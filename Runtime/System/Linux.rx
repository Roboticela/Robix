// Linux syscall numbers for the Robix runtime edge.
Package Robix.Runtime
Explain {
    Description: "Linux x86-64 syscall numbers used by the bump runtime.";
};

Import Robix.Core;


Public Class LinuxEdge {
    Public Function Mmap() -> Int
    Explain {
        Description: "Return the Linux mmap syscall number.";
        Input: none = "No input";
        Processing: "mmap is syscall 9 on x86-64.";
        Output: "Nine.";
    } {
        Return 9;
    }

    Public Function Page() -> Int
    Explain {
        Description: "Return the chunk size requested from mmap.";
        Input: none = "No input";
        Processing: "Chunks are whole pages.";
        Output: "4096 bytes.";
    } {
        Return 4096;
    }

    Public Function Prot() -> Int
    Explain {
        Description: "Return the mmap protection for a heap chunk.";
        Input: none = "No input";
        Processing: "The chunk is readable and writable.";
        Output: "Three, which is PROT_READ plus PROT_WRITE.";
    } {
        Return 3;
    }

    Public Function Flags() -> Int
    Explain {
        Description: "Return the mmap flags for a private anonymous chunk.";
        Input: none = "No input";
        Processing: "MAP_PRIVATE is 2 and MAP_ANONYMOUS is 32.";
        Output: "Thirty-four.";
    } {
        Return 34;
    }

    Public Function Round(Int bytes) -> Int
    Explain {
        Description: "Round a byte count up to a whole page.";
        Input: bytes = "The number of bytes the program asked for";
        Processing: "Empty requests still take one page.";
        Output: "The mmap length.";
    } {
        Int page = This.Page();
        Int count = bytes;
        If (count < 1) { count = 1; }
        Int pages = (count + page - 1) / page;
        Return pages * page;
    }

    Public Function Sample() -> Int
    Explain {
        Description: "Check the mmap request used for heap chunks.";
        Input: none = "No input";
        Processing: "A one-byte request is one anonymous read-write page.";
        Output: "One when the syscall, page, protection, and flags agree.";
    } {
        If (This.Mmap() != 9) { Return 0; }
        If (This.Page() != 4096) { Return 0; }
        If (This.Prot() != 3) { Return 0; }
        If (This.Flags() != 34) { Return 0; }
        If (This.Round(1) != 4096) { Return 0; }
        If (This.Round(4096) != 4096) { Return 0; }
        If (This.Round(4097) != 8192) { Return 0; }
        Return 1;
    }
}
