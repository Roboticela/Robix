// Tests for ProjectSystem.rx.

Test CanonicalTask {
    Case "build" {
        Input: command = "build";
        Output: "Build";
    }
    Case "clean" {
        Input: command = "clean";
        Output: "Clean";
    }
    Case "test" {
        Input: command = "test";
        Output: "Test";
    }
    Case "restore" {
        Input: command = "restore";
        Output: "Restore";
    }
    Case "publish" {
        Input: command = "publish";
        Output: "Publish";
    }
}

Test CommandOf {
    Case "empty args" {
        Input: args = [];
        Output: "";
    }
    Case "first non-flag" {
        Input: args = ["build", "--Verbose"];
        Output: "build";
    }
    Case "skip config value" {
        Input: args = ["--Configuration", "Release", "clean"];
        Output: "clean";
    }
}

Test ParentDirectory {
    Case "nested path" {
        Input: path = "src/tools/robix.rx";
        Output: "src/tools";
    }
    Case "root path" {
        Input: path = "robix.rx";
        Output: ".";
    }
}

Test FileStem {
    Case "simple file" {
        Input: relative = "src/Lexer.rx";
        Output: "Lexer";
    }
    Case "dotted file" {
        Input: relative = "Lexer.test.rx";
        Output: "Lexer.test";
    }
}

Test Trim {
    Case "spaces" {
        Input: text = "  hello world  ";
        Output: "hello world";
    }
    Case "tabs" {
        Input: text = "\t robix \t";
        Output: "robix";
    }
}

Test Join {
    Case "dot directory" {
        Input: directory = ".", relative = "file.rx";
        Output: "file.rx";
    }
    Case "nested directory" {
        Input: directory = "Build", relative = "Compiler";
        Output: "Build/Compiler";
    }
    Case "empty directory" {
        Input: directory = "", relative = "file.rx";
        Output: "file.rx";
    }
}

Test Split {
    Case "three segments" {
        Input: path = "foo/bar/baz";
        Assert: Result.Count() == 3 && Result[0] == "foo" && Result[1] == "bar" && Result[2] == "baz";
    }
}

Test SplitLines {
    Case "two lines" {
        Input: text = "line1\nline2";
        Assert: Result.Count() == 2 && Result[0] == "line1" && Result[1] == "line2";
    }
}

Test KnownType {
    Case "executable" {
        Input: projectType = "Executable";
        Output: True;
    }
    Case "library" {
        Input: projectType = "Library";
        Output: True;
    }
    Case "unknown" {
        Input: projectType = "InvalidType";
        Output: False;
    }
}

Test MatchSegment {
    Case "exact match" {
        Input: text = "abc", pattern = "abc";
        Output: True;
    }
    Case "wildcard match" {
        Input: text = "test.rx", pattern = "*.rx";
        Output: True;
    }
    Case "wildcard mismatch" {
        Input: text = "test.txt", pattern = "*.rx";
        Output: False;
    }
}

Test MatchPattern {
    Case "match extension" {
        Input: path = "src/main.rx", pattern = "**/*.rx";
        Output: True;
    }
    Case "mismatch extension" {
        Input: path = "src/main.txt", pattern = "**/*.rx";
        Output: False;
    }
}

Test MatchesAny {
    Case "matches one pattern" {
        Input: path = "src/main.rx", patterns = ["*.txt", "**/*.rx"];
        Output: True;
    }
    Case "matches none" {
        Input: path = "src/main.c", patterns = ["*.txt", "*.rx"];
        Output: False;
    }
}

Test MatchParts {
    Case "exact parts" {
        Input: pathParts = ["src", "main.rx"], pathIndex = 0, patternParts = ["src", "main.rx"], patternIndex = 0;
        Output: True;
    }
}

Test OrDefault {
    Case "non-empty" {
        Input: value = "custom", fallback = "default";
        Output: "custom";
    }
    Case "empty" {
        Input: value = "", fallback = "default";
        Output: "default";
    }
}

Test Property {
    Case "found property" {
        Input: node = ProjectNode(Found: True, Children: [ProjectNode(Name: "Type", Text: "Executable")]), name = "Type";
        Output: "Executable";
    }
    Case "missing property" {
        Input: node = ProjectNode(Found: True, Children: []), name = "Type";
        Output: "";
    }
}

Test FindChild {
    Case "found child" {
        Input: node = ProjectNode(Children: [ProjectNode(Name: "Config")]), name = "Config";
        Assert: Result.Name == "Config";
    }
    Case "missing child" {
        Input: node = ProjectNode(Children: []), name = "Config";
        Assert: !Result.Found;
    }
}

Test WordChar {
    Case "letter" {
        Input: character = "a";
        Output: True;
    }
    Case "digit" {
        Input: character = "5";
        Output: True;
    }
    Case "underscore" {
        Input: character = "_";
        Output: True;
    }
    Case "punctuation" {
        Input: character = "!";
        Output: False;
    }
}

