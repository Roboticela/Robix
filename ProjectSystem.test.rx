}

Test DeletePath {
    Case "delete nonexistent" {
        Input: path = "nonexistent_temp_file_12345";
        Assert: Result == True;
    }
}

Test SourceFiles {
    Case "empty project sources" {
        Input: project = ProjectNode();
        Assert: Result.Count() >= 0;
    }
}

Test EntryFile {
    Case "empty files" {
        Input: project = ProjectNode(), files = [];
