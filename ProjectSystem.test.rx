Test ParseItem {
    Case "parse item at eof" {
        Input:;
        Assert: Result != Null;
    }
}

Test ParseFile {
    Case "parse valid project" {
        Input: source = "Project \"Demo\" { Type: Executable; }";
        Assert: Result.Kind == "File" && Result.Children.Count() > 0 && Result.Children[0].Name == "Demo";
    }
}

Test FindFunction {
    Case "absent function" {
        Input: name = "func";
        Assert: !Result.Found;
    }
}

Test DefineVariable {
    Case "define var" {
        Input: name = "Config", value = "Release";
        Assert: True;
    }
}

Test LookupVariable {
    Case "missing" {
        Input: name = "Config";
        Output: "";
    }
}

Test HasVariable {
    Case "missing" {
        Input: name = "Config";
        Output: False;
    }
}

Test CollectVariables {
    Case "collect empty" {
        Input: root = ProjectNode();
        Assert: True;
    }
}

Test CollectFrom {
    Case "collect from empty" {
        Input: node = ProjectNode();
        Assert: True;
    }
}

Test Resolve {
    Case "resolve empty" {
        Input: node = ProjectNode();
        Assert: True;
    }
}

Test ResolveText {
    Case "plain text" {
        Input: text = "hello";
        Output: "hello";
    }
}

Test ConditionMatches {
    Case "equal expr" {
        Input: expression = "a == a";
        Output: True;
    }
    Case "unequal expr" {
        Input: expression = "a == b";
        Output: False;
    }
}

Test TaskAllows {
    Case "no condition" {
        Input: node = ProjectNode();
        Output: True;
    }
}

Test ProjectOf {
    Case "project of root" {
        Input: root = ProjectNode();
        Assert: Result != Null;
    }
}

Test FindTask {
    Case "task not found" {
        Input: tasks = ProjectNode(), taskName = "Build";
        Assert: !Result.Found;
    }
}

Test Validate {
    Case "empty project is invalid" {
        Input: root = ProjectNode();
        Assert: Result != "";
    }
}

Test PrintHelp {
    Case "prints help" {
        Input:;
