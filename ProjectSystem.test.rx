Test CheckTest {
    Case "check nonexistent file" {
        Input: relative = "nonexistent.rx";
        Assert: Result == True;
    }
}

Test Restore {
    Case "restore project" {
        Input: project = ProjectNode();
        Assert: Result == True;
    }
}

Test Clean {
    Case "clean project" {
        Input: project = ProjectNode();
        Assert: Result == True;
    }
}

Test CompileOne {
    Case "dry run or mock compile" {
        Input: project = ProjectNode(), relative = "a.rx", entry = False, native = NativeProgram(), module = AstNode();
        Assert: Result == False;
    }
}

Test CompileSources {
    Case "empty project compile sources" {
        Input: project = ProjectNode();
        Assert: Result == False;
    }
}

Test PackageOutput {
    Case "package empty output" {
        Input: project = ProjectNode();
        Assert: Result == True;
    }
}

Test RunEntry {
    Case "run entry with no files" {
        Input: project = ProjectNode();
        Assert: Result == False;
    }
}

Test RunDiscoveredTests {
    Case "run discovered tests" {
        Input: project = ProjectNode();
        Assert: Result == True;
    }
