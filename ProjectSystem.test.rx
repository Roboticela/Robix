Test RunTests {
    Case "run tests with pattern" {
        Input: project = ProjectNode(), pattern = "none/**/*.rx";
        Assert: Result == True;
    }
}

Test RunTask {
    Case "run empty task" {
        Input: project = ProjectNode(), task = ProjectNode(), stack = [];
        Assert: Result == True;
    }
}

Test ExecuteTask {
    Case "execute missing task" {
        Input: root = ProjectNode(), taskName = "UnknownTask";
        Assert: Result == False;
