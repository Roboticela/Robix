Test Fingerprint {
    Case "fingerprint non-empty" {
        Input: text = "hello";
        Assert: Result.Length() > 0;
    }
}

Test CachePath {
    Case "cache file path" {
        Input:;
        Assert: Result.Contains(".cache");
    }
}

Test Cached {
    Case "uncached file" {
        Input: relative = "main.rx";
        Assert: Result == "";
    }
}

Test Remember {
    Case "remember hash" {
        Input: relative = "main.rx", hash = "abc";
        Assert: True;
    }
}

Test OutputName {
    Case "default output name" {
        Input: project = ProjectNode();
        Assert: Result == "Application";
    }
}

Test OutputDirectory {
    Case "default output directory" {
        Input: project = ProjectNode();
        Assert: Result.Length() > 0;
    }
}

Test OutputPath {
    Case "entry output path" {
        Input: project = ProjectNode(), relative = "main.rx", entry = True;
        Assert: Result.Length() > 0;
    }
}

Test IntermediateDirectory {
    Case "temp directory" {
        Input: project = ProjectNode();
        Assert: Result.Length() > 0;
    }
}

Test IsApplication {
    Case "default is application" {
        Input: project = ProjectNode();
        Assert: Result == True;
