// Tests for Lexer.rx.

Test Tokenize {
    Case "tokenize empty input produces eof" {
        Input:;
        Assert: True;
    }
}

Test Register {
    Case "register keyword" {
        Input: canonical = "Let", kind = TokenKind.Let;
        Assert: canonical == "Let";
    }
}

Test RegisterKeywords {
    Case "register all keywords" {
        Input:;
        Assert: True;
    }
}

Test SkipTrivia {
    Case "skip trivia on empty source" {
        Input:;
        Assert: True;
    }
}

Test ReadToken {
    Case "read token on empty source" {
        Input:;
        Assert: True;
    }
}

Test ReadIdentifierOrKeyword {
    Case "read identifier" {
        Input:;
        Assert: True;
    }
}

Test ReadNumber {
    Case "read number" {
        Input:;
        Assert: True;
    }
}

Test ReadString {
    Case "read string" {
        Input: interpolated = False, raw = False;
        Assert: interpolated == False;
    }
}

Test ReadChar {
    Case "read char" {
        Input:;
        Assert: True;
    }
}

Test ReadOperatorOrDelimiter {
    Case "read operator" {
        Input:;
        Assert: True;
    }
}

Test TakeFixed {
    Case "take fixed token" {
        Input: kind = TokenKind.Let, length = 0;
        Assert: length == 0;
    }
}

Test Add {
    Case "add token" {
        Input: kind = TokenKind.Identifier, text = "sample", interpolated = False, raw = False, multiline = False;
        Assert: text == "sample";
    }
}

Test AdvanceChar {
    Case "advance at end of source" {
        Input:;
        Assert: True;
    }
}

Test PeekChar {
    Case "peek past end" {
        Input: offset = 0;
        Output: '\0';
    }
}

Test StartsWith {
    Case "empty source starts with" {
        Input: text = "abc";
        Output: False;
    }
}

Test IsDigit {
    Case "digit 5" {
        Input: character = '5';
        Output: True;
    }
    Case "letter a" {
        Input: character = 'a';
        Output: False;
    }
}

Test IsIdentifierStart {
    Case "letter x" {
        Input: character = 'x';
        Output: True;
    }
    Case "underscore" {
        Input: character = '_';
        Output: True;
    }
    Case "digit 7" {
        Input: character = '7';
        Output: False;
    }
}

Test IsIdentifierPart {
    Case "digit 7" {
        Input: character = '7';
        Output: True;
    }
    Case "letter b" {
        Input: character = 'b';
        Output: True;
    }
    Case "space" {
        Input: character = ' ';
        Output: False;
    }
}

Test IsSuffixChar {
    Case "char i" {
        Input: character = 'i';
        Output: True;
    }
    Case "char u" {
        Input: character = 'u';
        Output: True;
    }
    Case "char z" {
        Input: character = 'z';
        Output: False;
    }
}

Test IsCustomOperatorChar {
    Case "ascii tilde" {
        Input: character = '~';
        Output: False;
    }
    Case "ascii plus" {
        Input: character = '+';
        Output: False;
    }
}
