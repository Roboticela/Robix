<Robix3D Version="1.0">
  <Shader Name="Holographic">
    <Uniform Name="Time" Type="float" Default="0"/>
    <Uniform Name="ColorA" Type="color" Default="#00D9FF"/>
    <Uniform Name="ColorB" Type="color" Default="#FF00AA"/>
    <Surface>
      <Fresnel Power="3" Bias="0.1"/>
      <Noise Type="simplex" Scale="4" Speed="0.5"/>
      <Gradient From="{ColorA}" To="{ColorB}" Direction="view"/>
      <Output Color="Gradient" Roughness="0.15" Metalness="0.8" Emissive="0.2"/>
    </Surface>
  </Shader>

  <Scene Name="Gallery" Background="#101014">
    <Camera Type="perspective" Position="0,2,8" LookAt="0,1,0" Fov="40"/>
    <Lighting>
      <Ambient Color="#ffffff" Intensity="0.35"/>
      <Directional Color="#ffffff" Intensity="2" Position="4,6,3" CastShadow="true"/>
      <Spot Position="-3,5,2" Intensity="6" Angle="0.5" Penumbra="0.4"/>
      <Hemisphere Intensity="0.4" Color="#cfe6ff" Ground="#222222"/>
    </Lighting>

    <Mesh Name="Hologram">
      <Geometry Type="sphere" Radius="0.7" WidthSegments="64" HeightSegments="32"/>
      <Material Shader="Holographic"/>
      <Transform Position="-2.2,1.2,0"/>
    </Mesh>

    <Mesh Name="Glass">
      <Geometry Type="torus" Radius="0.6" Tube="0.18"/>
      <Material Type="glass" Color="#9fd6ff"/>
      <Transform Position="0,1.4,0"/>
    </Mesh>

    <Mesh Name="Block">
      <Geometry Type="box" Width="1" Height="1" Depth="1"/>
      <Material Type="standard" Color="#3399FF" Roughness="0.4"/>
      <Transform Position="2.2,2.2,0"/>
      <PhysicsBody Type="dynamic">
        <Collider Type="cuboid" Size="0.5,0.5,0.5"/>
        <Mass Value="1"/>
        <Restitution Value="0.3"/>
        <Friction Value="0.7"/>
      </PhysicsBody>
    </Mesh>

    <Mesh Name="Ground">
      <Geometry Type="box" Width="12" Height="0.2" Depth="12"/>
      <Material Color="#2a2a2e"/>
      <Transform Position="0,-0.1,0"/>
      <PhysicsBody Type="fixed">
        <Collider Type="cuboid" Size="6,0.1,6"/>
      </PhysicsBody>
    </Mesh>

    <Physics Engine="rapier" Gravity="0,-9.81,0"/>

    <State Name="SelectedColor" Type="color" Default="#3399FF"/>
    <Binding Target="Block.Material.Color" Value="{SelectedColor}"/>
    <Interaction Target="Block">
      <On Event="Click">
        <Action Type="SetState" Name="SelectedColor" Value="#FF3344"/>
      </On>
    </Interaction>

    <UI Source="Panel.rxu">
      <ColorPicker Label="Block" Bind="SelectedColor"/>
      <Note>Drag to orbit. Click the block to turn it red.</Note>
    </UI>

    <Controls>
      <OrbitControls EnableZoom="true" EnablePan="false"/>
    </Controls>
    <Renderer Shadows="true" Antialias="true" ToneMapping="aces"/>
  </Scene>
</Robix3D>
