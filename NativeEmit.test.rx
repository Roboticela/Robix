// Tests for NativeEmit.rx.

Test Collect {
    Case "empty collection" {
        Input: fileNames = [], modules = [];
        Assert: True;
    }
}

Test EmitFile {
    Case "emit module skeleton" {
        Input: fileName = "main.rx", module = AstNode(Children: []), isEntry = False;
        Assert: Result.Length() > 0;
    }
}

Test AddClass {
    Case "add empty class" {
        Input: fileName = "a.rx", node = AstNode(Name: "MyClass", Children: []);
        Assert: This.FindClass("MyClass").Name == "MyClass";
    }
}

Test PutMethod {
    Case "put method info" {
        Input: info = ClassInfo(), method = MethodInfo();
        Assert: True;
    }
}

Test AddFunction {
    Case "add empty function" {
        Input: fileName = "a.rx", node = AstNode(Name: "myFunc", Parameters: []);
        Assert: This.FindFunction("myFunc", "a.rx").Name == "myFunc";
    }
}

Test CollectLambdas {
    Case "collect lambda from node" {
        Input: fileName = "a.rx", node = AstNode(Kind: AstKind.Lambda);
        Assert: True;
    }
}

Test FindClass {
    Case "not found" {
        Input: name = "NonExistent";
        Assert: Result.Name == "";
    }
}

Test FindFunction {
    Case "not found" {
        Input: name = "f", fileName = "f.rx";
        Assert: Result.Name == "";
    }
}

Test RememberModuleOperator {
    Case "operator node" {
        Input: fileName = "a.rx", node = AstNode(Parameters: []);
        Assert: True;
    }
}

Test RememberClassOperator {
    Case "class operator node" {
        Input: className = "C", node = AstNode(Parameters: []);
        Assert: True;
    }
}

Test OperatorResult {
    Case "null type node" {
        Input: typeNode = Null;
        Output: "Int";
    }
}

Test SafeOperator {
    Case "add" {
        Input: symbol = "+";
        Output: "add";
