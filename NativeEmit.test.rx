    Case "error field" {
        Input: receiver = "RoboResult<Int, String>", parameters = "TValue, TError", fieldType = "TError?";
        Output: "String?";
    }
    Case "plain field" {
        Input: receiver = "RoboColor", parameters = "", fieldType = "UInt8";
        Output: "UInt8";
    }
}

Test ObjectTypeName {
    Case "bare struct" {
        Input: node = AstNode(Name: "RoboResult");
        Output: "RoboResult";
    }
}

Test ExitCodeValue {
    Case "success" {
        Input: name = "Success";
        Output: 0;
    }
    Case "error" {
        Input: name = "ErrorExecution";
        Output: 2;
    }
    Case "unknown" {
        Input: name = "Unknown";
        Output: -1;
    }
}

Test IsStringMethod {
    Case "length" {
        Input: name = "Length";
        Output: True;
    }
    Case "foo" {
        Input: name = "Foo";
        Output: False;
    }
}

Test IsListMethod {
    Case "add" {
        Input: name = "Add";
        Output: True;
    }
    Case "bar" {
        Input: name = "Bar";
        Output: False;
    }
}

Test Escape {
    Case "plain text" {
        Input: text = "hello";
        Assert: Result.Bytes == 5 && Result.Text == "hello";
    }
}

Test AppendUtf8 {
    Case "ascii char" {
        Input: result = EscapeText(), code = 65;
        Assert: result.Bytes == 1;
    }
}

Test HexByte {
    Case "zero" {
        Input: value = 0;
        Output: "\\00";
    }
    Case "65" {
        Input: value = 65;
        Output: "\\41";
    }
}

Test LiteralTypeName {
    Case "plain integer" {
        Input: text = "42";
        Output: "Int";
    }
    Case "unsigned suffix" {
        Input: text = "42u32";
        Output: "UInt32";
    }
    Case "decimal suffix" {
        Input: text = "42.0m";
        Output: "Decimal";
    }
    Case "hex is not a float suffix" {
        Input: text = "0xFF";
        Output: "Int";
    }
}

Test DigitSuffix {
    Case "digit before suffix" {
        Input: lower = "42u32", suffix = "u32";
        Output: True;
    }
    Case "hex letter is not a decimal digit" {
        Input: lower = "0xff", suffix = "f";
        Output: False;
    }
}

Test BitWidth {
    Case "generic width" {
        Input: typeName = "Int<24>";
        Output: 24;
    }
}

Test IsWideUnsigned {
    Case "uint64" {
        Input: typeName = "UInt64";
        Output: True;
    }
    Case "int24" {
        Input: typeName = "Int<24>";
        Output: False;
    }
}

Test EmitNumericFrom {
    Case "uint32 from" {
        Input: node = AstNode(Left: AstNode(Kind: AstKind.Member, Name: "From", Left: AstNode(Kind: AstKind.Name, Name: "UInt32")), Parameters: [AstNode(Kind: AstKind.Argument, Left: AstNode(Kind: AstKind.IntegerLiteral, Text: "14"))]);
        Assert: Result.TypeName == "UInt32";
    }
}

Test IsNumericType {
    Case "decimal is numeric" {
        Input: typeName = "Decimal";
        Output: True;
    }
    Case "bool is not numeric" {
        Input: typeName = "Bool";
        Output: False;
    }
}

Test IsWrappedInteger {
    Case "uint32 wraps" {
        Input: typeName = "UInt32";
        Output: True;
    }
    Case "int64 stays full width" {
        Input: typeName = "Int64";
        Output: False;
    }
}

Test WrapInteger {
    Case "mask uint8" {
        Input: value = "300", typeName = "UInt8";
        Assert: Result.StartsWith("%");
    }
}

Test SignExtend {
    Case "sign extend int8" {
        Input: value = "128", width = "i8";
        Assert: Result.StartsWith("%");
    }
}

Test NarrowFloat32 {
    Case "narrow a double bit pattern" {
        Input: bits = "0";
        Assert: Result.StartsWith("%");
    }
}

Test HexDigit {
    Case "9" {
        Input: value = 9;
        Output: "9";
    }
    Case "10" {
        Input: value = 10;
        Output: "A";
    }
    Case "15" {
        Input: value = 15;
        Output: "F";
    }
}
