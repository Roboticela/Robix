// Tests for TypeChecker.rx.

Test Check {
    Case "check empty module" {
        Input: module = AstNode(Kind: AstKind.Module);
        Assert: module.Kind == AstKind.Module;
    }
}

Test PredeclareFunctions {
    Case "predeclare functions" {
        Input: node = AstNode();
        Assert: node != Null;
    }
}

Test CheckNode {
    Case "check node" {
        Input: node = AstNode();
        Assert: node != Null;
    }
}

Test CheckScoped {
    Case "check scoped block" {
        Input: node = AstNode(Kind: AstKind.Block);
        Assert: node != Null;
    }
}

Test CheckVariable {
    Case "check variable" {
        Input: node = AstNode(Kind: AstKind.Variable, Name: "x");
        Assert: node.Name == "x";
    }
}

Test CheckFunction {
    Case "check function" {
        Input: node = AstNode(Kind: AstKind.Function, Name: "foo");
        Assert: node.Name == "foo";
    }
}

Test CheckIf {
    Case "check if" {
        Input: node = AstNode(Kind: AstKind.If);
        Assert: node != Null;
    }
}

Test CheckFor {
    Case "check for" {
        Input: node = AstNode(Kind: AstKind.For);
        Assert: node != Null;
    }
}

Test CheckMatch {
    Case "check match" {
        Input: node = AstNode(Kind: AstKind.Match);
        Assert: node != Null;
    }
}

Test CheckAssignment {
    Case "check assignment" {
        Input: node = AstNode(Kind: AstKind.Assignment);
        Assert: node != Null;
    }
}

Test Infer {
    Case "infer integer literal" {
        Input: node = AstNode(Kind: AstKind.IntegerLiteral);
        Output: "Int";
    }
}

Test InferCall {
    Case "infer call" {
        Input: node = AstNode(Kind: AstKind.Call);
        Assert: Result != "";
    }
}

Test RequireAssignable {
    Case "require assignable same type" {
        Input: node = AstNode(), expected = "Int", actual = "Int";
        Assert: expected == actual;
    }
}

Test RequireBool {
    Case "require bool type" {
        Input: node = AstNode(), actual = "Bool";
        Assert: actual == "Bool";
    }
}

Test MissingType {
    Case "missing type diagnostic" {
        Input: node = AstNode(), label = "Variable";
        Assert: label == "Variable";
    }
}

Test Undefined {
    Case "undefined variable diagnostic" {
        Input: node = AstNode(Name: "x");
        Assert: node.Name == "x";
    }
}

Test NoteNullNarrowing {
    Case "null condition narrowing" {
        Input: condition = Null;
        Assert: Result == Null;
    }
}

Test NoteNullExit {
    Case "null condition exit" {
        Input: condition = Null;
        Assert: Result == Null;
    }
}

Test BindPattern {
    Case "bind null pattern" {
        Input: pattern = Null, typeName = "Int";
        Assert: typeName == "Int";
    }
}

Test ReturnsAlways {
    Case "return is true" {
        Input: node = AstNode(Kind: AstKind.Return);
        Output: True;
    }
    Case "block is false" {
        Input: node = AstNode(Kind: AstKind.Block);
        Output: False;
    }
}

Test RegisterFunction {
    Case "register function" {
        Input: node = AstNode(Kind: AstKind.Function, Name: "bar");
        Assert: node.Name == "bar";
    }
}

Test Define {
    Case "define symbol" {
        Input: name = "x", typeName = "Int", mutable = False, nullable = False, initialized = True, isFunction = False, isAsync = False, isConst = False, line = 1, column = 1;
        Assert: name == "x";
    }
}

Test Find {
    Case "find unregistered symbol" {
        Input: name = "unregistered";
        Assert: Result == Null;
    }
}

Test PushScope {
    Case "push scope" {
        Input:;
        Assert: True;
    }
}

Test PopScope {
    Case "pop scope" {
        Input:;
        Assert: True;
    }
}

Test CollectAliases {
    Case "collect aliases" {
        Input: node = AstNode();
        Assert: node != Null;
    }
}

Test ResolveType {
    Case "resolve primitive type" {
        Input: name = "Int";
        Output: "Int";
    }
}

Test ApplyAlias {
    Case "unknown alias" {
        Input: name = "Pair<Int, String>";
        Output: "";
    }
}

Test SubstituteAlias {
    Case "pair of types" {
        Input: target = "(TLeft, TRight)", parameters = "TLeft, TRight", arguments = "Int, String";
        Output: "(Int, String)";
    }
    Case "nested argument" {
        Input: target = "Storage<T>", parameters = "T", arguments = "Map<String, Int>";
        Output: "Storage<Map<String, Int>>";
    }
}

Test SplitTypeList {
    Case "two types" {
        Input: text = "Int, String", parts = [];
        Assert: parts.Count() == 2;
    }
}

Test TrimType {
    Case "trim spaces" {
        Input: text = " Int ";
        Output: "Int";
    }
}

Test ReplaceParameter {
    Case "replace matching token" {
        Input: token = "T", names = ["T"], values = ["Int"];
        Output: "Int";
    }
}

Test GenericParameterText {
    Case "no parameters" {
        Input: node = AstNode();
        Output: "";
    }
}

Test GenericParametersOf {
    Case "unknown type" {
        Input: name = "RoboResult";
        Output: "";
    }
}

Test AppliedOwner {
    Case "generic struct" {
        Input: owner = "RoboResult<Int, String>";
        Output: "RoboResult";
    }
    Case "plain struct" {
        Input: owner = "RoboColor";
        Output: "RoboColor";
    }
}

Test TypeArguments {
    Case "two arguments" {
        Input: owner = "RoboResult<Int, String>";
        Output: "Int, String";
    }
    Case "no arguments" {
        Input: owner = "RoboColor";
        Output: "";
    }
}

Test AppliedObjectType {
    Case "bare name" {
        Input: node = AstNode(Name: "RoboResult");
        Output: "RoboResult";
    }
}

Test FieldTypeOf {
    Case "unknown field" {
        Input: owner = "RoboColor", name = "Red";
        Output: "";
    }
}

Test TypeText {
    Case "type text from node" {
        Input: type = AstNode(Name: "Int");
        Output: "Int";
    }
}

Test PromiseTypeOf {
    Case "default integer" {
        Input: member = AstNode();
        Output: "Promise<Int>";
    }
}

Test PromiseCombinatorType {
    Case "all" {
        Input: node = AstNode(), method = "All";
        Output: "Promise<Array<Int>>";
    }
    Case "race" {
        Input: node = AstNode(), method = "Race";
        Output: "Promise<Int>";
    }
}

Test WhenAllType {
    Case "empty" {
        Input: node = AstNode();
        Output: "()";
    }
}

Test TaskCallType {
    Case "delay" {
        Input: owner = "Task", name = "Delay";
        Output: "Task<Void>";
    }
    Case "sleep" {
        Input: owner = "Timer", name = "Sleep";
        Output: "Task<Void>";
    }
    Case "sensor" {
        Input: owner = "Hardware", name = "ReadSensor";
        Output: "Int";
    }
    Case "seconds" {
        Input: owner = "Duration", name = "Seconds";
        Output: "Int";
    }
    Case "unknown" {
        Input: owner = "Math", name = "Min";
        Output: "";
    }
}

Test InnerTask {
    Case "task int" {
        Input: typeName = "Task<Int>";
        Output: "Int";
    }
    Case "plain int" {
        Input: typeName = "Int";
        Output: "Int";
    }
}

Test StripOptional {
    Case "optional string" {
        Input: typeName = "String?";
        Output: "String";
    }
    Case "plain string" {
        Input: typeName = "String";
        Output: "String";
    }
}

Test WidensTo {
    Case "int32 to int" {
        Input: expected = "Int", actual = "Int32";
        Output: True;
    }
    Case "string to int" {
        Input: expected = "Int", actual = "String";
        Output: False;
    }
}

Test CallArgumentType {
    Case "call argument type default" {
        Input: node = AstNode();
        Output: "Int";
    }
}

Test CallTupleType {
    Case "call tuple type default" {
        Input: node = AstNode();
        Output: "()";
    }
}

Test LiteralElement {
    Case "literal element default" {
        Input: node = AstNode();
        Output: "Int";
    }
}

Test FunctionNodeOf {
    Case "unknown function" {
        Input: name = "RoboUpdate";
        Assert: True;
    }
}

Test ArgumentName {
    Case "missing argument" {
        Input: call = AstNode(), position = 0, parameterName = "speed";
        Output: "";
    }
}

Test CheckMutableArguments {
    Case "no parameters" {
        Input: call = AstNode(), function = AstNode();
        Output: True;
    }
}

Test FunctionSignature {
    Case "empty function" {
        Input: node = AstNode();
        Output: "Function<Void>";
    }
}

Test FunctionTypeOf {
    Case "unknown function" {
        Input: name = "RoboAdd";
        Output: "";
    }
}

Test ReferenceType {
    Case "missing argument" {
        Input: node = AstNode();
        Output: "Int";
    }
}

Test RefPayload {
    Case "mutable integer" {
        Input: typeName = "Ref<Mut Int>";
        Output: "Int";
    }
    Case "plain integer" {
        Input: typeName = "Ref<Int>";
        Output: "Int";
    }
}

Test ElementName {
    Case "list int element" {
        Input: typeName = "List<Int>";
        Output: "Int";
    }
    Case "plain int element" {
        Input: typeName = "Int";
        Output: "";
    }
}

Test SameElements {
    Case "list and array of int" {
        Input: expected = "List<Int>", actual = "Array<Int>";
        Output: True;
    }
    Case "int and string" {
        Input: expected = "List<Int>", actual = "List<String>";
        Output: False;
    }
}

Test FixedCount {
    Case "fixed array 4" {
        Input: typeName = "[Int; 4]";
        Output: 4;
    }
    Case "plain int" {
        Input: typeName = "Int";
        Output: -1;
    }
}

Test IsNumeric {
    Case "int is numeric" {
        Input: typeName = "Int";
        Output: True;
    }
    Case "string is not numeric" {
        Input: typeName = "String";
        Output: False;
    }
}

Test IsTypeName {
    Case "bool is type name" {
        Input: name = "Bool";
        Output: True;
    }
    Case "robot is not type name" {
        Input: name = "Robot";
        Output: False;
    }
}

Test IsCamel {
    Case "camel case" {
        Input: name = "robotSpeed";
        Output: True;
    }
    Case "pascal case" {
        Input: name = "RobotSpeed";
        Output: False;
    }
}

Test FitsIntegerLiteral {
    Case "int8 accepts twelve" {
        Input: node = AstNode(Kind: AstKind.IntegerLiteral, Text: "12"), expected = "Int8";
        Output: True;
    }
    Case "uint8 rejects 256" {
        Input: node = AstNode(Kind: AstKind.IntegerLiteral, Text: "256"), expected = "UInt8";
        Output: False;
    }
    Case "uint64 accepts its maximum" {
        Input: node = AstNode(Kind: AstKind.IntegerLiteral, Text: "18_446_744_073_709_551_615"), expected = "UInt64";
        Output: True;
    }
    Case "int24 accepts one hundred" {
        Input: node = AstNode(Kind: AstKind.IntegerLiteral, Text: "100"), expected = "Int<24>";
        Output: True;
    }
}

Test DigitsOnly {
    Case "width digits" {
        Input: text = "24";
        Output: True;
    }
    Case "named type" {
        Input: text = "Int";
        Output: False;
    }
}

Test WidthBits {
    Case "explicit width" {
        Input: typeName = "Int<24>";
        Output: 24;
    }
    Case "uint64" {
        Input: typeName = "UInt64";
        Output: 64;
    }
}

Test CleanDigits {
    Case "strip separators" {
        Input: text = "1_000";
        Output: "1000";
    }
}

Test DigitAt {
    Case "first digit" {
        Input: text = "42", index = 0;
        Output: 4;
    }
}

Test DigitChar {
    Case "four" {
        Input: digit = 4;
        Output: "4";
    }
}

Test DoubleDecimal {
    Case "double one hundred" {
        Input: digits = "100";
        Output: "200";
    }
}

Test MinusOneDecimal {
    Case "subtract one" {
        Input: digits = "256";
        Output: "255";
    }
}

Test PowerLimit {
    Case "eight bit maximum" {
        Input: bits = 8, includeTop = False;
        Output: "255";
    }
}

Test DigitsWithin {
    Case "equal limit" {
        Input: digits = "255", limit = "255";
        Output: True;
    }
    Case "above limit" {
        Input: digits = "256", limit = "255";
        Output: False;
    }
}

Test FitsFloatLiteral {
    Case "float literal fits float32" {
        Input: node = AstNode(Kind: AstKind.FloatLiteral, Text: "1.0"), expected = "Float32";
        Output: True;
    }
    Case "integer literal is not a float literal" {
        Input: node = AstNode(Kind: AstKind.IntegerLiteral, Text: "1"), expected = "Float32";
        Output: False;
    }
}

Test FitsDecimalLiteral {
    Case "float literal fits decimal" {
        Input: node = AstNode(Kind: AstKind.FloatLiteral, Text: "42.0"), expected = "Decimal";
        Output: True;
    }
    Case "string does not fit decimal" {
        Input: node = AstNode(Kind: AstKind.StringLiteral, Text: "42.0"), expected = "Decimal";
        Output: False;
    }
}

Test HasModifier {
    Case "has modifier" {
        Input: node = AstNode(Modifiers: ["Public", "Const"]), name = "Const";
        Output: True;
    }
    Case "missing modifier" {
        Input: node = AstNode(Modifiers: ["Public"]), name = "Const";
        Output: False;
    }
}
