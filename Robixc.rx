// robixc compiles a Robix module into a native executable.
Package Robix.Tools
Explain {
    Description: "Commands for the Robix native compiler."
};

Import Robix.Core;
Import Robix.Syntax;
Import Robix.Runtime;

Private Extern Function ClockMillis() -> Int;
Private Extern Function ToolchainPath() -> String;


Public Function Main(Args<String> args) -> ExecutionResult
Explain {
    Description: "Compile a Robix file or project into a native binary.";
    Input: args = "A source file, a project file, or a compiler command";
    Processing: "Reject test files, run tests unless asked not to, and assemble an ELF or a PE. Unchanged inputs are skipped.";
    Output: "Success when the binary, assembly, or check is written.";
} {
    String blocked = CompilerOption(args);
    If (blocked != "") {
        Int code = 2;
        If (blocked.StartsWith("Unknown")) { code = 4; }
        Return FinishRun(code, blocked);
    }
    String kind = ClassifyRobixc(args);
    If (kind == "help") {
        Print(CompilerHelp());
        Return FinishRun(ExitCode.Success, "Printed Robixc help.");
    }
    If (kind == "version" || kind == "version-detail") {
        String mode = "short";
        If (kind == "version-detail") { mode = "detail"; }
        Print(CompilerVersion(mode));
        Return FinishRun(ExitCode.Success, "Printed the Robixc version.");
    }
    If (kind == "reject-test") {
        Return FinishRun(ExitCode.InvalidArguments, "Test files are run with Robix Test. They are not compilation entries.");
    }
    If (kind == "targets") {
        Print("{blue}WindowsX64{/}  {muted}PE, ready{/}");
        Print("{blue}LinuxX64{/}  {muted}ELF, ready, default{/}");
        Print("{muted}WindowsARM64{/}  later");
        Print("{muted}LinuxARM64{/}  later");
        Return FinishRun(ExitCode.Success, "Targets printed.");
    }
    If (kind == "doctor") {
        Print("{blue}Robixc{/}  {muted}0.0.48{/}");
        Print("Assembler: linux-x64, windows-x64");
        Return FinishRun(ExitCode.Success, "Compiler diagnosis finished.");
    }
    String target = TargetName(OptionText(args, "--Target"));
    If (OptionText(args, "--Target") != "" && target == "") {
        Return FinishRun(ExitCode.InvalidArguments, "The target is not recognized.");
    }
    If (target == "") { target = "LinuxX64"; }
    String source = CompilerSource(args);
    String stem = "Program";
    If (source != "") { stem = OutputStem(source); }
    String mode = "program";
    For arg In args {
        String lower = arg.ToLower();
        If (lower == "--asm") { mode = "asm"; }
        If (lower == "--ir") { mode = "ir"; }
    }
    String requested = CompilerOutput(args);
    Bool projectBuild = kind == "build";
    If (kind == "analyze" && (source == "" || source.EndsWith(".rxp"))) { projectBuild = True; }
    If (projectBuild) {
        String projectPath = source;
        If (projectPath == "" || !projectPath.EndsWith(".rxp")) { projectPath = CompilerProject(); }
        If (projectPath == "" || !Files.Exists(projectPath)) {
            Return FinishRun(ExitCode.InvalidArguments, "A .rxp project is required.");
        }
        String project = Files.ReadText(projectPath);
        String entry = ProjectEntry(project);
        String title = ProjectHeading(project);
        If (title == "") { title = "Program"; }
        If (entry == "") {
            String preferred = title + ".rx";
            If (Files.Exists(preferred)) { entry = preferred; }
        }
        If (entry == "") {
            For relative In Directory.Files(".") {
                Bool sourceFile = relative.EndsWith(".rx") && !relative.EndsWith(".test.rx");
                If (sourceFile && !relative.Contains("/") && !relative.Contains("\\")) {
                    If (Files.ReadText(relative).Contains("Function Main")) {
                        entry = relative;
                        Break;
                    }
                }
            }
        }
        If (entry == "") { Return FinishRun(ExitCode.ErrorExecution, "The project has no entry file."); }
        If (title == "") { title = OutputStem(entry); }
        source = entry;
        stem = title;
    }
    String output = PlannedOutput(stem, target, requested, mode);
    If (kind == "info") {
        Print("{blue}target{/}  " + target);
        Print("{blue}output{/}  " + output);
        Return FinishRun(ExitCode.Success, "Build information printed.");
    }
    If (kind == "cache") {
        Bool stats = False;
        Bool clear = False;
        For arg In args {
            String lower = arg.ToLower();
            If (lower == "clear") { clear = True; }
            If (lower == "stats") { stats = True; }
        }
        If (stats) {
            Print(CacheSummary());
            Return FinishRun(ExitCode.Success, "Cache statistics printed.");
        }
        String cache = CacheFile(output);
        If (clear && Files.Exists(cache)) { Files.Delete(cache); }
        Print(cache);
        Return FinishRun(ExitCode.Success, "Cache command finished.");
    }
    If (kind == "toolchain") { Return ShowToolchain(); }
    If (kind == "link") { Return ShowLink(output); }
    If (kind == "disassemble") { Return ShowListing(output); }
    If (kind == "symbols") { Return ShowSymbols(output); }
    If (kind == "dependencies") { Return ShowDependencies(output); }
    If (kind == "explain") { Return ShowExplain(); }
    If (kind == "report") { Return ShowReport(output); }
    If (kind == "clean" || kind == "rebuild") {
        String cache = CacheFile(output);
        If (Files.Exists(cache)) { Files.Delete(cache); }
        If (Files.Exists(output)) { Files.Delete(output); }
        If (kind == "clean") { Return FinishRun(ExitCode.Success, "Build output removed."); }
    }
    If (kind == "usage") { Return FinishRun(ExitCode.InvalidArguments, "A source file or project is required."); }
    If (source == "") { Return FinishRun(ExitCode.InvalidArguments, "A source file or project is required."); }
    If (kind == "check") { Return CheckSource(source); }
    Bool skipTests = False;
    Bool noCache = kind == "rebuild";
    Bool optimize = True;
    Bool showStats = False;
    Bool profileBuild = False;
    Bool analyze = kind == "analyze";
    Bool parallel = False;
    Bool writeSymbols = False;
    For arg In args {
        String lower = arg.ToLower();
        If (lower == "--skiptests") { skipTests = True; }
        If (lower == "--nocache") { noCache = True; }
        If (lower == "--debug" || lower == "--nooptimize") { optimize = False; }
        If (lower == "--release" || lower == "--optimize") { optimize = True; }
        If (lower == "--stats") { showStats = True; }
        If (lower == "--profile") { profileBuild = True; }
        If (lower == "--analyze") { analyze = True; }
        If (lower == "--parallel") { parallel = True; }
        If (lower == "--symbols") { writeSymbols = True; }
        If (lower == "--nosymbols") { writeSymbols = False; }
    }
    String assembler = AssemblerTarget(target);
    If (assembler == "" && !analyze) {
        Return FinishRun(ExitCode.ErrorExecution, "The assembler does not encode " + target + " yet.");
    }
    Return CompileUnit(source, output, assembler, mode, skipTests, noCache, optimize, showStats, profileBuild, analyze, parallel, writeSymbols);
}

Public Function ClassifyRobixc(List<String> args) -> String
Explain {
    Description: "Choose the Robixc command.";
    Input: args = "Compiler arguments";
    Processing: "Read the first command word or source path. A test file is rejected.";
    Output: "The command name.";
} {
    Var words = List<String>();
    Bool skip = False;
    For arg In args {
        If (skip) {
            skip = False;
            Continue;
        }
        If (arg == "--") { Break; }
        String lower = arg.ToLower();
        If (lower == "--target" || lower == "--output") {
            skip = True;
            Continue;
        }
        If (!arg.StartsWith("-")) { words.Add(arg); }
    }
    If (words.Count() == 0) {
        For arg In args {
            String lower = arg.ToLower();
            If (lower == "-h" || lower == "--help") { Return "help"; }
            If (lower == "--version") { Return "version-detail"; }
            If (lower == "-v") { Return "version"; }
        }
        Return "help";
    }
    String first = words[0].ToLower();
    If (first == "help") { Return "help"; }
    If (first == "version") {
        For arg In args {
            If (arg.ToLower() == "--version") { Return "version-detail"; }
        }
        Return "version";
    }
    If (first == "targets") { Return "targets"; }
    If (first == "doctor") { Return "doctor"; }
    If (first == "cache") { Return "cache"; }
    If (first == "toolchain") { Return "toolchain"; }
    If (first == "link") { Return "link"; }
    If (first == "disassemble") { Return "disassemble"; }
    If (first == "symbols") { Return "symbols"; }
    If (first == "dependencies") { Return "dependencies"; }
    If (first == "explain") { Return "explain"; }
    If (first == "report") { Return "report"; }
    If (first == "info") { Return "info"; }
    If (first == "clean") { Return "clean"; }
    If (first == "rebuild") { Return "rebuild"; }
    If (first == "check") { Return "check"; }
    If (first == "analyze") { Return "analyze"; }
    If (first.EndsWith(".test.rx")) { Return "reject-test"; }
    If (first == "build") { Return "build"; }
    If (first == "compile") {
        If (words.Count() < 2) { Return "usage"; }
        If (words[1].EndsWith(".test.rx")) { Return "reject-test"; }
        If (words[1].EndsWith(".rxp")) { Return "build"; }
        If (words[1].EndsWith(".rx")) { Return "compile-file"; }
        Return "usage";
    }
    If (first.EndsWith(".rxp")) { Return "build"; }
    If (first.EndsWith(".rx")) { Return "compile-file"; }
    Return "usage";
}

Public Function CompilerHelp() -> String
Explain {
    Description: "Build the Robixc help page.";
    Input: None;
    Processing: "List compile, output, and target commands in PascalCase.";
    Output: "The help text.";
} {
    Return "{blue}ROBIXC{/}\nNative compiler and linker\n\n{blue}USAGE{/}\n  Robixc [Command] [File] [Options]\n\n{blue}COMPILE{/}\n  Robixc Main.rx                 Compile one file and its imports\n  Robixc Compile Main.rx         Same compile\n  Robixc Build                   Compile the project entry\n  Robixc Build App.rxp           Compile that project\n  Robixc Analyze                 Print checker and optimizer findings\n  Robixc Analyze Main.rx         Analyze that file\n\n{blue}OUTPUT{/}\n  Build/Main/LinuxX64/Main\n  Build/Main/WindowsX64/Main.exe\n  --Output Name                  Extension follows the target\n  --Asm                          Write RXASM (.rxasm)\n  Robixc Toolchain               Show the toolchain directories\n  Robixc Link                    Report whether objects were linked\n  Robixc Disassemble             Print the saved .rxasm listing\n  Robixc Symbols                 Print the symbol file\n  Robixc Dependencies            Print link dependencies\n  Robixc Explain                 Read the latest diagnostic\n  Robixc Report                  Write the build report\n  Robixc Cache Stats             Count compile hits and misses\n  --Ir                           Write RXIR\n\n{blue}TARGETS{/}\n  --Target LinuxX64              Default ELF\n  --Target WindowsX64            PE\n  --Target LinuxARM64            Not encoded yet\n  --Target WindowsARM64          Not encoded yet\n\n{blue}OPTIONS{/}\n  --Debug --Release --Profile --NoOptimize --SkipTests --NoCache --Rebuild\n  --Analyze                      Print findings and skip the binary\n  --Parallel                     This compiler builds one file at a time\n  -h, --Help                     Help\n  -v, --Version                  Version\n";
}

Public Function CompilerVersion(String kind) -> String
Explain {
    Description: "Format the Robixc version line.";
    Input: kind = "short or detail";
    Processing: "Print the toolchain version. Detail names the default target.";
    Output: "The version text.";
} {
    If (kind == "detail") { Return "Robixc 0.0.48\nDefault target: LinuxX64\n"; }
    Return "Robixc 0.0.48";
}

Public Function TargetName(String name) -> String
Explain {
    Description: "Normalize a compiler target name.";
    Input: name = "LinuxX64, linux-x64, or another target";
    Processing: "Accept the four named targets and the kebab-case aliases. An empty name stays empty so the caller can apply the default.";
    Output: "The canonical target, or empty when it is unknown.";
} {
    String lower = name.ToLower();
    If (lower == "linux-x64" || lower == "linuxx64" || name == "LinuxX64") { Return "LinuxX64"; }
    If (lower == "windows-x64" || lower == "windowsx64" || name == "WindowsX64") { Return "WindowsX64"; }
    If (lower == "linux-arm64" || lower == "linuxarm64" || name == "LinuxARM64") { Return "LinuxARM64"; }
    If (lower == "windows-arm64" || lower == "windowsarm64" || name == "WindowsARM64") { Return "WindowsARM64"; }
    Return "";
}

Public Function AssemblerTarget(String target) -> String
Explain {
    Description: "Map a canonical target to the assembler name.";
    Input: target = "LinuxX64, WindowsX64, LinuxARM64, or WindowsARM64";
    Processing: "Return the assembler id for targets that can emit a binary.";
    Output: "linux-x64, windows-x64, or empty.";
} {
    If (target == "LinuxX64") { Return "linux-x64"; }
    If (target == "WindowsX64") { Return "windows-x64"; }
    Return "";
}

Public Function PlannedOutput(String stem, String target, String requested, String mode) -> String
Explain {
    Description: "Choose the compiler output path.";
    Input: stem = "File or project name", target = "Canonical target", requested = "An --Output path, or empty", mode = "program, asm, or ir";
    Processing: "Use Build/Stem/Target/Stem by default. Add .exe on Windows when the requested name has no extension. Keep an extension the user wrote.";
    Output: "The output path.";
} {
    String base = requested;
    If (base == "") { base = "Build/" + stem + "/" + target + "/" + stem; }
    If (mode == "asm") {
        If (base.EndsWith(".rxasm") || base.EndsWith(".rxs")) { Return base; }
        Return base + ".rxasm";
    }
    If (mode == "ir") {
        If (base.EndsWith(".rxir")) { Return base; }
        Return base + ".rxir";
    }
    Int slash = base.LastIndexOf("/");
    String leaf = base;
    If (slash >= 0) { leaf = base.Substring(slash + 1); }
    If (leaf.IndexOf(".") >= 0) { Return base; }
    If (target.StartsWith("Windows")) { Return base + ".exe"; }
    Return base;
}

Public Function CacheStatus(String saved, String current, Bool present) -> String
Explain {
    Description: "Decide whether a compiled artifact can be reused.";
    Input: saved = "The stored hash", current = "The hash of the current inputs", present = "True when the output file exists";
    Processing: "A matching hash with an output is Skipped. A different hash with an output is Recompiled. Anything else is Compiled.";
    Output: "Skipped, Recompiled, or Compiled.";
} {
    If (saved != "" && saved == current && present) { Return "Skipped"; }
    If (saved != "" && saved != current && present) { Return "Recompiled"; }
    Return "Compiled";
}

Public Function OutputHash(String text) -> String
Explain {
    Description: "Hash compiler inputs.";
    Input: text = "Source, tests, target, and flags";
    Processing: "Fold the length and each character into a stable total.";
    Output: "The hash text.";
} {
    Int total = text.Length();
    Int index = 0;
    While (index < text.Length()) {
        total = total + text.GetChar(index).ToInt();
        index = index + 1;
    }
    Return total.ToString();
}

Public Function OutputStem(String path) -> String
Explain {
    Description: "Read the file name without its .rx extension.";
    Input: path = "A source path";
    Processing: "Drop the directory and the .rx suffix.";
    Output: "The stem.";
} {
    Int slash = path.LastIndexOf("/");
    Int back = path.LastIndexOf("\\");
    If (back > slash) { slash = back; }
    String name = path;
    If (slash >= 0) { name = path.Substring(slash + 1); }
    If (name.EndsWith(".rx")) { name = name.Substring(0, name.Length() - 3); }
    Return name;
}

Public Function ProjectEntry(String project) -> String
Explain {
    Description: "Read the entry path from project text.";
    Input: project = ".rxp text";
    Processing: "Read the quoted string after Entry.";
    Output: "The entry path, or empty.";
} {
    Int at = project.IndexOf("Entry: \"");
    If (at < 0) { Return ""; }
    Int open = at + 8;
    String tail = project.Substring(open);
    Int relative = tail.IndexOf("\"");
    If (relative < 0) { Return ""; }
    Return tail.Substring(0, relative);
}

Public Function ProjectHeading(String project) -> String
Explain {
    Description: "Read the project name from project text.";
    Input: project = ".rxp text";
    Processing: "Read the quoted name after Project.";
    Output: "The project name, or empty.";
} {
    Int at = project.IndexOf("Project \"");
    If (at < 0) { Return ""; }
    Int open = at + 9;
    String tail = project.Substring(open);
    Int relative = tail.IndexOf("\"");
    If (relative < 0) { Return ""; }
    Return tail.Substring(0, relative);
}

Public Function CompilerSource(List<String> args) -> String
Explain {
    Description: "Find the file the compiler should open.";
    Input: args = "Compiler arguments";
    Processing: "Use the first source, test, or project path.";
    Output: "The path, or empty.";
} {
    Bool skip = False;
    For arg In args {
        If (skip) {
            skip = False;
            Continue;
        }
        String lower = arg.ToLower();
        If (lower == "--target" || lower == "--output") {
            skip = True;
            Continue;
        }
        If (arg.StartsWith("-")) { Continue; }
        If (lower == "compile" || lower == "build" || lower == "check" || lower == "analyze" || lower == "clean" || lower == "rebuild" || lower == "info" || lower == "cache") { Continue; }
        If (arg.EndsWith(".rx") || arg.EndsWith(".rxp")) { Return arg; }
    }
    Return "";
}

Public Function CompilerOutput(List<String> args) -> String
Explain {
    Description: "Read an explicit output path.";
    Input: args = "Compiler arguments";
    Processing: "Prefer --Output. Otherwise use a positional path that is not a source file.";
    Output: "The requested path, or empty.";
} {
    String named = OptionText(args, "--Output");
    If (named != "") { Return named; }
    Bool skip = False;
    Int files = 0;
    For arg In args {
        If (skip) {
            skip = False;
            Continue;
        }
        String lower = arg.ToLower();
        If (lower == "--target" || lower == "--output") {
            skip = True;
            Continue;
        }
        If (arg.StartsWith("-")) { Continue; }
        If (lower == "compile" || lower == "build" || lower == "check" || lower == "analyze" || lower == "clean" || lower == "rebuild") { Continue; }
        files = files + 1;
        If (files == 2 && !arg.EndsWith(".rx") && !arg.EndsWith(".rxp")) { Return arg; }
    }
    Return "";
}

Public Function CompilerOption(List<String> args) -> String
Explain {
    Description: "Validate compiler options.";
    Input: args = "Compiler arguments";
    Processing: "Accept implemented options. Reject unknown options and options that are not encoded yet.";
    Output: "A message, or empty when every option is accepted.";
} {
    For arg In args {
        String lower = arg.ToLower();
        If (!arg.StartsWith("-")) { Continue; }
        If (lower == "--ir" || lower == "--asm" || lower == "--target" || lower == "--output") { Continue; }
        If (lower == "--skiptests" || lower == "--nocache" || lower == "--verbose" || lower == "--debug") { Continue; }
        If (lower == "--release" || lower == "--optimize" || lower == "--nooptimize" || lower == "--symbols" || lower == "--nosymbols") { Continue; }
        If (lower == "--clean" || lower == "--rebuild" || lower == "--stats" || lower == "--help" || lower == "--version") { Continue; }
        If (lower == "--parallel" || lower == "--profile" || lower == "--analyze") { Continue; }
        If (lower == "-h" || lower == "-v") { Continue; }
        If (lower.StartsWith("--target=") || lower.StartsWith("--output=")) { Continue; }
        Return "Unknown option " + arg + ".";
    }
    Return "";
}

Public Function OptionText(List<String> args, String flag) -> String
Explain {
    Description: "Read the value of a compiler option.";
    Input: args = "Compiler arguments", flag = "The option name";
    Processing: "Accept a following argument or an equals form.";
    Output: "The value, or empty.";
} {
    String wanted = flag.ToLower();
    Int index = 0;
    While (index < args.Count()) {
        String arg = args[index];
        String lower = arg.ToLower();
        Int equals = lower.IndexOf("=");
        If (equals > 0 && lower.Substring(0, equals) == wanted) { Return arg.Substring(equals + 1); }
        If (lower == wanted && index + 1 < args.Count()) { Return args[index + 1]; }
        index = index + 1;
    }
    Return "";
}

Public Function CompileUnit(String sourcePath, String outputPath, String assembler, String mode, Bool skipTests, Bool noCache, Bool optimize, Bool showStats, Bool profileBuild, Bool analyze, Bool parallel, Bool writeSymbols) -> ExecutionResult
Explain {
    Description: "Compile one source file to the requested output.";
    Input: sourcePath = "Source file", outputPath = "Destination", assembler = "linux-x64 or windows-x64", mode = "program, asm, or ir", skipTests = "True to pass the test gate with a warning", noCache = "True to ignore the input hash", optimize = "True to run the optimizer", showStats = "True to print the duration", profileBuild = "True to label the build Profile", analyze = "True to print findings and skip the binary", parallel = "True to say this compiler builds one file", writeSymbols = "True to write a symbol file";
    Processing: "Reuse a matching hash. Otherwise test, lower RXIR, and assemble. Analysis stops after the optimizer. A program build also fills Bin, Libraries, Objects, and Symbols.";
    Output: "The compile result.";
} {
    If (!Files.Exists(sourcePath)) { Return FinishRun(ExitCode.InvalidArguments, "The source file was not found."); }
    Print("{blue}robixc{/}  {bold}" + sourcePath + "{/}  {muted}->{/}  {bold}" + outputPath + "{/}");
    String source = Files.ReadText(sourcePath);
    String rules = "";
    If (Files.Exists(".robixignore")) { rules = Files.ReadText(".robixignore"); }
    If (SourceIgnored(sourcePath, rules)) { Return FinishRun(ExitCode.InvalidArguments, "The source is excluded by .robixignore."); }
    String tests = "";
    If (sourcePath.EndsWith(".rx")) {
        String companion = sourcePath.Substring(0, sourcePath.Length() - 3) + ".test.rx";
        If (Files.Exists(companion)) { tests = Files.ReadText(companion); }
    }
    String profile = "Release";
    If (!optimize) { profile = "Debug"; }
    If (profileBuild) { profile = "Profile"; }
    If (parallel) { Print("{info}This compiler builds one file at a time.{/}"); }
    String current = OutputHash(source + "\n" + tests + "\n" + assembler + "\n" + mode + "\n" + profile + "\n0.0.48");
    String cache = CacheFile(outputPath);
    String saved = "";
    If (!noCache && Files.Exists(cache)) { saved = Files.ReadText(cache); }
    Bool hadOutput = Files.Exists(outputPath);
    String status = CacheStatus(saved, current, hadOutput);
    If (status == "Skipped") {
        NoteCache("hit");
        Print("{info}Tests Skipped - No Relevant Changes{/}");
        Print("Skipped");
        Print("{blue}skipped{/}  {bold}" + outputPath + "{/}");
        Return FinishRun(ExitCode.Success, "Skipped " + outputPath + ".");
    }
    NoteCache("miss");
    Int compileStart = ClockMillis();
    SyntaxCompiler compiler = SyntaxCompiler();
    If (skipTests) { compiler.GateTests = False; }
    CompileResult result = compiler.CompileSource(source, sourcePath, True);
    Int warnings = 0;
    For line In compiler.DiagnosticsOf(result) {
        Print(line);
        If (line.StartsWith("warning")) { warnings = warnings + 1; }
    }
    If (!result.Succeeded) {
        Print("Failed");
        Return FinishRun(ExitCode.ErrorExecution, "Compilation failed.");
    }
    If (skipTests) {
        Print("{warning}--SkipTests{/}  tests were not run.");
    } Else {
        Interpreter tester = Interpreter();
        For line In tester.RequireTests(sourcePath, result.Module) {
            Print(line);
            Print("Failed");
            Return FinishRun(ExitCode.ErrorExecution, "Compilation failed.");
        }
    }
    String rxir = result.Rxir;
    If (optimize || profileBuild || analyze) {
        RxPass passes = RxPass();
        rxir = passes.Optimize(rxir);
    }
    If (analyze) {
        Int elapsed = ClockMillis() - compileStart;
        Print("{muted}compile{/}  {blue}" + elapsed.ToString() + " ms{/}  {muted}warnings{/} " + warnings.ToString());
        Print("{info}checker and optimizer{/}  findings are printed above");
        Return FinishRun(ExitCode.Success, "Analysis finished.");
    }
    EnsureFolder(outputPath);
    If (mode == "ir") {
        Files.WriteText(outputPath, rxir);
        Files.WriteText(cache, current);
        PlaceBuildTree(outputPath, rxir, DeclarationLines(source, "Import "), DeclarationLines(source, "Function "), writeSymbols);
        Print(status);
        Print("{success}compiled{/}  {bold}" + outputPath + "{/}");
        Return FinishRun(ExitCode.Success, "Wrote " + outputPath + ".");
    }
    RxAssembler assemblerTool = RxAssembler();
    assemblerTool.Target = "linux-x64";
    If (assembler == "windows-x64") { assemblerTool.Target = "windows-x64"; }
    String selected = assemblerTool.Select(rxir);
    String rxasm = assemblerTool.WithStart(selected);
    If (assembler == "windows-x64") { rxasm = assemblerTool.WithWindows(selected); }
    If (mode == "asm") {
        Files.WriteText(outputPath, rxasm);
        Files.WriteText(cache, current);
        PlaceBuildTree(outputPath, rxasm, DeclarationLines(source, "Import "), DeclarationLines(source, "Function "), writeSymbols);
        Print(status);
        Print("{success}compiled{/}  {bold}" + outputPath + "{/}");
        Return FinishRun(ExitCode.Success, "Wrote " + outputPath + ".");
    }
    If (rxasm.IndexOf("; skip") >= 0) {
        Print("Failed");
        Return FinishRun(ExitCode.ErrorExecution, "The assembler does not encode this program yet.");
    }
    List<Int> code = assemblerTool.Assemble(rxasm);
    If (code.Count() == 0) {
        Print("Failed");
        Return FinishRun(ExitCode.ErrorExecution, "Assembly failed.");
    }
    If (assembler == "windows-x64") {
        PeImage pe = PeImage();
        Files.WriteBytes(outputPath, pe.Wrap(code));
    } Else {
        ElfImage elf = ElfImage();
        Files.WriteBytes(outputPath, elf.Wrap(code));
    }
    Files.WriteText(cache, current);
    Files.WriteText(InfoFile(outputPath), "Target: " + assembler + "\nProfile: " + profile + "\nOutput: " + outputPath + "\n");
    String listingPath = outputPath + ".rxasm";
    Files.WriteText(listingPath, rxasm);
    PlaceBuildTree(outputPath, rxasm, DeclarationLines(source, "Import "), DeclarationLines(source, "Function "), writeSymbols);
    If (assembler == "windows-x64") {
        PeImage binImage = PeImage();
        Files.WriteBytes(BuildLeaf(outputPath, "Bin"), binImage.Wrap(code));
    } Else {
        ElfImage binImage = ElfImage();
        Files.WriteBytes(BuildLeaf(outputPath, "Bin"), binImage.Wrap(code));
    }
    Print(status);
    Print("Linked");
    Print("{success}compiled{/}  {bold}" + outputPath + "{/}");
    If (showStats || profileBuild) {
        Int elapsed = ClockMillis() - compileStart;
        Print("{muted}compile{/}  {blue}" + elapsed.ToString() + " ms{/}  {muted}warnings{/} " + warnings.ToString());
    }
    Return FinishRun(ExitCode.Success, "Wrote " + outputPath + ".");
}

Public Function CacheFile(String outputPath) -> String
Explain {
    Description: "Locate the hash file for an output.";
    Input: outputPath = "The compiled file";
    Processing: "Store the hash beside the output in Cache.";
    Output: "The hash path.";
} {
    Int slash = outputPath.LastIndexOf("/");
    String folder = ".";
    If (slash >= 0) { folder = outputPath.Substring(0, slash); }
    Return folder + "/Cache/input.hash";
}

Public Function InfoFile(String outputPath) -> String
Explain {
    Description: "Locate the build information file.";
    Input: outputPath = "The compiled file";
    Processing: "Store BuildInfo next to the output.";
    Output: "The information path.";
} {
    Int slash = outputPath.LastIndexOf("/");
    String folder = ".";
    If (slash >= 0) { folder = outputPath.Substring(0, slash); }
    Return folder + "/BuildInfo";
}

Public Function CompilerProject() -> String
Explain {
    Description: "Find the project file for a compiler build.";
    Input: None;
    Processing: "Prefer Robix.rxp, then another .rxp in the working directory.";
    Output: "The project path, or empty.";
} {
    If (Files.Exists("Robix.rxp")) { Return "Robix.rxp"; }
    For relative In Directory.Files(".") {
        If (relative.EndsWith(".rxp") && !relative.Contains("/") && !relative.Contains("\\")) { Return relative; }
    }
    Return "";
}

Public Function RuntimeObject(String target) -> String
Explain {
    Description: "Report that no C++ runtime file is linked.";
    Input: target = "linux-x64, windows-x64, or host";
    Processing: "Every target carries the Robix bump runtime.";
    Output: "An empty string.";
} {
    If (target == "none") { Return ""; }
    Return "";
}

Private Function CheckSource(String sourcePath) -> ExecutionResult {
    If (!Files.Exists(sourcePath)) { Return FinishRun(ExitCode.InvalidArguments, "The source file was not found."); }
    String source = Files.ReadText(sourcePath);
    SyntaxCompiler compiler = SyntaxCompiler();
    CompileResult result = compiler.CompileSource(source, sourcePath, False);
    For line In compiler.DiagnosticsOf(result) { Print(line); }
    If (!result.Succeeded) { Return FinishRun(ExitCode.ErrorExecution, "Check failed."); }
    Interpreter tester = Interpreter();
    For line In tester.RequireTests(sourcePath, result.Module) {
        Print(line);
        Return FinishRun(ExitCode.ErrorExecution, "Check failed.");
    }
    Return FinishRun(ExitCode.Success, "Check passed.");
}

Private Function EnsureFolder(String outputPath) -> Void {
    Int slash = outputPath.LastIndexOf("/");
    String folder = ".";
    If (slash >= 0) { folder = outputPath.Substring(0, slash); }
    Directory.Create("Build");
    Directory.Create(folder);
    Directory.Create(folder + "/Cache");
}

Private Function FinishRun(Int code, String reason) -> ExecutionResult {
    String tone = "success";
    String name = "success";
    If (code == 1) { tone = "warning"; name = "warning"; }
    If (code == 2) { tone = "error"; name = "execution error"; }
    If (code == 3) { tone = "error"; name = "fatal error"; }
    If (code == 4) { tone = "error"; name = "invalid arguments"; }
    If (code == 5) { tone = "error"; name = "permission denied"; }
    If (code == 6) { tone = "error"; name = "resource unavailable"; }
    If (code > 6 || code < 0) { tone = "error"; name = "custom"; }
    Print("{muted}────────────────────────────────{/}");
    Print("{" + tone + "}exit " + code.ToString() + "{/}  {" + tone + "}" + name + "{/}  " + reason);
    Directory.Create(".robix");
    Files.WriteText(".robix/last.txt", reason);
    Return ExecutionResult(code, reason);
}

Public Function BuildLeaf(String outputPath, String folderName) -> String
Explain {
    Description: "Place a file inside a build folder.";
    Input: outputPath = "The compiled file", folderName = "Bin, Libraries, Objects, or Symbols";
    Processing: "Keep the file name and move it under the named folder.";
    Output: "The folder path.";
} {
    Int slash = outputPath.LastIndexOf("/");
    String folder = ".";
    String leaf = outputPath;
    If (slash >= 0) {
        folder = outputPath.Substring(0, slash);
        leaf = outputPath.Substring(slash + 1);
    }
    Return folder + "/" + folderName + "/" + leaf;
}

Public Function DeclarationLines(String source, String needle) -> String
Explain {
    Description: "Collect source lines that contain a word.";
    Input: source = "Source text", needle = "Import or Function";
    Processing: "Keep each line that contains the word.";
    Output: "The matching lines.";
} {
    String found = "";
    Int start = 0;
    Int index = 0;
    While (index <= source.Length()) {
        Bool boundary = index == source.Length();
        If (!boundary && source.Substring(index, 1) == "\n") { boundary = True; }
        If (boundary && index > start) {
            String line = source.Substring(start, index - start);
            If (line.Contains(needle)) { found = found + line + "\n"; }
        }
        If (boundary) { start = index + 1; }
        index = index + 1;
    }
    Return found;
}

Public Function SourceIgnored(String path, String rules) -> Bool
Explain {
    Description: "Decide whether a compiler input is excluded.";
    Input: path = "A source path", rules = "The ignore file text";
    Processing: "Match a directory rule, an exact path, or a trailing star.";
    Output: "True when the path is excluded.";
} {
    String normalized = path;
    While (normalized.Contains("\\")) {
        Int slash = normalized.IndexOf("\\");
        normalized = normalized.Substring(0, slash) + "/" + normalized.Substring(slash + 1);
    }
    Int start = 0;
    Int index = 0;
    While (index <= rules.Length()) {
        Bool boundary = index == rules.Length();
        If (!boundary && rules.Substring(index, 1) == "\n") { boundary = True; }
        If (boundary && index > start) {
            String rule = rules.Substring(start, index - start);
            If (rule != "" && !rule.StartsWith("#")) {
                If (rule.EndsWith("/")) { rule = rule.Substring(0, rule.Length() - 1); }
                If (rule.EndsWith("*")) {
                    String prefix = rule.Substring(0, rule.Length() - 1);
                    If (prefix != "" && normalized.StartsWith(prefix)) { Return True; }
                }
                If (normalized == rule || normalized.StartsWith(rule + "/") || normalized.Contains("/" + rule + "/")) { Return True; }
            }
        }
        If (boundary) { start = index + 1; }
        index = index + 1;
    }
    Return False;
}

Public Function PlaceBuildTree(String outputPath, String listing, String imports, String symbols, Bool writeSymbols) -> Int
Explain {
    Description: "Write the build folders beside a compiler output.";
    Input: outputPath = "The compiled file", listing = "RXASM or RXIR text", imports = "Import lines", symbols = "Function lines", writeSymbols = "True to write the symbol file";
    Processing: "Create Bin, Libraries, Objects, and Symbols. Write the listing, the link list, and the symbol file when requested.";
    Output: "1 after the folders exist.";
} {
    Int slash = outputPath.LastIndexOf("/");
    String folder = ".";
    String leaf = outputPath;
    If (slash >= 0) {
        folder = outputPath.Substring(0, slash);
        leaf = outputPath.Substring(slash + 1);
    }
    If (leaf.EndsWith(".rxasm")) { leaf = leaf.Substring(0, leaf.Length() - 6); }
    If (leaf.EndsWith(".rxir")) { leaf = leaf.Substring(0, leaf.Length() - 5); }
    Directory.Create(folder);
    Directory.Create(folder + "/Bin");
    Directory.Create(folder + "/Libraries");
    Directory.Create(folder + "/Objects");
    Directory.Create(folder + "/Symbols");
    Files.WriteText(folder + "/Objects/" + leaf + ".rxasm", listing);
    Files.WriteText(folder + "/Libraries/link.txt", imports);
    If (writeSymbols) { Files.WriteText(folder + "/Symbols/" + leaf + ".sym", symbols); }
    Return 1;
}

Private Function NoteCache(String word) -> Void {
    Directory.Create(".robix");
    String prior = "";
    If (Files.Exists(".robix/compile-stats.txt")) { prior = Files.ReadText(".robix/compile-stats.txt"); }
    Files.WriteText(".robix/compile-stats.txt", prior + word + "\n");
}

Public Function CacheSummary() -> String
Explain {
    Description: "Count compile cache hits and misses.";
    Input: None;
    Processing: "Read .robix/compile-stats.txt. A missing file reports zero.";
    Output: "Hits, misses, and the file size in lines.";
} {
    String text = "";
    If (Files.Exists(".robix/compile-stats.txt")) { text = Files.ReadText(".robix/compile-stats.txt"); }
    Int hits = 0;
    Int misses = 0;
    Int lines = 0;
    Int start = 0;
    Int index = 0;
    While (index <= text.Length()) {
        Bool boundary = index == text.Length();
        If (!boundary && text.Substring(index, 1) == "\n") { boundary = True; }
        If (boundary && index > start) {
            String line = text.Substring(start, index - start);
            lines = lines + 1;
            If (line == "hit") { hits = hits + 1; }
            If (line == "miss") { misses = misses + 1; }
        }
        If (boundary) { start = index + 1; }
        index = index + 1;
    }
    Return "Hits " + hits.ToString() + "\nMisses " + misses.ToString() + "\nLines " + lines.ToString() + "\n";
}

Public Function ShowToolchain() -> ExecutionResult
Explain {
    Description: "Print the toolchain directories.";
    Input: None;
    Processing: "Report Bin, Library, Shared, and Packages, plus the toolchain path.";
    Output: "The toolchain result.";
} {
    Print("Toolchain " + ToolchainPath());
    If (Directory.Exists("Bin")) { Print("Bin"); } Else { Print("Bin missing"); }
    If (Directory.Exists("Library")) { Print("Library"); } Else { Print("Library missing"); }
    If (Directory.Exists("Shared")) { Print("Shared"); } Else { Print("Shared missing"); }
    If (Directory.Exists("Packages")) { Print("Packages"); } Else { Print("Packages missing"); }
    Return FinishRun(ExitCode.Success, "Toolchain printed.");
}

Public Function ShowLink(String outputPath) -> ExecutionResult
Explain {
    Description: "Report whether a program was linked.";
    Input: outputPath = "The compiled file";
    Processing: "A present output is Linked. An empty Objects folder has nothing to link.";
    Output: "The link result.";
} {
    If (Files.Exists(outputPath)) {
        Print("Linked");
        Return FinishRun(ExitCode.Success, "Linked " + outputPath + ".");
    }
    Return FinishRun(ExitCode.ErrorExecution, "There is nothing to link.");
}

Public Function ShowListing(String outputPath) -> ExecutionResult
Explain {
    Description: "Print a saved assembly listing.";
    Input: outputPath = "The compiled file";
    Processing: "Read the .rxasm file beside the output, then Objects.";
    Output: "The listing result.";
} {
    String listing = outputPath;
    If (!listing.EndsWith(".rxasm")) { listing = outputPath + ".rxasm"; }
    If (!Files.Exists(listing)) { listing = BuildLeaf(outputPath, "Objects"); }
    If (!listing.EndsWith(".rxasm")) { listing = listing + ".rxasm"; }
    If (!Files.Exists(listing)) { Return FinishRun(ExitCode.InvalidArguments, "No assembly listing was saved."); }
    Print(Files.ReadText(listing));
    Return FinishRun(ExitCode.Success, "Assembly listing printed.");
}

Public Function ShowSymbols(String outputPath) -> ExecutionResult
Explain {
    Description: "Print a saved symbol file.";
    Input: outputPath = "The compiled file";
    Processing: "Read Symbols/name.sym beside the output.";
    Output: "The symbol result.";
} {
    String path = BuildLeaf(outputPath, "Symbols");
    If (path.EndsWith(".rxasm")) { path = path.Substring(0, path.Length() - 6); }
    If (!path.EndsWith(".sym")) { path = path + ".sym"; }
    If (!Files.Exists(path)) { Return FinishRun(ExitCode.InvalidArguments, "No symbol file was saved. Pass --Symbols."); }
    Print(Files.ReadText(path));
    Return FinishRun(ExitCode.Success, "Symbols printed.");
}

Public Function ShowDependencies(String outputPath) -> ExecutionResult
Explain {
    Description: "Print recorded link dependencies.";
    Input: outputPath = "The compiled file";
    Processing: "Read Libraries/link.txt beside the output.";
    Output: "The dependency result.";
} {
    Int slash = outputPath.LastIndexOf("/");
    String folder = ".";
    If (slash >= 0) { folder = outputPath.Substring(0, slash); }
    String path = folder + "/Libraries/link.txt";
    If (!Files.Exists(path)) { Return FinishRun(ExitCode.InvalidArguments, "No link dependencies were saved."); }
    Print(Files.ReadText(path));
    Return FinishRun(ExitCode.Success, "Dependencies printed.");
}

Public Function ShowExplain() -> ExecutionResult
Explain {
    Description: "Explain the latest compiler diagnostic.";
    Input: None;
    Processing: "Read .robix/last.txt. A missing file says there is nothing to explain.";
    Output: "The explanation result.";
} {
    If (!Files.Exists(".robix/last.txt")) { Return FinishRun(ExitCode.InvalidArguments, "There is no diagnostic to explain."); }
    String text = Files.ReadText(".robix/last.txt");
    Print(text);
    Return FinishRun(ExitCode.Success, "Explanation printed.");
}

Public Function ShowReport(String outputPath) -> ExecutionResult
Explain {
    Description: "Write a build report.";
    Input: outputPath = "The compiled file";
    Processing: "Copy BuildInfo into .robix/build-report.txt.";
    Output: "The report result.";
} {
    String info = "";
    String infoPath = InfoFile(outputPath);
    If (Files.Exists(infoPath)) { info = Files.ReadText(infoPath); }
    If (info == "") { info = "No build information.\n"; }
    Directory.Create(".robix");
    Files.WriteText(".robix/build-report.txt", info);
    Print(info);
    Return FinishRun(ExitCode.Success, "Build report written.");
}
