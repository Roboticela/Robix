// Tests for Compiler/Pe.rx.

Test Low32 { Output: True; }

Test ImportRva {
    Case "next page" {
        Input: codeSize = 1;
        Assert: Result == 8192;
    }
    Case "full page" {
        Input: codeSize = 4096;
        Assert: Result == 8192;
    }
    Case "second page" {
        Input: codeSize = 4097;
        Assert: Result == 12288;
    }
}

Test Wrap { Output: True; }
Test Magic { Output: True; }

