// Tests for Compiler/Rxir.rx.

Test MachineType {
    Case "int" {
        Input: robixType = "Int";
        Assert: Result == "i64";
    }
    Case "float" {
        Input: robixType = "Float";
        Assert: Result == "f64";
    }
    Case "bool" {
        Input: robixType = "Bool";
        Assert: Result == "i8";
    }
    Case "string" {
        Input: robixType = "String";
        Assert: Result == "ptr";
    }
    Case "void" {
        Input: robixType = "Void";
        Assert: Result == "void";
    }
    Case "int32" {
        Input: robixType = "Int32";
        Assert: Result == "i32";
    }
}

Test LowerModule {
    Case "empty module" {
        Input: module = AstNode();
        Assert: Result == "";
    }
}

Test ReturnZero {
    Case "unboxed zero" {
        Input:;
        Assert: Result.IndexOf("const i64 0") >= 0 && Result.IndexOf("ret i64") >= 0 && Result.IndexOf("bitcast") < 0;
    }
}

Test AddTwo {
    Case "unboxed add" {
        Input:;
        Assert: Result.IndexOf("add i64") >= 0 && Result.IndexOf("bitcast") < 0;
    }
}

Test FloatOne {
    Case "unboxed float" {
        Input:;
        Assert: Result.IndexOf("const f64 1.5") >= 0 && Result.IndexOf("bitcast") < 0;
    }
}

Test BoolTrue {
    Case "unboxed bool" {
        Input:;
        Assert: Result.IndexOf("const i8 1") >= 0 && Result.IndexOf("ret i8") >= 0;
    }
}

Test HelloLines {
    Case "greeting and total" {
        Input:;
        Assert: Result.IndexOf("print str str0") >= 0 && Result.IndexOf("Hello, Robix") >= 0 && Result.IndexOf("print i64") >= 0 && Result.IndexOf("add i64") >= 0 && Result.IndexOf("cmp le") >= 0 && Result.IndexOf("note") < 0 && Result.IndexOf("call") < 0;
    }
}

Test FoldTwo {
    Case "constant three" {
        Input:;
        Assert: Result.IndexOf("const i64 3") >= 0 && Result.IndexOf("call") < 0;
    }
}

