Test AddImm {
    Case "add rsp, 8" {
        Input: dest = "rsp", value = 8;
        Assert: Result[0] == 72 && Result[1] == 131 && Result[2] == 196 && Result[3] == 8;
    }
}

Test SubImm {
    Case "sub rsp, 8" {
        Input: dest = "rsp", value = 8;
        Assert: Result[0] == 72 && Result[1] == 131 && Result[2] == 236 && Result[3] == 8;
    }
}

Test LeaRip {
    Case "lea rsi, rip" {
        Input: dest = "rsi", displacement = 0;
        Assert: Result[0] == 72 && Result[1] == 141 && Result[2] == 53 && Result[3] == 0;
    }
}

Test NegReg {
    Case "neg rdi" {
        Input: dest = "rdi";
        Assert: Result[0] == 72 && Result[1] == 247 && Result[2] == 223;
