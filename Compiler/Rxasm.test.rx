Test CallRel {
    Case "zero displacement" {
        Input: displacement = 0;
        Assert: Result[0] == 232 && Result[1] == 0;
    }
}

Test JmpRel {
    Output: True;
}

Test JccRel {
    Case "je" {
        Input: condition = "je", displacement = 0;
        Assert: Result[0] == 15 && Result[1] == 132;
    }
}

Test RegLow {
    Case "rbx" {
        Input: name = "rbx";
        Assert: Result == 3;
    }
}

Test RegHigh {
    Case "r12" {
        Input: name = "r12";
        Assert: Result == 1;
    }
}

Test Select {
    Case "return zero" {
        Input: rxir = "function Main() -> i64\nblock entry\n  %0 = const i64 0\n  ret i64 %0\n";
        Assert: Result.IndexOf("Main:") >= 0 && Result.IndexOf("ret") >= 0 && Result.IndexOf("; skip") < 0;
    }
}

Test WithStart {
    Case "adds entry" {
        Input: rxasm = "Main:\n    ret\n";
        Assert: Result.IndexOf("_start:") >= 0 && Result.IndexOf("syscall") >= 0;
    }
}

Test Assemble {
    Case "ret" {
        Input: rxasm = "ret\n";
        Assert: Result[0] == 195;
    }
    Case "slot store" {
        Input: rxasm = "mov [rsp+0], rax\n";
        Assert: Result[0] == 72 && Result[1] == 137 && Result[2] == 132 && Result[3] == 36;
    }
    Case "greeting bytes" {
        Input: rxasm = "lea rsi, str0\nstr0:\nascii \"Hi\"\n";
        Assert: Result[1] == 141 && Result[7] == 72 && Result[8] == 105 && Result[9] == 10;
    }
}

Test ProgramZero {
    Case "call" {
        Input:;
        Assert: Result == 232;
    }
}

Test ProgramSyscall {
    Case "exit" {
        Input:;
        Assert: Result == 1;
    }
}

Test RetCode {
    Case "ret" {
        Input:;
