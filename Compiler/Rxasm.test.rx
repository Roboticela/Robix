// Tests for Compiler/Rxasm.rx.

Test MovImm {
    Case "rax zero" {
        Input: dest = "rax", value = 0;
        Assert: Result[0] == 72 && Result[1] == 199 && Result[2] == 192 && Result[3] == 0;
    }
}

Test MovReg {
    Case "mov rdi, rax" {
        Input: dest = "rdi", source = "rax";
        Assert: Result[0] == 72 && Result[1] == 137 && Result[2] == 199;
    }
}

Test AddReg {
    Case "add rax, rcx" {
        Input: dest = "rax", source = "rcx";
        Assert: Result[0] == 72 && Result[1] == 1 && Result[2] == 200;
    }
}

Test SubReg {
    Output: True;
}

