Test MovAl {
    Case "newline" {
        Input: value = 10;
        Assert: Result[0] == 176 && Result[1] == 10;
    }
}

Test MovMem8 {
    Case "al at r10" {
        Input: base = "r10", byteReg = "al";
        Assert: Result[0] == 65 && Result[1] == 136 && Result[2] == 2;
    }
    Case "dl at r10" {
        Input: base = "r10", byteReg = "dl";
        Assert: Result[0] == 65 && Result[1] == 136 && Result[2] == 18;
    }
}

Test MovStoreRsp {
    Case "rax at zero" {
        Input: displacement = 0, source = "rax";
        Assert: Result[0] == 72 && Result[1] == 137 && Result[2] == 132 && Result[3] == 36 && Result[4] == 0;
    }
}

Test MovLoadRsp {
    Case "rax at zero" {
        Input: dest = "rax", displacement = 0;
        Assert: Result[0] == 72 && Result[1] == 139 && Result[2] == 132 && Result[3] == 36 && Result[4] == 0;
    }
}

