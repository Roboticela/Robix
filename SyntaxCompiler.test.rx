// Tests for SyntaxCompiler.rx.

Test SyntaxCompiler.CompileSource {
    Case "compiles valid snippet" {
        Input: source = "Package Robotics.Sample;", fileName = "Sample.rx", compile = False;
        Assert: Result != Null;
    }
}

Test RequireFunctionTests {
    Case "missing companion is an error" {
        Input: fileName = "MissingCompanion.rx", module = AstNode(Kind: AstKind.Function, Name: "Main", Line: 3, Column: 1, Children: []), diagnostics = DiagnosticBag();
        Assert: diagnostics.ErrorCount() == 1;
    }
    Case "a test file is not required to test itself" {
        Input: fileName = "Already.test.rx", module = AstNode(Kind: AstKind.Function, Name: "Main", Line: 1, Column: 1, Children: []), diagnostics = DiagnosticBag();
        Assert: diagnostics.ErrorCount() == 0;
    }
}

Test CollectTestCoverage { Output: True; }
Test CoverageListed { Output: True; }
Test ReportUntestedFunctions { Output: True; }
Test ImportedDeclaration { Output: True; }

Test SyntaxCompiler.DiagnosticsOf {
    Case "empty module has no diagnostics" {
        Input: result = CompileResult();
        Assert: Result != Null;
    }
}

Test LoadImports { Output: True; }
Test LoadPackage { Output: True; }
Test ImportLine { Output: True; }
Test ImportColumn { Output: True; }
Test RequireUses { Output: True; }
Test IsBinder { Output: True; }
Test IsNameStart { Output: True; }
Test IsNamePart { Output: True; }
Test IsNameCode { Output: True; }
Test IsNamePartCode { Output: True; }
Test TypeCatalog { Output: True; }
Test PackageName { Output: True; }
Test CollectTypes { Output: True; }
Test TypeNameOn { Output: True; }
Test DirectImports { Output: True; }
