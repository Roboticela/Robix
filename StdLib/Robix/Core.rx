package Robix.Core;

public Function Abs(Int x) -> Int {
    if (x < 0) {
        return 0 - x;
    }
    return x;
}

public Function Min(Int a, Int b) -> Int {
    if (a < b) {
        return a;
    }
    return b;
}

public Function Max(Int a, Int b) -> Int {
    if (a > b) {
        return a;
    }
    return b;
}

public Function Clamp(Int value, Int low, Int high) -> Int {
    return Min(Max(value, low), high);
}
