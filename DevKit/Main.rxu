<Screen name="DevKit" title="RobixUI" theme="dark" place="center" state="normal" overflow="scroll" display="flex" direction="column" align="start" gap="18" padding="24" background="#080A10">
  <Text value="Screen" fontSize="22" font="sans-semibold"/>
  <Text value="This window is place center and state normal. The samples below are theme, background, and size." fontSize="13"/>
  <Text value="Drag this sentence to select it. Double-click a word. Ctrl+C copies. Escape clears." fontSize="13"/>
  <Text value="This line cannot be selected." fontSize="13" selectable="false"/>
  <View direction="row" gap="16" align="start">
    <View direction="column" gap="6" align="start">
      <Screen theme="dark" width="168" height="72" background="#080A10"/>
      <Text value="Dark" fontSize="12"/>
    </View>
    <View direction="column" gap="6" align="start">
      <Screen theme="light" width="168" height="72" background="#F4F6FC"/>
      <Text value="Light" fontSize="12"/>
    </View>
    <View direction="column" gap="6" align="start">
      <Screen theme="dark" width="168" height="72" background="#0E7AFF"/>
      <Text value="Background" fontSize="12"/>
    </View>
    <View direction="column" gap="6" align="start">
      <Window title="Window" theme="dark" width="168" height="72" background="#1C2430"/>
      <Text value="Window" fontSize="12"/>
    </View>
    <View direction="column" gap="6" align="start">
      <Page title="Page" theme="dark" width="120" height="72" background="#243044"/>
      <Text value="Page" fontSize="12"/>
    </View>
  </View>

  <Text value="View" fontSize="22" font="sans-semibold"/>
  <Text value="Row" fontSize="13" font="sans-semibold"/>
  <View direction="row" width="280" height="36" gap="0" align="start" background="#141820">
    <View width="28" height="20" background="#E23B3B"/>
    <View width="28" height="20" background="#2F9E44"/>
    <View width="28" height="20" background="#0E7AFF"/>
  </View>

  <Text value="Column" fontSize="13" font="sans-semibold"/>
  <View direction="column" width="48" height="96" gap="4" align="start" background="#141820">
    <View width="28" height="20" background="#E23B3B"/>
    <View width="28" height="20" background="#2F9E44"/>
    <View width="28" height="20" background="#0E7AFF"/>
  </View>

  <Text value="Row reverse" fontSize="13" font="sans-semibold"/>
  <View direction="row-reverse" width="280" height="36" gap="8" align="start" background="#141820">
    <View width="28" height="20" background="#E23B3B"/>
    <View width="28" height="20" background="#2F9E44"/>
    <View width="28" height="20" background="#0E7AFF"/>
  </View>

  <Text value="Column reverse" fontSize="13" font="sans-semibold"/>
