  </View>

  <Text value="Space evenly" fontSize="13" font="sans-semibold"/>
  <View direction="row" width="180" height="32" justify="space-evenly" align="start" gap="0" background="#141820">
    <View width="28" height="20" background="#E23B3B"/>
    <View width="28" height="20" background="#2F9E44"/>
    <View width="28" height="20" background="#0E7AFF"/>
  </View>

  <Text value="Gap" fontSize="13" font="sans-semibold"/>
  <View direction="row" width="180" height="32" gap="16" align="start" background="#141820">
    <View width="28" height="20" background="#E23B3B"/>
    <View width="28" height="20" background="#2F9E44"/>
    <View width="28" height="20" background="#0E7AFF"/>
  </View>

  <Text value="Fill" fontSize="13" font="sans-semibold"/>
  <View width="180" height="36" background="#141820">
    <View fill="true" background="#0E7AFF"/>
  </View>

  <Text value="Wrap" fontSize="13" font="sans-semibold"/>
  <View direction="row" width="120" height="56" wrap="wrap" gap="8" align="start" background="#141820">
    <View width="48" height="20" background="#E23B3B"/>
    <View width="48" height="20" background="#2F9E44"/>
    <View width="48" height="20" background="#0E7AFF"/>
  </View>

  <Text value="Overflow scroll" fontSize="13" font="sans-semibold"/>
  <View direction="row" width="160" height="44" overflow="scroll" gap="8" align="start" padding="8" background="#141820">
    <View width="70" height="20" background="#E23B3B"/>
    <View width="70" height="20" background="#2F9E44"/>
    <View width="70" height="20" background="#0E7AFF"/>
  </View>

  <Text value="Content size" fontSize="13" font="sans-semibold"/>
  <View direction="row" size="content" gap="8" align="start" background="#141820">
    <View width="28" height="20" background="#E23B3B"/>
    <View width="40" height="20" background="#2F9E44"/>
  </View>

  <Text value="Constraints" fontSize="13" font="sans-semibold"/>
  <View width="24" height="16" minWidth="72" minHeight="28" background="#0E7AFF"/>

  <Text value="Aspect ratio 2" fontSize="13" font="sans-semibold"/>
  <View width="64" aspectRatio="2" background="#0E7AFF"/>

  <Text value="Grow" fontSize="13" font="sans-semibold"/>
  <View direction="row" width="180" height="28" gap="0" align="start" background="#141820">
    <View width="20" height="20" grow="1" background="#E23B3B"/>
    <View width="20" height="20" grow="1" background="#0E7AFF"/>
  </View>

  <Text value="Shrink" fontSize="13" font="sans-semibold"/>
  <View direction="row" width="100" height="28" gap="0" align="start" background="#141820">
    <View width="70" height="20" shrink="1" background="#E23B3B"/>
    <View width="70" height="20" shrink="1" background="#0E7AFF"/>
  </View>

  <Text value="Order" fontSize="13" font="sans-semibold"/>
  <View direction="row" width="120" height="28" gap="8" align="start" background="#141820">
    <View width="28" height="20" order="2" background="#E23B3B"/>
    <View width="28" height="20" order="1" background="#2F9E44"/>
  </View>

  <Text value="Clip" fontSize="13" font="sans-semibold"/>
  <View width="80" height="36" overflow="clip" background="#141820">
    <View position="absolute" left="56" top="8" width="48" height="20" background="#0E7AFF"/>
  </View>

  <Text value="Container" fontSize="13" font="sans-semibold"/>
  <Container direction="row" width="120" height="36" gap="8" align="start" background="#141820">
    <View width="28" height="20" background="#E23B3B"/>
    <View width="28" height="20" background="#0E7AFF"/>
  </Container>

  <Text value="Image" fontSize="22" font="sans-semibold"/>
  <Text value="The harbor is 1920 by 1080. The crest keeps a clear background. The garden is a tall picture, so contain, cover, and fill each crop it differently." fontSize="13"/>

  <Text value="Harbor" fontSize="13" font="sans-semibold"/>
  <View direction="row" wrap="wrap" gap="16" align="start">
    <View direction="column" gap="6" align="start">
      <Image source="Images/harbor.jpg" alt="Harbor at dusk, JPEG" width="720" height="405" fit="cover"/>
      <Text value="JPEG, 1920 by 1080" fontSize="12"/>
    </View>
    <View direction="column" gap="6" align="start">
      <Image source="Images/harbor.svg" alt="Harbor at dusk, SVG" width="720" height="405" fit="contain"/>
      <Text value="SVG, the same harbor as vectors" fontSize="12"/>
    </View>
  </View>

  <Text value="Motion" fontSize="13" font="sans-semibold"/>
  <View direction="column" gap="6" align="start">
    <Image source="Images/harbor.gif" alt="Harbor with a moving boat" width="640" height="360" fit="cover"/>
    <Text value="GIF, eight frames, boat, birds, and window lights" fontSize="12"/>
  </View>

  <Text value="Crest" fontSize="13" font="sans-semibold"/>
  <Text value="PNG and WebP leave the page showing through. The SVG crest stays sharp at this size." fontSize="13"/>
  <View direction="row" wrap="wrap" gap="16" align="start">
    <View direction="column" gap="6" align="start">
      <Image source="Images/crest.png" alt="Crest, PNG" width="280" height="280" fit="contain"/>
      <Text value="PNG" fontSize="12"/>
    </View>
    <View direction="column" gap="6" align="start">
      <Image source="Images/crest.webp" alt="Crest, WebP" width="280" height="280" fit="contain"/>
      <Text value="WebP" fontSize="12"/>
    </View>
    <View direction="column" gap="6" align="start">
      <Image source="Images/crest.svg" alt="Crest, SVG" width="280" height="280" fit="contain"/>
      <Text value="SVG" fontSize="12"/>
    </View>
  </View>

  <Text value="Same harbor, other files" fontSize="13" font="sans-semibold"/>
  <View direction="row" wrap="wrap" gap="16" align="start">
    <View direction="column" gap="6" align="start">
      <Image source="Images/harbor.tif" alt="Harbor, TIFF" width="420" height="236" fit="cover"/>
      <Text value="TIFF" fontSize="12"/>
    </View>
    <View direction="column" gap="6" align="start">
      <Image source="Images/harbor.heic" alt="Harbor, HEIC" width="420" height="236" fit="cover"/>
      <Text value="HEIC" fontSize="12"/>
    </View>
  </View>

  <Text value="Fit" fontSize="13" font="sans-semibold"/>
  <Text value="One 1080 by 1620 garden, placed in a wide frame." fontSize="13"/>
  <View direction="row" wrap="wrap" gap="16" align="start">
    <View direction="column" gap="6" align="start">
      <Image source="Images/garden.png" alt="Garden contained" width="280" height="160" fit="contain" background="#141820"/>
      <Text value="Contain" fontSize="12"/>
    </View>
    <View direction="column" gap="6" align="start">
      <Image source="Images/garden.png" alt="Garden covered" width="280" height="160" fit="cover" background="#141820"/>
      <Text value="Cover" fontSize="12"/>
    </View>
    <View direction="column" gap="6" align="start">
      <Image source="Images/garden.png" alt="Garden filled" width="280" height="160" fit="fill" background="#141820"/>
      <Text value="Fill" fontSize="12"/>
    </View>
  </View>

  <Text value="Canvas" fontSize="22" font="sans-semibold"/>
  <Text value="A canvas is a draw list. Later draws cover earlier ones. Rect, disc, circle, line, and text are all in the harbor." fontSize="13"/>

  <Text value="Harbor at night" fontSize="13" font="sans-semibold"/>
  <Canvas width="720" height="400">
    <Rect x="0" y="0" width="720" height="228" color="#07111C"/>
    <Rect x="0" y="228" width="720" height="172" color="#0C2C40"/>
    <Disc x="150" y="246" radius="96" color="#12263A"/>
    <Disc x="560" y="268" radius="130" color="#0A1C2C"/>
    <Disc x="590" y="72" radius="40" color="#F4E2B0"/>
    <Circle x="608" y="58" radius="32" color="#07111C"/>
    <Disc x="80" y="36" radius="2" color="#F4F7FB"/>
    <Disc x="140" y="84" radius="1" color="#F4F7FB"/>
    <Disc x="210" y="42" radius="2" color="#F4F7FB"/>
    <Disc x="280" y="96" radius="1" color="#F4F7FB"/>
    <Disc x="360" y="30" radius="2" color="#F4F7FB"/>
    <Disc x="430" y="78" radius="1" color="#F4F7FB"/>
    <Disc x="500" y="40" radius="2" color="#F4F7FB"/>
    <Disc x="680" y="110" radius="1" color="#F4F7FB"/>
    <Line x1="70" y1="128" x2="84" y2="118" color="#C5D0DC"/>
    <Line x1="84" y1="118" x2="98" y2="128" color="#C5D0DC"/>
    <Line x1="168" y1="104" x2="182" y2="94" color="#C5D0DC"/>
    <Line x1="182" y1="94" x2="196" y2="104" color="#C5D0DC"/>
    <Line x1="400" y1="118" x2="414" y2="108" color="#C5D0DC"/>
    <Line x1="414" y1="108" x2="428" y2="118" color="#C5D0DC"/>
    <Rect x="48" y="168" width="22" height="78" color="#D9D3C8"/>
    <Rect x="40" y="154" width="38" height="16" color="#1C2430"/>
    <Circle x="59" y="162" radius="5" color="#F2C14E"/>
    <Rect x="0" y="278" width="720" height="16" color="#1B2C3A"/>
    <Rect x="214" y="258" width="176" height="28" color="#C4553A"/>
    <Rect x="268" y="232" width="62" height="28" color="#E8D7C1"/>
    <Rect x="280" y="240" width="16" height="12" color="#F2C14E"/>
    <Rect x="306" y="240" width="12" height="12" color="#7EB6D6"/>
    <Line x1="298" y1="232" x2="298" y2="156" color="#E8D7C1"/>
    <Line x1="298" y1="164" x2="378" y2="224" color="#F7FBFF"/>
    <Line x1="298" y1="164" x2="228" y2="220" color="#D5DEEA"/>
    <Line x1="228" y1="224" x2="378" y2="224" color="#C4553A"/>
    <Disc x="298" y="156" radius="4" color="#F2C14E"/>
    <Line x1="298" y1="164" x2="318" y2="164" color="#E23B3B"/>
    <Rect x="520" y="262" width="70" height="16" color="#243044"/>
    <Line x1="555" y1="262" x2="555" y2="236" color="#D9D3C8"/>
    <Line x1="0" y1="294" x2="719" y2="294" color="#1E5068"/>
    <Disc x="590" y="332" radius="18" color="#8A7350"/>
    <Disc x="59" y="328" radius="5" color="#F2C14E"/>
    <Disc x="640" y="318" radius="6" color="#E23B3B"/>
    <Line x1="640" y1="318" x2="640" y2="294" color="#D9D3C8"/>
    <Text x="36" y="24" value="Harbor at night" size="28" color="#F4F7FB" font="sans-semibold"/>
    <Text x="36" y="60" value="Rects, discs, a circle, lines, and text." size="14" color="#C5D0DC"/>
  </Canvas>

  <Text value="Each draw" fontSize="13" font="sans-semibold"/>
  <Canvas width="720" height="176">
    <Rect x="0" y="0" width="720" height="176" color="#10151C"/>
    <Rect x="28" y="28" width="100" height="64" color="#E23B3B"/>
    <Text x="28" y="108" value="Rect" size="14" color="#F4F7FB"/>
    <Disc x="230" y="60" radius="32" color="#2F9E44"/>
    <Text x="206" y="108" value="Disc" size="14" color="#F4F7FB"/>
    <Circle x="390" y="60" radius="32" color="#0E7AFF"/>
    <Text x="360" y="108" value="Circle" size="14" color="#F4F7FB"/>
    <Line x1="500" y1="28" x2="600" y2="92" color="#F2C14E"/>
    <Text x="528" y="108" value="Line" size="14" color="#F4F7FB"/>
    <Text x="632" y="40" value="Text" size="28" color="#F4F7FB" font="sans-semibold"/>
    <Text x="632" y="108" value="Text" size="14" color="#F4F7FB"/>
  </Canvas>

  <Text value="Draw order" fontSize="13" font="sans-semibold"/>
  <Text value="The list is painted from first to last, so the line and the words sit on top of the shapes." fontSize="13"/>
  <Canvas width="720" height="160">
    <Rect x="0" y="0" width="720" height="160" color="#10151C"/>
    <Rect x="180" y="28" width="220" height="96" color="#E23B3B"/>
    <Disc x="330" y="84" radius="48" color="#2F9E44"/>
    <Line x1="150" y1="40" x2="540" y2="120" color="#0E7AFF"/>
    <Text x="196" y="62" value="Later draws cover earlier ones" size="16" color="#F4F7FB" font="sans-semibold"/>
  </Canvas>

  <Text value="Input" fontSize="22" font="sans-semibold"/>
  <Text value="TextField is the Input primitive. Double-click a word. Triple-click a line. Shift-click and Shift-arrows extend the selection. Ctrl moves by word. Home, End, cut, copy, paste, and undo work. The caret uses CursorColor." fontSize="13"/>

  <View direction="row" wrap="wrap" gap="16" align="start">
    <View direction="column" gap="6" align="start" width="352">
      <Text value="Placeholder" fontSize="12"/>
      <TextField id="harbor-name" placeholder="Name the berth" width="352" height="44" cursorColor="#F2C14E"/>
    </View>
    <View direction="column" gap="6" align="start" width="352">
      <Text value="Value and caret" fontSize="12"/>
      <TextField id="harbor-call" value="North berth" width="352" height="44" cursorColor="#0E7AFF"/>
    </View>
    <View direction="column" gap="6" align="start" width="720">
      <Text value="Thick caret" fontSize="12"/>
      <TextField id="harbor-thick" value="Harbor" fontSize="64" width="720" height="96" cursorColor="#F2C14E"/>
    </View>
    <View direction="column" gap="6" align="start" width="352">
      <Text value="Selection" fontSize="12"/>
      <TextField id="harbor-select" value="Select the lantern" width="352" height="44" cursorColor="#E23B3B" selectionStart="0" selectionEnd="6"/>
    </View>
    <View direction="column" gap="6" align="start" width="352">
      <Text value="Password" fontSize="12"/>
      <TextField id="harbor-secret" value="lantern" mask="password" width="352" height="44" cursorColor="#2F9E44"/>
    </View>
  </View>
  <View direction="column" gap="6" align="start" width="720">
    <Text value="Multiline" fontSize="12"/>
    <TextField id="harbor-note" multiline="true" width="720" height="96" cursorColor="#F2C14E" value="The night watch keeps the red lamp over the channel and the gold lamp on the pier."/>
  </View>
  <View direction="column" gap="6" align="start" width="720">
    <Text value="Disabled" fontSize="12"/>
    <TextField id="harbor-closed" value="Closed for the tide" disabled="true" width="720" height="44" cursorColor="#8E8E93"/>
  </View>

  <Text value="ScrollView" fontSize="22" font="sans-semibold"/>
  <Text value="The viewport clips the child. The track and the thumb are parts of the view. A wheel delta and a thumb drag both change the offset." fontSize="13"/>

  <Text value="Vertical" fontSize="13" font="sans-semibold"/>
  <Text value="Opens 48 pixels down the watch list." fontSize="13"/>
  <ScrollView axis="vertical" offset="48" width="720" height="220" background="#10151C" padding="12" direction="column" gap="8">
    <View direction="row" gap="12" align="center" width="696" height="44" background="#1C2430" padding="10">
      <View width="18" height="18" background="#E23B3B"/>
      <Text value="Red lamp, channel mouth" fontSize="14"/>
    </View>
    <View direction="row" gap="12" align="center" width="696" height="44" background="#1C2430" padding="10">
      <View width="18" height="18" background="#F2C14E"/>
      <Text value="Gold lamp, north pier" fontSize="14"/>
    </View>
    <View direction="row" gap="12" align="center" width="696" height="44" background="#1C2430" padding="10">
      <View width="18" height="18" background="#0E7AFF"/>
      <Text value="Blue lamp, dry dock" fontSize="14"/>
    </View>
    <View direction="row" gap="12" align="center" width="696" height="44" background="#1C2430" padding="10">
      <View width="18" height="18" background="#2F9E44"/>
      <Text value="Green lamp, inner harbor" fontSize="14"/>
    </View>
    <View direction="row" gap="12" align="center" width="696" height="44" background="#1C2430" padding="10">
      <View width="18" height="18" background="#C4553A"/>
      <Text value="Hull light, east wharf" fontSize="14"/>
    </View>
    <View direction="row" gap="12" align="center" width="696" height="44" background="#1C2430" padding="10">
      <View width="18" height="18" background="#F4F7FB"/>
      <Text value="Mast light, outer bar" fontSize="14"/>
    </View>
  </ScrollView>

  <Text value="Horizontal" fontSize="13" font="sans-semibold"/>
  <Text value="Opens 96 pixels along the quay." fontSize="13"/>
