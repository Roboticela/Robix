  </View>

  <Text value="Align end" fontSize="13" font="sans-semibold"/>
  <View direction="row" width="120" height="48" align="end" background="#141820">
    <View width="28" height="16" background="#2F9E44"/>
  </View>

  <Text value="Width 50%" fontSize="13" font="sans-semibold"/>
