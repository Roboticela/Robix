    <View width="28" height="20" background="#E23B3B"/>
    <View width="28" height="20" background="#2F9E44"/>
    <View width="28" height="20" background="#0E7AFF"/>
  </View>

  <Text value="Stack" fontSize="13" font="sans-semibold"/>
  <View display="stack" width="88" height="56" background="#141820">
    <View width="72" height="40" background="#E23B3B"/>
    <View width="36" height="24" background="#2F9E44"/>
  </View>

  <Text value="Grid, span 2" fontSize="13" font="sans-semibold"/>
  <View display="grid" columns="3" width="196" height="64" gap="4" background="#141820">
    <View gridColumn="span 2" height="24" background="#E23B3B"/>
    <View height="24" background="#2F9E44"/>
    <View height="24" background="#0E7AFF"/>
  </View>

  <Text value="Absolute" fontSize="13" font="sans-semibold"/>
  <View width="196" height="64" background="#141820">
    <View width="28" height="20" background="#E23B3B"/>
    <View position="absolute" left="80" top="18" width="28" height="20" background="#0E7AFF"/>
  </View>

  <Text value="Padding" fontSize="13" font="sans-semibold"/>
  <View direction="row" width="120" height="52" padding="12" align="start" background="#141820">
    <View width="28" height="20" background="#0E7AFF"/>
  </View>

  <Text value="Margin" fontSize="13" font="sans-semibold"/>
