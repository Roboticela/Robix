// Token kinds for the complete Robix syntax (sections 0 through 20).
Package Robix.Syntax;

Import Robix.Core;


Public Enum TokenKind {
    EndOfFile,
    Unknown,
    Identifier,

    IntegerLiteral,
    FloatLiteral,
    StringLiteral,
    CharLiteral,

    OpenParen,
    CloseParen,
    OpenBracket,
    CloseBracket,
    OpenBrace,
    CloseBrace,
    Comma,
    Semicolon,
    Colon,
    Dot,
    At,

    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Assign,
    PlusAssign,
    MinusAssign,
    StarAssign,
    SlashAssign,
    PercentAssign,
    AmpersandAssign,
    PipeAssign,
    CaretAssign,
    EqualEqual,
    BangEqual,
    Less,
    Greater,
    LessEqual,
    GreaterEqual,
    Ampersand,
    Pipe,
    Caret,
    Tilde,
    LessLess,
    GreaterGreater,
    AmpAmp,
    PipePipe,
    Bang,
    PlusPlus,
    MinusMinus,
    Question,
    QuestionQuestion,
    QuestionDot,
    DotDot,
    DotDotEqual,
    DotDotDot,
    Arrow,
    FatArrow,
    CustomOperator,

    Package,
    Import,
    As,
    Permissions,
    Let,
    Var,
    Const,
    Function,
    Public,
    Private,
    Protected,
    Internal,
    Explain,
    Return,
    Async,
    Await,
    Iterator,
    Yield,
    Consteval,
    Params,
    Mut,
    Ref,
    Class,
    Struct,
    Interface,
    Trait,
    Enum,
    Service,
    Implement,
    Implements,
    Connect,
    Abstract,
    Override,
    Virtual,
    Sealed,
    Final,
    Static,
    Partial,
    Constructor,
    Destructor,
    Base,
    This,
    If,
    Else,
    Match,
    For,
    In,
    While,
    Do,
    Repeat,
    Loop,
    Break,
    Continue,
    Try,
    Catch,
    Finally,
    Throw,
    Defer,
    Using,
    Unsafe,
    Lock,
    Asm,
    Goto,
    Operator,
    Precedence,
    LeftAssociative,
    RightAssociative,
    And,
    Or,
    Not,
    Equal,
    Is,
    Where,
    Type,
    Macro,
    Extern,
    CallingConvention,
    True,
    False,
    Null,
    Void,
    Any,
    Dynamic,
    Int,
    UInt,
    Float,
    Double,
    Decimal,
    Bool,
    Char,
    String,
    Out,
    Clobber,
    Test
}
