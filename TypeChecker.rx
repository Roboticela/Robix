// Strict type checks required before Robix can compile a module.
Package Robix.Syntax;

Import Robix.Core;


Public Class Symbol {
    Public String Name;
    Public String TypeName;
    Public Bool Mutable;
    Public Bool Nullable;
    Public Bool Initialized;
    Public Bool IsFunction;
    Public Bool IsAsync;
    Public Bool IsConst;
    Public Int Line;
    Public Int Column;

    Public Constructor() {
        This.Name = "";
        This.TypeName = "";
        This.Mutable = False;
        This.Nullable = False;
        This.Initialized = False;
        This.IsFunction = False;
        This.IsAsync = False;
        This.IsConst = False;
        This.Line = 1;
        This.Column = 1;
    }
}

Public Class TypeChecker {
    Private DiagnosticBag diagnostics;
    Private Bool strict;
    Private List<Symbol> symbols;
    Private List<Int> marks;
    Private Int unsafeDepth;
    Private Int asyncDepth;
    Private Int functionDepth;
    Private String currentReturn;
    Private List<String> aliasNames;
    Private List<String> aliasTargets;
    Private List<String> aliasParameters;
    Private String currentType;
    Private List<String> fieldOwners;
    Private List<String> fieldNames;
    Private List<String> fieldTypes;
    Private List<String> baseOwners;
    Private List<String> baseNames;
    Private List<String> genericOwners;
    Private List<String> genericParameters;
    Private List<String> functionNames;
    Private List<String> functionSignatures;
    Private List<AstNode> functionNodes;
    Private List<String> macroNames;
    Private List<String> labelNames;
    Private List<Int> labelDepths;
    Private List<String> gotoNames;
    Private List<Int> gotoDepths;
    Private List<Int> gotoLines;
    Private String currentPackage;
    Private List<String> typeNames;
    Private List<String> typeFlags;
    Private List<String> typePackages;
    Private List<String> memberOwners;
    Private List<String> memberNames;
    Private List<String> memberVisibility;
    Private List<String> memberKinds;

    Public Constructor(DiagnosticBag diagnostics) {
        This.diagnostics = diagnostics;
        This.strict = True;
        This.symbols = List<Symbol>();
        This.marks = List<Int>();
        This.unsafeDepth = 0;
        This.asyncDepth = 0;
        This.functionDepth = 0;
        This.currentReturn = "";
        This.aliasNames = List<String>();
        This.aliasTargets = List<String>();
        This.aliasParameters = List<String>();
        This.currentType = "";
        This.fieldOwners = List<String>();
        This.fieldNames = List<String>();
        This.fieldTypes = List<String>();
        This.baseOwners = List<String>();
        This.baseNames = List<String>();
        This.genericOwners = List<String>();
        This.genericParameters = List<String>();
        This.functionNames = List<String>();
        This.functionSignatures = List<String>();
        This.functionNodes = List<AstNode>();
        This.macroNames = List<String>();
        This.labelNames = List<String>();
        This.labelDepths = List<Int>();
        This.gotoNames = List<String>();
        This.gotoDepths = List<Int>();
        This.gotoLines = List<Int>();
        This.currentPackage = "";
        This.typeNames = List<String>();
        This.typeFlags = List<String>();
        This.typePackages = List<String>();
        This.memberOwners = List<String>();
        This.memberNames = List<String>();
        This.memberVisibility = List<String>();
        This.memberKinds = List<String>();
    }

    Public Function Check(AstNode module) -> Void
    Explain {
        Description: "Apply Robix type rules to a parsed module.";
        Input: module = "Parsed module";
        Processing: "Check declarations, assignments, calls, nullability, async use, returns, and matches. Checking is always strict.";
        Output: "No return value. Diagnostics are stored in the bag.";
    } {
        This.currentPackage = "";
        This.typeNames = List<String>();
        This.typeFlags = List<String>();
        This.typePackages = List<String>();
        This.memberOwners = List<String>();
        This.memberNames = List<String>();
        This.memberVisibility = List<String>();
        This.memberKinds = List<String>();
        This.baseOwners = List<String>();
        This.baseNames = List<String>();
        This.PushScope();
        This.CollectTypes(module);
        This.currentPackage = "";
        This.CollectAliases(module);
        This.PredeclareFunctions(module);
        For child In module.Children {
            This.CheckNode(child);
        }
        Int entryPoints = 0;
        Int entryLine = 1;
        Int entryColumn = 1;
        For child In module.Children {
            If (child.Kind == AstKind.Function && child.Name == "Main") {
                entryPoints = entryPoints + 1;
                entryLine = child.Line;
                entryColumn = child.Column;
            }
            If (child.Kind == AstKind.Class) {
                For member In child.Children {
                    If (member.Kind == AstKind.Function && member.Name == "Main") {
                        entryPoints = entryPoints + 1;
                        entryLine = member.Line;
                        entryColumn = member.Column;
                    }
                }
            }
        }
        If (entryPoints > 1) {
            This.diagnostics.TypeError("RX122", "A file can define only one Main.", entryLine, entryColumn, "one Main", entryPoints.ToString() + " entry points", "Keep either the function Main or the class Main.");
        }
        This.PopScope();
    }

    Private Function PredeclareFunctions(AstNode node) -> Void {
        For child In node.Children {
            If (child.Kind == AstKind.Function || child.Kind == AstKind.Extern) {
                This.RegisterFunction(child);
            }
            If (child.Kind == AstKind.Class || child.Kind == AstKind.Block) {
                This.PredeclareFunctions(child);
            }
        }
    }

    Private Function CheckNode(AstNode node) -> Void {
        If (node.Kind == AstKind.Package && node.Name != "") {
            This.currentPackage = node.Name;
        }
        If (node.Kind == AstKind.Label) {
            This.labelNames.Add(node.Name);
            This.labelDepths.Add(This.marks.Count());
        }
        If (node.Kind == AstKind.Goto) {
            This.gotoNames.Add(node.Name);
            This.gotoDepths.Add(This.marks.Count());
            This.gotoLines.Add(node.Line);
        }
        If (node.Kind == AstKind.Variable || node.Kind == AstKind.Field) {
            This.CheckVariable(node);
            If (!node.FlagC) {
                For child In node.Children {
                    This.CheckVariable(child);
                }
            }
            Return;
        }
        If (node.Kind == AstKind.Function || node.Kind == AstKind.Extern || node.Kind == AstKind.Lambda) {
            This.CheckFunction(node);
            Return;
        }
        If (node.Kind == AstKind.Class || node.Kind == AstKind.Implement) {
            String previousType = This.currentType;
            If (node.Kind == AstKind.Class || node.Kind == AstKind.Implement) {
                This.currentType = node.Name;
            }
            If (node.Kind == AstKind.Class) {
                String parameters = This.GenericParameterText(node);
                If (parameters != "" && This.GenericParametersOf(node.Name) == "") {
                    This.genericOwners.Add(node.Name);
                    This.genericParameters.Add(parameters);
                }
                This.CheckTypeRules(node);
            }
            For child In node.Children {
                This.CheckNode(child);
            }
            This.currentType = previousType;
            Return;
        }
        If (node.Kind == AstKind.Operator) {
            For child In node.Parameters {
                If (child.Type == Null && This.strict) {
                    This.MissingType(child, "Operator parameter");
                }
            }
            If (node.Body != Null && node.Body.Kind == AstKind.Function) {
                This.CheckNode(node.Body);
                Return;
            }
            This.PushScope();
            For child In node.Parameters {
                String parameterType = This.ResolveType(This.TypeText(child.Type));
                If (parameterType == "") { parameterType = "Unknown"; }
                This.Define(child.Name, parameterType, False, False, True, False, False, False, child.Line, child.Column);
            }
            If (node.Body != Null) { This.CheckNode(node.Body); }
            This.PopScope();
            Return;
        }
        If (node.Kind == AstKind.Block || node.Kind == AstKind.Package || node.Kind == AstKind.Unsafe || node.Kind == AstKind.Lock || node.Kind == AstKind.Defer || node.Kind == AstKind.Using || node.Kind == AstKind.Loop || node.Kind == AstKind.Repeat) {
            This.CheckScoped(node);
            Return;
        }
        If (node.Kind == AstKind.If) {
            This.CheckIf(node);
            Return;
        }
        If (node.Kind == AstKind.While || node.Kind == AstKind.DoWhile) {
            String condition = This.Infer(node.Condition);
            This.RequireBool(node.Condition, condition);
            If (node.Body != Null) {
                This.CheckScoped(node.Body);
            }
            Return;
        }
        If (node.Kind == AstKind.For) {
            This.CheckFor(node);
            Return;
        }
        If (node.Kind == AstKind.Match) {
            This.CheckMatch(node);
            Return;
        }
        If (node.Kind == AstKind.Try) {
            If (node.Body != Null) { This.CheckScoped(node.Body); }
            For caught In node.Children {
                This.PushScope();
                If (caught.Name.Length() > 0) {
                    This.Define(caught.Name, This.TypeText(caught.Type), False, False, True, False, False, False, caught.Line, caught.Column);
                }
                If (caught.Body != Null) { This.CheckNode(caught.Body); }
                This.PopScope();
            }
            If (node.Extra != Null) { This.CheckScoped(node.Extra); }
            Return;
        }
        If (node.Kind == AstKind.Return || node.Kind == AstKind.Yield || node.Kind == AstKind.Throw || node.Kind == AstKind.Await) {
            String actual = "";
            If (node.Left != Null) { actual = This.Infer(node.Left); }
            If (node.Kind == AstKind.Yield && node.Left != Null && This.currentReturn != "" && This.currentReturn != "Void") {
                This.RequireAssignable(node.Left, This.currentReturn, actual);
            }
            If (node.Kind == AstKind.Return && node.Left != Null && This.currentReturn != "" && This.currentReturn != "Void" && This.currentReturn != "Task<Void>" && This.currentReturn != "Promise<Void>") {
                String expected = This.currentReturn;
                If (This.asyncDepth > 0) { expected = This.InnerTask(This.currentReturn); }
                This.RequireAssignable(node.Left, expected, actual);
            }
            If (node.Kind == AstKind.Await && This.asyncDepth == 0 && This.functionDepth > 0 && This.strict) {
                This.diagnostics.TypeError("RX107", "Await is only valid inside an Async function or top-level async context.", node.Line, node.Column, "Async Function", "synchronous context", "Move Await into an Async Function.");
            }
            Return;
        }
        If (node.Kind == AstKind.ExpressionStatement) {
            String typeName = This.Infer(node.Left);
            If (typeName.StartsWith("Task<") || typeName.StartsWith("Promise<")) {
                This.diagnostics.Warning("RX114", "Unobserved Task. Await it or detach it with Task.Detach.", node.Line, node.Column);
            }
            Return;
        }
        If (node.Kind == AstKind.Macro) {
            This.macroNames.Add(node.Name);
            This.PushScope();
            For parameter In node.Parameters {
                This.Define(parameter.Name, "Any", False, False, True, False, False, False, parameter.Line, parameter.Column);
            }
            If (node.Body != Null) { This.CheckNode(node.Body); }
            This.PopScope();
            Return;
        }
        If (node.Kind == AstKind.Constructor || node.Kind == AstKind.Destructor) {
            This.PushScope();
            For parameter In node.Parameters {
                String parameterType = This.ResolveType(This.TypeText(parameter.Type));
                If (parameterType == "") { parameterType = "Unknown"; }
                This.Define(parameter.Name, parameterType, True, False, True, False, False, False, parameter.Line, parameter.Column);
            }
            This.DefineTypeFields();
            For child In node.Children { This.Infer(child); }
            If (node.Body != Null) { This.CheckNode(node.Body); }
            This.PopScope();
            Return;
        }
        If (node.Kind == AstKind.Assignment) {
            This.CheckAssignment(node);
            Return;
        }
        For child In node.Children {
            This.CheckNode(child);
        }
    }

    Private Function CheckScoped(AstNode node) -> Void {
        If (node.Kind == AstKind.Using) {
            This.PushScope();
            String leaseType = "AsyncLock";
            If (node.Initializer != Null) { leaseType = This.Infer(node.Initializer); }
            If (node.Name != "") {
                This.Define(node.Name, leaseType, False, False, True, False, False, False, node.Line, node.Column);
            }
            If (node.Body != Null) { This.CheckNode(node.Body); }
            This.PopScope();
            Return;
        }
        Bool unsafe = node.Kind == AstKind.Unsafe;
        If (unsafe) {
            This.unsafeDepth = This.unsafeDepth + 1;
        }
        This.PushScope();
        If (node.Kind == AstKind.Block || node.Kind == AstKind.Package || node.Kind == AstKind.Unsafe) {
            This.PredeclareFunctions(node);
            For child In node.Children {
                This.CheckNode(child);
            }
        } Else If (node.Body != Null) {
            This.CheckNode(node.Body);
        }
        If (node.Kind == AstKind.Using && node.Initializer != Null) {
            This.Infer(node.Initializer);
        }
        If (node.Kind == AstKind.Repeat && node.Condition != Null) {
            This.Infer(node.Condition);
        }
        This.PopScope();
        If (unsafe) {
            This.unsafeDepth = This.unsafeDepth - 1;
        }
    }

    Private Function CheckVariable(AstNode node) -> Void {
        If (node.Name.Length() == 0 && node.FlagC) {
            String tupleType = "";
            If (node.Initializer != Null && node.Initializer.Kind != AstKind.TupleLiteral) {
                tupleType = This.Infer(node.Initializer);
            }
            Int index = 0;
            For child In node.Children {
                String typeName = "Unknown";
                If (child.Type != Null) {
                    String declared = This.TypeText(child.Type);
                    If (declared != "") { typeName = declared; }
                }
                If (typeName == "Unknown" && node.Initializer != Null && node.Initializer.Kind == AstKind.TupleLiteral && index < node.Initializer.Children.Count()) {
                    typeName = This.Infer(node.Initializer.Children[index]);
                    If (typeName == "") { typeName = "Unknown"; }
                } Else If (typeName == "Unknown" && tupleType.StartsWith("(") && tupleType.EndsWith(")")) {
                    String inner = tupleType.Substring(1, tupleType.Length() - 2);
                    Int start = 0;
                    Int partIdx = 0;
                    While (start <= inner.Length()) {
                        Int comma = inner.IndexOf(", ", start);
                        If (comma < 0) {
                            If (partIdx == index) { typeName = inner.Substring(start); }
                            Break;
                        }
                        If (partIdx == index) { typeName = inner.Substring(start, comma - start); Break; }
                        start = comma + 2;
                        partIdx = partIdx + 1;
                    }
                    If (typeName == "" || typeName == "Unknown") { typeName = "Int"; }
                }
                This.Define(child.Name, typeName, child.FlagA, False, True, False, False, False, child.Line, child.Column);
                index = index + 1;
            }
            Return;
        }
        String declared = This.TypeText(node.Type);
        String inferred = "";
        If (node.Initializer != Null) {
            inferred = This.Infer(node.Initializer);
            If (node.Initializer.Kind == AstKind.Range) { inferred = "Array<Int>"; }
            If (node.Type == Null && node.Initializer.Kind == AstKind.ArrayLiteral) { inferred = "Array<Any>"; }
            If (node.Type == Null && node.Initializer.Kind == AstKind.MapLiteral) { inferred = "Map<String, Any>"; }
            If (node.Type == Null && node.Initializer.Kind == AstKind.SetLiteral) { inferred = "Set<Any>"; }
        }
        If (declared.Length() == 0) {
            declared = inferred;
        }
        If (declared.Length() == 0 && This.strict) {
            This.diagnostics.TypeError("RX102", "A variable needs a declared type or an initializer.", node.Line, node.Column, "a static type", "missing", "Add a type or an initializer.");
            declared = "Unknown";
        }
        declared = This.ResolveType(declared);
        inferred = This.ResolveType(inferred);
        Bool spanLiteral = declared.StartsWith("Span<") && node.Initializer != Null && node.Initializer.Kind == AstKind.ArrayLiteral;
        If (spanLiteral) {
            String element = This.ElementName(declared);
            If (element == "") { element = "Byte"; }
            For child In node.Initializer.Children {
                This.RequireAssignable(child, element, This.Infer(child));
            }
        }
        If (!spanLiteral && node.Initializer != Null && inferred.Length() > 0 && node.Type != Null) {
            This.RequireAssignable(node.Initializer, declared, inferred);
        }
        Int fixed = This.FixedCount(declared);
        If (fixed >= 0 && node.Initializer != Null && node.Initializer.Kind == AstKind.ArrayLiteral && node.Initializer.Children.Count() != fixed) {
            This.diagnostics.TypeError("RX103", "A fixed array needs exactly " + fixed.ToString() + " elements.", node.Line, node.Column, declared, node.Initializer.Children.Count().ToString() + " elements", "Match the declared length.");
        }
        Bool nullable = declared.EndsWith("?") || declared == "Null";
        This.Define(node.Name, declared, node.FlagA && !node.FlagB, nullable, node.Initializer != Null, False, False, node.FlagB, node.Line, node.Column);
        If (node.Kind == AstKind.Field && This.currentType != "") {
            This.fieldOwners.Add(This.currentType);
            This.fieldNames.Add(node.Name);
            This.fieldTypes.Add(declared);
        }
        If (node.Kind != AstKind.Field && node.Initializer == Null && !node.FlagA) {
            This.diagnostics.TypeError("RX103", "An immutable value must be initialized.", node.Line, node.Column, declared, "uninitialized", "Initialize the Let binding.");
        }
    }

    Private Function CheckFunction(AstNode node) -> Void {
        If (node.Kind == AstKind.Function || node.Kind == AstKind.Extern) {
            This.RegisterFunction(node);
        }
        Bool publicFunction = This.HasModifier(node, "Public");
        If (publicFunction && node.Kind == AstKind.Function && node.Extra == Null) {
            If (This.strict) {
                This.diagnostics.TypeError("RX105", "A public function requires an Explain block in Strict mode.", node.Line, node.Column, "Explain { ... }", "missing", "Add Description, Input, Processing, and Output.");
            } Else {
                This.diagnostics.Warning("RX105", "A public function is missing its Explain block.", node.Line, node.Column);
            }
        }
        String returnType = This.TypeText(node.Type) + "";
        If (node.Kind != AstKind.Lambda && returnType.Length() == 0 && This.strict) {
            This.diagnostics.TypeError("RX104", "A function requires a return type in Strict mode.", node.Line, node.Column, "-> Type", "missing", "Add a return type. Use Void when there is no result.");
        }
        Bool isAsync = node.FlagA || This.HasModifier(node, "Async") || (node.Kind == AstKind.Lambda && node.FlagB);
        If (isAsync && returnType.Length() > 0 && !returnType.StartsWith("Task<") && !returnType.StartsWith("Promise<")) {
            This.diagnostics.TypeError("RX104", "An Async function returns Task<T> or Promise<T>.", node.Line, node.Column, "Task<T>", returnType, "Change the return type to Task<T>.");
        }
        This.labelNames = List<String>();
        This.labelDepths = List<Int>();
        This.gotoNames = List<String>();
        This.gotoDepths = List<Int>();
        This.gotoLines = List<Int>();
        String previousReturn = This.currentReturn + "";
        This.currentReturn = returnType + "";
        This.PushScope();
        This.DefineTypeFields();
        For parameter In node.Parameters {
            If (!parameter.FlagC) {
                If (parameter.Type == Null && This.strict && node.Kind != AstKind.Lambda) {
                    This.MissingType(parameter, "Parameter");
                }
                String parameterType = This.ResolveType(This.TypeText(parameter.Type));
                If (parameter.FlagB) {
                    If (parameterType == "") { parameterType = "Any"; }
                    parameterType = "Array<" + parameterType + ">";
                }
                This.Define(parameter.Name, parameterType, parameter.FlagA, parameterType.EndsWith("?"), True, False, False, False, parameter.Line, parameter.Column);
            }
        }
        For parameter In node.Members {
            If (parameter.FlagC) {
                This.Define(parameter.Name, "Type", False, False, True, False, False, False, parameter.Line, parameter.Column);
            }
        }
        This.functionDepth = This.functionDepth + 1;
        If (isAsync) {
            This.asyncDepth = This.asyncDepth + 1;
        }
        If (node.Body != Null) {
            This.CheckNode(node.Body);
            Bool isIterator = node.Kind == AstKind.Function && node.FlagB;
            If (!isIterator && This.strict && returnType.Length() > 0 && returnType != "Void" && returnType != "Task<Void>" && returnType != "Promise<Void>" && !This.ReturnsAlways(node.Body) && node.Left == Null) {
                This.diagnostics.TypeError("RX108", "A non-Void function can finish without returning a value.", node.Line, node.Column, returnType, "missing return", "Return a value on every path.");
            }
        }
        If (node.Left != Null) {
            String bodyType = This.Infer(node.Left);
            If (returnType.Length() > 0) {
                This.RequireAssignable(node.Left, This.InnerTask(returnType), bodyType);
            }
        }
        If (isAsync) {
            This.asyncDepth = This.asyncDepth - 1;
        }
        This.functionDepth = This.functionDepth - 1;
        This.PopScope();
        Int jump = 0;
        While (jump < This.gotoNames.Count()) {
            Int labelDepth = -1;
            Int label = 0;
            While (label < This.labelNames.Count()) {
                If (This.labelNames[label] == This.gotoNames[jump]) { labelDepth = This.labelDepths[label]; }
                label = label + 1;
            }
            If (labelDepth > This.gotoDepths[jump]) {
                This.diagnostics.TypeError("RX119", "Goto cannot jump into a scope.", This.gotoLines[jump], 1, "a label in the current scope", "a deeper scope", "Jump only within the current scope or to an outer label.");
            }
            jump = jump + 1;
        }
        This.currentReturn = previousReturn;
        If (node.Kind == AstKind.Function && returnType == "Int" && (node.Name == "Main" || node.Name == "LegacyMain")) {
            This.diagnostics.Warning("RX112", "Main should return ExitCode or ExecutionResult instead of a raw integer.", node.Line, node.Column);
        }
    }

    Private Function CheckIf(AstNode node) -> Void {
        String condition = This.Infer(node.Condition);
        This.RequireBool(node.Condition, condition);
        Symbol? narrowed = This.NoteNullNarrowing(node.Condition);
        Symbol? excluded = This.NoteNullExit(node.Condition);
        If (narrowed != Null) {
            narrowed.Nullable = False;
            If (node.Body != Null) { This.CheckScoped(node.Body); }
            narrowed.Nullable = True;
        } Else {
            If (node.Body != Null) { This.CheckScoped(node.Body); }
        }
        If (excluded != Null) {
            If (node.Body != Null && This.ReturnsAlways(node.Body)) {
                excluded.Nullable = False;
            }
        }
        If (node.Otherwise != Null) { This.CheckNode(node.Otherwise); }
    }

    Private Function CheckFor(AstNode node) -> Void {
        This.PushScope();
        If (node.FlagB) {
            If (node.Initializer != Null) { This.CheckNode(node.Initializer); }
            If (node.Condition != Null) {
                This.RequireBool(node.Condition, This.Infer(node.Condition));
            }
            If (node.Extra != Null) { This.Infer(node.Extra); }
        } Else {
            String rightType = "Unknown";
            If (node.Right != Null) { rightType = This.Infer(node.Right); }
            If (node.FlagA && This.asyncDepth == 0 && This.strict) {
                This.diagnostics.TypeError("RX107", "Await For is only valid inside an Async function.", node.Line, node.Column, "Async Function", "synchronous function", "Mark the function Async.");
            }
            If (node.Left != Null && node.Left.Name != "()" && !rightType.StartsWith("Enumerate<")) {
                String elemType = This.ElementName(rightType);
                If (elemType != "") { rightType = elemType; }
            }
            This.BindPattern(node.Left, rightType);
        }
        If (node.Body != Null) { This.CheckNode(node.Body); }
        This.PopScope();
    }

    Private Function CheckMatch(AstNode node) -> Void {
        String scrutineeType = "";
        If (node.Left != Null) { scrutineeType = This.Infer(node.Left); }
        Bool wildcard = False;
        Bool hasSome = False;
        Bool hasNone = False;
        Bool hasSuccess = False;
        Bool hasError = False;
        For arm In node.Children {
            If (arm.Left != Null && arm.Left.FlagA) {
                wildcard = True;
            }
            If (arm.Left != Null) {
                String tag = arm.Left.Text;
                If (tag == "") { tag = arm.Left.Name; }
                If (tag == "Some") { hasSome = True; }
                If (tag == "None") { hasNone = True; }
                If (tag == "Success") { hasSuccess = True; }
                If (tag == "Error" || tag == "Failure") { hasError = True; }
            }
            This.PushScope();
            String patternType = "Unknown";
            If (arm.Left != Null && (arm.Left.Text == "Some" || arm.Left.Text == "Success")) {
                patternType = This.ElementName(scrutineeType);
                If (patternType == "") { patternType = "Int"; }
            } Else If (arm.Left != Null && (arm.Left.Text == "Error" || arm.Left.Text == "Failure")) {
                patternType = "String";
            } Else If (arm.Left != Null && arm.Left.Text.Length() > 0) {
                patternType = arm.Left.Text;
            }
            This.BindPattern(arm.Left, patternType);
            If (arm.Right != Null) { This.CheckNode(arm.Right); }
            This.PopScope();
        }
        If ((hasSome && hasNone) || (hasSuccess && hasError)) {
            wildcard = True;
        }
        If (!wildcard && node.Children.Count() > 0 && This.strict) {
            Bool closed = False;
            For arm In node.Children {
                If (arm.Left != Null && (arm.Left.Text == "Success" || arm.Left.Text == "Some" || arm.Left.Name == "Success" || arm.Left.Name == "Some")) {
                    closed = True;
                }
            }
            If (closed) {
                This.diagnostics.TypeError("RX111", "Match on Result or Option must be exhaustive or include a fallback arm.", node.Line, node.Column, "all cases or _", "partial match", "Add a wildcard arm.");
            }
        }
    }

    Private Function CheckAssignment(AstNode node) -> Void {
        String actual = "";
        If (node.Right != Null) {
            actual = This.Infer(node.Right);
        }
        If (node.Left != Null && node.Left.Kind == AstKind.TupleLiteral) {
            For target In node.Left.Children {
                If (target.Kind == AstKind.Name) {
                    Symbol? symbol = This.Find(target.Name);
                    If (symbol != Null) {
                        If (!symbol.Mutable || symbol.IsConst) {
                            This.diagnostics.TypeError("RX103", "Cannot assign to immutable '" + symbol.Name + "'.", node.Line, node.Column, "a Var binding", symbol.TypeName, "Declare it with Var.");
                        }
                        symbol.Initialized = True;
                    }
                }
            }
            Return;
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Name) {
            Symbol? symbol = This.Find(node.Left.Name);
            If (symbol == Null && This.IsCamel(node.Left.Name)) {
                This.Undefined(node.Left);
            } Else If (symbol != Null) {
                If (!symbol.Mutable || symbol.IsConst) {
                    This.diagnostics.TypeError("RX103", "Cannot assign to immutable '" + symbol.Name + "'.", node.Line, node.Column, "a Var binding", symbol.TypeName, "Declare it with Var.");
                }
                symbol.Initialized = True;
                If (symbol.TypeName.Length() > 0) {
                    This.RequireAssignable(node, symbol.TypeName, actual);
                }
            }
        } Else If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name) {
            Symbol? symbol = This.Find(node.Left.Left.Name);
            If (symbol != Null) {
                If (node.Left.Name == "Value" && symbol.TypeName.StartsWith("Ref<") && !symbol.TypeName.Contains("Mut")) {
                    This.diagnostics.TypeError("RX103", "A read-only reference cannot be assigned.", node.Line, node.Column, "Ref<Mut " + This.RefPayload(symbol.TypeName) + ">", symbol.TypeName, "Bind the reference with Ref(Mut name).");
                }
                String expected = This.FieldTypeOf(symbol.TypeName, node.Left.Name);
                If (expected != "" && node.Right != Null) { This.RequireAssignable(node.Right, expected, actual); }
            }
            This.Infer(node.Left);
        } Else If (node.Left != Null) {
            This.Infer(node.Left);
        }
    }

    Private Function Infer(AstNode? node) -> String {
        If (node == Null) {
            Return "";
        }
        If (node.Kind == AstKind.IntegerLiteral) {
            If (node.Suffix.Length() == 0) { Return "Int"; }
            Return SuffixTypeName(node.Suffix);
        }
        If (node.Kind == AstKind.FloatLiteral) {
            If (node.Suffix.Length() == 0) { Return "Float"; }
            Return SuffixTypeName(node.Suffix);
        }
        If (node.Kind == AstKind.StringLiteral || node.Kind == AstKind.Interpolation) { Return "String"; }
        If (node.Kind == AstKind.CharLiteral) { Return "Char"; }
        If (node.Kind == AstKind.BooleanLiteral) { Return "Bool"; }
        If (node.Kind == AstKind.NullLiteral) { Return "Null"; }
        If (node.Kind == AstKind.ArrayLiteral) { Return "Array<" + This.LiteralElement(node) + ">"; }
        If (node.Kind == AstKind.MapLiteral) {
            String valueType = "";
            Bool mixed = False;
            For child In node.Children {
                String item = "Int";
                If (child.Left != Null) { item = This.Infer(child.Left); }
                If (valueType == "") { valueType = item; }
                If (item != valueType) { mixed = True; }
            }
            If (mixed) { valueType = "Any"; }
            If (valueType == "") { valueType = "Int"; }
            Return "Map<String, " + valueType + ">";
        }
        If (node.Kind == AstKind.SetLiteral) { Return "Set<" + This.LiteralElement(node) + ">"; }
        If (node.Kind == AstKind.TupleLiteral) {
            String text = "(";
            Bool first = True;
            For child In node.Children {
                If (!first) { text = text + ", "; }
                text = text + This.Infer(child);
                first = False;
            }
            Return text + ")";
        }
        If (node.Kind == AstKind.RecordLiteral) {
            String text = "{";
            Bool first = True;
            For child In node.Children {
                String fieldType = "Int";
                If (child.Left != Null) { fieldType = This.Infer(child.Left); }
                If (!first) { text = text + ", "; }
                text = text + child.Name + ": " + fieldType;
                first = False;
            }
            Return text + "}";
        }
        If (node.Kind == AstKind.ObjectLiteral) {
            String applied = This.AppliedObjectType(node);
            For child In node.Children {
                If (child.Left != Null) {
                    String actual = This.Infer(child.Left);
                    String expected = This.FieldTypeOf(applied, child.Name);
                    If (expected != "") { This.RequireAssignable(child.Left, expected, actual); }
                }
            }
            Return applied;
        }
        If (node.Kind == AstKind.Name) {
            Symbol? symbol = This.Find(node.Name);
            If (symbol == Null) {
                If (This.IsCamel(node.Name)) {
                    This.Undefined(node);
                }
                Return "Unknown";
            }
            If (!symbol.Initialized && !symbol.IsFunction && This.strict) {
                This.diagnostics.TypeError("RX102", "'" + node.Name + "' is read before it is assigned.", node.Line, node.Column, symbol.TypeName, "uninitialized", "Assign the variable before reading it.");
            }
            If (This.currentType != "" && This.IsAmbiguousMember(This.currentType, node.Name)) {
                This.diagnostics.TypeError("RX131", "'" + node.Name + "' is inherited from more than one base.", node.Line, node.Column, "one member", "multiple bases", "Use BaseName.Member, an Override, or composition.");
            }
            If (symbol.IsFunction) {
                String signature = This.FunctionTypeOf(node.Name);
                If (signature != "") { Return signature; }
            }
            If (!symbol.Nullable && symbol.TypeName.EndsWith("?")) {
                Return This.StripOptional(symbol.TypeName);
            }
            Return symbol.TypeName;
        }
        If (node.Kind == AstKind.Assignment) {
            This.CheckAssignment(node);
            Return This.Infer(node.Right);
        }
        If (node.Kind == AstKind.Unary || node.Kind == AstKind.Unwrap || node.Kind == AstKind.Propagate) {
            String inner = This.Infer(node.Left);
            If (node.Kind == AstKind.Propagate || node.Kind == AstKind.Unwrap) {
                If (inner.EndsWith("?")) {
                    Return inner.Substring(0, inner.Length() - 1);
                }
                If (inner.StartsWith("Option<") || inner.StartsWith("Result<")) {
                    String elem = This.ElementName(inner);
                    If (elem != "") { Return elem; }
                    Return "Int";
                }
            }
            If (node.Operator == "!" || node.Operator == "Not") {
                Return "Bool";
            }
            If (node.Operator == "Mut") { Return "Mut " + inner; }
            If (node.Operator == "*" && inner.StartsWith("Pointer<")) { Return "Int"; }
            Return inner;
        }
        If (node.Kind == AstKind.Binary || node.Kind == AstKind.Range) {
            String left = This.Infer(node.Left);
            String right = This.Infer(node.Right);
            If (node.Operator == "&&" || node.Operator == "||" || node.Operator == "And" || node.Operator == "Or" || node.Operator == "==" || node.Operator == "!=" || node.Operator == "<" || node.Operator == ">" || node.Operator == "<=" || node.Operator == ">=" || node.Operator == "Equal") {
                Return "Bool";
            }
            If (node.Operator == "??") {
                If (left.EndsWith("?")) { Return This.StripOptional(left); }
                If (left == "Null") { Return right; }
                Return left;
            }
            If (node.Operator == "+" && left.StartsWith("Pointer<")) { Return left; }
            If (node.Operator == "+" && (left == "String" || right == "String")) {
                Return "String";
            }
            If (left == "Float" || right == "Float" || left == "Double" || right == "Double") {
                If (left != right && This.IsNumeric(left) && This.IsNumeric(right) && This.strict) {
                    This.diagnostics.TypeError("RX109", "Strict mode does not mix numeric types implicitly.", node.Line, node.Column, left, right, "Convert one operand explicitly.");
                }
            }
            Return left;
        }
        If (node.Kind == AstKind.Ternary) {
            This.RequireBool(node.Condition, This.Infer(node.Condition));
            String left = This.Infer(node.Left);
            String right = This.Infer(node.Right);
            If (left == right) { Return left; }
            Return left;
        }
        If (node.Kind == AstKind.TypeCheck) {
            This.Infer(node.Left);
            If (node.FlagA && node.Name != "") {
                String targetType = This.ResolveType(This.TypeText(node.Type));
                If (targetType == "") { targetType = "Any"; }
                This.Define(node.Name, targetType, False, False, True, False, False, False, node.Line, node.Column);
            }
            Return "Bool";
        }
        If (node.Kind == AstKind.Await) {
            If (This.asyncDepth == 0 && This.functionDepth > 0 && This.strict) {
                This.diagnostics.TypeError("RX107", "Await is only valid inside an Async function.", node.Line, node.Column, "Async Function", "synchronous function", "Mark the function Async.");
            }
            Return This.InnerTask(This.Infer(node.Left));
        }
        If (node.Kind == AstKind.Call) {
            Return This.InferCall(node);
        }
        If (node.Kind == AstKind.Member) {
            If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Name == "Console" && node.Left.Left != Null && node.Left.Left.Name == "Runtime") {
                If (node.Name == "Enabled") { Return "Bool"; }
                If (node.Name == "Port") { Return "Int"; }
            }
            String left = This.Infer(node.Left);
            String accessOwner = This.AppliedOwner(left);
            If (node.Left != Null && node.Left.Kind == AstKind.Name && This.TypeFlagOf(node.Left.Name) != "") {
                accessOwner = node.Left.Name;
            }
            This.CheckVisibility(accessOwner, node.Name, node);
            If (left.EndsWith("?") && !node.FlagA && This.strict) {
                This.diagnostics.TypeError("RX110", "A nullable value needs a check, '?.', or '!' before member access.", node.Line, node.Column, This.StripOptional(left), left, "Use '?.' or test the value against Null.");
            }
            If (node.Name == "ToString" || node.Name == "ToUpper" || node.Name == "ToLower" || node.Name == "Trim") { Return "String"; }
            If (node.Name == "ToFloat") { Return "Float"; }
            If (node.Name == "ToInt" || node.Name == "Length" || node.Name == "Count") { Return "Int"; }
            String fieldType = This.FieldTypeOf(left, node.Name);
            If (fieldType != "") { Return fieldType; }
            If (node.Name == "Token") { Return "CancellationToken"; }
            If (node.Name == "Message") { Return "String"; }
            Return "Unknown";
        }
        If (node.Kind == AstKind.Index) {
            This.Infer(node.Left);
            This.Infer(node.Right);
            Return "Unknown";
        }
        If (node.Kind == AstKind.Lambda) {
            This.CheckFunction(node);
            If (node.Type != Null) { Return "Lambda:" + This.TypeText(node.Type); }
            If (node.Left != Null) {
                This.PushScope();
                For parameter In node.Parameters {
                    String pType = This.ResolveType(This.TypeText(parameter.Type));
                    If (pType == "") { pType = "Unknown"; }
                    This.Define(parameter.Name, pType, parameter.FlagA, False, True, False, False, False, parameter.Line, parameter.Column);
                }
                String bodyType = This.Infer(node.Left);
                This.PopScope();
                If (bodyType != "") { Return "Lambda:" + bodyType; }
            }
            Return "Lambda:Void";
        }
        If (node.Kind == AstKind.Match || node.Kind == AstKind.Block || node.Kind == AstKind.If) {
            This.CheckNode(node);
            Return "Unknown";
        }
        For child In node.Children {
            This.Infer(child);
        }
        If (node.Left != Null) { This.Infer(node.Left); }
        If (node.Right != Null) { This.Infer(node.Right); }
        Return "Unknown";
    }

    Private Function InferCall(AstNode node) -> String {
        String name = "";
        String symbolReturn = "";
        String receiverType = "";
        If (node.Left != Null && node.Left.Kind == AstKind.Name) {
            name = node.Left.Name;
            Symbol? symbol = This.Find(name);
            If (symbol != Null) {
                If (symbol.TypeName.StartsWith("Lambda:")) {
                    symbolReturn = symbol.TypeName.Substring(7);
                } Else If (symbol.IsFunction) {
                    AstNode? function = This.FunctionNodeOf(name);
                    If (function != Null) { This.CheckMutableArguments(node, function); }
                    If (symbol.TypeName == "T") {
                        symbolReturn = "T";
                    } Else {
                        symbolReturn = symbol.TypeName;
                        If (function != Null) {
                            If (function.FlagB) { symbolReturn = "Array<" + symbol.TypeName + ">"; }
                        }
                    }
                }
            }
            If (symbol == Null && This.IsCamel(name)) {
                This.Undefined(node.Left);
            }
        } Else If (node.Left != Null) {
            If (node.Left.Kind == AstKind.Member && node.Left.Left != Null) {
                receiverType = This.Infer(node.Left.Left);
                String accessOwner = This.AppliedOwner(receiverType);
                If (node.Left.Left.Kind == AstKind.Name && This.TypeFlagOf(node.Left.Left.Name) != "") {
                    accessOwner = node.Left.Left.Name;
                }
                This.CheckVisibility(accessOwner, node.Left.Name, node.Left);
            } Else {
                This.Infer(node.Left);
            }
        }
        For argument In node.Parameters {
            If (argument.Left != Null) {
                This.Infer(argument.Left);
            }
        }
        If (symbolReturn == "T") {
            Return This.CallArgumentType(node);
        }
        If (symbolReturn != "") {
            Return symbolReturn;
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member) {
            String owner = "";
            If (node.Left.Left != Null && (node.Left.Left.Kind == AstKind.Name || node.Left.Left.Kind == AstKind.Member)) {
                owner = node.Left.Left.Name;
            }
            If ((owner == "Base" || owner.StartsWith("Base<")) && (node.Left.Name == "Constructor" || node.Left.Name == "Destructor")) { Return "Void"; }
            If (owner == "Reflect" && node.Left.Name == "TypeOf") { Return "TypeInfo"; }
            If (owner == "Reflect" && node.Left.Name == "Create") { Return "Any"; }
            If (owner == "Reflect" && node.Left.Name == "Invoke") { Return "Void"; }
            If (owner == "Pointer" && node.Left.Name == "Of") { Return "Pointer<Int>"; }
            If (owner == "Memory" && node.Left.Name == "Allocate") { Return "Pointer<Byte>"; }
            If (owner == "Memory" && (node.Left.Name == "Copy" || node.Left.Name == "Free")) { Return "Void"; }
            If (owner == "Volatile" && node.Left.Name == "Store") { Return "Void"; }
            If (owner == "Volatile" && node.Left.Name == "Load") { Return "Int"; }
            If (node.Left.Name == "Increment" && receiverType.StartsWith("Atomic<")) { Return "Int"; }
            If (owner == "Files" && node.Left.Name == "Open") { Return "File"; }
            If (node.Left.Name == "Read" && receiverType == "File") { Return "String"; }
            If (node.Left.Name == "Partial") {
                AstNode? target = This.FunctionNodeOf(owner);
                If (target != Null) {
                    If (target.Type != Null) { Return "Lambda:" + This.TypeText(target.Type); }
                }
                Return "Lambda:Int";
            }
            If (owner == "Function" && node.Left.Name == "Compose") { Return "Lambda:Int"; }
            If (node.Left.Name == "AcquireAsync") { Return "Task<AsyncLock>"; }
            If (node.Left.Name == "WithTimeout") {
                If (receiverType == "") { Return "Task<String>"; }
                Return receiverType;
            }
            If (node.Left.Name == "ThrowIfCancellationRequested" || node.Left.Name == "Cancel") { Return "Void"; }
            String library = This.TaskCallType(owner, node.Left.Name);
            If (library != "") { Return library; }
            If (owner == "Task" && (node.Left.Name == "FromResult" || node.Left.Name == "Run")) {
                String argument = This.CallArgumentType(node);
                If (argument.StartsWith("Lambda:")) { argument = argument.Substring(7); }
                Return "Task<" + argument + ">";
            }
            If (owner == "Task" && node.Left.Name == "WhenAll") { Return "Task<" + This.WhenAllType(node) + ">"; }
            If (owner == "Network" && node.Left.Name == "SendText") { Return "Task<String>"; }
            If (owner == "Timer" && (node.Left.Name == "SetTimeout" || node.Left.Name == "SetInterval" || node.Left.Name == "SetIntervalAsync")) { Return "TimerHandle"; }
            If (owner == "Timer" && (node.Left.Name == "ClearInterval" || node.Left.Name == "Clear")) { Return "Void"; }
            If (owner == "Scheduler" && (node.Left.Name == "QueueMicrotask" || node.Left.Name == "Queue")) { Return "Void"; }
            If (owner == "Function" && (node.Left.Name == "Debounce" || node.Left.Name == "Throttle")) {
                String argument = This.CallArgumentType(node);
                If (argument.StartsWith("Lambda:")) { Return argument; }
                If (argument == "") { Return "Lambda:Void"; }
                Return "Lambda:" + argument;
            }
            If (owner == "Promise" && (node.Left.Name == "All" || node.Left.Name == "Race" || node.Left.Name == "Any" || node.Left.Name == "AllSettled")) {
                Return This.PromiseCombinatorType(node, node.Left.Name);
            }
            If (owner == "Promise" && (node.Left.Name == "Create" || node.Left.Name == "FromCallback" || node.Left.Name == "Resolved" || node.Left.Name == "Rejected")) {
                Return This.PromiseTypeOf(node.Left);
            }
            If (owner == "LegacyApi" && node.Left.Name == "ReadText") { Return "String"; }
            If (owner == "Operators") {
                If (node.Left.Name == "Equal" || node.Left.Name == "GreaterThan" || node.Left.Name == "And") {
                    Return "Bool";
                }
                If (node.Left.Name == "Add" || node.Left.Name == "Negate") {
                    Return This.CallArgumentType(node);
                }
                Return "Unknown";
            }
            If (owner == "Math") {
                If (node.Left.Name == "Min" || node.Left.Name == "Max" || node.Left.Name == "Abs" || node.Left.Name == "Clamp" || node.Left.Name == "Gcd" || node.Left.Name == "IntegerSquareRoot") {
                    Return This.CallArgumentType(node);
                }
            }
            If (owner == "RoboString" || owner == "String") {
                If (node.Left.Name == "FormatInt" || node.Left.Name == "Digit") {
                    Return "String";
                }
            }
            If (owner == "Files") {
                If (node.Left.Name == "Name" || node.Left.Name == "Join" || node.Left.Name == "ReadText") {
                    Return "String";
                }
                If (node.Left.Name == "Exists") {
                    Return "Bool";
                }
            }
            If (owner == "Paths") {
                If (node.Left.Name == "Name" || node.Left.Name == "Join" || node.Left.Name == "Directory" || node.Left.Name == "Extension") { Return "String"; }
            }
            If (owner == "Date" && (node.Left.Name == "Year" || node.Left.Name == "Month" || node.Left.Name == "Day")) { Return "Int"; }
            If (owner == "Time" && (node.Left.Name == "Seconds" || node.Left.Name == "Millis")) { Return "Int"; }
            If (owner == "Net" && node.Left.Name == "Host") { Return "String"; }
            If (owner == "Net" && node.Left.Name == "Port") { Return "Int"; }
            If (owner == "Json" && (node.Left.Name == "Quote" || node.Left.Name == "Object")) { Return "String"; }
            If (owner == "Log" && (node.Left.Name == "Info" || node.Left.Name == "Error")) { Return "Void"; }
            If (owner == "Process" && node.Left.Name == "Count") { Return "Int"; }
            If (owner == "Process" && node.Left.Name == "Argument") { Return "String"; }
            If (owner == "Environment" && node.Left.Name == "Get") { Return "String"; }
            If (owner == "Crypto" && node.Left.Name == "Hash") { Return "Int"; }
            If (owner == "Testing" && node.Left.Name == "Equal") { Return "Bool"; }
            If (owner == "Diagnostics" && node.Left.Name == "Format") { Return "String"; }
            If (owner == "Library" && node.Left.Name == "Contains") { Return "Bool"; }
            If (owner == "Collection" && node.Left.Name == "Count") { Return "Int"; }
            If (owner == "Concurrency" && node.Left.Name == "Workers") { Return "Int"; }
            If (owner == "Hardware" && node.Left.Name == "ReadSensor") { Return "Int"; }
            If (node.Left.Name == "From" && This.IsNumeric(owner)) {
                String fullName = owner;
                If (node.Left.Left.Children.Count() > 0) {
                    fullName = owner + "<" + node.Left.Left.Children[0].Name + ">";
                }
                Return fullName;
            }
            If (node.Left.Name == "Enumerate") {
                String elem = This.ElementName(receiverType);
                If (elem == "") { elem = "Int"; }
                Return "Enumerate<" + elem + ">";
            }
            If (node.Left.Name == "Trim" || node.Left.Name == "Replace" || node.Left.Name == "Substring" || node.Left.Name == "ToString" || node.Left.Name == "ToUpper" || node.Left.Name == "ToLower") {
                Return "String";
            }
            If (node.Left.Name == "Split") {
                Return "Array<String>";
            }
            If (node.Left.Name == "Contains" || node.Left.Name == "StartsWith" || node.Left.Name == "EndsWith") {
                Return "Bool";
            }
            If (node.Left.Name == "Sort" || node.Left.Name == "Reverse" || node.Left.Name == "Add") {
                Return "Void";
            }
            If (node.Left.Name == "Map" || node.Left.Name == "Filter") {
                If (receiverType == "" || receiverType == "Unknown") { Return "Array<Int>"; }
                Return receiverType;
            }
            If (node.Left.Name == "Reduce") {
                Return This.CallArgumentType(node);
            }
            If ((node.Left.Name == "As" || node.Left.Name == "Cast") && node.Left.Children.Count() > 0) {
                Return This.ResolveType(This.TypeText(node.Left.Children[0]));
            }
            If (node.Left.Name == "AsOptional" && node.Left.Children.Count() > 0) {
                Return This.ResolveType(This.TypeText(node.Left.Children[0])) + "?";
            }
            If (node.Left.Name == "TryToInt") { Return "Result<Int, ConversionError>"; }
            If (node.Left.Name == "Length" || node.Left.Name == "Count" || node.Left.Name == "ToInt") {
                If (node.Left.FlagA) { Return "Int?"; }
                Return "Int";
            }
        }
        If (name == "Ref") { Return "Ref<" + This.ReferenceType(node) + ">"; }
        If (name == "TimeoutError") { Return "String"; }
        If (name == "CancellationSource") { Return "CancellationSource"; }
        If (name == "AsyncLock") { Return "AsyncLock"; }
        If (name == "RoboException") { Return "RoboException"; }
        If (name == "Atomic") { Return "Atomic<Int>"; }
        If (name == "Print" || name == "Assert" || name == "AssertTrue" || name == "AssertFalse" || name == "AssertEqual" || name == "AssertNear") {
            Return "Void";
        }
        For macroName In This.macroNames {
            If (macroName == name) { Return "Void"; }
        }
        If (name == "Some") { Return "Option<" + This.CallArgumentType(node) + ">"; }
        If (name == "Tuple") { Return This.CallTupleType(node); }
        If (name == "Success" || name == "Failure" || name == "Error" || name == "None") {
            Return name;
        }
        If (name == "Input") {
            If (node.Left != Null && node.Left.Children.Count() > 0) {
                Return This.TypeText(node.Left.Children[0]);
            }
            Return "String";
        }
        If (name != "" && This.TypeFlagOf(name) == "Abstract") {
            This.diagnostics.TypeError("RX132", "Cannot construct abstract type '" + name + "'.", node.Line, node.Column, "a concrete type", name, "Construct a derived type instead.");
            Return name;
        }
        If (This.IsTypeName(name)) {
            Return name;
        }
        Return "Unknown";
    }

    Private Function RequireAssignable(AstNode node, String expected, String actual) -> Void {
        If (!This.strict) {
            Return;
        }
        String wanted = This.ResolveType(expected);
        String given = This.ResolveType(actual);
        If (wanted.Length() == 0 || given.Length() == 0 || wanted == "Unknown" || given == "Unknown" || wanted == "Any" || wanted == "Dynamic" || wanted == given) {
            Return;
        }
        If (wanted.EndsWith("?") && (given == "Null" || given == This.StripOptional(wanted))) {
            Return;
        }
        If (This.WidensTo(wanted, given)) {
            Return;
        }
        If (This.SameElements(wanted, given)) {
            Return;
        }
        If (wanted.StartsWith("Pointer<") && given == "Null") { Return; }
        If (wanted.Contains(" | ")) {
            Var parts = List<String>();
            String rest = wanted;
            While (rest.Contains(" | ")) {
                Int bar = rest.IndexOf(" | ");
                parts.Add(rest.Substring(0, bar));
                rest = rest.Substring(bar + 3);
            }
            parts.Add(rest);
            For part In parts {
                If (part == given) { Return; }
            }
        }
        If (wanted.StartsWith("Option<") && (given.StartsWith("Option<") || given == "None")) { Return; }
        If (wanted.StartsWith("Result<") && (given.StartsWith("Result<") || given == "Success" || given == "Failure" || given == "Error")) { Return; }
        If (wanted == "Tuple" && given.StartsWith("(")) { Return; }
        If (wanted.StartsWith("Queue<") && given.StartsWith("Queue<")) { Return; }
        If (wanted.StartsWith("Stack<") && given.StartsWith("Stack<")) { Return; }
        If (wanted.StartsWith("Enumerate<") && given.StartsWith("Enumerate<")) { Return; }
        If (This.IsNumeric(wanted) && This.IsNumeric(given) && wanted != given) {
            If (This.FitsIntegerLiteral(node, wanted) || This.FitsFloatLiteral(node, wanted) || This.FitsDecimalLiteral(node, wanted)) {
                Return;
            }
            This.diagnostics.TypeError("RX109", "Numeric conversion would narrow or change representation.", node.Line, node.Column, wanted, given, "Use an explicit conversion such as " + wanted + ".FromChecked.");
            Return;
        }
        If (given == "Null" && !wanted.EndsWith("?")) {
            This.diagnostics.TypeError("RX110", "Null cannot be assigned to a non-nullable type.", node.Line, node.Column, wanted, "Null", "Declare the destination as " + wanted + "? .");
            Return;
        }
        If (wanted != given) {
            This.diagnostics.TypeError("RX103", "This value is not assignable to the destination.", node.Line, node.Column, wanted, given, "Change the value or the declared type.");
        }
    }

    Private Function RequireBool(AstNode? node, String actual) -> Void {
        If (!This.strict) {
            Return;
        }
        If (node == Null) {
            Return;
        }
        If (actual.Length() == 0 || actual == "Unknown" || actual == "Bool") {
            Return;
        }
        This.diagnostics.TypeError("RX103", "A condition must be Bool. Robix does not use truthy coercion.", node.Line, node.Column, "Bool", actual, "Compare the value explicitly.");
    }

    Private Function MissingType(AstNode node, String label) -> Void {
        This.diagnostics.TypeError("RX104", label + " '" + node.Name + "' is missing a type.", node.Line, node.Column, "Type name", "missing", "Declare the parameter type.");
    }

    Private Function Undefined(AstNode node) -> Void {
        If (!This.strict) {
            Return;
        }
        This.diagnostics.TypeError("RX102", "'" + node.Name + "' is not declared.", node.Line, node.Column, "a declared name", node.Name, "Declare the variable before using it.");
    }

    Private Function NoteNullNarrowing(AstNode? condition) -> Symbol? {
        If (condition == Null) {
            Return Null;
        }
        If (condition.Kind != AstKind.Binary) {
            Return Null;
        }
        If (condition.Operator == "!=" && condition.Right != Null && condition.Right.Kind == AstKind.NullLiteral && condition.Left != Null && condition.Left.Kind == AstKind.Name) {
            Return This.Find(condition.Left.Name);
        }
        Return Null;
    }

    Private Function NoteNullExit(AstNode? condition) -> Symbol? {
        If (condition == Null) {
            Return Null;
        }
        If (condition.Kind != AstKind.Binary) {
            Return Null;
        }
        If (condition.Operator == "==" && condition.Right != Null && condition.Right.Kind == AstKind.NullLiteral && condition.Left != Null && condition.Left.Kind == AstKind.Name) {
            Return This.Find(condition.Left.Name);
        }
        Return Null;
    }

    Private Function BindPattern(AstNode? pattern, String typeName) -> Void {
        If (pattern == Null) {
            Return;
        }
        If (pattern.Name == "()" && pattern.Children.Count() > 0) {
            Int idx = 0;
            For child In pattern.Children {
                String partType = "Unknown";
                If (typeName.StartsWith("Enumerate<")) {
                    If (idx == 0) { partType = "Int"; }
                    Else { partType = This.ElementName(typeName); }
                }
                This.BindPattern(child, partType);
                idx = idx + 1;
            }
            Return;
        }
        If (pattern.Name.Length() > 0 && pattern.Name != "_" && pattern.Name != "()") {
            If (This.IsCamel(pattern.Name) || pattern.Text.Length() > 0) {
                This.Define(pattern.Name, typeName, False, False, True, False, False, False, pattern.Line, pattern.Column);
            }
        }
        For child In pattern.Children {
            This.BindPattern(child, typeName);
        }
    }

    Private Function ReturnsAlways(AstNode node) -> Bool {
        If (node.Kind == AstKind.Return) {
            Return True;
        }
        If (node.Kind == AstKind.Match) {
            If (node.Children.Count() == 0) { Return False; }
            For arm In node.Children {
                If (arm.Right == Null || !This.ReturnsAlways(arm.Right)) { Return False; }
            }
            Return True;
        }
        If (node.Kind == AstKind.Block) {
            For child In node.Children {
                If (This.ReturnsAlways(child)) {
                    Return True;
                }
            }
            Return False;
        }
        If (node.Kind == AstKind.If && node.Body != Null && node.Otherwise != Null) {
            Return This.ReturnsAlways(node.Body) && This.ReturnsAlways(node.Otherwise);
        }
        If (node.Kind == AstKind.Try && node.Body != Null && node.Children.Count() > 0) {
            If (!This.ReturnsAlways(node.Body)) { Return False; }
            For caught In node.Children {
                If (caught.Body == Null || !This.ReturnsAlways(caught.Body)) { Return False; }
            }
            Return True;
        }
        Return False;
    }

    Private Function RegisterFunction(AstNode node) -> Void {
        If (node.Name.Length() == 0) {
            Return;
        }
        If (This.Find(node.Name) != Null) {
            Return;
        }
        String returnType = This.TypeText(node.Type);
        This.Define(node.Name, returnType, False, False, True, True, node.FlagA || This.HasModifier(node, "Async"), False, node.Line, node.Column);
        This.functionNames.Add(node.Name);
        This.functionSignatures.Add(This.FunctionSignature(node));
        This.functionNodes.Add(node);
    }

    Private Function FunctionNodeOf(String name) -> AstNode? {
        Int index = 0;
        While (index < This.functionNames.Count() && index < This.functionNodes.Count()) {
            If (This.functionNames[index] == name) { Return This.functionNodes[index]; }
            index = index + 1;
        }
        Return Null;
    }

    Private Function ArgumentName(AstNode call, Int position, String parameterName) -> String {
        Int index = 0;
        For argument In call.Parameters {
            If (parameterName != "" && argument.Name == parameterName) {
                If (argument.Left != Null && argument.Left.Kind == AstKind.Name) { Return argument.Left.Name; }
                If (argument.Kind == AstKind.Name) { Return argument.Name; }
                Return "";
            }
            index = index + 1;
        }
        If (position < 0 || position >= call.Parameters.Count()) { Return ""; }
        AstNode chosen = call.Parameters[position];
        If (chosen.Kind == AstKind.Name) { Return chosen.Name; }
        If (chosen.Left != Null && chosen.Left.Kind == AstKind.Name) { Return chosen.Left.Name; }
        Return "";
    }

    Private Function CheckMutableArguments(AstNode call, AstNode function) -> Bool {
        Int position = 0;
        For parameter In function.Parameters {
            If (!parameter.FlagC) {
                If (parameter.FlagA && position < call.Parameters.Count()) {
                    String variable = This.ArgumentName(call, position, parameter.Name);
                    If (variable == "") {
                        This.diagnostics.TypeError("RX103", "A Mut parameter needs a variable.", call.Line, call.Column, "a Var binding", "a value", "Pass a variable.");
                        Return False;
                    }
                    Symbol? symbol = This.Find(variable);
                    If (symbol != Null) {
                        If (!symbol.Mutable || symbol.IsConst) {
                            This.diagnostics.TypeError("RX103", "Cannot assign to immutable '" + symbol.Name + "'.", call.Line, call.Column, "a Var binding", symbol.TypeName, "Declare it with Var.");
                            Return False;
                        }
                    }
                }
                position = position + 1;
            }
        }
        Return True;
    }

    Private Function FunctionSignature(AstNode node) -> String {
        String text = "Function<";
        Bool first = True;
        For parameter In node.Parameters {
            If (!parameter.FlagC) {
                If (!first) { text = text + ", "; }
                String parameterType = This.TypeText(parameter.Type);
                If (parameterType == "") { parameterType = "Int"; }
                text = text + parameterType;
                first = False;
            }
        }
        If (!first) { text = text + ", "; }
        String returnType = This.TypeText(node.Type);
        If (returnType == "") { returnType = "Void"; }
        Return text + returnType + ">";
    }

    Private Function FunctionTypeOf(String name) -> String {
        Int index = 0;
        While (index < This.functionNames.Count() && index < This.functionSignatures.Count()) {
            If (This.functionNames[index] == name) { Return This.functionSignatures[index]; }
            index = index + 1;
        }
        Return "";
    }

    Private Function ReferenceType(AstNode node) -> String {
        If (node.Parameters.Count() == 0 || node.Parameters[0].Left == Null) { Return "Int"; }
        AstNode argument = node.Parameters[0].Left;
        If (argument.Kind == AstKind.Unary && argument.Operator == "Mut" && argument.Left != Null) {
            Return "Mut " + This.Infer(argument.Left);
        }
        Return This.Infer(argument);
    }

    Private Function RefPayload(String typeName) -> String {
        If (!typeName.StartsWith("Ref<") || !typeName.EndsWith(">")) { Return "Int"; }
        String inner = typeName.Substring(4, typeName.Length() - 5);
        If (inner.StartsWith("Mut ")) { Return inner.Substring(4); }
        If (inner.StartsWith("Const ")) { Return inner.Substring(6); }
        Return inner;
    }

    Private Function DefineTypeFields() -> Void {
        If (This.currentType == "") { Return; }
        Int index = 0;
        While (index < This.fieldOwners.Count()) {
            Bool owned = This.fieldOwners[index] == This.currentType;
            Int base = 0;
            While (base < This.baseOwners.Count()) {
                If (This.baseOwners[base] == This.currentType && This.baseNames[base] == This.fieldOwners[index]) { owned = True; }
                Int grand = 0;
                While (grand < This.baseOwners.Count()) {
                    If (This.baseOwners[grand] == This.baseNames[base] && This.baseOwners[base] == This.currentType && This.baseNames[grand] == This.fieldOwners[index]) { owned = True; }
                    grand = grand + 1;
                }
                base = base + 1;
            }
            If (owned) {
                String visibility = This.MemberVisibility(This.fieldOwners[index], This.fieldNames[index]);
                Bool allowed = True;
                If (visibility == "Private" && This.fieldOwners[index] != This.currentType) { allowed = False; }
                If (visibility == "Protected" && This.fieldOwners[index] != This.currentType && !This.Derives(This.currentType, This.fieldOwners[index])) { allowed = False; }
                If (visibility == "Internal" && This.fieldOwners[index] != This.currentType) {
                    String ownerPackage = This.PackageOf(This.fieldOwners[index]);
                    If (ownerPackage == "" || ownerPackage != This.currentPackage) { allowed = False; }
                }
                If (allowed) {
                    This.Define(This.fieldNames[index], This.fieldTypes[index], True, False, True, False, False, False, 1, 1);
                }
            }
            index = index + 1;
        }
    }

    Private Function Define(String name, String typeName, Bool mutable, Bool nullable, Bool initialized, Bool isFunction, Bool isAsync, Bool isConst, Int line, Int column) -> Void {
        If (name.Length() == 0) {
            Return;
        }
        Symbol symbol = Symbol();
        symbol.Name = name + "";
        symbol.TypeName = typeName + "";
        symbol.Mutable = mutable;
        symbol.Nullable = nullable;
        symbol.Initialized = initialized;
        symbol.IsFunction = isFunction;
        symbol.IsAsync = isAsync;
        symbol.IsConst = isConst;
        symbol.Line = line;
        symbol.Column = column;
        This.symbols.Add(symbol);
    }

    Private Function Find(String name) -> Symbol? {
        Int index = This.symbols.Count() - 1;
        While (index >= 0) {
            If (This.symbols[index].Name == name) {
                Return This.symbols[index];
            }
            index = index - 1;
        }
        Return Null;
    }

    Private Function PushScope() -> Void {
        This.marks.Add(This.symbols.Count());
    }

    Private Function PopScope() -> Void {
        If (This.marks.Count() == 0) {
            Return;
        }
        Int mark = This.marks[This.marks.Count() - 1];
        Var keptSymbols = List<Symbol>();
        Int index = 0;
        While (index < mark && index < This.symbols.Count()) {
            keptSymbols.Add(This.symbols[index]);
            index = index + 1;
        }
        This.symbols = keptSymbols;
        Var keptMarks = List<Int>();
        Int markIndex = 0;
        While (markIndex < This.marks.Count() - 1) {
            keptMarks.Add(This.marks[markIndex]);
            markIndex = markIndex + 1;
        }
        This.marks = keptMarks;
    }

    Private Function CollectAliases(AstNode node) -> Void {
        For child In node.Children {
            If (child.Kind == AstKind.TypeAlias) {
                This.aliasNames.Add(child.Name);
                String target = "";
                If (child.Type != Null) { target = This.TypeText(child.Type); }
                This.aliasTargets.Add(target);
                String parameters = "";
                For parameter In child.Parameters {
                    If (parameters != "") { parameters = parameters + ", "; }
                    parameters = parameters + parameter.Name;
                }
                This.aliasParameters.Add(parameters);
            }
        }
    }

    Private Function ResolveType(String name) -> String {
        Int guard = 0;
        String current = name;
        While (guard < 8) {
            String next = "";
            Int index = 0;
            For alias In This.aliasNames {
                If (alias == current && This.aliasParameters[index] == "") { next = This.aliasTargets[index]; }
                index = index + 1;
            }
            If (next == "") { next = This.ApplyAlias(current); }
            If (next == "" || next == current) { Return current; }
            current = next;
            guard = guard + 1;
        }
        Return current;
    }

    Private Function ApplyAlias(String name) -> String {
        Int open = name.IndexOf("<");
        If (open < 0 || !name.EndsWith(">")) { Return ""; }
        String head = name.Substring(0, open);
        String arguments = name.Substring(open + 1, name.Length() - open - 2);
        Int index = 0;
        For alias In This.aliasNames {
            If (alias == head && This.aliasParameters[index] != "") {
                Return This.SubstituteAlias(This.aliasTargets[index], This.aliasParameters[index], arguments);
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function SubstituteAlias(String target, String parameters, String arguments) -> String {
        Var names = List<String>();
        Var values = List<String>();
        This.SplitTypeList(parameters, names);
        This.SplitTypeList(arguments, values);
        String result = "";
        String token = "";
        Int index = 0;
        While (index < target.Length()) {
            Char character = target.GetChar(index);
            Bool word = character == '_' || (character >= 'A' && character <= 'Z') || (character >= 'a' && character <= 'z') || (character >= '0' && character <= '9');
            If (word) {
                token = token + target.Substring(index, 1);
            } Else {
                If (token != "") {
                    result = result + This.ReplaceParameter(token, names, values);
                    token = "";
                }
                result = result + target.Substring(index, 1);
            }
            index = index + 1;
        }
        If (token != "") { result = result + This.ReplaceParameter(token, names, values); }
        Return result;
    }

    Private Function SplitTypeList(String text, List<String> parts) -> Void {
        String current = "";
        Int depth = 0;
        Int index = 0;
        While (index < text.Length()) {
            String character = text.Substring(index, 1);
            If (character == "<") {
                depth = depth + 1;
                current = current + character;
            } Else If (character == ">") {
                If (depth > 0) { depth = depth - 1; }
                current = current + character;
            } Else If (character == "," && depth == 0) {
                parts.Add(This.TrimType(current));
                current = "";
                If (index + 1 < text.Length() && text.Substring(index + 1, 1) == " ") { index = index + 1; }
            } Else {
                current = current + character;
            }
            index = index + 1;
        }
        If (current != "") { parts.Add(This.TrimType(current)); }
    }

    Private Function TrimType(String text) -> String {
        Int start = 0;
        Int end = text.Length();
        While (start < end && text.Substring(start, 1) == " ") { start = start + 1; }
        While (end > start && text.Substring(end - 1, 1) == " ") { end = end - 1; }
        Return text.Substring(start, end - start);
    }

    Private Function ReplaceParameter(String token, List<String> names, List<String> values) -> String {
        Int index = 0;
        While (index < names.Count() && index < values.Count()) {
            If (names[index] == token) { Return values[index]; }
            index = index + 1;
        }
        Return token;
    }

    Private Function GenericParameterText(AstNode node) -> String {
        String text = "";
        For parameter In node.Parameters {
            If (parameter.FlagC) {
                If (text != "") { text = text + ", "; }
                text = text + parameter.Name;
            }
        }
        Return text;
    }

    Private Function GenericParametersOf(String name) -> String {
        Int index = 0;
        While (index < This.genericOwners.Count() && index < This.genericParameters.Count()) {
            If (This.genericOwners[index] == name) { Return This.genericParameters[index]; }
            index = index + 1;
        }
        Return "";
    }

    Private Function AppliedOwner(String owner) -> String {
        String head = owner;
        If (head.EndsWith("?")) { head = head.Substring(0, head.Length() - 1); }
        Int open = head.IndexOf("<");
        If (open > 0 && head.EndsWith(">")) { head = head.Substring(0, open); }
        Return head;
    }

    Private Function TypeArguments(String owner) -> String {
        String clean = owner;
        If (clean.EndsWith("?")) { clean = clean.Substring(0, clean.Length() - 1); }
        Int open = clean.IndexOf("<");
        If (open < 0 || !clean.EndsWith(">")) { Return ""; }
        Return clean.Substring(open + 1, clean.Length() - open - 2);
    }

    Private Function AppliedObjectType(AstNode node) -> String {
        String typeName = node.Name;
        If (typeName == "") { Return ""; }
        If (node.Left == Null || node.Left.Children.Count() == 0) { Return typeName; }
        String text = typeName + "<";
        Bool first = True;
        For child In node.Left.Children {
            If (!first) { text = text + ", "; }
            String argument = This.TypeText(child);
            If (argument == "") { argument = child.Name; }
            If (argument == "") { argument = "Int"; }
            text = text + argument;
            first = False;
        }
        Return text + ">";
    }

    Private Function FieldTypeOf(String owner, String name) -> String {
        String head = This.AppliedOwner(owner);
        String found = "";
        Int index = 0;
        While (index < This.fieldOwners.Count() && index < This.fieldNames.Count() && index < This.fieldTypes.Count()) {
            If (This.fieldOwners[index] == head && This.fieldNames[index] == name) { found = This.fieldTypes[index]; }
            index = index + 1;
        }
        String arguments = This.TypeArguments(owner);
        String parameters = This.GenericParametersOf(head);
        If (found != "" && arguments != "" && parameters != "") {
            Return This.SubstituteAlias(found, parameters, arguments);
        }
        Return found;
    }

    Private Function TypeText(AstNode? type) -> String {
        If (type == Null) {
            Return "";
        }
        If (type.Kind != AstKind.Type) {
            Return type.Name + "";
        }
        If (type.Name == "|") {
            String joined = "";
            For child In type.Children {
                If (joined.Length() > 0) {
                    joined = joined + " | ";
                }
                joined = joined + This.TypeText(child);
            }
            Return joined + "";
        }
        If (type.Name == "()") {
            String joined = "(";
            Bool first = True;
            For child In type.Children {
                If (!first) { joined = joined + ", "; }
                joined = joined + This.TypeText(child);
                first = False;
            }
            Return joined + ")";
        }
        If (type.Name == "[]") {
            String element = "Unknown";
            If (type.Children.Count() > 0) {
                element = This.TypeText(type.Children[0]);
            }
            If (type.FlagC && type.Right != Null) { Return "[" + element + "; " + type.Right.Text + "]"; }
            Return "[" + element + "]";
        }
        If (type.Name == "{}") {
            String joined = "{";
            Bool first = True;
            For child In type.Children {
                If (!first) { joined = joined + ", "; }
                joined = joined + child.Name + ": " + This.TypeText(child.Type);
                first = False;
            }
            Return joined + "}";
        }
        String text = type.Name + "";
        If (type.Text == "Const" || type.Text == "Mut") { text = type.Text + " " + type.Name; }
        If (type.Text == "ConstMut") { text = "Const Mut " + type.Name; }
        If (type.Children.Count() > 0) {
            text = text + "<";
            Bool first = True;
            For child In type.Children {
                If (!first) { text = text + ", "; }
                text = text + This.TypeText(child);
                first = False;
            }
            text = text + ">";
        }
        If (type.FlagB && !This.DigitsOnly(type.Name)) {
            text = text + "[]";
        }
        If (type.FlagA) {
            text = text + "?";
        }
        Return text + "";
    }

    Private Function PromiseTypeOf(AstNode member) -> String {
        String argument = "Int";
        If (member.Left != Null && member.Left.Children.Count() > 0) {
            String text = This.TypeText(member.Left.Children[0]);
            If (text != "") { argument = text; }
        }
        Return "Promise<" + argument + ">";
    }

    Private Function PromiseCombinatorType(AstNode node, String method) -> String {
        String argument = "Array<Task<Int>>";
        If (node.Parameters.Count() > 0 && node.Parameters[0].Left != Null) {
            String inferred = This.Infer(node.Parameters[0].Left);
            If (inferred != "") { argument = inferred; }
        }
        String element = "Int";
        If (argument.StartsWith("Array<") && argument.EndsWith(">")) {
            element = argument.Substring(6, argument.Length() - 7);
        } Else If (argument.StartsWith("List:")) {
            element = argument.Substring(5);
        }
        If (element.StartsWith("Task<") && element.EndsWith(">")) {
            element = element.Substring(5, element.Length() - 6);
        }
        If (element.StartsWith("Promise<") && element.EndsWith(">")) {
            element = element.Substring(8, element.Length() - 9);
        }
        If (element.StartsWith("Lambda:")) { element = element.Substring(7); }
        If (method == "All") { Return "Promise<Array<" + element + ">>"; }
        If (method == "AllSettled") { Return "Promise<Array<PromiseSettlement<" + element + ">>>"; }
        Return "Promise<" + element + ">";
    }

    Private Function WhenAllType(AstNode node) -> String {
        String text = "(";
        Bool first = True;
        For argument In node.Parameters {
            If (!first) { text = text + ", "; }
            String argumentType = "Int";
            If (argument.Left != Null) { argumentType = This.Infer(argument.Left); }
            If (argumentType == "") { argumentType = "Int"; }
            If (argumentType.StartsWith("Task<") && argumentType.EndsWith(">")) {
                argumentType = argumentType.Substring(5, argumentType.Length() - 6);
            }
            If (argumentType.StartsWith("Promise<") && argumentType.EndsWith(">")) {
                argumentType = argumentType.Substring(8, argumentType.Length() - 9);
            }
            If (argumentType.StartsWith("Lambda:")) { argumentType = argumentType.Substring(7); }
            text = text + argumentType;
            first = False;
        }
        Return text + ")";
    }

    Private Function TaskCallType(String owner, String name) -> String {
        If (owner == "Task" && (name == "Delay" || name == "Yield")) { Return "Task<Void>"; }
        If (owner == "Task" && name == "Detach") { Return "Void"; }
        If (owner == "Timer" && name == "Sleep") { Return "Task<Void>"; }
        If (owner == "Duration" && (name == "Milliseconds" || name == "Seconds")) { Return "Int"; }
        If (owner == "Hardware" && name == "ReadSensor") { Return "Int"; }
        If (owner == "Hardware" && name == "WatchSensor") { Return "AsyncStream<Int>"; }
        If (owner == "Async" && name == "WaitUntil") { Return "Task<Bool>"; }
        If (owner == "Network" && name == "IsConnected") { Return "Bool"; }
        Return "";
    }

    Private Function InnerTask(String typeName) -> String {
        If (typeName.StartsWith("Task<") && typeName.EndsWith(">")) {
            Return typeName.Substring(5, typeName.Length() - 6);
        }
        If (typeName.StartsWith("Promise<") && typeName.EndsWith(">")) {
            Return typeName.Substring(8, typeName.Length() - 9);
        }
        Return typeName;
    }

    Private Function StripOptional(String typeName) -> String {
        If (typeName.EndsWith("?")) {
            Return typeName.Substring(0, typeName.Length() - 1);
        }
        Return typeName;
    }

    Private Function WidensTo(String expected, String actual) -> Bool {
        If (expected == "Int" || expected == "Int64") {
            Return actual == "Int" || actual == "Int8" || actual == "Int16" || actual == "Int32" || actual == "Int64";
        }
        If (expected == "Float" || expected == "Double" || expected == "Float64") {
            Return actual == "Float" || actual == "Double" || actual == "Float16" || actual == "Float32" || actual == "Float64";
        }
        Return False;
    }

    Private Function CallArgumentType(AstNode node) -> String {
        If (node.Parameters.Count() == 0 || node.Parameters[0].Left == Null) { Return "Int"; }
        String argument = This.Infer(node.Parameters[0].Left);
        If (argument == "") { Return "Int"; }
        Return argument;
    }

    Private Function CallTupleType(AstNode node) -> String {
        String text = "(";
        Bool first = True;
        For argument In node.Parameters {
            If (!first) { text = text + ", "; }
            String argumentType = "Int";
            If (argument.Left != Null) { argumentType = This.Infer(argument.Left); }
            text = text + argumentType;
            first = False;
        }
        Return text + ")";
    }

    Private Function LiteralElement(AstNode node) -> String {
        String element = "";
        For child In node.Children {
            String item = This.Infer(child);
            If (item == "") { item = "Int"; }
            If (element == "") { element = item; }
            If (item != element) { Return "Any"; }
        }
        If (element == "") { Return "Int"; }
        Return element;
    }

    Private Function ElementName(String typeName) -> String {
        If (typeName.StartsWith("Span<") && typeName.EndsWith(">")) { Return typeName.Substring(5, typeName.Length() - 6); }
        If (typeName.StartsWith("List:")) { Return typeName.Substring(5); }
        If (typeName.StartsWith("Array<") && typeName.EndsWith(">")) { Return typeName.Substring(6, typeName.Length() - 7); }
        If (typeName.StartsWith("AsyncStream<") && typeName.EndsWith(">")) { Return typeName.Substring(12, typeName.Length() - 13); }
        If (typeName.StartsWith("List<") && typeName.EndsWith(">")) { Return typeName.Substring(5, typeName.Length() - 6); }
        If (typeName.StartsWith("Set<") && typeName.EndsWith(">")) { Return typeName.Substring(4, typeName.Length() - 5); }
        If (typeName.StartsWith("Enumerate<") && typeName.EndsWith(">")) { Return typeName.Substring(10, typeName.Length() - 11); }
        If (typeName.StartsWith("Option<") && typeName.EndsWith(">")) { Return typeName.Substring(7, typeName.Length() - 8); }
        If (typeName.StartsWith("Result<") && typeName.EndsWith(">")) {
            Int comma = typeName.IndexOf(",");
            If (comma > 7) { Return typeName.Substring(7, comma - 7); }
            Return "Int";
        }
        If (typeName.StartsWith("[") && typeName.EndsWith("]")) {
            String body = typeName.Substring(1, typeName.Length() - 2);
            Int semi = body.IndexOf(";");
            If (semi >= 0) { Return body.Substring(0, semi); }
            Return body;
        }
        Return "";
    }

    Private Function SameElements(String expected, String actual) -> Bool {
        String left = This.ElementName(expected);
        String right = This.ElementName(actual);
        If (left == "" || left != right) { Return False; }
        If (expected.StartsWith("Map") || actual.StartsWith("Map")) { Return False; }
        If (expected.StartsWith("Set<") != actual.StartsWith("Set<")) { Return False; }
        Return True;
    }

    Private Function FixedCount(String typeName) -> Int {
        Int semi = typeName.IndexOf("; ");
        If (semi < 0 || !typeName.EndsWith("]")) { Return -1; }
        String number = typeName.Substring(semi + 2, typeName.Length() - semi - 3);
        If (number == "") { Return -1; }
        Return ParseInteger(number);
    }

    Private Function DigitsOnly(String text) -> Bool {
        If (text.Length() == 0) { Return False; }
        Int index = 0;
        While (index < text.Length()) {
            Char character = text.GetChar(index);
            If (character < '0' || character > '9') { Return False; }
            index = index + 1;
        }
        Return True;
    }

    Private Function WidthBits(String typeName) -> Int {
        If (typeName == "Int8" || typeName == "UInt8" || typeName == "Byte") { Return 8; }
        If (typeName == "Int16" || typeName == "UInt16") { Return 16; }
        If (typeName == "Int32" || typeName == "UInt32") { Return 32; }
        If (typeName == "Int" || typeName == "Int64" || typeName == "UInt" || typeName == "UInt64") { Return 64; }
        Int open = typeName.IndexOf("<");
        If (open < 0 || !typeName.EndsWith(">")) { Return 0; }
        If (!typeName.StartsWith("Int") && !typeName.StartsWith("UInt")) { Return 0; }
        String inner = typeName.Substring(open + 1, typeName.Length() - open - 2);
        If (inner == "") { Return 0; }
        Return ParseInteger(inner);
    }

    Private Function CleanDigits(String text) -> String {
        String digits = "";
        Int index = 0;
        While (index < text.Length()) {
            Char character = text.GetChar(index);
            If (character >= '0' && character <= '9') { digits = digits + text.Substring(index, 1); }
            index = index + 1;
        }
        If (digits == "") { Return "0"; }
        Int start = 0;
        While (start < digits.Length() - 1 && digits.GetChar(start) == '0') { start = start + 1; }
        Return digits.Substring(start);
    }

    Private Function DigitAt(String text, Int index) -> Int {
        Int raw = text.GetChar(index).ToInt();
        If (raw >= 48) { Return raw - 48; }
        Return raw;
    }

    Private Function DigitChar(Int digit) -> String {
        String table = "0123456789";
        Var index = digit;
        If (index < 0) { index = 0; }
        If (index > 9) { index = 9; }
        Return table.Substring(index, 1);
    }

    Private Function DoubleDecimal(String digits) -> String {
        String result = "";
        Int carry = 0;
        Int index = digits.Length() - 1;
        While (index >= 0) {
            Int digit = This.DigitAt(digits, index) * 2 + carry;
            carry = 0;
            If (digit >= 10) {
                carry = 1;
                digit = digit - 10;
            }
            result = This.DigitChar(digit) + result;
            index = index - 1;
        }
        If (carry == 1) { result = "1" + result; }
        Return result;
    }

    Private Function MinusOneDecimal(String digits) -> String {
        If (digits == "0") { Return "0"; }
        String result = "";
        Int borrow = 1;
        Int index = digits.Length() - 1;
        While (index >= 0) {
            Int digit = This.DigitAt(digits, index) - borrow;
            borrow = 0;
            If (digit < 0) {
                digit = digit + 10;
                borrow = 1;
            }
            result = This.DigitChar(digit) + result;
            index = index - 1;
        }
        Return This.CleanDigits(result);
    }

    Private Function PowerLimit(Int bits, Bool includeTop) -> String {
        If (bits <= 0) { Return "0"; }
        String digits = "1";
        Int count = 0;
        While (count < bits) {
            digits = This.DoubleDecimal(digits);
            count = count + 1;
        }
        If (!includeTop) { digits = This.MinusOneDecimal(digits); }
        Return digits;
    }

    Private Function DigitsWithin(String digits, String limit) -> Bool {
        If (digits.Length() != limit.Length()) { Return digits.Length() < limit.Length(); }
        Int index = 0;
        While (index < digits.Length()) {
            Int left = This.DigitAt(digits, index);
            Int right = This.DigitAt(limit, index);
            If (left != right) { Return left < right; }
            index = index + 1;
        }
        Return True;
    }

    Private Function FitsIntegerLiteral(AstNode node, String expected) -> Bool {
        Int sign = 1;
        AstNode literal = node;
        If (node.Kind == AstKind.Unary && node.Operator == "-" && node.Left != Null && node.Left.Kind == AstKind.IntegerLiteral) {
            sign = -1;
            literal = node.Left;
        }
        If (literal.Kind != AstKind.IntegerLiteral) { Return False; }
        Int bits = This.WidthBits(expected);
        If (bits <= 0) { Return False; }
        String digits = This.CleanDigits(literal.Text);
        Bool unsigned = expected == "Byte" || expected.StartsWith("UInt");
        If (sign < 0) {
            If (unsigned) { Return False; }
            Return This.DigitsWithin(digits, This.PowerLimit(bits - 1, True));
        }
        Return This.DigitsWithin(digits, This.PowerLimit(bits, False));
    }

    Private Function FitsFloatLiteral(AstNode node, String expected) -> Bool {
        If (node.Kind != AstKind.FloatLiteral) { Return False; }
        Return expected == "Float" || expected == "Double" || expected == "Float16" || expected == "Float32" || expected == "Float64";
    }

    Private Function FitsDecimalLiteral(AstNode node, String expected) -> Bool {
        If (expected != "Decimal") { Return False; }
        Return node.Kind == AstKind.FloatLiteral || node.Kind == AstKind.IntegerLiteral;
    }

    Private Function IsNumeric(String typeName) -> Bool {
        Return typeName == "Int" || typeName == "UInt" || typeName == "Byte" || typeName == "Float" || typeName == "Double" || typeName == "Decimal" || typeName.StartsWith("Int") || typeName.StartsWith("UInt") || typeName.StartsWith("Float");
    }

    Private Function IsTypeName(String name) -> Bool {
        Return name == "Int" || name == "UInt" || name == "Float" || name == "Double" || name == "Decimal" || name == "Bool" || name == "Char" || name == "String" || name == "Byte";
    }

    Private Function IsCamel(String name) -> Bool {
        If (name.Length() == 0) {
            Return False;
        }
        Char first = name.GetChar(0);
        Return first >= 'a' && first <= 'z';
    }

    Private Function CollectTypes(AstNode node) -> Void {
        If (node.Kind == AstKind.Package && node.Name != "") {
            This.currentPackage = node.Name;
        }
        If (node.Kind == AstKind.Class) {
            String flag = "Open";
            If (This.HasModifier(node, "Sealed") || This.HasModifier(node, "Final")) { flag = "Sealed"; }
            Else If (This.HasModifier(node, "Abstract") || node.Text == "Interface" || node.Text == "Trait" || node.Text == "Service") { flag = "Abstract"; }
            This.typeNames.Add(node.Name);
            This.typeFlags.Add(flag);
            This.typePackages.Add(This.currentPackage);
            For baseType In node.Members {
                This.baseOwners.Add(node.Name);
                This.baseNames.Add(baseType.Name);
            }
            For child In node.Children {
                If (child.Kind == AstKind.Field || child.Kind == AstKind.Function) {
                    String visibility = "Public";
                    If (This.HasModifier(child, "Private")) { visibility = "Private"; }
                    Else If (This.HasModifier(child, "Protected")) { visibility = "Protected"; }
                    Else If (This.HasModifier(child, "Internal")) { visibility = "Internal"; }
                    String kind = "Concrete";
                    If (child.Kind == AstKind.Field) { kind = "Field"; }
                    Else If (This.HasModifier(child, "Sealed") || This.HasModifier(child, "Final")) { kind = "Sealed"; }
                    Else If (This.HasModifier(child, "Abstract") || (child.Body == Null && child.Left == Null)) { kind = "Abstract"; }
                    This.memberOwners.Add(node.Name);
                    This.memberNames.Add(child.Name);
                    This.memberVisibility.Add(visibility);
                    This.memberKinds.Add(kind);
                }
                If (child.Kind == AstKind.Class) { This.CollectTypes(child); }
            }
        }
        If (node.Kind != AstKind.Class) {
            For child In node.Children {
                This.CollectTypes(child);
            }
            If (node.Body != Null) { This.CollectTypes(node.Body); }
        }
    }

    Private Function TypeFlagOf(String name) -> String {
        Int index = 0;
        While (index < This.typeNames.Count() && index < This.typeFlags.Count()) {
            If (This.typeNames[index] == name) { Return This.typeFlags[index]; }
            index = index + 1;
        }
        Return "";
    }

    Private Function PackageOf(String name) -> String {
        Int index = 0;
        While (index < This.typeNames.Count() && index < This.typePackages.Count()) {
            If (This.typeNames[index] == name) { Return This.typePackages[index]; }
            index = index + 1;
        }
        Return "";
    }

    Private Function MemberVisibility(String owner, String name) -> String {
        Int index = 0;
        While (index < This.memberOwners.Count() && index < This.memberNames.Count() && index < This.memberVisibility.Count()) {
            If (This.memberOwners[index] == owner && This.memberNames[index] == name) { Return This.memberVisibility[index]; }
            index = index + 1;
        }
        Return "";
    }

    Private Function MemberKind(String owner, String name) -> String {
        Int index = 0;
        While (index < This.memberOwners.Count() && index < This.memberNames.Count() && index < This.memberKinds.Count()) {
            If (This.memberOwners[index] == owner && This.memberNames[index] == name) { Return This.memberKinds[index]; }
            index = index + 1;
        }
        Return "";
    }

    Private Function CheckTypeRules(AstNode node) -> Void {
        For baseType In node.Members {
            If (This.TypeFlagOf(baseType.Name) == "Sealed") {
                This.diagnostics.TypeError("RX130", "'" + node.Name + "' cannot inherit from sealed type '" + baseType.Name + "'.", node.Line, node.Column, "an open base", "sealed " + baseType.Name, "Use composition instead of inheriting a sealed type.");
            }
        }
        If (This.TypeFlagOf(node.Name) != "Abstract") {
            Var seen = List<String>();
            seen.Add(node.Name);
            Int cursor = 0;
            While (cursor < seen.Count() && cursor < 64) {
                Int base = 0;
                While (base < This.baseOwners.Count()) {
                    If (This.baseOwners[base] == seen[cursor]) {
                        String baseName = This.baseNames[base];
                        Bool known = False;
                        For item In seen {
                            If (item == baseName) { known = True; }
                        }
                        If (!known) { seen.Add(baseName); }
                    }
                    base = base + 1;
                }
                cursor = cursor + 1;
            }
            Var reported = List<String>();
            Int seenIndex = 1;
            While (seenIndex < seen.Count()) {
                Int member = 0;
                While (member < This.memberOwners.Count()) {
                    If (This.memberOwners[member] == seen[seenIndex] && This.memberKinds[member] == "Abstract") {
                        String memberName = This.memberNames[member];
                        Bool already = False;
                        For item In reported {
                            If (item == memberName) { already = True; }
                        }
                        If (!already && !This.HasConcrete(node.Name, memberName)) {
                            reported.Add(memberName);
                            This.diagnostics.TypeError("RX134", "'" + node.Name + "' must implement '" + memberName + "'.", node.Line, node.Column, "an implementation", "missing", "Add an Override or a concrete member.");
                        }
                    }
                    member = member + 1;
                }
                seenIndex = seenIndex + 1;
            }
        }
        For child In node.Children {
            If (child.Kind == AstKind.Function && This.HasModifier(child, "Override")) {
                String found = This.BaseDeclaringOwner(node.Name, child.Name);
                If (found == "") {
                    This.diagnostics.TypeError("RX133", "Override '" + child.Name + "' does not match a base member.", child.Line, child.Column, "a base member", "no base member", "Remove Override or inherit the member.");
                } Else If (This.MemberKind(found, child.Name) == "Sealed") {
                    This.diagnostics.TypeError("RX138", "'" + child.Name + "' is sealed and cannot be overridden.", child.Line, child.Column, "a new member", "sealed " + child.Name, "Remove Override.");
                }
            }
        }
    }

    Private Function HasConcrete(String typeName, String memberName) -> Bool {
        Var pending = List<String>();
        pending.Add(typeName);
        Int cursor = 0;
        While (cursor < pending.Count() && cursor < 64) {
            String current = pending[cursor];
            Int index = 0;
            While (index < This.memberOwners.Count()) {
                If (This.memberOwners[index] == current && This.memberNames[index] == memberName) {
                    If (This.memberKinds[index] == "Concrete" || This.memberKinds[index] == "Sealed") { Return True; }
                }
                index = index + 1;
            }
            Int base = 0;
            While (base < This.baseOwners.Count()) {
                If (This.baseOwners[base] == current) { pending.Add(This.baseNames[base]); }
                base = base + 1;
            }
            cursor = cursor + 1;
        }
        Return False;
    }

    Private Function DeclaringOwner(String owner, String memberName) -> String {
        Var pending = List<String>();
        pending.Add(owner);
        Int cursor = 0;
        While (cursor < pending.Count() && cursor < 64) {
            String current = pending[cursor];
            If (This.MemberVisibility(current, memberName) != "") { Return current; }
            Int base = 0;
            While (base < This.baseOwners.Count()) {
                If (This.baseOwners[base] == current) { pending.Add(This.baseNames[base]); }
                base = base + 1;
            }
            cursor = cursor + 1;
        }
        Return "";
    }

    Private Function BaseDeclaringOwner(String owner, String memberName) -> String {
        Int index = 0;
        While (index < This.baseOwners.Count()) {
            If (This.baseOwners[index] == owner) {
                String found = This.DeclaringOwner(This.baseNames[index], memberName);
                If (found != "") { Return found; }
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function CheckVisibility(String owner, String memberName, AstNode node) -> Void {
        If (owner == "" || This.TypeFlagOf(owner) == "") { Return; }
        String declaring = This.DeclaringOwner(owner, memberName);
        If (declaring == "") { Return; }
        String visibility = This.MemberVisibility(declaring, memberName);
        If (visibility == "" || visibility == "Public") { Return; }
        If (visibility == "Private") {
            If (This.currentType == declaring) { Return; }
            This.diagnostics.TypeError("RX135", "'" + memberName + "' is private to '" + declaring + "'.", node.Line, node.Column, "a member of " + declaring, "private access", "Use a public method of the declaring type.");
            Return;
        }
        If (visibility == "Protected") {
            If (This.currentType == declaring || This.Derives(This.currentType, declaring)) { Return; }
            This.diagnostics.TypeError("RX136", "'" + memberName + "' is protected in '" + declaring + "'.", node.Line, node.Column, "the declaring type or a derived type", "outside access", "Use a public method or move the call into a derived type.");
            Return;
        }
        If (visibility == "Internal") {
            If (This.currentType == declaring) { Return; }
            String ownerPackage = This.PackageOf(declaring);
            If (ownerPackage != "" && ownerPackage == This.currentPackage) { Return; }
            This.diagnostics.TypeError("RX137", "'" + memberName + "' is internal to package '" + ownerPackage + "'.", node.Line, node.Column, "the same package", "another package", "Expose a public method or stay in the declaring package.");
        }
    }

    Private Function Derives(String derived, String base) -> Bool {
        If (derived == "" || base == "") { Return False; }
        If (derived == base) { Return True; }
        Var pending = List<String>();
        pending.Add(derived);
        Int cursor = 0;
        While (cursor < pending.Count() && cursor < 64) {
            Int index = 0;
            While (index < This.baseOwners.Count()) {
                If (This.baseOwners[index] == pending[cursor]) {
                    If (This.baseNames[index] == base) { Return True; }
                    pending.Add(This.baseNames[index]);
                }
                index = index + 1;
            }
            cursor = cursor + 1;
        }
        Return False;
    }

    Private Function IsAmbiguousMember(String typeName, String memberName) -> Bool {
        If (memberName == "" || This.MemberVisibility(typeName, memberName) != "") { Return False; }
        Int hits = 0;
        Int index = 0;
        While (index < This.baseOwners.Count()) {
            If (This.baseOwners[index] == typeName && This.DeclaringOwner(This.baseNames[index], memberName) != "") {
                hits = hits + 1;
            }
            index = index + 1;
        }
        Return hits > 1;
    }

    Private Function HasModifier(AstNode node, String name) -> Bool {
        For modifier In node.Modifiers {
            If (modifier.ToLower() == name.ToLower()) {
                Return True;
            }
        }
        Return False;
    }
}
