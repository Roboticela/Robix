Test Expect {
    Case "expect eof" {
        Input: kind = TokenKind.EndOfFile, message = "expected eof";
        Assert: Result.Kind == TokenKind.EndOfFile;
    }
}

Test ConsumeGreater {
    Case "consume greater at eof" {
        Input: message = "expected greater";
        Output: False;
