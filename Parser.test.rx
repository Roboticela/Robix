// Tests for Parser.rx.

Test ParseTestSections {
    Case "parse test sections" {
        Input: node = AstNode(Kind: AstKind.Test);
        Assert: node.Kind == AstKind.Test;
    }
}

Test ParseTestCase {
    Case "parse test case" {
        Input: parent = AstNode(Kind: AstKind.Test, Name: "ParentTest");
        Assert: Result.Name == "ParentTest";
    }
}

Test ParseTestCheck {
    Case "parse assert check" {
        Input: label = "Assert";
        Assert: Result.Kind == AstKind.Constraint;
    }
}

Test IsTestCheck {
    Case "assert is test check" {
        Input: name = "Assert";
        Output: True;
    }
    Case "foo is not test check" {
        Input: name = "Foo";
        Output: False;
    }
}

