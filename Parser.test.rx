Test Check {
    Case "check eof" {
        Input: kind = TokenKind.EndOfFile;
        Output: True;
    }
    Case "check plus" {
        Input: kind = TokenKind.Plus;
        Output: False;
    }
}

Test Match {
    Case "match plus is false at eof" {
        Input: kind = TokenKind.Plus;
        Output: False;
    }
}

Test Advance {
