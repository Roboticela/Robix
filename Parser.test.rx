Test IsTypeDeclarationKeyword {
    Case "class is type declaration keyword" {
        Input: kind = TokenKind.Class;
        Output: True;
    }
    Case "plus is not type declaration keyword" {
        Input: kind = TokenKind.Plus;
        Output: False;
    }
}

Test IsModifier {
    Case "public is modifier" {
        Input: kind = TokenKind.Public;
        Output: True;
    }
    Case "plus is not modifier" {
        Input: kind = TokenKind.Plus;
        Output: False;
    }
}

Test ModifierHas {
    Case "has modifier" {
        Input: modifiers = ["Public", "Const"], name = "Const";
        Output: True;
    }
    Case "missing modifier" {
        Input: modifiers = ["Public"], name = "Private";
        Output: False;
    }
}

Test CopyModifiers {
    Case "copy modifiers" {
        Input: node = AstNode(), modifiers = ["Public"];
        Assert: modifiers.Count() == 1;
    }
}

