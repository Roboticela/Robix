// Tests for ParserExpressions.rx.

Test ParseExpressionOnly {
    Case "parse expression only at eof" {
        Input:;
        Assert: Result != Null;
    }
}

Test ParseExpression {
    Case "parse expression at eof" {
        Input:;
        Assert: Result != Null;
    }
}

Test ParsePrecedence {
    Case "parse precedence 0" {
        Input: minimum = 0;
        Assert: Result != Null;
    }
}

Test ParseUnary {
    Case "parse unary at eof" {
        Input:;
        Assert: Result != Null;
    }
}

