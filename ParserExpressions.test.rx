        Assert: Result != Null;
    }
}

Test ParsePostfix {
    Case "parse postfix at eof" {
        Input: left = AstNode();
        Assert: Result != Null;
    }
}

Test ParseStringLiteral {
    Case "parse string literal at eof" {
        Input:;
