Test TryAttachGeneric {
    Case "try attach generic" {
        Input: target = AstNode();
        Assert: target != Null;
    }
}

Test GenericFollows {
    Case "generic follows at eof" {
        Input:;
        Output: False;
    }
}

Test LooksLikeTypedVariable {
    Case "looks like typed variable at eof" {
        Input:;
        Output: False;
    }
}

Test StartsTypeAtCursor {
    Case "starts type at eof" {
        Input:;
        Output: False;
    }
}

Test SkipTypeLook {
    Case "skip type look at eof" {
        Input:;
        Output: False;
    }
}

Test SkipTypeSuffixLook {
    Case "skip type suffix look at eof" {
        Input:;
        Assert: True;
    }
}

Test SkipTypeAtom {
    Case "skip type atom at eof" {
        Input:;
        Output: False;
    }
}

Test SkipAngles {
    Case "skip angles at eof" {
        Input:;
        Output: False;
    }
}

Test SkipNest {
    Case "skip nest at eof" {
        Input: open = TokenKind.OpenParen, close = TokenKind.CloseParen;
        Output: False;
    }
}

Test LookKind {
    Case "look kind at eof" {
        Input:;
        Output: TokenKind.EndOfFile;
    }
}

Test BinaryPrecedence {
    Case "plus precedence is 60" {
        Input: token = Token(Kind: TokenKind.Plus);
        Output: 60;
    }
}

Test CustomPrecedence {
    Case "unregistered custom precedence is minus one" {
        Input: name = "⊗";
        Output: -1;
    }
}

Test IsRightAssociative {
    Case "unregistered operator is not right associative" {
        Input: token = Token(Text: "+");
        Output: False;
    }
}

Test IsAssignment {
    Case "assign is assignment" {
        Input: kind = TokenKind.Assign;
        Output: True;
    }
    Case "equal equal is not assignment" {
        Input: kind = TokenKind.EqualEqual;
        Output: False;
    }
}

Test IsPrefixOperator {
    Case "minus is prefix operator" {
        Input: kind = TokenKind.Minus;
        Output: True;
    }
    Case "assign is not prefix operator" {
        Input: kind = TokenKind.Assign;
        Output: False;
    }
}

Test IsExpressionStop {
    Case "eof is expression stop" {
        Input: kind = TokenKind.EndOfFile;
        Output: True;
    }
    Case "plus is not expression stop" {
        Input: kind = TokenKind.Plus;
        Output: False;
    }
}

Test StartsExpression {
    Case "identifier starts expression" {
        Input: kind = TokenKind.Identifier;
        Output: True;
    }
    Case "close paren does not start expression" {
        Input: kind = TokenKind.CloseParen;
        Output: False;
    }
}

Test IsLambdaAhead {
    Case "lambda ahead at eof" {
        Input:;
        Output: False;
    }
}

Test BraceIsObjectLiteral {
    Case "brace is object literal at eof" {
        Input:;
        Output: False;
    }
}

Test IsOperatorToken {
    Case "plus is operator token" {
        Input: kind = TokenKind.Plus;
        Output: True;
    }
    Case "eof is not operator token" {
        Input: kind = TokenKind.EndOfFile;
        Output: False;
    }
}

Test IsPrimaryName {
    Case "this is primary name" {
        Input: kind = TokenKind.This;
        Output: True;
    }
    Case "plus is not primary name" {
        Input: kind = TokenKind.Plus;
        Output: False;
    }
}

Test IsTypeKeyword {
    Case "int is type keyword" {
        Input: kind = TokenKind.Int;
        Output: True;
    }
    Case "plus is not type keyword" {
        Input: kind = TokenKind.Plus;
        Output: False;
    }
}

Test IsNameKeyword {
    Case "this is name keyword" {
        Input: kind = TokenKind.This;
        Output: True;
    }
    Case "plus is not name keyword" {
        Input: kind = TokenKind.Plus;
        Output: False;
    }
}
