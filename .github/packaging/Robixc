#!/bin/sh
set -eu

HERE=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$HERE/.." && pwd)
ENGINE="$ROOT/Shared/Tools/Compiler"

if [ "$#" -lt 2 ] || [ ! -x "$ENGINE" ]; then
    echo "Robixc compiles a Robix file into a machine-code program." >&2
    echo "Usage: Robixc <File.rx> <Output>" >&2
    echo "       Robixc <Folder> <Output>" >&2
    exit 1
fi

source=$1
output=$2
if [ -d "$source" ]; then
    found=$(find "$source" -maxdepth 1 -type f -name '*.rx' ! -name '*.test.rx' | sort)
    source=""
    for file in $found; do
        if grep -q 'Function Main' "$file"; then
            source=$file
            break
        fi
    done
    if [ -z "$source" ]; then
        echo "error: the folder has no Robix program" >&2
        exit 1
    fi
fi

if [ ! -f "$source" ]; then
    echo "error: source was not found: $source" >&2
    exit 1
fi

"$ENGINE" "$source" "$output" --target linux-x64
chmod +x "$output"
