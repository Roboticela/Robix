// Front end shared by robixc and the Robix interpreter.
Package Robix.Syntax;

Import Robix.Core;


Public Class CompileResult {
    Public AstNode Module;
    Public List<Byte> Image;
    Public String NativeIr;
    Public String Rxir;
    Public Bool Succeeded;
    Public Int SyntaxErrors;
    Public Int Errors;

    Public Constructor() {
        This.Module = AstNode();
        This.Image = List<Byte>();
        This.NativeIr = "";
        This.Rxir = "";
        This.Succeeded = False;
        This.SyntaxErrors = 0;
        This.Errors = 0;
    }
}

Public Class SyntaxCompiler {
    Public Bool GateTests;

    Public Constructor() {
        This.GateTests = True;
    }

    Public Function CompileSource(String source, String fileName, Bool compile) -> CompileResult
    Explain {
        Description: "Lex, parse, name-check, and type-check Robix source.";
        Input: source = "Robix source text", fileName = "File name used for naming diagnostics", compile = "True to emit a package image and require a test for every function";
        Processing: "Parse the syntax and apply the always-strict type rules. When compile is true, require a companion test for every function, then emit a package. The interpreter leaves compile false and ignores missing tests.";
        Output: "The module, diagnostics outcome, and package bytes when compilation succeeds.";
    } {
        DiagnosticBag diagnostics = DiagnosticBag();
        CompileResult result = CompileResult();
        Lexer lexer = Lexer(source, diagnostics);
        Parser parser = Parser(lexer.Tokenize(), diagnostics);
        AstNode module = parser.Parse();
        This.RequireUses(source, diagnostics);
        Var loaded = List<String>();
        This.LoadImports(module, loaded, diagnostics);
        If (diagnostics.ErrorCount() == 0) {
            NameChecker names = NameChecker(diagnostics, compile);
            names.Check(module, fileName);
            TypeChecker types = TypeChecker(diagnostics);
            types.Check(module);
        }
        If (compile && This.GateTests && diagnostics.SyntaxErrorCount() == 0) {
            This.RequireFunctionTests(fileName, module, diagnostics);
        }
        result.Module = module;
        result.SyntaxErrors = diagnostics.SyntaxErrorCount();
        result.Errors = diagnostics.ErrorCount();
        If (result.Errors == 0) {
            If (compile) {
                RxProgram rxir = RxProgram();
                result.Rxir = rxir.LowerModule(module);
            }
            result.Succeeded = True;
        }
        result.Module.Number = diagnostics.Count();
        This.AttachDiagnostics(result.Module, diagnostics);
        Return result;
    }

    Public Function CompileProgram(List<String> sources, List<String> names, Bool compile) -> CompileResult
    Explain {
        Description: "Compile the compiler sources as one program.";
        Input: sources = "Source text of each project file", names = "File name for each source", compile = "True to lower RXIR";
        Processing: "Parse every file, keep the declarations, and type-check one module. Package imports are not loaded.";
        Output: "The merged module and its RXIR when the strict check passes.";
    } {
        DiagnosticBag diagnostics = DiagnosticBag();
        CompileResult result = CompileResult();
        AstNode module = AstNode();
        module.Kind = AstKind.Module;
        module.Name = "Robix";
        Int index = 0;
        While (index < sources.Count()) {
            String source = sources[index];
            This.RequireUses(source, diagnostics);
            Lexer lexer = Lexer(source, diagnostics);
            Parser parser = Parser(lexer.Tokenize(), diagnostics);
            AstNode parsed = parser.Parse();
            If (parsed.Children != Null) {
                For child In parsed.Children {
                    If (child.Kind != AstKind.Import && child.Kind != AstKind.Package) {
                        module.Children.Add(child);
                    }
                }
            }
            index = index + 1;
        }
        This.MergePartial(module);
        If (diagnostics.ErrorCount() == 0) {
            NameChecker checker = NameChecker(diagnostics, compile);
            checker.Check(module, "Robix.rxp");
            TypeChecker types = TypeChecker(diagnostics);
            types.Check(module);
        }
        result.Module = module;
        result.SyntaxErrors = diagnostics.SyntaxErrorCount();
        result.Errors = diagnostics.ErrorCount();
        If (result.Errors == 0) {
            If (compile) {
                RxProgram rxir = RxProgram();
                result.Rxir = rxir.LowerModule(module);
            }
            result.Succeeded = True;
        }
        result.Module.Number = diagnostics.Count();
        This.AttachDiagnostics(result.Module, diagnostics);
        Return result;
    }

    Public Function RequireFunctionTests(String fileName, AstNode module, DiagnosticBag diagnostics) -> Void
    Explain {
        Description: "Require every function in a compiled file to have its own test.";
        Input: fileName = "Source path ending in .rx", module = "Parsed module", diagnostics = "Bag that receives RX120 errors";
        Processing: "The compiler reports a missing companion or a function with no matching Test. Test files are skipped. The interpreter does not call this.";
        Output: "No return value. Errors are stored in diagnostics.";
    } {
        If (!fileName.EndsWith(".rx") || fileName.EndsWith(".test.rx")) {
            Return;
        }
        String companion = fileName.Substring(0, fileName.Length() - 3) + ".test.rx";
        If (!Files.Exists(companion)) {
            diagnostics.Error("RX120", fileName + " requires " + companion + ".", 1, 1);
            Return;
        }
        DiagnosticBag parsed = DiagnosticBag();
        Lexer lexer = Lexer(Files.ReadText(companion), parsed);
        Parser parser = Parser(lexer.Tokenize(), parsed);
        AstNode tests = parser.Parse();
        If (parsed.ErrorCount() > 0) {
            For item In parsed.All() {
                If (item.Severity == DiagnosticSeverity.Error) {
                    diagnostics.Error("RX120", companion + " " + item.Message, item.Line, item.Column);
                }
            }
            Return;
        }
        Var covered = List<String>();
        This.CollectTestCoverage(tests, covered);
        This.ReportUntestedFunctions(module, covered, companion, diagnostics);
    }

    Private Function CollectTestCoverage(AstNode node, List<String> covered) -> Void {
        If (node.Kind == AstKind.Test && node.Name != "" && !This.CoverageListed(covered, node.Name)) {
            covered.Add(node.Name);
        }
        For child In node.Children {
            This.CollectTestCoverage(child, covered);
        }
        If (node.Body != Null) {
            This.CollectTestCoverage(node.Body, covered);
        }
    }

    Private Function CoverageListed(List<String> covered, String name) -> Bool {
        For existing In covered {
            If (existing == name) { Return True; }
        }
        Return False;
    }

    Private Function ReportUntestedFunctions(AstNode node, List<String> covered, String companion, DiagnosticBag diagnostics) -> Void {
        If (This.ImportedDeclaration(node)) {
            Return;
        }
        If (node.Kind == AstKind.Function && node.Name != "" && !This.CoverageListed(covered, node.Name)) {
            Int line = node.Line;
            Int column = node.Column;
            If (line < 1) { line = 1; }
            If (column < 1) { column = 1; }
            diagnostics.Error("RX120", companion + " has no test for '" + node.Name + "'.", line, column);
        }
        For child In node.Children {
            This.ReportUntestedFunctions(child, covered, companion, diagnostics);
        }
        If (node.Body != Null) {
            This.ReportUntestedFunctions(node.Body, covered, companion, diagnostics);
        }
    }

    Private Function ImportedDeclaration(AstNode node) -> Bool {
        For modifier In node.Modifiers {
            If (modifier == "Imported") { Return True; }
        }
        Return False;
    }

    Public Function DiagnosticsOf(CompileResult result) -> List<String>
    Explain {
        Description: "Return formatted diagnostics stored on a compile result.";
        Input: result = "Result produced by CompileSource";
        Processing: "Read the diagnostic lines saved on the module.";
        Output: "One display line per diagnostic.";
    } {
        Var lines = List<String>();
        For child In result.Module.Attributes {
            If (child.Kind == AstKind.ExplainEntry) {
                lines.Add(child.Text);
            }
        }
        Return lines;
    }

    Private Function MergePartial(AstNode module) -> Void {
        If (module.Children == Null) { Return; }
        Var kept = List<AstNode>();
        For child In module.Children {
            Bool merged = False;
            If (child.Kind == AstKind.Class) {
                For earlier In kept {
                    If (earlier.Kind == AstKind.Class && earlier.Name == child.Name && earlier.Children != Null && child.Children != Null) {
                        For member In child.Children {
                            earlier.Children.Add(member);
                        }
                        merged = True;
                    }
                }
            }
            If (!merged) { kept.Add(child); }
        }
        module.Children = kept;
    }

    Private Function LoadImports(AstNode module, List<String> loaded, DiagnosticBag diagnostics) -> Void {
        Var names = List<String>();
        For child In module.Children {
            If (child.Kind == AstKind.Import && child.Name != "") {
                names.Add(child.Name);
            }
        }
        For packageName In names {
            This.LoadPackage(module, packageName, loaded, diagnostics);
        }
    }

    Private Function LoadPackage(AstNode module, String packageName, List<String> loaded, DiagnosticBag diagnostics) -> Void {
        For seen In loaded {
            If (seen == packageName) { Return; }
        }
        loaded.Add(packageName);
        String path = This.PackagePath(packageName);
        If (path == "" || !Files.Exists(path)) { Return; }
        DiagnosticBag parsed = DiagnosticBag();
        Lexer lexer = Lexer(Files.ReadText(path), parsed);
        Parser parser = Parser(lexer.Tokenize(), parsed);
        AstNode imported = parser.Parse();
        If (parsed.ErrorCount() > 0) {
            diagnostics.TypeError("RX170", "Package '" + packageName + "' has syntax errors.", This.ImportLine(module, packageName), This.ImportColumn(module, packageName), "a valid package", packageName, "Fix the package source.");
            Return;
        }
        This.LoadImports(imported, loaded, diagnostics);
        For child In imported.Children {
            If (child.Kind != AstKind.Import) {
                child.Modifiers.Add("Imported");
                module.Children.Add(child);
            }
        }
    }

    Private Function ImportLine(AstNode module, String packageName) -> Int {
        For child In module.Children {
            If (child.Kind == AstKind.Import && child.Name == packageName) { Return child.Line; }
        }
        Return 1;
    }

    Private Function ImportColumn(AstNode module, String packageName) -> Int {
        For child In module.Children {
            If (child.Kind == AstKind.Import && child.Name == packageName) { Return child.Column; }
        }
        Return 1;
    }

    Private Function RequireUses(String source, DiagnosticBag diagnostics) -> Void {
        String catalog = This.TypeCatalog();
        String imported = This.DirectImports(source);
        String declared = This.DeclaredNames(source);
        String reported = ";";
        String previous = "";
        Int index = 0;
        Int line = 1;
        Int column = 1;
        While (index < source.Length()) {
            Int code = source.GetChar(index).ToInt();
            If (code == 10) {
                line = line + 1;
                column = 1;
                index = index + 1;
            } Else If (code == 47 && index + 1 < source.Length() && source.GetChar(index + 1).ToInt() == 47) {
                While (index < source.Length() && source.GetChar(index).ToInt() != 10) {
                    index = index + 1;
                }
            } Else If (code == 34) {
                index = index + 1;
                column = column + 1;
                While (index < source.Length() && source.GetChar(index).ToInt() != 34) {
                    If (source.GetChar(index).ToInt() == 92) {
                        index = index + 2;
                        column = column + 2;
                    } Else {
                        If (source.GetChar(index).ToInt() == 10) {
                            line = line + 1;
                            column = 1;
                        } Else {
                            column = column + 1;
                        }
                        index = index + 1;
                    }
                }
                If (index < source.Length()) {
                    index = index + 1;
                    column = column + 1;
                }
                previous = "";
            } Else If (This.IsNameCode(code)) {
                Int nameColumn = column;
                Int start = index;
                While (index < source.Length() && This.IsNamePartCode(source.GetChar(index).ToInt())) {
                    index = index + 1;
                    column = column + 1;
                }
                String token = source.Substring(start, index - start);
                If (previous != "." && !This.IsBinder(previous) && catalog.Contains(";" + token + "|") && !declared.Contains(";" + token + ";") && !reported.Contains(";" + token + ";")) {
                    String packageName = This.CatalogPackage(catalog, token);
                    If (packageName != "" && !imported.Contains(";" + packageName + ";")) {
                        diagnostics.TypeError("RX171", "'" + token + "' belongs to " + packageName + ".", line, nameColumn, "Import " + packageName, "no import", "Import " + packageName + " before using it.");
                        reported = reported + token + ";";
                    }
                }
                previous = token;
            } Else {
                If (code != 32 && code != 9 && code != 13) {
                    previous = String.From(code);
                }
                index = index + 1;
                column = column + 1;
            }
        }
    }

    Private Function IsBinder(String token) -> Bool {
        If (token == "Class" || token == "Struct" || token == "Enum" || token == "Interface" || token == "Function" || token == "Test" || token == "Package" || token == "Import") {
            Return True;
        }
        Return False;
    }

    Private Function IsNameStart(String piece) -> Bool {
        Return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_".Contains(piece);
    }

    Private Function IsNamePart(String piece) -> Bool {
        If (This.IsNameStart(piece)) { Return True; }
        Return "0123456789".Contains(piece);
    }

    Private Function IsNameCode(Int code) -> Bool {
        If (code >= 65 && code <= 90) { Return True; }
        If (code >= 97 && code <= 122) { Return True; }
        If (code == 95) { Return True; }
        Return False;
    }

    Private Function IsNamePartCode(Int code) -> Bool {
        If (This.IsNameCode(code)) { Return True; }
        If (code >= 48 && code <= 57) { Return True; }
        Return False;
    }

    Private Function TypeCatalog() -> String {
        String catalog = ";";
        Var files = Directory.Files("Packages");
        Int index = 0;
        While (index < files.Count()) {
            String relative = files[index];
            index = index + 1;
            If (relative.EndsWith(".rx") && !relative.EndsWith(".test.rx")) {
                String text = Files.ReadText("Packages/" + relative);
                String packageName = This.PackageName(text);
                catalog = This.CollectTypes(text, packageName, catalog);
            }
        }
        Return catalog;
    }

    Private Function PackageName(String text) -> String {
        Int index = 0;
        Int lineStart = 0;
        While (index <= text.Length()) {
            Int atEnd = 0;
            If (index == text.Length()) { atEnd = 1; }
            If (atEnd == 1 || text.GetChar(index).ToInt() == 10) {
                String line = text.Substring(lineStart, index - lineStart);
                String trimmed = This.TrimLeft(line);
                If (trimmed.StartsWith("Package ")) {
                    Return This.BeforeMark(trimmed.Substring(8), ";");
                }
                lineStart = index + 1;
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function CollectTypes(String text, String packageName, String catalog) -> String {
        String built = catalog;
        If (packageName == "") { Return built; }
        Int index = 0;
        Int lineStart = 0;
        While (index <= text.Length()) {
            Int atEnd = 0;
            If (index == text.Length()) { atEnd = 1; }
            If (atEnd == 1 || text.GetChar(index).ToInt() == 10) {
                String trimmed = This.TrimLeft(text.Substring(lineStart, index - lineStart));
                String name = This.TypeNameOn(trimmed);
                If (name != "" && !built.Contains(";" + name + "|")) {
                    built = built + name + "|" + packageName + ";";
                }
                lineStart = index + 1;
            }
            index = index + 1;
        }
        Return built;
    }

    Private Function TypeNameOn(String trimmed) -> String {
        String text = trimmed;
        If (text.StartsWith("Public ")) { text = This.TrimLeft(text.Substring(7)); }
        String kind = "";
        If (text.StartsWith("Class ")) { kind = "Class "; }
        If (text.StartsWith("Struct ")) { kind = "Struct "; }
        If (text.StartsWith("Enum ")) { kind = "Enum "; }
        If (text.StartsWith("Interface ")) { kind = "Interface "; }
        If (kind == "") { Return ""; }
        String name = This.BeforeMark(text.Substring(kind.Length()), " ");
        name = This.BeforeMark(name, "{");
        name = This.BeforeMark(name, ":");
        name = This.BeforeMark(name, "<");
        Return name;
    }

    Private Function DirectImports(String text) -> String {
        String imported = ";";
        Int index = 0;
        Int lineStart = 0;
        While (index <= text.Length()) {
            Int atEnd = 0;
            If (index == text.Length()) { atEnd = 1; }
            If (atEnd == 1 || text.GetChar(index).ToInt() == 10) {
                String trimmed = This.TrimLeft(text.Substring(lineStart, index - lineStart));
                If (trimmed.StartsWith("Import ")) {
                    String name = This.ImportName(trimmed.Substring(7));
                    If (name != "" && !imported.Contains(";" + name + ";")) {
                        imported = imported + name + ";";
                    }
                }
                lineStart = index + 1;
            }
            index = index + 1;
        }
        Return imported;
    }

    Private Function DeclaredNames(String text) -> String {
        String declared = ";";
        String previous = "";
        Int index = 0;
        While (index < text.Length()) {
            Int code = text.GetChar(index).ToInt();
            If (code == 34) {
                index = index + 1;
                While (index < text.Length() && text.GetChar(index).ToInt() != 34) {
                    If (text.GetChar(index).ToInt() == 92) { index = index + 2; }
                    Else { index = index + 1; }
                }
                If (index < text.Length()) { index = index + 1; }
                previous = "";
            } Else If (code == 47 && index + 1 < text.Length() && text.GetChar(index + 1).ToInt() == 47) {
                While (index < text.Length() && text.GetChar(index).ToInt() != 10) { index = index + 1; }
            } Else If (This.IsNameCode(code)) {
                Int start = index;
                While (index < text.Length() && This.IsNamePartCode(text.GetChar(index).ToInt())) {
                    index = index + 1;
                }
                String token = text.Substring(start, index - start);
                If (This.IsBinder(previous) && !declared.Contains(";" + token + ";")) {
                    declared = declared + token + ";";
                }
                previous = token;
            } Else {
                If (code != 32 && code != 9 && code != 13 && code != 10) { previous = String.From(code); }
                index = index + 1;
            }
        }
        Return declared;
    }

    Private Function ImportName(String text) -> String {
        String name = This.BeforeMark(text, ";");
        name = This.BeforeMark(name, " ");
        name = This.BeforeMark(name, ".*");
        Return name;
    }

    Private Function CatalogPackage(String catalog, String name) -> String {
        String key = ";" + name + "|";
        Int at = catalog.IndexOf(key);
        If (at < 0) { Return ""; }
        String rest = catalog.Substring(at + key.Length());
        Return This.BeforeMark(rest, ";");
    }

    Private Function BeforeMark(String text, String mark) -> String {
        Int at = text.IndexOf(mark);
        If (at < 0) { Return This.TrimEdge(text); }
        Return This.TrimEdge(text.Substring(0, at));
    }

    Private Function TrimLeft(String text) -> String {
        Int index = 0;
        While (index < text.Length()) {
            Int code = text.GetChar(index).ToInt();
            If (code != 32 && code != 9 && code != 13) { Return text.Substring(index); }
            index = index + 1;
        }
        Return "";
    }

    Private Function TrimEdge(String text) -> String {
        String trimmed = This.TrimLeft(text);
        Int end = trimmed.Length();
        While (end > 0) {
            Int code = trimmed.GetChar(end - 1).ToInt();
            If (code != 32 && code != 9 && code != 13) { Return trimmed.Substring(0, end); }
            end = end - 1;
        }
        Return "";
    }

    Private Function PackagePath(String packageName) -> String {
        String leaf = packageName;
        Int dot = packageName.LastIndexOf(".");
        If (dot >= 0) { leaf = packageName.Substring(dot + 1); }
        String path = "Packages/" + packageName + "/" + leaf + ".rx";
        If (Files.Exists(path)) { Return path; }
        Return "";
    }

    Private Function AttachDiagnostics(AstNode module, DiagnosticBag diagnostics) -> Void {
        For item In diagnostics.All() {
            AstNode entry = AstNode();
            entry.Kind = AstKind.ExplainEntry;
            entry.Text = FormatDiagnostic(item);
            entry.Name = item.Code;
            entry.Line = item.Line;
            entry.Column = item.Column;
            module.Attributes.Add(entry);
        }
    }
}
