// Tests for Robix.rx.

Test FinishRun { Output: True; }

Test Main {
    Constraint: True;
    Processing: True;
    Output: True;
}

Test IsProjectCommand {
    Case "build is project command" {
        Input: command = "build", args = ["build"];
        Constraint: command != "";
        Processing: True;
        Output: True;
    }
    Case "run with rx file is single file run" {
        Input: command = "run", args = ["run", "File.rx"];
        Constraint: command != "";
        Processing: False;
        Output: False;
    }
    Case "check with rx file is single file check" {
        Input: command = "check", args = ["check", "File.rx"];
        Output: False;
    }
    Case "cover is not project command" {
        Input: command = "cover", args = ["cover"];
        Output: False;
    }
}

Test ClassifyRobix {
    Case "repl" {
        Input: args = [];
        Output: "repl";
    }
    Case "help" {
        Input: args = ["--Help"];
        Output: "help";
    }
    Case "version detail" {
        Input: args = ["--Version"];
        Output: "version-detail";
    }
    Case "run file" {
        Input: args = ["Run", "Main.rx"];
        Output: "run-file";
    }
    Case "test file path" {
        Input: args = ["User.test.rx"];
        Output: "test-file";
    }
    Case "span" {
        Input: args = ["Main.rx:10:20"];
        Output: "run-span";
    }
    Case "named span" {
        Input: args = ["Main.rx:Start"];
        Output: "run-span";
    }
    Case "project build" {
        Input: args = ["Build"];
        Output: "project";
    }
    Case "install" {
        Input: args = ["install"];
        Output: "install";
    }
}

Test TopicOf {
    Case "full" {
        Input: args = ["Help"];
        Output: "full";
    }
    Case "test topic" {
        Input: args = ["Help", "Test"];
        Output: "Test";
    }
}

Test HelpText {
    Case "short page" {
        Input: topic = "short";
        Contains: Result, "-h";
    }
    Case "names the test command" {
        Input: topic = "full";
        Contains: Result, "Robix Test";
    }
    Case "install section" {
        Input: topic = "Install";
        Contains: Result, "Robix Install";
    }
}

Test VersionText {
    Case "short" {
        Input: kind = "short";
        Output: "Robix 0.0.48";
    }
    Case "detail" {
        Input: kind = "detail";
        Contains: Result, "Toolchain";
    }
}

Test PascalName {
    Case "hyphenated words" {
        Input: text = "hello-world";
        Output: "HelloWorld";
    }
    Case "already pascal" {
        Input: text = "HelloWorld";
        Output: "HelloWorld";
    }
    Case "leading digit" {
        Input: text = "3d";
        Output: "";
    }
}

Test SpanOf {
    Case "range" {
        Input: text = "Main.rx:10:20";
        Output: "Main.rx|10|20";
    }
    Case "one line" {
        Input: text = "Main.rx:10";
        Output: "Main.rx|10|10";
    }
    Case "one label" {
        Input: text = "Main.rx:Start";
        Output: "Main.rx|Start|Start";
    }
    Case "two labels" {
        Input: text = "Main.rx:Start:End";
        Output: "Main.rx|Start|End";
    }
    Case "whole file" {
        Input: text = "Main.rx";
        Output: "Main.rx||";
    }
}

Test SpanKind {
    Case "digits" {
        Input: token = "10";
        Output: "line";
    }
    Case "label" {
        Input: token = "Start";
        Output: "label";
    }
}

Test LabelName {
    Case "statement label" {
        Input: line = "    Start:";
        Output: "Start";
    }
    Case "code" {
        Input: line = "    Print(1);";
        Output: "";
    }
}

Test FunctionName {
    Case "declaration" {
        Input: line = "Public Function Main() -> Int {";
        Output: "Main";
    }
    Case "call" {
        Input: line = "    Print(1);";
        Output: "";
    }
}

Test SourceMapOf {
    Case "labels inside main" {
        Input: source = "Public Function Main() -> Int {\n    Start:\n    Print(1);\n    End:\n    Return 0;\n}\n";
        Contains: Result, "Main|1|6|function\n";
    }
    Case "start label" {
        Input: source = "Public Function Main() -> Int {\n    Start:\n    Print(1);\n    End:\n    Return 0;\n}\n";
        Contains: Result, "Start|2|6|label\n";
    }
}

Test MapEntry {
    Case "last label wins" {
        Input: map = "Main|1|6|function\nStart|2|6|label\n", name = "Start";
        Output: "2|6|label";
    }
    Case "missing" {
        Input: map = "Main|1|6|function\n", name = "Start";
        Output: "";
    }
}

Test LabelEnd {
    Case "stops before the next label" {
        Input: map = "Start|2|6|label\nEnd|4|6|label\n", line = 2, ceiling = 6, fileLines = 6;
        Output: 3;
    }
    Case "runs to the function end" {
        Input: map = "End|4|6|label\n", line = 4, ceiling = 6, fileLines = 6;
        Output: 6;
    }
}

Test SpanLines {
    Case "numbers" {
        Input: map = "", start = "10", end = "12", fileLines = 20;
        Output: "10|12";
    }
    Case "one label" {
        Input: map = "Start|2|6|label\nEnd|4|6|label\n", start = "Start", end = "Start", fileLines = 6;
        Output: "2|3";
    }
    Case "two labels" {
        Input: map = "Start|2|6|label\nEnd|4|6|label\n", start = "Start", end = "End", fileLines = 6;
        Output: "2|4";
    }
    Case "function" {
        Input: map = "Main|1|6|function\n", start = "Main", end = "Main", fileLines = 6;
        Output: "1|6";
    }
    Case "mixed" {
        Input: map = "Start|2|6|label\n", start = "Start", end = "4", fileLines = 6;
        Output: "error A span must use line numbers or labels, not both.";
    }
    Case "unknown label" {
        Input: map = "", start = "Start", end = "Start", fileLines = 6;
        Output: "error The source map has no label Start.";
    }
}

Test LineCount {
    Case "two lines" {
        Input: text = "a\nb";
        Output: 2;
    }
    Case "empty" {
        Input: text = "";
        Output: 0;
    }
}

Test StorePath {
    Case "version directory" {
        Input: name = "Alpha", version = "1.2.0";
        Output: "Packages/Installed/Alpha/1.2.0";
    }
}

Test PackageSpec {
    Case "exact version" {
        Input: text = "Alpha@1.2.0";
        Output: "Alpha|1.2.0";
    }
    Case "missing version" {
        Input: text = "Alpha";
        Output: "Alpha|1.0.0";
    }
}

Test DefaultConfig {
    Case "timing starts on" {
        Input:;
        Contains: Result, "Time=On";
    }
}

Test CanonicalKey {
    Case "exit code" {
        Input: key = "exitcode";
        Output: "ExitCode";
    }
    Case "unknown" {
        Input: key = "other";
        Output: "";
    }
}

Test CanonicalSwitch {
    Case "off" {
        Input: value = "off";
        Output: "Off";
    }
}

Test NextConfig {
    Case "turns color off" {
        Input: text = "", key = "Colors", value = "Off";
        Contains: Result, "Colors=Off";
    }
}

Test ConfigFlag {
    Case "reads time" {
        Input: text = "Time=Off\n", key = "Time";
        Output: "Off";
    }
}

Test FindFrom {
    Case "later match" {
        Input: text = "abba", start = 2, needle = "a";
        Output: 3;
    }
    Case "absent" {
        Input: text = "abba", start = 4, needle = "a";
        Output: -1;
    }
}

Test FindBefore {
    Case "earlier line" {
        Input: text = "ab\ncd", start = 3, needle = "\n";
        Output: 2;
    }
    Case "none before" {
        Input: text = "ab\ncd", start = 2, needle = "\n";
        Output: -1;
    }
}

Test StripColor {
    Case "drops tags" {
        Input: text = "{accent}Robix{/}";
        Output: "Robix";
    }
}

Test WithDependency {
    Case "inserts the package" {
        Input: project = "Project \"Demo\"\n{\n}\n", name = "Alpha", version = "1.2.0";
        Contains: Result, "Alpha";
    }
}

Test WithoutDependency {
    Case "drops the package" {
        Input: project = "Project \"Demo\"\n{\n    Package \"Alpha\" { Version: \"1.0.0\"; }\n}\n", name = "Alpha";
        False: Result.Contains("Alpha");
    }
}

Test RoleProject {
    Case "records the entry" {
        Input: name = "Demo", typeName = "WindowApplication", template = "Application.Window";
        Contains: Result, "Entry: \"Source/Main.rx\"";
    }
}

Test RoleSource {
    Case "names the role" {
        Input: name = "Demo", role = "window";
        Contains: Result, "Window";
    }
}

Test FormatSource {
    Case "indents the body" {
        Input: text = "{\nPrint(1);\n}\n";
        Contains: Result, "    Print(1);";
    }
}

Test LintText {
    Case "trailing space" {
        Input: text = "Print(1); \n";
        Contains: Result, "trailing space";
    }
}

Test ExplainCode {
    Case "missing test" {
        Input: diagnostic = "error RX120 missing";
        Contains: Result, "companion test";
    }
}

Test DiagnoseStep {
    Case "no message" {
        Input: message = "";
        Contains: Result, "Robix Check";
    }
}

Test ImportGraph {
    Case "one import" {
        Input: source = "Import Robix.Core;\n";
        Output: "Import Robix.Core;\n";
    }
}

Test ContentMark {
    Case "letter a" {
        Input: text = "a";
        Output: "98";
    }
}

Test DependencyText {
    Case "reads the package version" {
        Input: project = "Package \"Alpha\" { Version: \"1.2.0\"; }\n";
        Output: "Alpha 1.2.0\n";
    }
}

Test FormatFiles { Output: True; }
Test LintFiles { Output: True; }
Test ExplainLatest { Output: True; }
Test DiagnoseLatest { Output: True; }
Test GraphFiles { Output: True; }
Test ModuleFiles { Output: True; }
Test WatchFiles { Output: True; }

Test TemplateStatus {
    Case "console" {
        Input: kind = "Application", variant = "Console";
        Output: "console";
    }
    Case "bedrock" {
        Input: kind = "Bedrock", variant = "Kernel";
        Output: "kernel";
    }
    Case "empty canvas" {
        Input: kind = "Canvas", variant = "Empty";
        Output: "empty";
    }
}

Test ConsoleProject {
    Case "has an entry" {
        Input: name = "Demo";
        Contains: Result, "Entry: \"Source/Main.rx\"";
    }
}

Test EmptyProject {
    Case "has no entry" {
        Input: name = "Demo";
        False: Result.Contains("Entry:");
    }
}

Test SourceText {
    Case "greets the project" {
        Input: name = "Demo";
        Contains: Result, "Hello, Demo";
    }
}

Test TestText {
    Case "tests main" {
        Input: name = "Demo";
        Contains: Result, "Test Main";
    }
}

Test EntryOf {
    Case "quoted entry" {
        Input: project = "Entry: \"Source/Main.rx\";\n";
        Output: "Source/Main.rx";
    }
}

Test ProjectTitle {
    Case "quoted name" {
        Input: project = "Project \"Demo\"\n";
        Output: "Demo";
    }
}

Test BraceDepth {
    Case "matched" {
        Input: text = "{}";
        Output: 0;
    }
    Case "open" {
        Input: text = "{";
        Output: 1;
    }
    Case "quoted brace" {
        Input: text = "\"{\"";
        Output: 0;
    }
}

Test SessionProgram {
    Case "keeps the statement" {
        Input: body = "Print(\"hi\");\n", name = "Session";
        Contains: Result, "Print(\"hi\")";
    }
}

Test DoctorReport {
    Case "incomplete" {
        Input: hasInterpreter = True, hasCompiler = True, hasPackages = False;
        Contains: Result, "Installation: incomplete";
    }
}

Test EnvironmentReport {
    Case "packages present" {
        Input: hasPackages = True, hasLibrary = False, hasShared = False;
        Contains: Result, "Packages: present";
    }
}

Test CompletionScript {
    Case "lists install" {
        Input:;
        Contains: Result, "Install";
    }
}

Test LaterReason {
    Case "accepted" {
        Input: flag = "--Verbose";
        Output: "";
    }
    Case "report" {
        Input: flag = "--Report";
        Output: "";
    }
}

Test FirstProblem {
    Case "unknown option" {
        Input: args = ["--Nope"];
        Output: "Unknown option --Nope.";
    }
    Case "clean command" {
        Input: args = ["Run", "Main.rx"];
        Output: "";
    }
}

Test ProgramArgText {
    Case "after the file" {
        Input: args = ["Run", "Main.rx", "hello"];
        Output: "hello\n";
    }
    Case "after dash dash" {
        Input: args = ["Main.rx", "--", "a"];
        Output: "a\n";
    }
}

Test SourcePath {
    Case "run verb" {
        Input: args = ["Run", "Main.rx"];
        Output: "Main.rx";
    }
}

Test OptionText {
    Case "following value" {
        Input: args = ["--BreakAt", "20"], flag = "--BreakAt";
        Output: "20";
    }
    Case "equals value" {
        Input: args = ["--Target=LinuxX64"], flag = "--Target";
        Output: "LinuxX64";
    }
}

Test ApplyRobix { Output: True; }
Test WriteConfig { Output: True; }
Test AskProject { Output: True; }
Test WriteProject { Output: True; }
Test InspectCommand { Output: True; }
Test PackageCommand { Output: True; }
Test MaterializeDependencies { Output: True; }
Test PlacePackage { Output: True; }
Test StopResult {
    Case "failure" {
        Input: message = "Tests failed.";
        Output: True;
    }
    Case "success" {
        Input: message = "Tests passed.";
        Output: False;
    }
}

Test FindProjectFile { Output: True; }
Test RunSource { Output: True; }
Test RunSession { Output: True; }

Test SessionInventory {
    Case "finds a variable" {
        Input: source = "Var speed = 1;\n", command = ":variables", scope = "", versions = "";
        Contains: Result, "Var speed";
    }
    Case "uses the symbol table" {
        Input: source = "Var speed = 1;\n", command = ":variables", scope = "speed = 1\n", versions = "";
        Contains: Result, "speed = 1";
    }
    Case "shows an import version" {
        Input: source = "Import Robix.Core;\n", command = ":imports", scope = "", versions = "Robix.Core 1.0.0\n";
        Contains: Result, "Robix.Core  1.0.0";
    }
}

Test ClosestCommand {
    Case "format typo" {
        Input: word = "formt";
        Output: "Format";
    }
}

Test CommandScore { Output: True; }

Test StoredFlag {
    Case "absent key" {
        Input: text = "Time=Off\n", key = "Colors";
        Output: "";
    }
    Case "stored key" {
        Input: text = "Colors=Off\n", key = "Colors";
        Output: "Off";
    }
}

Test ActiveScope {
    Case "project wins" {
        Input: key = "Colors", projectText = "Colors=Off\n", userText = "Colors=On\n";
        Output: "project";
    }
    Case "default" {
        Input: key = "Colors", projectText = "", userText = "";
        Output: "default";
    }
}

Test ActiveValue {
    Case "user value" {
        Input: key = "Colors", projectText = "", userText = "Colors=Off\n";
        Output: "Off";
    }
}

Test ConfigReport {
    Case "names the scope" {
        Input: projectText = "Colors=Off\n", userText = "";
        Contains: Result, "Colors=Off  project";
    }
}

Test Ignored {
    Case "build directory" {
        Input: path = "Build/Main.rx", rules = "Build/\n";
        Output: True;
    }
    Case "source stays" {
        Input: path = "Main.rx", rules = "Build/\n";
        Output: False;
    }
}

Test ImportVersion {
    Case "pinned" {
        Input: line = "Import Robix.Core;", versions = "Robix.Core 1.0.0\n";
        Output: "Import Robix.Core  1.0.0";
    }
}

