// Assembled from the Robix.UI sources in this folder. Edit those files, then run Tools/stitch-rxu.py.
// RXU markup lexer and strict parser.
// RX is logic. RXU is UI structure. The .rxp file is the project.
// UI.Load will open a live document later. Import records a component file.
// Include records embedded markup. This parser does not load either file.
// Tags are XML-inspired, quoted or braced attributes, comments, and self-closing tags.
// There is no XML declaration and no namespace. Else binds to the nearest If.
// When, Default, and Otherwise bind to the nearest Choose or Switch.
// While is rejected. {Binding}, {Resource}, and {Localization} are not executed.
// A bare {Name} is a value expression. Quoted numbers and true/false keep their value mode.
// UI.Load reads a document. Import and Include still do not open their files.
// Loading does not show a document. Each load has its own tree and component names.
// Properties are typed. Animation wins over local, style, inherited, then the default.
// A resource is found on the component, then ancestors, the document, the application, then the built-in value.
// A project file lists RXU includes, assets, handlers, and backend capabilities.
// The build loads those files, resolves Import and Include, and refuses to package invalid markup.
// Bindings read observable values. A data context is inherited by descendants that do not set their own.
// OneWay, TwoWay, OneTime, OneWayToSource, Reactive, and Manual are the binding modes.
// Password values are stored for the control and masked in diagnostics.
// A universal backend records windows, input, drawing, and clipboard work.
// The host name selects it. Application files do not name a platform.
// The Linux application pumps a UI-thread queue. Background work posts to that queue.
// Window calls are recorded as GTK4 operations and applied on the universal backend.
// Layout measures, arranges, and renders in logical pixels. The host scale turns them into device pixels.
// Window decorations and fonts can differ by host. The geometry does not.
// MVP controls accept typed values, focus, keyboard input, clicks, bindings, styles, and runtime edits.
// Events route capture, target, bubble, document, then global. Every E1–E8 name is supported.
// Higher priority runs first. Cancel and Consume stop the route. A nested action returns Busy.
// The live tree can be queried and edited while its window stays open. A transaction coalesces layout and render.
// Declarative If, Each, Choose, Let, Set, Bind, and Include reconcile when state changes. While stays rejected.
// A component library imports definitions without opening a window. Instances keep isolated state. Templates change appearance only.
// The control catalog covers every C1–C6 member. A support matrix names the source, the test, and the inventory.
// A frame adopts the layout display list, damages changed slots, and hit-tests in device pixels. Pixels are rasterized outside Robix.
// Navigation keeps pages, breadcrumbs, chrome, modal dialogs, and window snapshots.
Package Robix.UI
Explain {
    Description: "Assembled from the Robix.UI sources in this folder. Edit those files, then run Tools/stitch-rxu.py.";
};

Import Robix.Core;


Public Class RxuDiagnostic {
    Public String Code;
    Public String Message;
    Public String Filename;
    Public Int Line;
    Public Int Column;
    Public Int Length;
    Public String Expected;
    Public String Actual;
    Public String Correction;

    Public Constructor() {
        This.Code = "";
        This.Message = "";
        This.Filename = "";
        This.Line = 1;
        This.Column = 1;
        This.Length = 0;
        This.Expected = "";
        This.Actual = "";
        This.Correction = "";
    }
}

Public Class RxuMessages {
    Private List<RxuDiagnostic> items;

    Public Constructor() {
        This.items = List<RxuDiagnostic>();
    }

    Public Function Add(
        String code,
        String message,
        String filename,
        Int line,
        Int column,
        Int length,
        String expected,
        String actual,
        String correction
    ) -> Void
    Explain {
        Description: "Record one RXU diagnostic with its source location and repair.";
        Input: code = "Stable RXU code", message = "What is wrong", filename = "Markup file name", line = "1-based line", column = "1-based column", length = "Span length", expected = "Expected markup", actual = "Markup that was found", correction = "How to repair it";
        Processing: "Copy the text and append the diagnostic.";
        Output: "No return value.";
    } {
        RxuDiagnostic item = RxuDiagnostic();
        item.Code = code + "";
        item.Message = message + "";
        item.Filename = filename + "";
        item.Line = line;
        item.Column = column;
        item.Length = length;
        item.Expected = expected + "";
        item.Actual = actual + "";
        item.Correction = correction + "";
        This.items.Add(item);
    }

    Public Function Count() -> Int
    Explain {
        Description: "Return how many RXU diagnostics are stored.";
        Input: None;
        Processing: "Read the diagnostic list size.";
        Output: "The number of stored diagnostics.";
    } {
        Return This.items.Count();
    }

    Public Function At(Int index) -> RxuDiagnostic
    Explain {
        Description: "Return one stored RXU diagnostic.";
        Input: index = "Zero-based diagnostic index";
        Processing: "Read that diagnostic, or a blank one when the index is outside the list.";
        Output: "The diagnostic at that index.";
    } {
        If (index < 0 || index >= This.items.Count()) {
            Return RxuDiagnostic();
        }
        Return This.items[index];
    }

    Public Function Find(String code) -> Int
    Explain {
        Description: "Find the first diagnostic with a code.";
        Input: code = "Stable RXU code";
        Processing: "Scan the stored diagnostics.";
        Output: "The index, or -1 when the code is absent.";
    } {
        Int index = 0;
        While (index < This.items.Count()) {
            If (This.items[index].Code == code) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Public Function FormatAt(Int index) -> String
    Explain {
        Description: "Format one diagnostic with file, position, span, and repair.";
        Input: index = "Zero-based diagnostic index";
        Processing: "Join the location, code, message, expected value, actual value, and correction.";
        Output: "The diagnostic line, or an empty string when the index is absent.";
    } {
        If (index < 0 || index >= This.items.Count()) {
            Return "";
        }
        RxuDiagnostic item = This.At(index);
        String location = item.Line.ToString() + ":" + item.Column.ToString();
        If (item.Filename != "") {
            location = item.Filename + ":" + location;
        }
        String text = location + ": length " + item.Length.ToString() + ": error " + item.Code + " " + item.Message;
        If (item.Expected != "" || item.Actual != "") {
            text = text + " expected " + item.Expected + ", actual " + item.Actual;
        }
        If (item.Correction != "") {
            text = text + " correction: " + item.Correction;
        }
        Return text;
    }
}

Public Class RxuToken {
    Public String Kind;
    Public String Text;
    Public String Mode;
    Public Int Line;
    Public Int Column;
    Public Int Length;
    Public Int Index;

    Public Constructor() {
        This.Kind = "";
        This.Text = "";
        This.Mode = "";
        This.Line = 1;
        This.Column = 1;
        This.Length = 0;
        This.Index = 0;
    }
}

Public Class RxuNode {
    Public String Kind;
    Public String Name;
    Public String Text;
    Public String Mode;
    Public Int Line;
    Public Int Column;
    Public Int Length;
    Public List<RxuNode> Attributes;
    Public List<RxuNode> Children;
    Public RxuMessages Messages;

    Public Constructor() {
        This.Kind = "";
        This.Name = "";
        This.Text = "";
        This.Mode = "";
        This.Line = 1;
        This.Column = 1;
        This.Length = 0;
        This.Attributes = List<RxuNode>();
        This.Children = List<RxuNode>();
        This.Messages = RxuMessages();
    }

    Public Function FindAttribute(String name) -> RxuNode
    Explain {
        Description: "Find a direct attribute by name.";
        Input: name = "Attribute name";
        Processing: "Scan the attributes of this node.";
        Output: "The attribute, or a blank node when it is missing.";
    } {
        For attribute In This.Attributes {
            If (attribute.Name == name) {
                Return attribute;
            }
        }
        Return RxuNode();
    }

    Public Function FindChild(String name) -> RxuNode
    Explain {
        Description: "Find a direct element child by name.";
        Input: name = "Element name";
        Processing: "Scan the direct children.";
        Output: "The element, or a blank node when it is missing.";
    } {
        For child In This.Children {
            If (child.Kind == "Element" && child.Name == name) {
                Return child;
            }
        }
        Return RxuNode();
    }

    Public Function FindKind(String kind) -> RxuNode
    Explain {
        Description: "Find a direct child by node kind.";
        Input: kind = "Document, Element, Text, Comment, Expression, or Attribute";
        Processing: "Scan the direct children.";
        Output: "The child, or a blank node when it is missing.";
    } {
        For child In This.Children {
            If (child.Kind == kind) {
                Return child;
            }
        }
        Return RxuNode();
    }

    Public Function Describe() -> String
    Explain {
        Description: "Describe this node and its children.";
        Input: None;
        Processing: "Write the kind, name, mode, text, and attributes, then each child.";
        Output: "A multiline description.";
    } {
        Return This.DescribeAt(0);
    }

    Private Function DescribeAt(Int depth) -> String {
        String line = "";
        Int pad = 0;
        While (pad < depth) {
            line = line + "  ";
            pad = pad + 1;
        }
        line = line + This.Kind;
        If (This.Name != "") {
            line = line + " " + This.Name;
        }
        If (This.Mode != "") {
            line = line + " " + This.Mode;
        }
        If (This.Text != "") {
            line = line + " " + This.Text;
        }
        For attribute In This.Attributes {
            line = line + " " + attribute.Name + "=" + attribute.Mode + ":" + attribute.Text;
        }
        For child In This.Children {
            line = line + "\n" + child.DescribeAt(depth + 1);
        }
        Return line;
    }
}

Public Class RxuLexer {
    Private String filename;
    Private String source;
    Private Int index;
    Private Int line;
    Private Int column;
    Private Bool inTag;
    Private String classified;
    Private List<RxuToken> tokens;
    Private RxuMessages messages;

    Public Constructor() {
        This.filename = "";
        This.source = "";
        This.index = 0;
        This.line = 1;
        This.column = 1;
        This.inTag = False;
        This.classified = "";
        This.tokens = List<RxuToken>();
        This.messages = RxuMessages();
    }

    Public Function Tokenize(String filename, String source) -> Void
    Explain {
        Description: "Turn RXU markup into tokens.";
        Input: filename = "Markup file name", source = "RXU source text";
        Processing: "Read tags, attributes, strings, comments, text, and expressions.";
        Output: "No return value. The tokens stay on this lexer.";
    } {
        This.Reset(filename, source);
        This.Scan();
        This.Take("End", "", "", This.line, This.column, This.index);
    }

    Public Function TokenCount() -> Int
    Explain {
        Description: "Return how many tokens were read.";
        Input: None;
        Processing: "Read the token list size.";
        Output: "The number of tokens, including End.";
    } {
        Return This.tokens.Count();
    }

    Public Function TokenAt(Int index) -> RxuToken
    Explain {
        Description: "Return one token by index.";
        Input: index = "Zero-based token index";
        Processing: "Read that token, or a blank token when the index is outside the list.";
        Output: "The token at that index.";
    } {
        If (index < 0 || index >= This.tokens.Count()) {
            Return RxuToken();
        }
        Return This.tokens[index];
    }

    Public Function LexerDiagnostics() -> RxuMessages
    Explain {
        Description: "Return the diagnostics recorded while tokenizing.";
        Input: None;
        Processing: "Hand back the message bag filled by Tokenize.";
        Output: "The lexer diagnostics.";
    } {
        Return This.messages;
    }

    Private Function Reset(String filename, String source) -> Void {
        This.filename = filename + "";
        This.source = source + "";
        This.index = 0;
        This.line = 1;
        This.column = 1;
        This.inTag = False;
        This.classified = "";
        This.tokens = List<RxuToken>();
        This.messages = RxuMessages();
    }

    Private Function Scan() -> Void {
        Int guard = 0;
        Int limit = This.source.Length() + 8;
        While (This.index < This.source.Length() && guard < limit) {
            Int before = This.index;
            If (This.inTag) {
                This.SkipSpace();
                If (This.index >= This.source.Length()) {
                    Break;
                }
                If (This.StartsWith("<!--")) {
                    This.ReadComment();
                } Else If (This.PeekChar(0) == ">") {
                    Int start = This.index;
                    Int startLine = This.line;
                    Int startColumn = This.column;
                    This.Advance();
                    This.Take("Close", ">", "", startLine, startColumn, start);
                    This.inTag = False;
                } Else If (This.PeekChar(0) == "/") {
                    Int start = This.index;
                    Int startLine = This.line;
                    Int startColumn = This.column;
                    This.Advance();
                    This.Take("Slash", "/", "", startLine, startColumn, start);
                } Else If (This.PeekChar(0) == "=") {
                    Int start = This.index;
                    Int startLine = This.line;
                    Int startColumn = This.column;
                    This.Advance();
                    This.Take("Equals", "=", "", startLine, startColumn, start);
                } Else If (This.PeekChar(0) == "\"" || This.PeekChar(0) == "'") {
                    This.ReadString();
                } Else If (This.PeekChar(0) == "{") {
                    This.ReadExpression();
                } Else If (This.IsDigit(This.PeekChar(0))) {
                    This.ReadNumber();
                } Else If (This.IsNameStart(This.PeekChar(0))) {
                    This.ReadName();
                    If (This.PeekChar(0) == ":") {
                        This.LexerFail("RXU015", "XML namespaces are not allowed.", This.line, This.column, "a name without a namespace", ":", "Remove the namespace prefix.");
                        This.Advance();
                        While (This.IsNamePart(This.PeekChar(0))) {
                            This.Advance();
                        }
                    }
                } Else {
                    This.LexerFail("RXU003", "This character is not valid inside a tag.", This.line, This.column, "a name, value, '/' or '>'", This.PeekChar(0), "Rewrite the tag.");
                    This.Advance();
                }
            } Else If (This.StartsWith("<!--")) {
                This.ReadComment();
            } Else If (This.StartsWith("<?")) {
                This.SkipDeclaration();
            } Else If (This.StartsWith("<!")) {
                This.LexerFail("RXU003", "This markup is not a comment or a tag.", This.line, This.column, "<!-- or a tag", "<!", "Use a tag or a comment.");
                While (This.index < This.source.Length() && This.PeekChar(0) != ">") {
                    This.Advance();
                }
                If (This.PeekChar(0) == ">") {
                    This.Advance();
                }
            } Else If (This.PeekChar(0) == "<") {
                Int start = This.index;
                Int startLine = This.line;
                Int startColumn = This.column;
                This.Advance();
                This.Take("Open", "<", "", startLine, startColumn, start);
                This.inTag = True;
            } Else If (This.PeekChar(0) == "{") {
                This.ReadExpression();
            } Else {
                This.ReadText();
            }
            If (This.index == before) {
                This.LexerFail("RXU003", "The markup could not be read here.", This.line, This.column, "more markup", This.PeekChar(0), "Remove the invalid character.");
                This.Advance();
            }
            guard = guard + 1;
        }
    }

    Private Function Take(String kind, String text, String mode, Int line, Int column, Int start) -> Void {
        RxuToken token = RxuToken();
        token.Kind = kind + "";
        token.Text = text + "";
        token.Mode = mode + "";
        token.Line = line;
        token.Column = column;
        token.Index = start;
        token.Length = This.index - start;
        If (token.Length < 0) {
            token.Length = 0;
        }
        This.tokens.Add(token);
    }

    Private Function LexerFail(
        String code,
        String message,
        Int line,
        Int column,
        String expected,
        String actual,
        String correction
    ) -> Void {
        This.messages.Add(code, message, This.filename, line, column, 1, expected, actual, correction);
    }

    Private Function Advance() -> Void {
        If (This.index >= This.source.Length()) {
            Return;
        }
        String character = This.PeekChar(0);
        This.index = This.index + 1;
        If (character == "\n") {
            This.line = This.line + 1;
            This.column = 1;
        } Else {
            This.column = This.column + 1;
        }
    }

    Private Function PeekChar(Int offset) -> String {
        Int position = This.index + offset;
        If (position < 0 || position >= This.source.Length()) {
            Return "";
        }
        Return This.source.Substring(position, 1);
    }

    Private Function StartsWith(String text) -> Bool {
        If (This.index + text.Length() > This.source.Length()) {
            Return False;
        }
        Return This.source.Substring(This.index, text.Length()) == text;
    }

    Private Function SkipSpace() -> Void {
        While (This.index < This.source.Length()) {
            String character = This.PeekChar(0);
            If (character == " " || character == "\t" || character == "\r" || character == "\n") {
                This.Advance();
            } Else {
                Break;
            }
        }
    }

    Private Function ReadName() -> Void {
        Int start = This.index;
        Int startLine = This.line;
        Int startColumn = This.column;
        This.Advance();
        While (This.IsNamePart(This.PeekChar(0))) {
            This.Advance();
        }
        String text = This.source.Substring(start, This.index - start);
        String kind = "Name";
        If (text == "true" || text == "false" || text == "True" || text == "False") {
            kind = "Boolean";
        }
        This.Take(kind, text, "", startLine, startColumn, start);
    }

    Private Function ReadNumber() -> Void {
        Int start = This.index;
        Int startLine = This.line;
        Int startColumn = This.column;
        While (This.IsDigit(This.PeekChar(0))) {
            This.Advance();
        }
        If (This.PeekChar(0) == "." && This.IsDigit(This.PeekChar(1))) {
            This.Advance();
            While (This.IsDigit(This.PeekChar(0))) {
                This.Advance();
            }
        }
        String text = This.source.Substring(start, This.index - start);
        This.Take("Number", text, "", startLine, startColumn, start);
    }

    Private Function ReadString() -> Void {
        Int start = This.index;
        Int startLine = This.line;
        Int startColumn = This.column;
        String quote = This.PeekChar(0);
        This.Advance();
        String value = "";
        Int chunk = This.index;
        Bool closed = False;
        While (This.index < This.source.Length()) {
            String character = This.PeekChar(0);
            If (character == "\\") {
                If (This.index > chunk) {
                    value = value + This.source.Substring(chunk, This.index - chunk);
                }
                This.Advance();
                String escaped = This.PeekChar(0);
                If (escaped == "n") {
                    value = value + "\n";
                } Else If (escaped == "r") {
                    value = value + "\r";
                } Else If (escaped == "t") {
                    value = value + "\t";
                } Else If (escaped == "") {
                    value = value + "\\";
                } Else {
                    value = value + escaped;
                }
                If (escaped != "") {
                    This.Advance();
                }
                chunk = This.index;
            } Else If (character == quote) {
                If (This.index > chunk) {
                    value = value + This.source.Substring(chunk, This.index - chunk);
                }
                This.Advance();
                closed = True;
                Break;
            } Else {
                This.Advance();
            }
        }
        If (!closed) {
            If (This.index > chunk) {
                value = value + This.source.Substring(chunk, This.index - chunk);
            }
            This.LexerFail("RXU004", "This string is not closed.", startLine, startColumn, quote, "end of document", "Close the string with the same quote.");
        }
        This.Take("String", value, "String", startLine, startColumn, start);
    }

    Private Function ReadText() -> Void {
        Int start = This.index;
        Int startLine = This.line;
        Int startColumn = This.column;
        While (This.index < This.source.Length()) {
            String character = This.PeekChar(0);
            If (character == "<" || character == "{") {
                Break;
            }
            This.Advance();
        }
        If (This.index == start) {
            Return;
        }
        String text = This.source.Substring(start, This.index - start);
        This.Take("Text", text, "", startLine, startColumn, start);
    }

    Private Function ReadExpression() -> Void {
        Int start = This.index;
        Int startLine = This.line;
        Int startColumn = This.column;
        This.Advance();
        Int depth = 1;
        Bool closed = False;
        While (This.index < This.source.Length()) {
            String character = This.PeekChar(0);
            If (character == "\"" || character == "'") {
                String quote = character;
                This.Advance();
                While (This.index < This.source.Length() && This.PeekChar(0) != quote) {
                    If (This.PeekChar(0) == "\\") {
                        This.Advance();
                    }
                    If (This.index < This.source.Length()) {
                        This.Advance();
                    }
                }
                If (This.PeekChar(0) == quote) {
                    This.Advance();
                }
            } Else If (character == "{") {
                depth = depth + 1;
                This.Advance();
            } Else If (character == "}") {
                depth = depth - 1;
                This.Advance();
                If (depth == 0) {
                    closed = True;
                    Break;
                }
            } Else {
                This.Advance();
            }
        }
        Int bodyStart = start + 1;
        Int bodyLength = This.index - bodyStart;
        If (closed) {
            bodyLength = bodyLength - 1;
        }
        If (bodyLength < 0) {
            bodyLength = 0;
        }
        String body = This.source.Substring(bodyStart, bodyLength);
        If (!closed) {
            This.LexerFail("RXU005", "This expression is not closed.", startLine, startColumn, "}", "end of document", "Close the expression with '}'.");
        }
        String mode = This.Classify(body, startLine, startColumn);
        This.Take("Expression", This.classified, mode, startLine, startColumn, start);
    }

    Private Function ReadComment() -> Void {
        Int start = This.index;
        Int startLine = This.line;
        Int startColumn = This.column;
        This.Advance();
        This.Advance();
        This.Advance();
        This.Advance();
        Int body = This.index;
        Bool closed = False;
        While (This.index < This.source.Length()) {
            If (This.StartsWith("-->")) {
                String text = This.source.Substring(body, This.index - body);
                This.Advance();
                This.Advance();
                This.Advance();
                This.Take("Comment", text, "", startLine, startColumn, start);
                closed = True;
                Break;
            }
            This.Advance();
        }
        If (!closed) {
            String text = "";
            If (This.index > body) {
                text = This.source.Substring(body, This.index - body);
            }
            This.LexerFail("RXU006", "This comment is not closed.", startLine, startColumn, "-->", "end of document", "End the comment with -->.");
            This.Take("Comment", text, "", startLine, startColumn, start);
        }
    }

    Private Function SkipDeclaration() -> Void {
        This.LexerFail("RXU009", "An XML declaration is not allowed.", This.line, This.column, "an element", "<?", "Remove the XML declaration.");
        While (This.index < This.source.Length()) {
            If (This.StartsWith("?>")) {
                This.Advance();
                This.Advance();
                Break;
            }
            If (This.PeekChar(0) == ">") {
                This.Advance();
                Break;
            }
            This.Advance();
        }
    }

    Private Function Classify(String body, Int line, Int column) -> String {
        String text = body.Trim();
        If (text.Length() == 0) {
            This.LexerFail("RXU007", "An expression cannot be empty.", line, column, "a value, binding, resource, or localization", "empty", "Write the expression inside the braces.");
            This.classified = "";
            Return "Expression";
        }
        If (This.HasKeyword(text, "Binding")) {
            This.classified = This.AfterKeyword(text, "Binding");
            Return "Binding";
        }
        If (This.HasKeyword(text, "Resource")) {
            This.classified = This.AfterKeyword(text, "Resource");
            Return "Resource";
        }
        If (This.HasKeyword(text, "Localization")) {
            This.classified = This.AfterKeyword(text, "Localization");
            Return "Localization";
        }
        This.classified = text + "";
        Return "Expression";
    }

    Private Function HasKeyword(String text, String keyword) -> Bool {
        If (text == keyword) {
            Return True;
        }
        If (text.StartsWith(keyword) && text.Length() > keyword.Length()) {
            String next = text.Substring(keyword.Length(), 1);
            If (next == " " || next == "\t") {
                Return True;
            }
        }
        Return False;
    }

    Private Function AfterKeyword(String text, String keyword) -> String {
        If (text == keyword) {
            Return "";
        }
        Return text.Substring(keyword.Length() + 1).Trim() + "";
    }

    Private Function IsDigit(String character) -> Bool {
        If (character.Length() != 1) {
            Return False;
        }
        Return character >= "0" && character <= "9";
    }

    Private Function IsNameStart(String character) -> Bool {
        If (character.Length() != 1) {
            Return False;
        }
        If (character >= "A" && character <= "Z") {
            Return True;
        }
        If (character >= "a" && character <= "z") {
            Return True;
        }
        Return character == "_";
    }

    Private Function IsNamePart(String character) -> Bool {
        If (This.IsNameStart(character) || This.IsDigit(character)) {
            Return True;
        }
        Return character == "-";
    }
}

Public Class RxuParser {
    Private String filename;
    Private List<RxuToken> tokens;
    Private RxuMessages messages;
    Private Int index;

    Public Constructor() {
        This.filename = "";
        This.tokens = List<RxuToken>();
        This.messages = RxuMessages();
        This.index = 0;
    }

    Public Function Parse(String filename, String source) -> RxuNode
    Explain {
        Description: "Parse RXU markup into a position-aware tree.";
        Input: filename = "Markup file name", source = "RXU source text";
        Processing: "Tokenize the markup, parse elements, and bind Else and choice branches.";
        Output: "The document tree. Diagnostics are stored on the document.";
    } {
        RxuLexer lexer = RxuLexer();
        This.filename = filename + "";
        lexer.Tokenize(filename, source);
        This.messages = lexer.LexerDiagnostics();
        This.tokens = List<RxuToken>();
        Int count = lexer.TokenCount();
        Int cursor = 0;
        While (cursor < count) {
            This.tokens.Add(lexer.TokenAt(cursor));
            cursor = cursor + 1;
        }
        This.index = 0;
        RxuNode document = This.ParseDocument();
        document.Messages = This.messages;
        Return document;
    }

    Private Function ParseDocument() -> RxuNode {
        RxuNode document = This.MakeNode("Document", This.filename, "", "", 1, 1, 0);
        This.ParseSequence(document);
        If (!This.AtKind("End")) {
            RxuToken extra = This.PeekToken();
            This.ParserFail("RXU003", "Markup remains after the document.", extra.Line, extra.Column, extra.Length, "end of document", extra.Kind, "Remove the extra markup.");
        }
        document.Messages = This.messages;
        Return document;
    }

    Private Function ParseSequence(RxuNode parent) -> Void {
        RxuNode held = RxuNode();
        held.Name = parent.Name + "";
        Int guard = 0;
        While (!This.AtKind("End") && guard < This.tokens.Count() + 2) {
            If (This.AtKind("Open") && This.KindAt(1) == "Slash") {
                Break;
            }
            Int before = This.index;
            If (This.AtKind("Open")) {
                held.Children.Add(This.ParseElement());
            } Else If (This.AtKind("Text")) {
                held.Children.Add(This.NodeFromToken("Text"));
            } Else If (This.AtKind("Comment")) {
                held.Children.Add(This.NodeFromToken("Comment"));
            } Else If (This.AtKind("Expression")) {
                held.Children.Add(This.NodeFromToken("Expression"));
            } Else {
                RxuToken bad = This.PeekToken();
                This.ParserFail("RXU003", "This token cannot appear here.", bad.Line, bad.Column, bad.Length, "an element, text, comment, or expression", bad.Kind, "Rewrite this part of the markup.");
                This.AdvanceToken();
            }
            If (This.index == before) {
                This.AdvanceToken();
            }
            guard = guard + 1;
        }
        This.BindFlow(held);
        parent.Children = List<RxuNode>();
        Int cursor = 0;
        While (cursor < held.Children.Count()) {
            parent.Children.Add(held.Children[cursor]);
            cursor = cursor + 1;
        }
    }

    Private Function ParseElement() -> RxuNode {
        RxuToken open = This.ExpectKind("Open", "RXU003", "A tag must start with '<'.", "<", "Start the tag with '<'.");
        RxuToken name = This.ExpectKind("Name", "RXU003", "A tag needs a name.", "a name", "Write the element name after '<'.");
        If (name.Text == "While") {
            This.ParserFail("RXU008", "While is not allowed in RXU.", name.Line, name.Column, name.Length, "If, Each, or For", "While", "Use If, Each, For, or ForEach.");
        }
        RxuNode node = This.MakeNode("Element", name.Text, "", "Pair", open.Line, open.Column, open.Length);
        This.ParseAttributes(node);
        If (This.AtKind("Slash")) {
            This.AdvanceToken();
            RxuToken close = This.ExpectKind("Close", "RXU003", "A self-closing tag must end with '/>'.", ">", "End the tag with '/>'.");
            node.Mode = "Empty";
            node.Length = close.Index + close.Length - open.Index;
            If (node.Length < 0) {
                node.Length = 1;
            }
            Return node;
        }
        RxuToken close = This.ExpectKind("Close", "RXU003", "A tag must end with '>'.", ">", "End the tag with '>'.");
        This.ParseSequence(node);
        If (This.AtKind("End")) {
            This.ParserFail("RXU002", "This tag is not closed.", open.Line, open.Column, open.Length, "</" + name.Text + ">", "end of document", "Add the matching end tag.");
            node.Length = close.Index + close.Length - open.Index;
            If (node.Length < 0) {
                node.Length = 1;
            }
            Return node;
        }
        This.ExpectKind("Open", "RXU003", "An end tag must start with '</'.", "</", "Close the element with an end tag.");
        This.ExpectKind("Slash", "RXU003", "An end tag must start with '</'.", "/", "Write '/' after '<'.");
        RxuToken endName = This.ExpectKind("Name", "RXU003", "An end tag needs the element name.", name.Text, "Write the matching element name.");
        If (endName.Text != name.Text) {
            This.ParserFail("RXU001", "The end tag does not match the open tag.", endName.Line, endName.Column, endName.Length, name.Text, endName.Text, "Close <" + name.Text + "> with </" + name.Text + ">.");
        }
        RxuToken endClose = This.ExpectKind("Close", "RXU003", "An end tag must end with '>'.", ">", "End the tag with '>'.");
        node.Length = endClose.Index + endClose.Length - open.Index;
        If (node.Length < 0) {
            node.Length = 1;
        }
        Return node;
    }

    Private Function ParseAttributes(RxuNode node) -> Void {
        While (This.AtKind("Name")) {
            Int before = This.index;
            RxuToken attributeName = This.PeekToken();
            This.AdvanceToken();
            String mode = "Boolean";
            String text = "true";
            Int length = attributeName.Length;
            Int valueIndex = attributeName.Index;
            Int valueLength = attributeName.Length;
            If (This.AtKind("Equals")) {
                This.AdvanceToken();
                RxuToken value = This.PeekToken();
                If (value.Kind == "String" || value.Kind == "Number" || value.Kind == "Boolean" || value.Kind == "Expression") {
                    mode = "String";
                    If (value.Kind == "String") {
                        mode = This.QuotedMode(value.Text);
                    } Else If (value.Kind == "Number") {
                        mode = "Number";
                        If (value.Text.Contains(".")) {
                            mode = "Float";
                        }
                    } Else If (value.Kind == "Boolean") {
                        mode = "Boolean";
                    } Else If (value.Kind == "Expression") {
                        mode = value.Mode;
                    }
                    text = value.Text;
                    valueIndex = value.Index;
                    valueLength = value.Length;
                    This.AdvanceToken();
                } Else {
                    This.ParserFail("RXU003", "An attribute needs a quoted value or an expression.", value.Line, value.Column, value.Length, "a value", value.Kind, "Quote the value or write a braced expression.");
                }
            }
            length = valueIndex + valueLength - attributeName.Index;
            If (length < 0) {
                length = attributeName.Length;
            }
            RxuNode attribute = This.MakeNode("Attribute", attributeName.Text, text, mode, attributeName.Line, attributeName.Column, length);
            node.Attributes.Add(attribute);
            If (This.index == before) {
                This.AdvanceToken();
            }
        }
    }

    Private Function BindFlow(RxuNode parent) -> Void {
        RxuNode held = RxuNode();
        held.Name = parent.Name + "";
        Int count = parent.Children.Count();
        Int cursor = 0;
        While (cursor < count) {
            RxuNode node = parent.Children[cursor];
            If (node.Kind == "Element" && (node.Name == "Else" || node.Name == "ElseIf")) {
                If (parent.Name == "If" || parent.Name == "ElseIf") {
                    This.RejectDuplicateElse(held, node);
                    held.Children.Add(node);
                } Else {
                    Int owner = This.LastNamed(held, "If");
                    If (owner < 0) {
                        This.ParserFail("RXU010", "Else and ElseIf must follow an If.", node.Line, node.Column, node.Length, "If", node.Name, "Put this branch after an If.");
                        held.Children.Add(node);
                    } Else {
                        This.RejectDuplicateElse(held.Children[owner], node);
                        held.Children[owner].Children.Add(node);
                    }
                }
            } Else If (node.Kind == "Element" && (node.Name == "When" || node.Name == "Default" || node.Name == "Otherwise")) {
                If (parent.Name == "Choose" || parent.Name == "Switch") {
                    This.RejectDuplicateDefault(held, node);
                    held.Children.Add(node);
                } Else {
                    Int owner = This.LastNamed(held, "Choose");
                    If (owner < 0) {
                        owner = This.LastNamed(held, "Switch");
                    }
                    If (owner < 0) {
                        This.ParserFail("RXU011", "This branch needs a Choose or Switch.", node.Line, node.Column, node.Length, "Choose or Switch", node.Name, "Place it after Choose or Switch.");
                        held.Children.Add(node);
                    } Else {
                        This.RejectDuplicateDefault(held.Children[owner], node);
                        held.Children[owner].Children.Add(node);
                    }
                }
            } Else {
                held.Children.Add(node);
            }
            cursor = cursor + 1;
        }
        parent.Children = List<RxuNode>();
        cursor = 0;
        While (cursor < held.Children.Count()) {
            parent.Children.Add(held.Children[cursor]);
            cursor = cursor + 1;
        }
    }

    Private Function RejectDuplicateElse(RxuNode parent, RxuNode node) -> Void {
        If (node.Name == "Else" && This.NodeHas(parent, "Else")) {
            This.ParserFail("RXU012", "An If already has an Else.", node.Line, node.Column, node.Length, "one Else", "another Else", "Keep a single Else on this If.");
        }
        If (node.Name == "ElseIf" && This.NodeHas(parent, "Else")) {
            This.ParserFail("RXU012", "ElseIf cannot follow Else.", node.Line, node.Column, node.Length, "ElseIf before Else", "ElseIf after Else", "Move ElseIf before Else.");
        }
    }

    Private Function RejectDuplicateDefault(RxuNode parent, RxuNode node) -> Void {
        If ((node.Name == "Default" || node.Name == "Otherwise") && (This.NodeHas(parent, "Default") || This.NodeHas(parent, "Otherwise"))) {
            This.ParserFail("RXU013", "A choice already has a default branch.", node.Line, node.Column, node.Length, "one Default or Otherwise", node.Name, "Keep a single default branch.");
        }
    }

    Private Function LastNamed(RxuNode parent, String name) -> Int {
        Int cursor = parent.Children.Count() - 1;
        While (cursor >= 0) {
            RxuNode item = parent.Children[cursor];
            If (item.Kind == "Element" && item.Name == name) {
                Return cursor;
            }
            cursor = cursor - 1;
        }
        Return -1;
    }

    Private Function NodeHas(RxuNode parent, String name) -> Bool {
        Int cursor = 0;
        While (cursor < parent.Children.Count()) {
            RxuNode node = parent.Children[cursor];
            If (node.Kind == "Element" && node.Name == name) {
                Return True;
            }
            cursor = cursor + 1;
        }
        Return False;
    }

    Private Function ParserFail(
        String code,
        String message,
        Int line,
        Int column,
        Int length,
        String expected,
        String actual,
        String correction
    ) -> Void {
        Int span = length;
        If (span < 1) {
            span = 1;
        }
        This.messages.Add(code, message, This.filename, line, column, span, expected, actual, correction);
    }

    Private Function PeekToken() -> RxuToken {
        If (This.index < 0 || This.index >= This.tokens.Count()) {
            Return This.EndToken();
        }
        Return This.tokens[This.index];
    }

    Private Function KindAt(Int offset) -> String {
        Int at = This.index + offset;
        If (at < 0 || at >= This.tokens.Count()) {
            Return "End";
        }
        Return This.tokens[at].Kind;
    }

    Private Function AtKind(String kind) -> Bool {
        Return This.PeekToken().Kind == kind;
    }

    Private Function AdvanceToken() -> Void {
        If (This.index < This.tokens.Count()) {
            This.index = This.index + 1;
        }
    }

    Private Function ExpectKind(String kind, String code, String message, String expected, String correction) -> RxuToken {
        RxuToken token = This.PeekToken();
        If (token.Kind == kind) {
            This.AdvanceToken();
            Return token;
        }
        This.ParserFail(code, message, token.Line, token.Column, token.Length, expected, token.Kind, correction);
        If (token.Kind != "End") {
            This.AdvanceToken();
        }
        Return token;
    }

    Private Function QuotedMode(String text) -> String {
        If (text == "true" || text == "false" || text == "True" || text == "False") {
            Return "Boolean";
        }
        Int index = 0;
        If (text.Length() > 0 && text.Substring(0, 1) == "-") {
            index = 1;
        }
        If (index >= text.Length()) {
            Return "String";
        }
        Bool digit = False;
        Bool dot = False;
        While (index < text.Length()) {
            String character = text.Substring(index, 1);
            If (character == "." && !dot && digit) {
                dot = True;
                digit = False;
            } Else If (character >= "0" && character <= "9") {
                digit = True;
            } Else {
                Return "String";
            }
            index = index + 1;
        }
        If (!digit) {
            Return "String";
        }
        If (dot) {
            Return "Float";
        }
        Return "Number";
    }

    Private Function MakeNode(String kind, String name, String text, String mode, Int line, Int column, Int length) -> RxuNode {
        RxuNode node = RxuNode();
        node.Kind = kind + "";
        node.Name = name + "";
        node.Text = text + "";
        node.Mode = mode + "";
        node.Line = line;
        node.Column = column;
        node.Length = length;
        Return node;
    }

    Private Function NodeFromToken(String kind) -> RxuNode {
        RxuToken token = This.PeekToken();
        String name = "";
        If (kind == "Expression") {
            name = token.Mode;
        }
        RxuNode node = This.MakeNode(kind, name, token.Text, token.Mode, token.Line, token.Column, token.Length);
        This.AdvanceToken();
        Return node;
    }

    Private Function EndToken() -> RxuToken {
        RxuToken token = RxuToken();
        token.Kind = "End";
        token.Line = 1;
        token.Column = 1;
        Return token;
    }
}

Public Class RxuInstance {
    Public String Id;
    Public String UserId;
    Public String Name;
    Public String Kind;
    Public String Text;
    Public String ParentId;
    Public String DocumentId;
    Public Bool Disposed;
    Public List<RxuInstance> Children;

    Public Constructor() {
        This.Id = "";
        This.UserId = "";
        This.Name = "";
        This.Kind = "";
        This.Text = "";
        This.ParentId = "";
        This.DocumentId = "";
        This.Disposed = False;
        This.Children = List<RxuInstance>();
    }
}

Public Class RxuDocument {
    Public String Id;
    Public String Path;
    Public String Source;
    Public String State;
    Public RxuInstance Root;
    Public RxuMessages Messages;
    Public Bool Disposed;
    Public List<String> componentNames;
    Public List<RxuNode> componentNodes;
    Public List<String> seenIds;

    Public Constructor() {
        This.Id = "";
        This.Path = "";
        This.Source = "";
        This.State = "";
        This.Root = RxuInstance();
        This.Messages = RxuMessages();
        This.Disposed = False;
        This.componentNames = List<String>();
        This.componentNodes = List<RxuNode>();
        This.seenIds = List<String>();
    }

    Public Function ComponentCount() -> Int
    Explain {
        Description: "Return how many component definitions this document recorded.";
        Input: None;
        Processing: "Read this document's component list.";
        Output: "The number of recorded components.";
    } {
        Return This.componentNames.Count();
    }

    Public Function ComponentName(Int index) -> String
    Explain {
        Description: "Return one recorded component name.";
        Input: index = "Zero-based component index";
        Processing: "Read the name at that index.";
        Output: "The component name, or empty text when the index is outside the list.";
    } {
        If (index < 0 || index >= This.componentNames.Count()) {
            Return "";
        }
        Return This.componentNames[index];
    }
}

Public Class DocumentManager {
    Private List<RxuDocument> documents;
    Private Int nextDocument;
    Private Int nextNode;

    Public Constructor() {
        This.documents = List<RxuDocument>();
        This.nextDocument = 0;
        This.nextNode = 0;
    }

    Public Function Load(String path) -> RxuDocument
    Explain {
        Description: "Load one RXU file into a new document.";
        Input: path = "Path of the markup file";
        Processing: "Read the file, parse it, and keep a private component tree.";
        Output: "The loaded document, or a failed document when the file or markup is invalid.";
    } {
        If (!Files.Exists(path)) {
            Return This.FailMissing(path);
        }
        Return This.Adopt(path, Files.ReadText(path));
    }

    Public Function LoadAsync(String path) -> RxuDocument
    Explain {
        Description: "Load one RXU file and finish before returning.";
        Input: path = "Path of the markup file";
        Processing: "Call Load. This headless runtime has no background loader.";
        Output: "The same document Load returns.";
    } {
        Return This.Load(path);
    }

    Public Function LoadMany(List<String> paths) -> Int
    Explain {
        Description: "Load several RXU files.";
        Input: paths = "Markup file paths";
        Processing: "Load each path as its own document.";
        Output: "The number of documents added.";
    } {
        Int added = 0;
        Int index = 0;
        While (index < paths.Count()) {
            This.Load(paths[index]);
            added = added + 1;
            index = index + 1;
        }
        Return added;
    }

    Public Function Reload(String id) -> RxuDocument
    Explain {
        Description: "Parse a loaded document again and keep its id.";
        Input: id = "Document id";
        Processing: "Read the stored source or file, replace the tree, and return to Loaded.";
        Output: "The same document, or a blank document when the id is gone.";
    } {
        RxuDocument document = This.GetDocument(id);
        If (document.Id == "") {
            Return document;
        }
        String source = document.Source;
        If (document.Path != "" && document.Path != "memory" && Files.Exists(document.Path)) {
            source = Files.ReadText(document.Path);
        }
        This.Fill(document, document.Path, source);
        Return document;
    }

    Public Function ReloadAsync(String id) -> RxuDocument
    Explain {
        Description: "Reload a document and finish before returning.";
        Input: id = "Document id";
        Processing: "Call Reload. This headless runtime has no background loader.";
        Output: "The same document Reload returns.";
    } {
        Return This.Reload(id);
    }

    Public Function Unload(String id) -> Void
    Explain {
        Description: "Drop a document and mark its tree disposed.";
        Input: id = "Document id";
        Processing: "Dispose the instance tree and remove the document.";
        Output: "No return value.";
    } {
        Int index = 0;
        While (index < This.documents.Count()) {
            If (This.documents[index].Id == id) {
                This.DisposeInstance(This.documents[index].Root);
                This.documents[index].Disposed = True;
                This.documents[index].State = "Unloaded";
                This.documents[index].Root = RxuInstance();
                Int cursor = 0;
                Var kept = List<RxuDocument>();
                While (cursor < This.documents.Count()) {
                    If (cursor != index) {
                        kept.Add(This.documents[cursor]);
                    }
                    cursor = cursor + 1;
                }
                This.documents = kept;
                Return;
            }
            index = index + 1;
        }
    }

    Public Function CreateDocument(String source) -> RxuDocument
    Explain {
        Description: "Create a document from markup text.";
        Input: source = "RXU markup";
        Processing: "Parse the text into a private document with path memory.";
        Output: "The created document.";
    } {
        Return This.Adopt("memory", source);
    }

    Public Function GetDocuments() -> Int
    Explain {
        Description: "Count the documents that are still loaded.";
        Input: None;
        Processing: "Read the live document list.";
        Output: "The number of live documents.";
    } {
        Return This.documents.Count();
    }

    Public Function DocumentAt(Int index) -> RxuDocument
    Explain {
        Description: "Return one live document.";
        Input: index = "Zero-based document index";
        Processing: "Read the document at that index.";
        Output: "The document, or a blank document when the index is outside the list.";
    } {
        If (index < 0 || index >= This.documents.Count()) {
            Return RxuDocument();
        }
        Return This.documents[index];
    }

    Public Function GetDocument(String id) -> RxuDocument
    Explain {
        Description: "Find a live document by id.";
        Input: id = "Document id";
        Processing: "Scan the live documents.";
        Output: "The document, or a blank document when it is missing or unloaded.";
    } {
        Int index = 0;
        While (index < This.documents.Count()) {
            If (This.documents[index].Id == id) {
                Return This.documents[index];
            }
            index = index + 1;
        }
        Return RxuDocument();
    }

    Public Function GetRoot(String id) -> RxuInstance
    Explain {
        Description: "Return the root instance of a live document.";
        Input: id = "Document id";
        Processing: "Find the document and read its root.";
        Output: "The root instance, or a blank instance when the document is missing.";
    } {
        RxuDocument document = This.GetDocument(id);
        If (document.Id == "") {
            Return RxuInstance();
        }
        Return document.Root;
    }

    Public Function Show(String id) -> Void
    Explain {
        Description: "Mark a loaded document shown without creating a window.";
        Input: id = "Document id";
        Processing: "Change Loaded, Hidden, or Closed to Shown.";
        Output: "No return value.";
    } {
        RxuDocument document = This.GetDocument(id);
        If (document.State == "Loaded" || document.State == "Hidden" || document.State == "Closed") {
            document.State = "Shown";
        }
    }

    Public Function Hide(String id) -> Void
    Explain {
        Description: "Mark a shown document hidden.";
        Input: id = "Document id";
        Processing: "Change Shown to Hidden.";
        Output: "No return value.";
    } {
        RxuDocument document = This.GetDocument(id);
        If (document.State == "Shown") {
            document.State = "Hidden";
        }
    }

    Public Function Close(String id) -> Void
    Explain {
        Description: "Mark a document closed without unloading it.";
        Input: id = "Document id";
        Processing: "Change a live document to Closed and keep its tree.";
        Output: "No return value.";
    } {
        RxuDocument document = This.GetDocument(id);
        If (document.State == "Loaded" || document.State == "Shown" || document.State == "Hidden") {
            document.State = "Closed";
        }
    }

    Public Function FindByName(String id, String name) -> RxuInstance
    Explain {
        Description: "Find an instance by its Name attribute.";
        Input: id = "Document id", name = "Name attribute";
        Processing: "Walk the live tree.";
        Output: "The first match, or a blank instance.";
    } {
        Return This.FindNamed(This.GetRoot(id), name);
    }

    Public Function FindById(String id, String userId) -> RxuInstance
    Explain {
        Description: "Find an instance by its Id attribute.";
        Input: id = "Document id", userId = "Element Id attribute";
        Processing: "Walk the live tree. The first Id wins.";
        Output: "The first match, or a blank instance.";
    } {
        Return This.FindUser(This.GetRoot(id), userId);
    }

    Public Function FindByKind(String id, String kind) -> RxuInstance
    Explain {
        Description: "Find an instance by its element name.";
        Input: id = "Document id", kind = "Element name";
        Processing: "Walk the live tree.";
        Output: "The first match, or a blank instance.";
    } {
        Return This.FindInstanceKind(This.GetRoot(id), kind);
    }

    Public Function FindByPath(String id, String path) -> RxuInstance
    Explain {
        Description: "Find an instance by a slash-separated element path.";
        Input: id = "Document id", path = "Element path such as Window/Panel/Button";
        Processing: "Match each path segment to an element name.";
        Output: "The instance, or a blank instance.";
    } {
        Return This.FindPath(This.GetRoot(id), path);
    }

    Public Function Attach(String id, String parentId, String kind, String name) -> RxuInstance
    Explain {
        Description: "Add a live instance under a parent.";
        Input: id = "Document id", parentId = "Internal parent id", kind = "Element name", name = "Name attribute";
        Processing: "Create an instance and add it to the parent. The markup definition is unchanged.";
        Output: "The new instance, or a blank instance when the parent is missing.";
    } {
        RxuInstance parent = This.FindInternal(This.GetRoot(id), parentId);
        If (parent.Id == "") {
            Return RxuInstance();
        }
        This.nextNode = This.nextNode + 1;
        RxuInstance child = RxuInstance();
        child.Id = "n" + This.nextNode.ToString();
        child.Kind = kind + "";
        child.Name = name + "";
        child.ParentId = parent.Id + "";
        child.DocumentId = id + "";
        parent.Children.Add(child);
        Return child;
    }

    Public Function Detach(String id, String instanceId) -> Void
    Explain {
        Description: "Remove a live instance from its parent.";
        Input: id = "Document id", instanceId = "Internal instance id";
        Processing: "Drop the instance from its parent and mark that subtree disposed.";
        Output: "No return value.";
    } {
        RxuInstance instance = This.FindInternal(This.GetRoot(id), instanceId);
        If (instance.Id == "" || instance.ParentId == "") {
            Return;
        }
        RxuInstance parent = This.FindInternal(This.GetRoot(id), instance.ParentId);
        Var kept = List<RxuInstance>();
        Int index = 0;
        While (index < parent.Children.Count()) {
            If (parent.Children[index].Id != instanceId) {
                kept.Add(parent.Children[index]);
            }
            index = index + 1;
        }
        parent.Children = List<RxuInstance>();
        index = 0;
        While (index < kept.Count()) {
            parent.Children.Add(kept[index]);
            index = index + 1;
        }
        This.DisposeInstance(instance);
    }

    Private Function FailMissing(String path) -> RxuDocument {
        This.nextDocument = This.nextDocument + 1;
        RxuDocument document = RxuDocument();
        document.Id = "d" + This.nextDocument.ToString();
        document.Path = path + "";
        document.State = "Failed";
        document.Messages.Add("RXU017", "This document file was not found.", path, 1, 1, 1, "an RXU file", path, "Create the file or correct the path.");
        This.documents.Add(document);
        Return document;
    }

    Private Function Adopt(String path, String source) -> RxuDocument {
        This.nextDocument = This.nextDocument + 1;
        RxuDocument document = RxuDocument();
        document.Id = "d" + This.nextDocument.ToString();
        This.Fill(document, path, source);
        This.documents.Add(document);
        Return document;
    }

    Private Function Fill(RxuDocument document, String path, String source) -> Void {
        document.Path = path + "";
        document.Source = source + "";
        document.Disposed = False;
        document.Messages = RxuMessages();
        document.componentNames = List<String>();
        document.componentNodes = List<RxuNode>();
        document.seenIds = List<String>();
        document.Root = RxuInstance();
        RxuParser parser = RxuParser();
        RxuNode tree = parser.Parse(path, source);
        This.CopyMessages(tree.Messages, document.Messages);
        If (document.Messages.Count() > 0) {
            document.State = "Failed";
            Return;
        }
        document.State = "Loaded";
        document.Root = This.BuildRoot(tree, document);
    }

    Private Function BuildRoot(RxuNode tree, RxuDocument document) -> RxuInstance {
        Int elements = 0;
        Int cursor = 0;
        RxuNode only = RxuNode();
        While (cursor < tree.Children.Count()) {
            If (tree.Children[cursor].Kind == "Element") {
                elements = elements + 1;
                If (elements == 1) {
                    only = tree.Children[cursor];
                }
            }
            cursor = cursor + 1;
        }
        If (elements == 1) {
            RxuInstance root = This.MakeInstance(only, document, "");
            This.BuildChildren(root, only, document);
            Return root;
        }
        This.nextNode = This.nextNode + 1;
        RxuInstance holder = RxuInstance();
        holder.Id = "n" + This.nextNode.ToString();
        holder.Kind = "Document";
        holder.DocumentId = document.Id + "";
        This.BuildChildren(holder, tree, document);
        Return holder;
    }

    Private Function BuildChildren(RxuInstance parent, RxuNode node, RxuDocument document) -> Void {
        Int cursor = 0;
        While (cursor < node.Children.Count()) {
            RxuNode child = node.Children[cursor];
            If (child.Kind == "Element") {
                If (child.Name == "Component") {
                    String componentName = child.FindAttribute("Name").Text + "";
                    If (componentName != "") {
                        document.componentNames.Add(componentName);
                    }
                }
                RxuInstance instance = This.MakeInstance(child, document, parent.Id);
                parent.Children.Add(instance);
                This.BuildChildren(instance, child, document);
            }
            cursor = cursor + 1;
        }
    }

    Private Function MakeInstance(RxuNode node, RxuDocument document, String parentId) -> RxuInstance {
        This.nextNode = This.nextNode + 1;
        RxuInstance instance = RxuInstance();
        instance.Id = "n" + This.nextNode.ToString();
        instance.Kind = node.Name + "";
        instance.Name = node.FindAttribute("Name").Text + "";
        instance.UserId = node.FindAttribute("Id").Text + "";
        instance.Text = node.FindAttribute("Text").Text + "";
        instance.ParentId = parentId + "";
        instance.DocumentId = document.Id + "";
        If (instance.UserId != "") {
            Int index = 0;
            Bool seen = False;
            While (index < document.seenIds.Count()) {
                If (document.seenIds[index] == instance.UserId) {
                    seen = True;
                }
                index = index + 1;
            }
            If (seen) {
                document.Messages.Add("RXU016", "This Id is already used in the document.", document.Path, node.Line, node.Column, node.Length, "a unique Id", instance.UserId, "Give this element a different Id.");
            } Else {
                document.seenIds.Add(instance.UserId);
            }
        }
        Return instance;
    }

    Private Function CopyMessages(RxuMessages source, RxuMessages target) -> Void {
        Int index = 0;
        While (index < source.Count()) {
            RxuDiagnostic item = source.At(index);
            target.Add(item.Code, item.Message, item.Filename, item.Line, item.Column, item.Length, item.Expected, item.Actual, item.Correction);
            index = index + 1;
        }
    }

    Private Function FindNamed(RxuInstance node, String name) -> RxuInstance {
        If (node.Id == "" || node.Disposed) {
            Return RxuInstance();
        }
        If (node.Name == name && name != "") {
            Return node;
        }
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuInstance found = This.FindNamed(node.Children[index], name);
            If (found.Id != "") {
                Return found;
            }
            index = index + 1;
        }
        Return RxuInstance();
    }

    Private Function FindUser(RxuInstance node, String userId) -> RxuInstance {
        If (node.Id == "" || node.Disposed) {
            Return RxuInstance();
        }
        If (node.UserId == userId && userId != "") {
            Return node;
        }
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuInstance found = This.FindUser(node.Children[index], userId);
            If (found.Id != "") {
                Return found;
            }
            index = index + 1;
        }
        Return RxuInstance();
    }

    Private Function FindInstanceKind(RxuInstance node, String kind) -> RxuInstance {
        If (node.Id == "" || node.Disposed) {
            Return RxuInstance();
        }
        If (node.Kind == kind && kind != "") {
            Return node;
        }
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuInstance found = This.FindInstanceKind(node.Children[index], kind);
            If (found.Id != "") {
                Return found;
            }
            index = index + 1;
        }
        Return RxuInstance();
    }

    Private Function FindInternal(RxuInstance node, String instanceId) -> RxuInstance {
        If (node.Id == "" || node.Disposed) {
            Return RxuInstance();
        }
        If (node.Id == instanceId) {
            Return node;
        }
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuInstance found = This.FindInternal(node.Children[index], instanceId);
            If (found.Id != "") {
                Return found;
            }
            index = index + 1;
        }
        Return RxuInstance();
    }

    Private Function FindPath(RxuInstance node, String path) -> RxuInstance {
        If (node.Id == "" || node.Disposed || path == "") {
            Return RxuInstance();
        }
        Int slash = path.IndexOf("/");
        String head = path;
        String tail = "";
        If (slash >= 0) {
            head = path.Substring(0, slash);
            tail = path.Substring(slash + 1, path.Length() - slash - 1);
        }
        If (node.Kind != head) {
            Return RxuInstance();
        }
        If (tail == "") {
            Return node;
        }
        Int index = 0;
        While (index < node.Children.Count()) {
            If (node.Children[index].Kind == This.PathHead(tail)) {
                RxuInstance found = This.FindPath(node.Children[index], tail);
                If (found.Id != "") {
                    Return found;
                }
            }
            index = index + 1;
        }
        Return RxuInstance();
    }

    Private Function PathHead(String path) -> String {
        Int slash = path.IndexOf("/");
        If (slash < 0) {
            Return path;
        }
        Return path.Substring(0, slash);
    }

    Private Function DisposeInstance(RxuInstance node) -> Void {
        node.Disposed = True;
        Int index = 0;
        While (index < node.Children.Count()) {
            This.DisposeInstance(node.Children[index]);
            index = index + 1;
        }
    }
}

Public Class UI {
    Public DocumentManager Documents;

    Public Constructor() {
        This.Documents = DocumentManager();
    }

    Public Function Load(String path) -> RxuDocument
    Explain {
        Description: "Load one RXU document.";
        Input: path = "Path of the markup file";
        Processing: "Ask the document manager to load the file.";
        Output: "The loaded document.";
    } {
        Return This.Documents.Load(path);
    }

    Public Function LoadAsync(String path) -> RxuDocument
    Explain {
        Description: "Load one RXU document and finish before returning.";
        Input: path = "Path of the markup file";
        Processing: "Ask the document manager to load the file now.";
        Output: "The loaded document.";
    } {
        Return This.Documents.LoadAsync(path);
    }

    Public Function LoadMany(List<String> paths) -> Int
    Explain {
        Description: "Load several RXU documents.";
        Input: paths = "Markup file paths";
        Processing: "Ask the document manager to load each file.";
        Output: "The number of documents added.";
    } {
        Return This.Documents.LoadMany(paths);
    }

    Public Function Reload(String id) -> RxuDocument
    Explain {
        Description: "Reload one document.";
        Input: id = "Document id";
        Processing: "Ask the document manager to parse the document again.";
        Output: "The reloaded document.";
    } {
        Return This.Documents.Reload(id);
    }

    Public Function ReloadAsync(String id) -> RxuDocument
    Explain {
        Description: "Reload one document and finish before returning.";
        Input: id = "Document id";
        Processing: "Ask the document manager to reload the document now.";
        Output: "The reloaded document.";
    } {
        Return This.Documents.ReloadAsync(id);
    }

    Public Function Unload(String id) -> Void
    Explain {
        Description: "Unload one document.";
        Input: id = "Document id";
        Processing: "Ask the document manager to drop the document.";
        Output: "No return value.";
    } {
        This.Documents.Unload(id);
    }

    Public Function CreateDocument(String source) -> RxuDocument
    Explain {
        Description: "Create a document from markup text.";
        Input: source = "RXU markup";
        Processing: "Ask the document manager to parse the text.";
        Output: "The created document.";
    } {
        Return This.Documents.CreateDocument(source);
    }

    Public Function GetDocuments() -> Int
    Explain {
        Description: "Count the live documents.";
        Input: None;
        Processing: "Ask the document manager for the live count.";
        Output: "The number of live documents.";
    } {
        Return This.Documents.GetDocuments();
    }

    Public Function GetDocument(String id) -> RxuDocument
    Explain {
        Description: "Find a live document by id.";
        Input: id = "Document id";
        Processing: "Ask the document manager for that document.";
        Output: "The document, or a blank document.";
    } {
        Return This.Documents.GetDocument(id);
    }

    Public Function GetRoot(String id) -> RxuInstance
    Explain {
        Description: "Return the root instance of a document.";
        Input: id = "Document id";
        Processing: "Ask the document manager for the root.";
        Output: "The root instance, or a blank instance.";
    } {
        Return This.Documents.GetRoot(id);
    }

    Public Function Show(String id) -> Void
    Explain {
        Description: "Show a document without loading it again.";
        Input: id = "Document id";
        Processing: "Ask the document manager to mark the document shown.";
        Output: "No return value.";
    } {
        This.Documents.Show(id);
    }

    Public Function Hide(String id) -> Void
    Explain {
        Description: "Hide a shown document.";
        Input: id = "Document id";
        Processing: "Ask the document manager to mark the document hidden.";
        Output: "No return value.";
    } {
        This.Documents.Hide(id);
    }

    Public Function Close(String id) -> Void
    Explain {
        Description: "Close a document without unloading it.";
        Input: id = "Document id";
        Processing: "Ask the document manager to mark the document closed.";
        Output: "No return value.";
    } {
        This.Documents.Close(id);
    }
}

Public Class UIElement {
    Public String Kind;
    Public Int ChangeCount;
    Public Bool Invalidated;
    Public Bool LayoutInvalidated;
    Public String TemplateName;
    Public String VisualKind;
    Public RxuMessages Messages;
    Private String contextKey;
    Private Bool contextLocal;
    Public List<UIElement> children;
    Private Int updateDepth;
    Private List<String> names;
    Private List<String> values;
    Private List<String> sources;
    Private List<String> pendingNames;
    Private List<String> pendingValues;

    Public Constructor() {
        This.Kind = "UIElement";
        This.ChangeCount = 0;
        This.Invalidated = False;
        This.LayoutInvalidated = False;
        This.TemplateName = "";
        This.VisualKind = "";
        This.Messages = RxuMessages();
        This.contextKey = "";
        This.contextLocal = False;
        This.children = List<UIElement>();
        This.updateDepth = 0;
        This.names = List<String>();
        This.values = List<String>();
        This.sources = List<String>();
        This.pendingNames = List<String>();
        This.pendingValues = List<String>();
    }

    Public Function SetAttribute(String name, String value) -> Bool
    Explain {
        Description: "Set a local property when the value matches its type.";
        Input: name = "Property name", value = "New value";
        Processing: "Reject an unknown, disallowed, or mistyped value. Queue it inside an update.";
        Output: "True when the value is accepted.";
    } {
        Return This.Write("Local", name, value);
    }

    Public Function GetAttribute(String name) -> String
    Explain {
        Description: "Read the effective property value.";
        Input: name = "Property name";
        Processing: "Choose animation, then local, style, inherited, then the default.";
        Output: "The effective text, or empty text when the property is unknown.";
    } {
        String stored = This.Canonical(name);
        If (This.TypeOf(stored) == "") {
            Return "";
        }
        String chosen = This.SourceValue(stored, "Animation");
        If (chosen == "") {
            chosen = This.SourceValue(stored, "Local");
        }
        If (chosen == "") {
            chosen = This.SourceValue(stored, "Style");
        }
        If (chosen == "") {
            chosen = This.SourceValue(stored, "Inherited");
        }
        If (chosen == "") {
            Return This.DefaultOf(stored);
        }
        Return chosen;
    }

    Public Function HasAttribute(String name) -> Bool
    Explain {
        Description: "Report whether a local value is set.";
        Input: name = "Property name";
        Processing: "Look for a local entry. Foreground uses Color.";
        Output: "True when a local value is present.";
    } {
        Return This.SourceValue(This.Canonical(name), "Local") != "";
    }

    Public Function Accepts(String name) -> Bool
    Explain {
        Description: "Report whether this element allows a property.";
        Input: name = "Property name";
        Processing: "Use the element kind catalog. Foreground uses Color.";
        Output: "True when the property is allowed.";
    } {
        Return This.Allows(This.Canonical(name));
    }

    Public Function RemoveAttribute(String name) -> Bool
    Explain {
        Description: "Remove the local value.";
        Input: name = "Property name";
        Processing: "Drop the local entry and leave style, animation, and inherited values.";
        Output: "True when a local value was removed.";
    } {
        Return This.DropSource(This.Canonical(name), "Local");
    }

    Public Function ResetAttribute(String name) -> Void
    Explain {
        Description: "Clear local, style, and animation values.";
        Input: name = "Property name";
        Processing: "Drop those sources so inherited or the default shows through.";
        Output: "No return value.";
    } {
        String stored = This.Canonical(name);
        This.DropSource(stored, "Local");
        This.DropSource(stored, "Style");
        This.DropSource(stored, "Animation");
    }

    Public Function AttributeCount() -> Int
    Explain {
        Description: "Count the properties this element kind allows.";
        Input: None;
        Processing: "Read the catalog for this kind.";
        Output: "The number of property names.";
    } {
        Return This.SegmentCount(This.Catalog());
    }

    Public Function AttributeName(Int index) -> String
    Explain {
        Description: "Return one allowed property name.";
        Input: index = "Zero-based catalog index";
        Processing: "Read that segment of the catalog.";
        Output: "The property name, or empty text when the index is outside the catalog.";
    } {
        Return This.Segment(This.Catalog(), index);
    }

    Public Function AttributeType(String name) -> String
    Explain {
        Description: "Return the type name of a property.";
        Input: name = "Property name";
        Processing: "Resolve aliases and read the type.";
        Output: "The type name, or empty text when the property is unknown.";
    } {
        Return This.TypeOf(This.Canonical(name));
    }

    Public Function SetAttributes(RxuNode node) -> Int
    Explain {
        Description: "Apply the attributes of a parsed element.";
        Input: node = "Parsed element";
        Processing: "Set each attribute and count the ones that are rejected.";
        Output: "The number of rejected attributes.";
    } {
        Int failed = 0;
        Int index = 0;
        While (index < node.Attributes.Count()) {
            RxuNode attribute = node.Attributes[index];
            If (!This.SetAttribute(attribute.Name, attribute.Text)) {
                failed = failed + 1;
            }
            index = index + 1;
        }
        Return failed;
    }

    Public Function SetStyle(String name, String value) -> Bool
    Explain {
        Description: "Set a style value.";
        Input: name = "Property name", value = "Style value";
        Processing: "Validate the value and store it as Style.";
        Output: "True when the value is accepted.";
    } {
        Return This.Write("Style", name, value);
    }

    Public Function ClearStyle(String name) -> Void
    Explain {
        Description: "Remove one style value.";
        Input: name = "Property name";
        Processing: "Drop the style source so local, inherited, or the default shows through.";
        Output: "No return value.";
    } {
        This.DropSource(This.Canonical(name), "Style");
    }

    Public Function SetAnimation(String name, String value) -> Bool
    Explain {
        Description: "Set an animation value.";
        Input: name = "Property name", value = "Animation value";
        Processing: "Validate the value and store it as Animation.";
        Output: "True when the value is accepted.";
    } {
        Return This.Write("Animation", name, value);
    }

    Public Function BeginUpdate() -> Void
    Explain {
        Description: "Start a batched property update.";
        Input: None;
        Processing: "Increase the update depth. Local writes wait for the outer end.";
        Output: "No return value.";
    } {
        This.updateDepth = This.updateDepth + 1;
    }

    Public Function EndUpdate() -> Int
    Explain {
        Description: "End one update level and apply the batch at the outer end.";
        Input: None;
        Processing: "Apply queued local values once and raise one change notice.";
        Output: "The number of values applied, or zero when the batch is still open.";
    } {
        If (This.updateDepth == 0) {
            Return 0;
        }
        This.updateDepth = This.updateDepth - 1;
        If (This.updateDepth > 0) {
            Return 0;
        }
        Return This.ApplyChanges();
    }

    Public Function CancelUpdate() -> Void
    Explain {
        Description: "Drop a batched update.";
        Input: None;
        Processing: "Clear the queued values and the update depth.";
        Output: "No return value.";
    } {
        This.updateDepth = 0;
        This.pendingNames = List<String>();
        This.pendingValues = List<String>();
    }

    Public Function ApplyChanges() -> Int
    Explain {
        Description: "Apply queued local values.";
        Input: None;
        Processing: "Write the queue, mark the element dirty, and count one change.";
        Output: "The number of values applied.";
    } {
        Int count = This.pendingNames.Count();
        Int index = 0;
        While (index < count) {
            This.Store("Local", This.pendingNames[index], This.pendingValues[index]);
            If (This.IsLayout(This.pendingNames[index])) {
                This.LayoutInvalidated = True;
            }
            This.Publish(This.pendingNames[index]);
            index = index + 1;
        }
        This.pendingNames = List<String>();
        This.pendingValues = List<String>();
        If (count > 0) {
            This.Invalidated = True;
            This.ChangeCount = This.ChangeCount + 1;
        }
        Return count;
    }

    Public Function Refresh() -> Void
    Explain {
        Description: "Clear the dirty flags after a refresh.";
        Input: None;
        Processing: "Set both invalidation flags to false.";
        Output: "No return value.";
    } {
        This.Invalidated = False;
        This.LayoutInvalidated = False;
    }

    Public Function Invalidate() -> Void
    Explain {
        Description: "Mark the element for a repaint.";
        Input: None;
        Processing: "Set the paint invalidation flag.";
        Output: "No return value.";
    } {
        This.Invalidated = True;
    }

    Public Function InvalidateLayout() -> Void
    Explain {
        Description: "Mark the element for layout and repaint.";
        Input: None;
        Processing: "Set the layout and paint invalidation flags.";
        Output: "No return value.";
    } {
        This.Invalidated = True;
        This.LayoutInvalidated = True;
    }

    Public Function SetParent(UIElement parent) -> Void
    Explain {
        Description: "Attach this element to a parent and inherit values.";
        Input: parent = "Parent element";
        Processing: "Record the parent and copy inheritable effective values.";
        Output: "No return value.";
    } {
        parent.children.Add(This);
        This.TakeDataContext(parent.ContextKey());
        This.TakeInherited(parent, "Color");
        This.TakeInherited(parent, "FontFamily");
        This.TakeInherited(parent, "FontSize");
        This.TakeInherited(parent, "FontWeight");
        This.TakeInherited(parent, "Cursor");
        This.TakeInherited(parent, "TextAlignment");
    }

    Public Function SetDataContext(String key) -> Void
    Explain {
        Description: "Set this element's data context and pass it to descendants.";
        Input: key = "Context path such as User";
        Processing: "Remember a local context and copy it onto descendants that do not have their own.";
        Output: "No return value.";
    } {
        This.contextKey = key + "";
        This.contextLocal = True;
        Int index = 0;
        While (index < This.children.Count()) {
            This.children[index].TakeDataContext(key);
            index = index + 1;
        }
    }

    Public Function ClearDataContext(String inherited) -> Void
    Explain {
        Description: "Drop the local data context and inherit another.";
        Input: inherited = "Context key from the parent, or empty";
        Processing: "Clear the local flag and copy the inherited key onto descendants that do not have their own.";
        Output: "No return value.";
    } {
        This.contextLocal = False;
        This.contextKey = inherited + "";
        Int index = 0;
        While (index < This.children.Count()) {
            This.children[index].TakeDataContext(inherited);
            index = index + 1;
        }
    }

    Public Function ContextKey() -> String
    Explain {
        Description: "Read the effective data context key.";
        Input: None;
        Processing: "Return the local key or the key copied from an ancestor.";
        Output: "The context key, or empty text when none is set.";
    } {
        Return This.contextKey;
    }

    Public Function TakeDataContext(String key) -> Void
    Explain {
        Description: "Inherit a data context when this element does not have its own.";
        Input: key = "Ancestor context key";
        Processing: "Keep a local context. Otherwise copy the key and pass it downward.";
        Output: "No return value.";
    } {
        If (This.contextLocal) {
            Return;
        }
        This.contextKey = key + "";
        Int index = 0;
        While (index < This.children.Count()) {
            This.children[index].TakeDataContext(key);
            index = index + 1;
        }
    }

    Private Function Write(String source, String name, String value) -> Bool {
        String stored = This.Canonical(name);
        String typeName = This.TypeOf(stored);
        If (typeName == "") {
            This.Messages.Add("RXU019", "This property is unknown.", "", 1, 1, name.Length(), "a known property", name, "Use a property from the catalog.");
            Return False;
        }
        If (!This.Allows(stored)) {
            This.Messages.Add("RXU020", "This property is not allowed on this element.", "", 1, 1, name.Length(), This.Kind, name, "Move the property to an element that allows it.");
            Return False;
        }
        If (!This.ValidValue(stored, value) || !This.ValidRange(stored, value)) {
            This.Messages.Add("RXU018", "This value does not match the property type.", "", 1, 1, value.Length(), typeName, value, "Use a value of the property type.");
            Return False;
        }
        If (source == "Local" && This.updateDepth > 0) {
            This.Hold(stored, value);
            Return True;
        }
        This.Store(source, stored, value);
        If (This.IsLayout(stored)) {
            This.LayoutInvalidated = True;
        }
        This.Invalidated = True;
        This.ChangeCount = This.ChangeCount + 1;
        This.Publish(stored);
        Return True;
    }

    Private Function Canonical(String name) -> String {
        If (name == "Foreground") {
            Return "Color";
        }
        Return name;
    }

    Private Function Catalog() -> String {
        String common = "Name,Id,Visible,Enabled,Opacity,Tag,Class";
        String framework = "Width,Height,MinWidth,MinHeight,MaxWidth,MaxHeight,Margin,Padding,HorizontalAlignment,VerticalAlignment,Cursor,ToolTip,Style";
        String layout = "Orientation,Spacing,Row,Column,RowSpan,ColumnSpan,HorizontalContentAlignment,VerticalContentAlignment,GridColumns,GridRows,Dock,Wrap,ClipToBounds";
        String appearance = "Background,Color,Foreground,FontFamily,FontSize,FontWeight,BorderColor,BorderWidth,CornerRadius,Shadow,TextAlignment,TextDecoration,Icon,Image,Animation,Duration";
        If (This.Kind == "Panel") {
            Return common + "," + framework + "," + layout;
        }
        If (This.Kind == "Control" || This.Kind == "Button") {
            Return common + "," + framework + "," + appearance;
        }
        If (This.Kind == "Window" || This.Kind == "FrameworkElement") {
            Return common + "," + framework + ",Title";
        }
        Return common;
    }

    Private Function Allows(String name) -> Bool {
        Int index = 0;
        String catalog = This.Catalog();
        Int count = This.SegmentCount(catalog);
        While (index < count) {
            If (This.Segment(catalog, index) == name || (name == "Color" && This.Segment(catalog, index) == "Foreground")) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function TypeOf(String name) -> String {
        If (name == "Name" || name == "Id" || name == "Tag" || name == "Class" || name == "Style" || name == "ToolTip" || name == "FontFamily" || name == "Icon" || name == "Image" || name == "Animation" || name == "Title") {
            Return "String";
        }
        If (name == "Width" || name == "Height") {
            Return "Dimension";
        }
        If (name == "MinWidth" || name == "MinHeight" || name == "MaxWidth" || name == "MaxHeight" || name == "BorderWidth" || name == "Spacing" || name == "Row" || name == "Column" || name == "RowSpan" || name == "ColumnSpan" || name == "GridColumns" || name == "GridRows") {
            Return "Number";
        }
        If (name == "Opacity" || name == "FontSize") {
            Return "Float";
        }
        If (name == "Visible" || name == "Enabled" || name == "ClipToBounds" || name == "Wrap") {
            Return "Boolean";
        }
        If (name == "Margin" || name == "Padding" || name == "CornerRadius") {
            Return "Thickness";
        }
        If (name == "Shadow") {
            Return "Shadow";
        }
        If (name == "Background" || name == "BorderColor") {
            Return "Brush";
        }
        If (name == "Color") {
            Return "Color";
        }
        If (name == "Cursor") {
            Return "Cursor";
        }
        If (name == "HorizontalAlignment" || name == "VerticalAlignment" || name == "HorizontalContentAlignment" || name == "VerticalContentAlignment" || name == "TextAlignment") {
            Return "Alignment";
        }
        If (name == "Orientation") {
            Return "Orientation";
        }
        If (name == "Dock") {
            Return "Dock";
        }
        If (name == "FontWeight") {
            Return "FontWeight";
        }
        If (name == "TextDecoration") {
            Return "TextDecoration";
        }
        If (name == "Duration") {
            Return "Duration";
        }
        Return "";
    }

    Private Function DefaultOf(String name) -> String {
        If (name == "Visible" || name == "Enabled") {
            Return "true";
        }
        If (name == "Opacity") {
            Return "1";
        }
        If (name == "Width" || name == "Height") {
            Return "Auto";
        }
        If (name == "HorizontalAlignment" || name == "VerticalAlignment" || name == "HorizontalContentAlignment" || name == "VerticalContentAlignment") {
            Return "Stretch";
        }
        If (name == "Cursor") {
            Return "Arrow";
        }
        If (name == "Orientation") {
            Return "Vertical";
        }
        If (name == "Dock") {
            Return "Fill";
        }
        If (name == "Wrap" || name == "ClipToBounds") {
            Return "false";
        }
        If (name == "FontSize") {
            Return "14";
        }
        If (name == "FontWeight") {
            Return "Normal";
        }
        If (name == "TextAlignment") {
            Return "Start";
        }
        If (name == "TextDecoration" || name == "Shadow" || name == "Background") {
            Return "None";
        }
        If (name == "Color" || name == "BorderColor") {
            Return "#000000";
        }
        If (name == "BorderWidth" || name == "Spacing" || name == "Row" || name == "Column" || name == "Margin" || name == "Padding" || name == "CornerRadius") {
            Return "0";
        }
        If (name == "RowSpan" || name == "ColumnSpan" || name == "GridColumns" || name == "GridRows") {
            Return "1";
        }
        If (name == "Duration") {
            Return "0ms";
        }
        Return "";
    }

    Private Function IsLayout(String name) -> Bool {
        String typeName = This.TypeOf(name);
        If (typeName == "Dimension" || typeName == "Thickness" || typeName == "Orientation" || typeName == "Dock" || typeName == "Alignment") {
            Return True;
        }
        If (name == "Spacing" || name == "Row" || name == "Column" || name == "RowSpan" || name == "ColumnSpan" || name == "GridColumns" || name == "GridRows" || name == "Wrap" || name == "ClipToBounds" || name == "MinWidth" || name == "MinHeight" || name == "MaxWidth" || name == "MaxHeight") {
            Return True;
        }
        Return False;
    }

    Private Function ValidValue(String name, String value) -> Bool {
        String typeName = This.TypeOf(name);
        If (typeName == "String") {
            Return True;
        }
        If (typeName == "Number") {
            Return This.IsNumber(value);
        }
        If (typeName == "Float") {
            If (name == "Opacity") {
                Return This.IsOpacity(value);
            }
            Return This.IsFloat(value);
        }
        If (typeName == "Boolean") {
            Return value == "true" || value == "false" || value == "True" || value == "False";
        }
        If (typeName == "Dimension") {
            Return This.IsDimension(value);
        }
        If (typeName == "Thickness") {
            Return This.IsThickness(value);
        }
        If (typeName == "Shadow") {
            Return value == "None" || This.IsThickness(value);
        }
        If (typeName == "Color") {
            Return This.IsColor(value);
        }
        If (typeName == "Brush") {
            Return value == "None" || This.IsColor(value) || (value.StartsWith("Solid ") && This.IsColor(value.Substring(6, value.Length() - 6)));
        }
        If (typeName == "Duration") {
            Return This.IsDuration(value);
        }
        If (typeName == "Alignment") {
            Return value == "Start" || value == "Center" || value == "End" || value == "Stretch";
        }
        If (typeName == "Cursor") {
            Return value == "Arrow" || value == "Hand" || value == "Text" || value == "Wait";
        }
        If (typeName == "Orientation") {
            Return value == "Horizontal" || value == "Vertical";
        }
        If (typeName == "Dock") {
            Return value == "Left" || value == "Right" || value == "Top" || value == "Bottom" || value == "Fill";
        }
        If (typeName == "FontWeight") {
            Return value == "Normal" || value == "Bold";
        }
        If (typeName == "TextDecoration") {
            Return value == "None" || value == "Underline";
        }
        Return False;
    }

    Private Function ValidRange(String name, String value) -> Bool {
        If (name == "MinWidth" || name == "MinHeight" || name == "MaxWidth" || name == "MaxHeight") {
            String pair = "MaxWidth";
            String current = This.GetAttribute(name);
            If (name == "MinWidth") {
                pair = "MaxWidth";
            }
            If (name == "MinHeight") {
                pair = "MaxHeight";
            }
            If (name == "MaxWidth") {
                pair = "MinWidth";
            }
            If (name == "MaxHeight") {
                pair = "MinHeight";
            }
            String other = This.GetAttribute(pair);
            If (other == "" || value == "") {
                Return True;
            }
            Int next = value.ToInt();
            Int previous = other.ToInt();
            If (name.StartsWith("Min") && previous < next) {
                Return False;
            }
            If (name.StartsWith("Max") && next < previous) {
                Return False;
            }
            If (current == value) {
                Return True;
            }
        }
        Return True;
    }

    Private Function IsNumber(String value) -> Bool {
        Int index = 0;
        If (value.Length() > 0 && value.Substring(0, 1) == "-") {
            index = 1;
        }
        If (index >= value.Length()) {
            Return False;
        }
        While (index < value.Length()) {
            String character = value.Substring(index, 1);
            If (character < "0" || character > "9") {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function IsFloat(String value) -> Bool {
        Int dots = 0;
        Int digits = 0;
        Int index = 0;
        While (index < value.Length()) {
            String character = value.Substring(index, 1);
            If (character == ".") {
                dots = dots + 1;
            } Else If (character >= "0" && character <= "9") {
                digits = digits + 1;
            } Else {
                Return False;
            }
            index = index + 1;
        }
        Return digits > 0 && dots < 2;
    }

    Private Function IsOpacity(String value) -> Bool {
        If (value == "0" || value == "1" || value == "0.0" || value == "1.0") {
            Return True;
        }
        If (value.Length() < 3 || value.Substring(0, 2) != "0.") {
            Return False;
        }
        Int index = 2;
        While (index < value.Length()) {
            String character = value.Substring(index, 1);
            If (character < "0" || character > "9") {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function IsDimension(String value) -> Bool {
        If (value == "Auto" || value == "*") {
            Return True;
        }
        If (value.EndsWith("px")) {
            Return This.IsNumber(value.Substring(0, value.Length() - 2));
        }
        If (value.EndsWith("*")) {
            Return This.IsNumber(value.Substring(0, value.Length() - 1));
        }
        Return This.IsNumber(value);
    }

    Private Function IsThickness(String value) -> Bool {
        Int parts = 1;
        Int index = 0;
        String current = "";
        While (index < value.Length()) {
            String character = value.Substring(index, 1);
            If (character == ",") {
                If (!This.IsNumber(current)) {
                    Return False;
                }
                current = "";
                parts = parts + 1;
            } Else {
                current = current + character;
            }
            index = index + 1;
        }
        Return This.IsNumber(current) && (parts == 1 || parts == 2 || parts == 4);
    }

    Private Function IsColor(String value) -> Bool {
        If (value == "Black" || value == "White" || value == "Transparent") {
            Return True;
        }
        If (value.Length() < 4 || value.Substring(0, 1) != "#") {
            Return False;
        }
        Int length = value.Length() - 1;
        If (length != 3 && length != 4 && length != 6 && length != 8) {
            Return False;
        }
        Int index = 1;
        While (index < value.Length()) {
            String character = value.Substring(index, 1);
            Bool digit = character >= "0" && character <= "9";
            Bool lower = character >= "a" && character <= "f";
            Bool upper = character >= "A" && character <= "F";
            If (!digit && !lower && !upper) {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function IsDuration(String value) -> Bool {
        If (value.EndsWith("ms")) {
            Return This.IsNumber(value.Substring(0, value.Length() - 2));
        }
        If (value.EndsWith("s")) {
            Return This.IsNumber(value.Substring(0, value.Length() - 1));
        }
        Return False;
    }

    Private Function Store(String source, String name, String value) -> Void {
        Int index = 0;
        While (index < This.names.Count()) {
            If (This.names[index] == name && This.sources[index] == source) {
                This.values[index] = value + "";
                Return;
            }
            index = index + 1;
        }
        This.names.Add(name + "");
        This.values.Add(value + "");
        This.sources.Add(source + "");
    }

    Private Function SourceValue(String name, String source) -> String {
        Int index = 0;
        While (index < This.names.Count()) {
            If (This.names[index] == name && This.sources[index] == source) {
                Return This.values[index];
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function DropSource(String name, String source) -> Bool {
        Int found = 0;
        Var keptNames = List<String>();
        Var keptValues = List<String>();
        Var keptSources = List<String>();
        Int index = 0;
        While (index < This.names.Count()) {
            If (This.names[index] == name && This.sources[index] == source) {
                found = 1;
            } Else {
                keptNames.Add(This.names[index]);
                keptValues.Add(This.values[index]);
                keptSources.Add(This.sources[index]);
            }
            index = index + 1;
        }
        This.names = keptNames;
        This.values = keptValues;
        This.sources = keptSources;
        Return found == 1;
    }

    Private Function Hold(String name, String value) -> Void {
        Int index = 0;
        While (index < This.pendingNames.Count()) {
            If (This.pendingNames[index] == name) {
                This.pendingValues[index] = value + "";
                Return;
            }
            index = index + 1;
        }
        This.pendingNames.Add(name + "");
        This.pendingValues.Add(value + "");
    }

    Private Function Publish(String name) -> Void {
        If (name != "Color" && name != "FontFamily" && name != "FontSize" && name != "FontWeight" && name != "Cursor" && name != "TextAlignment") {
            Return;
        }
        Int index = 0;
        While (index < This.children.Count()) {
            This.children[index].TakeInherited(This, name);
            index = index + 1;
        }
    }

    Private Function TakeInherited(UIElement parent, String name) -> Void {
        If (This.SourceValue(name, "Animation") != "" || This.SourceValue(name, "Local") != "" || This.SourceValue(name, "Style") != "") {
            Return;
        }
        This.Store("Inherited", name, parent.GetAttribute(name));
    }

    Private Function SegmentCount(String catalog) -> Int {
        If (catalog == "") {
            Return 0;
        }
        Int count = 1;
        Int index = 0;
        While (index < catalog.Length()) {
            If (catalog.Substring(index, 1) == ",") {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function Segment(String catalog, Int wanted) -> String {
        Int seen = 0;
        Int start = 0;
        Int index = 0;
        While (index < catalog.Length()) {
            If (catalog.Substring(index, 1) == ",") {
                If (seen == wanted) {
                    Return catalog.Substring(start, index - start);
                }
                seen = seen + 1;
                start = index + 1;
            }
            index = index + 1;
        }
        If (seen == wanted) {
            Return catalog.Substring(start, catalog.Length() - start);
        }
        Return "";
    }
}

Public Class ResourceTable {
    Public RxuMessages Messages;
    Private List<String> keys;
    Private List<String> types;
    Private List<String> values;

    Public Constructor() {
        This.Messages = RxuMessages();
        This.keys = List<String>();
        This.types = List<String>();
        This.values = List<String>();
    }

    Public Function Set(String typeName, String key, String value) -> Bool
    Explain {
        Description: "Store one typed resource.";
        Input: typeName = "Resource type", key = "Resource name", value = "Resource value";
        Processing: "Reject an unknown type, a mistyped value, or a duplicate key.";
        Output: "True when the resource is stored.";
    } {
        If (!This.KnownType(typeName) || !This.Valid(typeName, value)) {
            This.Messages.Add("RXU021", "This resource value does not match its type.", "", 1, 1, value.Length(), typeName, value, "Use a value of the declared resource type.");
            Return False;
        }
        If (This.Has(key)) {
            This.Messages.Add("RXU023", "This resource key is already defined here.", "", 1, 1, key.Length(), "one value", key, "Override it in a nearer scope or remove the old value.");
            Return False;
        }
        This.keys.Add(key + "");
        This.types.Add(typeName + "");
        This.values.Add(value + "");
        Return True;
    }

    Public Function Get(String key) -> String
    Explain {
        Description: "Read one resource value.";
        Input: key = "Resource name";
        Processing: "Find the key in this table only.";
        Output: "The stored value, or empty text when it is missing.";
    } {
        Int index = This.IndexOf(key);
        If (index < 0) {
            Return "";
        }
        Return This.values[index];
    }

    Public Function TypeOfKey(String key) -> String
    Explain {
        Description: "Read the type of one resource.";
        Input: key = "Resource name";
        Processing: "Find the key in this table only.";
        Output: "The type name, or empty text when it is missing.";
    } {
        Int index = This.IndexOf(key);
        If (index < 0) {
            Return "";
        }
        Return This.types[index];
    }

    Public Function Has(String key) -> Bool
    Explain {
        Description: "Report whether this table defines a key.";
        Input: key = "Resource name";
        Processing: "Scan this table only.";
        Output: "True when the key is present.";
    } {
        Return This.IndexOf(key) >= 0;
    }

    Public Function Count() -> Int
    Explain {
        Description: "Count the resources in this table.";
        Input: None;
        Processing: "Read the key list size.";
        Output: "The number of resources.";
    } {
        Return This.keys.Count();
    }

    Public Function KeyAt(Int index) -> String
    Explain {
        Description: "Return one resource key.";
        Input: index = "Zero-based index";
        Processing: "Read the key at that index.";
        Output: "The key, or empty text when the index is outside the table.";
    } {
        If (index < 0 || index >= This.keys.Count()) {
            Return "";
        }
        Return This.keys[index];
    }

    Public Function Remove(String key) -> Bool
    Explain {
        Description: "Remove one resource from this table.";
        Input: key = "Resource name";
        Processing: "Drop the key, type, and value together.";
        Output: "True when the key was present.";
    } {
        Int found = This.IndexOf(key);
        If (found < 0) {
            Return False;
        }
        Var keptKeys = List<String>();
        Var keptTypes = List<String>();
        Var keptValues = List<String>();
        Int index = 0;
        While (index < This.keys.Count()) {
            If (index != found) {
                keptKeys.Add(This.keys[index]);
                keptTypes.Add(This.types[index]);
                keptValues.Add(This.values[index]);
            }
            index = index + 1;
        }
        This.keys = keptKeys;
        This.types = keptTypes;
        This.values = keptValues;
        Return True;
    }

    Public Function Load(RxuNode node) -> Int
    Explain {
        Description: "Load resource elements from markup.";
        Input: node = "Resources element";
        Processing: "Read each typed child and count the ones that are rejected.";
        Output: "The number of rejected resources.";
    } {
        Int failed = 0;
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuNode child = node.Children[index];
            If (child.Kind == "Element" && This.KnownType(child.Name)) {
                If (!This.Set(child.Name, child.FindAttribute("Name").Text, child.FindAttribute("Value").Text)) {
                    failed = failed + 1;
                }
            }
            index = index + 1;
        }
        Return failed;
    }

    Private Function IndexOf(String key) -> Int {
        Int index = 0;
        While (index < This.keys.Count()) {
            If (This.keys[index] == key) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function KnownType(String typeName) -> Bool {
        String catalog = "Color,Brush,Number,String,Boolean,Font,Style,Template,Image,Icon,Dimension,Thickness,Duration,Animation,Data,Theme";
        Int start = 0;
        Int index = 0;
        While (index < catalog.Length()) {
            If (catalog.Substring(index, 1) == ",") {
                If (catalog.Substring(start, index - start) == typeName) {
                    Return True;
                }
                start = index + 1;
            }
            index = index + 1;
        }
        Return catalog.Substring(start, catalog.Length() - start) == typeName;
    }

    Private Function Valid(String typeName, String value) -> Bool {
        If (value.Length() > 0 && value.Substring(0, 1) == "@") {
            Return True;
        }
        If (typeName == "String" || typeName == "Font" || typeName == "Style" || typeName == "Template" || typeName == "Image" || typeName == "Icon" || typeName == "Animation" || typeName == "Data" || typeName == "Theme") {
            Return True;
        }
        If (typeName == "Number") {
            Return This.IsNumber(value);
        }
        If (typeName == "Boolean") {
            Return value == "true" || value == "false" || value == "True" || value == "False";
        }
        If (typeName == "Color") {
            Return This.IsColor(value);
        }
        If (typeName == "Brush") {
            Return value == "None" || This.IsColor(value);
        }
        If (typeName == "Dimension") {
            Return This.IsDimension(value);
        }
        If (typeName == "Thickness") {
            Return This.IsThickness(value);
        }
        If (typeName == "Duration") {
            Return This.IsDuration(value);
        }
        Return False;
    }

    Private Function IsNumber(String value) -> Bool {
        Int index = 0;
        If (value.Length() > 0 && value.Substring(0, 1) == "-") {
            index = 1;
        }
        If (index >= value.Length()) {
            Return False;
        }
        While (index < value.Length()) {
            String character = value.Substring(index, 1);
            If (character < "0" || character > "9") {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function IsColor(String value) -> Bool {
        If (value == "Black" || value == "White" || value == "Transparent") {
            Return True;
        }
        If (value.Length() < 4 || value.Substring(0, 1) != "#") {
            Return False;
        }
        Int length = value.Length() - 1;
        If (length != 3 && length != 4 && length != 6 && length != 8) {
            Return False;
        }
        Int index = 1;
        While (index < value.Length()) {
            String character = value.Substring(index, 1);
            Bool digit = character >= "0" && character <= "9";
            Bool lower = character >= "a" && character <= "f";
            Bool upper = character >= "A" && character <= "F";
            If (!digit && !lower && !upper) {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function IsDimension(String value) -> Bool {
        If (value == "Auto" || value == "*") {
            Return True;
        }
        If (value.EndsWith("px")) {
            Return This.IsNumber(value.Substring(0, value.Length() - 2));
        }
        If (value.EndsWith("*")) {
            Return This.IsNumber(value.Substring(0, value.Length() - 1));
        }
        Return This.IsNumber(value);
    }

    Private Function IsThickness(String value) -> Bool {
        Int parts = 1;
        Int index = 0;
        String current = "";
        While (index < value.Length()) {
            String character = value.Substring(index, 1);
            If (character == ",") {
                If (!This.IsNumber(current)) {
                    Return False;
                }
                current = "";
                parts = parts + 1;
            } Else {
                current = current + character;
            }
            index = index + 1;
        }
        Return This.IsNumber(current) && (parts == 1 || parts == 2 || parts == 4);
    }

    Private Function IsDuration(String value) -> Bool {
        If (value.EndsWith("ms")) {
            Return This.IsNumber(value.Substring(0, value.Length() - 2));
        }
        If (value.EndsWith("s")) {
            Return This.IsNumber(value.Substring(0, value.Length() - 1));
        }
        Return False;
    }
}

Public Class StyleSheet {
    Public RxuMessages Messages;
    Private List<String> names;
    Private List<String> states;
    Private List<String> properties;
    Private List<String> values;

    Public Constructor() {
        This.Messages = RxuMessages();
        This.names = List<String>();
        This.states = List<String>();
        This.properties = List<String>();
        This.values = List<String>();
    }

    Public Function AddSetter(String name, String state, String property, String value) -> Bool
    Explain {
        Description: "Add one style setter.";
        Input: name = "Style name", state = "Empty, Hover, Pressed, Disabled, or Focused", property = "Property name", value = "Property value";
        Processing: "Keep the setter when the state is known.";
        Output: "True when the setter is stored.";
    } {
        If (!This.KnownState(state)) {
            This.Messages.Add("RXU025", "This style state is unknown.", "", 1, 1, state.Length(), "Hover, Pressed, Disabled, or Focused", state, "Use one of the known states.");
            Return False;
        }
        This.names.Add(name + "");
        This.states.Add(state + "");
        This.properties.Add(property + "");
        This.values.Add(value + "");
        Return True;
    }

    Public Function SetterCount() -> Int
    Explain {
        Description: "Count the stored setters.";
        Input: None;
        Processing: "Read the setter list size.";
        Output: "The number of setters.";
    } {
        Return This.names.Count();
    }

    Public Function Load(RxuNode node) -> Int
    Explain {
        Description: "Load Style and Setter markup.";
        Input: node = "Style element";
        Processing: "Read each Setter, including its State.";
        Output: "The number of rejected setters.";
    } {
        Int failed = 0;
        String name = node.FindAttribute("Name").Text;
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuNode child = node.Children[index];
            If (child.Kind == "Element" && child.Name == "Setter") {
                If (!This.AddSetter(name, child.FindAttribute("State").Text, child.FindAttribute("Property").Text, child.FindAttribute("Value").Text)) {
                    failed = failed + 1;
                }
            }
            index = index + 1;
        }
        Return failed;
    }

    Public Function Apply(UIElement element, String name, String state) -> Int
    Explain {
        Description: "Apply one style class and state to an element.";
        Input: element = "Target element", name = "Style name", state = "Current state";
        Processing: "Clear the style's properties, then apply the state setter or the base setter.";
        Output: "The number of setters applied.";
    } {
        Int index = 0;
        While (index < This.names.Count()) {
            If (This.names[index] == name) {
                element.ClearStyle(This.properties[index]);
            }
            index = index + 1;
        }
        Int applied = 0;
        index = 0;
        While (index < This.names.Count()) {
            If (This.Wins(name, state, index)) {
                If (element.SetStyle(This.properties[index], This.values[index])) {
                    applied = applied + 1;
                }
            }
            index = index + 1;
        }
        Return applied;
    }

    Private Function Wins(String name, String state, Int index) -> Bool {
        If (This.names[index] != name) {
            Return False;
        }
        If (This.states[index] == state) {
            Return True;
        }
        If (This.states[index] != "") {
            Return False;
        }
        Int cursor = 0;
        While (cursor < This.names.Count()) {
            If (This.names[cursor] == name && This.properties[cursor] == This.properties[index] && This.states[cursor] == state) {
                Return False;
            }
            cursor = cursor + 1;
        }
        Return True;
    }

    Private Function KnownState(String state) -> Bool {
        Return state == "" || state == "Hover" || state == "Pressed" || state == "Disabled" || state == "Focused";
    }
}

Public Class ResourceLibrary {
    Public ResourceTable Document;
    Public ResourceTable Application;
    Public ResourceTable Builtins;
    Public StyleSheet Styles;
    Public RxuMessages Messages;
    Private List<String> themeNames;
    Private List<String> themeKeys;
    Private List<String> themeTypes;
    Private List<String> themeValues;
    Private List<UIElement> targets;
    Private List<String> targetProperties;
    Private List<String> targetKeys;
    Private List<String> targetFallbacks;
    Private List<String> templateNames;
    Private List<String> templateRoots;

    Public Constructor() {
        This.Document = ResourceTable();
        This.Application = ResourceTable();
        This.Builtins = ResourceTable();
        This.Styles = StyleSheet();
        This.Messages = RxuMessages();
        This.themeNames = List<String>();
        This.themeKeys = List<String>();
        This.themeTypes = List<String>();
        This.themeValues = List<String>();
        This.targets = List<UIElement>();
        This.targetProperties = List<String>();
        This.targetKeys = List<String>();
        This.targetFallbacks = List<String>();
        This.templateNames = List<String>();
        This.templateRoots = List<String>();
        This.Builtins.Set("Color", "Accent", "#336699");
        This.Builtins.Set("Number", "Spacing", "8");
        This.Builtins.Set("String", "FontFamily", "Roboto");
        This.Builtins.Set("Boolean", "Enabled", "true");
        This.Builtins.Set("Font", "Body", "Roboto");
        This.Builtins.Set("Dimension", "IconSize", "16");
        This.Builtins.Set("Thickness", "Pad", "4");
        This.Builtins.Set("Duration", "Fast", "120ms");
        This.Builtins.Set("Brush", "Canvas", "None");
        This.Builtins.Set("Image", "Mark", "arm.png");
        This.Builtins.Set("Icon", "Save", "save");
        This.Builtins.Set("Style", "Base", "Primary");
        This.Builtins.Set("Template", "Button", "ArmButton");
        This.Builtins.Set("Animation", "Fade", "fade");
        This.Builtins.Set("Data", "Empty", "{}");
        This.Builtins.Set("Theme", "Light", "Light");
    }

    Public Function Resolve(ResourceTable component, ResourceTable ancestor, String key, String fallback) -> String
    Explain {
        Description: "Find a resource through the scope chain.";
        Input: component = "Nearest table", ancestor = "Ancestor table", key = "Resource name", fallback = "Value used when the key is missing";
        Processing: "Search the component, ancestor, document, application, and built-in tables. Follow @ aliases.";
        Output: "The resolved value, or the fallback.";
    } {
        String current = key + "";
        Var seen = List<String>();
        Int depth = 0;
        While (depth < 8) {
            Int seenIndex = 0;
            While (seenIndex < seen.Count()) {
                If (seen[seenIndex] == current) {
                    This.Messages.Add("RXU022", "This resource alias is cyclic.", "", 1, 1, current.Length(), "an acyclic alias", current, "Break the alias cycle.");
                    Return fallback + "";
                }
                seenIndex = seenIndex + 1;
            }
            seen.Add(current);
            String value = This.FindRaw(component, ancestor, current);
            If (value == "") {
                This.Messages.Add("RXU024", "This resource was not found.", "", 1, 1, current.Length(), "a defined resource", current, "Define the resource or use the fallback.");
                Return fallback + "";
            }
            If (value.Length() > 0 && value.Substring(0, 1) == "@") {
                current = value.Substring(1, value.Length() - 1);
            } Else {
                Return value;
            }
            depth = depth + 1;
        }
        This.Messages.Add("RXU022", "This resource alias is cyclic.", "", 1, 1, key.Length(), "an acyclic alias", key, "Break the alias cycle.");
        Return fallback + "";
    }

    Public Function Bind(UIElement element, String property, String key, String fallback) -> Bool
    Explain {
        Description: "Apply a resource to a property and remember it.";
        Input: element = "Target element", property = "Property name", key = "Resource name", fallback = "Fallback value";
        Processing: "Resolve the key and set the property. A later refresh uses the same key.";
        Output: "True when the property accepts the value.";
    } {
        String value = This.Resolve(ResourceTable(), ResourceTable(), key, fallback);
        Bool applied = element.SetAttribute(property, value);
        This.targets.Add(element);
        This.targetProperties.Add(property + "");
        This.targetKeys.Add(key + "");
        This.targetFallbacks.Add(fallback + "");
        Return applied;
    }

    Public Function RefreshBindings() -> Int
    Explain {
        Description: "Reapply every resource binding.";
        Input: None;
        Processing: "Resolve each remembered key and write the property again.";
        Output: "The number of bindings refreshed.";
    } {
        Int count = 0;
        Int index = 0;
        While (index < This.targets.Count()) {
            String value = This.Resolve(ResourceTable(), ResourceTable(), This.targetKeys[index], This.targetFallbacks[index]);
            If (This.targets[index].SetAttribute(This.targetProperties[index], value)) {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Public Function AddTheme(RxuNode node) -> Int
    Explain {
        Description: "Record a theme's resources.";
        Input: node = "Theme element";
        Processing: "Store each typed child under the theme name.";
        Output: "The number of rejected theme resources.";
    } {
        Int failed = 0;
        String name = node.FindAttribute("Name").Text + "";
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuNode child = node.Children[index];
            If (child.Kind == "Element") {
                String typeName = child.Name;
                String key = child.FindAttribute("Name").Text;
                String value = child.FindAttribute("Value").Text;
                ResourceTable check = ResourceTable();
                If (check.Set(typeName, key, value)) {
                    This.themeNames.Add(name);
                    This.themeKeys.Add(key + "");
                    This.themeTypes.Add(typeName + "");
                    This.themeValues.Add(value + "");
                } Else {
                    failed = failed + 1;
                }
            }
            index = index + 1;
        }
        Return failed;
    }

    Public Function SwitchTheme(String name) -> Bool
    Explain {
        Description: "Replace application resources with one theme.";
        Input: name = "Theme name";
        Processing: "Write that theme into the application table and refresh bindings. Elements are not copied.";
        Output: "True when the theme has at least one resource.";
    } {
        Int found = 0;
        Int index = 0;
        While (index < This.themeNames.Count()) {
            If (This.themeNames[index] == name) {
                If (This.Application.Has(This.themeKeys[index])) {
                    This.Application.Remove(This.themeKeys[index]);
                }
                This.Application.Set(This.themeTypes[index], This.themeKeys[index], This.themeValues[index]);
                found = found + 1;
            }
            index = index + 1;
        }
        This.RefreshBindings();
        Return found > 0;
    }

    Public Function LoadTemplate(RxuNode node) -> Bool
    Explain {
        Description: "Record a template visual without changing control behavior.";
        Input: node = "Template element";
        Processing: "Remember the template name and its first visual element.";
        Output: "True when the template has a visual root.";
    } {
        String name = node.FindAttribute("Name").Text + "";
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuNode child = node.Children[index];
            If (child.Kind == "Element") {
                This.templateNames.Add(name);
                This.templateRoots.Add(child.Name + "");
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Public Function ApplyTemplate(UIElement element, String name) -> Bool
    Explain {
        Description: "Attach a template visual to an element.";
        Input: element = "Target element", name = "Template name";
        Processing: "Set the visual root and keep the element's kind.";
        Output: "True when the template exists.";
    } {
        Int index = 0;
        While (index < This.templateNames.Count()) {
            If (This.templateNames[index] == name) {
                element.TemplateName = name + "";
                element.VisualKind = This.templateRoots[index] + "";
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function FindRaw(ResourceTable component, ResourceTable ancestor, String key) -> String {
        If (component.Has(key)) {
            Return component.Get(key);
        }
        If (ancestor.Has(key)) {
            Return ancestor.Get(key);
        }
        If (This.Document.Has(key)) {
            Return This.Document.Get(key);
        }
        If (This.Application.Has(key)) {
            Return This.Application.Get(key);
        }
        If (This.Builtins.Has(key)) {
            Return This.Builtins.Get(key);
        }
        Return "";
    }
}

Public Class RxuBuild {
    Public RxuMessages Messages;
    Private List<String> includes;
    Private List<String> assets;
    Private List<String> handlers;
    Private List<String> capabilities;
    Private List<String> loaded;
    Private List<String> stack;
    Private List<String> componentNames;
    Private List<String> resourceKeys;
    Private List<String> idNames;
    Private Int runtimeChecks;

    Public Constructor() {
        This.Messages = RxuMessages();
        This.includes = List<String>();
        This.assets = List<String>();
        This.handlers = List<String>();
        This.capabilities = List<String>();
        This.loaded = List<String>();
        This.stack = List<String>();
        This.componentNames = List<String>();
        This.resourceKeys = List<String>();
        This.idNames = List<String>();
        This.runtimeChecks = 0;
        This.resourceKeys.Add("Accent");
        This.resourceKeys.Add("Spacing");
        This.resourceKeys.Add("FontFamily");
        This.resourceKeys.Add("Enabled");
        This.resourceKeys.Add("Body");
        This.resourceKeys.Add("IconSize");
        This.resourceKeys.Add("Pad");
        This.resourceKeys.Add("Fast");
        This.resourceKeys.Add("Canvas");
        This.resourceKeys.Add("Mark");
        This.resourceKeys.Add("Save");
        This.resourceKeys.Add("Base");
        This.resourceKeys.Add("Button");
        This.resourceKeys.Add("Fade");
        This.resourceKeys.Add("Empty");
        This.resourceKeys.Add("Light");
    }

    Public Function AddInclude(String path) -> Void
    Explain {
        Description: "Add one project RXU file.";
        Input: path = "Path listed by the project";
        Processing: "Store the path when it is new.";
        Output: "No return value.";
    } {
        If (!This.BuildHas(This.includes, path)) {
            This.includes.Add(path + "");
        }
    }

    Public Function AddAsset(String path) -> Void
    Explain {
        Description: "Add one packaged asset name.";
        Input: path = "Asset path or file name";
        Processing: "Store the name when it is new.";
        Output: "No return value.";
    } {
        If (!This.BuildHas(This.assets, path)) {
            This.assets.Add(path + "");
        }
    }

    Public Function AddHandler(String name) -> Void
    Explain {
        Description: "Add one RX event handler the project defines.";
        Input: name = "Handler name";
        Processing: "Store the name when it is new.";
        Output: "No return value.";
    } {
        If (!This.BuildHas(This.handlers, name)) {
            This.handlers.Add(name + "");
        }
    }

    Public Function AddCapability(String name) -> Void
    Explain {
        Description: "Add one backend capability.";
        Input: name = "Element kind the backend can host";
        Processing: "Store the capability when it is new.";
        Output: "No return value.";
    } {
        If (!This.BuildHas(This.capabilities, name)) {
            This.capabilities.Add(name + "");
        }
    }

    Public Function LoadGraph() -> Int
    Explain {
        Description: "Load every project file and check the reachable markup.";
        Input: None;
        Processing: "Resolve imports, then check components, properties, resources, handlers, assets, and capabilities.";
        Output: "The number of build diagnostics.";
    } {
        Int index = 0;
        While (index < This.includes.Count()) {
            This.BuildLoad(This.includes[index], This.includes[index], 1, 1, This.includes[index].Length());
            index = index + 1;
        }
        Return This.Messages.Count();
    }

    Public Function ReadProject(String path) -> Int
    Explain {
        Description: "Read RXU assets from a project file and check them.";
        Input: path = "Project file path";
        Processing: "Read Include, Asset, Handler, and Capability entries, then load the graph.";
        Output: "The number of build diagnostics.";
    } {
        If (!Files.Exists(path)) {
            This.BuildNote("RXU017", "This project file was not found.", path, 1, 1, path.Length(), "a project file", path, "Create the project or correct the path.");
            Return This.Messages.Count();
        }
        String text = Files.ReadText(path);
        String directory = This.BuildDirectory(path);
        String line = "";
        Int index = 0;
        While (index < text.Length()) {
            String character = text.Substring(index, 1);
            If (character == "\n") {
                This.BuildLine(line, directory);
                line = "";
            } Else {
                line = line + character;
            }
            index = index + 1;
        }
        This.BuildLine(line, directory);
        Return This.LoadGraph();
    }

    Public Function PackageReady() -> Bool
    Explain {
        Description: "Report whether the project can be packaged.";
        Input: None;
        Processing: "A package requires an empty diagnostic list.";
        Output: "True when the build found no errors.";
    } {
        Return This.Messages.Count() == 0;
    }

    Public Function RuntimeCount() -> Int
    Explain {
        Description: "Count values that must be checked again at runtime.";
        Input: None;
        Processing: "Count bindings, expressions, and localization values.";
        Output: "The number of deferred checks.";
    } {
        Return This.runtimeChecks;
    }

    Private Function BuildLoad(String path, String fromFile, Int line, Int column, Int length) -> Void {
        If (This.BuildHas(This.stack, path)) {
            This.BuildNote("RXU026", "This import is circular.", fromFile, line, column, length, "an acyclic import", path, "Remove the import cycle.");
            Return;
        }
        If (This.BuildHas(This.loaded, path)) {
            Return;
        }
        If (!Files.Exists(path)) {
            This.BuildNote("RXU027", "This imported file was not found.", fromFile, line, column, length, "an RXU file", path, "Create the file or correct the path.");
            Return;
        }
        If (!This.BuildHas(This.includes, path)) {
            This.BuildNote("RXU038", "This file is not a project asset.", fromFile, line, column, length, "a project include", path, "Add the file to the project.");
            Return;
        }
        RxuParser parser = RxuParser();
        RxuNode document = parser.Parse(path, Files.ReadText(path));
        This.loaded.Add(path + "");
        This.BuildCopy(document.Messages);
        If (document.Messages.Count() != 0) {
            Return;
        }
        This.stack.Add(path + "");
        This.BuildCollect(document, path);
        This.BuildPop();
        This.idNames = List<String>();
        This.BuildVerify(document, "", path);
    }

    Private Function BuildCollect(RxuNode node, String file) -> Void {
        If (node.Kind == "Element") {
            If (node.Name == "Component") {
                String componentName = node.FindAttribute("Name").Text;
                If (componentName == "") {
                    This.BuildNote("RXU036", "A component needs a name.", file, node.Line, node.Column, node.Length, "a component name", "empty", "Set the Name attribute.");
                } Else {
                    If (This.BuildHas(This.componentNames, componentName)) {
                        This.BuildNote("RXU036", "This component name is already defined.", file, node.Line, node.Column, node.Length, "one component", componentName, "Rename one component.");
                    } Else {
                        This.componentNames.Add(componentName + "");
                    }
                }
            }
            If (node.Name == "Import" || node.Name == "Include") {
                String source = node.FindAttribute("Source").Text;
                If (source == "") {
                    This.BuildNote("RXU027", "This imported file was not found.", file, node.Line, node.Column, node.Length, "an RXU file", "empty", "Set the Source attribute.");
                } Else {
                    String full = This.BuildResolve(This.BuildDirectory(file), source);
                    This.BuildLoad(full, file, node.Line, node.Column, node.Length);
                }
            }
            If (node.Name == "Resources" || node.Name == "Theme") {
                Int child = 0;
                While (child < node.Children.Count()) {
                    RxuNode item = node.Children[child];
                    If (item.Kind == "Element") {
                        String key = item.FindAttribute("Name").Text;
                        If (key != "") {
                            This.resourceKeys.Add(key + "");
                        }
                    }
                    child = child + 1;
                }
            }
        }
        Int index = 0;
        While (index < node.Children.Count()) {
            This.BuildCollect(node.Children[index], file);
            index = index + 1;
        }
    }

    Private Function BuildVerify(RxuNode node, String parent, String file) -> Void {
        If (node.Kind != "Element") {
            Int nested = 0;
            While (nested < node.Children.Count()) {
                This.BuildVerify(node.Children[nested], parent, file);
                nested = nested + 1;
            }
            Return;
        }
        String element = node.Name;
        String builtins = "Window,Panel,Button,Control,FrameworkElement,UIElement,Text,Label,Border,Image,Icon,Resources,Color,Brush,Number,String,Boolean,Font,Style,Template,Setter,Theme,Data,Animation,Dimension,Thickness,Duration,Component,Import,Include,If,Else,ElseIf,Each,For,ForEach,Choose,Switch,When,Default,Otherwise,Let,Set,Bind,Content,Dialog,Menu,Canvas";
        If (!This.BuildKnown(builtins, element) && !This.BuildHas(This.componentNames, element)) {
            This.BuildNote("RXU028", "This component is not defined.", file, node.Line, node.Column, node.Length, "a known element or component", element, "Define the component or use a known element.");
        }
        If (This.BuildKnown("Window,Panel,Button,Control,FrameworkElement,UIElement,Label,Text,Border,Image,Dialog,Menu,Canvas", element) && !This.BuildHas(This.capabilities, element)) {
            This.BuildNote("RXU034", "This backend cannot host this element.", file, node.Line, node.Column, node.Length, "a supported capability", element, "Use an element the backend supports.");
        }
        If (element == "Window" && parent != "") {
            This.BuildNote("RXU029", "A window cannot be nested.", file, node.Line, node.Column, node.Length, "a top-level window", parent, "Move the window to the top of the document.");
        }
        If (element == "Setter" && parent != "Style") {
            This.BuildNote("RXU029", "A setter must belong to a style.", file, node.Line, node.Column, node.Length, "Style", parent, "Place the setter inside a Style.");
        }
        If (This.BuildKnown("Color,Brush,Number,String,Boolean,Font,Dimension,Thickness,Duration,Animation,Data", element) && parent != "Resources" && parent != "Theme") {
            This.BuildNote("RXU029", "This resource must belong to a resource table.", file, node.Line, node.Column, node.Length, "Resources or Theme", parent, "Move it inside Resources or Theme.");
        }
        String userId = node.FindAttribute("Id").Text;
        If (userId != "") {
            If (This.BuildHas(This.idNames, userId)) {
                This.BuildNote("RXU016", "This Id is already used in the document.", file, node.Line, node.Column, node.Length, "a unique Id", userId, "Give this element a different Id.");
            } Else {
                This.idNames.Add(userId + "");
            }
        }
        Bool visual = This.BuildKnown("Window,Panel,Button,Control,FrameworkElement,UIElement,Label,Text,Border,Image", element);
        UIElement probe = UIElement();
        probe.Kind = This.BuildProbeKind(element);
        Int attribute = 0;
        While (attribute < node.Attributes.Count()) {
            RxuNode item = node.Attributes[attribute];
            Bool deferred = item.Mode == "Binding" || item.Mode == "Expression" || item.Mode == "Localization";
            If (item.Name.StartsWith("On") && item.Name.Length() > 2) {
                If (deferred) {
                    This.runtimeChecks = This.runtimeChecks + 1;
                } Else {
                    If (!This.BuildHas(This.handlers, item.Text)) {
                        This.BuildNote("RXU032", "This event handler is not defined.", file, item.Line, item.Column, item.Length, "a project handler", item.Text, "Define the handler or correct its name.");
                    }
                }
            } Else {
                If (!This.BuildSkip(element, item.Name)) {
                    If (item.Mode == "Resource") {
                        If (visual && !probe.Accepts(item.Name)) {
                            This.BuildNote("RXU031", "This binding target is not a property of the element.", file, item.Line, item.Column, item.Length, "a property of " + element, item.Name, "Bind a property this element allows.");
                        }
                        If (!This.BuildHas(This.resourceKeys, item.Text)) {
                            This.BuildNote("RXU030", "This resource was not found in the project.", file, item.Line, item.Column, item.Length, "a defined resource", item.Text, "Define the resource or use a built-in key.");
                        }
                    } Else {
                        If (deferred) {
                            If (visual && !probe.Accepts(item.Name)) {
                                This.BuildNote("RXU031", "This binding target is not a property of the element.", file, item.Line, item.Column, item.Length, "a property of " + element, item.Name, "Bind a property this element allows.");
                            } Else {
                                This.runtimeChecks = This.runtimeChecks + 1;
                            }
                        } Else {
                            If (visual) {
                                Int before = probe.Messages.Count();
                                probe.SetAttribute(item.Name, item.Text);
                                Int after = before;
                                While (after < probe.Messages.Count()) {
                                    RxuDiagnostic diagnostic = probe.Messages.At(after);
                                    This.BuildNote(diagnostic.Code, diagnostic.Message, file, item.Line, item.Column, item.Length, diagnostic.Expected, diagnostic.Actual, diagnostic.Correction);
                                    after = after + 1;
                                }
                            } Else {
                                If (This.BuildKnown(builtins, element)) {
                                    This.BuildNote("RXU019", "This property is unknown.", file, item.Line, item.Column, item.Length, "a known property", item.Name, "Remove the attribute or move it to an element that allows it.");
                                }
                            }
                        }
                    }
                }
            }
            If ((item.Name == "Image" || item.Name == "Icon") && !deferred && item.Mode != "Resource") {
                String assetPath = This.BuildResolve(This.BuildDirectory(file), item.Text);
                If (!This.BuildHas(This.assets, item.Text) || (!Files.Exists(assetPath) && !Files.Exists(item.Text))) {
                    This.BuildNote("RXU033", "This asset is not in the project.", file, item.Line, item.Column, item.Length, "a packaged asset", item.Text, "Add the file to the project assets.");
                }
            }
            attribute = attribute + 1;
        }
        Int child = 0;
        While (child < node.Children.Count()) {
            This.BuildVerify(node.Children[child], element, file);
            child = child + 1;
        }
    }

    Private Function BuildLine(String line, String directory) -> Void {
        String value = This.BuildQuoted(line);
        If (value == "") {
            Return;
        }
        If (line.Contains("Include:")) {
            This.AddInclude(This.BuildResolve(directory, value));
        }
        If (line.Contains("Asset:")) {
            This.AddAsset(value);
            This.AddAsset(This.BuildResolve(directory, value));
        }
        If (line.Contains("Handler:")) {
            This.AddHandler(value);
        }
        If (line.Contains("Capability:")) {
            This.AddCapability(value);
        }
    }

    Private Function BuildQuoted(String line) -> String {
        Int start = -1;
        Int index = 0;
        While (index < line.Length()) {
            If (line.Substring(index, 1) == "\"") {
                If (start < 0) {
                    start = index + 1;
                } Else {
                    Return line.Substring(start, index - start);
                }
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function BuildResolve(String directory, String source) -> String {
        If (directory == "" || source.StartsWith("/")) {
            Return source;
        }
        Return directory + "/" + source;
    }

    Private Function BuildDirectory(String path) -> String {
        Int last = -1;
        Int index = 0;
        While (index < path.Length()) {
            If (path.Substring(index, 1) == "/") {
                last = index;
            }
            index = index + 1;
        }
        If (last < 0) {
            Return "";
        }
        Return path.Substring(0, last);
    }

    Private Function BuildHas(List<String> items, String name) -> Bool {
        Int index = 0;
        While (index < items.Count()) {
            If (items[index] == name) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function BuildKnown(String catalog, String name) -> Bool {
        Return ("," + catalog + ",").Contains("," + name + ",");
    }

    Private Function BuildProbeKind(String element) -> String {
        If (element == "Window" || element == "Panel" || element == "FrameworkElement" || element == "Control" || element == "UIElement") {
            Return element;
        }
        Return "Button";
    }

    Private Function BuildSkip(String element, String attribute) -> Bool {
        If (attribute == "Name" || attribute == "Id") {
            Return True;
        }
        If ((element == "Import" || element == "Include") && attribute == "Source") {
            Return True;
        }
        If ((element == "Each" || element == "For" || element == "ForEach") && (attribute == "Items" || attribute == "As")) {
            Return True;
        }
        If (element == "Setter" && (attribute == "State" || attribute == "Property" || attribute == "Value")) {
            Return True;
        }
        If (element == "When" && attribute == "Value") {
            Return True;
        }
        If ((element == "Let" || element == "Set") && attribute == "Value") {
            Return True;
        }
        If (element == "Bind" && (attribute == "Target" || attribute == "Source")) {
            Return True;
        }
        If (This.BuildKnown("Color,Brush,Number,String,Boolean,Font,Style,Template,Image,Icon,Dimension,Thickness,Duration,Animation,Data,Theme", element) && (attribute == "Name" || attribute == "Value")) {
            Return True;
        }
        Return False;
    }

    Private Function BuildCopy(RxuMessages source) -> Void {
        Int index = 0;
        While (index < source.Count()) {
            RxuDiagnostic item = source.At(index);
            This.BuildNote(item.Code, item.Message, item.Filename, item.Line, item.Column, item.Length, item.Expected, item.Actual, item.Correction);
            index = index + 1;
        }
    }

    Private Function BuildPop() -> Void {
        List<String> next = List<String>();
        Int index = 0;
        While (index < This.stack.Count() - 1) {
            next.Add(This.stack[index]);
            index = index + 1;
        }
        This.stack = next;
    }

    Private Function BuildNote(
        String code,
        String message,
        String filename,
        Int line,
        Int column,
        Int length,
        String expected,
        String actual,
        String correction
    ) -> Void {
        This.Messages.Add(code, message, filename, line, column, length, expected, actual, correction);
    }
}

Public Class Observable {
    Public String Key;
    Public String Value;
    Public Bool Secret;

    Public Constructor() {
        This.Key = "";
        This.Value = "";
        This.Secret = False;
    }
}

Public Class ObservableList {
    Public String Key;
    Public List<String> Items;

    Public Constructor() {
        This.Key = "";
        This.Items = List<String>();
    }
}

Public Class Binding {
    Public String Mode;
    Public UIElement Target;
    Public String Property;
    Public String Expression;
    Public String Converter;
    Public Bool Invert;
    Public String Fallback;
    Public String Trigger;
    Public String Context;
    Public String Source;
    Public Bool Secret;
    Public Bool Active;
    Public Bool Once;
    Public List<String> Dependencies;
    Public String Applied;

    Public Constructor() {
        This.Mode = "OneWay";
        This.Target = UIElement();
        This.Property = "";
        This.Expression = "";
        This.Converter = "";
        This.Invert = False;
        This.Fallback = "";
        This.Trigger = "Change";
        This.Context = "";
        This.Source = "";
        This.Secret = False;
        This.Active = True;
        This.Once = False;
        This.Dependencies = List<String>();
        This.Applied = "";
    }
}

Public Class RxuExpression {
    Public RxuMessages Messages;
    Public String TypeName;
    Public String Value;
    Private String text;
    Private Int cursor;
    Private Bool failed;
    Private BindingEngine scope;
    Private String context;
    Private List<String> dependencies;

    Public Constructor() {
        This.Messages = RxuMessages();
        This.TypeName = "";
        This.Value = "";
        This.text = "";
        This.cursor = 0;
        This.failed = False;
        This.scope = BindingEngine();
        This.context = "";
        This.dependencies = List<String>();
    }

    Public Function CheckExpression(String source) -> String
    Explain {
        Description: "Type-check one binding expression.";
        Input: source = "Expression text";
        Processing: "Accept paths, comparisons, arithmetic, logic, null checks, conditionals, and approved functions.";
        Output: "The result type, or Error.";
    } {
        This.text = source + "";
        This.cursor = 0;
        This.failed = False;
        This.Messages = RxuMessages();
        This.dependencies = List<String>();
        This.TypeName = This.ExprTernary(False);
        This.ExprSkip();
        If (This.cursor < This.text.Length()) {
            This.ExprFail("RXU044", "This expression has trailing text.", This.text.Substring(This.cursor, This.text.Length() - This.cursor));
            This.TypeName = "Error";
        }
        If (This.failed) {
            Return "Error";
        }
        Return This.TypeName;
    }

    Public Function EvaluateExpression(String source, BindingEngine scope, String context) -> String
    Explain {
        Description: "Evaluate one binding expression.";
        Input: source = "Expression text", scope = "Observable values", context = "Data context key";
        Processing: "Read only the paths the expression uses and reject unknown functions.";
        Output: "The value text, or empty text when the result is null or invalid.";
    } {
        This.text = source + "";
        This.cursor = 0;
        This.failed = False;
        This.Messages = RxuMessages();
        This.dependencies = List<String>();
        This.scope = scope;
        This.context = context + "";
        This.Value = "";
        This.TypeName = This.ExprTernary(True);
        This.ExprSkip();
        If (This.cursor < This.text.Length()) {
            This.ExprFail("RXU044", "This expression has trailing text.", This.text.Substring(This.cursor, This.text.Length() - This.cursor));
        }
        If (This.failed || This.TypeName == "Null" || This.TypeName == "Error") {
            This.Value = "";
            Return "";
        }
        Return This.Value;
    }

    Public Function DependencyCount() -> Int
    Explain {
        Description: "Count the paths read by the last expression.";
        Input: None;
        Processing: "Read the recorded path list.";
        Output: "The number of paths.";
    } {
        Return This.dependencies.Count();
    }

    Public Function DependencyAt(Int index) -> String
    Explain {
        Description: "Read one path used by the last expression.";
        Input: index = "Zero-based path index";
        Processing: "Return that path, or empty text when the index is outside the list.";
        Output: "The path.";
    } {
        If (index < 0 || index >= This.dependencies.Count()) {
            Return "";
        }
        Return This.dependencies[index];
    }

    Private Function ExprTernary(Bool live) -> String {
        String condition = This.ExprOr(live);
        String left = This.Value + "";
        This.ExprSkip();
        If (!This.ExprEat("?")) {
            Return condition;
        }
        String yesType = This.ExprTernary(live);
        String yes = This.Value + "";
        This.ExprSkip();
        If (!This.ExprEat(":")) {
            This.ExprFail("RXU044", "A conditional needs a false branch.", ":");
            Return "Error";
        }
        String noType = This.ExprTernary(live);
        String no = This.Value + "";
        If (condition == "Error" || yesType == "Error" || noType == "Error") {
            Return "Error";
        }
        If (condition != "Boolean") {
            This.ExprFail("RXU044", "A conditional test must be Boolean.", condition);
            Return "Error";
        }
        String chosen = yesType;
        If (yesType != noType) {
            chosen = "String";
        }
        If (live) {
            If (left == "true") {
                This.Value = yes;
            } Else {
                This.Value = no;
            }
        }
        Return chosen;
    }

    Private Function ExprOr(Bool live) -> String {
        String current = This.ExprAnd(live);
        String value = This.Value + "";
        While (!This.failed) {
            This.ExprSkip();
            If (!This.ExprEat("||")) {
                Break;
            }
            String right = This.ExprAnd(live);
            If (current != "Boolean" || right != "Boolean") {
                This.ExprFail("RXU044", "Logic operands must be Boolean.", current);
                Return "Error";
            }
            If (live) {
                If (value == "true" || This.Value == "true") {
                    value = "true";
                } Else {
                    value = "false";
                }
                This.Value = value;
            }
            current = "Boolean";
        }
        This.Value = value;
        Return current;
    }

    Private Function ExprAnd(Bool live) -> String {
        String current = This.ExprCompare(live);
        String value = This.Value + "";
        While (!This.failed) {
            This.ExprSkip();
            If (!This.ExprEat("&&")) {
                Break;
            }
            String right = This.ExprCompare(live);
            If (current != "Boolean" || right != "Boolean") {
                This.ExprFail("RXU044", "Logic operands must be Boolean.", current);
                Return "Error";
            }
            If (live) {
                If (value == "true" && This.Value == "true") {
                    value = "true";
                } Else {
                    value = "false";
                }
                This.Value = value;
            }
            current = "Boolean";
        }
        This.Value = value;
        Return current;
    }

    Private Function ExprCompare(Bool live) -> String {
        String current = This.ExprAdd(live);
        String value = This.Value + "";
        This.ExprSkip();
        String op = This.ExprOperator();
        If (op == "") {
            Return current;
        }
        String right = This.ExprAdd(live);
        String other = This.Value + "";
        If (current == "Error" || right == "Error") {
            Return "Error";
        }
        If (op != "==" && op != "!=" && current == "Null") {
            This.ExprFail("RXU044", "Null can only be compared with == or !=.", op);
            Return "Error";
        }
        If ((op == "<" || op == ">" || op == "<=" || op == ">=") && current != "Number") {
            This.ExprFail("RXU044", "Ordered comparisons need numbers.", current);
            Return "Error";
        }
        If (live) {
            Bool same = value == other;
            Bool less = False;
            If (current == "Number" && right == "Number") {
                less = value.ToInt() < other.ToInt();
                same = value.ToInt() == other.ToInt();
            }
            Bool answer = False;
            If (op == "==") { answer = same; }
            If (op == "!=") { answer = !same; }
            If (op == "<") { answer = less; }
            If (op == ">") { answer = !less && !same; }
            If (op == "<=") { answer = less || same; }
            If (op == ">=") { answer = !less || same; }
            If (answer) {
                This.Value = "true";
            } Else {
                This.Value = "false";
            }
        }
        Return "Boolean";
    }

    Private Function ExprAdd(Bool live) -> String {
        String current = This.ExprMul(live);
        String value = This.Value + "";
        While (!This.failed) {
            This.ExprSkip();
            String op = "";
            If (This.ExprEat("+")) {
                op = "+";
            } Else {
                If (This.ExprEat("-")) {
                    op = "-";
                }
            }
            If (op == "") {
                Break;
            }
            String right = This.ExprMul(live);
            If (current != "Number" || right != "Number") {
                This.ExprFail("RXU044", "Arithmetic operands must be numbers.", current);
                Return "Error";
            }
            If (live) {
                Int number = value.ToInt();
                If (op == "+") {
                    number = number + This.Value.ToInt();
                } Else {
                    number = number - This.Value.ToInt();
                }
                value = number.ToString();
                This.Value = value;
            }
            current = "Number";
        }
        This.Value = value;
        Return current;
    }

    Private Function ExprMul(Bool live) -> String {
        String current = This.ExprUnary(live);
        String value = This.Value + "";
        While (!This.failed) {
            This.ExprSkip();
            String op = "";
            If (This.ExprEat("*")) {
                op = "*";
            } Else {
                If (This.ExprEat("/")) {
                    op = "/";
                }
            }
            If (op == "") {
                Break;
            }
            String right = This.ExprUnary(live);
            If (current != "Number" || right != "Number") {
                This.ExprFail("RXU044", "Arithmetic operands must be numbers.", current);
                Return "Error";
            }
            If (live) {
                Int number = value.ToInt();
                Int divisor = This.Value.ToInt();
                If (op == "*") {
                    number = number * divisor;
                } Else {
                    If (divisor == 0) {
                        This.ExprFail("RXU044", "Division by zero is not allowed.", "0");
                        Return "Error";
                    }
                    number = number / divisor;
                }
                value = number.ToString();
                This.Value = value;
            }
            current = "Number";
        }
        This.Value = value;
        Return current;
    }

    Private Function ExprUnary(Bool live) -> String {
        This.ExprSkip();
        If (This.ExprEat("!")) {
            String inner = This.ExprUnary(live);
            If (inner != "Boolean") {
                This.ExprFail("RXU044", "Not must be applied to a Boolean.", inner);
                Return "Error";
            }
            If (live) {
                If (This.Value == "true") {
                    This.Value = "false";
                } Else {
                    This.Value = "true";
                }
            }
            Return "Boolean";
        }
        If (This.ExprEat("-")) {
            String inner = This.ExprUnary(live);
            If (inner != "Number") {
                This.ExprFail("RXU044", "Negation must be applied to a number.", inner);
                Return "Error";
            }
            If (live) {
                This.Value = (0 - This.Value.ToInt()).ToString();
            }
            Return "Number";
        }
        Return This.ExprPrimary(live);
    }

    Private Function ExprPrimary(Bool live) -> String {
        This.ExprSkip();
        If (This.ExprEat("(")) {
            String inner = This.ExprTernary(live);
            This.ExprSkip();
            If (!This.ExprEat(")")) {
                This.ExprFail("RXU044", "This group is missing ')'.", ")");
                Return "Error";
            }
            Return inner;
        }
        If (This.ExprPeek() == "\"") {
            Return This.ExprText(live);
        }
        If (This.ExprIsDigit(This.ExprPeek())) {
            Return This.ExprNumber(live);
        }
        String word = This.ExprWord();
        If (word == "") {
            This.ExprFail("RXU044", "This expression is missing a value.", "");
            Return "Error";
        }
        If (word == "true" || word == "false") {
            This.Value = word;
            Return "Boolean";
        }
        If (word == "null") {
            This.Value = "";
            Return "Null";
        }
        This.ExprSkip();
        If (This.ExprEat("(")) {
            Return This.ExprCall(word, live);
        }
        Return This.ExprPath(word, live);
    }

    Private Function ExprCall(String name, Bool live) -> String {
        String argument = This.ExprTernary(live);
        String payload = This.Value + "";
        This.ExprSkip();
        If (!This.ExprEat(")")) {
            This.ExprFail("RXU044", "A function call is missing ')'.", ")");
            Return "Error";
        }
        If (name != "Length" && name != "Empty" && name != "Not" && name != "Count" && name != "Lower" && name != "Upper") {
            This.ExprFail("RXU039", "This function is not approved.", name);
            Return "Error";
        }
        If (name == "Not" && argument != "Boolean") {
            This.ExprFail("RXU044", "Not expects a Boolean.", argument);
            Return "Error";
        }
        If ((name == "Length" || name == "Empty" || name == "Lower" || name == "Upper") && argument != "String") {
            This.ExprFail("RXU044", "This function expects text.", argument);
            Return "Error";
        }
        If (name == "Count" && argument != "String") {
            This.ExprFail("RXU044", "Count expects a collection path.", argument);
            Return "Error";
        }
        If (!live) {
            If (name == "Length" || name == "Count") { Return "Number"; }
            If (name == "Empty" || name == "Not") { Return "Boolean"; }
            Return "String";
        }
        If (name == "Length") {
            This.Value = payload.Length().ToString();
            Return "Number";
        }
        If (name == "Empty") {
            If (payload.Length() == 0) { This.Value = "true"; } Else { This.Value = "false"; }
            Return "Boolean";
        }
        If (name == "Not") {
            If (payload == "true") { This.Value = "false"; } Else { This.Value = "true"; }
            Return "Boolean";
        }
        If (name == "Lower") {
            This.Value = This.ExprCase(payload, False);
            Return "String";
        }
        If (name == "Upper") {
            This.Value = This.ExprCase(payload, True);
            Return "String";
        }
        String listName = payload;
        If (This.dependencies.Count() > 0) {
            listName = This.dependencies[This.dependencies.Count() - 1];
        }
        This.Value = This.scope.ItemCount(listName).ToString();
        Return "Number";
    }

    Private Function ExprPath(String head, Bool live) -> String {
        String path = head + "";
        While (True) {
            If (!This.ExprEat(".")) {
                Break;
            }
            String part = This.ExprWord();
            If (part == "" && This.ExprIsDigit(This.ExprPeek())) {
                part = This.ExprDigits();
            }
            If (part == "") {
                This.ExprFail("RXU044", "A path is missing a name.", ".");
                Return "Error";
            }
            path = path + "." + part;
        }
        String full = path;
        If (This.context != "" && !path.Contains(".")) {
            full = This.context + "." + path;
        }
        This.dependencies.Add(full + "");
        If (full.EndsWith(".Count")) {
            If (!live) {
                Return "Number";
            }
            String listName = full.Substring(0, full.Length() - 6);
            This.dependencies.Add(listName + "");
            This.Value = This.scope.ItemCount(listName).ToString();
            Return "Number";
        }
        If (!live) {
            Return "String";
        }
        Int dot = full.Length() - 1;
        While (dot >= 0) {
            If (full.Substring(dot, 1) == ".") {
                Break;
            }
            dot = dot - 1;
        }
        If (dot >= 0) {
            String tail = full.Substring(dot + 1, full.Length() - dot - 1);
            If (This.ExprIsDigit(tail.Substring(0, 1))) {
                String listName = full.Substring(0, dot);
                This.dependencies.Add(listName + "");
                String item = This.scope.ItemAt(listName, tail.ToInt());
                If (item == "") {
                    This.Value = "";
                    Return "Null";
                }
                This.Value = item;
                Return "String";
            }
        }
        If (!This.scope.HasPath(full)) {
            This.Value = "";
            Return "Null";
        }
        This.Value = This.scope.ReadValue(full);
        Return "String";
    }

    Private Function ExprText(Bool live) -> String {
        This.cursor = This.cursor + 1;
        String value = "";
        While (This.cursor < This.text.Length() && This.ExprPeek() != "\"") {
            value = value + This.ExprPeek();
            This.cursor = This.cursor + 1;
        }
        If (!This.ExprEat("\"")) {
            This.ExprFail("RXU044", "This string is not closed.", "\"");
            Return "Error";
        }
        If (live) {
            This.Value = value;
        }
        Return "String";
    }

    Private Function ExprNumber(Bool live) -> String {
        String digits = This.ExprDigits();
        If (live) {
            This.Value = digits;
        }
        Return "Number";
    }

    Private Function ExprDigits() -> String {
        String digits = "";
        While (This.ExprIsDigit(This.ExprPeek())) {
            digits = digits + This.ExprPeek();
            This.cursor = This.cursor + 1;
        }
        Return digits;
    }

    Private Function ExprWord() -> String {
        String word = "";
        String character = This.ExprPeek();
        If (!This.ExprIsLetter(character)) {
            Return "";
        }
        While (This.ExprIsLetter(This.ExprPeek()) || This.ExprIsDigit(This.ExprPeek())) {
            word = word + This.ExprPeek();
            This.cursor = This.cursor + 1;
        }
        Return word;
    }

    Private Function ExprOperator() -> String {
        If (This.ExprEat("==")) { Return "=="; }
        If (This.ExprEat("!=")) { Return "!="; }
        If (This.ExprEat("<=")) { Return "<="; }
        If (This.ExprEat(">=")) { Return ">="; }
        If (This.ExprEat("<")) { Return "<"; }
        If (This.ExprEat(">")) { Return ">"; }
        Return "";
    }

    Private Function ExprCase(String value, Bool upper) -> String {
        String result = "";
        Int index = 0;
        While (index < value.Length()) {
            String character = value.Substring(index, 1);
            If (upper && character >= "a" && character <= "z") {
                If (character == "a") { character = "A"; }
                If (character == "b") { character = "B"; }
                If (character == "c") { character = "C"; }
                If (character == "d") { character = "D"; }
                If (character == "e") { character = "E"; }
                If (character == "f") { character = "F"; }
                If (character == "g") { character = "G"; }
                If (character == "h") { character = "H"; }
                If (character == "i") { character = "I"; }
                If (character == "j") { character = "J"; }
                If (character == "k") { character = "K"; }
                If (character == "l") { character = "L"; }
                If (character == "m") { character = "M"; }
                If (character == "n") { character = "N"; }
                If (character == "o") { character = "O"; }
                If (character == "p") { character = "P"; }
                If (character == "q") { character = "Q"; }
                If (character == "r") { character = "R"; }
                If (character == "s") { character = "S"; }
                If (character == "t") { character = "T"; }
                If (character == "u") { character = "U"; }
                If (character == "v") { character = "V"; }
                If (character == "w") { character = "W"; }
                If (character == "x") { character = "X"; }
                If (character == "y") { character = "Y"; }
                If (character == "z") { character = "Z"; }
            }
            If (!upper && character >= "A" && character <= "Z") {
                If (character == "A") { character = "a"; }
                If (character == "B") { character = "b"; }
                If (character == "C") { character = "c"; }
                If (character == "D") { character = "d"; }
                If (character == "E") { character = "e"; }
                If (character == "F") { character = "f"; }
                If (character == "G") { character = "g"; }
                If (character == "H") { character = "h"; }
                If (character == "I") { character = "i"; }
                If (character == "J") { character = "j"; }
                If (character == "K") { character = "k"; }
                If (character == "L") { character = "l"; }
                If (character == "M") { character = "m"; }
                If (character == "N") { character = "n"; }
                If (character == "O") { character = "o"; }
                If (character == "P") { character = "p"; }
                If (character == "Q") { character = "q"; }
                If (character == "R") { character = "r"; }
                If (character == "S") { character = "s"; }
                If (character == "T") { character = "t"; }
                If (character == "U") { character = "u"; }
                If (character == "V") { character = "v"; }
                If (character == "W") { character = "w"; }
                If (character == "X") { character = "x"; }
                If (character == "Y") { character = "y"; }
                If (character == "Z") { character = "z"; }
            }
            result = result + character;
            index = index + 1;
        }
        Return result;
    }

    Private Function ExprSkip() -> Void {
        While (This.cursor < This.text.Length()) {
            String character = This.ExprPeek();
            If (character != " " && character != "\t") {
                Return;
            }
            This.cursor = This.cursor + 1;
        }
    }

    Private Function ExprPeek() -> String {
        If (This.cursor >= This.text.Length()) {
            Return "";
        }
        Return This.text.Substring(This.cursor, 1);
    }

    Private Function ExprEat(String token) -> Bool {
        This.ExprSkip();
        If (This.cursor + token.Length() > This.text.Length()) {
            Return False;
        }
        If (This.text.Substring(This.cursor, token.Length()) == token) {
            This.cursor = This.cursor + token.Length();
            Return True;
        }
        Return False;
    }

    Private Function ExprIsDigit(String character) -> Bool {
        Return character >= "0" && character <= "9";
    }

    Private Function ExprIsLetter(String character) -> Bool {
        If (character >= "A" && character <= "Z") { Return True; }
        If (character >= "a" && character <= "z") { Return True; }
        Return character == "_";
    }

    Private Function ExprFail(String code, String message, String actual) -> Void {
        This.failed = True;
        This.TypeName = "Error";
        This.Messages.Add(code, message, "", 1, This.cursor + 1, actual.Length(), "a valid expression", actual, "Rewrite the expression with approved operations.");
    }
}

Public Class BindingEngine {
    Public RxuMessages Messages;
    Private List<Observable> values;
    Private List<ObservableList> lists;
    Private List<Binding> bindings;
    Private Int updateDepth;

    Public Constructor() {
        This.Messages = RxuMessages();
        This.values = List<Observable>();
        This.lists = List<ObservableList>();
        This.bindings = List<Binding>();
        This.updateDepth = 0;
    }

    Public Function DefineValue(String key, String value, Bool secret) -> Void
    Explain {
        Description: "Create or replace an observable value.";
        Input: key = "Value path", value = "Initial text", secret = "True when the value must not be logged";
        Processing: "Store the value and notify active bindings.";
        Output: "No return value.";
    } {
        Int index = This.FindValue(key);
        If (index < 0) {
            Observable created = Observable();
            created.Key = key + "";
            created.Value = value + "";
            created.Secret = secret;
            This.values.Add(created);
        } Else {
            This.values[index].Value = value + "";
            This.values[index].Secret = secret;
        }
        This.NotifyWatchers(key);
    }

    Public Function ChangeValue(String key, String value) -> Void
    Explain {
        Description: "Change an observable value and refresh dependent bindings.";
        Input: key = "Value path", value = "New text";
        Processing: "Store a different value and notify watchers. An unchanged value does not refresh.";
        Output: "No return value.";
    } {
        Int index = This.FindValue(key);
        If (index < 0) {
            This.DefineValue(key, value, False);
            Return;
        }
        If (This.values[index].Value == value) {
            Return;
        }
        This.values[index].Value = value + "";
        This.NotifyWatchers(key);
    }

    Public Function ReadValue(String key) -> String
    Explain {
        Description: "Read an observable value.";
        Input: key = "Value path";
        Processing: "Find the stored text.";
        Output: "The value, or empty text when the path is missing.";
    } {
        Int index = This.FindValue(key);
        If (index < 0) {
            Return "";
        }
        Return This.values[index].Value;
    }

    Public Function HasPath(String key) -> Bool
    Explain {
        Description: "Report whether a value or collection exists.";
        Input: key = "Path";
        Processing: "Look through values and collections.";
        Output: "True when the path is defined.";
    } {
        If (This.FindValue(key) >= 0) {
            Return True;
        }
        Return This.FindList(key) >= 0;
    }

    Public Function DefineList(String key) -> Void
    Explain {
        Description: "Create an observable collection.";
        Input: key = "Collection name";
        Processing: "Store an empty collection when it does not already exist.";
        Output: "No return value.";
    } {
        If (This.FindList(key) >= 0) {
            Return;
        }
        ObservableList created = ObservableList();
        created.Key = key + "";
        This.lists.Add(created);
    }

    Public Function AddItem(String key, String value) -> Void
    Explain {
        Description: "Append one collection item.";
        Input: key = "Collection name", value = "Item text";
        Processing: "Add the item and notify bindings that read the collection.";
        Output: "No return value.";
    } {
        Int index = This.FindList(key);
        If (index < 0) {
            This.DefineList(key);
            index = This.FindList(key);
        }
        This.lists[index].Items.Add(value + "");
        This.NotifyWatchers(key);
    }

    Public Function RemoveItem(String key, Int item) -> Void
    Explain {
        Description: "Remove one collection item.";
        Input: key = "Collection name", item = "Zero-based index";
        Processing: "Rebuild the collection without that index and notify bindings.";
        Output: "No return value.";
    } {
        Int index = This.FindList(key);
        If (index < 0 || item < 0 || item >= This.lists[index].Items.Count()) {
            Return;
        }
        List<String> next = List<String>();
        Int cursor = 0;
        While (cursor < This.lists[index].Items.Count()) {
            If (cursor != item) {
                next.Add(This.lists[index].Items[cursor]);
            }
            cursor = cursor + 1;
        }
        This.lists[index].Items = next;
        This.NotifyWatchers(key);
    }

    Public Function MoveItem(String key, Int from, Int to) -> Void
    Explain {
        Description: "Move one collection item.";
        Input: key = "Collection name", from = "Current index", to = "New index";
        Processing: "Reorder the item and notify bindings.";
        Output: "No return value.";
    } {
        Int index = This.FindList(key);
        If (index < 0 || from < 0 || to < 0 || from >= This.lists[index].Items.Count() || to >= This.lists[index].Items.Count()) {
            Return;
        }
        String moving = This.lists[index].Items[from] + "";
        This.RemoveItem(key, from);
        Int target = to;
        List<String> next = List<String>();
        Int cursor = 0;
        While (cursor < This.lists[index].Items.Count()) {
            If (cursor == target) {
                next.Add(moving);
            }
            next.Add(This.lists[index].Items[cursor]);
            cursor = cursor + 1;
        }
        If (target >= This.lists[index].Items.Count()) {
            next.Add(moving);
        }
        This.lists[index].Items = next;
        This.NotifyWatchers(key);
    }

    Public Function ItemAt(String key, Int item) -> String
    Explain {
        Description: "Read one collection item.";
        Input: key = "Collection name", item = "Zero-based index";
        Processing: "Return the item text.";
        Output: "The item, or empty text when it is missing.";
    } {
        Int index = This.FindList(key);
        If (index < 0 || item < 0 || item >= This.lists[index].Items.Count()) {
            Return "";
        }
        Return This.lists[index].Items[item];
    }

    Public Function ItemCount(String key) -> Int
    Explain {
        Description: "Count collection items.";
        Input: key = "Collection name";
        Processing: "Read the collection size.";
        Output: "The number of items, or zero when the collection is missing.";
    } {
        Int index = This.FindList(key);
        If (index < 0) {
            Return 0;
        }
        Return This.lists[index].Items.Count();
    }

    Public Function BindTo(UIElement target, String property, String expression, String mode, String converter, Bool invert, String fallback, String trigger, String context) -> Int
    Explain {
        Description: "Bind an element property to an expression.";
        Input: target = "Element", property = "Property name", expression = "Source expression", mode = "OneWay, TwoWay, OneTime, OneWayToSource, Reactive, or Manual", converter = "Upper, Lower, Not, or empty", invert = "True to flip a Boolean", fallback = "Text used when the source is missing", trigger = "Change, Input, or Explicit", context = "Data context key";
        Processing: "Store the subscription and apply it unless the mode waits for input or an explicit refresh.";
        Output: "The binding index.";
    } {
        Binding created = Binding();
        created.Target = target;
        created.Property = property + "";
        created.Expression = expression + "";
        created.Mode = mode + "";
        created.Converter = converter + "";
        created.Invert = invert;
        created.Fallback = fallback + "";
        created.Trigger = trigger + "";
        created.Context = context + "";
        created.Secret = target.Kind == "PasswordBox" || property == "Password";
        created.Source = This.PlainPath(expression, context);
        created.Active = True;
        This.bindings.Add(created);
        Int index = This.bindings.Count() - 1;
        If (mode != "Manual" && mode != "OneWayToSource" && trigger != "Explicit") {
            This.ApplyBound(index, True);
        }
        Return index;
    }

    Public Function PushInput(Int index, String value) -> Bool
    Explain {
        Description: "Apply a user edit to a bound property.";
        Input: index = "Binding index", value = "Edited text";
        Processing: "Write the property. Two-way and source bindings also write the observable.";
        Output: "True when the property accepts the text.";
    } {
        If (index < 0 || index >= This.bindings.Count()) {
            Return False;
        }
        Binding item = This.bindings[index];
        Bool accepted = item.Target.SetAttribute(item.Property, value);
        If (item.Active && item.Source != "" && (item.Mode == "TwoWay" || item.Mode == "OneWayToSource" || item.Trigger == "Input")) {
            This.ChangeValue(item.Source, This.ConvertBack(item, value));
        }
        Return accepted;
    }

    Public Function RefreshBound(Int index) -> Bool
    Explain {
        Description: "Refresh one binding explicitly.";
        Input: index = "Binding index";
        Processing: "Evaluate the expression again, including manual bindings. Animation still wins over the written local value.";
        Output: "True when the binding was applied.";
    } {
        Return This.ApplyBound(index, True);
    }

    Public Function DisposeBound(Int index) -> Void
    Explain {
        Description: "Unsubscribe one binding.";
        Input: index = "Binding index";
        Processing: "Mark it inactive and drop its dependencies.";
        Output: "No return value.";
    } {
        If (index < 0 || index >= This.bindings.Count()) {
            Return;
        }
        This.bindings[index].Active = False;
        This.bindings[index].Dependencies = List<String>();
    }

    Public Function DisposeAll() -> Void
    Explain {
        Description: "Drop every binding subscription.";
        Input: None;
        Processing: "Deactivate each binding so later changes do not reach disposed documents.";
        Output: "No return value.";
    } {
        Int index = 0;
        While (index < This.bindings.Count()) {
            This.DisposeBound(index);
            index = index + 1;
        }
    }

    Public Function ActiveCount() -> Int
    Explain {
        Description: "Count active subscriptions.";
        Input: None;
        Processing: "Count bindings that have not been disposed.";
        Output: "The number of active bindings.";
    } {
        Int count = 0;
        Int index = 0;
        While (index < This.bindings.Count()) {
            If (This.bindings[index].Active) {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Public Function TraceValue(Int index) -> String
    Explain {
        Description: "Read the last applied binding text for diagnostics.";
        Input: index = "Binding index";
        Processing: "Mask password values.";
        Output: "The applied text, or bullets when the value is secret.";
    } {
        If (index < 0 || index >= This.bindings.Count()) {
            Return "";
        }
        If (This.bindings[index].Secret) {
            Return "••••";
        }
        Return This.bindings[index].Applied;
    }

    Private Function ApplyBound(Int index, Bool forced) -> Bool {
        If (index < 0 || index >= This.bindings.Count()) {
            Return False;
        }
        If (This.updateDepth >= 8) {
            This.Messages.Add("RXU040", "This binding update is cyclic.", "", 1, 1, 1, "an update that settles", "a repeated update", "Break the binding cycle.");
            Return False;
        }
        Binding item = This.bindings[index];
        If (!item.Active && !forced) {
            Return False;
        }
        If (!forced) {
            If (item.Mode == "Manual" || item.Mode == "OneWayToSource" || item.Trigger == "Explicit") {
                Return False;
            }
            If (item.Mode == "OneTime" && item.Once) {
                Return False;
            }
        }
        This.updateDepth = This.updateDepth + 1;
        RxuExpression expression = RxuExpression();
        String raw = expression.EvaluateExpression(item.Expression, This, item.Context);
        item.Dependencies = List<String>();
        Int watch = 0;
        While (watch < expression.DependencyCount()) {
            item.Dependencies.Add(expression.DependencyAt(watch));
            watch = watch + 1;
        }
        String shown = raw;
        If (expression.TypeName == "Null" || expression.TypeName == "Error" || raw == "") {
            shown = item.Fallback;
        } Else {
            shown = This.ConvertText(item, raw);
        }
        item.Applied = shown + "";
        Bool accepted = True;
        If (item.Mode != "OneWayToSource" || forced) {
            If (item.Secret && !item.Target.Accepts(item.Property)) {
                accepted = False;
            } Else {
                accepted = item.Target.SetAttribute(item.Property, shown);
            }
            If (!accepted) {
                This.Messages.Add("RXU041", "This binding value was rejected.", "", 1, 1, 1, "a value the property accepts", This.MaskText(item, shown), "Change the binding or the fallback.");
            }
        }
        If (expression.Messages.Find("RXU039") >= 0 || expression.Messages.Find("RXU044") >= 0) {
            Int diagnostic = 0;
            While (diagnostic < expression.Messages.Count()) {
                RxuDiagnostic found = expression.Messages.At(diagnostic);
                This.Messages.Add(found.Code, found.Message, "", found.Line, found.Column, found.Length, found.Expected, This.MaskText(item, found.Actual), found.Correction);
                diagnostic = diagnostic + 1;
            }
        }
        If (item.Mode == "OneTime") {
            item.Once = True;
            item.Active = False;
        }
        If ((item.Mode == "TwoWay" || item.Mode == "OneWayToSource") && item.Source != "" && accepted) {
            If (This.ReadValue(item.Source) != shown) {
                This.ChangeValue(item.Source, shown);
            }
        }
        This.updateDepth = This.updateDepth - 1;
        Return accepted;
    }

    Private Function NotifyWatchers(String key) -> Void {
        Int index = 0;
        While (index < This.bindings.Count()) {
            If (This.DependsOn(index, key)) {
                This.ApplyBound(index, False);
            }
            index = index + 1;
        }
    }

    Private Function DependsOn(Int index, String key) -> Bool {
        Binding item = This.bindings[index];
        If (!item.Active || item.Mode == "Manual" || item.Mode == "OneWayToSource" || item.Trigger == "Explicit") {
            Return False;
        }
        Int watch = 0;
        While (watch < item.Dependencies.Count()) {
            String used = item.Dependencies[watch];
            If (used == key || used.StartsWith(key + ".") || key.StartsWith(used + ".")) {
                Return True;
            }
            watch = watch + 1;
        }
        Return False;
    }

    Private Function ConvertText(Binding item, String value) -> String {
        String shown = value + "";
        If (item.Converter == "Upper") { shown = This.ChangeCase(shown, True); }
        If (item.Converter == "Lower") { shown = This.ChangeCase(shown, False); }
        If (item.Converter == "Not" || item.Invert) {
            If (shown == "true") { shown = "false"; }
            Else { If (shown == "false") { shown = "true"; } }
        }
        Return shown;
    }

    Private Function ConvertBack(Binding item, String value) -> String {
        String stored = value + "";
        If (item.Converter == "Not" || item.Invert) {
            If (stored == "true") { Return "false"; }
            If (stored == "false") { Return "true"; }
        }
        Return stored;
    }

    Private Function MaskText(Binding item, String value) -> String {
        If (item.Secret) {
            Return "••••";
        }
        Return value;
    }

    Private Function PlainPath(String expression, String context) -> String {
        String text = expression.Trim();
        Int index = 0;
        While (index < text.Length()) {
            String character = text.Substring(index, 1);
            Bool name = (character >= "A" && character <= "Z") || (character >= "a" && character <= "z") || (character >= "0" && character <= "9") || character == "_" || character == ".";
            If (!name) {
                Return "";
            }
            index = index + 1;
        }
        If (context != "" && !text.Contains(".")) {
            Return context + "." + text;
        }
        Return text;
    }

    Private Function FindValue(String key) -> Int {
        Int index = 0;
        While (index < This.values.Count()) {
            If (This.values[index].Key == key) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function FindList(String key) -> Int {
        Int index = 0;
        While (index < This.lists.Count()) {
            If (This.lists[index].Key == key) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function ChangeCase(String value, Bool upper) -> String {
        RxuExpression helper = RxuExpression();
        If (upper) {
            Return helper.EvaluateExpression("Upper(\"" + value + "\")", This, "");
        }
        Return helper.EvaluateExpression("Lower(\"" + value + "\")", This, "");
    }
}

Public Class UIBackend {
    Public RxuMessages Messages;
    Public String Name;
    Private List<String> capabilities;
    Private List<String> log;
    Private List<String> windows;
    Private List<String> components;
    Private List<String> componentWindows;
    Private String clipboard;
    Private Bool running;
    Private Int screens;

    Public Constructor() {
        This.Messages = RxuMessages();
        This.Name = "";
        This.capabilities = List<String>();
        This.log = List<String>();
        This.windows = List<String>();
        This.components = List<String>();
        This.componentWindows = List<String>();
        This.clipboard = "";
        This.running = True;
        This.screens = 1;
        This.UseHost("");
    }

    Public Function UseHost(String host) -> String
    Explain {
        Description: "Select a backend from the host name.";
        Input: host = "linux, windows, macos, or empty for headless";
        Processing: "Choose capabilities in this library. The project does not import a platform.";
        Output: "The selected backend name.";
    } {
        This.capabilities = List<String>();
        This.running = True;
        This.Allow("Window");
        This.Allow("Mouse");
        This.Allow("Keyboard");
        This.Allow("Clipboard");
        This.Allow("Screen");
        This.Allow("Accessibility");
        If (host == "linux" || host == "windows" || host == "macos") {
            This.Allow("Menu");
            This.Allow("Dialog");
            This.Allow("HiDPI");
            This.Allow("FileDialog");
            This.Allow("Graphics");
            This.Allow("Notification");
            This.screens = 2;
        } Else {
            This.screens = 1;
        }
        If (host == "linux" || host == "macos") {
            This.Allow("Touch");
        }
        If (host == "linux") {
            This.Name = "Linux";
        } Else {
            If (host == "windows") {
                This.Name = "Windows";
            } Else {
                If (host == "macos") {
                    This.Name = "Mac";
                } Else {
                    This.Name = "Headless";
                }
            }
        }
        Return This.Name;
    }

    Public Function Supports(String capability) -> Bool
    Explain {
        Description: "Report whether the selected backend supports a capability.";
        Input: capability = "Window, Menu, Dialog, Clipboard, Accessibility, Touch, Mouse, Keyboard, HiDPI, FileDialog, Graphics, Notification, or Screen";
        Processing: "Look through the selected capability list.";
        Output: "True when the capability is available.";
    } {
        Return This.FindId(This.capabilities, capability) >= 0;
    }

    Public Function OpenWindow(String id, String title) -> Bool
    Explain {
        Description: "Open a window through the universal backend.";
        Input: id = "Window id", title = "Window title";
        Processing: "Record the window when the backend is running and can host windows.";
        Output: "True when the window is open.";
    } {
        If (!This.running || !This.Supports("Window")) {
            This.BackendNote("RXU045", "This backend cannot open a window.", "Window");
            Return False;
        }
        If (This.FindId(This.windows, id) < 0) {
            This.windows.Add(id + "");
        }
        This.Remember("OpenWindow " + id + " " + title);
        Return True;
    }

    Public Function CloseWindow(String id) -> Bool
    Explain {
        Description: "Close a window and its components.";
        Input: id = "Window id";
        Processing: "Drop the window and every component that belongs to it.";
        Output: "True when the window existed.";
    } {
        If (This.FindId(This.windows, id) < 0) {
            Return False;
        }
        List<String> nextIds = List<String>();
        Int index = 0;
        While (index < This.windows.Count()) {
            If (This.windows[index] != id) {
                nextIds.Add(This.windows[index]);
            }
            index = index + 1;
        }
        This.windows = nextIds;
        List<String> kept = List<String>();
        List<String> keptWindows = List<String>();
        index = 0;
        While (index < This.components.Count()) {
            If (This.componentWindows[index] != id) {
                kept.Add(This.components[index]);
                keptWindows.Add(This.componentWindows[index]);
            }
            index = index + 1;
        }
        This.components = kept;
        This.componentWindows = keptWindows;
        This.Remember("CloseWindow " + id);
        Return True;
    }

    Public Function OpenComponent(String windowId, String id, String kind) -> Bool
    Explain {
        Description: "Create a universal component inside a window.";
        Input: windowId = "Parent window", id = "Component id", kind = "Universal element kind";
        Processing: "Reject platform widget names. Record a known kind in an open window.";
        Output: "True when the component is created.";
    } {
        If (This.Leaked(kind) || !This.KnownKind(kind)) {
            This.BackendNote("RXU046", "Platform widget types are not part of the public UI API.", kind);
            Return False;
        }
        If (This.FindId(This.windows, windowId) < 0) {
            Return False;
        }
        If (This.FindId(This.components, id) < 0) {
            This.components.Add(id + "");
            This.componentWindows.Add(windowId + "");
        }
        This.Remember("OpenComponent " + windowId + " " + id + " " + kind);
        Return True;
    }

    Public Function CloseComponent(String id) -> Bool
    Explain {
        Description: "Destroy one component.";
        Input: id = "Component id";
        Processing: "Remove it from the live component list.";
        Output: "True when the component existed.";
    } {
        Int found = This.FindId(This.components, id);
        If (found < 0) {
            Return False;
        }
        List<String> kept = List<String>();
        List<String> keptWindows = List<String>();
        Int index = 0;
        While (index < This.components.Count()) {
            If (index != found) {
                kept.Add(This.components[index]);
                keptWindows.Add(This.componentWindows[index]);
            }
            index = index + 1;
        }
        This.components = kept;
        This.componentWindows = keptWindows;
        This.Remember("CloseComponent " + id);
        Return True;
    }

    Public Function SyncProperty(String id, String name, String value) -> Bool
    Explain {
        Description: "Send one property value to the backend.";
        Input: id = "Component id", name = "Property name", value = "Property value";
        Processing: "Record the sync for a live component.";
        Output: "True when the component exists.";
    } {
        If (This.FindId(This.components, id) < 0) {
            Return False;
        }
        This.Remember("Sync " + id + " " + name + " " + value);
        Return True;
    }

    Public Function OfferInput(String kind, String value) -> Bool
    Explain {
        Description: "Deliver one semantic input event.";
        Input: kind = "Pointer, Key, Touch, or Scroll", value = "Event text";
        Processing: "Require the matching pointer, key, or touch capability.";
        Output: "True when the backend accepts the event.";
    } {
        String needed = "Mouse";
        If (kind == "Key") {
            needed = "Keyboard";
        }
        If (kind == "Touch") {
            needed = "Touch";
        }
        If (kind != "Pointer" && kind != "Key" && kind != "Touch" && kind != "Scroll") {
            This.BackendNote("RXU046", "This input is not a universal event.", kind);
            Return False;
        }
        If (!This.Supports(needed)) {
            This.BackendNote("RXU045", "This backend cannot accept this input.", needed);
            Return False;
        }
        This.Remember("Input " + kind + " " + value);
        Return True;
    }

    Public Function MeasureNode(String id) -> String
    Explain {
        Description: "Measure a component.";
        Input: id = "Component id";
        Processing: "Return a width and height for a live component.";
        Output: "The size text, or 0,0 when the component is missing.";
    } {
        If (This.FindId(This.components, id) < 0) {
            Return "0,0";
        }
        This.Remember("Measure " + id);
        Return "120,32";
    }

    Public Function Draw(String command, String value) -> Bool
    Explain {
        Description: "Record one universal drawing command.";
        Input: command = "Fill, Stroke, Text, Clip, Push, or Pop", value = "Command argument";
        Processing: "Reject platform commands. Without graphics acceleration, record a software fallback.";
        Output: "True when the command is universal.";
    } {
        If (This.Leaked(command) || !This.KnownKind(command) && command != "Fill" && command != "Stroke" && command != "Text" && command != "Clip" && command != "Push" && command != "Pop") {
            This.BackendNote("RXU046", "This drawing command is not universal.", command);
            Return False;
        }
        If (command != "Fill" && command != "Stroke" && command != "Text" && command != "Clip" && command != "Push" && command != "Pop") {
            This.BackendNote("RXU046", "This drawing command is not universal.", command);
            Return False;
        }
        If (!This.Supports("Graphics")) {
            This.BackendNote("RXU045", "Graphics acceleration is unavailable, so software drawing is used.", "Graphics");
            This.Remember("Software " + command + " " + value);
            Return True;
        }
        This.Remember("Draw " + command + " " + value);
        Return True;
    }

    Public Function MarkDirty(String id) -> Bool
    Explain {
        Description: "Mark a component for another frame.";
        Input: id = "Component id";
        Processing: "Record the invalidation.";
        Output: "True when the component exists.";
    } {
        If (This.FindId(This.components, id) < 0) {
            Return False;
        }
        This.Remember("Dirty " + id);
        Return True;
    }

    Public Function CopyClipboard(String text) -> Bool
    Explain {
        Description: "Copy text to the universal clipboard.";
        Input: text = "Clipboard text";
        Processing: "Store the text when clipboard is supported.";
        Output: "True when the text is stored.";
    } {
        If (!This.Supports("Clipboard")) {
            This.BackendNote("RXU045", "This backend has no clipboard.", "Clipboard");
            Return False;
        }
        This.clipboard = text + "";
        This.Remember("Copy " + text);
        Return True;
    }

    Public Function PasteClipboard() -> String
    Explain {
        Description: "Read the universal clipboard.";
        Input: None;
        Processing: "Return the stored text when clipboard is supported.";
        Output: "The clipboard text, or empty text.";
    } {
        If (!This.Supports("Clipboard")) {
            This.BackendNote("RXU045", "This backend has no clipboard.", "Clipboard");
            Return "";
        }
        This.Remember("Paste");
        Return This.clipboard;
    }

    Public Function OpenDialog(String title, String message) -> Bool
    Explain {
        Description: "Show a dialog or record a universal fallback.";
        Input: title = "Dialog title", message = "Dialog message";
        Processing: "Use a message fallback when dialogs are unavailable.";
        Output: "True when the dialog or its fallback is recorded.";
    } {
        If (!This.Supports("Dialog")) {
            This.BackendNote("RXU045", "This backend falls back to an inline message.", "Dialog");
            This.Remember("Fallback Dialog " + title);
            Return True;
        }
        This.Remember("Dialog " + title + " " + message);
        Return True;
    }

    Public Function OpenFile(String title) -> String
    Explain {
        Description: "Choose a file or record a fallback.";
        Input: title = "Picker title";
        Processing: "Return a sample path when file dialogs exist. Otherwise record a fallback.";
        Output: "The chosen path, or empty text.";
    } {
        If (!This.Supports("FileDialog")) {
            This.BackendNote("RXU045", "This backend has no file dialog.", "FileDialog");
            This.Remember("Fallback File " + title);
            Return "";
        }
        This.Remember("File " + title);
        Return "arm.rxu";
    }

    Public Function Notify(String text) -> Bool
    Explain {
        Description: "Post a notification or record a fallback.";
        Input: text = "Notification text";
        Processing: "Use a log fallback when notifications are unavailable.";
        Output: "True when the notice or its fallback is recorded.";
    } {
        If (!This.Supports("Notification")) {
            This.BackendNote("RXU045", "This backend falls back to the log.", "Notification");
            This.Remember("Fallback Notification " + text);
            Return True;
        }
        This.Remember("Notification " + text);
        Return True;
    }

    Public Function OpenMenu(String id) -> Bool
    Explain {
        Description: "Open a menu or record a fallback.";
        Input: id = "Menu id";
        Processing: "Use a command fallback when menus are unavailable.";
        Output: "True when the menu or its fallback is recorded.";
    } {
        If (!This.Supports("Menu")) {
            This.BackendNote("RXU045", "This backend falls back to a command.", "Menu");
            This.Remember("Fallback Menu " + id);
            Return True;
        }
        This.Remember("Menu " + id);
        Return True;
    }

    Public Function ReadScale() -> String
    Explain {
        Description: "Read the display scale.";
        Input: None;
        Processing: "Return 2 when HiDPI is supported and 1 otherwise.";
        Output: "The scale text.";
    } {
        If (!This.Supports("HiDPI")) {
            This.BackendNote("RXU045", "HiDPI is unavailable, so the scale stays at 1.", "HiDPI");
            Return "1";
        }
        Return "2";
    }

    Public Function ReadScreens() -> Int
    Explain {
        Description: "Count the screens the backend knows.";
        Input: None;
        Processing: "Read the selected screen count.";
        Output: "The number of screens.";
    } {
        If (!This.Supports("Screen")) {
            This.BackendNote("RXU045", "This backend reports no screen.", "Screen");
            Return 0;
        }
        Return This.screens;
    }

    Public Function SaveState() -> String
    Explain {
        Description: "Save the open window ids.";
        Input: None;
        Processing: "Join the window ids.";
        Output: "The saved state.";
    } {
        String text = "";
        Int index = 0;
        While (index < This.windows.Count()) {
            If (index > 0) {
                text = text + ",";
            }
            text = text + This.windows[index];
            index = index + 1;
        }
        This.Remember("Save " + text);
        Return text;
    }

    Public Function RestoreState(String text) -> Bool
    Explain {
        Description: "Restore windows from saved ids.";
        Input: text = "Comma-separated window ids";
        Processing: "Replace the open window list.";
        Output: "True when the state is restored.";
    } {
        This.windows = List<String>();
        String current = "";
        Int index = 0;
        While (index < text.Length()) {
            String character = text.Substring(index, 1);
            If (character == ",") {
                If (current != "") {
                    This.windows.Add(current);
                }
                current = "";
            } Else {
                current = current + character;
            }
            index = index + 1;
        }
        If (current != "") {
            This.windows.Add(current);
        }
        This.Remember("Restore " + text);
        Return True;
    }

    Public Function ShutDown() -> Void
    Explain {
        Description: "Stop the backend and drop live windows.";
        Input: None;
        Processing: "Mark the backend stopped and clear windows and components.";
        Output: "No return value.";
    } {
        This.running = False;
        This.windows = List<String>();
        This.components = List<String>();
        This.componentWindows = List<String>();
        This.Remember("ShutDown");
    }

    Public Function LogCount() -> Int
    Explain {
        Description: "Count recorded backend operations.";
        Input: None;
        Processing: "Read the operation log size.";
        Output: "The number of log entries.";
    } {
        Return This.log.Count();
    }

    Public Function LogAt(Int index) -> String
    Explain {
        Description: "Read one recorded backend operation.";
        Input: index = "Zero-based log index";
        Processing: "Return that entry, or empty text when the index is outside the log.";
        Output: "The log entry.";
    } {
        If (index < 0 || index >= This.log.Count()) {
            Return "";
        }
        Return This.log[index];
    }

    Public Function ProjectClean(String path) -> Bool
    Explain {
        Description: "Reject platform-specific project text.";
        Input: path = "Project, logic, or markup path";
        Processing: "Read the file and refuse platform widget names and OS conditionals.";
        Output: "True when the file stays universal.";
    } {
        If (!Files.Exists(path)) {
            This.BackendNote("RXU017", "This project file was not found.", path);
            Return False;
        }
        String text = Files.ReadText(path);
        If (This.Leaked(text) || text.Contains("#if") || text.Contains("OperatingSystem")) {
            This.BackendNote("RXU046", "This project names a platform.", path);
            Return False;
        }
        Return True;
    }

    Private Function Allow(String capability) -> Void {
        If (This.FindId(This.capabilities, capability) < 0) {
            This.capabilities.Add(capability + "");
        }
    }

    Private Function Remember(String entry) -> Void {
        This.log.Add(entry + "");
    }

    Private Function BackendNote(String code, String message, String actual) -> Void {
        This.Messages.Add(code, message, "", 1, 1, actual.Length(), "a universal backend operation", actual, "Use a capability the selected backend provides.");
    }

    Private Function KnownKind(String kind) -> Bool {
        String catalog = ",Window,Panel,Button,Text,Label,Image,Border,";
        Return catalog.Contains("," + kind + ",");
    }

    Private Function Leaked(String text) -> Bool {
        If (text.Contains("Gtk") || text.Contains("HWND") || text.Contains("NSWindow") || text.Contains("NSView")) {
            Return True;
        }
        Return False;
    }

    Private Function FindId(List<String> items, String id) -> Int {
        Int index = 0;
        While (index < items.Count()) {
            If (items[index] == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }
}

Public Class LinuxApp {
    Public RxuMessages Messages;
    Public UIBackend Backend;
    Private List<String> ids;
    Private List<String> titles;
    Private List<String> states;
    Private List<String> xs;
    Private List<String> ys;
    Private List<String> widths;
    Private List<String> heights;
    Private List<String> queue;
    Private List<String> trace;
    Private Bool running;
    Private Bool background;
    Private String phase;
    Private Int exitCode;
    Private String mainId;

    Public Constructor() {
        This.Messages = RxuMessages();
        This.Backend = UIBackend();
        This.ids = List<String>();
        This.titles = List<String>();
        This.states = List<String>();
        This.xs = List<String>();
        This.ys = List<String>();
        This.widths = List<String>();
        This.heights = List<String>();
        This.queue = List<String>();
        This.trace = List<String>();
        This.running = False;
        This.background = False;
        This.phase = "Stopped";
        This.exitCode = 0;
        This.mainId = "";
        This.CreateApp();
    }

    Public Function CreateApp() -> Bool
    Explain {
        Description: "Create the Linux application and select the Linux backend.";
        Input: None;
        Processing: "Start from a stopped application with an empty window list.";
        Output: "True when the application is ready to run.";
    } {
        This.Backend = UIBackend();
        This.Backend.UseHost("linux");
        This.ids = List<String>();
        This.titles = List<String>();
        This.states = List<String>();
        This.xs = List<String>();
        This.ys = List<String>();
        This.widths = List<String>();
        This.heights = List<String>();
        This.queue = List<String>();
        This.trace = List<String>();
        This.running = False;
        This.background = False;
        This.phase = "Stopped";
        This.exitCode = 0;
        This.mainId = "";
        Return True;
    }

    Public Function OpenAppWindow(String id, String title, String width, String height) -> Bool
    Explain {
        Description: "Create a window before it is shown.";
        Input: id = "Window id", title = "Title", width = "Width text", height = "Height text";
        Processing: "Record the window and the GTK creation call.";
        Output: "True when the window is created.";
    } {
        If (This.phase == "Exited" || This.AppIndex(id) >= 0) {
            Return False;
        }
        This.ids.Add(id + "");
        This.titles.Add(title + "");
        This.states.Add("Hidden");
        This.xs.Add("0");
        This.ys.Add("0");
        This.widths.Add(width + "");
        This.heights.Add(height + "");
        If (This.mainId == "") {
            This.mainId = id + "";
        }
        This.Backend.OpenWindow(id, title);
        This.AppTrace("gtk_window_new " + id);
        Return True;
    }

    Public Function RunApp() -> Int
    Explain {
        Description: "Run the UI queue and show the main window.";
        Input: None;
        Processing: "Pump queued work and present the main window, then return.";
        Output: "The number of queued operations that were applied.";
    } {
        This.running = True;
        This.phase = "Running";
        Int applied = This.PumpApp();
        If (This.mainId != "" && This.ReadWindowState(This.mainId) == "Hidden") {
            This.ShowWindow(This.mainId);
        }
        Return applied;
    }

    Public Function ShutdownApp() -> Void
    Explain {
        Description: "Dispose every window and stop the application.";
        Input: None;
        Processing: "Destroy live windows and mark the application stopped.";
        Output: "No return value.";
    } {
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.states[index] != "Disposed") {
                This.states[index] = "Disposed";
                This.Backend.CloseWindow(This.ids[index]);
                This.AppTrace("gtk_window_destroy " + This.ids[index]);
            }
            index = index + 1;
        }
        This.running = False;
        This.background = False;
        This.phase = "Stopped";
        This.Backend.ShutDown();
    }

    Public Function ExitApp(Int code) -> Void
    Explain {
        Description: "Exit the process with a code.";
        Input: code = "Process exit code";
        Processing: "Shut down, then record the exit code.";
        Output: "No return value.";
    } {
        This.exitCode = code;
        This.ShutdownApp();
        This.phase = "Exited";
    }

    Public Function ReadPhase() -> String
    Explain {
        Description: "Read the application phase.";
        Input: None;
        Processing: "Return Stopped, Running, or Exited.";
        Output: "The phase name.";
    } {
        Return This.phase;
    }

    Public Function ReadExit() -> Int
    Explain {
        Description: "Read the exit code.";
        Input: None;
        Processing: "Return the code passed to Exit.";
        Output: "The exit code.";
    } {
        Return This.exitCode;
    }

    Public Function ReadMain() -> String
    Explain {
        Description: "Read the main window id.";
        Input: None;
        Processing: "Return the first window id.";
        Output: "The main window id.";
    } {
        Return This.mainId;
    }

    Public Function ShowWindow(String id) -> Bool
    Explain {
        Description: "Show a window.";
        Input: id = "Window id";
        Processing: "Present a hidden or closed window on the UI thread.";
        Output: "True when the window is shown.";
    } {
        If (!This.AppGuard() || !This.AppAlive(id) || This.ReadWindowState(id) == "Disposed") {
            Return False;
        }
        Int index = This.AppIndex(id);
        This.states[index] = "Normal";
        This.AppTrace("gtk_widget_show " + id);
        Return True;
    }

    Public Function HideWindow(String id) -> Bool
    Explain {
        Description: "Hide a window without destroying it.";
        Input: id = "Window id";
        Processing: "Mark the window hidden on the UI thread.";
        Output: "True when the window is hidden.";
    } {
        If (!This.AppGuard() || !This.AppAlive(id)) {
            Return False;
        }
        This.states[This.AppIndex(id)] = "Hidden";
        This.AppTrace("gtk_widget_hide " + id);
        Return True;
    }

    Public Function CloseAppWindow(String id) -> Bool
    Explain {
        Description: "Close a window without disposing it.";
        Input: id = "Window id";
        Processing: "Mark the window closed so it can be shown again.";
        Output: "True when the window is closed.";
    } {
        If (!This.AppGuard() || !This.AppAlive(id)) {
            Return False;
        }
        This.states[This.AppIndex(id)] = "Closed";
        This.Backend.CloseWindow(id);
        This.AppTrace("gtk_window_close " + id);
        Return True;
    }

    Public Function ActivateWindow(String id) -> Bool
    Explain {
        Description: "Activate a window.";
        Input: id = "Window id";
        Processing: "Show it and mark it normal.";
        Output: "True when the window is active.";
    } {
        If (!This.AppGuard() || !This.AppAlive(id)) {
            Return False;
        }
        This.states[This.AppIndex(id)] = "Normal";
        This.AppTrace("gtk_window_present " + id);
        Return True;
    }

    Public Function MinimizeWindow(String id) -> Bool
    Explain {
        Description: "Minimize a window.";
        Input: id = "Window id";
        Processing: "Mark the window minimized.";
        Output: "True when the window is minimized.";
    } {
        If (!This.AppGuard() || !This.AppAlive(id)) {
            Return False;
        }
        This.states[This.AppIndex(id)] = "Minimized";
        This.AppTrace("gtk_window_minimize " + id);
        Return True;
    }

    Public Function MaximizeWindow(String id) -> Bool
    Explain {
        Description: "Maximize a window.";
        Input: id = "Window id";
        Processing: "Mark the window maximized.";
        Output: "True when the window is maximized.";
    } {
        If (!This.AppGuard() || !This.AppAlive(id)) {
            Return False;
        }
        This.states[This.AppIndex(id)] = "Maximized";
        This.AppTrace("gtk_window_maximize " + id);
        Return True;
    }

    Public Function RestoreWindow(String id) -> Bool
    Explain {
        Description: "Restore a minimized or maximized window.";
        Input: id = "Window id";
        Processing: "Mark the window normal.";
        Output: "True when the window is restored.";
    } {
        If (!This.AppGuard() || !This.AppAlive(id)) {
            Return False;
        }
        This.states[This.AppIndex(id)] = "Normal";
        This.AppTrace("gtk_window_unminimize " + id);
        Return True;
    }

    Public Function RetitleWindow(String id, String title) -> Bool
    Explain {
        Description: "Change a window title.";
        Input: id = "Window id", title = "New title";
        Processing: "Reject the change from a background turn.";
        Output: "True when the title is stored.";
    } {
        If (!This.AppGuard() || !This.AppAlive(id)) {
            Return False;
        }
        This.titles[This.AppIndex(id)] = title + "";
        This.Backend.SyncProperty(id, "Title", title);
        This.AppTrace("gtk_window_set_title " + id);
        Return True;
    }

    Public Function ResizeWindow(String id, String width, String height) -> Bool
    Explain {
        Description: "Resize a window.";
        Input: id = "Window id", width = "Width text", height = "Height text";
        Processing: "Store the size on the UI thread.";
        Output: "True when the size is stored.";
    } {
        If (!This.AppGuard() || !This.AppAlive(id)) {
            Return False;
        }
        Int index = This.AppIndex(id);
        This.widths[index] = width + "";
        This.heights[index] = height + "";
        This.Backend.SyncProperty(id, "Width", width);
        This.AppTrace("gtk_window_set_default_size " + id);
        Return True;
    }

    Public Function MoveWindow(String id, String x, String y) -> Bool
    Explain {
        Description: "Move a window.";
        Input: id = "Window id", x = "Left position", y = "Top position";
        Processing: "Store the position on the UI thread.";
        Output: "True when the position is stored.";
    } {
        If (!This.AppGuard() || !This.AppAlive(id)) {
            Return False;
        }
        Int index = This.AppIndex(id);
        This.xs[index] = x + "";
        This.ys[index] = y + "";
        This.AppTrace("gtk_window_move " + id);
        Return True;
    }

    Public Function ReadWindowState(String id) -> String
    Explain {
        Description: "Read a window state.";
        Input: id = "Window id";
        Processing: "Return Hidden, Normal, Minimized, Maximized, Closed, or Disposed.";
        Output: "The state, or empty text when the id is unknown.";
    } {
        Int index = This.AppIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.states[index];
    }

    Public Function ReadWindowTitle(String id) -> String
    Explain {
        Description: "Read a window title.";
        Input: id = "Window id";
        Processing: "Return the stored title.";
        Output: "The title, or empty text.";
    } {
        Int index = This.AppIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.titles[index];
    }

    Public Function ReadWindowSize(String id) -> String
    Explain {
        Description: "Read a window size.";
        Input: id = "Window id";
        Processing: "Join width and height.";
        Output: "The size text.";
    } {
        Int index = This.AppIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.widths[index] + "," + This.heights[index];
    }

    Public Function ReadWindowPosition(String id) -> String
    Explain {
        Description: "Read a window position.";
        Input: id = "Window id";
        Processing: "Join the left and top positions.";
        Output: "The position text.";
    } {
        Int index = This.AppIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.xs[index] + "," + This.ys[index];
    }

    Public Function PostWork(String work) -> Bool
    Explain {
        Description: "Queue work for the UI thread.";
        Input: work = "Title, Size, Move, or Show command";
        Processing: "Append the command. A background turn may post.";
        Output: "True when the command is queued.";
    } {
        This.queue.Add(work + "");
        Return True;
    }

    Public Function DispatchWork(String work) -> Bool
    Explain {
        Description: "Run work now on the UI thread, or queue it from the background.";
        Input: work = "Queued command";
        Processing: "Apply it immediately on the UI thread. Queue it from the background so the caller does not block.";
        Output: "True when the work is accepted.";
    } {
        If (This.IsUIThread()) {
            This.AppApply(work);
            Return True;
        }
        Return This.PostWork(work);
    }

    Public Function DispatchLater(String work) -> Bool
    Explain {
        Description: "Queue work and return without waiting.";
        Input: work = "Queued command";
        Processing: "Always append the command.";
        Output: "True when the command is queued.";
    } {
        Return This.PostWork(work);
    }

    Public Function InvokeWork(String work) -> Bool
    Explain {
        Description: "Run work on the UI thread and wait.";
        Input: work = "Queued command";
        Processing: "Apply it on the UI thread. Reject a background call instead of blocking.";
        Output: "True when the work ran.";
    } {
        If (!This.IsUIThread()) {
            This.AppNote("RXU047", "Invoke must run on the UI thread.", work);
            Return False;
        }
        This.AppApply(work);
        Return True;
    }

    Public Function InvokeLater(String work) -> Bool
    Explain {
        Description: "Queue work that the UI thread will run later.";
        Input: work = "Queued command";
        Processing: "Append the command and return.";
        Output: "True when the command is queued.";
    } {
        Return This.PostWork(work);
    }

    Public Function ScheduleWork(String work) -> Bool
    Explain {
        Description: "Schedule work on the UI queue.";
        Input: work = "Queued command";
        Processing: "Append the command.";
        Output: "True when the command is queued.";
    } {
        Return This.PostWork(work);
    }

    Public Function CheckAccess() -> Bool
    Explain {
        Description: "Report whether the caller may change the UI.";
        Input: None;
        Processing: "Allow changes only while the application is running on the UI thread.";
        Output: "True when a UI change is allowed.";
    } {
        Return This.running && !This.background;
    }

    Public Function IsUIThread() -> Bool
    Explain {
        Description: "Report whether the caller is the UI thread.";
        Input: None;
        Processing: "Background turns are not the UI thread.";
        Output: "True when the caller is the UI thread.";
    } {
        Return !This.background;
    }

    Public Function EnterBackground() -> Void
    Explain {
        Description: "Begin a background turn.";
        Input: None;
        Processing: "Mark the caller as off the UI thread.";
        Output: "No return value.";
    } {
        This.background = True;
    }

    Public Function LeaveBackground() -> Void
    Explain {
        Description: "End a background turn.";
        Input: None;
        Processing: "Mark the caller as the UI thread again.";
        Output: "No return value.";
    } {
        This.background = False;
    }

    Public Function PumpApp() -> Int
    Explain {
        Description: "Apply the queued UI work.";
        Input: None;
        Processing: "Run each queued command and return. The caller is not blocked after the queue is empty.";
        Output: "The number of commands applied.";
    } {
        Int applied = 0;
        Int guard = 0;
        While (This.queue.Count() > 0 && guard < 100) {
            This.AppApply(This.AppTake());
            applied = applied + 1;
            guard = guard + 1;
        }
        Return applied;
    }

    Public Function DisposeWindow(String id) -> Bool
    Explain {
        Description: "Destroy a window and its backend object.";
        Input: id = "Window id";
        Processing: "Mark it disposed and record the GTK destroy call.";
        Output: "True when the window is disposed.";
    } {
        If (!This.AppGuard() || This.AppIndex(id) < 0 || This.ReadWindowState(id) == "Disposed") {
            Return False;
        }
        This.states[This.AppIndex(id)] = "Disposed";
        This.Backend.CloseWindow(id);
        This.AppTrace("gtk_window_destroy " + id);
        Return True;
    }

    Public Function ReadScale() -> String
    Explain {
        Description: "Read the Linux display scale.";
        Input: None;
        Processing: "Ask the Linux backend for the HiDPI scale.";
        Output: "The scale text.";
    } {
        Return This.Backend.ReadScale();
    }

    Public Function CopyText(String text) -> Bool
    Explain {
        Description: "Copy text through the Linux clipboard bridge.";
        Input: text = "Clipboard text";
        Processing: "Delegate to the backend clipboard.";
        Output: "True when the text is stored.";
    } {
        Return This.Backend.CopyClipboard(text);
    }

    Public Function PasteText() -> String
    Explain {
        Description: "Paste text through the Linux clipboard bridge.";
        Input: None;
        Processing: "Delegate to the backend clipboard.";
        Output: "The clipboard text.";
    } {
        Return This.Backend.PasteClipboard();
    }

    Public Function ChooseFile(String title) -> String
    Explain {
        Description: "Open the Linux file picker bridge.";
        Input: title = "Picker title";
        Processing: "Delegate to the backend file dialog.";
        Output: "The chosen path.";
    } {
        Return This.Backend.OpenFile(title);
    }

    Public Function AskDialog(String title, String message) -> Bool
    Explain {
        Description: "Open the Linux dialog bridge.";
        Input: title = "Dialog title", message = "Dialog message";
        Processing: "Delegate to the backend dialog.";
        Output: "True when the dialog is recorded.";
    } {
        Return This.Backend.OpenDialog(title, message);
    }

    Public Function TraceCount() -> Int
    Explain {
        Description: "Count recorded GTK calls.";
        Input: None;
        Processing: "Read the trace size.";
        Output: "The number of calls.";
    } {
        Return This.trace.Count();
    }

    Public Function TraceAt(Int index) -> String
    Explain {
        Description: "Read one recorded GTK call.";
        Input: index = "Zero-based trace index";
        Processing: "Return that call.";
        Output: "The call text, or empty text.";
    } {
        If (index < 0 || index >= This.trace.Count()) {
            Return "";
        }
        Return This.trace[index];
    }

    Private Function AppGuard() -> Bool {
        If (This.background) {
            This.AppNote("RXU047", "This change must run on the UI thread.", "background");
            Return False;
        }
        Return True;
    }

    Private Function AppAlive(String id) -> Bool {
        Int index = This.AppIndex(id);
        If (index < 0) {
            Return False;
        }
        If (This.states[index] == "Disposed") {
            This.AppNote("RXU048", "This window has been disposed.", id);
            Return False;
        }
        Return True;
    }

    Private Function AppIndex(String id) -> Int {
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.ids[index] == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function AppApply(String work) -> Void {
        String op = This.AppField(work, 0);
        String id = This.AppField(work, 1);
        If (This.AppIndex(id) < 0 || This.ReadWindowState(id) == "Disposed") {
            Return;
        }
        If (op == "Title") {
            This.titles[This.AppIndex(id)] = This.AppField(work, 2);
            This.AppTrace("gtk_window_set_title " + id);
        }
        If (op == "Size") {
            This.widths[This.AppIndex(id)] = This.AppField(work, 2);
            This.heights[This.AppIndex(id)] = This.AppField(work, 3);
            This.AppTrace("gtk_window_set_default_size " + id);
        }
        If (op == "Move") {
            This.xs[This.AppIndex(id)] = This.AppField(work, 2);
            This.ys[This.AppIndex(id)] = This.AppField(work, 3);
            This.AppTrace("gtk_window_move " + id);
        }
        If (op == "Show") {
            This.states[This.AppIndex(id)] = "Normal";
            This.AppTrace("gtk_widget_show " + id);
        }
    }

    Private Function AppTake() -> String {
        If (This.queue.Count() == 0) {
            Return "";
        }
        String item = This.queue[0] + "";
        List<String> rest = List<String>();
        Int index = 1;
        While (index < This.queue.Count()) {
            rest.Add(This.queue[index]);
            index = index + 1;
        }
        This.queue = rest;
        Return item;
    }

    Private Function AppField(String text, Int wanted) -> String {
        Int seen = 0;
        String current = "";
        Int index = 0;
        While (index < text.Length()) {
            String character = text.Substring(index, 1);
            If (character == "|") {
                If (seen == wanted) {
                    Return current;
                }
                seen = seen + 1;
                current = "";
            } Else {
                current = current + character;
            }
            index = index + 1;
        }
        If (seen == wanted) {
            Return current;
        }
        Return "";
    }

    Private Function AppTrace(String call) -> Void {
        This.trace.Add(call + "");
    }

    Private Function AppNote(String code, String message, String actual) -> Void {
        This.Messages.Add(code, message, "", 1, 1, actual.Length(), "a UI-thread change", actual, "Post the change to the UI queue.");
    }
}

Public Class LayoutSlot {
    Public String Id;
    Public String Parent;
    Public String Kind;
    Public String Width;
    Public String Height;
    Public String MinWidth;
    Public String MinHeight;
    Public String MaxWidth;
    Public String MaxHeight;
    Public String Margin;
    Public String Padding;
    Public String Horizontal;
    Public String Vertical;
    Public String Orientation;
    Public String Spacing;
    Public String Dock;
    Public String Row;
    Public String Column;
    Public String RowSpan;
    Public String ColumnSpan;
    Public String Columns;
    Public String Rows;
    Public String Clip;
    Public String Content;
    Public String Background;
    Public Int X;
    Public Int Y;
    Public Int W;
    Public Int H;
    Public Int DesiredW;
    Public Int DesiredH;
    Public Int Measures;
    Public Int ScrollX;
    Public Int ScrollY;
    Public Bool Dirty;
    Public String Avail;

    Public Constructor() {
        This.Id = "";
        This.Parent = "";
        This.Kind = "Panel";
        This.Width = "Auto";
        This.Height = "Auto";
        This.MinWidth = "0";
        This.MinHeight = "0";
        This.MaxWidth = "100000";
        This.MaxHeight = "100000";
        This.Margin = "0";
        This.Padding = "0";
        This.Horizontal = "Stretch";
        This.Vertical = "Stretch";
        This.Orientation = "Vertical";
        This.Spacing = "0";
        This.Dock = "";
        This.Row = "0";
        This.Column = "0";
        This.RowSpan = "1";
        This.ColumnSpan = "1";
        This.Columns = "1";
        This.Rows = "1";
        This.Clip = "false";
        This.Content = "";
        This.Background = "#000000";
        This.X = 0;
        This.Y = 0;
        This.W = 0;
        This.H = 0;
        This.DesiredW = 0;
        This.DesiredH = 0;
        This.Measures = 0;
        This.ScrollX = 0;
        This.ScrollY = 0;
        This.Dirty = True;
        This.Avail = "";
    }
}

Public Class LayoutEngine {
    Public List<LayoutSlot> Slots;
    Public List<String> Commands;
    Private Int scale;
    Private String flow;
    Private Int revision;
    Private String lastKey;
    Private Int sideL;
    Private Int sideT;
    Private Int sideR;
    Private Int sideB;

    Public Constructor() {
        This.Slots = List<LayoutSlot>();
        This.Commands = List<String>();
        This.scale = 1;
        This.flow = "LTR";
        This.revision = 0;
        This.lastKey = "";
        This.sideL = 0;
        This.sideT = 0;
        This.sideR = 0;
        This.sideB = 0;
    }

    Public Function AddSlot(String id, String parent, String kind) -> Int
    Explain {
        Description: "Add one layout node.";
        Input: id = "Node name", parent = "Parent name, or empty for the root", kind = "Panel, Stack, Grid, View, Scroll, Dock, Wrap, Canvas, Overlay, Flex, Uniform, Split, Constraint, Tab, Text, Image, Rect, Border, Path, or Shadow";
        Processing: "Store the node as dirty so the next pass measures it.";
        Output: "The slot index.";
    } {
        LayoutSlot slot = LayoutSlot();
        slot.Id = id + "";
        slot.Parent = parent + "";
        If (kind != "") {
            slot.Kind = kind + "";
        }
        This.Slots.Add(slot);
        Return This.Slots.Count() - 1;
    }

    Public Function SetText(String id, String field, String value) -> Bool
    Explain {
        Description: "Change one layout input.";
        Input: id = "Node name", field = "Input name", value = "New text";
        Processing: "Store the text and mark the node dirty.";
        Output: "True when the field is known.";
    } {
        Int index = This.SlotIndex(id);
        If (index < 0) {
            Return False;
        }
        Bool known = This.SlotWrite(index, field, value);
        If (known) {
            This.Slots[index].Dirty = True;
        }
        Return known;
    }

    Public Function ImportLayout(RxuNode node, String parent) -> Int
    Explain {
        Description: "Import layout markup into slots.";
        Input: node = "Document or element", parent = "Parent name";
        Processing: "Copy each element into a slot and walk its children.";
        Output: "The number of imported elements.";
    } {
        If (node.Kind != "Element") {
            Int count = 0;
            Int index = 0;
            While (index < node.Children.Count()) {
                count = count + This.ImportLayout(node.Children[index], parent);
                index = index + 1;
            }
            Return count;
        }
        String id = node.FindAttribute("Name").Text;
        If (id == "") {
            id = "n" + This.Slots.Count().ToString();
        }
        String kind = node.FindAttribute("Tag").Text;
        Int slot = This.AddSlot(id, parent, kind);
        This.SlotWrite(slot, "Width", node.FindAttribute("Width").Text);
        This.SlotWrite(slot, "Height", node.FindAttribute("Height").Text);
        This.SlotWrite(slot, "MinWidth", node.FindAttribute("MinWidth").Text);
        This.SlotWrite(slot, "MinHeight", node.FindAttribute("MinHeight").Text);
        This.SlotWrite(slot, "MaxWidth", node.FindAttribute("MaxWidth").Text);
        This.SlotWrite(slot, "MaxHeight", node.FindAttribute("MaxHeight").Text);
        This.SlotWrite(slot, "Margin", node.FindAttribute("Margin").Text);
        This.SlotWrite(slot, "Padding", node.FindAttribute("Padding").Text);
        This.SlotWrite(slot, "Horizontal", node.FindAttribute("HorizontalAlignment").Text);
        This.SlotWrite(slot, "Vertical", node.FindAttribute("VerticalAlignment").Text);
        This.SlotWrite(slot, "Orientation", node.FindAttribute("Orientation").Text);
        This.SlotWrite(slot, "Spacing", node.FindAttribute("Spacing").Text);
        This.SlotWrite(slot, "Dock", node.FindAttribute("Dock").Text);
        This.SlotWrite(slot, "Row", node.FindAttribute("Row").Text);
        This.SlotWrite(slot, "Column", node.FindAttribute("Column").Text);
        This.SlotWrite(slot, "RowSpan", node.FindAttribute("RowSpan").Text);
        This.SlotWrite(slot, "ColumnSpan", node.FindAttribute("ColumnSpan").Text);
        This.SlotWrite(slot, "Columns", node.FindAttribute("GridColumns").Text);
        This.SlotWrite(slot, "Rows", node.FindAttribute("GridRows").Text);
        This.SlotWrite(slot, "Clip", node.FindAttribute("ClipToBounds").Text);
        This.SlotWrite(slot, "Content", node.FindAttribute("Content").Text);
        This.SlotWrite(slot, "Background", node.FindAttribute("Background").Text);
        Int count = 1;
        Int child = 0;
        While (child < node.Children.Count()) {
            count = count + This.ImportLayout(node.Children[child], id);
            child = child + 1;
        }
        Return count;
    }

    Public Function SetScale(Int value) -> Void
    Explain {
        Description: "Set the device scale.";
        Input: value = "Scale, such as 1 or 2";
        Processing: "Store the scale used when frames become device pixels.";
        Output: "No return value.";
    } {
        Int scale = value;
        If (scale < 1) {
            scale = 1;
        }
        This.scale = scale;
    }

    Public Function SetFlow(String direction) -> Void
    Explain {
        Description: "Set the layout direction.";
        Input: direction = "LTR or RTL";
        Processing: "RTL mirrors arranged positions inside the parent.";
        Output: "No return value.";
    } {
        If (direction == "RTL") {
            This.flow = "RTL";
        } Else {
            This.flow = "LTR";
        }
    }

    Public Function SetOffset(String id, Int x, Int y) -> Bool
    Explain {
        Description: "Set a scroll offset.";
        Input: id = "Scroll view name", x = "Horizontal offset", y = "Vertical offset";
        Processing: "Store the offset and mark the view dirty.";
        Output: "True when the view exists.";
    } {
        Int index = This.SlotIndex(id);
        If (index < 0) {
            Return False;
        }
        This.Slots[index].ScrollX = x;
        This.Slots[index].ScrollY = y;
        This.Slots[index].Dirty = True;
        Return True;
    }

    Public Function InvalidateSlot(String id) -> Bool
    Explain {
        Description: "Mark one node for another layout pass.";
        Input: id = "Node name";
        Processing: "Set the dirty flag. Clean siblings keep their cached measure.";
        Output: "True when the node exists.";
    } {
        Int index = This.SlotIndex(id);
        If (index < 0) {
            Return False;
        }
        This.Slots[index].Dirty = True;
        Return True;
    }

    Public Function MeasureSlot(String id, Int availableW, Int availableH) -> String
    Explain {
        Description: "Measure one node.";
        Input: id = "Node name", availableW = "Available width", availableH = "Available height";
        Processing: "Resolve auto, fixed, percent, min, and max sizes.";
        Output: "The desired width and height.";
    } {
        Int index = This.SlotIndex(id);
        If (index < 0) {
            Return "0,0";
        }
        This.SlotMeasure(index, availableW, availableH);
        Return This.Slots[index].DesiredW.ToString() + "," + This.Slots[index].DesiredH.ToString();
    }

    Public Function ArrangeSlot(String id, Int x, Int y, Int w, Int h) -> Bool
    Explain {
        Description: "Arrange one node into a rectangle.";
        Input: id = "Node name", x = "Left", y = "Top", w = "Width", h = "Height";
        Processing: "Place the node and its children.";
        Output: "True when the node exists.";
    } {
        Int index = This.SlotIndex(id);
        If (index < 0) {
            Return False;
        }
        This.SlotArrange(index, x, y, w, h);
        Return True;
    }

    Public Function DrawSlots(String id) -> Int
    Explain {
        Description: "Render one arranged tree.";
        Input: id = "Root name";
        Processing: "Emit primitives, clips, and overflow clipping.";
        Output: "The number of drawing commands.";
    } {
        This.Commands = List<String>();
        Int index = This.SlotIndex(id);
        If (index < 0) {
            Return 0;
        }
        This.SlotPaint(index, False, 0, 0, 0, 0);
        Return This.Commands.Count();
    }

    Public Function Relayout(String id, Int w, Int h) -> Int
    Explain {
        Description: "Measure, arrange, and render one root.";
        Input: id = "Root name", w = "Window width", h = "Window height";
        Processing: "Reuse the cached pass when nothing is dirty and the viewport is unchanged.";
        Output: "The number of drawing commands.";
    } {
        Int index = This.SlotIndex(id);
        If (index < 0) {
            Return 0;
        }
        String key = w.ToString() + "," + h.ToString() + "," + This.scale.ToString() + "," + This.flow;
        If (key == This.lastKey && !This.Slots[index].Dirty && !This.SlotDirtyKids(index) && This.Commands.Count() > 0) {
            Return This.Commands.Count();
        }
        If (key != This.lastKey) {
            This.Slots[index].Dirty = True;
        }
        This.lastKey = key;
        This.SlotMeasure(index, w, h);
        This.SlotArrange(index, 0, 0, w, h);
        Int count = This.DrawSlots(id);
        This.revision = This.revision + 1;
        Return count;
    }

    Public Function FrameOf(String id) -> String
    Explain {
        Description: "Read one arranged frame in device pixels.";
        Input: id = "Node name";
        Processing: "Apply direction and scale to the logical rectangle.";
        Output: "x,y,w,h or empty text.";
    } {
        Int index = This.SlotIndex(id);
        If (index < 0) {
            Return "";
        }
        Int x = 0;
        Int y = 0;
        Int w = 0;
        Int h = 0;
        This.SlotDevice(index, x, y, w, h);
        Return This.sideL.ToString() + "," + This.sideT.ToString() + "," + This.sideR.ToString() + "," + This.sideB.ToString();
    }

    Public Function CommandCount() -> Int
    Explain {
        Description: "Count drawing commands.";
        Input: None;
        Processing: "Read the command list size.";
        Output: "The number of commands.";
    } {
        Return This.Commands.Count();
    }

    Public Function CommandAt(Int index) -> String
    Explain {
        Description: "Read one drawing command.";
        Input: index = "Zero-based command index";
        Processing: "Return that command.";
        Output: "The command, or empty text.";
    } {
        If (index < 0 || index >= This.Commands.Count()) {
            Return "";
        }
        Return This.Commands[index];
    }

    Public Function MeasureCount(String id) -> Int
    Explain {
        Description: "Count how many times a node was measured.";
        Input: id = "Node name";
        Processing: "Read the cached measure counter.";
        Output: "The measure count.";
    } {
        Int index = This.SlotIndex(id);
        If (index < 0) {
            Return 0;
        }
        Return This.Slots[index].Measures;
    }

    Public Function RevisionOf() -> Int
    Explain {
        Description: "Read how many full layout passes ran.";
        Input: None;
        Processing: "Read the revision counter.";
        Output: "The revision.";
    } {
        Return This.revision;
    }

    Public Function DecorationNote() -> String
    Explain {
        Description: "Describe host differences that layout does not own.";
        Input: None;
        Processing: "Return the shared note about fonts and window decorations.";
        Output: "The note.";
    } {
        Return "Window decorations and fonts follow the host. Layout geometry stays shared.";
    }

    Public Function HasCommand(String text) -> Bool
    Explain {
        Description: "Find one drawing command.";
        Input: text = "The full command";
        Processing: "Scan the commands from the last render.";
        Output: "True when that command was recorded.";
    } {
        Int index = 0;
        While (index < This.Commands.Count()) {
            If (This.Commands[index] == text) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function SlotWrite(Int index, String field, String value) -> Bool {
        If (value == "") {
            Return True;
        }
        If (field == "Width") { This.Slots[index].Width = value + ""; Return True; }
        If (field == "Height") { This.Slots[index].Height = value + ""; Return True; }
        If (field == "MinWidth") { This.Slots[index].MinWidth = value + ""; Return True; }
        If (field == "MinHeight") { This.Slots[index].MinHeight = value + ""; Return True; }
        If (field == "MaxWidth") { This.Slots[index].MaxWidth = value + ""; Return True; }
        If (field == "MaxHeight") { This.Slots[index].MaxHeight = value + ""; Return True; }
        If (field == "Margin") { This.Slots[index].Margin = value + ""; Return True; }
        If (field == "Padding") { This.Slots[index].Padding = value + ""; Return True; }
        If (field == "Horizontal") { This.Slots[index].Horizontal = value + ""; Return True; }
        If (field == "Vertical") { This.Slots[index].Vertical = value + ""; Return True; }
        If (field == "Orientation") { This.Slots[index].Orientation = value + ""; Return True; }
        If (field == "Spacing") { This.Slots[index].Spacing = value + ""; Return True; }
        If (field == "Dock") { This.Slots[index].Dock = value + ""; Return True; }
        If (field == "Row") { This.Slots[index].Row = value + ""; Return True; }
        If (field == "Column") { This.Slots[index].Column = value + ""; Return True; }
        If (field == "RowSpan") { This.Slots[index].RowSpan = value + ""; Return True; }
        If (field == "ColumnSpan") { This.Slots[index].ColumnSpan = value + ""; Return True; }
        If (field == "Columns") { This.Slots[index].Columns = value + ""; Return True; }
        If (field == "Rows") { This.Slots[index].Rows = value + ""; Return True; }
        If (field == "Clip") { This.Slots[index].Clip = value + ""; Return True; }
        If (field == "Content") { This.Slots[index].Content = value + ""; Return True; }
        If (field == "Background") { This.Slots[index].Background = value + ""; Return True; }
        Return False;
    }

    Private Function SlotIndex(String id) -> Int {
        Int index = 0;
        While (index < This.Slots.Count()) {
            If (This.Slots[index].Id == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function SlotDirtyKids(Int index) -> Bool {
        Int child = 0;
        While (child < This.Slots.Count()) {
            If (This.Slots[child].Parent == This.Slots[index].Id) {
                If (This.Slots[child].Dirty || This.SlotDirtyKids(child)) {
                    Return True;
                }
            }
            child = child + 1;
        }
        Return False;
    }

    Private Function SlotKids(Int index) -> Int {
        Int count = 0;
        Int child = 0;
        While (child < This.Slots.Count()) {
            If (This.Slots[child].Parent == This.Slots[index].Id) {
                count = count + 1;
            }
            child = child + 1;
        }
        Return count;
    }

    Private Function SlotKid(Int index, Int nth) -> Int {
        Int seen = 0;
        Int child = 0;
        While (child < This.Slots.Count()) {
            If (This.Slots[child].Parent == This.Slots[index].Id) {
                If (seen == nth) {
                    Return child;
                }
                seen = seen + 1;
            }
            child = child + 1;
        }
        Return -1;
    }

    Private Function SlotSides(String text) -> Void {
        This.sideL = 0;
        This.sideT = 0;
        This.sideR = 0;
        This.sideB = 0;
        If (text == "") {
            Return;
        }
        Int commas = 0;
        Int index = 0;
        While (index < text.Length()) {
            If (text.Substring(index, 1) == ",") {
                commas = commas + 1;
            }
            index = index + 1;
        }
        If (commas == 0) {
            Int value = text.ToInt();
            This.sideL = value;
            This.sideT = value;
            This.sideR = value;
            This.sideB = value;
            Return;
        }
        Int part = 0;
        String current = "";
        index = 0;
        While (index < text.Length()) {
            String character = text.Substring(index, 1);
            If (character == ",") {
                This.SlotSide(part, current.ToInt());
                part = part + 1;
                current = "";
            } Else {
                current = current + character;
            }
            index = index + 1;
        }
        This.SlotSide(part, current.ToInt());
    }

    Private Function SlotSide(Int part, Int value) -> Void {
        If (part == 0) { This.sideL = value; }
        If (part == 1) { This.sideT = value; }
        If (part == 2) { This.sideR = value; }
        If (part == 3) { This.sideB = value; }
    }

    Private Function SlotFixed(String text, Int available, Int natural) -> Int {
        If (text == "" || text == "Auto" || text == "Content") {
            Return natural;
        }
        If (text.EndsWith("%") && text.Length() > 1) {
            Int percent = text.Substring(0, text.Length() - 1).ToInt();
            Return available * percent / 100;
        }
        Return text.ToInt();
    }

    Private Function SlotClamp(Int value, String minimum, String maximum) -> Int {
        Int low = minimum.ToInt();
        Int high = maximum.ToInt();
        Int size = value;
        If (high <= 0) {
            high = 100000;
        }
        If (size < low) {
            size = low;
        }
        If (size > high) {
            size = high;
        }
        Return size;
    }

    Private Function SlotNatural(Int index) -> Void {
        String kind = This.Slots[index].Kind;
        String content = This.Slots[index].Content;
        If (content == "") {
            content = This.Slots[index].Id;
        }
        This.sideL = 40;
        This.sideT = 40;
        If (kind == "Text") {
            This.sideL = content.Length() * 8;
            This.sideT = 16;
        }
        If (kind == "Image") {
            This.sideL = 32;
            This.sideT = 32;
        }
    }

    Private Function SlotMeasure(Int index, Int availableW, Int availableH) -> Void {
        String key = availableW.ToString() + "," + availableH.ToString();
        If (!This.Slots[index].Dirty && !This.SlotDirtyKids(index) && This.Slots[index].Measures > 0 && This.Slots[index].Avail == key) {
            Return;
        }
        This.Slots[index].Measures = This.Slots[index].Measures + 1;
        This.Slots[index].Avail = key;
        This.SlotSides(This.Slots[index].Margin);
        Int marginL = This.sideL;
        Int marginT = This.sideT;
        Int marginR = This.sideR;
        Int marginB = This.sideB;
        This.SlotNatural(index);
        Int naturalW = This.sideL;
        Int naturalH = This.sideT;
        Int innerW = availableW - marginL - marginR;
        Int innerH = availableH - marginT - marginB;
        If (innerW < 0) { innerW = 0; }
        If (innerH < 0) { innerH = 0; }
        Int width = This.SlotClamp(This.SlotFixed(This.Slots[index].Width, innerW, naturalW), This.Slots[index].MinWidth, This.Slots[index].MaxWidth);
        Int height = This.SlotClamp(This.SlotFixed(This.Slots[index].Height, innerH, naturalH), This.Slots[index].MinHeight, This.Slots[index].MaxHeight);
        String kind = This.Slots[index].Kind;
        If (kind == "Panel" || kind == "Stack" || kind == "Dock" || kind == "Wrap" || kind == "Flex" || kind == "Split") {
            Int across = innerW;
            If (width > 0 && This.Slots[index].Width != "Auto" && This.Slots[index].Width != "Content" && !This.Slots[index].Width.EndsWith("%")) {
                across = width;
            }
            Int sum = 0;
            Int broad = 0;
            Int count = This.SlotKids(index);
            Int child = 0;
            While (child < count) {
                Int kid = This.SlotKid(index, child);
                This.SlotMeasure(kid, across, 10000);
                Int outerW = This.Slots[kid].DesiredW;
                Int outerH = This.Slots[kid].DesiredH;
                This.SlotSides(This.Slots[kid].Margin);
                outerW = outerW + This.sideL + This.sideR;
                outerH = outerH + This.sideT + This.sideB;
                If (outerW > broad) { broad = outerW; }
                If (outerH > broad && (kind == "Stack" && This.Slots[index].Orientation == "Horizontal" || kind == "Flex" || kind == "Wrap")) {
                    broad = outerH;
                }
                sum = sum + outerH;
                If (kind == "Stack" && This.Slots[index].Orientation == "Horizontal" || kind == "Flex" || kind == "Wrap") {
                    sum = sum - outerH + outerW;
                }
                child = child + 1;
            }
            This.SlotSides(This.Slots[index].Padding);
            Int pad = This.sideL + This.sideR;
            Int padH = This.sideT + This.sideB;
            Int gap = 0;
            If (count > 1) {
                gap = This.Slots[index].Spacing.ToInt() * (count - 1);
            }
            If (This.Slots[index].Width == "Auto" || This.Slots[index].Width == "Content") {
                width = broad + pad;
            }
            If (This.Slots[index].Height == "Auto" || This.Slots[index].Height == "Content") {
                height = sum + gap + padH;
            }
        } Else {
            Int extra = This.SlotKids(index);
            Int nth = 0;
            While (nth < extra) {
                This.SlotMeasure(This.SlotKid(index, nth), innerW, innerH);
                nth = nth + 1;
            }
        }
        This.Slots[index].DesiredW = width;
        This.Slots[index].DesiredH = height;
        This.Slots[index].Dirty = False;
    }

    Private Function SlotArrange(Int index, Int x, Int y, Int w, Int h) -> Void {
        This.SlotSides(This.Slots[index].Margin);
        Int marginL = This.sideL;
        Int marginT = This.sideT;
        Int marginR = This.sideR;
        Int marginB = This.sideB;
        Int innerW = w - marginL - marginR;
        Int innerH = h - marginT - marginB;
        If (innerW < 0) { innerW = 0; }
        If (innerH < 0) { innerH = 0; }
        Int boxW = This.Slots[index].DesiredW;
        Int boxH = This.Slots[index].DesiredH;
        If (This.Slots[index].Horizontal == "Stretch") { boxW = innerW; }
        If (This.Slots[index].Vertical == "Stretch") { boxH = innerH; }
        Int boxX = x + marginL;
        Int boxY = y + marginT;
        If (This.Slots[index].Horizontal == "Center") { boxX = x + marginL + (innerW - boxW) / 2; }
        If (This.Slots[index].Horizontal == "End") { boxX = x + marginL + innerW - boxW; }
        If (This.Slots[index].Vertical == "Center") { boxY = y + marginT + (innerH - boxH) / 2; }
        If (This.Slots[index].Vertical == "End") { boxY = y + marginT + innerH - boxH; }
        This.Slots[index].X = boxX;
        This.Slots[index].Y = boxY;
        This.Slots[index].W = boxW;
        This.Slots[index].H = boxH;
        This.SlotSides(This.Slots[index].Padding);
        Int padL = This.sideL;
        Int padT = This.sideT;
        Int padR = This.sideR;
        Int padB = This.sideB;
        Int contentX = boxX + padL;
        Int contentY = boxY + padT;
        Int contentW = boxW - padL - padR;
        Int contentH = boxH - padT - padB;
        If (contentW < 0) { contentW = 0; }
        If (contentH < 0) { contentH = 0; }
        String kind = This.Slots[index].Kind;
        Int spacing = This.Slots[index].Spacing.ToInt();
        Int count = This.SlotKids(index);
        If (kind == "Panel" || (kind == "Stack" && This.Slots[index].Orientation != "Horizontal")) {
            Int cursor = contentY;
            Int child = 0;
            While (child < count) {
                Int kid = This.SlotKid(index, child);
                This.SlotSides(This.Slots[kid].Margin);
                Int outer = This.Slots[kid].DesiredH + This.sideT + This.sideB;
                This.SlotArrange(kid, contentX, cursor, contentW, outer);
                cursor = cursor + outer + spacing;
                child = child + 1;
            }
        }
        If (kind == "Stack" && This.Slots[index].Orientation == "Horizontal") {
            Int cursor = contentX;
            Int child = 0;
            While (child < count) {
                Int kid = This.SlotKid(index, child);
                This.SlotSides(This.Slots[kid].Margin);
                Int outer = This.Slots[kid].DesiredW + This.sideL + This.sideR;
                This.SlotArrange(kid, cursor, contentY, outer, contentH);
                cursor = cursor + outer + spacing;
                child = child + 1;
            }
        }
        If (kind == "Grid" || kind == "Uniform") {
            Int columns = This.Slots[index].Columns.ToInt();
            Int rows = This.Slots[index].Rows.ToInt();
            If (columns < 1) { columns = 1; }
            If (kind == "Uniform") {
                rows = (count + columns - 1) / columns;
            }
            If (rows < 1) { rows = 1; }
            Int cellW = contentW / columns;
            Int cellH = contentH / rows;
            Int child = 0;
            While (child < count) {
                Int kid = This.SlotKid(index, child);
                Int column = This.Slots[kid].Column.ToInt();
                Int row = This.Slots[kid].Row.ToInt();
                Int columnSpan = This.Slots[kid].ColumnSpan.ToInt();
                Int rowSpan = This.Slots[kid].RowSpan.ToInt();
                If (kind == "Uniform") {
                    column = child - (child / columns) * columns;
                    row = child / columns;
                    columnSpan = 1;
                    rowSpan = 1;
                }
                If (columnSpan < 1) { columnSpan = 1; }
                If (rowSpan < 1) { rowSpan = 1; }
                This.SlotArrange(kid, contentX + column * cellW, contentY + row * cellH, cellW * columnSpan, cellH * rowSpan);
                child = child + 1;
            }
        }
        If (kind == "Dock") {
            Int left = contentX;
            Int top = contentY;
            Int right = contentX + contentW;
            Int bottom = contentY + contentH;
            Int child = 0;
            While (child < count) {
                Int kid = This.SlotKid(index, child);
                String dock = This.Slots[kid].Dock;
                If (dock == "Left") {
                    Int strip = This.Slots[kid].DesiredW;
                    This.SlotArrange(kid, left, top, strip, bottom - top);
                    left = left + strip;
                } Else {
                    If (dock == "Right") {
                        Int strip = This.Slots[kid].DesiredW;
                        right = right - strip;
                        This.SlotArrange(kid, right, top, strip, bottom - top);
                    } Else {
                        If (dock == "Top") {
                            Int strip = This.Slots[kid].DesiredH;
                            This.SlotArrange(kid, left, top, right - left, strip);
                            top = top + strip;
                        } Else {
                            If (dock == "Bottom") {
                                Int strip = This.Slots[kid].DesiredH;
                                bottom = bottom - strip;
                                This.SlotArrange(kid, left, bottom, right - left, strip);
                            } Else {
                                This.SlotArrange(kid, left, top, right - left, bottom - top);
                            }
                        }
                    }
                }
                child = child + 1;
            }
        }
        If (kind == "Wrap") {
            Int cursorX = contentX;
            Int cursorY = contentY;
            Int rowH = 0;
            Int child = 0;
            While (child < count) {
                Int kid = This.SlotKid(index, child);
                Int itemW = This.Slots[kid].DesiredW;
                Int itemH = This.Slots[kid].DesiredH;
                If (cursorX > contentX && cursorX + itemW > contentX + contentW) {
                    cursorX = contentX;
                    cursorY = cursorY + rowH + spacing;
                    rowH = 0;
                }
                This.SlotArrange(kid, cursorX, cursorY, itemW, itemH);
                cursorX = cursorX + itemW + spacing;
                If (itemH > rowH) { rowH = itemH; }
                child = child + 1;
            }
        }
        If (kind == "Canvas") {
            Int child = 0;
            While (child < count) {
                Int kid = This.SlotKid(index, child);
                This.SlotArrange(kid, contentX + This.Slots[kid].Column.ToInt(), contentY + This.Slots[kid].Row.ToInt(), This.Slots[kid].DesiredW, This.Slots[kid].DesiredH);
                child = child + 1;
            }
        }
        If (kind == "Overlay" || kind == "View") {
            Int child = 0;
            Int limit = count;
            If (kind == "View" && limit > 1) { limit = 1; }
            While (child < limit) {
                This.SlotArrange(This.SlotKid(index, child), contentX, contentY, contentW, contentH);
                child = child + 1;
            }
        }
        If (kind == "Flex") {
            Int autos = 0;
            Int fixed = 0;
            Int child = 0;
            While (child < count) {
                Int kid = This.SlotKid(index, child);
                String width = This.Slots[kid].Width;
                If (width == "Auto" || width == "Content" || width == "") {
                    autos = autos + 1;
                } Else {
                    fixed = fixed + This.Slots[kid].DesiredW;
                }
                child = child + 1;
            }
            Int gap = 0;
            If (count > 1) { gap = spacing * (count - 1); }
            Int remain = contentW - fixed - gap;
            If (remain < 0) { remain = 0; }
            Int share = 0;
            If (autos > 0) { share = remain / autos; }
            Int cursor = contentX;
            child = 0;
            While (child < count) {
                Int kid = This.SlotKid(index, child);
                String width = This.Slots[kid].Width;
                Int itemW = This.Slots[kid].DesiredW;
                If (width == "Auto" || width == "Content" || width == "") { itemW = share; }
                This.SlotArrange(kid, cursor, contentY, itemW, contentH);
                cursor = cursor + itemW + spacing;
                child = child + 1;
            }
        }
        If (kind == "Split") {
            Int pane = 0;
            If (count > 0) { pane = This.Slots[This.SlotKid(index, 0)].DesiredW; }
            If (count > 0) { This.SlotArrange(This.SlotKid(index, 0), contentX, contentY, pane, contentH); }
            If (count > 1) { This.SlotArrange(This.SlotKid(index, 1), contentX + pane, contentY, contentW - pane, contentH); }
        }
        If (kind == "Constraint" && count > 0) {
            Int kid = This.SlotKid(index, 0);
            Int itemW = This.Slots[kid].DesiredW;
            Int itemH = This.Slots[kid].DesiredH;
            Int atX = contentX + (contentW - itemW) / 2;
            Int atY = contentY + (contentH - itemH) / 2;
            This.SlotArrange(kid, atX, atY, itemW, itemH);
        }
        If (kind == "Tab") {
            Int child = 0;
            While (child < count) {
                If (child == 0) {
                    This.SlotArrange(This.SlotKid(index, child), contentX, contentY, contentW, contentH);
                } Else {
                    This.SlotArrange(This.SlotKid(index, child), contentX, contentY, 0, 0);
                }
                child = child + 1;
            }
        }
        If (kind == "Scroll" && count > 0) {
            Int kid = This.SlotKid(index, 0);
            This.SlotArrange(kid, contentX - This.Slots[index].ScrollX, contentY - This.Slots[index].ScrollY, This.Slots[kid].DesiredW, This.Slots[kid].DesiredH);
        }
    }

    Private Function SlotDevice(Int index, Int x, Int y, Int w, Int h) -> Void {
        Int left = This.Slots[index].X;
        Int top = This.Slots[index].Y;
        Int width = This.Slots[index].W;
        Int height = This.Slots[index].H;
        If (This.flow == "RTL") {
            Int parent = This.SlotIndex(This.Slots[index].Parent);
            Int origin = 0;
            Int space = width;
            If (parent >= 0) {
                origin = This.Slots[parent].X;
                space = This.Slots[parent].W;
            }
            left = origin + space - (This.Slots[index].X - origin) - width;
        }
        This.sideL = left * This.scale;
        This.sideT = top * This.scale;
        This.sideR = width * This.scale;
        This.sideB = height * This.scale;
    }

    Private Function SlotPaint(Int index, Bool clipped, Int clipX, Int clipY, Int clipW, Int clipH) -> Void {
        This.SlotDevice(index, 0, 0, 0, 0);
        Int x = This.sideL;
        Int y = This.sideT;
        Int w = This.sideR;
        Int h = This.sideB;
        Int drawX = x;
        Int drawY = y;
        Int drawW = w;
        Int drawH = h;
        If (clipped) {
            Int right = x + w;
            Int bottom = y + h;
            Int clipRight = clipX + clipW;
            Int clipBottom = clipY + clipH;
            If (drawX < clipX) { drawX = clipX; }
            If (drawY < clipY) { drawY = clipY; }
            If (right > clipRight) { right = clipRight; }
            If (bottom > clipBottom) { bottom = clipBottom; }
            drawW = right - drawX;
            drawH = bottom - drawY;
            If (drawW < 0) { drawW = 0; }
            If (drawH < 0) { drawH = 0; }
        }
        String kind = This.Slots[index].Kind;
        String id = This.Slots[index].Id;
        String brush = This.Slots[index].Background;
        If (kind == "Text") {
            This.Commands.Add("Text " + id + " " + drawX.ToString() + " " + drawY.ToString() + " " + drawW.ToString() + " " + drawH.ToString() + " " + This.Slots[index].Content);
        }
        If (kind == "Image") {
            This.Commands.Add("Image " + id + " " + drawX.ToString() + " " + drawY.ToString() + " " + drawW.ToString() + " " + drawH.ToString());
        }
        If (kind == "Rect") {
            This.Commands.Add("Fill " + id + " " + drawX.ToString() + " " + drawY.ToString() + " " + drawW.ToString() + " " + drawH.ToString() + " " + brush);
        }
        If (kind == "Border") {
            This.Commands.Add("Border " + id + " " + drawX.ToString() + " " + drawY.ToString() + " " + drawW.ToString() + " " + drawH.ToString());
        }
        If (kind == "Path") {
            This.Commands.Add("Path " + id + " " + drawX.ToString() + " " + drawY.ToString() + " " + drawW.ToString() + " " + drawH.ToString());
        }
        If (kind == "Shadow") {
            This.Commands.Add("Shadow " + id + " " + drawX.ToString() + " " + drawY.ToString() + " " + drawW.ToString() + " " + drawH.ToString());
        }
        Bool clips = This.Slots[index].Clip == "true" || kind == "View" || kind == "Scroll";
        Int nextX = clipX;
        Int nextY = clipY;
        Int nextW = clipW;
        Int nextH = clipH;
        Bool nextClip = clipped;
        If (clips) {
            This.Commands.Add("Clip " + x.ToString() + " " + y.ToString() + " " + w.ToString() + " " + h.ToString());
            nextX = x;
            nextY = y;
            nextW = w;
            nextH = h;
            If (clipped) {
                Int right = x + w;
                Int bottom = y + h;
                Int clipRight = clipX + clipW;
                Int clipBottom = clipY + clipH;
                If (nextX < clipX) { nextX = clipX; }
                If (nextY < clipY) { nextY = clipY; }
                If (right > clipRight) { right = clipRight; }
                If (bottom > clipBottom) { bottom = clipBottom; }
                nextW = right - nextX;
                nextH = bottom - nextY;
                If (nextW < 0) { nextW = 0; }
                If (nextH < 0) { nextH = 0; }
            }
            nextClip = True;
        }
        Int child = 0;
        While (child < This.SlotKids(index)) {
            This.SlotPaint(This.SlotKid(index, child), nextClip, nextX, nextY, nextW, nextH);
            child = child + 1;
        }
        If (clips) {
            This.Commands.Add("Pop");
        }
    }
}

Public Class MvpHost {
    Public List<String> ids;
    Public List<String> kinds;
    Public List<String> texts;
    Public List<String> enabledFlags;
    Public List<String> visibles;
    Public List<String> checks;
    Public List<String> backgrounds;
    Public List<String> extras;
    Public List<String> locals;
    Public List<String> binds;
    Public List<String> sources;
    Public List<String> styles;
    Public List<String> rows;
    Private String focus;
    Private String notice;
    Private String theme;
    Private String spinning;
    Private Int clicks;
    Private Int changes;

    Public Constructor() {
        This.ids = List<String>();
        This.kinds = List<String>();
        This.texts = List<String>();
        This.enabledFlags = List<String>();
        This.visibles = List<String>();
        This.checks = List<String>();
        This.backgrounds = List<String>();
        This.extras = List<String>();
        This.locals = List<String>();
        This.binds = List<String>();
        This.sources = List<String>();
        This.styles = List<String>();
        This.rows = List<String>();
        This.focus = "";
        This.notice = "";
        This.theme = "#336699";
        This.spinning = "";
        This.clicks = 0;
        This.changes = 0;
    }

    Public Function ImportMvp(RxuNode node) -> Int
    Explain {
        Description: "Import MVP controls from markup.";
        Input: node = "Document or element";
        Processing: "Record each known control and walk its children.";
        Output: "The number of imported controls.";
    } {
        If (node.Kind != "Element") {
            Int count = 0;
            Int index = 0;
            While (index < node.Children.Count()) {
                count = count + This.ImportMvp(node.Children[index]);
                index = index + 1;
            }
            Return count;
        }
        String kind = node.Name + "";
        If (!This.MvpKnown(kind)) {
            kind = node.FindAttribute("Tag").Text + "";
        }
        Int count = 0;
        String id = node.FindAttribute("Name").Text + "";
        If (This.MvpKnown(kind) && id != "" && This.MvpIndex(id) < 0) {
            This.ids.Add(id);
            This.kinds.Add(kind);
            String content = node.FindAttribute("Content").Text + "";
            If (content == "") {
                content = node.FindAttribute("Title").Text + "";
            }
            If (content == "") {
                content = node.FindAttribute("Text").Text + "";
            }
            This.texts.Add(content);
            String enabled = node.FindAttribute("Enabled").Text + "";
            If (enabled != "false") {
                enabled = "true";
            }
            This.enabledFlags.Add(enabled);
            String visible = node.FindAttribute("Visible").Text + "";
            If (visible != "false") {
                visible = "true";
            }
            This.visibles.Add(visible);
            String checked = node.FindAttribute("Checked").Text + "";
            If (checked != "true") {
                checked = "false";
            }
            This.checks.Add(checked);
            This.backgrounds.Add("");
            This.MvpBagPut(id, "Width", This.MvpOr(node.FindAttribute("Width").Text, "Auto"));
            This.MvpBagPut(id, "Height", This.MvpOr(node.FindAttribute("Height").Text, "Auto"));
            This.MvpBagPut(id, "Source", node.FindAttribute("Source").Text + "");
            This.MvpBagPut(id, "Placeholder", node.FindAttribute("Placeholder").Text + "");
            This.MvpBagPut(id, "Orientation", This.MvpOr(node.FindAttribute("Orientation").Text, "Vertical"));
            This.MvpBagPut(id, "Columns", This.MvpOr(node.FindAttribute("Columns").Text, "1"));
            This.MvpBagPut(id, "Rows", This.MvpOr(node.FindAttribute("Rows").Text, "1"));
            This.MvpBagPut(id, "Spacing", This.MvpOr(node.FindAttribute("Spacing").Text, "0"));
            count = 1;
        }
        Int child = 0;
        While (child < node.Children.Count()) {
            count = count + This.ImportMvp(node.Children[child]);
            child = child + 1;
        }
        Return count;
    }

    Public Function AddMvp(String kind, String id) -> Bool
    Explain {
        Description: "Add one control at runtime.";
        Input: kind = "Control kind", id = "New control name";
        Processing: "Reject an unknown kind or a duplicate name.";
        Output: "True when the control was added.";
    } {
        If (!This.MvpKnown(kind) || id == "" || This.MvpIndex(id) >= 0) {
            Return False;
        }
        This.ids.Add(id);
        This.kinds.Add(kind);
        This.texts.Add("");
        This.enabledFlags.Add("true");
        This.visibles.Add("true");
        This.checks.Add("false");
        This.backgrounds.Add("");
        This.MvpBagPut(id, "Width", "Auto");
        This.MvpBagPut(id, "Height", "Auto");
        Return True;
    }

    Public Function PutField(String id, String field, String value) -> Bool
    Explain {
        Description: "Set one control property.";
        Input: id = "Control name", field = "Property name", value = "New value";
        Processing: "Reject a mistyped value and keep the previous one. A successful write is local.";
        Output: "True when the value was stored.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0 || !This.MvpValid(field, value)) {
            Return False;
        }
        This.MvpApply(index, field, value);
        This.MvpMark(id, field);
        This.changes = This.changes + 1;
        Return True;
    }

    Public Function ReadField(String id, String field) -> String
    Explain {
        Description: "Read one control property.";
        Input: id = "Control name", field = "Property name";
        Processing: "Return the stored value, or the theme color when Color was not set.";
        Output: "The value, or empty text when the control is missing.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0) {
            Return "";
        }
        If (field == "Content" || field == "Title" || field == "Text") {
            Return This.texts[index];
        }
        If (field == "Enabled") {
            Return This.enabledFlags[index];
        }
        If (field == "Visible") {
            Return This.visibles[index];
        }
        If (field == "Checked") {
            Return This.checks[index];
        }
        If (field == "Background") {
            Return This.backgrounds[index];
        }
        If (field == "Kind") {
            Return This.kinds[index];
        }
        If (field == "Color") {
            String color = This.MvpBag(id, "Color");
            If (color == "") {
                Return This.theme;
            }
            Return color;
        }
        If (field == "Count") {
            Return This.MvpRows(id, -1);
        }
        If (field.StartsWith("Item")) {
            Int item = field.Substring(4).ToInt();
            Return This.MvpRows(id, item);
        }
        Return This.MvpBag(id, field);
    }

    Public Function PressMvp(String id) -> Bool
    Explain {
        Description: "Click a button.";
        Input: id = "Button name";
        Processing: "Ignore a disabled, hidden, or non-button control.";
        Output: "True when the click was counted.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0 || This.kinds[index] != "Button" || This.enabledFlags[index] != "true" || This.visibles[index] != "true") {
            Return False;
        }
        This.clicks = This.clicks + 1;
        Return True;
    }

    Public Function TypeMvp(String id, String value) -> Bool
    Explain {
        Description: "Type into the focused text box.";
        Input: id = "Text box name", value = "Characters to append";
        Processing: "Require focus and an enabled text box.";
        Output: "True when the text changed.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0 || This.focus != id || This.kinds[index] != "TextBox" || This.enabledFlags[index] != "true") {
            Return False;
        }
        This.texts[index] = This.texts[index] + value;
        This.changes = This.changes + 1;
        Return True;
    }

    Public Function ToggleMvp(String id) -> Bool
    Explain {
        Description: "Toggle a check box.";
        Input: id = "Check box name";
        Processing: "Flip Checked when the control is an enabled check box.";
        Output: "True when the value flipped.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0 || This.kinds[index] != "CheckBox" || This.enabledFlags[index] != "true") {
            Return False;
        }
        If (This.checks[index] == "true") {
            This.checks[index] = "false";
        } Else {
            This.checks[index] = "true";
        }
        This.changes = This.changes + 1;
        Return True;
    }

    Public Function FocusMvp(String id) -> Bool
    Explain {
        Description: "Move keyboard focus.";
        Input: id = "Control name";
        Processing: "Focus an enabled button, text box, or check box.";
        Output: "True when focus moved.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0 || !This.MvpFocusable(index)) {
            Return False;
        }
        This.focus = id + "";
        Return True;
    }

    Public Function KeyMvp(String id, String key) -> Bool
    Explain {
        Description: "Move focus from the keyboard.";
        Input: id = "Focused control", key = "Tab or ShiftTab";
        Processing: "Tab moves to the next focusable control. ShiftTab moves to the previous one.";
        Output: "True when focus moved.";
    } {
        If (This.focus != id) {
            Return False;
        }
        Int step = 0;
        If (key == "Tab") {
            step = 1;
        }
        If (key == "ShiftTab") {
            step = -1;
        }
        If (step == 0) {
            Return False;
        }
        String next = This.MvpStep(id, step);
        If (next == "") {
            Return False;
        }
        This.focus = next + "";
        Return True;
    }

    Public Function BindMvp(String id, String field, String path) -> Bool
    Explain {
        Description: "Bind a control property to a source path.";
        Input: id = "Control name", field = "Property name", path = "Source path";
        Processing: "Store the binding and apply the current source when the property is not local.";
        Output: "True when the control exists.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0 || field == "" || path == "") {
            Return False;
        }
        This.binds.Add(id + "." + field + "=" + path);
        String current = This.MvpSource(path);
        If (current != "" && !This.MvpLocal(id, field)) {
            This.MvpApply(index, field, current);
        }
        Return True;
    }

    Public Function PushMvp(String path, String value) -> Int
    Explain {
        Description: "Change a binding source.";
        Input: path = "Source path", value = "New source value";
        Processing: "Update every bound property that was not set locally.";
        Output: "The number of controls updated.";
    } {
        This.MvpSourcePut(path, value);
        Int updated = 0;
        Int index = 0;
        While (index < This.binds.Count()) {
            String row = This.binds[index];
            Int mark = row.IndexOf("=");
            If (mark > 0 && row.Substring(mark + 1) == path) {
                String head = row.Substring(0, mark);
                Int dot = head.IndexOf(".");
                If (dot > 0) {
                    String id = head.Substring(0, dot);
                    String field = head.Substring(dot + 1);
                    Int slot = This.MvpIndex(id);
                    If (slot >= 0 && !This.MvpLocal(id, field)) {
                        This.MvpApply(slot, field, value);
                        updated = updated + 1;
                    }
                }
            }
            index = index + 1;
        }
        Return updated;
    }

    Public Function StyleMvp(String name, String background) -> Bool
    Explain {
        Description: "Store a named style.";
        Input: name = "Style name", background = "Background color";
        Processing: "Remember the background for a later apply.";
        Output: "True when the color is a hex color.";
    } {
        If (name == "" || !This.MvpColor(background)) {
            Return False;
        }
        This.styles.Add(name + "=" + background);
        Return True;
    }

    Public Function ApplyMvp(String id, String name) -> Bool
    Explain {
        Description: "Apply a named style.";
        Input: id = "Control name", name = "Style name";
        Processing: "Set the background unless a local background already won.";
        Output: "True when the style exists.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0) {
            Return False;
        }
        String background = "";
        Int cursor = 0;
        While (cursor < This.styles.Count()) {
            String row = This.styles[cursor];
            If (row.StartsWith(name + "=")) {
                background = row.Substring(name.Length() + 1);
            }
            cursor = cursor + 1;
        }
        If (background == "") {
            Return False;
        }
        If (!This.MvpLocal(id, "Background")) {
            This.backgrounds[index] = background + "";
        }
        Return True;
    }

    Public Function UseTheme(String name) -> Bool
    Explain {
        Description: "Select the shared theme color.";
        Input: name = "Light or Dark";
        Processing: "Light and Dark choose the color inherited by controls without a local color.";
        Output: "True when the theme name is known.";
    } {
        If (name == "Light") {
            This.theme = "#F4F7FB";
            Return True;
        }
        If (name == "Dark") {
            This.theme = "#112233";
            Return True;
        }
        Return False;
    }

    Public Function AddRow(String id, String item) -> Bool
    Explain {
        Description: "Append one list row.";
        Input: id = "List view name", item = "Row text";
        Processing: "Reject a control that is not a list view.";
        Output: "True when the row was added.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0 || This.kinds[index] != "ListView") {
            Return False;
        }
        This.rows.Add(id + "=" + item);
        This.changes = This.changes + 1;
        Return True;
    }

    Public Function RemoveRow(String id, Int item) -> Bool
    Explain {
        Description: "Remove one list row.";
        Input: id = "List view name", item = "Zero-based row";
        Processing: "Drop that row and keep the others in order.";
        Output: "True when the row existed.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0 || This.kinds[index] != "ListView" || item < 0) {
            Return False;
        }
        List<String> kept = List<String>();
        Int seen = 0;
        Bool removed = False;
        Int cursor = 0;
        While (cursor < This.rows.Count()) {
            String row = This.rows[cursor];
            Bool drop = False;
            If (row.StartsWith(id + "=")) {
                If (seen == item) {
                    drop = True;
                    removed = True;
                }
                seen = seen + 1;
            }
            If (!drop) {
                kept.Add(row);
            }
            cursor = cursor + 1;
        }
        This.rows = kept;
        If (removed) {
            This.changes = This.changes + 1;
        }
        Return removed;
    }

    Public Function OpenNotice(String id) -> Bool
    Explain {
        Description: "Open a dialog.";
        Input: id = "Dialog name";
        Processing: "Show that dialog.";
        Output: "True when the control is a dialog.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0 || This.kinds[index] != "Dialog") {
            Return False;
        }
        This.notice = id + "";
        Return True;
    }

    Public Function CloseNotice() -> Bool
    Explain {
        Description: "Close the open dialog.";
        Input: None;
        Processing: "Clear the open notice.";
        Output: "True when a dialog was open.";
    } {
        If (This.notice == "") {
            Return False;
        }
        This.notice = "";
        Return True;
    }

    Public Function SpinMvp(String id, Bool active) -> Bool
    Explain {
        Description: "Start or stop a spinner.";
        Input: id = "Spinner name", active = "True while work is in progress";
        Processing: "Only a spinner can become the active indicator.";
        Output: "True when the control is a spinner.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0 || This.kinds[index] != "Spinner") {
            Return False;
        }
        If (active) {
            This.spinning = id + "";
        } Else {
            If (This.spinning == id) {
                This.spinning = "";
            }
        }
        Return True;
    }

    Public Function MvpCount() -> Int
    Explain {
        Description: "Return how many controls are loaded.";
        Input: None;
        Processing: "Read the control list.";
        Output: "The number of controls.";
    } {
        Return This.ids.Count();
    }

    Public Function MvpKind(String id) -> String
    Explain {
        Description: "Return one control kind.";
        Input: id = "Control name";
        Processing: "Read the stored kind.";
        Output: "The kind, or empty text when the control is missing.";
    } {
        Int index = This.MvpIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.kinds[index];
    }

    Public Function ClickTally() -> Int
    Explain {
        Description: "Return how many button clicks were accepted.";
        Input: None;
        Processing: "Read the click counter.";
        Output: "The number of accepted clicks.";
    } {
        Return This.clicks;
    }

    Public Function ChangeTally() -> Int
    Explain {
        Description: "Return how many values changed.";
        Input: None;
        Processing: "Read the change counter.";
        Output: "The number of accepted edits.";
    } {
        Return This.changes;
    }

    Public Function FocusName() -> String
    Explain {
        Description: "Return the focused control.";
        Input: None;
        Processing: "Read the focus name.";
        Output: "The focused name, or empty text.";
    } {
        Return This.focus;
    }

    Public Function NoticeOpen() -> String
    Explain {
        Description: "Return the open dialog.";
        Input: None;
        Processing: "Read the notice name.";
        Output: "The dialog name, or empty text.";
    } {
        Return This.notice;
    }

    Public Function Spinning() -> String
    Explain {
        Description: "Return the active spinner.";
        Input: None;
        Processing: "Read the spinner name.";
        Output: "The spinner name, or empty text.";
    } {
        Return This.spinning;
    }

    Private Function MvpIndex(String id) -> Int {
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.ids[index] == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function MvpKnown(String kind) -> Bool {
        String names = "Window,View,Panel,StackPanel,Grid,Text,Image,Button,TextBox,CheckBox,ScrollView,ListView,Dialog,Spinner";
        Int index = 0;
        While (index < This.MvpParts(names)) {
            If (This.MvpPart(names, index) == kind) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function MvpValid(String field, String value) -> Bool {
        If (field == "Content" || field == "Title" || field == "Text" || field == "Source" || field == "Placeholder") {
            Return True;
        }
        If (field == "Enabled" || field == "Visible" || field == "Checked") {
            Return value == "true" || value == "false";
        }
        If (field == "Width" || field == "Height") {
            Return This.MvpSize(value);
        }
        If (field == "Opacity") {
            Return This.MvpOpacity(value);
        }
        If (field == "Columns" || field == "Rows" || field == "Spacing" || field == "Offset") {
            Return This.MvpDigits(value);
        }
        If (field == "Orientation") {
            Return value == "Horizontal" || value == "Vertical";
        }
        If (field == "Background" || field == "Color") {
            Return This.MvpColor(value);
        }
        Return False;
    }

    Private Function MvpApply(Int index, String field, String value) -> Void {
        If (field == "Content" || field == "Title" || field == "Text") {
            This.texts[index] = value + "";
            Return;
        }
        If (field == "Enabled") {
            This.enabledFlags[index] = value + "";
            Return;
        }
        If (field == "Visible") {
            This.visibles[index] = value + "";
            Return;
        }
        If (field == "Checked") {
            This.checks[index] = value + "";
            Return;
        }
        If (field == "Background") {
            This.backgrounds[index] = value + "";
            Return;
        }
        This.MvpBagPut(This.ids[index], field, value);
    }

    Private Function MvpMark(String id, String field) -> Void {
        If (This.MvpLocal(id, field)) {
            Return;
        }
        This.locals.Add(id + "." + field);
    }

    Private Function MvpLocal(String id, String field) -> Bool {
        String key = id + "." + field;
        Int index = 0;
        While (index < This.locals.Count()) {
            If (This.locals[index] == key) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function MvpFocusable(Int index) -> Bool {
        String kind = This.kinds[index];
        If (This.enabledFlags[index] != "true" || This.visibles[index] != "true") {
            Return False;
        }
        Return kind == "Button" || kind == "TextBox" || kind == "CheckBox";
    }

    Private Function MvpStep(String id, Int step) -> String {
        Int index = This.MvpIndex(id);
        Int cursor = index + step;
        While (cursor >= 0 && cursor < This.ids.Count()) {
            If (This.MvpFocusable(cursor)) {
                Return This.ids[cursor];
            }
            cursor = cursor + step;
        }
        Return "";
    }

    Private Function MvpBag(String id, String field) -> String {
        String key = id + "." + field + "=";
        Int index = 0;
        While (index < This.extras.Count()) {
            String row = This.extras[index];
            If (row.StartsWith(key)) {
                If (row.Length() <= key.Length()) {
                    Return "";
                }
                Return row.Substring(key.Length());
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function MvpBagPut(String id, String field, String value) -> Void {
        String key = id + "." + field + "=";
        List<String> kept = List<String>();
        Int index = 0;
        While (index < This.extras.Count()) {
            String row = This.extras[index];
            If (!row.StartsWith(key)) {
                kept.Add(row);
            }
            index = index + 1;
        }
        kept.Add(key + value);
        This.extras = kept;
    }

    Private Function MvpSource(String path) -> String {
        String key = path + "=";
        Int index = 0;
        While (index < This.sources.Count()) {
            String row = This.sources[index];
            If (row.StartsWith(key)) {
                If (row.Length() <= key.Length()) {
                    Return "";
                }
                Return row.Substring(key.Length());
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function MvpSourcePut(String path, String value) -> Void {
        String key = path + "=";
        List<String> kept = List<String>();
        Int index = 0;
        While (index < This.sources.Count()) {
            String row = This.sources[index];
            If (!row.StartsWith(key)) {
                kept.Add(row);
            }
            index = index + 1;
        }
        kept.Add(key + value);
        This.sources = kept;
    }

    Private Function MvpRows(String id, Int item) -> String {
        Int seen = 0;
        Int index = 0;
        String prefix = id + "=";
        While (index < This.rows.Count()) {
            String row = This.rows[index];
            If (row.StartsWith(prefix)) {
                If (item < 0) {
                    seen = seen + 1;
                } Else {
                    If (seen == item) {
                        If (row.Length() <= prefix.Length()) {
                            Return "";
                        }
                        Return row.Substring(prefix.Length());
                    }
                    seen = seen + 1;
                }
            }
            index = index + 1;
        }
        If (item < 0) {
            Return seen.ToString();
        }
        Return "";
    }

    Private Function MvpOr(String value, String fallback) -> String {
        If (value == "") {
            Return fallback;
        }
        Return value + "";
    }

    Private Function MvpSize(String value) -> Bool {
        If (value == "Auto" || value == "*") {
            Return True;
        }
        String body = value + "";
        If (value.EndsWith("px") && value.Length() > 2) {
            body = value.Substring(0, value.Length() - 2);
        } Else {
            If (value.EndsWith("*") && value.Length() > 1) {
                body = value.Substring(0, value.Length() - 1);
            }
        }
        Return This.MvpDigits(body);
    }

    Private Function MvpOpacity(String value) -> Bool {
        If (value == "0" || value == "1") {
            Return True;
        }
        If (!value.StartsWith("0.") || value.Length() < 3) {
            Return False;
        }
        Return This.MvpDigits(value.Substring(2));
    }

    Private Function MvpDigits(String value) -> Bool {
        If (value.Length() == 0) {
            Return False;
        }
        Int index = 0;
        While (index < value.Length()) {
            String character = value.GetChar(index);
            If (character < "0" || character > "9") {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function MvpColor(String value) -> Bool {
        If (value.Length() != 7 || !value.StartsWith("#")) {
            Return False;
        }
        Int index = 1;
        While (index < value.Length()) {
            String character = value.GetChar(index);
            Bool digit = character >= "0" && character <= "9";
            Bool lower = character >= "a" && character <= "f";
            Bool upper = character >= "A" && character <= "F";
            If (!digit && !lower && !upper) {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function MvpParts(String text) -> Int {
        Int count = 1;
        Int index = 0;
        While (index < text.Length()) {
            If (text.GetChar(index) == ",") {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function MvpPart(String text, Int item) -> String {
        Int seen = 0;
        Int start = 0;
        Int index = 0;
        While (index <= text.Length()) {
            Bool boundary = index == text.Length();
            If (!boundary) {
                boundary = text.GetChar(index) == ",";
            }
            If (boundary) {
                If (seen == item) {
                    Return text.Substring(start, index - start);
                }
                seen = seen + 1;
                start = index + 1;
            }
            index = index + 1;
        }
        Return "";
    }
}

Public Class EventHost {
    Private List<String> ids;
    Private List<String> kinds;
    Private List<String> parents;
    Private List<String> aliveFlags;
    Private List<String> handlerNames;
    Private List<String> handlerSigns;
    Private List<String> watchScope;
    Private List<String> watchId;
    Private List<String> watchEvent;
    Private List<String> watchHandler;
    Private List<String> watchPhase;
    Private List<String> watchPriority;
    Private List<String> watchOrder;
    Private List<String> watchLive;
    Private List<String> trace;
    Private Int mismatches;
    Private Int exceptions;
    Private Int depth;
    Private Int serial;
    Private String origin;
    Private String button;
    Private String pressedKey;
    Private String typedText;
    Private Int pointX;
    Private Int pointY;
    Private Bool cancelled;
    Private Bool consumed;
    Private String lastAction;
    Private String catalog;

    Public Constructor() {
        This.ids = List<String>();
        This.kinds = List<String>();
        This.parents = List<String>();
        This.aliveFlags = List<String>();
        This.handlerNames = List<String>();
        This.handlerSigns = List<String>();
        This.watchScope = List<String>();
        This.watchId = List<String>();
        This.watchEvent = List<String>();
        This.watchHandler = List<String>();
        This.watchPhase = List<String>();
        This.watchPriority = List<String>();
        This.watchOrder = List<String>();
        This.watchLive = List<String>();
        This.trace = List<String>();
        This.mismatches = 0;
        This.exceptions = 0;
        This.depth = 0;
        This.serial = 0;
        This.origin = "";
        This.button = "";
        This.pressedKey = "";
        This.typedText = "";
        This.pointX = 0;
        This.pointY = 0;
        This.cancelled = False;
        This.consumed = False;
        This.lastAction = "";
        This.catalog = "OnClick,OnDoubleClick,OnPointerDown,OnPointerUp,OnPointerMove,OnPointerEnter,OnPointerLeave,OnPointerCancel,OnMouseDown,OnMouseUp,OnMouseMove,OnMouseEnter,OnMouseLeave,OnMouseWheel,OnContextMenu,OnRightClick,OnMiddleClick,OnPressed,OnReleased,OnHover,OnLeave,OnKeyDown,OnKeyUp,OnKeyPress,OnTextInput,OnShortcut,OnFocus,OnBlur,OnTab,OnEscape,OnEnter,OnCreate,OnInitialize,OnLoad,OnLoaded,OnUnload,OnUnloaded,OnDestroy,OnDispose,OnShow,OnHide,OnEnable,OnDisable,OnUpdate,OnChange,OnValueChange,OnTextChange,OnInput,OnSubmit,OnSelect,OnDeselect,OnChecked,OnUnchecked,OnExpand,OnCollapse,OnWindowOpen,OnWindowClose,OnWindowClosing,OnWindowResize,OnWindowMove,OnWindowMinimize,OnWindowMaximize,OnWindowRestore,OnWindowFocus,OnWindowBlur,OnDragStart,OnDrag,OnDragEnd,OnDragEnter,OnDragLeave,OnDragOver,OnDrop,OnResize,OnMove,OnLayout,OnMeasure,OnRender,OnVisibilityChange,OnSizeChange,OnPositionChange,OnAnimationStart,OnAnimationUpdate,OnAnimationComplete,OnAnimationCancel";
    }

    Public Function ImportEvents(RxuNode node) -> Int
    Explain {
        Description: "Import controls and On* handlers from markup.";
        Input: node = "Document or element";
        Processing: "Record each named control, bind On* attributes whose handler signature is Event, and raise the load events.";
        Output: "The number of imported controls.";
    } {
        Return This.EvtWalk(node, "");
    }

    Public Function NoteHandler(String name, String signature) -> Bool
    Explain {
        Description: "Register the signature of an RX handler.";
        Input: name = "Handler name", signature = "Event, Throws, or another type name";
        Processing: "Store or replace the signature used when a handler is bound.";
        Output: "True when the name and signature are both present.";
    } {
        If (name == "" || signature == "") {
            Return False;
        }
        Int index = 0;
        While (index < This.handlerNames.Count()) {
            If (This.handlerNames[index] == name) {
                This.handlerSigns[index] = signature + "";
                Return True;
            }
            index = index + 1;
        }
        This.handlerNames.Add(name);
        This.handlerSigns.Add(signature);
        Return True;
    }

    Public Function WatchEvent(String scope, String id, String eventName, String handler, String phase, Int priority) -> Bool
    Explain {
        Description: "Subscribe a handler, the += operation.";
        Input: scope = "Component, Document, or Global", id = "Control name", eventName = "Event name", handler = "Handler name", phase = "Capture or Bubble", priority = "Higher runs first";
        Processing: "Reject an unknown event, a dead control, or a handler whose signature is not Event or Throws.";
        Output: "True when the subscription was stored.";
    } {
        If (scope != "Component" && scope != "Document" && scope != "Global") {
            Return False;
        }
        If (phase != "Capture" && phase != "Bubble") {
            Return False;
        }
        If (!This.EvtKnown(eventName)) {
            Return False;
        }
        String sign = This.EvtSignature(handler);
        If (sign != "Event" && sign != "Throws") {
            This.mismatches = This.mismatches + 1;
            Return False;
        }
        String stored = id + "";
        If (scope != "Component") {
            stored = "*";
        } Else {
            If (!This.EvtAlive(id)) {
                Return False;
            }
        }
        This.watchScope.Add(scope);
        This.watchId.Add(stored);
        This.watchEvent.Add(eventName);
        This.watchHandler.Add(handler);
        This.watchPhase.Add(phase);
        This.watchPriority.Add(priority.ToString());
        This.watchOrder.Add(This.serial.ToString());
        This.watchLive.Add("true");
        This.serial = This.serial + 1;
        Return True;
    }

    Public Function UnwatchEvent(String scope, String id, String eventName, String handler, String phase) -> Bool
    Explain {
        Description: "Unsubscribe a handler, the -= operation.";
        Input: scope = "Component, Document, or Global", id = "Control name", eventName = "Event name", handler = "Handler name", phase = "Capture or Bubble";
        Processing: "Mark the first matching live subscription dead.";
        Output: "True when a subscription was removed.";
    } {
        String stored = id + "";
        If (scope != "Component") {
            stored = "*";
        }
        Int index = 0;
        While (index < This.watchLive.Count()) {
            If (This.watchLive[index] == "true" && This.watchScope[index] == scope && This.watchId[index] == stored && This.watchEvent[index] == eventName && This.watchHandler[index] == handler && This.watchPhase[index] == phase) {
                This.watchLive[index] = "false";
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Public Function RaiseEvent(String id, String eventName, String source) -> Int
    Explain {
        Description: "Raise one event.";
        Input: id = "Target control", eventName = "Event name", source = "Real or Synthetic";
        Processing: "Route capture, the target, bubble, the document, then the global scope.";
        Output: "The number of handlers that ran.";
    } {
        If (!This.EvtKnown(eventName) || (source != "Real" && source != "Synthetic") || !This.EvtAlive(id)) {
            Return 0;
        }
        This.origin = source + "";
        This.cancelled = False;
        This.consumed = False;
        This.depth = This.depth + 1;
        Int fired = This.EvtRoute(id, eventName, source);
        This.depth = This.depth - 1;
        Return fired;
    }

    Public Function ClickEvent(String id) -> Int
    Explain {
        Description: "Click a control.";
        Input: id = "Control name";
        Processing: "Raise OnClick as real input with the left button.";
        Output: "The number of handlers that ran.";
    } {
        This.button = "Left";
        Return This.RaiseEvent(id, "OnClick", "Real");
    }

    Public Function PointEvent(String id, String eventName, Int x, Int y, String buttonName) -> Int
    Explain {
        Description: "Raise a pointer or mouse event with coordinates.";
        Input: id = "Control name", eventName = "Pointer event", x = "X", y = "Y", buttonName = "Left, Middle, Right, or Wheel";
        Processing: "Store the point and button, then raise the event as real input.";
        Output: "The number of handlers that ran.";
    } {
        This.pointX = x;
        This.pointY = y;
        This.button = buttonName + "";
        Return This.RaiseEvent(id, eventName, "Real");
    }

    Public Function KeyIn(String id, String eventName, String keyName, String text) -> Int
    Explain {
        Description: "Raise a keyboard event.";
        Input: id = "Control name", eventName = "Keyboard event", keyName = "Key name", text = "Inserted text";
        Processing: "Store the key and text. Enter, Tab, and Escape also raise their named events. A key press with text also raises OnTextInput.";
        Output: "The number of handlers that ran.";
    } {
        This.pressedKey = keyName + "";
        This.typedText = text + "";
        Int fired = This.RaiseEvent(id, eventName, "Real");
        If (eventName == "OnKeyDown" && keyName == "Enter") {
            fired = fired + This.RaiseEvent(id, "OnEnter", "Real");
        }
        If (eventName == "OnKeyDown" && keyName == "Tab") {
            fired = fired + This.RaiseEvent(id, "OnTab", "Real");
        }
        If (eventName == "OnKeyDown" && keyName == "Escape") {
            fired = fired + This.RaiseEvent(id, "OnEscape", "Real");
        }
        If (eventName == "OnKeyPress" && text != "") {
            fired = fired + This.RaiseEvent(id, "OnTextInput", "Real");
        }
        Return fired;
    }

    Public Function RunAction(String id, String action) -> String
    Explain {
        Description: "Run a component action on the UI thread.";
        Input: id = "Control name", action = "Action name";
        Processing: "A nested call during dispatch returns Busy and changes nothing. Otherwise the action raises its events.";
        Output: "Ok, Busy, Missing, or Rejected.";
    } {
        If (This.depth > 0) {
            Return "Busy";
        }
        If (!This.EvtAlive(id)) {
            Return "Missing";
        }
        If (action == "Enable") {
            This.RaiseEvent(id, "OnEnable", "Real");
            Return "Ok";
        }
        If (action == "Disable") {
            This.RaiseEvent(id, "OnDisable", "Real");
            Return "Ok";
        }
        If (action == "Show") {
            This.RaiseEvent(id, "OnShow", "Real");
            This.RaiseEvent(id, "OnVisibilityChange", "Real");
            Return "Ok";
        }
        If (action == "Hide") {
            This.RaiseEvent(id, "OnHide", "Real");
            This.RaiseEvent(id, "OnVisibilityChange", "Real");
            Return "Ok";
        }
        If (action == "Submit") {
            This.RaiseEvent(id, "OnSubmit", "Real");
            Return "Ok";
        }
        If (action == "Select") {
            This.RaiseEvent(id, "OnSelect", "Real");
            Return "Ok";
        }
        If (action == "Deselect") {
            This.RaiseEvent(id, "OnDeselect", "Real");
            Return "Ok";
        }
        If (action == "Check") {
            This.RaiseEvent(id, "OnChecked", "Real");
            Return "Ok";
        }
        If (action == "Uncheck") {
            This.RaiseEvent(id, "OnUnchecked", "Real");
            Return "Ok";
        }
        If (action == "Expand") {
            This.RaiseEvent(id, "OnExpand", "Real");
            Return "Ok";
        }
        If (action == "Collapse") {
            This.RaiseEvent(id, "OnCollapse", "Real");
            Return "Ok";
        }
        If (action == "Open") {
            This.RaiseEvent(id, "OnWindowOpen", "Real");
            Return "Ok";
        }
        If (action == "Close") {
            This.RaiseEvent(id, "OnWindowClosing", "Real");
            If (!This.cancelled) {
                This.RaiseEvent(id, "OnWindowClose", "Real");
            }
            Return "Ok";
        }
        If (action == "Resize") {
            This.RaiseEvent(id, "OnResize", "Real");
            This.RaiseEvent(id, "OnSizeChange", "Real");
            This.RaiseEvent(id, "OnWindowResize", "Real");
            Return "Ok";
        }
        If (action == "Move") {
            This.RaiseEvent(id, "OnMove", "Real");
            This.RaiseEvent(id, "OnPositionChange", "Real");
            This.RaiseEvent(id, "OnWindowMove", "Real");
            Return "Ok";
        }
        If (action == "Minimize") {
            This.RaiseEvent(id, "OnWindowMinimize", "Real");
            Return "Ok";
        }
        If (action == "Maximize") {
            This.RaiseEvent(id, "OnWindowMaximize", "Real");
            Return "Ok";
        }
        If (action == "Restore") {
            This.RaiseEvent(id, "OnWindowRestore", "Real");
            Return "Ok";
        }
        If (action == "Focus") {
            This.RaiseEvent(id, "OnFocus", "Real");
            This.RaiseEvent(id, "OnWindowFocus", "Real");
            Return "Ok";
        }
        If (action == "Blur") {
            This.RaiseEvent(id, "OnBlur", "Real");
            This.RaiseEvent(id, "OnWindowBlur", "Real");
            Return "Ok";
        }
        If (action == "Drag") {
            This.RaiseEvent(id, "OnDragStart", "Real");
            Return "Ok";
        }
        If (action == "Drop") {
            This.RaiseEvent(id, "OnDrop", "Real");
            Return "Ok";
        }
        If (action == "Measure") {
            This.RaiseEvent(id, "OnMeasure", "Real");
            This.RaiseEvent(id, "OnLayout", "Real");
            Return "Ok";
        }
        If (action == "Render") {
            This.RaiseEvent(id, "OnRender", "Real");
            Return "Ok";
        }
        If (action == "Animate") {
            This.RaiseEvent(id, "OnAnimationStart", "Real");
            This.RaiseEvent(id, "OnAnimationUpdate", "Real");
            This.RaiseEvent(id, "OnAnimationComplete", "Real");
            Return "Ok";
        }
        If (action == "CancelAnimation") {
            This.RaiseEvent(id, "OnAnimationCancel", "Real");
            Return "Ok";
        }
        If (action == "Update") {
            This.RaiseEvent(id, "OnUpdate", "Real");
            Return "Ok";
        }
        If (action == "Change") {
            This.RaiseEvent(id, "OnChange", "Real");
            This.RaiseEvent(id, "OnValueChange", "Real");
            Return "Ok";
        }
        If (action == "Input") {
            This.RaiseEvent(id, "OnInput", "Real");
            This.RaiseEvent(id, "OnTextChange", "Real");
            Return "Ok";
        }
        If (action == "Load") {
            This.RaiseEvent(id, "OnLoad", "Real");
            This.RaiseEvent(id, "OnLoaded", "Real");
            Return "Ok";
        }
        If (action == "Unload") {
            This.RaiseEvent(id, "OnUnload", "Real");
            This.RaiseEvent(id, "OnUnloaded", "Real");
            Return "Ok";
        }
        If (action == "Dispose") {
            This.DisposeHost(id);
            Return "Ok";
        }
        Return "Rejected";
    }

    Public Function DisposeHost(String id) -> Bool
    Explain {
        Description: "Dispose a control.";
        Input: id = "Control name";
        Processing: "Raise OnDispose and OnDestroy, then refuse later events.";
        Output: "True when the control was alive.";
    } {
        If (!This.EvtAlive(id)) {
            Return False;
        }
        This.RaiseEvent(id, "OnDispose", "Real");
        This.RaiseEvent(id, "OnDestroy", "Real");
        Int index = This.EvtIndex(id);
        This.aliveFlags[index] = "false";
        Return True;
    }

    Public Function SupportOf(String eventName) -> String
    Explain {
        Description: "Return the support status of one inventory event.";
        Input: eventName = "Event name";
        Processing: "Every E1 through E8 name is supported. Unknown names have no status.";
        Output: "Supported, or empty text.";
    } {
        If (This.EvtKnown(eventName)) {
            Return "Supported";
        }
        Return "";
    }

    Public Function ActionContract() -> String
    Explain {
        Description: "Return the action thread contract.";
        Input: None;
        Processing: "Read the fixed contract.";
        Output: "The contract sentence.";
    } {
        Return "Actions run on the UI thread. A nested action returns Busy.";
    }

    Public Function TraceAt(Int index) -> String
    Explain {
        Description: "Return one routed handler record.";
        Input: index = "Zero-based trace row";
        Processing: "Read the trace.";
        Output: "The record, or empty text.";
    } {
        If (index < 0 || index >= This.trace.Count()) {
            Return "";
        }
        Return This.trace[index];
    }

    Public Function TraceSize() -> Int
    Explain {
        Description: "Return how many handlers ran.";
        Input: None;
        Processing: "Read the trace length.";
        Output: "The number of trace rows.";
    } {
        Return This.trace.Count();
    }

    Public Function ClearTrace() -> Int
    Explain {
        Description: "Clear the handler trace.";
        Input: None;
        Processing: "Drop recorded rows. Subscriptions stay.";
        Output: "Zero.";
    } {
        This.trace = List<String>();
        Return 0;
    }

    Public Function MismatchTally() -> Int
    Explain {
        Description: "Return how many handler signatures were rejected.";
        Input: None;
        Processing: "Read the mismatch counter.";
        Output: "The number of rejected bindings.";
    } {
        Return This.mismatches;
    }

    Public Function ExceptionTally() -> Int
    Explain {
        Description: "Return how many handlers threw.";
        Input: None;
        Processing: "Read the exception counter.";
        Output: "The number of thrown handlers.";
    } {
        Return This.exceptions;
    }

    Public Function LastSource() -> String
    Explain {
        Description: "Return Real or Synthetic for the last raise.";
        Input: None;
        Processing: "Read the stored source.";
        Output: "The source name.";
    } {
        Return This.origin;
    }

    Public Function LastButton() -> String
    Explain {
        Description: "Return the last pointer button.";
        Input: None;
        Processing: "Read the stored button.";
        Output: "The button name.";
    } {
        Return This.button;
    }

    Public Function LastKey() -> String
    Explain {
        Description: "Return the last key.";
        Input: None;
        Processing: "Read the stored key.";
        Output: "The key name.";
    } {
        Return This.pressedKey;
    }

    Public Function LastText() -> String
    Explain {
        Description: "Return the last inserted text.";
        Input: None;
        Processing: "Read the stored text.";
        Output: "The inserted text.";
    } {
        Return This.typedText;
    }

    Public Function LastX() -> Int
    Explain {
        Description: "Return the last pointer x.";
        Input: None;
        Processing: "Read the stored x.";
        Output: "The x coordinate.";
    } {
        Return This.pointX;
    }

    Public Function LastY() -> Int
    Explain {
        Description: "Return the last pointer y.";
        Input: None;
        Processing: "Read the stored y.";
        Output: "The y coordinate.";
    } {
        Return This.pointY;
    }

    Public Function CancelledFlag() -> Bool
    Explain {
        Description: "Return whether the last event was cancelled.";
        Input: None;
        Processing: "Read the cancel flag.";
        Output: "True when a Cancel handler ran.";
    } {
        Return This.cancelled;
    }

    Public Function ConsumedFlag() -> Bool
    Explain {
        Description: "Return whether the last event was consumed.";
        Input: None;
        Processing: "Read the consume flag.";
        Output: "True when a Consume handler ran.";
    } {
        Return This.consumed;
    }

    Public Function EventDepth() -> Int
    Explain {
        Description: "Return the current dispatch depth.";
        Input: None;
        Processing: "Read the depth counter.";
        Output: "Zero when no event is running.";
    } {
        Return This.depth;
    }

    Public Function KnownEventCount() -> Int
    Explain {
        Description: "Return how many inventory events are supported.";
        Input: None;
        Processing: "Count the E1 through E8 names.";
        Output: "The number of supported events.";
    } {
        Return This.EvtSlices(This.catalog);
    }

    Public Function LastAction() -> String
    Explain {
        Description: "Return the result of a nested action.";
        Input: None;
        Processing: "Read the result stored by the Act handler.";
        Output: "The action result, or empty text.";
    } {
        Return This.lastAction;
    }

    Public Function CoverEvents(String id) -> Int
    Explain {
        Description: "Raise every supported event on one control.";
        Input: id = "Control name";
        Processing: "Subscribe Any and raise each inventory event as synthetic input.";
        Output: "The number of new trace rows.";
    } {
        Int before = This.trace.Count();
        Int count = This.EvtSlices(This.catalog);
        Int index = 0;
        While (index < count) {
            String name = This.EvtSlice(This.catalog, index);
            This.WatchEvent("Component", id, name, "Any", "Bubble", 0);
            This.RaiseEvent(id, name, "Synthetic");
            index = index + 1;
        }
        Return This.trace.Count() - before;
    }

    Private Function EvtWalk(RxuNode node, String parentId) -> Int {
        If (node.Kind != "Element") {
            Int count = 0;
            Int index = 0;
            While (index < node.Children.Count()) {
                count = count + This.EvtWalk(node.Children[index], parentId);
                index = index + 1;
            }
            Return count;
        }
        String id = node.FindAttribute("Name").Text + "";
        Int count = 0;
        String next = parentId + "";
        If (id != "" && This.EvtIndex(id) < 0) {
            This.ids.Add(id);
            This.kinds.Add(node.Name + "");
            This.parents.Add(parentId + "");
            This.aliveFlags.Add("true");
            count = 1;
            next = id + "";
            Int attribute = 0;
            While (attribute < node.Attributes.Count()) {
                String attr = node.Attributes[attribute].Name + "";
                If (This.EvtKnown(attr)) {
                    String handler = node.Attributes[attribute].Text + "";
                    This.WatchEvent("Component", id, attr, handler, "Bubble", 0);
                }
                attribute = attribute + 1;
            }
            This.RaiseEvent(id, "OnCreate", "Real");
            This.RaiseEvent(id, "OnInitialize", "Real");
            This.RaiseEvent(id, "OnLoad", "Real");
            This.RaiseEvent(id, "OnLoaded", "Real");
        }
        Int index = 0;
        While (index < node.Children.Count()) {
            count = count + This.EvtWalk(node.Children[index], next);
            index = index + 1;
        }
        Return count;
    }

    Private Function EvtIndex(String id) -> Int {
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.ids[index] == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function EvtKnown(String eventName) -> Bool {
        If (eventName == "") {
            Return False;
        }
        Return ("," + This.catalog + ",").Contains("," + eventName + ",");
    }

    Private Function EvtSignature(String handler) -> String {
        Int index = 0;
        While (index < This.handlerNames.Count()) {
            If (This.handlerNames[index] == handler) {
                Return This.handlerSigns[index];
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function EvtParent(String id) -> String {
        Int index = This.EvtIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.parents[index];
    }

    Private Function EvtAlive(String id) -> Bool {
        Int index = This.EvtIndex(id);
        If (index < 0) {
            Return False;
        }
        Return This.aliveFlags[index] == "true";
    }

    Private Function EvtRoute(String id, String eventName, String source) -> Int {
        Int fired = 0;
        fired = fired + This.EvtDispatch("*", eventName, "Global", "Capture", "Global", source);
        If (This.EvtStop()) {
            Return fired;
        }
        fired = fired + This.EvtDispatch("*", eventName, "Document", "Capture", "Document", source);
        If (This.EvtStop()) {
            Return fired;
        }
        List<String> up = List<String>();
        String cursor = id + "";
        Int guard = 0;
        While (cursor != "" && guard < 32) {
            up.Add(cursor);
            cursor = This.EvtParent(cursor);
            guard = guard + 1;
        }
        Int index = up.Count() - 1;
        While (index > 0) {
            fired = fired + This.EvtDispatch(up[index], eventName, "Component", "Capture", "Capture", source);
            If (This.EvtStop()) {
                Return fired;
            }
            index = index - 1;
        }
        fired = fired + This.EvtDispatch(id, eventName, "Component", "Capture", "Target", source);
        If (This.EvtStop()) {
            Return fired;
        }
        fired = fired + This.EvtDispatch(id, eventName, "Component", "Bubble", "Target", source);
        If (This.EvtStop()) {
            Return fired;
        }
        index = 1;
        While (index < up.Count()) {
            fired = fired + This.EvtDispatch(up[index], eventName, "Component", "Bubble", "Bubble", source);
            If (This.EvtStop()) {
                Return fired;
            }
            index = index + 1;
        }
        fired = fired + This.EvtDispatch("*", eventName, "Document", "Bubble", "Document", source);
        If (This.EvtStop()) {
            Return fired;
        }
        fired = fired + This.EvtDispatch("*", eventName, "Global", "Bubble", "Global", source);
        Return fired;
    }

    Private Function EvtDispatch(String id, String eventName, String scope, String phase, String label, String source) -> Int {
        List<String> hits = List<String>();
        Int index = 0;
        While (index < This.watchLive.Count()) {
            If (This.watchLive[index] == "true" && This.watchScope[index] == scope && This.watchEvent[index] == eventName && This.watchPhase[index] == phase && This.watchId[index] == id) {
                hits.Add(index.ToString());
            }
            index = index + 1;
        }
        Int slot = 0;
        While (slot < hits.Count()) {
            Int best = slot;
            Int other = slot + 1;
            While (other < hits.Count()) {
                Int left = hits[best].ToInt();
                Int right = hits[other].ToInt();
                Int leftPriority = This.watchPriority[left].ToInt();
                Int rightPriority = This.watchPriority[right].ToInt();
                Int leftOrder = This.watchOrder[left].ToInt();
                Int rightOrder = This.watchOrder[right].ToInt();
                Bool better = False;
                If (rightPriority > leftPriority) {
                    better = True;
                }
                If (rightPriority == leftPriority && rightOrder < leftOrder) {
                    better = True;
                }
                If (better) {
                    best = other;
                }
                other = other + 1;
            }
            If (best != slot) {
                String swap = hits[slot] + "";
                hits[slot] = hits[best];
                hits[best] = swap;
            }
            slot = slot + 1;
        }
        Int fired = 0;
        Int cursor = 0;
        While (cursor < hits.Count()) {
            Int hit = hits[cursor].ToInt();
            This.EvtFire(id, eventName, This.watchHandler[hit], label, source);
            fired = fired + 1;
            If (This.EvtStop()) {
                Return fired;
            }
            cursor = cursor + 1;
        }
        Return fired;
    }

    Private Function EvtFire(String id, String eventName, String handler, String label, String source) -> Int {
        String sign = This.EvtSignature(handler);
        If (sign == "Throws") {
            This.exceptions = This.exceptions + 1;
        }
        String shown = id + "";
        This.trace.Add(label + " " + shown + " " + eventName + " " + handler + " " + source);
        If (handler == "Cancel") {
            This.cancelled = True;
        }
        If (handler == "Consume") {
            This.consumed = True;
        }
        If (handler == "Act") {
            This.lastAction = This.RunAction(shown, "Disable");
        }
        Return 1;
    }

    Private Function EvtStop() -> Bool {
        If (This.cancelled || This.consumed) {
            Return True;
        }
        Return False;
    }

    Private Function EvtCatalog() -> String {
        Return This.catalog;
    }

    Private Function EvtSlices(String text) -> Int {
        If (text == "") {
            Return 0;
        }
        Int count = 1;
        Int index = 0;
        While (index < text.Length()) {
            If (text.GetChar(index) == ",") {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function EvtSlice(String text, Int item) -> String {
        Int seen = 0;
        Int start = 0;
        Int index = 0;
        While (index <= text.Length()) {
            Bool boundary = index == text.Length();
            If (!boundary) {
                boundary = text.GetChar(index) == ",";
            }
            If (boundary) {
                If (seen == item) {
                    Return text.Substring(start, index - start);
                }
                seen = seen + 1;
                start = index + 1;
            }
            index = index + 1;
        }
        Return "";
    }
}

Public Class TreeHost {
    Private List<String> ids;
    Private List<String> kinds;
    Private List<String> names;
    Private List<String> parents;
    Private List<String> docs;
    Private List<String> orders;
    Private List<String> stamps;
    Private List<String> attachedFlags;
    Private List<String> extras;
    Private List<String> watches;
    Private List<String> pending;
    Private List<String> childIds;
    Private List<String> matchIds;
    Private List<String> snapIds;
    Private List<String> snapKinds;
    Private List<String> snapNames;
    Private List<String> snapParents;
    Private List<String> snapDocs;
    Private List<String> snapOrders;
    Private List<String> snapStamps;
    Private List<String> snapAttached;
    Private List<String> snapExtras;
    Private List<String> snapWatches;
    Private Int serial;
    Private Int layoutCount;
    Private Int renderCount;
    Private Int held;
    Private Bool tx;
    Private Bool dirty;
    Private Bool invoking;
    Private String phase;

    Public Constructor() {
        This.ids = List<String>();
        This.kinds = List<String>();
        This.names = List<String>();
        This.parents = List<String>();
        This.docs = List<String>();
        This.orders = List<String>();
        This.stamps = List<String>();
        This.attachedFlags = List<String>();
        This.extras = List<String>();
        This.watches = List<String>();
        This.pending = List<String>();
        This.childIds = List<String>();
        This.matchIds = List<String>();
        This.snapIds = List<String>();
        This.snapKinds = List<String>();
        This.snapNames = List<String>();
        This.snapParents = List<String>();
        This.snapDocs = List<String>();
        This.snapOrders = List<String>();
        This.snapStamps = List<String>();
        This.snapAttached = List<String>();
        This.snapExtras = List<String>();
        This.snapWatches = List<String>();
        This.serial = 1;
        This.layoutCount = 0;
        This.renderCount = 0;
        This.held = 0;
        This.tx = False;
        This.dirty = False;
        This.invoking = False;
        This.phase = "Open";
    }

    Public Function ImportTree(RxuNode node) -> Int
    Explain {
        Description: "Import a live tree from markup.";
        Input: node = "Document or element";
        Processing: "Record each named control under the open main document and coalesce the first layout.";
        Output: "The number of imported controls.";
    } {
        Int count = This.TreeWalk(node, "", "", 0);
        This.phase = "Open";
        If (count > 0) {
            This.TreeNote();
        }
        Return count;
    }

    Public Function TreeOpen(String doc, String id, String kind, String name) -> Bool
    Explain {
        Description: "Open another document root without closing the current window.";
        Input: doc = "Document id", id = "Stable control id", kind = "Control kind", name = "Visible name";
        Processing: "Create an attached root. The window phase stays Open.";
        Output: "True when the root was created.";
    } {
        If (doc == "" || id == "" || kind == "" || name == "" || This.TreeIndex(id) >= 0) {
            Return False;
        }
        This.TreePlace(id, kind, name, "", doc, 0);
        This.TreeNote();
        Return True;
    }

    Public Function TreeCreate(String kind, String id, String name) -> Bool
    Explain {
        Description: "Create a detached control.";
        Input: kind = "Control kind", id = "Stable control id", name = "Visible name";
        Processing: "Store the control without a parent. The id is never reused.";
        Output: "True when the control was created.";
    } {
        If (kind == "" || id == "" || name == "" || This.TreeIndex(id) >= 0) {
            Return False;
        }
        This.TreePlace(id, kind, name, "", "", 0);
        Return True;
    }

    Public Function TreeAdd(String parent, String id) -> Bool
    Explain {
        Description: "Attach a detached control at the end of a parent.";
        Input: parent = "Parent id", id = "Detached control id";
        Processing: "Reject a missing parent, a cycle, or a control that is already attached.";
        Output: "True when the control was attached.";
    } {
        If (This.TreeIndex(parent) < 0) {
            Return False;
        }
        This.TreeKids(parent);
        Return This.TreeInsert(parent, This.childIds.Count(), id);
    }

    Public Function TreeInsert(String parent, Int index, String id) -> Bool
    Explain {
        Description: "Insert a detached control at a child index.";
        Input: parent = "Parent id", index = "Zero-based index", id = "Detached control id";
        Processing: "Shift later siblings. Reject a cycle, a live parent pointer, or an index past the end.";
        Output: "True when the control was inserted.";
    } {
        Int parentIndex = This.TreeIndex(parent);
        Int node = This.TreeIndex(id);
        If (parentIndex < 0 || node < 0 || index < 0) {
            Return False;
        }
        If (This.parents[node] != "" || This.docs[node] != "") {
            Return False;
        }
        If (id == parent || This.TreeUnder(parent, id)) {
            Return False;
        }
        This.TreeKids(parent);
        If (index > This.childIds.Count()) {
            Return False;
        }
        Int cursor = 0;
        While (cursor < This.ids.Count()) {
            If (This.parents[cursor] == parent && This.orders[cursor].ToInt() >= index) {
                Int shifted = This.orders[cursor].ToInt() + 1;
                This.orders[cursor] = shifted.ToString();
            }
            cursor = cursor + 1;
        }
        This.parents[node] = parent + "";
        This.orders[node] = index.ToString();
        This.TreeSetDoc(id, This.docs[parentIndex]);
        This.TreeNote();
        Return True;
    }

    Public Function TreeDetach(String id) -> Bool
    Explain {
        Description: "Remove a control from its parent without destroying its id.";
        Input: id = "Control id";
        Processing: "During an action the removal waits until the action returns. Otherwise the subtree leaves the document immediately.";
        Output: "True when the control was removed or queued.";
    } {
        Int node = This.TreeIndex(id);
        If (node < 0) {
            Return False;
        }
        If (This.parents[node] == "" && This.docs[node] == "") {
            Return False;
        }
        If (This.invoking) {
            Int pendingIndex = 0;
            While (pendingIndex < This.pending.Count()) {
                If (This.pending[pendingIndex] == id) {
                    Return True;
                }
                pendingIndex = pendingIndex + 1;
            }
            This.pending.Add(id);
            Return True;
        }
        Return This.TreeUnlink(id);
    }

    Public Function TreeReplace(String id, String kind) -> Bool
    Explain {
        Description: "Replace a control kind and keep its id, children, and properties.";
        Input: id = "Control id", kind = "New kind";
        Processing: "The stable id and stored properties stay.";
        Output: "True when the kind changed.";
    } {
        Int node = This.TreeIndex(id);
        If (node < 0 || kind == "") {
            Return False;
        }
        This.kinds[node] = kind + "";
        This.TreeNote();
        Return True;
    }

    Public Function TreeClear(String id) -> Int
    Explain {
        Description: "Detach every direct child.";
        Input: id = "Parent id";
        Processing: "Each child subtree leaves the document and keeps its own state.";
        Output: "The number of detached children, or -1 when the parent is missing.";
    } {
        If (This.TreeIndex(id) < 0) {
            Return -1;
        }
        This.TreeKids(id);
        List<String> copy = List<String>();
        Int index = 0;
        While (index < This.childIds.Count()) {
            copy.Add(This.childIds[index]);
            index = index + 1;
        }
        Int count = 0;
        While (count < copy.Count()) {
            This.TreeDetach(copy[count]);
            count = count + 1;
        }
        Return count;
    }

    Public Function TreeMove(String id, String parent, Int index) -> Bool
    Explain {
        Description: "Move a control under a new parent, including across documents.";
        Input: id = "Control id", parent = "New parent id", index = "Zero-based index";
        Processing: "Reject a cycle or an index past the end. Properties and the stable id stay.";
        Output: "True when the control moved.";
    } {
        Int node = This.TreeIndex(id);
        Int parentIndex = This.TreeIndex(parent);
        If (node < 0 || parentIndex < 0 || index < 0 || id == parent || This.TreeUnder(parent, id)) {
            Return False;
        }
        This.TreeKids(parent);
        Int count = This.childIds.Count();
        If (This.parents[node] == parent) {
            count = count - 1;
        }
        If (index > count) {
            Return False;
        }
        If (!This.TreeUnlink(id)) {
            Return False;
        }
        Return This.TreeInsert(parent, index, id);
    }

    Public Function TreeFindKind(String kind) -> String
    Explain {
        Description: "Find the first attached control of a kind.";
        Input: kind = "Control kind";
        Processing: "Walk each open document in tree order.";
        Output: "The stable id, or empty text.";
    } {
        This.TreeGather("kind", kind);
        If (This.matchIds.Count() == 0) {
            Return "";
        }
        Return This.matchIds[0];
    }

    Public Function TreeFindId(String id) -> Bool
    Explain {
        Description: "Report whether a stable id exists.";
        Input: id = "Stable id";
        Processing: "Look up the id, attached or detached.";
        Output: "True when the id is still stored.";
    } {
        Return This.TreeIndex(id) >= 0;
    }

    Public Function TreeFindName(String name) -> String
    Explain {
        Description: "Find the first attached control with a name.";
        Input: name = "Visible name";
        Processing: "Walk each open document in tree order. Later same names stay addressable by path.";
        Output: "The stable id, or empty text.";
    } {
        This.TreeGather("name", name);
        If (This.matchIds.Count() == 0) {
            Return "";
        }
        Return This.matchIds[0];
    }

    Public Function TreeFindPath(String path) -> String
    Explain {
        Description: "Find an attached control by a slash path of names.";
        Input: path = "Root/child/name";
        Processing: "Walk from an open root through named children.";
        Output: "The stable id, or empty text.";
    } {
        Int parts = This.TreePieces(path, "/");
        If (parts == 0) {
            Return "";
        }
        String name = This.TreePiece(path, "/", 0);
        String current = "";
        Int index = 0;
        While (index < This.ids.Count()) {
            If (current == "" && This.parents[index] == "" && This.docs[index] != "" && This.names[index] == name) {
                current = This.ids[index];
            }
            index = index + 1;
        }
        If (current == "") {
            Return "";
        }
        Int part = 1;
        While (part < parts) {
            String want = This.TreePiece(path, "/", part);
            This.TreeKids(current);
            String next = "";
            Int child = 0;
            While (child < This.childIds.Count()) {
                Int childIndex = This.TreeIndex(This.childIds[child]);
                If (next == "" && childIndex >= 0 && This.names[childIndex] == want) {
                    next = This.childIds[child];
                }
                child = child + 1;
            }
            If (next == "") {
                Return "";
            }
            current = next + "";
            part = part + 1;
        }
        Return current;
    }

    Public Function TreeMatchCount(String kind) -> Int
    Explain {
        Description: "Count attached controls of a kind.";
        Input: kind = "Control kind";
        Processing: "Walk each open document in tree order.";
        Output: "The number of matches.";
    } {
        This.TreeGather("kind", kind);
        Return This.matchIds.Count();
    }

    Public Function TreeMatchAt(String kind, Int index) -> String
    Explain {
        Description: "Return one attached match of a kind.";
        Input: kind = "Control kind", index = "Zero-based match";
        Processing: "Walk each open document in tree order.";
        Output: "The stable id, or empty text.";
    } {
        This.TreeGather("kind", kind);
        If (index < 0 || index >= This.matchIds.Count()) {
            Return "";
        }
        Return This.matchIds[index];
    }

    Public Function TreeParent(String id) -> String
    Explain {
        Description: "Return the parent id.";
        Input: id = "Control id";
        Processing: "Read the stored parent. A detached root has none.";
        Output: "The parent id, or empty text.";
    } {
        Int node = This.TreeIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.parents[node];
    }

    Public Function TreeChildCount(String id) -> Int
    Explain {
        Description: "Count the direct children.";
        Input: id = "Parent id";
        Processing: "Collect the children in sibling order.";
        Output: "The number of children, or -1 when the id is missing.";
    } {
        If (This.TreeIndex(id) < 0) {
            Return -1;
        }
        This.TreeKids(id);
        Return This.childIds.Count();
    }

    Public Function TreeChildAt(String id, Int index) -> String
    Explain {
        Description: "Return one direct child.";
        Input: id = "Parent id", index = "Zero-based index";
        Processing: "Collect the children in sibling order.";
        Output: "The child id, or empty text.";
    } {
        If (This.TreeIndex(id) < 0) {
            Return "";
        }
        This.TreeKids(id);
        If (index < 0 || index >= This.childIds.Count()) {
            Return "";
        }
        Return This.childIds[index];
    }

    Public Function TreeSibling(String id, Int step) -> String
    Explain {
        Description: "Return the previous or next sibling.";
        Input: id = "Control id", step = "1 for next, -1 for previous";
        Processing: "Move among the parent's children. There is no wrap.";
        Output: "The sibling id, or empty text.";
    } {
        Int node = This.TreeIndex(id);
        If (node < 0 || This.parents[node] == "") {
            Return "";
        }
        String parent = This.parents[node];
        This.TreeKids(parent);
        Int index = 0;
        Int found = -1;
        While (index < This.childIds.Count()) {
            If (This.childIds[index] == id) {
                found = index;
            }
            index = index + 1;
        }
        Int target = found + step;
        If (found < 0 || target < 0 || target >= This.childIds.Count()) {
            Return "";
        }
        Return This.childIds[target];
    }

    Public Function TreeRoot(String id) -> String
    Explain {
        Description: "Return the root of a control's subtree.";
        Input: id = "Control id";
        Processing: "Walk parent links to the top.";
        Output: "The root id, or empty text.";
    } {
        Int node = This.TreeIndex(id);
        If (node < 0) {
            Return "";
        }
        String current = id + "";
        Int guard = 0;
        While (This.TreeParent(current) != "" && guard < 64) {
            current = This.TreeParent(current);
            guard = guard + 1;
        }
        Return current;
    }

    Public Function TreePut(String id, String field, String value) -> Bool
    Explain {
        Description: "Write one typed property.";
        Input: id = "Control id", field = "Property name", value = "Typed value";
        Processing: "Reject a value of the wrong type and keep the previous one.";
        Output: "True when the value was stored.";
    } {
        If (This.TreeIndex(id) < 0 || !This.TreeValid(field, value)) {
            Return False;
        }
        If (field == "Name") {
            Int node = This.TreeIndex(id);
            This.names[node] = value + "";
        }
        This.TreeBagPut(id, field, value);
        This.TreeNote();
        Return True;
    }

    Public Function TreeRead(String id, String field) -> String
    Explain {
        Description: "Read one property.";
        Input: id = "Control id", field = "Property name";
        Processing: "Return the stored value, or the default for a known property.";
        Output: "The value, or empty text.";
    } {
        Int node = This.TreeIndex(id);
        If (node < 0) {
            Return "";
        }
        If (field == "Kind") {
            Return This.kinds[node];
        }
        If (field == "Name") {
            Return This.names[node];
        }
        If (field == "Id") {
            Return This.ids[node];
        }
        String value = This.TreeBag(id, field);
        If (value == "" && (field == "Width" || field == "Height")) {
            Return "Auto";
        }
        If (value == "" && (field == "Enabled" || field == "Visible")) {
            Return "true";
        }
        Return value;
    }

    Public Function TreeSetAttribute(String id, String name, String value) -> Bool
    Explain {
        Description: "Set a generic attribute.";
        Input: id = "Control id", name = "Attribute name", value = "Raw value";
        Processing: "Store the text without the typed property check.";
        Output: "True when the attribute was stored.";
    } {
        If (This.TreeIndex(id) < 0 || name == "") {
            Return False;
        }
        This.TreeBagPut(id, name, value);
        This.TreeNote();
        Return True;
    }

    Public Function TreeGetAttribute(String id, String name) -> String
    Explain {
        Description: "Read a generic attribute.";
        Input: id = "Control id", name = "Attribute name";
        Processing: "Read the stored text.";
        Output: "The value, or empty text.";
    } {
        Return This.TreeBag(id, name);
    }

    Public Function TreeHasAttribute(String id, String name) -> Bool
    Explain {
        Description: "Report whether an attribute is stored.";
        Input: id = "Control id", name = "Attribute name";
        Processing: "Look for the attribute key.";
        Output: "True when it is present.";
    } {
        Return This.TreeBagHas(id, name);
    }

    Public Function TreeDropAttribute(String id, String name) -> Bool
    Explain {
        Description: "Remove one generic attribute.";
        Input: id = "Control id", name = "Attribute name";
        Processing: "Drop the stored key.";
        Output: "True when it was present.";
    } {
        If (!This.TreeBagHas(id, name)) {
            Return False;
        }
        This.TreeBagDrop(id, name);
        This.TreeNote();
        Return True;
    }

    Public Function TreeResetAttribute(String id, String name) -> Bool
    Explain {
        Description: "Reset one attribute to its default.";
        Input: id = "Control id", name = "Attribute name";
        Processing: "Drop the stored key so a later read uses the default.";
        Output: "True when it was present.";
    } {
        Return This.TreeDropAttribute(id, name);
    }

    Public Function TreeAttributeCount(String id) -> Int
    Explain {
        Description: "Count stored attributes.";
        Input: id = "Control id";
        Processing: "Count keys for this id.";
        Output: "The number of attributes.";
    } {
        Return This.TreeBagCount(id);
    }

    Public Function TreeAttributeAt(String id, Int index) -> String
    Explain {
        Description: "Return one stored attribute name.";
        Input: id = "Control id", index = "Zero-based attribute";
        Processing: "Read the attribute key.";
        Output: "The attribute name, or empty text.";
    } {
        Return This.TreeBagName(id, index);
    }

    Public Function TreePutMany(String id, String packed) -> Int
    Explain {
        Description: "Write several typed properties.";
        Input: id = "Control id", packed = "Field=value pairs separated by semicolons";
        Processing: "Reject the whole batch when any value is invalid.";
        Output: "The number of values written, or -1.";
    } {
        If (This.TreeIndex(id) < 0) {
            Return -1;
        }
        If (packed == "") {
            Return 0;
        }
        Int parts = This.TreePieces(packed, ";");
        Int index = 0;
        While (index < parts) {
            String piece = This.TreePiece(packed, ";", index);
            Int mark = piece.IndexOf("=");
            If (mark <= 0) {
                Return -1;
            }
            String field = piece.Substring(0, mark);
            String value = "";
            If (piece.Length() > mark + 1) {
                value = piece.Substring(mark + 1);
            }
            If (!This.TreeValid(field, value)) {
                Return -1;
            }
            index = index + 1;
        }
        index = 0;
        While (index < parts) {
            String piece = This.TreePiece(packed, ";", index);
            Int mark = piece.IndexOf("=");
            String field = piece.Substring(0, mark);
            String value = "";
            If (piece.Length() > mark + 1) {
                value = piece.Substring(mark + 1);
            }
            This.TreePut(id, field, value);
            index = index + 1;
        }
        Return parts;
    }

    Public Function TreeInvoke(String id, String action) -> String
    Explain {
        Description: "Invoke a component action.";
        Input: id = "Control id", action = "Action name";
        Processing: "RemoveSelf is deferred until the action returns. Enable and Disable write Enabled.";
        Output: "Ok, Deferred, Missing, or Rejected.";
    } {
        If (This.TreeIndex(id) < 0) {
            Return "Missing";
        }
        If (action == "RemoveSelf") {
            This.invoking = True;
            Bool queued = This.TreeDetach(id);
            This.held = This.TreeChildCount(This.TreeParent(id));
            This.invoking = False;
            This.TreeFlush();
            If (queued) {
                Return "Deferred";
            }
            Return "Rejected";
        }
        If (action == "Enable") {
            This.TreePut(id, "Enabled", "true");
            Return "Ok";
        }
        If (action == "Disable") {
            This.TreePut(id, "Enabled", "false");
            Return "Ok";
        }
        Return "Rejected";
    }

    Public Function TreeSubscribe(String id, String eventName, String handler) -> Bool
    Explain {
        Description: "Subscribe a handler on a control.";
        Input: id = "Control id", eventName = "Event name", handler = "Handler name";
        Processing: "Store an On* subscription for this control.";
        Output: "True when the subscription is stored.";
    } {
        If (This.TreeIndex(id) < 0 || handler == "" || !eventName.StartsWith("On") || eventName.Length() < 3) {
            Return False;
        }
        String row = id + " " + eventName + " " + handler;
        Int index = 0;
        While (index < This.watches.Count()) {
            If (This.watches[index] == row) {
                Return True;
            }
            index = index + 1;
        }
        This.watches.Add(row);
        Return True;
    }

    Public Function TreeUnsubscribe(String id, String eventName, String handler) -> Bool
    Explain {
        Description: "Remove one handler subscription.";
        Input: id = "Control id", eventName = "Event name", handler = "Handler name";
        Processing: "Drop the matching subscription.";
        Output: "True when it was present.";
    } {
        String row = id + " " + eventName + " " + handler;
        List<String> kept = List<String>();
        Bool found = False;
        Int index = 0;
        While (index < This.watches.Count()) {
            If (This.watches[index] == row) {
                found = True;
            } Else {
                kept.Add(This.watches[index]);
            }
            index = index + 1;
        }
        This.watches = kept;
        Return found;
    }

    Public Function TreeRaise(String id, String eventName) -> Int
    Explain {
        Description: "Raise one subscribed event on a control.";
        Input: id = "Control id", eventName = "Event name";
        Processing: "Count matching subscriptions.";
        Output: "The number of handlers.";
    } {
        String prefix = id + " " + eventName + " ";
        Int count = 0;
        Int index = 0;
        While (index < This.watches.Count()) {
            If (This.watches[index].StartsWith(prefix)) {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Public Function TreeBegin() -> Bool
    Explain {
        Description: "Begin a tree transaction.";
        Input: None;
        Processing: "Snapshot the tree so layout can wait for the commit.";
        Output: "True when the transaction started.";
    } {
        If (This.tx) {
            Return False;
        }
        This.TreeSnap();
        This.tx = True;
        This.dirty = False;
        Return True;
    }

    Public Function TreeCommit() -> Int
    Explain {
        Description: "Commit a tree transaction.";
        Input: None;
        Processing: "Coalesce every edit since begin into one layout and one render.";
        Output: "1 when layout ran, otherwise 0.";
    } {
        If (!This.tx) {
            Return 0;
        }
        This.tx = False;
        If (!This.dirty) {
            Return 0;
        }
        This.dirty = False;
        This.layoutCount = This.layoutCount + 1;
        This.renderCount = This.renderCount + 1;
        Return 1;
    }

    Public Function TreeRollback() -> Bool
    Explain {
        Description: "Roll back a tree transaction.";
        Input: None;
        Processing: "Restore the snapshot. Layout does not run.";
        Output: "True when the snapshot was restored.";
    } {
        If (!This.tx) {
            Return False;
        }
        This.TreeRestore();
        This.tx = False;
        This.dirty = False;
        Return True;
    }

    Public Function TreeLayoutCount() -> Int
    Explain {
        Description: "Return how many layouts have run.";
        Input: None;
        Processing: "Read the layout counter.";
        Output: "The layout count.";
    } {
        Return This.layoutCount;
    }

    Public Function TreeRenderCount() -> Int
    Explain {
        Description: "Return how many renders have run.";
        Input: None;
        Processing: "Read the render counter.";
        Output: "The render count.";
    } {
        Return This.renderCount;
    }

    Public Function TreePhase() -> String
    Explain {
        Description: "Return the window phase.";
        Input: None;
        Processing: "The live window stays open across edits.";
        Output: "Open.";
    } {
        Return This.phase;
    }

    Public Function TreeDoc(String id) -> String
    Explain {
        Description: "Return the document that contains a control.";
        Input: id = "Control id";
        Processing: "Read the stored document. A detached control has none.";
        Output: "The document id, or empty text.";
    } {
        Int node = This.TreeIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.docs[node];
    }

    Public Function TreeKind(String id) -> String
    Explain {
        Description: "Return a control kind.";
        Input: id = "Control id";
        Processing: "Read the stored kind.";
        Output: "The kind, or empty text.";
    } {
        Int node = This.TreeIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.kinds[node];
    }

    Public Function TreeStamp(String id) -> String
    Explain {
        Description: "Return the stable creation stamp.";
        Input: id = "Control id";
        Processing: "The stamp stays the same across moves, renames, and replacement.";
        Output: "The stamp, or empty text.";
    } {
        Int node = This.TreeIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.stamps[node];
    }

    Public Function TreeAttached(String id) -> Bool
    Explain {
        Description: "Report whether a control is in an open document.";
        Input: id = "Control id";
        Processing: "A detached control keeps its id and loses its document.";
        Output: "True when the control is attached.";
    } {
        Int node = This.TreeIndex(id);
        If (node < 0) {
            Return False;
        }
        Return This.attachedFlags[node] == "true";
    }

    Public Function TreeHeld() -> Int
    Explain {
        Description: "Return the child count observed while an action was still running.";
        Input: None;
        Processing: "Read the count captured before a deferred removal.";
        Output: "The held child count.";
    } {
        Return This.held;
    }

    Private Function TreePlace(String id, String kind, String name, String parent, String doc, Int order) -> Int {
        This.ids.Add(id);
        This.kinds.Add(kind);
        This.names.Add(name);
        This.parents.Add(parent);
        This.docs.Add(doc);
        This.orders.Add(order.ToString());
        This.stamps.Add(This.serial.ToString());
        If (doc == "") {
            This.attachedFlags.Add("false");
        } Else {
            This.attachedFlags.Add("true");
        }
        This.serial = This.serial + 1;
        This.TreeBagPut(id, "Width", "Auto");
        This.TreeBagPut(id, "Height", "Auto");
        This.TreeBagPut(id, "Enabled", "true");
        This.TreeBagPut(id, "Visible", "true");
        Return 1;
    }

    Private Function TreeWalk(RxuNode node, String parentId, String doc, Int order) -> Int {
        If (node.Kind != "Element") {
            Int count = 0;
            Int index = 0;
            While (index < node.Children.Count()) {
                count = count + This.TreeWalk(node.Children[index], parentId, doc, order);
                index = index + 1;
            }
            Return count;
        }
        String id = node.FindAttribute("Name").Text + "";
        If (id == "" || This.TreeIndex(id) >= 0) {
            Return 0;
        }
        String docName = doc + "";
        If (parentId == "") {
            docName = "main";
        }
        This.TreePlace(id, node.Name + "", id, parentId + "", docName, order);
        Int attribute = 0;
        While (attribute < node.Attributes.Count()) {
            String attr = node.Attributes[attribute].Name + "";
            If (attr != "Name" && attr != "") {
                This.TreeBagPut(id, attr, node.Attributes[attribute].Text + "");
            }
            attribute = attribute + 1;
        }
        Int count = 1;
        Int childOrder = 0;
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuNode child = node.Children[index];
            If (child.Kind == "Element") {
                count = count + This.TreeWalk(child, id, docName, childOrder);
                childOrder = childOrder + 1;
            } Else {
                count = count + This.TreeWalk(child, id, docName, childOrder);
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function TreeIndex(String id) -> Int {
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.ids[index] == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function TreeKids(String parent) -> Int {
        This.childIds = List<String>();
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.parents[index] == parent) {
                This.childIds.Add(This.ids[index]);
            }
            index = index + 1;
        }
        Int slot = 0;
        While (slot < This.childIds.Count()) {
            Int best = slot;
            Int other = slot + 1;
            While (other < This.childIds.Count()) {
                Int left = This.TreeIndex(This.childIds[best]);
                Int right = This.TreeIndex(This.childIds[other]);
                If (left >= 0 && right >= 0 && This.orders[right].ToInt() < This.orders[left].ToInt()) {
                    best = other;
                }
                other = other + 1;
            }
            If (best != slot) {
                String swap = This.childIds[slot] + "";
                This.childIds[slot] = This.childIds[best];
                This.childIds[best] = swap;
            }
            slot = slot + 1;
        }
        Return This.childIds.Count();
    }

    Private Function TreeUnder(String start, String ancestor) -> Bool {
        String cursor = start + "";
        Int guard = 0;
        While (cursor != "" && guard < 64) {
            If (cursor == ancestor) {
                Return True;
            }
            Int node = This.TreeIndex(cursor);
            If (node < 0) {
                Return False;
            }
            cursor = This.parents[node];
            guard = guard + 1;
        }
        Return False;
    }

    Private Function TreeUnlink(String id) -> Bool {
        Int node = This.TreeIndex(id);
        If (node < 0) {
            Return False;
        }
        If (This.parents[node] == "" && This.docs[node] == "") {
            Return False;
        }
        String old = This.parents[node] + "";
        This.parents[node] = "";
        This.TreeSetDoc(id, "");
        If (old != "") {
            This.TreeRenumber(old);
        }
        This.TreeNote();
        Return True;
    }

    Private Function TreeSetDoc(String id, String doc) -> Int {
        Int node = This.TreeIndex(id);
        If (node < 0) {
            Return 0;
        }
        This.TreeKids(id);
        List<String> copy = List<String>();
        Int index = 0;
        While (index < This.childIds.Count()) {
            copy.Add(This.childIds[index]);
            index = index + 1;
        }
        This.docs[node] = doc + "";
        If (doc == "") {
            This.attachedFlags[node] = "false";
        } Else {
            This.attachedFlags[node] = "true";
        }
        Int child = 0;
        While (child < copy.Count()) {
            This.TreeSetDoc(copy[child], doc);
            child = child + 1;
        }
        Return 1;
    }

    Private Function TreeRenumber(String parent) -> Int {
        This.TreeKids(parent);
        Int index = 0;
        While (index < This.childIds.Count()) {
            Int node = This.TreeIndex(This.childIds[index]);
            If (node >= 0) {
                This.orders[node] = index.ToString();
            }
            index = index + 1;
        }
        Return index;
    }

    Private Function TreeNote() -> Int {
        If (This.tx) {
            This.dirty = True;
            Return 0;
        }
        This.layoutCount = This.layoutCount + 1;
        This.renderCount = This.renderCount + 1;
        Return 1;
    }

    Private Function TreeFlush() -> Int {
        List<String> copy = List<String>();
        Int index = 0;
        While (index < This.pending.Count()) {
            copy.Add(This.pending[index]);
            index = index + 1;
        }
        This.pending = List<String>();
        Int count = 0;
        While (count < copy.Count()) {
            This.TreeUnlink(copy[count]);
            count = count + 1;
        }
        Return count;
    }

    Private Function TreeGather(String mode, String key) -> Int {
        This.matchIds = List<String>();
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.parents[index] == "" && This.docs[index] != "") {
                This.TreeCollect(This.ids[index], mode, key);
            }
            index = index + 1;
        }
        Return This.matchIds.Count();
    }

    Private Function TreeCollect(String id, String mode, String key) -> Int {
        Int node = This.TreeIndex(id);
        If (node < 0 || This.docs[node] == "") {
            Return 0;
        }
        Bool chosen = False;
        If (mode == "kind" && This.kinds[node] == key) {
            chosen = True;
        }
        If (mode == "name" && This.names[node] == key) {
            chosen = True;
        }
        If (chosen) {
            This.matchIds.Add(id);
        }
        This.TreeKids(id);
        List<String> copy = List<String>();
        Int index = 0;
        While (index < This.childIds.Count()) {
            copy.Add(This.childIds[index]);
            index = index + 1;
        }
        Int child = 0;
        While (child < copy.Count()) {
            This.TreeCollect(copy[child], mode, key);
            child = child + 1;
        }
        Return 1;
    }

    Private Function TreeSnap() -> Int {
        This.snapIds = List<String>();
        This.snapKinds = List<String>();
        This.snapNames = List<String>();
        This.snapParents = List<String>();
        This.snapDocs = List<String>();
        This.snapOrders = List<String>();
        This.snapStamps = List<String>();
        This.snapAttached = List<String>();
        This.snapExtras = List<String>();
        This.snapWatches = List<String>();
        Int index = 0;
        While (index < This.ids.Count()) {
            This.snapIds.Add(This.ids[index]);
            This.snapKinds.Add(This.kinds[index]);
            This.snapNames.Add(This.names[index]);
            This.snapParents.Add(This.parents[index]);
            This.snapDocs.Add(This.docs[index]);
            This.snapOrders.Add(This.orders[index]);
            This.snapStamps.Add(This.stamps[index]);
            This.snapAttached.Add(This.attachedFlags[index]);
            index = index + 1;
        }
        index = 0;
        While (index < This.extras.Count()) {
            This.snapExtras.Add(This.extras[index]);
            index = index + 1;
        }
        index = 0;
        While (index < This.watches.Count()) {
            This.snapWatches.Add(This.watches[index]);
            index = index + 1;
        }
        Return This.snapIds.Count();
    }

    Private Function TreeRestore() -> Int {
        This.ids = List<String>();
        This.kinds = List<String>();
        This.names = List<String>();
        This.parents = List<String>();
        This.docs = List<String>();
        This.orders = List<String>();
        This.stamps = List<String>();
        This.attachedFlags = List<String>();
        This.extras = List<String>();
        This.watches = List<String>();
        Int index = 0;
        While (index < This.snapIds.Count()) {
            This.ids.Add(This.snapIds[index]);
            This.kinds.Add(This.snapKinds[index]);
            This.names.Add(This.snapNames[index]);
            This.parents.Add(This.snapParents[index]);
            This.docs.Add(This.snapDocs[index]);
            This.orders.Add(This.snapOrders[index]);
            This.stamps.Add(This.snapStamps[index]);
            This.attachedFlags.Add(This.snapAttached[index]);
            index = index + 1;
        }
        index = 0;
        While (index < This.snapExtras.Count()) {
            This.extras.Add(This.snapExtras[index]);
            index = index + 1;
        }
        index = 0;
        While (index < This.snapWatches.Count()) {
            This.watches.Add(This.snapWatches[index]);
            index = index + 1;
        }
        Return This.ids.Count();
    }

    Private Function TreeBag(String id, String field) -> String {
        String key = id + "." + field + "=";
        Int index = 0;
        While (index < This.extras.Count()) {
            String row = This.extras[index];
            If (row.StartsWith(key)) {
                If (row.Length() <= key.Length()) {
                    Return "";
                }
                Return row.Substring(key.Length());
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function TreeBagHas(String id, String field) -> Bool {
        String key = id + "." + field + "=";
        Int index = 0;
        While (index < This.extras.Count()) {
            If (This.extras[index].StartsWith(key)) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function TreeBagPut(String id, String field, String value) -> Int {
        String key = id + "." + field + "=";
        List<String> kept = List<String>();
        Int index = 0;
        While (index < This.extras.Count()) {
            If (!This.extras[index].StartsWith(key)) {
                kept.Add(This.extras[index]);
            }
            index = index + 1;
        }
        kept.Add(key + value);
        This.extras = kept;
        Return 1;
    }

    Private Function TreeBagDrop(String id, String field) -> Int {
        String key = id + "." + field + "=";
        List<String> kept = List<String>();
        Int index = 0;
        While (index < This.extras.Count()) {
            If (!This.extras[index].StartsWith(key)) {
                kept.Add(This.extras[index]);
            }
            index = index + 1;
        }
        This.extras = kept;
        Return 1;
    }

    Private Function TreeBagCount(String id) -> Int {
        String prefix = id + ".";
        Int count = 0;
        Int index = 0;
        While (index < This.extras.Count()) {
            If (This.extras[index].StartsWith(prefix)) {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function TreeBagName(String id, Int item) -> String {
        String prefix = id + ".";
        Int seen = 0;
        Int index = 0;
        While (index < This.extras.Count()) {
            String row = This.extras[index];
            If (row.StartsWith(prefix)) {
                If (seen == item) {
                    Int mark = row.IndexOf("=");
                    If (mark > prefix.Length()) {
                        Return row.Substring(prefix.Length(), mark - prefix.Length());
                    }
                    Return "";
                }
                seen = seen + 1;
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function TreeValid(String field, String value) -> Bool {
        If (field == "Content" || field == "Title" || field == "Text" || field == "Name") {
            Return True;
        }
        If (field == "Enabled" || field == "Visible") {
            Return value == "true" || value == "false";
        }
        If (field == "Width" || field == "Height") {
            Return This.TreeSize(value);
        }
        If (field == "Opacity") {
            Return This.TreeOpacity(value);
        }
        If (field == "Columns" || field == "Rows" || field == "Spacing") {
            Return This.TreeDigits(value);
        }
        If (field == "Background" || field == "Color") {
            Return This.TreeColor(value);
        }
        Return False;
    }

    Private Function TreeDigits(String value) -> Bool {
        If (value.Length() == 0) {
            Return False;
        }
        Int index = 0;
        While (index < value.Length()) {
            String character = value.GetChar(index);
            If (character < "0" || character > "9") {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function TreeSize(String value) -> Bool {
        If (value == "Auto" || value == "*") {
            Return True;
        }
        String body = value + "";
        If (value.EndsWith("px") && value.Length() > 2) {
            body = value.Substring(0, value.Length() - 2);
        } Else {
            If (value.EndsWith("*") && value.Length() > 1) {
                body = value.Substring(0, value.Length() - 1);
            }
        }
        Return This.TreeDigits(body);
    }

    Private Function TreeOpacity(String value) -> Bool {
        If (value == "0" || value == "1") {
            Return True;
        }
        If (!value.StartsWith("0.") || value.Length() < 3) {
            Return False;
        }
        Return This.TreeDigits(value.Substring(2));
    }

    Private Function TreeColor(String value) -> Bool {
        If (value.Length() != 7 || !value.StartsWith("#")) {
            Return False;
        }
        Int index = 1;
        While (index < value.Length()) {
            String character = value.GetChar(index);
            Bool digit = character >= "0" && character <= "9";
            Bool lower = character >= "a" && character <= "f";
            Bool upper = character >= "A" && character <= "F";
            If (!digit && !lower && !upper) {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function TreePieces(String text, String separator) -> Int {
        If (text == "") {
            Return 0;
        }
        Int count = 1;
        Int index = 0;
        While (index < text.Length()) {
            If (text.GetChar(index) == separator) {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function TreePiece(String text, String separator, Int item) -> String {
        Int seen = 0;
        Int start = 0;
        Int index = 0;
        While (index <= text.Length()) {
            Bool boundary = index == text.Length();
            If (!boundary) {
                boundary = text.GetChar(index) == separator;
            }
            If (boundary) {
                If (seen == item) {
                    Return text.Substring(start, index - start);
                }
                seen = seen + 1;
                start = index + 1;
            }
            index = index + 1;
        }
        Return "";
    }
}

Public Class FlowHost {
    Private List<String> ids;
    Private List<String> kinds;
    Private List<String> names;
    Private List<String> parents;
    Private List<String> texts;
    Private List<String> widths;
    Private List<String> stamps;
    Private List<String> visits;
    Private List<String> generations;
    Private List<String> attachedFlags;
    Private List<String> slots;
    Private List<String> locals;
    Private List<String> links;
    Private List<String> heard;
    Private List<String> includes;
    Private List<String> imports;
    Private List<String> chain;
    Private List<String> childIds;
    Private Int serial;
    Private Int generation;
    Private Int visitSerial;
    Private Int missing;
    Private Int setMiss;
    Private Int cycles;
    Private Int detaches;
    Private Int raising;

    Public Constructor() {
        This.ids = List<String>();
        This.kinds = List<String>();
        This.names = List<String>();
        This.parents = List<String>();
        This.texts = List<String>();
        This.widths = List<String>();
        This.stamps = List<String>();
        This.visits = List<String>();
        This.generations = List<String>();
        This.attachedFlags = List<String>();
        This.slots = List<String>();
        This.locals = List<String>();
        This.links = List<String>();
        This.heard = List<String>();
        This.includes = List<String>();
        This.imports = List<String>();
        This.chain = List<String>();
        This.childIds = List<String>();
        This.serial = 1;
        This.generation = 0;
        This.visitSerial = 0;
        This.missing = 0;
        This.setMiss = 0;
        This.cycles = 0;
        This.detaches = 0;
        This.raising = 0;
    }

    Public Function FlowAssign(String name, String value) -> Bool
    Explain {
        Description: "Set one observable slot.";
        Input: name = "Slot name", value = "New value";
        Processing: "Store the slot used by conditions, repeats, and bindings.";
        Output: "True when the name is present.";
    } {
        If (name == "") {
            Return False;
        }
        This.FlowSlotSet(name, value);
        Return True;
    }

    Public Function FlowLoad(RxuNode node) -> Int
    Explain {
        Description: "Reconcile the declarative tree against current state.";
        Input: node = "Parsed document";
        Processing: "Rebuild branches, repeats, locals, includes, and imports. Unvisited controls detach and keep their ids.";
        Output: "The number of attached controls.";
    } {
        This.generation = This.generation + 1;
        This.missing = 0;
        This.setMiss = 0;
        This.includes = List<String>();
        This.imports = List<String>();
        This.FlowWalk(node, "", "root");
        This.FlowSweep();
        Return This.FlowCount();
    }

    Public Function FlowUpdate(String name, String value) -> Bool
    Explain {
        Description: "Update a declared local, or a slot when no local exists.";
        Input: name = "Name", value = "New value";
        Processing: "A later refresh keeps a Let value and reapplies a Set. Bindings follow the change once.";
        Output: "True when a local or slot was updated.";
    } {
        If (name == "") {
            Return False;
        }
        If (This.FlowScopeHas("root", name)) {
            This.FlowScopeSet("root", name, value);
        } Else {
            This.FlowSlotSet(name, value);
        }
        This.FlowPush(name, value);
        Return True;
    }

    Public Function FlowRead(String id, String field) -> String
    Explain {
        Description: "Read one live control.";
        Input: id = "Control id", field = "Text, Width, Name, Kind, or Id";
        Processing: "Read the stored value.";
        Output: "The value, or empty text.";
    } {
        Int node = This.FlowIndex(id);
        If (node < 0) {
            Return "";
        }
        If (field == "Text") {
            Return This.texts[node];
        }
        If (field == "Width") {
            Return This.widths[node];
        }
        If (field == "Name") {
            Return This.names[node];
        }
        If (field == "Kind") {
            Return This.kinds[node];
        }
        If (field == "Id") {
            Return This.ids[node];
        }
        Return "";
    }

    Public Function FlowFind(String name) -> String
    Explain {
        Description: "Find the first attached control with a name.";
        Input: name = "Control name";
        Processing: "Scan attached controls.";
        Output: "The id, or empty text.";
    } {
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.attachedFlags[index] == "true" && This.names[index] == name) {
                Return This.ids[index];
            }
            index = index + 1;
        }
        Return "";
    }

    Public Function FlowByText(String text) -> String
    Explain {
        Description: "Find the first attached control with text.";
        Input: text = "Visible text";
        Processing: "Scan attached controls.";
        Output: "The id, or empty text.";
    } {
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.attachedFlags[index] == "true" && This.texts[index] == text) {
                Return This.ids[index];
            }
            index = index + 1;
        }
        Return "";
    }

    Public Function FlowHasText(String text) -> Bool
    Explain {
        Description: "Report whether any attached control shows text.";
        Input: text = "Visible text";
        Processing: "Scan attached controls.";
        Output: "True when the text is showing.";
    } {
        Return This.FlowByText(text) != "";
    }

    Public Function FlowAttached(String id) -> Bool
    Explain {
        Description: "Report whether a control is in the current reconciliation.";
        Input: id = "Control id";
        Processing: "Detached controls keep their id and stored edits.";
        Output: "True when it is attached.";
    } {
        Int node = This.FlowIndex(id);
        If (node < 0) {
            Return False;
        }
        Return This.attachedFlags[node] == "true";
    }

    Public Function FlowCount() -> Int
    Explain {
        Description: "Count attached controls.";
        Input: None;
        Processing: "Scan the live records.";
        Output: "The attached count.";
    } {
        Int count = 0;
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.attachedFlags[index] == "true") {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Public Function FlowParent(String id) -> String
    Explain {
        Description: "Return the parent id.";
        Input: id = "Control id";
        Processing: "Read the stored parent.";
        Output: "The parent id, or empty text.";
    } {
        Int node = This.FlowIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.parents[node];
    }

    Public Function FlowChildCount(String id) -> Int
    Explain {
        Description: "Count attached children.";
        Input: id = "Parent id";
        Processing: "Collect attached children in visit order.";
        Output: "The child count.";
    } {
        This.FlowKids(id);
        Return This.childIds.Count();
    }

    Public Function FlowChildAt(String id, Int index) -> String
    Explain {
        Description: "Return one attached child.";
        Input: id = "Parent id", index = "Zero-based index";
        Processing: "Collect attached children in visit order.";
        Output: "The child id, or empty text.";
    } {
        This.FlowKids(id);
        If (index < 0 || index >= This.childIds.Count()) {
            Return "";
        }
        Return This.childIds[index];
    }

    Public Function FlowPut(String id, String field, String value) -> Bool
    Explain {
        Description: "Edit one live property.";
        Input: id = "Control id", field = "Width or Text", value = "New value";
        Processing: "The edit survives a later reconciliation when the same id returns.";
        Output: "True when the value was stored.";
    } {
        Int node = This.FlowIndex(id);
        If (node < 0) {
            Return False;
        }
        If (field == "Width") {
            This.widths[node] = value + "";
            Return True;
        }
        If (field == "Text") {
            This.texts[node] = value + "";
            Return True;
        }
        Return False;
    }

    Public Function FlowListen(String id, String eventName, String handler) -> Bool
    Explain {
        Description: "Listen for an event on a control or its descendants.";
        Input: id = "Control id", eventName = "Event name", handler = "Handler name";
        Processing: "Store the listener. A Loop handler cannot re-enter the same raise.";
        Output: "True when the listener was stored.";
    } {
        If (id == "" || handler == "" || !eventName.StartsWith("On")) {
            Return False;
        }
        This.heard.Add(id + "|" + eventName + "|" + handler);
        Return True;
    }

    Public Function FlowRaise(String id, String eventName) -> Int
    Explain {
        Description: "Raise an event and notify ancestor listeners.";
        Input: id = "Control id", eventName = "Event name";
        Processing: "Walk parents. A repeated raise of the same target stops as a cycle.";
        Output: "The number of listeners notified.";
    } {
        String mark = id + "|" + eventName;
        If (This.FlowChainHas(mark)) {
            This.cycles = This.cycles + 1;
            Return 0;
        }
        This.chain.Add(mark);
        This.raising = This.raising + 1;
        Int count = 0;
        String cursor = id + "";
        Int guard = 0;
        While (cursor != "" && guard < 32) {
            Int index = 0;
            While (index < This.heard.Count()) {
                String row = This.heard[index];
                String prefix = cursor + "|" + eventName + "|";
                If (row.StartsWith(prefix)) {
                    count = count + 1;
                    String handler = "";
                    If (row.Length() > prefix.Length()) {
                        handler = row.Substring(prefix.Length());
                    }
                    If (handler == "Loop") {
                        This.FlowRaise(id, eventName);
                    }
                }
                index = index + 1;
            }
            cursor = This.FlowParent(cursor);
            guard = guard + 1;
        }
        This.raising = This.raising - 1;
        This.FlowChainDrop(mark);
        Return count;
    }

    Public Function FlowLink(String source, String target) -> Bool
    Explain {
        Description: "Bind a source path to a target path.";
        Input: source = "Slot or control path", target = "Slot or control path";
        Processing: "A later push updates the target. A cycle stops instead of looping.";
        Output: "True when both paths are present.";
    } {
        If (source == "" || target == "") {
            Return False;
        }
        This.links.Add(source + ">" + target);
        Return True;
    }

    Public Function FlowPush(String path, String value) -> Bool
    Explain {
        Description: "Write a path and update bindings.";
        Input: path = "Slot, local, or id.field", value = "New value";
        Processing: "If the path is already being written, record a cycle and stop.";
        Output: "True when the write was applied.";
    } {
        If (path == "") {
            Return False;
        }
        If (This.FlowChainHas(path)) {
            This.cycles = This.cycles + 1;
            Return False;
        }
        This.chain.Add(path);
        This.FlowQuiet(path, value);
        Int index = 0;
        While (index < This.links.Count()) {
            String row = This.links[index];
            String prefix = path + ">";
            If (row.StartsWith(prefix)) {
                String target = "";
                If (row.Length() > prefix.Length()) {
                    target = row.Substring(prefix.Length());
                }
                This.FlowPush(target, value);
            }
            index = index + 1;
        }
        This.FlowChainDrop(path);
        Return True;
    }

    Public Function FlowLocal(String name) -> String
    Explain {
        Description: "Read a root local.";
        Input: name = "Local name";
        Processing: "Read the root scope. Repeat item names stay in their own scope.";
        Output: "The value, or empty text.";
    } {
        Return This.FlowScopeGet("root", name);
    }

    Public Function FlowSlot(String name) -> String
    Explain {
        Description: "Read an observable slot.";
        Input: name = "Slot name";
        Processing: "Read the slot store.";
        Output: "The value, or empty text.";
    } {
        Return This.FlowSlotGet(name);
    }

    Public Function FlowMissing() -> Int
    Explain {
        Description: "Return how many repeat items had no key on the last reconcile.";
        Input: None;
        Processing: "Items without Key use an index key and are counted here.";
        Output: "The missing-key count.";
    } {
        Return This.missing;
    }

    Public Function FlowSetMiss() -> Int
    Explain {
        Description: "Return how many Set names were not declared.";
        Input: None;
        Processing: "Set updates a Let. An unknown name is refused.";
        Output: "The refused Set count.";
    } {
        Return This.setMiss;
    }

    Public Function FlowCycles() -> Int
    Explain {
        Description: "Return how many circular updates were stopped.";
        Input: None;
        Processing: "Bindings and Loop handlers do not recurse through an active path.";
        Output: "The cycle count.";
    } {
        Return This.cycles;
    }

    Public Function FlowIncludes() -> Int
    Explain {
        Description: "Return how many Include files were expanded.";
        Input: None;
        Processing: "Include embeds markup into the tree.";
        Output: "The include count.";
    } {
        Return This.includes.Count();
    }

    Public Function FlowImports() -> Int
    Explain {
        Description: "Return how many Import sources were recorded.";
        Input: None;
        Processing: "Import records a component file and does not instantiate it.";
        Output: "The import count.";
    } {
        Return This.imports.Count();
    }

    Public Function FlowIncludeAt(Int index) -> String
    Explain {
        Description: "Return one included path.";
        Input: index = "Zero-based include";
        Processing: "Read the include list.";
        Output: "The path, or empty text.";
    } {
        If (index < 0 || index >= This.includes.Count()) {
            Return "";
        }
        Return This.includes[index];
    }

    Public Function FlowImportAt(Int index) -> String
    Explain {
        Description: "Return one imported source.";
        Input: index = "Zero-based import";
        Processing: "Read the import list.";
        Output: "The source, or empty text.";
    } {
        If (index < 0 || index >= This.imports.Count()) {
            Return "";
        }
        Return This.imports[index];
    }

    Public Function FlowDetachCount() -> Int
    Explain {
        Description: "Return how many controls have been detached.";
        Input: None;
        Processing: "A branch or repeat item that leaves the tree is detached, not reused as a new id.";
        Output: "The detach count.";
    } {
        Return This.detaches;
    }

    Public Function FlowRepeatCount() -> Int
    Explain {
        Description: "Count attached controls created by a repeat.";
        Input: None;
        Processing: "Repeat controls have no name, so their ids start with gen-.";
        Output: "The repeat count.";
    } {
        Int count = 0;
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.attachedFlags[index] == "true" && This.ids[index].StartsWith("gen-")) {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Public Function FlowStamp(String id) -> String
    Explain {
        Description: "Return the stable creation stamp.";
        Input: id = "Control id";
        Processing: "The stamp survives detach and return.";
        Output: "The stamp, or empty text.";
    } {
        Int node = This.FlowIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.stamps[node];
    }

    Public Function FlowWhileStatus() -> String
    Explain {
        Description: "Return whether bounded While is approved.";
        Input: None;
        Processing: "P00 has not approved While, so the parser still rejects it and the runtime does not run it.";
        Output: "Rejected.";
    } {
        Return "Rejected";
    }

    Public Function FlowPhase() -> String
    Explain {
        Description: "Return the window phase.";
        Input: None;
        Processing: "Reconciliation does not close the window.";
        Output: "Open.";
    } {
        Return "Open";
    }

    Private Function FlowWalk(RxuNode node, String parent, String scope) -> Int {
        If (node.Kind != "Element") {
            Int count = 0;
            Int index = 0;
            While (index < node.Children.Count()) {
                count = count + This.FlowWalk(node.Children[index], parent, scope);
                index = index + 1;
            }
            Return count;
        }
        String name = node.Name + "";
        If (name == "Include") {
            Return This.FlowInclude(node, parent, scope);
        }
        If (name == "Import") {
            This.imports.Add(node.FindAttribute("Source").Text + "");
            Return 0;
        }
        If (name == "Let") {
            String localName = node.FindAttribute("Name").Text + "";
            If (localName != "" && !This.FlowScopeHas(scope, localName)) {
                This.FlowScopeSet(scope, localName, node.FindAttribute("Value").Text + "");
            }
            Return 0;
        }
        If (name == "Set") {
            String localName = node.FindAttribute("Name").Text + "";
            If (localName == "" || !This.FlowScopeHas(scope, localName)) {
                This.setMiss = This.setMiss + 1;
                Return 0;
            }
            This.FlowScopeSet(scope, localName, node.FindAttribute("Value").Text + "");
            Return 0;
        }
        If (name == "Bind") {
            String target = node.FindAttribute("Target").Text + "";
            String source = node.FindAttribute("Source").Text + "";
            If (target != "" && source != "") {
                This.FlowLink(source, target + ".Text");
                This.FlowQuiet(target + ".Text", This.FlowResolve(source, scope));
            }
            Return 0;
        }
        If (name == "If" || name == "ElseIf") {
            Return This.FlowBranch(node, parent, scope);
        }
        If (name == "Choose" || name == "Switch") {
            Return This.FlowChoice(node, parent, scope);
        }
        If (name == "Each" || name == "For" || name == "ForEach") {
            Return This.FlowEach(node, parent, scope);
        }
        If (name == "Else" || name == "When" || name == "Default" || name == "Otherwise") {
            Return 0;
        }
        String id = node.FindAttribute("Name").Text + "";
        If (id == "") {
            id = "gen-" + scope + "-" + name;
        }
        String text = This.FlowText(node, scope);
        This.FlowMaterial(id, name, node.FindAttribute("Name").Text + "", parent, text);
        Int count = 1;
        Int index = 0;
        While (index < node.Children.Count()) {
            count = count + This.FlowWalk(node.Children[index], id, scope);
            index = index + 1;
        }
        Return count;
    }

    Private Function FlowBranch(RxuNode node, String parent, String scope) -> Int {
        String condition = node.FindAttribute("Condition").Text + "";
        If (This.FlowResolve(condition, scope) == "true") {
            Return This.FlowBody(node, parent, scope);
        }
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuNode child = node.Children[index];
            If (child.Kind == "Element" && child.Name == "ElseIf") {
                String next = child.FindAttribute("Condition").Text + "";
                If (This.FlowResolve(next, scope) == "true") {
                    Return This.FlowBody(child, parent, scope);
                }
            }
            index = index + 1;
        }
        index = 0;
        While (index < node.Children.Count()) {
            RxuNode child = node.Children[index];
            If (child.Kind == "Element" && child.Name == "Else") {
                Return This.FlowBody(child, parent, scope);
            }
            index = index + 1;
        }
        Return 0;
    }

    Private Function FlowChoice(RxuNode node, String parent, String scope) -> Int {
        String value = This.FlowResolve(node.FindAttribute("Value").Text + "", scope);
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuNode child = node.Children[index];
            If (child.Kind == "Element" && child.Name == "When" && child.FindAttribute("Value").Text == value) {
                Return This.FlowBody(child, parent, scope);
            }
            index = index + 1;
        }
        index = 0;
        While (index < node.Children.Count()) {
            RxuNode child = node.Children[index];
            If (child.Kind == "Element" && (child.Name == "Otherwise" || child.Name == "Default")) {
                Return This.FlowBody(child, parent, scope);
            }
            index = index + 1;
        }
        Return 0;
    }

    Private Function FlowBody(RxuNode node, String parent, String scope) -> Int {
        Int count = 0;
        Int index = 0;
        While (index < node.Children.Count()) {
            RxuNode child = node.Children[index];
            If (child.Kind != "Element" || (child.Name != "Else" && child.Name != "ElseIf" && child.Name != "When" && child.Name != "Default" && child.Name != "Otherwise")) {
                count = count + This.FlowWalk(child, parent, scope);
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function FlowEach(RxuNode node, String parent, String scope) -> Int {
        String source = node.FindAttribute("Items").Text + "";
        String asName = node.FindAttribute("As").Text + "";
        String data = This.FlowResolve(source, scope);
        Int parts = This.FlowPieces(data, ",");
        String keyName = node.FindAttribute("Key").Text + "";
        If (keyName == "") {
            If (parts == 0) {
                This.missing = This.missing + 1;
            } Else {
                This.missing = This.missing + parts;
            }
        }
        Int count = 0;
        Int index = 0;
        While (index < parts) {
            String item = This.FlowPiece(data, ",", index);
            String key = item + "";
            If (keyName == "") {
                key = "#" + index.ToString();
            } Else {
                If (keyName != asName) {
                    key = This.FlowResolve(keyName, scope);
                }
            }
            If (key == "") {
                This.missing = This.missing + 1;
                key = "#" + index.ToString();
            }
            String itemScope = scope + "/" + asName + "/" + key;
            If (asName != "") {
                This.FlowScopeSet(itemScope, asName, item);
            }
            Int child = 0;
            While (child < node.Children.Count()) {
                count = count + This.FlowWalk(node.Children[child], parent, itemScope);
                child = child + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function FlowInclude(RxuNode node, String parent, String scope) -> Int {
        String path = node.FindAttribute("Source").Text + "";
        This.includes.Add(path);
        If (path == "" || !Files.Exists(path)) {
            Return 0;
        }
        RxuParser parser = RxuParser();
        RxuNode included = parser.Parse(path, Files.ReadText(path));
        Int count = 0;
        Int index = 0;
        While (index < included.Children.Count()) {
            count = count + This.FlowWalk(included.Children[index], parent, scope);
            index = index + 1;
        }
        Return count;
    }

    Private Function FlowText(RxuNode node, String scope) -> String {
        String mode = node.FindAttribute("Value").Mode + "";
        String text = node.FindAttribute("Value").Text + "";
        If (text == "") {
            mode = node.FindAttribute("Content").Mode + "";
            text = node.FindAttribute("Content").Text + "";
        }
        If (mode == "Expression" || mode == "Binding") {
            Return This.FlowResolve(text, scope);
        }
        Return text;
    }

    Private Function FlowMaterial(String id, String kind, String name, String parent, String text) -> Int {
        Int node = This.FlowIndex(id);
        This.visitSerial = This.visitSerial + 1;
        If (node < 0) {
            This.ids.Add(id);
            This.kinds.Add(kind);
            This.names.Add(name);
            This.parents.Add(parent);
            This.texts.Add(text);
            This.widths.Add("Auto");
            This.stamps.Add(This.serial.ToString());
            This.serial = This.serial + 1;
            This.visits.Add(This.visitSerial.ToString());
            This.generations.Add(This.generation.ToString());
            This.attachedFlags.Add("true");
            Return 1;
        }
        This.kinds[node] = kind + "";
        This.names[node] = name + "";
        This.parents[node] = parent + "";
        This.texts[node] = text + "";
        This.visits[node] = This.visitSerial.ToString();
        This.generations[node] = This.generation.ToString();
        This.attachedFlags[node] = "true";
        Return 1;
    }

    Private Function FlowResolve(String name, String scope) -> String {
        String cursor = scope + "";
        Int guard = 0;
        While (cursor != "" && guard < 32) {
            String value = This.FlowScopeGet(cursor, name);
            If (value != "") {
                Return value;
            }
            Int slash = cursor.IndexOf("/");
            If (slash < 0) {
                cursor = "";
            } Else {
                Int last = slash;
                Int index = slash + 1;
                While (index < cursor.Length()) {
                    If (cursor.GetChar(index) == "/") {
                        last = index;
                    }
                    index = index + 1;
                }
                If (last <= 0) {
                    cursor = "";
                } Else {
                    cursor = cursor.Substring(0, last);
                }
            }
            guard = guard + 1;
        }
        Return This.FlowSlotGet(name);
    }

    Private Function FlowSweep() -> Int {
        Int index = 0;
        Int count = 0;
        String current = This.generation.ToString();
        While (index < This.ids.Count()) {
            If (This.attachedFlags[index] == "true" && This.generations[index] != current) {
                This.attachedFlags[index] = "false";
                This.detaches = This.detaches + 1;
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function FlowScopeGet(String scope, String name) -> String {
        String key = scope + "|" + name + "=";
        Int index = 0;
        While (index < This.locals.Count()) {
            String row = This.locals[index];
            If (row.StartsWith(key)) {
                If (row.Length() <= key.Length()) {
                    Return "";
                }
                Return row.Substring(key.Length());
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function FlowScopeHas(String scope, String name) -> Bool {
        String key = scope + "|" + name + "=";
        Int index = 0;
        While (index < This.locals.Count()) {
            If (This.locals[index].StartsWith(key)) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function FlowScopeSet(String scope, String name, String value) -> Int {
        String key = scope + "|" + name + "=";
        List<String> kept = List<String>();
        Int index = 0;
        While (index < This.locals.Count()) {
            If (!This.locals[index].StartsWith(key)) {
                kept.Add(This.locals[index]);
            }
            index = index + 1;
        }
        kept.Add(key + value);
        This.locals = kept;
        Return 1;
    }

    Private Function FlowSlotGet(String name) -> String {
        String key = name + "=";
        Int index = 0;
        While (index < This.slots.Count()) {
            String row = This.slots[index];
            If (row.StartsWith(key)) {
                If (row.Length() <= key.Length()) {
                    Return "";
                }
                Return row.Substring(key.Length());
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function FlowSlotSet(String name, String value) -> Int {
        String key = name + "=";
        List<String> kept = List<String>();
        Int index = 0;
        While (index < This.slots.Count()) {
            If (!This.slots[index].StartsWith(key)) {
                kept.Add(This.slots[index]);
            }
            index = index + 1;
        }
        kept.Add(key + value);
        This.slots = kept;
        Return 1;
    }

    Private Function FlowQuiet(String path, String value) -> Int {
        Int dot = path.IndexOf(".");
        If (dot > 0) {
            String id = path.Substring(0, dot);
            String field = "";
            If (path.Length() > dot + 1) {
                field = path.Substring(dot + 1);
            }
            Int node = This.FlowIndex(id);
            If (node >= 0 && field == "Text") {
                This.texts[node] = value + "";
            }
            If (node >= 0 && field == "Width") {
                This.widths[node] = value + "";
            }
            Return 1;
        }
        If (This.FlowScopeHas("root", path)) {
            This.FlowScopeSet("root", path, value);
        }
        This.FlowSlotSet(path, value);
        Return 1;
    }

    Private Function FlowIndex(String id) -> Int {
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.ids[index] == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function FlowKids(String parent) -> Int {
        This.childIds = List<String>();
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.attachedFlags[index] == "true" && This.parents[index] == parent) {
                This.childIds.Add(This.ids[index]);
            }
            index = index + 1;
        }
        Int slot = 0;
        While (slot < This.childIds.Count()) {
            Int best = slot;
            Int other = slot + 1;
            While (other < This.childIds.Count()) {
                Int left = This.FlowIndex(This.childIds[best]);
                Int right = This.FlowIndex(This.childIds[other]);
                If (left >= 0 && right >= 0 && This.visits[right].ToInt() < This.visits[left].ToInt()) {
                    best = other;
                }
                other = other + 1;
            }
            If (best != slot) {
                String swap = This.childIds[slot] + "";
                This.childIds[slot] = This.childIds[best];
                This.childIds[best] = swap;
            }
            slot = slot + 1;
        }
        Return This.childIds.Count();
    }

    Private Function FlowChainHas(String path) -> Bool {
        Int index = 0;
        While (index < This.chain.Count()) {
            If (This.chain[index] == path) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function FlowChainDrop(String path) -> Int {
        List<String> kept = List<String>();
        Int index = 0;
        While (index < This.chain.Count()) {
            If (This.chain[index] != path) {
                kept.Add(This.chain[index]);
            }
            index = index + 1;
        }
        This.chain = kept;
        Return 1;
    }

    Private Function FlowApplyLinks() -> Int {
        Return This.links.Count();
    }

    Private Function FlowPieces(String text, String separator) -> Int {
        If (text == "") {
            Return 0;
        }
        Int count = 1;
        Int index = 0;
        While (index < text.Length()) {
            If (text.GetChar(index) == separator) {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function FlowPiece(String text, String separator, Int item) -> String {
        Int seen = 0;
        Int start = 0;
        Int index = 0;
        While (index <= text.Length()) {
            Bool boundary = index == text.Length();
            If (!boundary) {
                boundary = text.GetChar(index) == separator;
            }
            If (boundary) {
                If (seen == item) {
                    Return text.Substring(start, index - start);
                }
                seen = seen + 1;
                start = index + 1;
            }
            index = index + 1;
        }
        Return "";
    }
}

Public Class KitHost {
    Private List<String> defs;
    Private List<String> defAccess;
    Private List<String> defLibs;
    Private List<String> libs;
    Private List<String> versions;
    Private List<String> params;
    Private List<String> outputs;
    Private List<String> methods;
    Private List<String> events;
    Private List<String> hooks;
    Private List<String> states;
    Private List<String> resources;
    Private List<String> styles;
    Private List<String> parts;
    Private List<String> nested;
    Private List<String> templates;
    Private List<String> ids;
    Private List<String> kinds;
    Private List<String> parents;
    Private List<String> stamps;
    Private List<String> looks;
    Private List<String> values;
    Private List<String> heard;
    Private List<String> chain;
    Private Int serial;
    Private Int collisions;
    Private Int invalid;
    Private Int windows;
    Private Int spawned;

    Public Constructor() {
        This.defs = List<String>();
        This.defAccess = List<String>();
        This.defLibs = List<String>();
        This.libs = List<String>();
        This.versions = List<String>();
        This.params = List<String>();
        This.outputs = List<String>();
        This.methods = List<String>();
        This.events = List<String>();
        This.hooks = List<String>();
        This.states = List<String>();
        This.resources = List<String>();
        This.styles = List<String>();
        This.parts = List<String>();
        This.nested = List<String>();
        This.templates = List<String>();
        This.ids = List<String>();
        This.kinds = List<String>();
        This.parents = List<String>();
        This.stamps = List<String>();
        This.looks = List<String>();
        This.values = List<String>();
        This.heard = List<String>();
        This.chain = List<String>();
        This.serial = 1;
        This.collisions = 0;
        This.invalid = 0;
        This.windows = 0;
        This.spawned = 0;
    }

    Public Function KitImport(String path) -> Int
    Explain {
        Description: "Import a component library.";
        Input: path = "Library file";
        Processing: "Load definitions only. No window is opened and no instance is created.";
        Output: "The number of new definitions.";
    } {
        Int before = This.defs.Count();
        This.KitPull(path);
        Return This.defs.Count() - before;
    }

    Public Function KitLoad(RxuNode node) -> Int
    Explain {
        Description: "Load an application that imports libraries and creates instances.";
        Input: node = "Parsed document";
        Processing: "Import definitions, then instantiate usages. A second definition of the same name collides and keeps the first.";
        Output: "The number of component instances created.";
    } {
        This.spawned = 0;
        This.KitWalk(node, "use", "", "");
        Return This.spawned;
    }

    Public Function KitDefined(String name) -> Bool
    Explain {
        Description: "Report whether a component definition exists.";
        Input: name = "Component name";
        Processing: "Look up the definition table.";
        Output: "True when it was defined.";
    } {
        Return This.KitKnown(name);
    }

    Public Function KitVersion(String library) -> String
    Explain {
        Description: "Return a library version.";
        Input: library = "Library name";
        Processing: "The first version wins when the same library is imported again.";
        Output: "The version, or empty text.";
    } {
        Int index = 0;
        While (index < This.libs.Count()) {
            If (This.libs[index] == library) {
                Return This.versions[index];
            }
            index = index + 1;
        }
        Return "";
    }

    Public Function KitDefault(String kind, String name) -> String
    Explain {
        Description: "Return a parameter default.";
        Input: kind = "Component name", name = "Parameter name";
        Processing: "Read the first definition. A colliding import does not replace it.";
        Output: "The default, or empty text.";
    } {
        Return This.KitParam(kind, name, 3);
    }

    Public Function KitSource(String kind) -> String
    Explain {
        Description: "Return the library that defined a component.";
        Input: kind = "Component name";
        Processing: "Read the first definition's library.";
        Output: "The library name, or empty text.";
    } {
        Int index = 0;
        While (index < This.defs.Count()) {
            If (This.defs[index] == kind) {
                Return This.defLibs[index];
            }
            index = index + 1;
        }
        Return "";
    }

    Public Function KitWindows() -> Int
    Explain {
        Description: "Return how many windows were opened.";
        Input: None;
        Processing: "Importing a library does not open a window.";
        Output: "The window count.";
    } {
        Return This.windows;
    }

    Public Function KitInstances(String kind) -> Int
    Explain {
        Description: "Count instances of a component.";
        Input: kind = "Component name";
        Processing: "Nested instances count separately from their parents.";
        Output: "The instance count.";
    } {
        Int count = 0;
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.kinds[index] == kind) {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Public Function KitCollisions() -> Int
    Explain {
        Description: "Return how many duplicate definitions were refused.";
        Input: None;
        Processing: "The first definition stays.";
        Output: "The collision count.";
    } {
        Return This.collisions;
    }

    Public Function KitInvalid() -> Int
    Explain {
        Description: "Return how many values failed validation.";
        Input: None;
        Processing: "A missing required parameter or a wrong type is invalid.";
        Output: "The invalid count.";
    } {
        Return This.invalid;
    }

    Public Function KitFind(String name) -> String
    Explain {
        Description: "Find an instance by its name.";
        Input: name = "Instance name or id";
        Processing: "The id is the instance name. Nested ids use parent/name.";
        Output: "The id, or empty text.";
    } {
        If (This.KitIndex(name) >= 0) {
            Return name;
        }
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.ids[index].EndsWith("/" + name)) {
                Return This.ids[index];
            }
            index = index + 1;
        }
        Return "";
    }

    Public Function KitGet(String id, String field) -> String
    Explain {
        Description: "Read a public parameter or state value.";
        Input: id = "Instance id", field = "Field name";
        Processing: "Private parameters are hidden.";
        Output: "The value, or empty text.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0) {
            Return "";
        }
        String access = This.KitParam(This.kinds[node], field, 4);
        If (access == "Private") {
            Return "";
        }
        Return This.KitTake(id, field);
    }

    Public Function KitSet(String id, String field, String value) -> Bool
    Explain {
        Description: "Write a public parameter.";
        Input: id = "Instance id", field = "Parameter name", value = "Typed value";
        Processing: "Reject a private parameter or a value of the wrong type and keep the previous value.";
        Output: "True when the value was stored.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0) {
            Return False;
        }
        String kind = This.kinds[node];
        String access = This.KitParam(kind, field, 4);
        If (access != "Public") {
            Return False;
        }
        String typeName = This.KitParam(kind, field, 2);
        If (!This.KitTyped(typeName, value)) {
            This.invalid = This.invalid + 1;
            Return False;
        }
        This.KitPut(id, field, value);
        Return True;
    }

    Public Function KitCall(String id, String method) -> Int
    Explain {
        Description: "Call a component method.";
        Input: id = "Instance id", method = "Method name";
        Processing: "Press updates only that instance and raises OnPressed. The method must be defined.";
        Output: "The number of listeners notified, or -1 when the method is missing.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0) {
            Return -1;
        }
        String kind = This.kinds[node];
        If (!This.KitHasRow(This.methods, kind + "|" + method)) {
            Return -1;
        }
        If (method == "Press") {
            This.KitPut(id, "Pressed", "true");
        }
        Return This.KitNotify(id, "OnPressed");
    }

    Public Function KitListen(String id, String eventName, String handler) -> Bool
    Explain {
        Description: "Listen for a custom event.";
        Input: id = "Instance id", eventName = "Event name", handler = "Handler name";
        Processing: "Store the listener on that instance only.";
        Output: "True when the event is defined.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0 || handler == "") {
            Return False;
        }
        If (!This.KitHasRow(This.events, This.kinds[node] + "|" + eventName)) {
            Return False;
        }
        This.heard.Add(id + "|" + eventName + "|" + handler);
        Return True;
    }

    Public Function KitOutput(String id, String name) -> String
    Explain {
        Description: "Read a component output.";
        Input: id = "Instance id", name = "Output name";
        Processing: "Read the source parameter of the output.";
        Output: "The value, or empty text.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0) {
            Return "";
        }
        String source = This.KitRowValue(This.outputs, This.kinds[node] + "|" + name + "|");
        If (source == "") {
            Return "";
        }
        Return This.KitGet(id, source);
    }

    Public Function KitResource(String id, String name) -> String
    Explain {
        Description: "Read a resource from the instance's component scope.";
        Input: id = "Instance id", name = "Resource name";
        Processing: "Resources belong to the component definition, not to sibling components.";
        Output: "The value, or empty text.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.KitRowValue(This.resources, This.kinds[node] + "|" + name + "|");
    }

    Public Function KitStyle(String id, String name) -> String
    Explain {
        Description: "Read a style from the instance's component scope.";
        Input: id = "Instance id", name = "Style name";
        Processing: "Styles stay with the component when a template changes appearance.";
        Output: "The value, or empty text.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.KitRowValue(This.styles, This.kinds[node] + "|" + name + "|");
    }

    Public Function KitPart(String id, String name) -> String
    Explain {
        Description: "Return a named child.";
        Input: id = "Instance id", name = "Child name";
        Processing: "Named internals and nested components use parent/name.";
        Output: "The child id, or empty text.";
    } {
        String child = id + "/" + name;
        If (This.KitIndex(child) < 0) {
            Return "";
        }
        Return child;
    }

    Public Function KitPartText(String id, String name) -> String
    Explain {
        Description: "Read the visible text of a named child.";
        Input: id = "Instance id", name = "Child name";
        Processing: "A template can change this text without changing parameters.";
        Output: "The text, or empty text.";
    } {
        Return This.KitTake(id + "/" + name, "Text");
    }

    Public Function KitApplyTemplate(String id, String name) -> Bool
    Explain {
        Description: "Apply a visual template.";
        Input: id = "Instance id", name = "Template name";
        Processing: "Replace the named child's appearance. Parameters, state, and methods stay.";
        Output: "True when the template exists.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0) {
            Return False;
        }
        String body = This.KitRowValue(This.templates, This.kinds[node] + "|" + name + "|");
        If (body == "") {
            Return False;
        }
        This.looks[node] = name + "";
        Int mark = body.IndexOf("|");
        String text = body + "";
        If (mark >= 0 && body.Length() > mark + 1) {
            text = body.Substring(mark + 1);
        }
        This.KitPut(id + "/caption", "Text", text);
        Return True;
    }

    Public Function KitCreate(String kind, String id, String parent) -> Bool
    Explain {
        Description: "Create a component instance from RX.";
        Input: kind = "Component name", id = "New instance id", parent = "Parent id";
        Processing: "Use defaults. A private component cannot be created. State is isolated from other instances.";
        Output: "True when the instance was created.";
    } {
        Return This.KitSpawn(kind, id, parent, "");
    }

    Public Function KitParent(String id) -> String
    Explain {
        Description: "Return the parent id.";
        Input: id = "Instance id";
        Processing: "Read the stored parent.";
        Output: "The parent id, or empty text.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.parents[node];
    }

    Public Function KitKind(String id) -> String
    Explain {
        Description: "Return an instance kind.";
        Input: id = "Instance id";
        Processing: "Read the stored kind.";
        Output: "The kind, or empty text.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.kinds[node];
    }

    Public Function KitStamp(String id) -> String
    Explain {
        Description: "Return the stable creation stamp.";
        Input: id = "Instance id";
        Processing: "The stamp does not change when a template or parameter changes.";
        Output: "The stamp, or empty text.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.stamps[node];
    }

    Public Function KitHook(String id, String name) -> Int
    Explain {
        Description: "Return how many times a lifecycle hook ran.";
        Input: id = "Instance id", name = "Hook name";
        Processing: "OnLoaded runs once at creation.";
        Output: "The hook count.";
    } {
        String value = This.KitTake(id, "hook:" + name);
        If (value == "") {
            Return 0;
        }
        Return value.ToInt();
    }

    Public Function KitAppearance(String id) -> String
    Explain {
        Description: "Return the current visual template.";
        Input: id = "Instance id";
        Processing: "Native is the component body. A template name replaces it.";
        Output: "The appearance name, or empty text.";
    } {
        Int node = This.KitIndex(id);
        If (node < 0) {
            Return "";
        }
        Return This.looks[node];
    }

    Public Function KitPhase() -> String
    Explain {
        Description: "Return the window phase.";
        Input: None;
        Processing: "Loading a library does not close the application window.";
        Output: "Open.";
    } {
        Return "Open";
    }

    Private Function KitPull(String path) -> Int {
        If (path == "" || !Files.Exists(path)) {
            Return 0;
        }
        If (This.KitChainHas(path)) {
            Return 0;
        }
        This.chain.Add(path);
        RxuParser parser = RxuParser();
        RxuNode library = parser.Parse(path, Files.ReadText(path));
        This.KitWalk(library, "use", "", "");
        This.KitChainDrop(path);
        Return 1;
    }

    Private Function KitWalk(RxuNode node, String mode, String library, String owner) -> Int {
        If (node.Kind != "Element") {
            Int count = 0;
            Int index = 0;
            While (index < node.Children.Count()) {
                count = count + This.KitWalk(node.Children[index], mode, library, owner);
                index = index + 1;
            }
            Return count;
        }
        String name = node.Name + "";
        If (name == "Components") {
            String libName = node.FindAttribute("Name").Text + "";
            This.KitNoteLib(libName, node.FindAttribute("Version").Text + "");
            Int count = 0;
            Int index = 0;
            While (index < node.Children.Count()) {
                count = count + This.KitWalk(node.Children[index], "lib", libName, "");
                index = index + 1;
            }
            Return count;
        }
        If (name == "Import") {
            Return This.KitPull(node.FindAttribute("Source").Text + "");
        }
        If (name == "Component" && mode != "def") {
            String kind = node.FindAttribute("Name").Text + "";
            String access = node.FindAttribute("Access").Text + "";
            If (access == "") {
                access = "Public";
            }
            If (!This.KitDefine(kind, library, access)) {
                Return 0;
            }
            Int count = 0;
            Int index = 0;
            While (index < node.Children.Count()) {
                count = count + This.KitWalk(node.Children[index], "def", library, kind);
                index = index + 1;
            }
            Return count;
        }
        If (mode == "def") {
            Return This.KitMember(node, owner);
        }
        If (name == "Window") {
            This.windows = This.windows + 1;
            Int count = 0;
            Int index = 0;
            While (index < node.Children.Count()) {
                count = count + This.KitWalk(node.Children[index], "use", library, node.FindAttribute("Name").Text + "");
                index = index + 1;
            }
            Return count;
        }
        If (This.KitKnown(name)) {
            String id = node.FindAttribute("Name").Text + "";
            If (This.KitSpawn(name, id, owner, This.KitOverrides(node))) {
                Return 1;
            }
            Return 0;
        }
        Int count = 0;
        Int index = 0;
        While (index < node.Children.Count()) {
            count = count + This.KitWalk(node.Children[index], mode, library, owner);
            index = index + 1;
        }
        Return count;
    }

    Private Function KitMember(RxuNode node, String owner) -> Int {
        String name = node.Name + "";
        If (name == "Parameter") {
            String access = node.FindAttribute("Access").Text + "";
            If (access == "") {
                access = "Public";
            }
            String required = node.FindAttribute("Required").Text + "";
            If (required != "true") {
                required = "false";
            }
            String typeName = node.FindAttribute("Type").Text + "";
            If (typeName == "") {
                typeName = "String";
            }
            This.params.Add(owner + "|" + node.FindAttribute("Name").Text + "|" + typeName + "|" + node.FindAttribute("Default").Text + "|" + access + "|" + required);
            Return 1;
        }
        If (name == "Output") {
            This.outputs.Add(owner + "|" + node.FindAttribute("Name").Text + "|" + node.FindAttribute("Source").Text);
            Return 1;
        }
        If (name == "State") {
            This.states.Add(owner + "|" + node.FindAttribute("Name").Text + "|" + node.FindAttribute("Default").Text);
            Return 1;
        }
        If (name == "Resource") {
            This.resources.Add(owner + "|" + node.FindAttribute("Name").Text + "|" + node.FindAttribute("Value").Text);
            Return 1;
        }
        If (name == "Style") {
            String value = node.FindAttribute("Background").Text + "";
            If (value == "") {
                value = node.FindAttribute("Value").Text + "";
            }
            This.styles.Add(owner + "|" + node.FindAttribute("Name").Text + "|" + value);
            Return 1;
        }
        If (name == "Method") {
            This.methods.Add(owner + "|" + node.FindAttribute("Name").Text);
            Return 1;
        }
        If (name == "Event") {
            This.events.Add(owner + "|" + node.FindAttribute("Name").Text);
            Return 1;
        }
        If (name == "Hook") {
            This.hooks.Add(owner + "|" + node.FindAttribute("Name").Text);
            Return 1;
        }
        If (name == "Template") {
            String templateName = node.FindAttribute("Name").Text + "";
            Int index = 0;
            While (index < node.Children.Count()) {
                RxuNode child = node.Children[index];
                If (child.Kind == "Element") {
                    This.templates.Add(owner + "|" + templateName + "|" + child.Name + "|" + child.FindAttribute("Value").Text);
                    Return 1;
                }
                index = index + 1;
            }
            Return 0;
        }
        String childName = node.FindAttribute("Name").Text + "";
        If (childName == "") {
            Return 0;
        }
        If (This.KitKnown(name)) {
            This.nested.Add(owner + "|" + childName + "|" + name + "|" + This.KitOverrides(node));
            Return 1;
        }
        This.parts.Add(owner + "|" + childName + "|" + name);
        Return 1;
    }

    Private Function KitNoteLib(String name, String version) -> Int {
        If (name == "") {
            Return 0;
        }
        Int index = 0;
        While (index < This.libs.Count()) {
            If (This.libs[index] == name) {
                Return 0;
            }
            index = index + 1;
        }
        This.libs.Add(name);
        This.versions.Add(version);
        Return 1;
    }

    Private Function KitDefine(String name, String library, String access) -> Bool {
        If (name == "" || This.KitKnown(name)) {
            This.collisions = This.collisions + 1;
            Return False;
        }
        This.defs.Add(name);
        This.defAccess.Add(access);
        This.defLibs.Add(library);
        Return True;
    }

    Private Function KitKnown(String name) -> Bool {
        Int index = 0;
        While (index < This.defs.Count()) {
            If (This.defs[index] == name) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function KitSpawn(String kind, String id, String parent, String overrides) -> Bool {
        If (id == "" || !This.KitKnown(kind) || This.KitIndex(id) >= 0) {
            Return False;
        }
        Int defined = 0;
        While (defined < This.defs.Count()) {
            If (This.defs[defined] == kind && This.defAccess[defined] == "Private") {
                Return False;
            }
            defined = defined + 1;
        }
        Int index = 0;
        While (index < This.params.Count()) {
            String row = This.params[index];
            If (row.StartsWith(kind + "|")) {
                String field = This.KitPiece(row, "|", 1);
                String required = This.KitPiece(row, "|", 5);
                String fallback = This.KitPiece(row, "|", 3);
                String given = This.KitOverride(overrides, field);
                If (required == "true" && given == "" && fallback == "") {
                    This.invalid = This.invalid + 1;
                    Return False;
                }
            }
            index = index + 1;
        }
        This.ids.Add(id);
        This.kinds.Add(kind);
        This.parents.Add(parent);
        This.stamps.Add(This.serial.ToString());
        This.serial = This.serial + 1;
        This.looks.Add("Native");
        index = 0;
        While (index < This.params.Count()) {
            String row = This.params[index];
            If (row.StartsWith(kind + "|")) {
                String field = This.KitPiece(row, "|", 1);
                String typeName = This.KitPiece(row, "|", 2);
                String fallback = This.KitPiece(row, "|", 3);
                String access = This.KitPiece(row, "|", 4);
                String given = This.KitOverride(overrides, field);
                String chosen = fallback + "";
                If (given != "" && access == "Public" && This.KitTyped(typeName, given)) {
                    chosen = given + "";
                } Else {
                    If (given != "" && access == "Public" && !This.KitTyped(typeName, given)) {
                        This.invalid = This.invalid + 1;
                    }
                }
                This.KitPut(id, field, chosen);
            }
            index = index + 1;
        }
        index = 0;
        While (index < This.states.Count()) {
            String row = This.states[index];
            If (row.StartsWith(kind + "|")) {
                This.KitPut(id, This.KitPiece(row, "|", 1), This.KitPiece(row, "|", 2));
            }
            index = index + 1;
        }
        index = 0;
        While (index < This.parts.Count()) {
            String row = This.parts[index];
            If (row.StartsWith(kind + "|")) {
                String partName = This.KitPiece(row, "|", 1);
                String partKind = This.KitPiece(row, "|", 2);
                String text = "";
                If (partName == "caption") {
                    text = This.KitTake(id, "Caption");
                }
                This.KitAddPart(id, partName, partKind, text);
            }
            index = index + 1;
        }
        index = 0;
        While (index < This.nested.Count()) {
            String row = This.nested[index];
            If (row.StartsWith(kind + "|")) {
                String childName = This.KitPiece(row, "|", 1);
                String childKind = This.KitPiece(row, "|", 2);
                String childOver = This.KitPiece(row, "|", 3);
                This.KitSpawn(childKind, id + "/" + childName, id, childOver);
            }
            index = index + 1;
        }
        index = 0;
        While (index < This.hooks.Count()) {
            String row = This.hooks[index];
            If (row == kind + "|OnLoaded") {
                This.KitPut(id, "hook:OnLoaded", "1");
            }
            index = index + 1;
        }
        This.spawned = This.spawned + 1;
        Return True;
    }

    Private Function KitAddPart(String parent, String name, String kind, String text) -> Int {
        String id = parent + "/" + name;
        If (This.KitIndex(id) >= 0) {
            This.KitPut(id, "Text", text);
            Return 0;
        }
        This.ids.Add(id);
        This.kinds.Add(kind);
        This.parents.Add(parent);
        This.stamps.Add(This.serial.ToString());
        This.serial = This.serial + 1;
        This.looks.Add("Native");
        This.KitPut(id, "Text", text);
        Return 1;
    }

    Private Function KitOverrides(RxuNode node) -> String {
        String text = "";
        Int index = 0;
        While (index < node.Attributes.Count()) {
            String name = node.Attributes[index].Name + "";
            If (name != "" && name != "Name") {
                If (text != "") {
                    text = text + ";";
                }
                text = text + name + "=" + node.Attributes[index].Text;
            }
            index = index + 1;
        }
        Return text;
    }

    Private Function KitOverride(String text, String field) -> String {
        Int parts = This.KitPieces(text, ";");
        Int index = 0;
        While (index < parts) {
            String piece = This.KitPiece(text, ";", index);
            String prefix = field + "=";
            If (piece.StartsWith(prefix)) {
                If (piece.Length() <= prefix.Length()) {
                    Return "";
                }
                Return piece.Substring(prefix.Length());
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function KitTake(String id, String field) -> String {
        String key = id + "|" + field + "=";
        Int index = 0;
        While (index < This.values.Count()) {
            String row = This.values[index];
            If (row.StartsWith(key)) {
                If (row.Length() <= key.Length()) {
                    Return "";
                }
                Return row.Substring(key.Length());
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function KitPut(String id, String field, String value) -> Int {
        String key = id + "|" + field + "=";
        List<String> kept = List<String>();
        Int index = 0;
        While (index < This.values.Count()) {
            If (!This.values[index].StartsWith(key)) {
                kept.Add(This.values[index]);
            }
            index = index + 1;
        }
        kept.Add(key + value);
        This.values = kept;
        Return 1;
    }

    Private Function KitParam(String kind, String name, Int item) -> String {
        String prefix = kind + "|" + name + "|";
        Int index = 0;
        While (index < This.params.Count()) {
            String row = This.params[index];
            If (row.StartsWith(prefix)) {
                Return This.KitPiece(row, "|", item);
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function KitHasRow(List<String> rows, String prefix) -> Bool {
        Int index = 0;
        While (index < rows.Count()) {
            If (rows[index] == prefix || rows[index].StartsWith(prefix + "|")) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function KitRowValue(List<String> rows, String prefix) -> String {
        Int index = 0;
        While (index < rows.Count()) {
            String row = rows[index];
            If (row.StartsWith(prefix)) {
                If (row.Length() <= prefix.Length()) {
                    Return "";
                }
                Return row.Substring(prefix.Length());
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function KitNotify(String id, String eventName) -> Int {
        String prefix = id + "|" + eventName + "|";
        Int count = 0;
        Int index = 0;
        While (index < This.heard.Count()) {
            If (This.heard[index].StartsWith(prefix)) {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function KitIndex(String id) -> Int {
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.ids[index] == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function KitTyped(String typeName, String value) -> Bool {
        If (typeName == "" || typeName == "String") {
            Return True;
        }
        If (typeName == "Int") {
            Return This.KitDigits(value);
        }
        If (typeName == "Bool") {
            Return value == "true" || value == "false";
        }
        If (typeName == "Color") {
            Return This.KitColor(value);
        }
        Return True;
    }

    Private Function KitDigits(String value) -> Bool {
        If (value.Length() == 0) {
            Return False;
        }
        Int index = 0;
        While (index < value.Length()) {
            String character = value.GetChar(index);
            If (character < "0" || character > "9") {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function KitColor(String value) -> Bool {
        If (value.Length() != 7 || !value.StartsWith("#")) {
            Return False;
        }
        Int index = 1;
        While (index < value.Length()) {
            String character = value.GetChar(index);
            Bool digit = character >= "0" && character <= "9";
            Bool lower = character >= "a" && character <= "f";
            Bool upper = character >= "A" && character <= "F";
            If (!digit && !lower && !upper) {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function KitChainHas(String path) -> Bool {
        Int index = 0;
        While (index < This.chain.Count()) {
            If (This.chain[index] == path) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function KitChainDrop(String path) -> Int {
        List<String> kept = List<String>();
        Int index = 0;
        While (index < This.chain.Count()) {
            If (This.chain[index] != path) {
                kept.Add(This.chain[index]);
            }
            index = index + 1;
        }
        This.chain = kept;
        Return 1;
    }

    Private Function KitPieces(String text, String separator) -> Int {
        If (text == "") {
            Return 0;
        }
        Int count = 1;
        Int index = 0;
        While (index < text.Length()) {
            If (text.GetChar(index) == separator) {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function KitPiece(String text, String separator, Int item) -> String {
        Int seen = 0;
        Int start = 0;
        Int index = 0;
        While (index <= text.Length()) {
            Bool boundary = index == text.Length();
            If (!boundary) {
                boundary = text.GetChar(index) == separator;
            }
            If (boundary) {
                If (seen == item) {
                    Return text.Substring(start, index - start);
                }
                seen = seen + 1;
                start = index + 1;
            }
            index = index + 1;
        }
        Return "";
    }
}

Public Class CatHost {
    Private List<String> ids;
    Private List<String> kinds;
    Private List<String> values;
    Private List<String> binds;
    Private List<String> notes;
    Private List<String> secrets;
    Private List<String> cells;
    Private List<String> families;
    Private List<String> catalogKinds;
    Private String focus;

    Public Constructor() {
        This.ids = List<String>();
        This.kinds = List<String>();
        This.values = List<String>();
        This.binds = List<String>();
        This.notes = List<String>();
        This.secrets = List<String>();
        This.cells = List<String>();
        This.families = List<String>();
        This.catalogKinds = List<String>();
        This.focus = "";
        This.CatFill("C1", "Application,Window,View,Control,Container,Panel,StackPanel,Grid,DockPanel,WrapPanel,ScrollView,Canvas,Overlay,SplitView,TabView");
        This.CatFill("C2", "Text,Label,RichText,Image,Icon,ProgressBar,Spinner,Divider,Badge,Tooltip,Placeholder");
        This.CatFill("C3", "Button,TextBox,PasswordBox,TextArea,CheckBox,RadioButton,Switch,Slider,NumberBox,ComboBox,DropDown,DatePicker,TimePicker,ColorPicker,FilePicker");
        This.CatFill("C4", "ListView,GridView,TreeView,Table,DataGrid,Repeater,Carousel,ItemsView");
        This.CatFill("C5", "NavigationView,Menu,MenuItem,TabItem,Breadcrumb,Dialog,Popup,Flyout,Drawer,StatusBar,TitleBar,Toolbar");
        This.CatFill("C6", "Canvas,Rectangle,Circle,Ellipse,Line,Path,Polygon,Polyline");
    }

    Public Function CatLoad(RxuNode node) -> Int
    Explain {
        Description: "Create catalog controls from markup.";
        Input: node = "Parsed document";
        Processing: "Walk every element whose name is in C1–C6 and create it.";
        Output: "The number of controls created.";
    } {
        Return This.CatWalk(node);
    }

    Public Function CatCount() -> Int
    Explain {
        Description: "Return how many catalog entries exist.";
        Input: None;
        Processing: "Count the family entries, including Canvas in both C1 and C6.";
        Output: "The number of entries.";
    } {
        Return This.catalogKinds.Count();
    }

    Public Function CatEntry(Int item) -> String
    Explain {
        Description: "Return one support-matrix row.";
        Input: item = "Zero-based catalog index";
        Processing: "Map the entry to its example, its check, and the inventory document.";
        Output: "family|kind|source|test|documentation, or empty text when the index is outside the catalog.";
    } {
        String family = This.CatFamilyAt(item);
        String kind = This.CatKindAt(item);
        If (family == "" || kind == "") {
            Return "";
        }
        Return family + "|" + kind + "|Examples/UI/Catalog.rxu|CheckCatalog|RobixUI.txt";
    }

    Public Function CatKindAt(Int item) -> String
    Explain {
        Description: "Return the control kind at a catalog index.";
        Input: item = "Zero-based catalog index";
        Processing: "Read the kind from that entry.";
        Output: "The kind, or empty text.";
    } {
        If (item < 0 || item >= This.catalogKinds.Count()) {
            Return "";
        }
        Return This.catalogKinds[item];
    }

    Public Function CatFamilyAt(Int item) -> String
    Explain {
        Description: "Return the family at a catalog index.";
        Input: item = "Zero-based catalog index";
        Processing: "Read the family from that entry.";
        Output: "The family code, or empty text.";
    } {
        If (item < 0 || item >= This.families.Count()) {
            Return "";
        }
        Return This.families[item];
    }

    Public Function CatKnown(String kind) -> Bool
    Explain {
        Description: "Report whether a kind is in the catalog.";
        Input: kind = "Control kind";
        Processing: "Search the catalog entries.";
        Output: "True when the kind is listed.";
    } {
        Int index = 0;
        While (index < This.catalogKinds.Count()) {
            If (This.catalogKinds[index] == kind) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Public Function CatFamilyOf(String kind) -> String
    Explain {
        Description: "Return the first family that lists a kind.";
        Input: kind = "Control kind";
        Processing: "Scan entries in order. Canvas belongs to C1 first and C6 as well.";
        Output: "The family code, or empty text.";
    } {
        Int index = 0;
        While (index < This.catalogKinds.Count()) {
            If (This.catalogKinds[index] == kind) {
                Return This.families[index];
            }
            index = index + 1;
        }
        Return "";
    }

    Public Function CatBeyond(String kind) -> Bool
    Explain {
        Description: "Report whether a kind is outside the MVP set.";
        Input: kind = "Control kind";
        Processing: "Known kinds other than the original MVP controls are beyond MVP.";
        Output: "True when the kind is in the catalog and is not an MVP control.";
    } {
        If (!This.CatKnown(kind)) {
            Return False;
        }
        String mvp = ",Window,View,Panel,StackPanel,Grid,Text,Image,Button,TextBox,CheckBox,ScrollView,ListView,Dialog,Spinner,";
        Return !mvp.Contains("," + kind + ",");
    }

    Public Function CatCreate(String kind, String id) -> Bool
    Explain {
        Description: "Create one catalog control.";
        Input: kind = "Control kind", id = "Instance name";
        Processing: "Reject an unknown kind, an empty name, or a duplicate name. Store defaults for that family.";
        Output: "True when the control is created.";
    } {
        If (id == "" || !This.CatKnown(kind) || This.CatIndex(id) >= 0) {
            Return False;
        }
        This.ids.Add(id);
        This.kinds.Add(kind);
        This.CatPut(id, "Visible", "true");
        This.CatPut(id, "Enabled", "true");
        This.CatPut(id, "Name", id);
        If (kind == "NumberBox" || kind == "Slider") {
            This.CatPut(id, "Min", "0");
            This.CatPut(id, "Max", "100");
        }
        If (kind == "CheckBox" || kind == "RadioButton" || kind == "Switch") {
            This.CatPut(id, "Checked", "false");
        }
        If (This.CatCollection(kind)) {
            This.CatPut(id, "Start", "0");
            This.CatPut(id, "Window", "0");
            This.CatPut(id, "Total", "0");
        }
        If (This.CatDrawing(kind)) {
            This.CatPut(id, "X", "0");
            This.CatPut(id, "Y", "0");
            This.CatPut(id, "Width", "10");
            This.CatPut(id, "Height", "10");
            This.CatPut(id, "Fill", "#336699");
            This.CatPut(id, "Stroke", "#112233");
            If (kind == "Circle") {
                This.CatPut(id, "Radius", "5");
            }
            If (kind == "Ellipse") {
                This.CatPut(id, "Rx", "6");
                This.CatPut(id, "Ry", "4");
            }
            If (kind == "Line") {
                This.CatPut(id, "X2", "10");
                This.CatPut(id, "Y2", "0");
            }
            If (kind == "Path") {
                This.CatPut(id, "Points", "M0,0 L10,0");
            }
            If (kind == "Polygon" || kind == "Polyline") {
                This.CatPut(id, "Points", "0,0 10,0 10,10");
            }
        }
        Return True;
    }

    Public Function CatSchema(String kind) -> String
    Explain {
        Description: "Return the property schema for a kind.";
        Input: kind = "Control kind";
        Processing: "Start from the common properties and add the family fields.";
        Output: "A comma-separated property list, or empty text when the kind is unknown.";
    } {
        If (!This.CatKnown(kind)) {
            Return "";
        }
        String common = "Name,Visible,Enabled,ToolTip";
        If (kind == "Canvas") {
            Return common + ",Orientation,Spacing,Dock,Columns,Rows,X,Y,Width,Height,Points,Fill,Stroke";
        }
        String family = This.CatFamilyOf(kind);
        If (family == "C1") {
            Return common + ",Orientation,Spacing,Dock,Columns,Rows";
        }
        If (family == "C2") {
            Return common + ",Text,Source,Value";
        }
        If (family == "C3") {
            String extra = common + ",Value,Placeholder";
            If (kind == "PasswordBox") {
                extra = extra + ",Password";
            }
            If (kind == "CheckBox" || kind == "RadioButton" || kind == "Switch") {
                extra = extra + ",Checked";
            }
            If (kind == "RadioButton") {
                extra = extra + ",Group";
            }
            If (kind == "NumberBox" || kind == "Slider") {
                extra = extra + ",Min,Max";
            }
            Return extra;
        }
        If (family == "C4") {
            Return common + ",Items,Selected,Columns";
        }
        If (family == "C5") {
            Return common + ",Title,Open,Route";
        }
        If (family == "C6") {
            String extra = common + ",X,Y,Width,Height,Fill,Stroke,Points";
            If (kind == "Circle") {
                extra = extra + ",Radius";
            }
            If (kind == "Ellipse") {
                extra = extra + ",Rx,Ry";
            }
            If (kind == "Line") {
                extra = extra + ",X2,Y2";
            }
            Return extra;
        }
        Return "";
    }

    Public Function CatSet(String id, String field, String value) -> Bool
    Explain {
        Description: "Set a typed property on a control.";
        Input: id = "Instance name", field = "Property name", value = "Property value";
        Processing: "Reject an unknown property or a value of the wrong type. A password is stored secretly and shown as a mask.";
        Output: "True when the value is stored.";
    } {
        Int index = This.CatIndex(id);
        If (index < 0 || !This.CatAccept(This.kinds[index], id, field, value)) {
            Return False;
        }
        String kind = This.kinds[index];
        If (kind == "PasswordBox" && (field == "Password" || field == "Value")) {
            This.CatSecretPut(id, value);
            String mask = This.CatMask(value);
            This.CatPut(id, "Value", mask);
            This.CatPut(id, "Password", mask);
            Return True;
        }
        If (kind == "RadioButton" && field == "Checked" && value == "true") {
            This.CatClearRadios(id);
        }
        This.CatPut(id, field, value);
        If (field == "Enabled" && value == "false" && This.focus == id) {
            This.focus = "";
        }
        Return True;
    }

    Public Function CatGet(String id, String field) -> String
    Explain {
        Description: "Read a property from a control.";
        Input: id = "Instance name", field = "Property name";
        Processing: "Return the stored value. A password reads back as its mask.";
        Output: "The value, or empty text.";
    } {
        Return This.CatTake(id, field);
    }

    Public Function CatBind(String id, String field, String source) -> Bool
    Explain {
        Description: "Bind a property to a named source.";
        Input: id = "Instance name", field = "Property name", source = "Source name";
        Processing: "Keep one binding for that property. The source must be named.";
        Output: "True when the binding is stored.";
    } {
        If (source == "" || This.CatIndex(id) < 0) {
            Return False;
        }
        Int index = This.CatIndex(id);
        If (!This.CatHasField(This.kinds[index], field)) {
            Return False;
        }
        This.binds.Add(id + "|" + field + ">" + source);
        Return True;
    }

    Public Function CatSource(String name, String value) -> Int
    Explain {
        Description: "Write a binding source and push it to bound properties.";
        Input: name = "Source name", value = "Source value";
        Processing: "Update every binding that reads this source when the value fits the property.";
        Output: "The number of properties updated.";
    } {
        Return This.CatPush(name, value);
    }

    Public Function CatAccess(String id) -> String
    Explain {
        Description: "Return the accessibility role.";
        Input: id = "Instance name";
        Processing: "Map the control kind to a role.";
        Output: "The role, or empty text when the control is missing.";
    } {
        Int index = This.CatIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.CatRole(This.kinds[index]);
    }

    Public Function CatLabel(String id) -> String
    Explain {
        Description: "Return the accessible name.";
        Input: id = "Instance name";
        Processing: "Use Name, then ToolTip.";
        Output: "The label, or empty text.";
    } {
        String label = This.CatTake(id, "Name");
        If (label == "") {
            Return This.CatTake(id, "ToolTip");
        }
        Return label;
    }

    Public Function CatCanFocus(String id) -> Bool
    Explain {
        Description: "Report whether a control can take focus.";
        Input: id = "Instance name";
        Processing: "Input, collection, and navigation controls can take focus while they are visible and enabled.";
        Output: "True when focus is allowed.";
    } {
        Int index = This.CatIndex(id);
        If (index < 0) {
            Return False;
        }
        If (This.CatTake(id, "Enabled") != "true" || This.CatTake(id, "Visible") != "true") {
            Return False;
        }
        Return This.CatFocusKind(This.kinds[index]);
    }

    Public Function CatFocus(String id) -> Bool
    Explain {
        Description: "Move focus to a control.";
        Input: id = "Instance name";
        Processing: "Focus a visible enabled input, collection, or navigation control.";
        Output: "True when that control is focused.";
    } {
        If (!This.CatCanFocus(id)) {
            Return False;
        }
        This.focus = id + "";
        Return True;
    }

    Public Function CatFocused() -> String
    Explain {
        Description: "Return the focused control.";
        Input: None;
        Processing: "Read the focus name.";
        Output: "The focused name, or empty text.";
    } {
        Return This.focus;
    }

    Public Function CatState(String id) -> String
    Explain {
        Description: "Return the interaction state.";
        Input: id = "Instance name";
        Processing: "Disabled, editing, pressed, focused, and checked win in that order.";
        Output: "The state name, or empty text when the control is missing.";
    } {
        If (This.CatIndex(id) < 0) {
            Return "";
        }
        If (This.CatTake(id, "Enabled") != "true") {
            Return "Disabled";
        }
        If (This.CatTake(id, "Editing") != "") {
            Return "Editing";
        }
        If (This.CatTake(id, "Pressed") == "true") {
            Return "Pressed";
        }
        If (This.focus == id) {
            Return "Focused";
        }
        If (This.CatTake(id, "Checked") == "true") {
            Return "Checked";
        }
        Return "Normal";
    }

    Public Function CatRaise(String id, String eventName) -> Bool
    Explain {
        Description: "Raise a common event on a control.";
        Input: id = "Instance name", eventName = "Event name";
        Processing: "Accept a common event on an enabled control. OnFocus requires a focusable control. OnPressed marks that control only.";
        Output: "True when the event is recorded.";
    } {
        If (This.CatIndex(id) < 0 || eventName == "") {
            Return False;
        }
        If (This.CatTake(id, "Enabled") != "true") {
            Return False;
        }
        String common = ",OnClick,OnChange,OnValueChange,OnFocus,OnBlur,OnKeyDown,OnPressed,";
        If (!common.Contains("," + eventName + ",")) {
            Return False;
        }
        If (eventName == "OnFocus" && !This.CatCanFocus(id)) {
            Return False;
        }
        If (eventName == "OnPressed") {
            This.CatPut(id, "Pressed", "true");
        }
        If (eventName == "OnFocus") {
            This.focus = id + "";
        }
        String key = id + "|" + eventName;
        Int index = 0;
        While (index < This.notes.Count()) {
            If (This.notes[index] == key) {
                Return True;
            }
            index = index + 1;
        }
        This.notes.Add(key);
        Return True;
    }

    Public Function CatHeard(String id, String eventName) -> Bool
    Explain {
        Description: "Report whether an event was raised.";
        Input: id = "Instance name", eventName = "Event name";
        Processing: "Look for that event on that control.";
        Output: "True when it was recorded.";
    } {
        String key = id + "|" + eventName;
        Int index = 0;
        While (index < This.notes.Count()) {
            If (This.notes[index] == key) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Public Function CatEdit(String id, Int row, Int column, String value) -> Bool
    Explain {
        Description: "Begin a DataGrid cell edit.";
        Input: id = "DataGrid name", row = "Row index", column = "Column index", value = "Cell value";
        Processing: "Edit a row inside the materialized window. The previous value is kept for cancel.";
        Output: "True when the cell is editing.";
    } {
        Int index = This.CatIndex(id);
        If (index < 0 || This.kinds[index] != "DataGrid" || column < 0) {
            Return False;
        }
        Int start = This.CatInt(This.CatTake(id, "Start"));
        Int window = This.CatInt(This.CatTake(id, "Window"));
        If (row < start || row >= start + window) {
            Return False;
        }
        This.CatPut(id, "Draft", This.CatReadCell(id, row, column));
        This.CatPutCell(id, row, column, value);
        This.CatPut(id, "Editing", row.ToString() + "," + column.ToString());
        Return True;
    }

    Public Function CatCell(String id, Int row, Int column) -> String
    Explain {
        Description: "Read a DataGrid cell.";
        Input: id = "DataGrid name", row = "Row index", column = "Column index";
        Processing: "Read the stored cell.";
        Output: "The cell text, or empty text.";
    } {
        Return This.CatReadCell(id, row, column);
    }

    Public Function CatCancelEdit(String id) -> Bool
    Explain {
        Description: "Cancel a DataGrid edit.";
        Input: id = "DataGrid name";
        Processing: "Restore the cell captured when the edit began.";
        Output: "True when an edit was cancelled.";
    } {
        String editing = This.CatTake(id, "Editing");
        If (editing == "") {
            Return False;
        }
        Int row = This.CatInt(This.CatPiece(editing, ",", 0));
        Int column = This.CatInt(This.CatPiece(editing, ",", 1));
        This.CatPutCell(id, row, column, This.CatTake(id, "Draft"));
        This.CatPut(id, "Editing", "");
        This.CatPut(id, "Draft", "");
        Return True;
    }

    Public Function CatCommitEdit(String id) -> Bool
    Explain {
        Description: "Commit a DataGrid edit.";
        Input: id = "DataGrid name";
        Processing: "Keep the edited cell and leave editing.";
        Output: "True when an edit was committed.";
    } {
        If (This.CatTake(id, "Editing") == "") {
            Return False;
        }
        This.CatPut(id, "Editing", "");
        This.CatPut(id, "Draft", "");
        Return True;
    }

    Public Function CatVirtual(String id, Int total, Int window) -> Int
    Explain {
        Description: "Virtualize a large collection.";
        Input: id = "Collection name", total = "Full item count", window = "Materialized row count";
        Processing: "Remember the total and materialize only the window. Rows outside the window are not created.";
        Output: "The number of materialized rows, or 0 when this kind is not a collection.";
    } {
        Int index = This.CatIndex(id);
        If (index < 0 || !This.CatCollection(This.kinds[index]) || total < 0 || window < 0) {
            Return 0;
        }
        Int shown = window;
        If (shown > total) {
            shown = total;
        }
        This.CatPut(id, "Total", total.ToString());
        This.CatPut(id, "Window", shown.ToString());
        This.CatPut(id, "Start", "0");
        Return shown;
    }

    Public Function CatScroll(String id, Int start) -> Bool
    Explain {
        Description: "Move a virtual window.";
        Input: id = "Collection name", start = "First materialized row";
        Processing: "Slide the window when the start still fits in the total.";
        Output: "True when the window moves.";
    } {
        Int index = This.CatIndex(id);
        If (index < 0 || !This.CatCollection(This.kinds[index]) || start < 0) {
            Return False;
        }
        Int total = This.CatInt(This.CatTake(id, "Total"));
        Int window = This.CatInt(This.CatTake(id, "Window"));
        If (start >= total || start + window > total) {
            Return False;
        }
        This.CatPut(id, "Start", start.ToString());
        Return True;
    }

    Public Function CatMaterialized(String id) -> Int
    Explain {
        Description: "Return how many collection rows are materialized.";
        Input: id = "Collection name";
        Processing: "Read the virtual window size.";
        Output: "The window size.";
    } {
        Return This.CatInt(This.CatTake(id, "Window"));
    }

    Public Function CatTotal(String id) -> Int
    Explain {
        Description: "Return the full collection size.";
        Input: id = "Collection name";
        Processing: "Read the stored total.";
        Output: "The total row count.";
    } {
        Return This.CatInt(This.CatTake(id, "Total"));
    }

    Public Function CatRow(String id, Int item) -> String
    Explain {
        Description: "Return a materialized row name.";
        Input: id = "Collection name", item = "Row index";
        Processing: "Name a row only when it sits inside the virtual window.";
        Output: "The row name, or empty text.";
    } {
        Int start = This.CatInt(This.CatTake(id, "Start"));
        Int window = This.CatInt(This.CatTake(id, "Window"));
        If (item < start || item >= start + window) {
            Return "";
        }
        Return id + "#" + item.ToString();
    }

    Public Function CatGeometry(String id) -> String
    Explain {
        Description: "Return the vector geometry of a drawing control.";
        Input: id = "Drawing name";
        Processing: "Build a command string from the stored geometry.";
        Output: "The command string, or empty text.";
    } {
        Int index = This.CatIndex(id);
        If (index < 0 || !This.CatDrawing(This.kinds[index])) {
            Return "";
        }
        String kind = This.kinds[index];
        String x = This.CatTake(id, "X");
        String y = This.CatTake(id, "Y");
        If (kind == "Circle") {
            Return "C" + x + "," + y + "," + This.CatTake(id, "Radius");
        }
        If (kind == "Ellipse") {
            Return "E" + x + "," + y + "," + This.CatTake(id, "Rx") + "," + This.CatTake(id, "Ry");
        }
        If (kind == "Line") {
            Return "L" + x + "," + y + "," + This.CatTake(id, "X2") + "," + This.CatTake(id, "Y2");
        }
        If (kind == "Path") {
            Return This.CatTake(id, "Points");
        }
        If (kind == "Polygon") {
            Return "P" + This.CatTake(id, "Points") + " Z";
        }
        If (kind == "Polyline") {
            Return "P" + This.CatTake(id, "Points");
        }
        Int right = This.CatInt(x) + This.CatInt(This.CatTake(id, "Width"));
        Int bottom = This.CatInt(y) + This.CatInt(This.CatTake(id, "Height"));
        Return "M" + x + "," + y + " H" + right.ToString() + " V" + bottom.ToString() + " H" + x + " Z";
    }

    Public Function CatHit(String id, Int x, Int y) -> Bool
    Explain {
        Description: "Test whether a point hits a drawing.";
        Input: id = "Drawing name", x = "Point x", y = "Point y";
        Processing: "Use the kind's geometry. A polyline hits only its vertices.";
        Output: "True when the point hits.";
    } {
        Int index = This.CatIndex(id);
        If (index < 0 || !This.CatDrawing(This.kinds[index])) {
            Return False;
        }
        String kind = This.kinds[index];
        Int left = This.CatInt(This.CatTake(id, "X"));
        Int top = This.CatInt(This.CatTake(id, "Y"));
        If (kind == "Circle") {
            Int radius = This.CatInt(This.CatTake(id, "Radius"));
            Int dx = x - left;
            Int dy = y - top;
            If (dx < 0) {
                dx = 0 - dx;
            }
            If (dy < 0) {
                dy = 0 - dy;
            }
            Return dx * dx + dy * dy <= radius * radius;
        }
        If (kind == "Ellipse") {
            Int rx = This.CatInt(This.CatTake(id, "Rx"));
            Int ry = This.CatInt(This.CatTake(id, "Ry"));
            Int dx = x - left;
            Int dy = y - top;
            If (dx < 0) {
                dx = 0 - dx;
            }
            If (dy < 0) {
                dy = 0 - dy;
            }
            Return dx * dx * ry * ry + dy * dy * rx * rx <= rx * rx * ry * ry;
        }
        If (kind == "Line") {
            Int x2 = This.CatInt(This.CatTake(id, "X2"));
            Int y2 = This.CatInt(This.CatTake(id, "Y2"));
            If (top == y2 && y == top) {
                Int minX = left;
                Int maxX = x2;
                If (x2 < left) {
                    minX = x2;
                    maxX = left;
                }
                Return x >= minX && x <= maxX;
            }
            If (left == x2 && x == left) {
                Int minY = top;
                Int maxY = y2;
                If (y2 < top) {
                    minY = y2;
                    maxY = top;
                }
                Return y >= minY && y <= maxY;
            }
            Return False;
        }
        If (kind == "Path") {
            Return This.CatTake(id, "Points").Contains(x.ToString() + "," + y.ToString());
        }
        If (kind == "Polyline") {
            String points = " " + This.CatTake(id, "Points") + " ";
            Return points.Contains(" " + x.ToString() + "," + y.ToString() + " ");
        }
        If (kind == "Polygon") {
            Return This.CatInside(This.CatTake(id, "Points"), x, y);
        }
        Int right = left + This.CatInt(This.CatTake(id, "Width"));
        Int bottom = top + This.CatInt(This.CatTake(id, "Height"));
        Return x >= left && x < right && y >= top && y < bottom;
    }

    Public Function CatCommand(String id, String name, String value) -> String
    Explain {
        Description: "Apply a vector command.";
        Input: id = "Drawing name", name = "Command name", value = "Command arguments";
        Processing: "Move, resize, extend a line, or append a point, then return the geometry.";
        Output: "The new geometry, or empty text when the command does not apply.";
    } {
        Int index = This.CatIndex(id);
        If (index < 0 || !This.CatDrawing(This.kinds[index]) || name == "") {
            Return "";
        }
        String kind = This.kinds[index];
        If (name == "Move") {
            This.CatPut(id, "X", This.CatPointX(value).ToString());
            This.CatPut(id, "Y", This.CatPointY(value).ToString());
            Return This.CatGeometry(id);
        }
        If (name == "Size") {
            If (kind == "Circle") {
                This.CatPut(id, "Radius", This.CatPointX(value).ToString());
            } Else If (kind == "Ellipse") {
                This.CatPut(id, "Rx", This.CatPointX(value).ToString());
                This.CatPut(id, "Ry", This.CatPointY(value).ToString());
            } Else {
                This.CatPut(id, "Width", This.CatPointX(value).ToString());
                This.CatPut(id, "Height", This.CatPointY(value).ToString());
            }
            Return This.CatGeometry(id);
        }
        If (name == "To" && kind == "Line") {
            This.CatPut(id, "X2", This.CatPointX(value).ToString());
            This.CatPut(id, "Y2", This.CatPointY(value).ToString());
            Return This.CatGeometry(id);
        }
        If (name == "Add" && (kind == "Path" || kind == "Polygon" || kind == "Polyline")) {
            String points = This.CatTake(id, "Points");
            If (kind == "Path") {
                points = points + " L" + value;
            } Else {
                points = points + " " + value;
            }
            This.CatPut(id, "Points", points);
            Return This.CatGeometry(id);
        }
        Return "";
    }

    Public Function CatSecret(String id) -> String
    Explain {
        Description: "Read a password that display properties keep masked.";
        Input: id = "PasswordBox name";
        Processing: "Return the stored secret for a password box.";
        Output: "The secret, or empty text.";
    } {
        Int index = This.CatIndex(id);
        If (index < 0 || This.kinds[index] != "PasswordBox") {
            Return "";
        }
        Return This.CatSecretTake(id);
    }

    Private Function CatWalk(RxuNode node) -> Int {
        Int count = 0;
        If (node.Kind == "Element" && This.CatKnown(node.Name)) {
            String id = node.FindAttribute("Name").Text + "";
            If (This.CatCreate(node.Name, id)) {
                count = 1;
            }
        }
        Int index = 0;
        While (index < node.Children.Count()) {
            count = count + This.CatWalk(node.Children[index]);
            index = index + 1;
        }
        Return count;
    }

    Private Function CatFill(String family, String names) -> Int {
        Int index = 0;
        Int count = This.CatPieces(names, ",");
        While (index < count) {
            This.families.Add(family);
            This.catalogKinds.Add(This.CatPiece(names, ",", index));
            index = index + 1;
        }
        Return count;
    }

    Private Function CatJoin(String family, String names) -> String {
        String text = "";
        Int index = 0;
        Int count = This.CatPieces(names, ",");
        While (index < count) {
            If (text != "") {
                text = text + ",";
            }
            text = text + family + ":" + This.CatPiece(names, ",", index);
            index = index + 1;
        }
        Return text;
    }

    Private Function CatSlot(Int item) -> String {
        String family = This.CatFamilyAt(item);
        String kind = This.CatKindAt(item);
        If (family == "" || kind == "") {
            Return "";
        }
        Return family + ":" + kind;
    }

    Private Function CatIndex(String id) -> Int {
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.ids[index] == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function CatPut(String id, String field, String value) -> Int {
        This.values.Add(id + "|" + field + "=" + value);
        Return 1;
    }

    Private Function CatTake(String id, String field) -> String {
        String key = id + "|" + field + "=";
        Int index = This.values.Count() - 1;
        While (index >= 0) {
            String row = This.values[index];
            If (row.StartsWith(key)) {
                If (row.Length() <= key.Length()) {
                    Return "";
                }
                Return row.Substring(key.Length());
            }
            index = index - 1;
        }
        Return "";
    }

    Private Function CatHasField(String kind, String field) -> Bool {
        String schema = This.CatSchema(kind);
        Return ("," + schema + ",").Contains("," + field + ",");
    }

    Private Function CatAccept(String kind, String id, String field, String value) -> Bool {
        If (!This.CatHasField(kind, field)) {
            Return False;
        }
        If (field == "Visible" || field == "Enabled" || field == "Checked" || field == "Open") {
            Return value == "true" || value == "false";
        }
        If (field == "Orientation") {
            Return value == "Horizontal" || value == "Vertical";
        }
        If (field == "Dock") {
            Return value == "Left" || value == "Right" || value == "Top" || value == "Bottom" || value == "Fill";
        }
        If (field == "Spacing" || field == "Columns" || field == "Rows" || field == "Width" || field == "Height" || field == "Radius" || field == "Rx" || field == "Ry" || field == "Min" || field == "Max") {
            Return This.CatNumber(value, False);
        }
        If (field == "X" || field == "Y" || field == "X2" || field == "Y2") {
            Return This.CatNumber(value, False);
        }
        If (field == "Fill" || field == "Stroke") {
            Return This.CatColor(value);
        }
        If (field == "Value" && (kind == "ProgressBar" || kind == "Spinner" || kind == "NumberBox" || kind == "Slider")) {
            Return This.CatRange(id, value, 0, 100);
        }
        If (field == "Value" && kind == "DatePicker") {
            Return This.CatDate(value);
        }
        If (field == "Value" && kind == "TimePicker") {
            Return This.CatTime(value);
        }
        If (field == "Value" && kind == "ColorPicker") {
            Return This.CatColor(value);
        }
        If (field == "Value" && kind == "FilePicker") {
            Return This.CatFile(value);
        }
        Return True;
    }

    Private Function CatFocusKind(String kind) -> Bool {
        String family = This.CatFamilyOf(kind);
        Return family == "C3" || family == "C4" || family == "C5";
    }

    Private Function CatRole(String kind) -> String {
        If (kind == "Application") {
            Return "Application";
        }
        If (kind == "Window") {
            Return "Window";
        }
        If (kind == "Dialog" || kind == "Popup" || kind == "Flyout" || kind == "Drawer") {
            Return "Dialog";
        }
        If (kind == "Button" || kind == "DatePicker" || kind == "TimePicker" || kind == "ColorPicker" || kind == "FilePicker") {
            Return "Button";
        }
        If (kind == "TextBox" || kind == "PasswordBox" || kind == "TextArea" || kind == "NumberBox") {
            Return "TextBox";
        }
        If (kind == "CheckBox" || kind == "Switch") {
            Return "CheckBox";
        }
        If (kind == "RadioButton") {
            Return "Radio";
        }
        If (kind == "Slider") {
            Return "Slider";
        }
        If (kind == "ComboBox" || kind == "DropDown") {
            Return "ComboBox";
        }
        If (kind == "Text" || kind == "Label" || kind == "RichText" || kind == "Badge" || kind == "Placeholder") {
            Return "Text";
        }
        If (kind == "Image" || kind == "Icon") {
            Return "Image";
        }
        If (kind == "ProgressBar" || kind == "Spinner") {
            Return "Progress";
        }
        If (kind == "Divider") {
            Return "Separator";
        }
        If (kind == "Tooltip") {
            Return "Tooltip";
        }
        If (kind == "Menu" || kind == "MenuItem") {
            Return "Menu";
        }
        If (kind == "ListView" || kind == "GridView" || kind == "TreeView" || kind == "Table" || kind == "DataGrid" || kind == "Repeater" || kind == "Carousel" || kind == "ItemsView") {
            Return "List";
        }
        If (kind == "Rectangle" || kind == "Circle" || kind == "Ellipse" || kind == "Line" || kind == "Path" || kind == "Polygon" || kind == "Polyline" || kind == "Canvas") {
            Return "Drawing";
        }
        String family = This.CatFamilyOf(kind);
        If (family == "C1") {
            Return "Group";
        }
        If (family == "C5") {
            Return "Navigation";
        }
        Return "Control";
    }

    Private Function CatCollection(String kind) -> Bool {
        Return This.CatFamilyOf(kind) == "C4";
    }

    Private Function CatDrawing(String kind) -> Bool {
        Return kind == "Canvas" || kind == "Rectangle" || kind == "Circle" || kind == "Ellipse" || kind == "Line" || kind == "Path" || kind == "Polygon" || kind == "Polyline";
    }

    Private Function CatMask(String value) -> String {
        String mask = "";
        Int index = 0;
        While (index < value.Length()) {
            mask = mask + "*";
            index = index + 1;
        }
        Return mask;
    }

    Private Function CatSecretPut(String id, String value) -> Int {
        This.secrets.Add(id + "=" + value);
        Return 1;
    }

    Private Function CatSecretTake(String id) -> String {
        String key = id + "=";
        Int index = This.secrets.Count() - 1;
        While (index >= 0) {
            String row = This.secrets[index];
            If (row.StartsWith(key)) {
                If (row.Length() <= key.Length()) {
                    Return "";
                }
                Return row.Substring(key.Length());
            }
            index = index - 1;
        }
        Return "";
    }

    Private Function CatClearRadios(String id) -> Int {
        String group = This.CatTake(id, "Group");
        Int index = 0;
        While (index < This.ids.Count()) {
            If (This.kinds[index] == "RadioButton" && This.ids[index] != id && This.CatTake(This.ids[index], "Group") == group) {
                This.CatPut(This.ids[index], "Checked", "false");
            }
            index = index + 1;
        }
        Return 1;
    }

    Private Function CatNumber(String value, Bool allowSign) -> Bool {
        If (value == "") {
            Return False;
        }
        Int index = 0;
        If (allowSign && value.GetChar(0) == "-") {
            If (value.Length() == 1) {
                Return False;
            }
            index = 1;
        }
        While (index < value.Length()) {
            String character = value.GetChar(index);
            If (character < "0" || character > "9") {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function CatColor(String value) -> Bool {
        If (value.Length() != 7 || value.GetChar(0) != "#") {
            Return False;
        }
        Int index = 1;
        While (index < 7) {
            String character = value.GetChar(index);
            Bool digit = character >= "0" && character <= "9";
            Bool lower = character >= "a" && character <= "f";
            Bool upper = character >= "A" && character <= "F";
            If (!digit && !lower && !upper) {
                Return False;
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function CatDate(String value) -> Bool {
        If (value.Length() != 10 || value.GetChar(4) != "-" || value.GetChar(7) != "-") {
            Return False;
        }
        Int index = 0;
        While (index < 10) {
            If (index != 4 && index != 7) {
                String character = value.GetChar(index);
                If (character < "0" || character > "9") {
                    Return False;
                }
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function CatTime(String value) -> Bool {
        If (value.Length() != 5 || value.GetChar(2) != ":") {
            Return False;
        }
        Int index = 0;
        While (index < 5) {
            If (index != 2) {
                String character = value.GetChar(index);
                If (character < "0" || character > "9") {
                    Return False;
                }
            }
            index = index + 1;
        }
        Return True;
    }

    Private Function CatFile(String value) -> Bool {
        Return value != "" && (value.Contains(".") || value.Contains("/"));
    }

    Private Function CatRange(String id, String value, Int low, Int high) -> Bool {
        If (!This.CatNumber(value, False)) {
            Return False;
        }
        Int number = value.ToInt();
        String minText = This.CatTake(id, "Min");
        String maxText = This.CatTake(id, "Max");
        Int min = low;
        Int max = high;
        If (minText != "") {
            min = minText.ToInt();
        }
        If (maxText != "") {
            max = maxText.ToInt();
        }
        Return number >= min && number <= max;
    }

    Private Function CatPutCell(String id, Int row, Int column, String value) -> Int {
        This.cells.Add(id + "|" + row.ToString() + "|" + column.ToString() + "=" + value);
        Return 1;
    }

    Private Function CatReadCell(String id, Int row, Int column) -> String {
        String key = id + "|" + row.ToString() + "|" + column.ToString() + "=";
        Int index = This.cells.Count() - 1;
        While (index >= 0) {
            String rowText = This.cells[index];
            If (rowText.StartsWith(key)) {
                If (rowText.Length() <= key.Length()) {
                    Return "";
                }
                Return rowText.Substring(key.Length());
            }
            index = index - 1;
        }
        Return "";
    }

    Private Function CatPush(String name, String value) -> Int {
        Int count = 0;
        Int index = This.binds.Count() - 1;
        While (index >= 0) {
            String row = This.binds[index];
            String id = This.CatPiece(row, "|", 0);
            String rest = This.CatPiece(row, "|", 1);
            String field = This.CatPiece(rest, ">", 0);
            String source = This.CatPiece(rest, ">", 1);
            String prefix = id + "|" + field + ">";
            If (source == name && !This.CatNewer(index, prefix) && This.CatSet(id, field, value)) {
                count = count + 1;
            }
            index = index - 1;
        }
        Return count;
    }

    Private Function CatNewer(Int before, String prefix) -> Bool {
        Int index = before + 1;
        While (index < This.binds.Count()) {
            If (This.binds[index].StartsWith(prefix)) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function CatInside(String points, Int x, Int y) -> Bool {
        Int index = 0;
        Int count = This.CatPieces(points, " ");
        Int minX = 0;
        Int maxX = 0;
        Int minY = 0;
        Int maxY = 0;
        Bool found = False;
        While (index < count) {
            String pair = This.CatPiece(points, " ", index);
            Int px = This.CatPointX(pair);
            Int py = This.CatPointY(pair);
            If (!found) {
                minX = px;
                maxX = px;
                minY = py;
                maxY = py;
                found = True;
            }
            If (px < minX) {
                minX = px;
            }
            If (px > maxX) {
                maxX = px;
            }
            If (py < minY) {
                minY = py;
            }
            If (py > maxY) {
                maxY = py;
            }
            index = index + 1;
        }
        If (!found) {
            Return False;
        }
        Return x >= minX && x <= maxX && y >= minY && y <= maxY;
    }

    Private Function CatPointX(String value) -> Int {
        Return This.CatInt(This.CatPiece(value, ",", 0));
    }

    Private Function CatPointY(String value) -> Int {
        Return This.CatInt(This.CatPiece(value, ",", 1));
    }

    Private Function CatInt(String value) -> Int {
        If (!This.CatNumber(value, False)) {
            Return 0;
        }
        Return value.ToInt();
    }

    Private Function CatPieces(String text, String separator) -> Int {
        If (text == "") {
            Return 0;
        }
        Int count = 1;
        Int index = 0;
        While (index < text.Length()) {
            If (text.GetChar(index) == separator) {
                count = count + 1;
            }
            index = index + 1;
        }
        Return count;
    }

    Private Function CatPiece(String text, String separator, Int item) -> String {
        Int seen = 0;
        Int start = 0;
        Int index = 0;
        While (index <= text.Length()) {
            Bool boundary = index == text.Length();
            If (!boundary) {
                boundary = text.GetChar(index) == separator;
            }
            If (boundary) {
                If (seen == item) {
                    Return text.Substring(start, index - start);
                }
                seen = seen + 1;
                start = index + 1;
            }
            index = index + 1;
        }
        Return "";
    }
}

Public Class FrameHost {
    Public RxuMessages Messages;
    Private List<String> commands;
    Private List<String> names;
    Private List<String> frames;
    Private List<String> hits;
    Private List<String> clips;
    Private String phase;
    Private String target;
    Private String keys;
    Private String pressed;
    Private Int pending;
    Private Int band;
    Private Int width;
    Private Int height;

    Public Constructor() {
        This.Messages = RxuMessages();
        This.commands = List<String>();
        This.names = List<String>();
        This.frames = List<String>();
        This.hits = List<String>();
        This.clips = List<String>();
        This.phase = "Open";
        This.target = "";
        This.keys = "";
        This.pressed = "";
        This.pending = 0;
        This.band = 0;
        This.width = 0;
        This.height = 0;
    }

    Public Function FrameAdopt(LayoutEngine engine, String root) -> Int
    Explain {
        Description: "Adopt one arranged display list.";
        Input: engine = "Laid-out engine", root = "Root slot name";
        Processing: "Copy commands and device frames. The first present is pending. Later presents wait for damage.";
        Output: "The number of drawing commands.";
    } {
        This.commands = List<String>();
        This.names = List<String>();
        This.frames = List<String>();
        Int index = 0;
        While (index < engine.CommandCount()) {
            This.commands.Add(engine.CommandAt(index));
            index = index + 1;
        }
        index = 0;
        While (index < engine.Slots.Count()) {
            String id = engine.Slots[index].Id;
            This.names.Add(id);
            This.frames.Add(engine.FrameOf(id));
            index = index + 1;
        }
        String rootFrame = engine.FrameOf(root);
        This.width = This.FrameInt(rootFrame, 2);
        This.height = This.FrameInt(rootFrame, 3);
        This.phase = "Open";
        This.pending = 1;
        This.FrameCollect();
        Return This.commands.Count();
    }

    Public Function FrameWrite(String path) -> Bool
    Explain {
        Description: "Write the retained display list for the rasterizer.";
        Input: path = "Output path";
        Processing: "Write the device size and the same commands CommandAt returns.";
        Output: "True when the list is written.";
    } {
        If (path == "" || This.commands.Count() == 0) {
            Return False;
        }
        String text = "size " + This.width.ToString() + " " + This.height.ToString() + "\n";
        Int index = 0;
        While (index < This.commands.Count()) {
            text = text + This.commands[index] + "\n";
            index = index + 1;
        }
        Files.WriteText(path, text);
        Return True;
    }

    Public Function FramePump() -> Int
    Explain {
        Description: "Run one frame of the universal clock.";
        Input: None;
        Processing: "A settled frame rasters nothing. One damaged region rasters once, then the frame is clean.";
        Output: "1 when a damaged region must be rastered, otherwise 0.";
    } {
        If (This.phase != "Open" || This.pending == 0) {
            Return 0;
        }
        This.pending = 0;
        Return 1;
    }

    Public Function FrameDamage(LayoutEngine engine, String id) -> Int
    Explain {
        Description: "Union the old and new device rectangles of one slot.";
        Input: engine = "Engine after the edit", id = "Slot name";
        Processing: "The next frame rasters that union, not the whole window.";
        Output: "The damaged area in device pixels.";
    } {
        String previous = This.FrameStored(id);
        String next = engine.FrameOf(id);
        Int left = This.FrameInt(previous, 0);
        Int top = This.FrameInt(previous, 1);
        Int right = left + This.FrameInt(previous, 2);
        Int bottom = top + This.FrameInt(previous, 3);
        Int nextLeft = This.FrameInt(next, 0);
        Int nextTop = This.FrameInt(next, 1);
        Int nextRight = nextLeft + This.FrameInt(next, 2);
        Int nextBottom = nextTop + This.FrameInt(next, 3);
        If (nextLeft < left) {
            left = nextLeft;
        }
        If (nextTop < top) {
            top = nextTop;
        }
        If (nextRight > right) {
            right = nextRight;
        }
        If (nextBottom > bottom) {
            bottom = nextBottom;
        }
        Int wide = right - left;
        Int high = bottom - top;
        If (wide < 0) {
            wide = 0;
        }
        If (high < 0) {
            high = 0;
        }
        This.band = wide * high;
        This.pending = 1;
        This.FrameStore(id, next);
        Return This.band;
    }

    Public Function FrameBand() -> Int
    Explain {
        Description: "Return the last damaged area.";
        Input: None;
        Processing: "Read the union rectangle.";
        Output: "The area in device pixels.";
    } {
        Return This.band;
    }

    Public Function FrameWindow() -> Int
    Explain {
        Description: "Return the window area.";
        Input: None;
        Processing: "Multiply the adopted device width and height.";
        Output: "The window area.";
    } {
        Return This.width * This.height;
    }

    Public Function FrameHit(Int x, Int y) -> String
    Explain {
        Description: "Hit-test a device point.";
        Input: x = "Device x", y = "Device y";
        Processing: "Walk painted commands from front to back and honor clip rectangles.";
        Output: "The target id, or empty text.";
    } {
        Int index = This.hits.Count() - 1;
        While (index >= 0) {
            String row = This.hits[index];
            Int left = This.FrameInt(row, 1);
            Int top = This.FrameInt(row, 2);
            Int wide = This.FrameInt(row, 3);
            Int high = This.FrameInt(row, 4);
            If (x >= left && y >= top && x < left + wide && y < top + high) {
                Return This.FramePiece(row, "|", 0);
            }
            index = index - 1;
        }
        Return "";
    }

    Public Function FrameHitSlot(String id) -> String
    Explain {
        Description: "Hit-test the center of one adopted slot.";
        Input: id = "Slot name";
        Processing: "Convert the stored device frame to a point and hit-test it.";
        Output: "The front-most id at that point.";
    } {
        String frame = This.FrameStored(id);
        Int x = This.FrameInt(frame, 0) + This.FrameInt(frame, 2) / 2;
        Int y = This.FrameInt(frame, 1) + This.FrameInt(frame, 3) / 2;
        Return This.FrameHit(x, y);
    }

    Public Function FramePointer(Int x, Int y) -> String
    Explain {
        Description: "Deliver a pointer press through the hit test.";
        Input: x = "Device x", y = "Device y";
        Processing: "Remember the target and mark it pressed. The event route stays outside this host.";
        Output: "The target id.";
    } {
        String id = This.FrameHit(x, y);
        This.target = id;
        If (id != "") {
            This.pressed = "Pressed";
            This.pending = 1;
        }
        Return id;
    }

    Public Function FrameKey(String text) -> String
    Explain {
        Description: "Deliver a key to the pressed target.";
        Input: text = "Key text";
        Processing: "Append the key while a target is pressed.";
        Output: "The keys accepted so far.";
    } {
        If (This.target == "" || text == "") {
            Return This.keys;
        }
        This.keys = This.keys + text;
        This.pending = 1;
        Return This.keys;
    }

    Public Function FramePressed() -> String
    Explain {
        Description: "Read the property a pointer press changed.";
        Input: None;
        Processing: "Read the pressed marker.";
        Output: "Pressed, or empty text.";
    } {
        Return This.pressed;
    }

    Public Function FrameKeys() -> String
    Explain {
        Description: "Read the keys accepted by the open frame.";
        Input: None;
        Processing: "Read the key buffer.";
        Output: "The key text.";
    } {
        Return This.keys;
    }

    Public Function FrameTarget() -> String
    Explain {
        Description: "Read the last pointer target.";
        Input: None;
        Processing: "Read the stored id.";
        Output: "The target id.";
    } {
        Return This.target;
    }

    Public Function FrameResize(LayoutEngine engine, String root, Int w, Int h) -> String
    Explain {
        Description: "Relayout after the client size changes.";
        Input: engine = "Layout engine", root = "Root slot", w = "Client width", h = "Client height";
        Processing: "Run Relayout and adopt the new display list.";
        Output: "The root device frame.";
    } {
        engine.Relayout(root, w, h);
        This.FrameAdopt(engine, root);
        Return engine.FrameOf(root);
    }

    Public Function FramePresent(String path) -> Bool
    Explain {
        Description: "Hand the display list to a surface.";
        Input: path = "List path, or empty when no display is attached";
        Processing: "A missing display records RXU049 and stays headless. The document stays open.";
        Output: "True when the list was written.";
    } {
        If (path == "" || This.phase != "Open") {
            This.Messages.Add("RXU049", "No display is attached, so the frame stays headless.", "", 1, 1, 7, "a display surface", "missing", "Present through the headless buffer.");
            Return False;
        }
        Return This.FrameWrite(path);
    }

    Public Function FrameClose() -> String
    Explain {
        Description: "Dispose the surface and stop the frame clock.";
        Input: None;
        Processing: "Mark the frame closed so later pumps raster nothing.";
        Output: "Closed.";
    } {
        This.phase = "Closed";
        This.pending = 0;
        Return This.phase;
    }

    Public Function FramePhase() -> String
    Explain {
        Description: "Read the frame phase.";
        Input: None;
        Processing: "Return Open or Closed.";
        Output: "The phase.";
    } {
        Return This.phase;
    }

    Private Function FrameCollect() -> Int {
        This.hits = List<String>();
        This.clips = List<String>();
        This.clips.Add("0|0|" + This.width.ToString() + "|" + This.height.ToString());
        Int index = 0;
        While (index < This.commands.Count()) {
            String command = This.commands[index];
            String kind = This.FramePiece(command, " ", 0);
            If (kind == "Clip") {
                String clip = This.FramePiece(command, " ", 1) + "|" + This.FramePiece(command, " ", 2) + "|" + This.FramePiece(command, " ", 3) + "|" + This.FramePiece(command, " ", 4);
                This.clips.Add(clip);
            } Else {
                If (kind == "Pop") {
                    If (This.clips.Count() > 1) {
                        List<String> kept = List<String>();
                        Int cursor = 0;
                        While (cursor < This.clips.Count() - 1) {
                            kept.Add(This.clips[cursor]);
                            cursor = cursor + 1;
                        }
                        This.clips = kept;
                    }
                } Else {
                    String id = This.FramePiece(command, " ", 1);
                    Int left = This.FrameInt(command, 2);
                    Int top = This.FrameInt(command, 3);
                    Int wide = This.FrameInt(command, 4);
                    Int high = This.FrameInt(command, 5);
                    String clip = This.clips[This.clips.Count() - 1];
                    Int clipLeft = This.FrameInt(clip, 0);
                    Int clipTop = This.FrameInt(clip, 1);
                    Int clipRight = clipLeft + This.FrameInt(clip, 2);
                    Int clipBottom = clipTop + This.FrameInt(clip, 3);
                    Int right = left + wide;
                    Int bottom = top + high;
                    If (left < clipLeft) {
                        left = clipLeft;
                    }
                    If (top < clipTop) {
                        top = clipTop;
                    }
                    If (right > clipRight) {
                        right = clipRight;
                    }
                    If (bottom > clipBottom) {
                        bottom = clipBottom;
                    }
                    wide = right - left;
                    high = bottom - top;
                    If (wide > 0 && high > 0 && id != "") {
                        This.hits.Add(id + "|" + left.ToString() + "|" + top.ToString() + "|" + wide.ToString() + "|" + high.ToString());
                    }
                }
            }
            index = index + 1;
        }
        Return This.hits.Count();
    }

    Private Function FrameStored(String id) -> String {
        Int index = 0;
        While (index < This.names.Count()) {
            If (This.names[index] == id) {
                Return This.frames[index];
            }
            index = index + 1;
        }
        Return "0,0,0,0";
    }

    Private Function FrameStore(String id, String frame) -> Int {
        Int index = 0;
        While (index < This.names.Count()) {
            If (This.names[index] == id) {
                This.frames[index] = frame + "";
                Return 1;
            }
            index = index + 1;
        }
        Return 0;
    }

    Private Function FrameInt(String text, Int item) -> Int {
        String piece = This.FramePiece(text, ",", item);
        If (piece == "") {
            piece = This.FramePiece(text, " ", item);
        }
        If (piece == "") {
            piece = This.FramePiece(text, "|", item);
        }
        If (piece == "" || piece == "-") {
            Return 0;
        }
        Int index = 0;
        Int value = 0;
        Int sign = 1;
        If (piece.GetChar(0) == "-") {
            sign = -1;
            index = 1;
        }
        While (index < piece.Length()) {
            String character = piece.GetChar(index);
            If (character < "0" || character > "9") {
                Return 0;
            }
            value = value * 10 + character.ToInt();
            index = index + 1;
        }
        Return sign * value;
    }

    Private Function FramePiece(String text, String separator, Int item) -> String {
        Int seen = 0;
        Int start = 0;
        Int index = 0;
        While (index <= text.Length()) {
            Bool boundary = index == text.Length();
            If (!boundary) {
                boundary = text.GetChar(index) == separator;
            }
            If (boundary) {
                If (seen == item) {
                    Return text.Substring(start, index - start);
                }
                seen = seen + 1;
                start = index + 1;
            }
            index = index + 1;
        }
        Return "";
    }
}


Public Class NavHost {
    Public RxuMessages Messages;
    Private List<String> pageIds;
    Private List<String> pageRoutes;
    Private List<String> pageTitles;
    Private List<String> pageAlive;
    Private List<String> history;
    Private List<String> future;
    Private List<String> crumbs;
    Private List<String> events;
    Private List<String> chromeKinds;
    Private List<String> chromeIds;
    Private List<String> overlayKinds;
    Private List<String> overlayIds;
    Private List<String> overlayOpen;
    Private List<String> overlayX;
    Private List<String> overlayY;
    Private List<String> windowIds;
    Private List<String> windowTitles;
    Private List<String> windowStates;
    Private List<String> windowX;
    Private List<String> windowY;
    Private List<String> savedTitles;
    Private List<String> savedX;
    Private List<String> savedY;
    Private String focus;
    Private String modal;
    Private String current;
    Private String phase;

    Public Constructor() {
        This.Messages = RxuMessages();
        This.pageIds = List<String>();
        This.pageRoutes = List<String>();
        This.pageTitles = List<String>();
        This.pageAlive = List<String>();
        This.history = List<String>();
        This.future = List<String>();
        This.crumbs = List<String>();
        This.events = List<String>();
        This.chromeKinds = List<String>();
        This.chromeIds = List<String>();
        This.overlayKinds = List<String>();
        This.overlayIds = List<String>();
        This.overlayOpen = List<String>();
        This.overlayX = List<String>();
        This.overlayY = List<String>();
        This.windowIds = List<String>();
        This.windowTitles = List<String>();
        This.windowStates = List<String>();
        This.windowX = List<String>();
        This.windowY = List<String>();
        This.savedTitles = List<String>();
        This.savedX = List<String>();
        This.savedY = List<String>();
        This.focus = "";
        This.modal = "";
        This.current = "";
        This.phase = "Open";
    }

    Public Function NavImport(RxuNode node) -> Int
    Explain {
        Description: "Import pages, chrome, overlays, and windows from markup.";
        Input: node = "Document or element";
        Processing: "Record each named page, menu, overlay, and window. Pages stay closed until navigation.";
        Output: "The number of pages.";
    } {
        This.NavWalk(node);
        Return This.pageIds.Count();
    }

    Public Function NavGo(String route) -> String
    Explain {
        Description: "Navigate to a route.";
        Input: route = "Page route";
        Processing: "Push the current page, clear the forward stack, and rebuild the breadcrumb.";
        Output: "The page id, or empty text when the route is missing.";
    } {
        If (This.phase != "Open") {
            Return "";
        }
        Int index = This.NavPageIndex(route);
        If (index < 0) {
            Return "";
        }
        If (This.current != "") {
            This.history.Add(This.current + "");
        }
        This.future = List<String>();
        This.current = This.pageIds[index] + "";
        This.NavCrumbs(route);
        This.NavNote("Navigate " + route);
        Return This.current + "";
    }

    Public Function NavBack() -> String
    Explain {
        Description: "Return to the previous page.";
        Input: None;
        Processing: "Pop history and keep the current page for forward navigation.";
        Output: "The page id, or empty text when history is empty.";
    } {
        If (This.phase != "Open" || This.history.Count() == 0) {
            Return "";
        }
        String previous = This.history[This.history.Count() - 1] + "";
        List<String> kept = List<String>();
        Int index = 0;
        While (index < This.history.Count() - 1) {
            kept.Add(This.history[index]);
            index = index + 1;
        }
        This.history = kept;
        If (This.current != "") {
            This.future.Add(This.current + "");
        }
        This.current = previous + "";
        This.NavCrumbs(This.NavRouteOf(previous));
        This.NavNote("Back " + This.NavRoute());
        Return This.current + "";
    }

    Public Function NavForward() -> String
    Explain {
        Description: "Enter the page that was left by going back.";
        Input: None;
        Processing: "Pop the forward stack and push the current page onto history.";
        Output: "The page id, or empty text when there is no forward page.";
    } {
        If (This.phase != "Open" || This.future.Count() == 0) {
            Return "";
        }
        String next = This.future[This.future.Count() - 1] + "";
        List<String> kept = List<String>();
        Int index = 0;
        While (index < This.future.Count() - 1) {
            kept.Add(This.future[index]);
            index = index + 1;
        }
        This.future = kept;
        If (This.current != "") {
            This.history.Add(This.current + "");
        }
        This.current = next + "";
        This.NavCrumbs(This.NavRouteOf(next));
        This.NavNote("Forward " + This.NavRoute());
        Return This.current + "";
    }

    Public Function NavRoute() -> String
    Explain {
        Description: "Read the current route.";
        Input: None;
        Processing: "Look up the route of the current page.";
        Output: "The route, or empty text.";
    } {
        Return This.NavRouteOf(This.current);
    }

    Public Function NavPage() -> String
    Explain {
        Description: "Read the current page id.";
        Input: None;
        Processing: "Return the id selected by the last navigation.";
        Output: "The page id.";
    } {
        Return This.current + "";
    }

    Public Function NavHistoryCount() -> Int
    Explain {
        Description: "Count pages that can be reached by going back.";
        Input: None;
        Processing: "Read the history stack.";
        Output: "The number of previous pages.";
    } {
        Return This.history.Count();
    }

    Public Function NavCrumbCount() -> Int
    Explain {
        Description: "Count breadcrumb segments.";
        Input: None;
        Processing: "Read the segments of the current route.";
        Output: "The number of crumbs.";
    } {
        Return This.crumbs.Count();
    }

    Public Function NavCrumbAt(Int index) -> String
    Explain {
        Description: "Read one breadcrumb.";
        Input: index = "Crumb index";
        Processing: "Return that route segment.";
        Output: "The segment, or empty text.";
    } {
        If (index < 0 || index >= This.crumbs.Count()) {
            Return "";
        }
        Return This.crumbs[index] + "";
    }

    Public Function NavEventCount() -> Int
    Explain {
        Description: "Count navigation events.";
        Input: None;
        Processing: "Read the event log.";
        Output: "The number of events.";
    } {
        Return This.events.Count();
    }

    Public Function NavEventAt(Int index) -> String
    Explain {
        Description: "Read one navigation event.";
        Input: index = "Event index";
        Processing: "Return the recorded text.";
        Output: "The event, or empty text.";
    } {
        If (index < 0 || index >= This.events.Count()) {
            Return "";
        }
        Return This.events[index] + "";
    }

    Public Function NavChrome(String id) -> String
    Explain {
        Description: "Read the kind of a menu, toolbar, status bar, title bar, or tab.";
        Input: id = "Chrome id";
        Processing: "Find the imported chrome item.";
        Output: "The kind, or empty text.";
    } {
        Int index = This.NavChromeIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.chromeKinds[index] + "";
    }

    Public Function NavChromeCount() -> Int
    Explain {
        Description: "Count imported chrome items.";
        Input: None;
        Processing: "Read the chrome list.";
        Output: "The number of items.";
    } {
        Return This.chromeIds.Count();
    }

    Public Function NavOpenOverlay(String id) -> Bool
    Explain {
        Description: "Open a popup, flyout, drawer, or dialog.";
        Input: id = "Overlay id";
        Processing: "Mark it open. A dialog becomes the modal focus owner.";
        Output: "True when the overlay exists.";
    } {
        Int index = This.NavOverlayIndex(id);
        If (index < 0 || This.phase != "Open") {
            Return False;
        }
        This.overlayOpen[index] = "Open";
        If (This.overlayKinds[index] == "Dialog") {
            This.modal = id + "";
            This.focus = id + "";
        }
        This.NavNote("Open " + id);
        Return True;
    }

    Public Function NavCloseOverlay(String id) -> Bool
    Explain {
        Description: "Close an overlay.";
        Input: id = "Overlay id";
        Processing: "Mark it closed and release modal focus when it was the dialog.";
        Output: "True when the overlay exists.";
    } {
        Int index = This.NavOverlayIndex(id);
        If (index < 0) {
            Return False;
        }
        This.overlayOpen[index] = "Closed";
        If (This.modal == id) {
            This.modal = "";
            This.focus = "";
        }
        This.NavNote("Close " + id);
        Return True;
    }

    Public Function NavOverlayState(String id) -> String
    Explain {
        Description: "Read whether an overlay is open.";
        Input: id = "Overlay id";
        Processing: "Return the stored state.";
        Output: "Open, Closed, or empty text.";
    } {
        Int index = This.NavOverlayIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.overlayOpen[index] + "";
    }

    Public Function NavModal() -> String
    Explain {
        Description: "Read the modal dialog.";
        Input: None;
        Processing: "Return the dialog that owns focus.";
        Output: "The dialog id, or empty text.";
    } {
        Return This.modal + "";
    }

    Public Function NavFocus(String id) -> Bool
    Explain {
        Description: "Move focus.";
        Input: id = "Control id";
        Processing: "Refuse a target outside the modal dialog.";
        Output: "True when focus moved.";
    } {
        If (This.modal != "" && id != This.modal) {
            Return False;
        }
        This.focus = id + "";
        Return True;
    }

    Public Function NavFocused() -> String
    Explain {
        Description: "Read the focused id.";
        Input: None;
        Processing: "Return the id kept by the last focus change.";
        Output: "The focused id.";
    } {
        Return This.focus + "";
    }

    Public Function NavKey(String key) -> String
    Explain {
        Description: "Handle a key while a dialog may be open.";
        Input: key = "Tab or Escape";
        Processing: "Tab stays inside the dialog. Escape closes it.";
        Output: "The focused id after the key.";
    } {
        If (key == "Escape" && This.modal != "") {
            This.NavCloseOverlay(This.modal);
            Return "";
        }
        If (key == "Tab" && This.modal != "") {
            This.focus = This.modal + "";
            This.NavNote("Tab " + This.modal);
            Return This.focus + "";
        }
        Return This.focus + "";
    }

    Public Function NavMoveOverlay(String id, Int x, Int y) -> Bool
    Explain {
        Description: "Place a popup.";
        Input: id = "Overlay id", x = "X", y = "Y";
        Processing: "Store the placement in logical pixels.";
        Output: "True when the overlay exists.";
    } {
        Int index = This.NavOverlayIndex(id);
        If (index < 0) {
            Return False;
        }
        This.overlayX[index] = x.ToString();
        This.overlayY[index] = y.ToString();
        Return True;
    }

    Public Function NavPopupAt(String id) -> String
    Explain {
        Description: "Read a popup placement.";
        Input: id = "Overlay id";
        Processing: "Join the stored x and y.";
        Output: "x,y or empty text.";
    } {
        Int index = This.NavOverlayIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.overlayX[index] + "," + This.overlayY[index];
    }

    Public Function NavWindowCount() -> Int
    Explain {
        Description: "Count windows.";
        Input: None;
        Processing: "Read the window list.";
        Output: "The number of windows.";
    } {
        Return This.windowIds.Count();
    }

    Public Function NavWindowState(String id) -> String
    Explain {
        Description: "Read a window state.";
        Input: id = "Window id";
        Processing: "Return Hidden, Shown, or Closed.";
        Output: "The state, or empty text.";
    } {
        Int index = This.NavWindowIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.windowStates[index] + "";
    }

    Public Function NavShowWindow(String id) -> Bool
    Explain {
        Description: "Show a window that is not closed.";
        Input: id = "Window id";
        Processing: "A closed window must be reopened instead.";
        Output: "True when the window is shown.";
    } {
        Int index = This.NavWindowIndex(id);
        If (index < 0 || This.windowStates[index] == "Closed") {
            Return False;
        }
        This.windowStates[index] = "Shown";
        This.NavNote("Show " + id);
        Return True;
    }

    Public Function NavHideWindow(String id) -> Bool
    Explain {
        Description: "Hide a shown window.";
        Input: id = "Window id";
        Processing: "Keep the window so it can be shown again.";
        Output: "True when the window exists.";
    } {
        Int index = This.NavWindowIndex(id);
        If (index < 0 || This.windowStates[index] == "Closed") {
            Return False;
        }
        This.windowStates[index] = "Hidden";
        This.NavNote("Hide " + id);
        Return True;
    }

    Public Function NavCloseWindow(String id) -> Bool
    Explain {
        Description: "Close a window.";
        Input: id = "Window id";
        Processing: "Mark it closed and keep the record for reopen.";
        Output: "True when the window exists.";
    } {
        Int index = This.NavWindowIndex(id);
        If (index < 0) {
            Return False;
        }
        This.windowStates[index] = "Closed";
        This.NavNote("Close " + id);
        Return True;
    }

    Public Function NavReopenWindow(String id) -> Bool
    Explain {
        Description: "Open a closed window again.";
        Input: id = "Window id";
        Processing: "Change Closed to Shown.";
        Output: "True when the window was closed.";
    } {
        Int index = This.NavWindowIndex(id);
        If (index < 0 || This.windowStates[index] != "Closed") {
            Return False;
        }
        This.windowStates[index] = "Shown";
        This.NavNote("Reopen " + id);
        Return True;
    }

    Public Function NavSetTitle(String id, String title) -> Bool
    Explain {
        Description: "Change a window title.";
        Input: id = "Window id", title = "Title";
        Processing: "Store the title on that window.";
        Output: "True when the window exists.";
    } {
        Int index = This.NavWindowIndex(id);
        If (index < 0) {
            Return False;
        }
        This.windowTitles[index] = title + "";
        Return True;
    }

    Public Function NavReadTitle(String id) -> String
    Explain {
        Description: "Read a window title.";
        Input: id = "Window id";
        Processing: "Return the stored title.";
        Output: "The title, or empty text.";
    } {
        Int index = This.NavWindowIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.windowTitles[index] + "";
    }

    Public Function NavMoveWindow(String id, Int x, Int y) -> Bool
    Explain {
        Description: "Move a window.";
        Input: id = "Window id", x = "X", y = "Y";
        Processing: "Store the position.";
        Output: "True when the window exists.";
    } {
        Int index = This.NavWindowIndex(id);
        If (index < 0) {
            Return False;
        }
        This.windowX[index] = x.ToString();
        This.windowY[index] = y.ToString();
        Return True;
    }

    Public Function NavReadPosition(String id) -> String
    Explain {
        Description: "Read a window position.";
        Input: id = "Window id";
        Processing: "Join the stored x and y.";
        Output: "x,y or empty text.";
    } {
        Int index = This.NavWindowIndex(id);
        If (index < 0) {
            Return "";
        }
        Return This.windowX[index] + "," + This.windowY[index];
    }

    Public Function NavSave(String id) -> Bool
    Explain {
        Description: "Save window title and position.";
        Input: id = "Window id";
        Processing: "Copy the current title and position into the saved slot.";
        Output: "True when the window exists.";
    } {
        Int index = This.NavWindowIndex(id);
        If (index < 0) {
            Return False;
        }
        This.savedTitles[index] = This.windowTitles[index] + "";
        This.savedX[index] = This.windowX[index] + "";
        This.savedY[index] = This.windowY[index] + "";
        Return True;
    }

    Public Function NavRestore(String id) -> Bool
    Explain {
        Description: "Restore a saved window title and position.";
        Input: id = "Window id";
        Processing: "Copy the saved slot back onto the window.";
        Output: "True when a snapshot exists.";
    } {
        Int index = This.NavWindowIndex(id);
        If (index < 0 || This.savedTitles[index] == "") {
            Return False;
        }
        This.windowTitles[index] = This.savedTitles[index] + "";
        This.windowX[index] = This.savedX[index] + "";
        This.windowY[index] = This.savedY[index] + "";
        Return True;
    }

    Public Function NavDrop(String id) -> Bool
    Explain {
        Description: "Tear down a page.";
        Input: id = "Page id";
        Processing: "Mark the page dead so navigation cannot enter it.";
        Output: "True when the page existed.";
    } {
        Int index = 0;
        Bool found = False;
        While (index < This.pageIds.Count()) {
            If (This.pageIds[index] == id && This.pageAlive[index] == "true") {
                This.pageAlive[index] = "false";
                found = True;
            }
            index = index + 1;
        }
        If (This.current == id) {
            This.current = "";
            This.crumbs = List<String>();
        }
        This.NavNote("Drop " + id);
        Return found;
    }

    Public Function NavAlive(String id) -> Bool
    Explain {
        Description: "Report whether a page is still in the navigation tree.";
        Input: id = "Page id";
        Processing: "A dropped page is not alive.";
        Output: "True when the page can still be entered.";
    } {
        Int index = 0;
        While (index < This.pageIds.Count()) {
            If (This.pageIds[index] == id && This.pageAlive[index] == "true") {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Public Function NavCloseHost() -> String
    Explain {
        Description: "Close navigation.";
        Input: None;
        Processing: "Refuse later navigation and keep the event log.";
        Output: "Closed.";
    } {
        This.phase = "Closed";
        This.modal = "";
        This.focus = "";
        Return This.phase + "";
    }

    Public Function NavPhase() -> String
    Explain {
        Description: "Read the navigation phase.";
        Input: None;
        Processing: "Return Open or Closed.";
        Output: "The phase name.";
    } {
        Return This.phase + "";
    }

    Private Function NavWalk(RxuNode node) -> Int {
        Int count = 0;
        If (node.Kind == "Element") {
            String id = node.FindAttribute("Name").Text;
            String kind = node.Name + "";
            If (id != "") {
                If (kind == "Page") {
                    This.pageIds.Add(id + "");
                    This.pageRoutes.Add(node.FindAttribute("Route").Text + "");
                    This.pageTitles.Add(node.FindAttribute("Title").Text + "");
                    This.pageAlive.Add("true");
                    count = 1;
                }
                If (kind == "Menu" || kind == "MenuItem" || kind == "Toolbar" || kind == "StatusBar" || kind == "TitleBar" || kind == "TabItem") {
                    This.chromeKinds.Add(kind + "");
                    This.chromeIds.Add(id + "");
                }
                If (kind == "Popup" || kind == "Flyout" || kind == "Drawer" || kind == "Dialog") {
                    This.overlayKinds.Add(kind + "");
                    This.overlayIds.Add(id + "");
                    This.overlayOpen.Add("Closed");
                    This.overlayX.Add("0");
                    This.overlayY.Add("0");
                }
                If (kind == "Window") {
                    This.windowIds.Add(id + "");
                    This.windowTitles.Add(node.FindAttribute("Title").Text + "");
                    This.windowStates.Add("Hidden");
                    This.windowX.Add("0");
                    This.windowY.Add("0");
                    This.savedTitles.Add("");
                    This.savedX.Add("");
                    This.savedY.Add("");
                }
            }
        }
        Int index = 0;
        While (index < node.Children.Count()) {
            count = count + This.NavWalk(node.Children[index]);
            index = index + 1;
        }
        Return count;
    }

    Private Function NavPageIndex(String route) -> Int {
        Int index = 0;
        While (index < This.pageRoutes.Count()) {
            If (This.pageRoutes[index] == route && This.pageAlive[index] == "true") {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function NavRouteOf(String id) -> String {
        Int index = 0;
        While (index < This.pageIds.Count()) {
            If (This.pageIds[index] == id) {
                Return This.pageRoutes[index] + "";
            }
            index = index + 1;
        }
        Return "";
    }

    Private Function NavCrumbs(String route) -> Int {
        This.crumbs = List<String>();
        Int start = 0;
        Int index = 0;
        While (index <= route.Length()) {
            Bool boundary = index == route.Length();
            If (!boundary) {
                boundary = route.GetChar(index) == "/";
            }
            If (boundary && index > start) {
                This.crumbs.Add(route.Substring(start, index - start));
            }
            If (boundary) {
                start = index + 1;
            }
            index = index + 1;
        }
        Return This.crumbs.Count();
    }

    Private Function NavNote(String text) -> Int {
        This.events.Add(text + "");
        Return This.events.Count();
    }

    Private Function NavChromeIndex(String id) -> Int {
        Int index = 0;
        While (index < This.chromeIds.Count()) {
            If (This.chromeIds[index] == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function NavOverlayIndex(String id) -> Int {
        Int index = 0;
        While (index < This.overlayIds.Count()) {
            If (This.overlayIds[index] == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }

    Private Function NavWindowIndex(String id) -> Int {
        Int index = 0;
        While (index < This.windowIds.Count()) {
            If (This.windowIds[index] == id) {
                Return index;
            }
            index = index + 1;
        }
        Return -1;
    }
}

Private Function ReadExample(String path) -> RxuNode {
    RxuParser parser = RxuParser();
    Return parser.Parse(path, Files.ReadText(path));
}

Private Function ExpectAttribute(String path, String element, String attribute, String mode, String text) -> Int {
    RxuNode document = ReadExample(path);
    RxuNode node = document.FindChild(element);
    RxuNode value = node.FindAttribute(attribute);
    Bool bad = document.Messages.Count() != 0 || node.Name != element || value.Mode != mode || value.Text != text;
    Return FailWhen(bad, path);
}

Private Function ElementAt(RxuNode parent, Int nth) -> RxuNode {
    Int seen = 0;
    Int cursor = 0;
    While (cursor < parent.Children.Count()) {
        RxuNode child = parent.Children[cursor];
        If (child.Kind == "Element") {
            If (seen == nth) {
                Return child;
            }
            seen = seen + 1;
        }
        cursor = cursor + 1;
    }
    Return RxuNode();
}

Private Function ExpectCode(String path, String code) -> Int {
    RxuNode document = ReadExample(path);
    Return FailWhen(document.Messages.Find(code) < 0, path);
}

Private Function ExpectSource(String name, String source, String code) -> Int {
    RxuParser parser = RxuParser();
    RxuNode document = parser.Parse(name, source);
    Return FailWhen(document.Messages.Find(code) < 0, name);
}

Public Function CheckExamples() -> Int
Explain {
    Description: "Parse every RXU example and check the feature it demonstrates.";
    Input: None;
    Processing: "Accept Examples/UI markup and require the matching diagnostic for Examples/UI/Rejected.";
    Output: "The number of failed example checks.";
} {
    Int failed = 0;
    failed = failed + ExpectAttribute("Examples/UI/Element.rxu", "Window", "Title", "String", "Arm");
    failed = failed + ExpectAttribute("Examples/UI/SelfClosing.rxu", "Button", "Text", "String", "Move");
    failed = failed + ExpectAttribute("Examples/UI/StringValue.rxu", "Text", "Value", "String", "Line\nNext");
    failed = failed + ExpectAttribute("Examples/UI/NumberValue.rxu", "Window", "Width", "Number", "320");
    failed = failed + ExpectAttribute("Examples/UI/FloatValue.rxu", "Window", "Opacity", "Float", "0.5");
    failed = failed + ExpectAttribute("Examples/UI/BooleanValue.rxu", "Window", "Enabled", "Boolean", "true");
    failed = failed + ExpectAttribute("Examples/UI/BooleanValue.rxu", "Window", "Visible", "Boolean", "true");
    failed = failed + ExpectAttribute("Examples/UI/Binding.rxu", "Button", "Text", "Binding", "Joint");
    failed = failed + ExpectAttribute("Examples/UI/ResourceExpression.rxu", "Text", "Value", "Resource", "Accent");
    failed = failed + ExpectAttribute("Examples/UI/Localization.rxu", "Text", "Value", "Localization", "Title");
    failed = failed + ExpectAttribute("Examples/UI/ValueExpression.rxu", "Text", "Value", "Expression", "Panel.Width");
    failed = failed + ExpectAttribute("Examples/UI/NameExpression.rxu", "Text", "Value", "Expression", "Joints");
    failed = failed + ExpectAttribute("Examples/UI/Component.rxu", "Component", "Name", "String", "Move");
    failed = failed + ExpectAttribute("Examples/UI/Import.rxu", "Import", "Source", "String", "Theme.rxu");
    failed = failed + ExpectAttribute("Examples/UI/Include.rxu", "Include", "Source", "String", "Part.rxu");
    failed = failed + ExpectAttribute("Examples/UI/Let.rxu", "Let", "Name", "String", "Title");
    failed = failed + ExpectAttribute("Examples/UI/Set.rxu", "Set", "Value", "Number", "320");
    failed = failed + ExpectAttribute("Examples/UI/Bind.rxu", "Bind", "Source", "Binding", "Joint");
    failed = failed + ExpectAttribute("Examples/UI/Unicode.rxu", "Label", "Text", "String", "Café");
    failed = failed + ExpectAttribute("Examples/UI/Escapes.rxu", "Text", "Value", "String", "A\rB\tC\\D");
    RxuNode nesting = ReadExample("Examples/UI/Nesting.rxu");
    RxuNode leaf = nesting.FindChild("Window").FindChild("Panel").FindChild("Panel").FindChild("Label");
    failed = failed + FailWhen(nesting.Messages.Count() != 0 || leaf.FindAttribute("Text").Text != "Nest", "Examples/UI/Nesting.rxu");
    RxuNode comment = ReadExample("Examples/UI/Comment.rxu");
    failed = failed + FailWhen(comment.Messages.Count() != 0 || comment.FindChild("Panel").FindKind("Comment").Text != " arm panel ", "Examples/UI/Comment.rxu");
    RxuNode embedded = ReadExample("Examples/UI/EmbeddedBinding.rxu");
    RxuNode embeddedValue = embedded.FindChild("Panel").FindKind("Expression");
    failed = failed + FailWhen(embedded.Messages.Count() != 0 || embeddedValue.Mode != "Binding" || embeddedValue.Text != "User.Name", "Examples/UI/EmbeddedBinding.rxu");
    RxuNode space = ReadExample("Examples/UI/Whitespace.rxu");
    failed = failed + FailWhen(space.Messages.Count() != 0 || space.FindChild("Panel").FindKind("Text").Text != " Hi ", "Examples/UI/Whitespace.rxu");
    RxuNode button = ReadExample("Examples/UI/SelfClosing.rxu").FindChild("Button");
    failed = failed + FailWhen(button.Mode != "Empty", "Examples/UI/SelfClosing.rxu mode");
    RxuNode paired = ReadExample("Examples/UI/Element.rxu").FindChild("Window");
    failed = failed + FailWhen(paired.Mode != "Pair", "Examples/UI/Element.rxu mode");
    RxuNode color = ReadExample("Examples/UI/Resources.rxu").FindChild("Resources").FindChild("Color");
    failed = failed + FailWhen(color.FindAttribute("Name").Text != "Accent" || color.FindAttribute("Value").Text != "#336699", "Examples/UI/Resources.rxu color");
    RxuNode move = ReadExample("Examples/UI/Component.rxu").FindChild("Component").FindChild("Button");
    failed = failed + FailWhen(move.FindAttribute("Text").Mode != "Binding" || move.FindAttribute("Text").Text != "Joint", "Examples/UI/Component.rxu button");
    RxuNode branch = ReadExample("Examples/UI/IfElse.rxu");
    RxuNode ifNode = branch.FindChild("Panel").FindChild("If");
    failed = failed + FailWhen(branch.Messages.Count() != 0 || ifNode.FindAttribute("Condition").Text != "LoggedIn" || ifNode.FindChild("Else").FindChild("Text").FindAttribute("Value").Text != "Go" || branch.FindChild("Panel").FindChild("Else").Name != "", "Examples/UI/IfElse.rxu");
    RxuNode elseIf = ReadExample("Examples/UI/ElseIf.rxu");
    RxuNode elseIfNode = elseIf.FindChild("Panel").FindChild("If");
    failed = failed + FailWhen(elseIf.Messages.Count() != 0 || elseIfNode.FindChild("ElseIf").FindAttribute("Condition").Text != "Guest" || elseIfNode.FindChild("Else").FindChild("Text").FindAttribute("Value").Text != "Go" || elseIf.FindChild("Panel").FindChild("ElseIf").Name != "", "Examples/UI/ElseIf.rxu");
    RxuNode nearest = ReadExample("Examples/UI/NearestElse.rxu");
    RxuNode nearestPanel = nearest.FindChild("Panel");
    failed = failed + FailWhen(nearest.Messages.Count() != 0 || ElementAt(nearestPanel, 1).FindChild("Else").FindAttribute("Name").Text != "C" || ElementAt(nearestPanel, 0).FindChild("Else").Name != "" || ElementAt(nearestPanel, 2).Name != "", "Examples/UI/NearestElse.rxu");
    RxuNode choose = ReadExample("Examples/UI/Choose.rxu");
    RxuNode chooseNode = choose.FindChild("Choose");
    failed = failed + FailWhen(choose.Messages.Count() != 0 || chooseNode.FindAttribute("Value").Mode != "Expression" || chooseNode.FindChild("When").FindAttribute("Value").Text != "Live" || chooseNode.FindChild("Otherwise").FindChild("Text").FindAttribute("Value").Text != "Idle", "Examples/UI/Choose.rxu");
    RxuNode switchNode = ReadExample("Examples/UI/Switch.rxu").FindChild("Switch");
    failed = failed + FailWhen(switchNode.FindChild("When").FindAttribute("Value").Text != "Live" || switchNode.FindChild("Default").FindChild("Text").FindAttribute("Value").Text != "Idle", "Examples/UI/Switch.rxu");
    RxuNode adopted = ReadExample("Examples/UI/AdoptedWhen.rxu");
    RxuNode adoptedPanel = adopted.FindChild("Panel");
    failed = failed + FailWhen(adopted.Messages.Count() != 0 || ElementAt(adoptedPanel, 1).Name != "" || ElementAt(adoptedPanel, 0).FindChild("When").FindAttribute("Value").Text != "On", "Examples/UI/AdoptedWhen.rxu");
    RxuNode each = ReadExample("Examples/UI/Each.rxu").FindChild("Each");
    failed = failed + FailWhen(each.FindAttribute("Items").Mode != "Expression" || each.FindAttribute("Items").Text != "Joints" || each.FindAttribute("As").Text != "joint" || each.FindChild("Text").FindAttribute("Value").Text != "joint", "Examples/UI/Each.rxu");
    RxuNode forNode = ReadExample("Examples/UI/For.rxu").FindChild("For");
    failed = failed + FailWhen(forNode.FindAttribute("Items").Text != "Joints" || forNode.FindChild("Text").FindAttribute("Value").Mode != "Expression", "Examples/UI/For.rxu");
    RxuNode forEach = ReadExample("Examples/UI/ForEach.rxu").FindChild("ForEach");
    failed = failed + FailWhen(forEach.FindAttribute("As").Text != "joint" || forEach.FindChild("Text").FindAttribute("Value").Text != "joint", "Examples/UI/ForEach.rxu");
    failed = failed + ExpectCode("Examples/UI/Rejected/Mismatch.rxu", "RXU001");
    failed = failed + ExpectCode("Examples/UI/Rejected/Unclosed.rxu", "RXU002");
    failed = failed + ExpectCode("Examples/UI/Rejected/Malformed.rxu", "RXU003");
    failed = failed + ExpectCode("Examples/UI/Rejected/UnclosedString.rxu", "RXU004");
    failed = failed + ExpectCode("Examples/UI/Rejected/UnclosedExpression.rxu", "RXU005");
    failed = failed + ExpectCode("Examples/UI/Rejected/UnclosedComment.rxu", "RXU006");
    failed = failed + ExpectCode("Examples/UI/Rejected/EmptyExpression.rxu", "RXU007");
    failed = failed + ExpectCode("Examples/UI/Rejected/While.rxu", "RXU008");
    failed = failed + ExpectCode("Examples/UI/Rejected/XmlDeclaration.rxu", "RXU009");
    failed = failed + ExpectCode("Examples/UI/Rejected/LooseElse.rxu", "RXU010");
    failed = failed + ExpectCode("Examples/UI/Rejected/OrphanWhen.rxu", "RXU011");
    failed = failed + ExpectCode("Examples/UI/Rejected/DuplicateElse.rxu", "RXU012");
    failed = failed + ExpectCode("Examples/UI/Rejected/ElseIfAfterElse.rxu", "RXU012");
    failed = failed + ExpectCode("Examples/UI/Rejected/DuplicateDefault.rxu", "RXU013");
    failed = failed + ExpectCode("Examples/UI/Rejected/Namespace.rxu", "RXU015");
    failed = failed + ExpectSource("nest-open.rxu", "<A><B><C>", "RXU002");
    failed = failed + ExpectSource("nest-mismatch.rxu", "<A><B></A>", "RXU001");
    failed = failed + ExpectSource("deep-empty.rxu", "<A><B>{}</B></A>", "RXU007");
    failed = failed + ExpectSource("nested-while.rxu", "<A><While/></A>", "RXU008");
    Return failed;
}

Public Function CheckDocuments() -> Int
Explain {
    Description: "Load, query, show, and unload independent RXU documents.";
    Input: None;
    Processing: "Use the Examples/UI documents and markup text. Loading stays separate from showing.";
    Output: "The number of failed document checks.";
} {
    Int failed = 0;
    UI app = UI();
    RxuDocument first = app.Load("Examples/UI/LiveDocument.rxu");
    RxuDocument second = app.LoadAsync("Examples/UI/SecondDocument.rxu");
    failed = failed + FailWhen(first.State != "Loaded" || second.State != "Loaded" || first.Id == second.Id, "document load");
    failed = failed + FailWhen(app.GetRoot(first.Id).Kind != "Window" || app.GetRoot(first.Id).Name != "Arm", "document root");
    first.Root.Name = "Changed";
    failed = failed + FailWhen(app.GetDocument(second.Id).Root.Name != "Other", "document isolation");
    failed = failed + FailWhen(first.ComponentCount() != 1 || second.ComponentCount() != 1 || first.ComponentName(0) != "Move" || second.ComponentName(0) != "Move", "document components");
    failed = failed + FailWhen(app.Documents.FindByName(first.Id, "Controls").Kind != "Panel", "find name");
    failed = failed + FailWhen(app.Documents.FindById(first.Id, "move").Name != "Move", "find id");
    failed = failed + FailWhen(app.Documents.FindByKind(first.Id, "Panel").Name != "Controls", "find kind");
    failed = failed + FailWhen(app.Documents.FindByPath(first.Id, "Window/Panel/Button").Name != "Move", "find path");
    failed = failed + FailWhen(first.Messages.Find("RXU016") < 0, "duplicate id");
    RxuInstance added = app.Documents.Attach(first.Id, app.GetRoot(first.Id).Id, "Label", "Extra");
    failed = failed + FailWhen(added.Name != "Extra" || app.Documents.FindByName(first.Id, "Extra").Id != added.Id, "attach");
    app.Documents.Detach(first.Id, added.Id);
    failed = failed + FailWhen(app.Documents.FindByName(first.Id, "Extra").Id != "", "detach");
    app.Show(first.Id);
    failed = failed + FailWhen(app.GetDocument(first.Id).State != "Shown", "show");
    app.Hide(first.Id);
    failed = failed + FailWhen(app.GetDocument(first.Id).State != "Hidden", "hide");
    app.Close(first.Id);
    failed = failed + FailWhen(app.GetDocument(first.Id).State != "Closed" || app.GetRoot(first.Id).Kind != "Window", "close");
    String firstId = first.Id + "";
    app.Unload(firstId);
    failed = failed + FailWhen(app.GetDocument(firstId).Id != "" || app.GetRoot(firstId).Id != "" || app.GetDocument(second.Id).Root.Name != "Other", "unload");
    RxuDocument created = app.CreateDocument("<Window Name=\"One\"/>");
    created.Root.Name = "Edited";
    RxuDocument again = app.ReloadAsync(created.Id);
    failed = failed + FailWhen(again.Id != created.Id || again.State != "Loaded" || again.Root.Name != "One", "reload");
    Var paths = List<String>();
    paths.Add("Examples/UI/Element.rxu");
    paths.Add("Examples/UI/Unicode.rxu");
    Int before = app.GetDocuments();
    Int addedCount = app.LoadMany(paths);
    failed = failed + FailWhen(addedCount != 2 || app.GetDocuments() != before + 2, "load many");
    RxuDocument missing = app.Load("Examples/UI/NoSuchDocument.rxu");
    failed = failed + FailWhen(missing.State != "Failed" || missing.Messages.Find("RXU017") < 0, "missing file");
    RxuDocument broken = app.Load("Examples/UI/Rejected/Mismatch.rxu");
    failed = failed + FailWhen(broken.State != "Failed" || broken.Messages.Find("RXU001") < 0 || broken.Root.Id != "", "failed parse");
    Return failed;
}

Public Function CheckProperties() -> Int
Explain {
    Description: "Check typed properties, precedence, inheritance, and batched updates.";
    Input: None;
    Processing: "Apply the Examples/UI property files and the direct precedence cases.";
    Output: "The number of failed property checks.";
} {
    Int failed = 0;
    UIElement button = UIElement();
    button.Kind = "Button";
    RxuNode properties = ReadExample("Examples/UI/Properties.rxu").FindChild("Button");
    failed = failed + FailWhen(button.SetAttributes(properties) != 0 || button.GetAttribute("Width") != "120" || button.GetAttribute("Opacity") != "0.8" || button.GetAttribute("Margin") != "4,8" || button.GetAttribute("Name") != "Save", "Examples/UI/Properties.rxu");
    UIElement panel = UIElement();
    panel.Kind = "Panel";
    RxuNode layout = ReadExample("Examples/UI/Layout.rxu").FindChild("Panel");
    failed = failed + FailWhen(panel.SetAttributes(layout) != 0 || panel.GetAttribute("Orientation") != "Vertical" || panel.GetAttribute("GridColumns") != "3" || panel.GetAttribute("Dock") != "Left" || panel.GetAttribute("ClipToBounds") != "true", "Examples/UI/Layout.rxu");
    UIElement face = UIElement();
    face.Kind = "Button";
    RxuNode appearance = ReadExample("Examples/UI/Appearance.rxu").FindChild("Button");
    failed = failed + FailWhen(face.SetAttributes(appearance) != 0 || face.GetAttribute("BorderColor") != "#112233" || face.GetAttribute("Duration") != "200ms" || face.GetAttribute("Shadow") != "None" || face.GetAttribute("FontWeight") != "Bold", "Examples/UI/Appearance.rxu");
    UIElement broken = UIElement();
    broken.Kind = "Button";
    RxuNode invalid = ReadExample("Examples/UI/InvalidProperties.rxu").FindChild("Button");
    failed = failed + FailWhen(broken.SetAttributes(invalid) != 4 || broken.GetAttribute("Width") != "Auto" || broken.Messages.Find("RXU018") < 0 || broken.Messages.Find("RXU019") < 0 || broken.Messages.Find("RXU020") < 0, "Examples/UI/InvalidProperties.rxu");
    failed = failed + FailWhen(button.AttributeType("Foreground") != "Color" || button.AttributeType("Width") != "Dimension", "property type");
    failed = failed + FailWhen(button.HasAttribute("Width") != True || button.HasAttribute("MaxWidth") != False, "local attribute");
    button.RemoveAttribute("Height");
    button.SetStyle("Height", "40");
    failed = failed + FailWhen(button.GetAttribute("Height") != "40", "style value");
    button.SetAttribute("Height", "80");
    failed = failed + FailWhen(button.GetAttribute("Height") != "80", "local wins");
    button.RemoveAttribute("Height");
    failed = failed + FailWhen(button.GetAttribute("Height") != "40" || button.HasAttribute("Height") != False, "remove local");
    button.SetAnimation("Height", "12");
    failed = failed + FailWhen(button.GetAttribute("Height") != "12", "animation wins");
    button.ResetAttribute("Height");
    failed = failed + FailWhen(button.GetAttribute("Height") != "Auto", "reset attribute");
    UIElement owner = UIElement();
    owner.Kind = "Control";
    owner.SetAttribute("Color", "#112233");
    UIElement child = UIElement();
    child.Kind = "Button";
    child.SetParent(owner);
    failed = failed + FailWhen(child.GetAttribute("Color") != "#112233", "inherit color");
    child.SetAttribute("Color", "#FFFFFF");
    owner.SetAttribute("Color", "#000000");
    failed = failed + FailWhen(child.GetAttribute("Color") != "#FFFFFF" || child.GetAttribute("Foreground") != "#FFFFFF", "local color alias");
    child.SetAnimation("Foreground", "#FF0000");
    failed = failed + FailWhen(child.GetAttribute("Color") != "#FF0000", "animation alias");
    failed = failed + FailWhen(button.SetAttribute("MinWidth", "20") != True || button.SetAttribute("MaxWidth", "10") != False, "min max");
    Int changes = button.ChangeCount;
    button.BeginUpdate();
    button.SetAttribute("Width", "10");
    button.SetAttribute("Height", "20");
    button.CancelUpdate();
    failed = failed + FailWhen(button.GetAttribute("Width") != "120" || button.ChangeCount != changes, "cancel update");
    button.BeginUpdate();
    button.BeginUpdate();
    button.SetAttribute("Width", "30");
    failed = failed + FailWhen(button.EndUpdate() != 0 || button.GetAttribute("Width") != "120", "nested update");
    failed = failed + FailWhen(button.EndUpdate() != 1 || button.GetAttribute("Width") != "30" || button.ChangeCount != changes + 1, "end update");
    failed = failed + FailWhen(button.LayoutInvalidated != True, "layout invalid");
    button.Refresh();
    failed = failed + FailWhen(button.Invalidated != False || button.LayoutInvalidated != False, "refresh");
    button.InvalidateLayout();
    failed = failed + FailWhen(button.Invalidated != True || button.LayoutInvalidated != True, "invalidate layout");
    failed = failed + FailWhen(button.AttributeCount() < 20 || button.AttributeName(0) != "Name", "catalog");
    Return failed;
}

Public Function CheckResources() -> Int
Explain {
    Description: "Check resource lookup, styles, themes, and templates.";
    Input: None;
    Processing: "Load the Examples/UI resource files and apply them to elements.";
    Output: "The number of failed resource checks.";
} {
    Int failed = 0;
    ResourceLibrary library = ResourceLibrary();
    RxuNode resources = ReadExample("Examples/UI/Resources.rxu").FindChild("Resources");
    failed = failed + FailWhen(library.Document.Load(resources) != 0 || library.Document.Get("Accent") != "#336699", "Examples/UI/Resources.rxu");
    RxuNode typed = ReadExample("Examples/UI/ResourceTypes.rxu").FindChild("Resources");
    ResourceTable types = ResourceTable();
    failed = failed + FailWhen(types.Load(typed) != 0 || types.Count() != 16 || types.TypeOfKey("Pad") != "Thickness", "Examples/UI/ResourceTypes.rxu");
    ResourceTable component = ResourceTable();
    ResourceTable ancestor = ResourceTable();
    component.Set("Color", "Accent", "#111111");
    ancestor.Set("Color", "Accent", "#333333");
    failed = failed + FailWhen(library.Resolve(component, ancestor, "Accent", "Black") != "#111111", "component resource");
    component.Remove("Accent");
    failed = failed + FailWhen(library.Resolve(component, ancestor, "Accent", "Black") != "#333333", "ancestor resource");
    ancestor.Remove("Accent");
    failed = failed + FailWhen(library.Resolve(component, ancestor, "Accent", "Black") != "#336699", "document resource");
    library.Document.Remove("Accent");
    failed = failed + FailWhen(library.Resolve(component, ancestor, "Accent", "Black") != "#336699", "builtin resource");
    failed = failed + FailWhen(component.Set("Color", "Accent", "#111111") != True || component.Set("Color", "Accent", "#222222") != False || component.Get("Accent") != "#111111" || component.Messages.Find("RXU023") < 0, "duplicate resource");
    failed = failed + FailWhen(library.Resolve(component, ancestor, "Missing", "Black") != "Black" || library.Messages.Find("RXU024") < 0, "missing resource");
    component.Set("Color", "Loop", "@Back");
    component.Set("Color", "Back", "@Loop");
    failed = failed + FailWhen(library.Resolve(component, ancestor, "Loop", "Black") != "Black" || library.Messages.Find("RXU022") < 0, "cyclic resource");
    failed = failed + FailWhen(component.Set("Color", "Bad", "nope") != False || component.Messages.Find("RXU021") < 0, "bad resource");
    UIElement button = UIElement();
    button.Kind = "Button";
    button.SetAttribute("Name", "Save");
    library.Document.Set("Color", "Accent", "#336699");
    failed = failed + FailWhen(library.Bind(button, "Background", "Accent", "#000000") != True || button.GetAttribute("Background") != "#336699", "resource binding");
    RxuNode theme = ReadExample("Examples/UI/Theme.rxu").FindChild("Theme");
    library.Document.Remove("Accent");
    failed = failed + FailWhen(library.AddTheme(theme) != 0 || library.SwitchTheme("Dark") != True || button.GetAttribute("Background") != "#112233" || button.GetAttribute("Name") != "Save", "Examples/UI/Theme.rxu");
    RxuNode style = ReadExample("Examples/UI/Styles.rxu").FindChild("Style");
    failed = failed + FailWhen(library.Styles.Load(style) != 1, "Examples/UI/Styles.rxu");
    UIElement styled = UIElement();
    styled.Kind = "Button";
    failed = failed + FailWhen(library.Styles.Apply(styled, "Primary", "") < 1 || styled.GetAttribute("Background") != "#336699", "base style");
    failed = failed + FailWhen(library.Styles.Apply(styled, "Primary", "Hover") < 1 || styled.GetAttribute("Background") != "#224466", "hover style");
    failed = failed + FailWhen(library.Styles.Apply(styled, "Primary", "Pressed") < 1 || styled.GetAttribute("Background") != "#112233", "pressed style");
    failed = failed + FailWhen(library.Styles.Apply(styled, "Primary", "Disabled") < 1 || styled.GetAttribute("Opacity") != "0.4", "disabled style");
    failed = failed + FailWhen(library.Styles.Apply(styled, "Primary", "Focused") < 1 || styled.GetAttribute("BorderColor") != "#FFFFFF", "focused style");
    styled.SetAttribute("Background", "#ABCDEF");
    library.Styles.Apply(styled, "Primary", "Hover");
    failed = failed + FailWhen(styled.GetAttribute("Background") != "#ABCDEF", "local beats style");
    RxuNode template = ReadExample("Examples/UI/Template.rxu").FindChild("Template");
    failed = failed + FailWhen(library.LoadTemplate(template) != True || library.ApplyTemplate(styled, "ArmButton") != True || styled.Kind != "Button" || styled.VisualKind != "Border" || styled.TemplateName != "ArmButton", "Examples/UI/Template.rxu");
    Return failed;
}

Public Function CheckBuild() -> Int
Explain {
    Description: "Check project loading, import resolution, and packaging failures.";
    Input: None;
    Processing: "Load the Examples/UI/Build projects and require each invalid project to fail packaging.";
    Output: "The number of failed build checks.";
} {
    Int failed = 0;
    RxuBuild ready = RxuBuild();
    failed = failed + FailWhen(ready.ReadProject("Examples/UI/Build/App.rxp") != 0 || ready.PackageReady() != True || ready.RuntimeCount() < 1, "Examples/UI/Build/App.rxp");
    RxuBuild typed = RxuBuild();
    Int span = typed.ReadProject("Examples/UI/Build/BadProperty.rxp");
    Int typedAt = typed.Messages.Find("RXU018");
    failed = failed + FailWhen(span == 0 || typedAt < 0 || typed.Messages.Find("RXU019") < 0 || typed.PackageReady() != False || typed.Messages.FormatAt(typedAt).Contains("length") != True, "Examples/UI/Build/BadProperty.rxp");
    RxuBuild nest = RxuBuild();
    failed = failed + FailWhen(nest.ReadProject("Examples/UI/Build/BadNest.rxp") == 0 || nest.Messages.Find("RXU029") < 0 || nest.PackageReady() != False, "Examples/UI/Build/BadNest.rxp");
    RxuBuild missing = RxuBuild();
    failed = failed + FailWhen(missing.ReadProject("Examples/UI/Build/MissingImport.rxp") == 0 || missing.Messages.Find("RXU027") < 0 || missing.PackageReady() != False, "Examples/UI/Build/MissingImport.rxp");
    RxuBuild cycle = RxuBuild();
    failed = failed + FailWhen(cycle.ReadProject("Examples/UI/Build/Cycle.rxp") == 0 || cycle.Messages.Find("RXU026") < 0 || cycle.PackageReady() != False, "Examples/UI/Build/Cycle.rxp");
    RxuBuild handler = RxuBuild();
    failed = failed + FailWhen(handler.ReadProject("Examples/UI/Build/MissingHandler.rxp") == 0 || handler.Messages.Find("RXU032") < 0 || handler.PackageReady() != False, "Examples/UI/Build/MissingHandler.rxp");
    RxuBuild asset = RxuBuild();
    failed = failed + FailWhen(asset.ReadProject("Examples/UI/Build/MissingAsset.rxp") == 0 || asset.Messages.Find("RXU033") < 0 || asset.PackageReady() != False, "Examples/UI/Build/MissingAsset.rxp");
    RxuBuild backend = RxuBuild();
    failed = failed + FailWhen(backend.ReadProject("Examples/UI/Build/Unsupported.rxp") == 0 || backend.Messages.Find("RXU034") < 0 || backend.PackageReady() != False, "Examples/UI/Build/Unsupported.rxp");
    RxuBuild reference = RxuBuild();
    failed = failed + FailWhen(reference.ReadProject("Examples/UI/Build/BadReference.rxp") == 0 || reference.Messages.Find("RXU028") < 0 || reference.PackageReady() != False, "Examples/UI/Build/BadReference.rxp");
    RxuBuild duplicate = RxuBuild();
    failed = failed + FailWhen(duplicate.ReadProject("Examples/UI/Build/DuplicateComponent.rxp") == 0 || duplicate.Messages.Find("RXU036") < 0 || duplicate.PackageReady() != False, "Examples/UI/Build/DuplicateComponent.rxp");
    RxuBuild resource = RxuBuild();
    failed = failed + FailWhen(resource.ReadProject("Examples/UI/Build/MissingResource.rxp") == 0 || resource.Messages.Find("RXU030") < 0 || resource.PackageReady() != False, "Examples/UI/Build/MissingResource.rxp");
    RxuBuild binding = RxuBuild();
    failed = failed + FailWhen(binding.ReadProject("Examples/UI/Build/BadBinding.rxp") == 0 || binding.Messages.Find("RXU031") < 0 || binding.PackageReady() != False, "Examples/UI/Build/BadBinding.rxp");
    RxuBuild identity = RxuBuild();
    failed = failed + FailWhen(identity.ReadProject("Examples/UI/Build/DuplicateId.rxp") == 0 || identity.Messages.Find("RXU016") < 0 || identity.PackageReady() != False, "Examples/UI/Build/DuplicateId.rxp");
    RxuBuild syntax = RxuBuild();
    failed = failed + FailWhen(syntax.ReadProject("Examples/UI/Build/BadSyntax.rxp") == 0 || syntax.Messages.Find("RXU008") < 0 || syntax.PackageReady() != False, "Examples/UI/Build/BadSyntax.rxp");
    RxuBuild outside = RxuBuild();
    failed = failed + FailWhen(outside.ReadProject("Examples/UI/Build/Unlisted.rxp") == 0 || outside.Messages.Find("RXU038") < 0 || outside.PackageReady() != False, "Examples/UI/Build/Unlisted.rxp");
    Return failed;
}

Public Function CheckBindings() -> Int
Explain {
    Description: "Check observables, expressions, binding modes, and secret values.";
    Input: None;
    Processing: "Load the binding examples and apply live values, collections, converters, and disposal.";
    Output: "The number of failed binding checks.";
} {
    Int failed = 0;
    RxuNode observed = ReadExample("Examples/UI/Observable.rxu");
    failed = failed + FailWhen(observed.Messages.Count() != 0 || observed.FindChild("Window").FindAttribute("DataContext").Text != "User" || observed.FindChild("Window").FindChild("Button").FindAttribute("ToolTip").Mode != "Binding" || observed.FindChild("Window").FindChild("Button").FindAttribute("ToolTip").Text != "Name", "Examples/UI/Observable.rxu");
    RxuNode modes = ReadExample("Examples/UI/BindingModes.rxu");
    failed = failed + FailWhen(modes.Messages.Count() != 0 || modes.FindChild("Button").FindAttribute("Mode").Text != "TwoWay", "Examples/UI/BindingModes.rxu");
    RxuNode converted = ReadExample("Examples/UI/BindingConvert.rxu");
    failed = failed + FailWhen(converted.Messages.Count() != 0 || converted.FindChild("Button").FindAttribute("Converter").Text != "Upper" || converted.FindChild("Button").FindAttribute("Fallback").Text != "Guest", "Examples/UI/BindingConvert.rxu");
    RxuNode secret = ReadExample("Examples/UI/PasswordBox.rxu");
    failed = failed + FailWhen(secret.Messages.Count() != 0 || secret.FindChild("PasswordBox").FindAttribute("Name").Mode != "Binding" || secret.FindChild("PasswordBox").FindAttribute("Name").Text != "Password", "Examples/UI/PasswordBox.rxu");
    UIElement scope = UIElement();
    scope.Kind = "Window";
    scope.SetDataContext("User");
    UIElement child = UIElement();
    child.Kind = "Button";
    child.SetParent(scope);
    UIElement nested = UIElement();
    nested.Kind = "Button";
    nested.SetParent(child);
    failed = failed + FailWhen(child.ContextKey() != "User" || nested.ContextKey() != "User", "data context");
    child.SetDataContext("Local");
    scope.SetDataContext("Account");
    failed = failed + FailWhen(child.ContextKey() != "Local" || nested.ContextKey() != "Local" || scope.ContextKey() != "Account", "local data context");
    child.ClearDataContext(scope.ContextKey());
    failed = failed + FailWhen(child.ContextKey() != "Account" || nested.ContextKey() != "Account", "cleared data context");
    RxuExpression math = RxuExpression();
    failed = failed + FailWhen(math.CheckExpression("1 + 2 * 3") != "Number" || math.EvaluateExpression("1 + 2 * 3", BindingEngine(), "") != "7", "arithmetic");
    failed = failed + FailWhen(math.CheckExpression("(1 + 2) * 3") != "Number" || math.EvaluateExpression("(1 + 2) * 3", BindingEngine(), "") != "9", "grouped arithmetic");
    failed = failed + FailWhen(math.CheckExpression("1 + 2 == 3") != "Boolean" || math.EvaluateExpression("1 + 2 == 3", BindingEngine(), "") != "true", "comparison");
    failed = failed + FailWhen(math.EvaluateExpression("!false && (false || true)", BindingEngine(), "") != "true", "logic");
    failed = failed + FailWhen(math.EvaluateExpression("1 > 2 ? \"no\" : \"yes\"", BindingEngine(), "") != "yes", "conditional");
    failed = failed + FailWhen(math.EvaluateExpression("Length(\"ab\")", BindingEngine(), "") != "2" || math.EvaluateExpression("Empty(\"\")", BindingEngine(), "") != "true" || math.EvaluateExpression("Lower(\"ADA\")", BindingEngine(), "") != "ada" || math.EvaluateExpression("Upper(\"ada\")", BindingEngine(), "") != "ADA" || math.EvaluateExpression("Not(true)", BindingEngine(), "") != "false", "approved functions");
    failed = failed + FailWhen(math.CheckExpression("Unknown(1)") != "Error" || math.Messages.Find("RXU039") < 0, "unknown function");
    failed = failed + FailWhen(math.CheckExpression("1 + true") != "Error" || math.Messages.Find("RXU044") < 0, "bad arithmetic");
    failed = failed + FailWhen(math.EvaluateExpression("null == null", BindingEngine(), "") != "true", "null check");
    BindingEngine engine = BindingEngine();
    engine.DefineValue("User.Name", "Ada", False);
    engine.DefineValue("Flag", "true", False);
    engine.DefineList("Joints");
    engine.AddItem("Joints", "A");
    engine.AddItem("Joints", "B");
    UIElement title = UIElement();
    title.Kind = "Window";
    title.SetDataContext("User");
    Int live = engine.BindTo(title, "Title", "Name", "OneWay", "", False, "Guest", "Change", title.ContextKey());
    failed = failed + FailWhen(title.GetAttribute("Title") != "Ada" || math.DependencyCount() < 0 || engine.ReadValue("User.Name") != "Ada", "nested binding");
    engine.ChangeValue("User.Name", "Bea");
    failed = failed + FailWhen(title.GetAttribute("Title") != "Bea", "live binding");
    UIElement once = UIElement();
    once.Kind = "Window";
    Int onceIndex = engine.BindTo(once, "Title", "User.Name", "OneTime", "", False, "", "Change", "");
    engine.ChangeValue("User.Name", "Cara");
    failed = failed + FailWhen(once.GetAttribute("Title") != "Bea" || title.GetAttribute("Title") != "Cara", "one time binding");
    UIElement manual = UIElement();
    manual.Kind = "Window";
    Int manualIndex = engine.BindTo(manual, "Title", "User.Name", "Manual", "", False, "", "Explicit", "");
    failed = failed + FailWhen(manual.GetAttribute("Title") != "", "manual binding");
    engine.RefreshBound(manualIndex);
    failed = failed + FailWhen(manual.GetAttribute("Title") != "Cara", "explicit refresh");
    UIElement source = UIElement();
    source.Kind = "Window";
    source.SetAttribute("Title", "Kept");
    Int sourceIndex = engine.BindTo(source, "Title", "User.Name", "OneWayToSource", "", False, "", "Input", "");
    engine.ChangeValue("User.Name", "Dora");
    failed = failed + FailWhen(source.GetAttribute("Title") != "Kept" || engine.PushInput(sourceIndex, "Edit") != True || engine.ReadValue("User.Name") != "Edit", "source binding");
    UIElement both = UIElement();
    both.Kind = "Window";
    Int bothIndex = engine.BindTo(both, "Title", "User.Name", "TwoWay", "", False, "", "Change", "");
    failed = failed + FailWhen(engine.PushInput(bothIndex, "Faye") != True || engine.ReadValue("User.Name") != "Faye" || both.GetAttribute("Title") != "Faye", "two way binding");
    UIElement upper = UIElement();
    upper.Kind = "Window";
    engine.DefineValue("Label", "ada", False);
    engine.BindTo(upper, "Title", "Label", "OneWay", "Upper", False, "", "Change", "");
    failed = failed + FailWhen(upper.GetAttribute("Title") != "ADA", "converter");
    UIElement missing = UIElement();
    missing.Kind = "Window";
    engine.BindTo(missing, "Title", "Missing", "OneWay", "", False, "Guest", "Change", "");
    failed = failed + FailWhen(missing.GetAttribute("Title") != "Guest", "fallback");
    UIElement blank = UIElement();
    blank.Kind = "Window";
    engine.BindTo(blank, "Title", "null", "OneWay", "", False, "Guest", "Change", "");
    failed = failed + FailWhen(blank.GetAttribute("Title") != "Guest", "null fallback");
    UIElement width = UIElement();
    width.Kind = "Window";
    engine.BindTo(width, "Width", "\"wide\"", "OneWay", "", False, "", "Change", "");
    failed = failed + FailWhen(width.GetAttribute("Width") != "Auto" || engine.Messages.Find("RXU041") < 0, "rejected binding");
    UIElement styled = UIElement();
    styled.Kind = "Window";
    engine.DefineValue("Heading", "Ada", False);
    engine.BindTo(styled, "Title", "Heading", "OneWay", "", False, "", "Change", "");
    styled.SetStyle("Title", "Styled");
    failed = failed + FailWhen(styled.GetAttribute("Title") != "Ada", "binding beats style");
    styled.SetAnimation("Title", "Anim");
    Int styledIndex = engine.BindTo(styled, "Title", "Heading", "Reactive", "", False, "", "Change", "");
    engine.RefreshBound(styledIndex);
    failed = failed + FailWhen(styled.GetAttribute("Title") != "Anim", "animation beats binding");
    UIElement listTitle = UIElement();
    listTitle.Kind = "Window";
    Int listIndex = engine.BindTo(listTitle, "ToolTip", "Joints.0", "Reactive", "", False, "", "Change", "");
    failed = failed + FailWhen(listTitle.GetAttribute("ToolTip") != "A" || engine.ItemCount("Joints") != 2, "collection binding");
    engine.MoveItem("Joints", 0, 1);
    failed = failed + FailWhen(engine.ItemAt("Joints", 0) != "B" || listTitle.GetAttribute("ToolTip") != "B", "collection reorder");
    engine.RemoveItem("Joints", 0);
    failed = failed + FailWhen(listTitle.GetAttribute("ToolTip") != "A", "collection remove");
    engine.AddItem("Joints", "C");
    failed = failed + FailWhen(engine.ItemCount("Joints") != 2 || math.EvaluateExpression("Count(Joints)", engine, "") != "2", "collection add");
    UIElement stale = UIElement();
    stale.Kind = "Window";
    Int staleIndex = engine.BindTo(stale, "Title", "Heading", "OneWay", "", False, "", "Change", "");
    engine.DisposeBound(staleIndex);
    engine.ChangeValue("Heading", "Bea");
    failed = failed + FailWhen(stale.GetAttribute("Title") != "Ada" || styled.GetAttribute("Title") != "Anim", "stale subscription");
    Int before = engine.ActiveCount();
    engine.DisposeAll();
    engine.ChangeValue("Heading", "Cara");
    failed = failed + FailWhen(before < 1 || engine.ActiveCount() != 0 || stale.GetAttribute("Title") != "Ada", "disposed bindings");
    BindingEngine cycle = BindingEngine();
    cycle.DefineValue("Flag", "true", False);
    UIElement flag = UIElement();
    flag.Kind = "Button";
    cycle.BindTo(flag, "Enabled", "Flag", "TwoWay", "", True, "", "Change", "");
    failed = failed + FailWhen(cycle.Messages.Find("RXU040") < 0, "binding cycle");
    BindingEngine vault = BindingEngine();
    vault.DefineValue("Password", "s3cret", True);
    UIElement box = UIElement();
    box.Kind = "PasswordBox";
    Int boxIndex = vault.BindTo(box, "ToolTip", "Password", "OneWay", "", False, "", "Change", "");
    Int diagnostic = 0;
    Bool leaked = False;
    While (diagnostic < vault.Messages.Count()) {
        If (vault.Messages.FormatAt(diagnostic).Contains("s3cret")) {
            leaked = True;
        }
        diagnostic = diagnostic + 1;
    }
    failed = failed + FailWhen(vault.TraceValue(boxIndex) != "••••" || vault.Messages.Find("RXU041") < 0 || leaked || box.GetAttribute("ToolTip") != "", "password binding");
    Int ignored = live + onceIndex + listIndex;
    If (ignored < 0) {
        failed = failed + 1;
    }
    Return failed;
}

Public Function CheckBackend() -> Int
Explain {
    Description: "Check backend selection, capabilities, fallbacks, and universal projects.";
    Input: None;
    Processing: "Drive the headless backend and read the universal sample project.";
    Output: "The number of failed backend checks.";
} {
    Int failed = 0;
    UIBackend backend = UIBackend();
    failed = failed + FailWhen(backend.UseHost("") != "Headless" || backend.Supports("Graphics") || !backend.Supports("Window") || !backend.Supports("Clipboard") || !backend.Supports("Accessibility") || backend.ReadScreens() != 1 || backend.ReadScale() != "1" || backend.Messages.Find("RXU045") < 0, "headless backend");
    failed = failed + FailWhen(backend.UseHost("linux") != "Linux" || !backend.Supports("HiDPI") || !backend.Supports("Touch") || !backend.Supports("Graphics") || !backend.Supports("Dialog") || !backend.Supports("FileDialog") || !backend.Supports("Notification") || !backend.Supports("Menu") || backend.ReadScreens() != 2 || backend.ReadScale() != "2", "linux backend");
    failed = failed + FailWhen(backend.UseHost("windows") != "Windows" || backend.Supports("Touch") || !backend.Supports("Graphics"), "windows backend");
    failed = failed + FailWhen(backend.UseHost("macos") != "Mac" || !backend.Supports("Touch"), "mac backend");
    backend.UseHost("");
    failed = failed + FailWhen(backend.OpenWindow("main", "Arm") != True || backend.OpenComponent("main", "save", "Button") != True || backend.SyncProperty("save", "Name", "Save") != True || backend.MeasureNode("save") != "120,32", "backend lifetime");
    failed = failed + FailWhen(backend.OpenComponent("main", "bad", "GtkButton") != False || backend.Messages.Find("RXU046") < 0, "platform widget");
    failed = failed + FailWhen(backend.OfferInput("Pointer", "1,2") != True || backend.OfferInput("Key", "S") != True || backend.OfferInput("Scroll", "1") != True || backend.OfferInput("Touch", "1") != False || backend.MarkDirty("save") != True, "semantic input");
    failed = failed + FailWhen(backend.CopyClipboard("arm") != True || backend.PasteClipboard() != "arm", "clipboard");
    failed = failed + FailWhen(backend.SaveState() != "main" || backend.CloseWindow("main") != True || backend.OpenComponent("main", "save", "Button") != False || backend.RestoreState("main") != True || backend.OpenComponent("main", "save", "Button") != True, "state restore");
    failed = failed + FailWhen(backend.Draw("Fill", "#336699") != True || backend.Draw("GtkBox", "") != False, "drawing");
    failed = failed + FailWhen(backend.OpenDialog("Confirm", "Save") != True || backend.OpenFile("Open") != "" || backend.Notify("Done") != True || backend.OpenMenu("File") != True, "backend fallback");
    backend.ShutDown();
    failed = failed + FailWhen(backend.OpenWindow("main", "Arm") != False, "backend shutdown");
    Bool sawSoftware = False;
    Bool sawDialog = False;
    Bool sawStop = False;
    Int index = 0;
    While (index < backend.LogCount()) {
        String entry = backend.LogAt(index);
        If (entry == "Software Fill #336699") { sawSoftware = True; }
        If (entry == "Fallback Dialog Confirm") { sawDialog = True; }
        If (entry == "ShutDown") { sawStop = True; }
        index = index + 1;
    }
    failed = failed + FailWhen(!sawSoftware || !sawDialog || !sawStop || backend.LogAt(0) != "OpenWindow main Arm", "backend log");
    RxuNode markup = ReadExample("Examples/UI/Backend.rxu");
    failed = failed + FailWhen(markup.Messages.Count() != 0 || markup.FindChild("Window").FindAttribute("Title").Text != "Arm", "Examples/UI/Backend.rxu");
    UIBackend project = UIBackend();
    failed = failed + FailWhen(project.ProjectClean("Examples/UI/Backend/App.rxp") != True || project.ProjectClean("Examples/UI/Backend/App.rx") != True || project.ProjectClean("Examples/UI/Backend/App.rxu") != True || project.ProjectClean("Examples/UI/Backend/Rejected.rx") != False || project.Messages.Find("RXU046") < 0, "universal project");
    Return failed;
}

Public Function CheckLinux() -> Int
Explain {
    Description: "Check the Linux application loop, window calls, and UI thread queue.";
    Input: None;
    Processing: "Start, resize, close, reopen, dispose, and post background work.";
    Output: "The number of failed Linux checks.";
} {
    Int failed = 0;
    RxuNode markup = ReadExample("Examples/UI/LinuxApp.rxu");
    failed = failed + FailWhen(markup.Messages.Count() != 0 || markup.FindChild("Window").FindAttribute("Title").Text != "Arm" || markup.FindChild("Window").FindAttribute("Width").Text != "320", "Examples/UI/LinuxApp.rxu");
    LinuxApp app = LinuxApp();
    failed = failed + FailWhen(app.CreateApp() != True || app.OpenAppWindow("main", "Arm", "320", "240") != True || app.ReadWindowState("main") != "Hidden" || app.ReadMain() != "main", "linux create");
    app.PostWork("Size|main|500|250");
    failed = failed + FailWhen(app.RunApp() != 1 || app.ReadPhase() != "Running" || app.ReadWindowState("main") != "Normal" || app.ReadWindowSize("main") != "500,250" || app.ReadScale() != "2", "linux startup");
    failed = failed + FailWhen(app.ResizeWindow("main", "400", "300") != True || app.ReadWindowSize("main") != "400,300" || app.MoveWindow("main", "10", "20") != True || app.ReadWindowPosition("main") != "10,20", "linux resize");
    failed = failed + FailWhen(app.MinimizeWindow("main") != True || app.ReadWindowState("main") != "Minimized" || app.MaximizeWindow("main") != True || app.ReadWindowState("main") != "Maximized" || app.RestoreWindow("main") != True || app.ReadWindowState("main") != "Normal", "linux window state");
    failed = failed + FailWhen(app.HideWindow("main") != True || app.ReadWindowState("main") != "Hidden" || app.ActivateWindow("main") != True || app.ReadWindowState("main") != "Normal", "linux activate");
    failed = failed + FailWhen(app.RetitleWindow("main", "Bea") != True || app.ReadWindowTitle("main") != "Bea" || app.CloseAppWindow("main") != True || app.ReadWindowState("main") != "Closed" || app.ShowWindow("main") != True || app.ReadWindowState("main") != "Normal", "linux reopen");
    failed = failed + FailWhen(app.CopyText("arm") != True || app.PasteText() != "arm" || app.ChooseFile("Open") != "arm.rxu" || app.AskDialog("Confirm", "Save") != True, "linux bridges");
    app.EnterBackground();
    failed = failed + FailWhen(app.IsUIThread() != False || app.CheckAccess() != False || app.RetitleWindow("main", "Cara") != False || app.ReadWindowTitle("main") != "Bea" || app.Messages.Find("RXU047") < 0, "wrong thread");
    app.PostWork("Title|main|Queued");
    failed = failed + FailWhen(app.ReadWindowTitle("main") != "Bea" || app.PumpApp() != 1 || app.ReadWindowTitle("main") != "Queued", "background post");
    failed = failed + FailWhen(app.DispatchWork("Title|main|Sent") != True || app.ReadWindowTitle("main") != "Queued" || app.PumpApp() != 1 || app.ReadWindowTitle("main") != "Sent", "dispatch async");
    failed = failed + FailWhen(app.InvokeWork("Title|main|Now") != False || app.ReadWindowTitle("main") != "Sent", "invoke rejected");
    app.LeaveBackground();
    failed = failed + FailWhen(app.IsUIThread() != True || app.CheckAccess() != True || app.InvokeWork("Title|main|Now") != True || app.ReadWindowTitle("main") != "Now", "invoke ui");
    failed = failed + FailWhen(app.DispatchLater("Title|main|Later") != True || app.ReadWindowTitle("main") != "Now" || app.ScheduleWork("Show|main") != True || app.PumpApp() != 2 || app.ReadWindowTitle("main") != "Later", "scheduled work");
    failed = failed + FailWhen(app.DisposeWindow("main") != True || app.ShowWindow("main") != False || app.Messages.Find("RXU048") < 0, "linux dispose");
    app.ExitApp(0);
    Bool sawNew = False;
    Bool sawShow = False;
    Bool sawSize = False;
    Bool sawDestroy = False;
    Int index = 0;
    While (index < app.TraceCount()) {
        String call = app.TraceAt(index);
        If (call == "gtk_window_new main") { sawNew = True; }
        If (call == "gtk_widget_show main") { sawShow = True; }
        If (call == "gtk_window_set_default_size main") { sawSize = True; }
        If (call == "gtk_window_destroy main") { sawDestroy = True; }
        index = index + 1;
    }
    failed = failed + FailWhen(!sawNew || !sawShow || !sawSize || !sawDestroy || app.ReadPhase() != "Exited" || app.ReadExit() != 0, "gtk trace");
    Return failed;
}

Private Function LayoutOpen(String path, String id, Int w, Int h) -> LayoutEngine {
    LayoutEngine engine = LayoutEngine();
    engine.ImportLayout(ReadExample(path), "");
    engine.Relayout(id, w, h);
    Return engine;
}

Public Function CheckLayout() -> Int
Explain {
    Description: "Check measure, arrange, render, and the shared layout geometry.";
    Input: None;
    Processing: "Load the layout examples and compare frames, clips, scale, direction, and cached measures.";
    Output: "The number of failed layout checks.";
} {
    Int failed = 0;
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutStack.rxu").Messages.Count() != 0, "stack parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutGrid.rxu").Messages.Count() != 0, "grid parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutCanvas.rxu").Messages.Count() != 0, "canvas parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutScroll.rxu").Messages.Count() != 0, "scroll parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutDock.rxu").Messages.Count() != 0, "dock parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutWrap.rxu").Messages.Count() != 0, "wrap parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutFlex.rxu").Messages.Count() != 0, "flex parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutUniform.rxu").Messages.Count() != 0, "uniform parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutSplit.rxu").Messages.Count() != 0, "split parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutConstraint.rxu").Messages.Count() != 0, "constraint parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutTab.rxu").Messages.Count() != 0, "tab parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutView.rxu").Messages.Count() != 0, "view parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutPrimitives.rxu").Messages.Count() != 0, "primitives parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutPanel.rxu").Messages.Count() != 0, "panel parse");
    failed = failed + FailWhen(ReadExample("Examples/UI/LayoutRow.rxu").Messages.Count() != 0, "row parse");
    LayoutEngine stack = LayoutOpen("Examples/UI/LayoutStack.rxu", "root", 200, 100);
    failed = failed + FailWhen(stack.FrameOf("Title") != "4,4,50,20" || stack.FrameOf("Body") != "4,32,50,20", "stack " + stack.FrameOf("Title") + " " + stack.FrameOf("Body"));
    failed = failed + FailWhen(!stack.HasCommand("Text Title 4 4 50 20 Arm") || stack.MeasureSlot("Title", 80, 40) != "50,20" || stack.SetText("Title", "Nope", "x") != False, "stack text");
    LayoutEngine grid = LayoutOpen("Examples/UI/LayoutGrid.rxu", "grid", 100, 100);
    failed = failed + FailWhen(grid.FrameOf("A") != "0,0,50,50" || grid.FrameOf("B") != "50,0,50,50" || grid.FrameOf("C") != "0,50,100,50", "grid " + grid.FrameOf("A") + " " + grid.FrameOf("B") + " " + grid.FrameOf("C"));
    failed = failed + FailWhen(!grid.HasCommand("Fill A 0 0 50 50 #336699") || !grid.HasCommand("Fill C 0 50 100 50 #336699"), "grid fill");
    LayoutEngine canvas = LayoutOpen("Examples/UI/LayoutCanvas.rxu", "canvas", 200, 100);
    failed = failed + FailWhen(canvas.FrameOf("mark") != "30,12,10,10", "canvas " + canvas.FrameOf("mark"));
    LayoutEngine scroll = LayoutOpen("Examples/UI/LayoutScroll.rxu", "scroll", 100, 80);
    scroll.SetOffset("scroll", 0, 40);
    scroll.Relayout("scroll", 100, 80);
    failed = failed + FailWhen(scroll.FrameOf("long") != "0,-40,100,200" || !scroll.HasCommand("Fill long 0 0 100 80 #336699") || !scroll.HasCommand("Clip 0 0 100 80"), "scroll " + scroll.FrameOf("long"));
    LayoutEngine dock = LayoutOpen("Examples/UI/LayoutDock.rxu", "dock", 200, 100);
    failed = failed + FailWhen(dock.FrameOf("side") != "0,0,40,100" || dock.FrameOf("rest") != "40,0,160,100", "dock " + dock.FrameOf("side") + " " + dock.FrameOf("rest"));
    LayoutEngine wrap = LayoutOpen("Examples/UI/LayoutWrap.rxu", "wrap", 100, 80);
    failed = failed + FailWhen(wrap.FrameOf("a") != "0,0,40,20" || wrap.FrameOf("b") != "40,0,40,20" || wrap.FrameOf("c") != "0,20,40,20", "wrap " + wrap.FrameOf("c"));
    LayoutEngine flex = LayoutOpen("Examples/UI/LayoutFlex.rxu", "flex", 100, 20);
    failed = failed + FailWhen(flex.FrameOf("a") != "0,0,50,20" || flex.FrameOf("b") != "50,0,50,20", "flex " + flex.FrameOf("a") + " " + flex.FrameOf("b"));
    LayoutEngine uniform = LayoutOpen("Examples/UI/LayoutUniform.rxu", "uniform", 100, 100);
    failed = failed + FailWhen(uniform.FrameOf("a") != "0,0,50,50" || uniform.FrameOf("b") != "50,0,50,50" || uniform.FrameOf("c") != "0,50,50,50", "uniform " + uniform.FrameOf("c"));
    LayoutEngine split = LayoutOpen("Examples/UI/LayoutSplit.rxu", "split", 200, 40);
    failed = failed + FailWhen(split.FrameOf("pane") != "0,0,80,40" || split.FrameOf("rest") != "80,0,120,40", "split " + split.FrameOf("pane") + " " + split.FrameOf("rest"));
    LayoutEngine limit = LayoutOpen("Examples/UI/LayoutConstraint.rxu", "limit", 200, 40);
    failed = failed + FailWhen(limit.FrameOf("item") != "75,10,50,20", "constraint " + limit.FrameOf("item"));
    LayoutEngine tabs = LayoutOpen("Examples/UI/LayoutTab.rxu", "tabs", 100, 30);
    failed = failed + FailWhen(tabs.FrameOf("first") != "0,0,100,30" || tabs.FrameOf("second") != "0,0,0,0", "tab " + tabs.FrameOf("second"));
    LayoutEngine view = LayoutOpen("Examples/UI/LayoutView.rxu", "view", 100, 40);
    failed = failed + FailWhen(view.FrameOf("body") != "0,0,100,40" || !view.HasCommand("Clip 0 0 100 40") || !view.HasCommand("Fill body 0 0 100 40 #336699"), "view");
    LayoutEngine art = LayoutOpen("Examples/UI/LayoutPrimitives.rxu", "art", 80, 80);
    failed = failed + FailWhen(art.FrameOf("box") != "0,0,80,80" || art.FrameOf("photo") != "0,0,32,32" || art.FrameOf("label") != "0,0,24,16", "primitives " + art.FrameOf("photo") + " " + art.FrameOf("label"));
    failed = failed + FailWhen(!art.HasCommand("Fill box 0 0 80 80 #336699") || !art.HasCommand("Border edge 0 0 80 80") || !art.HasCommand("Image photo 0 0 32 32") || !art.HasCommand("Text label 0 0 24 16 Arm") || !art.HasCommand("Path curve 0 0 80 80") || !art.HasCommand("Shadow shade 0 0 80 80"), "primitive commands");
    LayoutEngine panel = LayoutOpen("Examples/UI/LayoutPanel.rxu", "panel", 100, 80);
    failed = failed + FailWhen(panel.FrameOf("a") != "0,0,40,20" || panel.FrameOf("b") != "0,20,40,20", "panel " + panel.FrameOf("b"));
    LayoutEngine row = LayoutOpen("Examples/UI/LayoutRow.rxu", "row", 200, 40);
    failed = failed + FailWhen(row.FrameOf("a") != "0,0,40,20" || row.FrameOf("b") != "40,0,40,20", "row " + row.FrameOf("b"));
    LayoutEngine once = LayoutEngine();
    once.AddSlot("n", "", "Rect");
    once.SetText("n", "Width", "10");
    once.SetText("n", "Height", "10");
    failed = failed + FailWhen(once.MeasureSlot("n", 10, 10) != "10,10" || once.ArrangeSlot("n", 1, 2, 10, 10) != True || once.DrawSlots("n") != 1 || once.FrameOf("n") != "1,2,10,10" || once.CommandAt(0) != "Fill n 1 2 10 10 #000000", "lifecycle " + once.FrameOf("n") + " " + once.CommandAt(0));
    LayoutEngine sizes = LayoutEngine();
    sizes.AddSlot("root", "", "Stack");
    sizes.SetText("root", "Height", "100");
    sizes.AddSlot("pct", "root", "Rect");
    sizes.SetText("pct", "Width", "50%");
    sizes.SetText("pct", "Height", "20");
    sizes.SetText("pct", "Horizontal", "Start");
    sizes.AddSlot("fix", "root", "Rect");
    sizes.SetText("fix", "Width", "40");
    sizes.SetText("fix", "Height", "20");
    sizes.SetText("fix", "Horizontal", "Start");
    sizes.Relayout("root", 200, 100);
    failed = failed + FailWhen(sizes.FrameOf("pct") != "0,0,100,20" || sizes.FrameOf("fix") != "0,20,40,20", "percent small " + sizes.FrameOf("pct") + " " + sizes.FrameOf("fix"));
    sizes.Relayout("root", 800, 100);
    failed = failed + FailWhen(sizes.FrameOf("pct") != "0,0,400,20" || sizes.FrameOf("fix") != "0,20,40,20", "percent large " + sizes.FrameOf("pct"));
    LayoutEngine rules = LayoutEngine();
    rules.AddSlot("root", "", "Stack");
    rules.SetText("root", "Width", "200");
    rules.SetText("root", "Height", "120");
    rules.AddSlot("label", "root", "Text");
    rules.SetText("label", "Content", "Hi");
    rules.SetText("label", "MinWidth", "40");
    rules.SetText("label", "Horizontal", "Start");
    rules.AddSlot("wide", "root", "Rect");
    rules.SetText("wide", "Width", "100");
    rules.SetText("wide", "MaxWidth", "30");
    rules.SetText("wide", "Height", "20");
    rules.SetText("wide", "Horizontal", "Start");
    rules.AddSlot("end", "root", "Rect");
    rules.SetText("end", "Width", "50");
    rules.SetText("end", "Height", "20");
    rules.SetText("end", "Horizontal", "End");
    rules.AddSlot("pad", "root", "Rect");
    rules.SetText("pad", "Width", "50");
    rules.SetText("pad", "Height", "20");
    rules.SetText("pad", "Margin", "1,2,3,4");
    rules.SetText("pad", "Horizontal", "Start");
    rules.Relayout("root", 200, 120);
    failed = failed + FailWhen(rules.FrameOf("label") != "0,0,40,16" || rules.FrameOf("wide") != "0,16,30,20" || rules.FrameOf("end") != "150,36,50,20" || rules.FrameOf("pad") != "1,58,50,20", "rules " + rules.FrameOf("label") + " " + rules.FrameOf("wide") + " " + rules.FrameOf("end") + " " + rules.FrameOf("pad"));
    LayoutEngine flow = LayoutEngine();
    flow.AddSlot("box", "", "Stack");
    flow.SetText("box", "Width", "100");
    flow.SetText("box", "Height", "40");
    flow.AddSlot("big", "box", "Rect");
    flow.SetText("big", "Width", "300");
    flow.SetText("big", "Height", "20");
    flow.SetText("big", "Horizontal", "Start");
    flow.Relayout("box", 100, 40);
    failed = failed + FailWhen(flow.FrameOf("big") != "0,0,300,20" || !flow.HasCommand("Fill big 0 0 300 20 #000000"), "overflow " + flow.FrameOf("big"));
    flow.SetText("box", "Clip", "true");
    flow.Relayout("box", 100, 40);
    failed = failed + FailWhen(flow.FrameOf("big") != "0,0,300,20" || !flow.HasCommand("Fill big 0 0 100 20 #000000") || !flow.HasCommand("Clip 0 0 100 40"), "clip");
    LayoutEngine nest = LayoutEngine();
    nest.AddSlot("outer", "", "Scroll");
    nest.SetText("outer", "Width", "100");
    nest.SetText("outer", "Height", "100");
    nest.SetText("outer", "Clip", "true");
    nest.AddSlot("inner", "outer", "Scroll");
    nest.SetText("inner", "Width", "100");
    nest.SetText("inner", "Height", "80");
    nest.AddSlot("item", "inner", "Rect");
    nest.SetText("item", "Width", "100");
    nest.SetText("item", "Height", "40");
    nest.SetOffset("outer", 0, 10);
    nest.SetOffset("inner", 0, 5);
    nest.Relayout("outer", 100, 100);
    failed = failed + FailWhen(nest.FrameOf("item") != "0,-15,100,40" || !nest.HasCommand("Fill item 0 0 100 25 #000000"), "nested " + nest.FrameOf("item"));
    LayoutEngine dpi = LayoutEngine();
    dpi.AddSlot("root", "", "Stack");
    dpi.SetText("root", "Width", "200");
    dpi.SetText("root", "Height", "40");
    dpi.AddSlot("box", "root", "Rect");
    dpi.SetText("box", "Width", "50");
    dpi.SetText("box", "Height", "20");
    dpi.SetText("box", "Horizontal", "Start");
    dpi.Relayout("root", 200, 40);
    Int measured = dpi.MeasureCount("box");
    dpi.SetScale(2);
    dpi.Relayout("root", 200, 40);
    failed = failed + FailWhen(dpi.FrameOf("box") != "0,0,100,40" || dpi.MeasureCount("box") != measured, "dpi " + dpi.FrameOf("box") + " " + dpi.MeasureCount("box").ToString());
    LayoutEngine rtl = LayoutEngine();
    rtl.AddSlot("root", "", "Stack");
    rtl.SetText("root", "Width", "200");
    rtl.SetText("root", "Height", "40");
    rtl.AddSlot("item", "root", "Rect");
    rtl.SetText("item", "Width", "50");
    rtl.SetText("item", "Height", "20");
    rtl.SetText("item", "Horizontal", "Start");
    rtl.SetFlow("RTL");
    rtl.Relayout("root", 200, 40);
    failed = failed + FailWhen(rtl.FrameOf("item") != "150,0,50,20" || rtl.DecorationNote() != "Window decorations and fonts follow the host. Layout geometry stays shared.", "rtl " + rtl.FrameOf("item"));
    LayoutEngine cache = LayoutEngine();
    cache.AddSlot("root", "", "Stack");
    cache.SetText("root", "Width", "200");
    cache.SetText("root", "Height", "80");
    cache.AddSlot("A", "root", "Rect");
    cache.SetText("A", "Width", "50");
    cache.SetText("A", "Height", "20");
    cache.SetText("A", "Horizontal", "Start");
    cache.AddSlot("B", "root", "Rect");
    cache.SetText("B", "Width", "50");
    cache.SetText("B", "Height", "20");
    cache.SetText("B", "Horizontal", "Start");
    cache.Relayout("root", 200, 80);
    Int firstA = cache.MeasureCount("A");
    Int firstB = cache.MeasureCount("B");
    Int revision = cache.RevisionOf();
    cache.Relayout("root", 200, 80);
    failed = failed + FailWhen(firstA != 1 || cache.MeasureCount("A") != firstA || cache.MeasureCount("B") != firstB || cache.RevisionOf() != revision, "cache hold " + firstA.ToString());
    cache.SetText("B", "Height", "30");
    cache.InvalidateSlot("B");
    cache.Relayout("root", 200, 80);
    failed = failed + FailWhen(cache.MeasureCount("A") != firstA || cache.MeasureCount("B") != firstB + 1 || cache.RevisionOf() != revision + 1 || cache.FrameOf("A") != "0,0,50,20" || cache.FrameOf("B") != "0,20,50,30", "cache dirty " + cache.FrameOf("B") + " " + cache.MeasureCount("B").ToString());
    Return failed;
}

Public Function CheckFrame() -> Int
Explain {
    Description: "Check damage, hit testing, and headless present for the Arm console.";
    Input: None;
    Processing: "Adopt the layout display list. A clean frame rasters nothing. A text edit damages one slot. A missing display stays headless.";
    Output: "The number of failed checks.";
} {
    Int failed = 0;
    Directory.Create("Build/rxu");
    LayoutEngine layout = LayoutOpen("Examples/UI/ArmConsole.rxu", "shell", 640, 480);
    FrameHost host = FrameHost();
    Int commands = host.FrameAdopt(layout, "shell");
    String mark = layout.FrameOf("mark");
    String rows = layout.FrameOf("rows");
    String bar = layout.FrameOf("bar");
    String sideTitle = layout.FrameOf("sideTitle");
    failed = failed + FailWhen(commands < 1 || !host.FrameWrite("Build/rxu/arm-s1.list") || host.FramePump() != 1 || host.FramePump() != 0 || host.FrameHitSlot("heading") != "heading", "frame adopt " + commands.ToString() + " " + host.FrameHitSlot("heading"));
    String heading = layout.FrameOf("heading");
    Int hx = heading.IndexOf(",");
    Int hy = heading.IndexOf(",", hx + 1);
    Int left = heading.Substring(0, hx).ToInt();
    Int top = heading.Substring(hx + 1, hy - hx - 1).ToInt();
    failed = failed + FailWhen(host.FramePointer(left + 2, top + 2) != "heading" || host.FramePressed() != "Pressed" || host.FrameKey("A") != "A" || host.FrameTarget() != "heading", "frame input");
    failed = failed + FailWhen(!layout.SetText("heading", "Content", "Wrist"), "frame text");
    layout.Relayout("shell", 640, 480);
    Int band = host.FrameDamage(layout, "heading");
    failed = failed + FailWhen(band < 1 || band >= host.FrameWindow() || host.FramePump() != 1 || host.FramePump() != 0, "frame damage " + band.ToString());
    layout.SetOffset("list", 0, 40);
    layout.Relayout("shell", 640, 480);
    failed = failed + FailWhen(layout.FrameOf("rows") == rows || layout.FrameOf("bar") != bar, "frame scroll");
    layout.SetScale(2);
    layout.Relayout("shell", 640, 480);
    host.FrameAdopt(layout, "shell");
    failed = failed + FailWhen(!host.FrameWrite("Build/rxu/arm-s2.list") || layout.FrameOf("mark") == mark, "frame scale");
    layout.SetScale(1);
    layout.SetFlow("RTL");
    layout.Relayout("shell", 640, 480);
    failed = failed + FailWhen(layout.FrameOf("sideTitle") == sideTitle, "frame rtl");
    layout.SetFlow("LTR");
    String sized = host.FrameResize(layout, "shell", 800, 600);
    failed = failed + FailWhen(sized == "" || host.FramePresent("") || host.Messages.Find("RXU049") < 0 || host.FramePhase() != "Open", "frame present " + sized);
    failed = failed + FailWhen(host.FrameClose() != "Closed" || host.FramePhase() != "Closed" || host.FramePump() != 0, "frame close");
    Return failed;
}

Public Function CheckCatalog() -> Int
Explain {
    Description: "Check every C1–C6 control, its schema, and the support matrix.";
    Input: None;
    Processing: "Load the catalog example, then check properties, bindings, accessibility, focus, state, and events for each entry. DataGrid edits stay inside a virtual window. Drawing commands change geometry only.";
    Output: "The number of failed checks.";
} {
    Int failed = 0;
    RxuParser parser = RxuParser();
    RxuNode document = parser.Parse("Examples/UI/Catalog.rxu", Files.ReadText("Examples/UI/Catalog.rxu"));
    CatHost host = CatHost();
    Int loaded = host.CatLoad(document);
    String loadNote = loaded.ToString();
    If (document.Messages.Count() > 0) {
        loadNote = loadNote + " " + document.Messages.FormatAt(0);
    }
    failed = failed + FailWhen(document.Messages.Count() != 0 || loaded != 68, "catalog load " + loadNote);
    failed = failed + FailWhen(host.CatCount() != 69 || !host.CatBeyond("DockPanel") || host.CatBeyond("Button") || host.CatBeyond("Nope") || host.CatFamilyOf("Canvas") != "C1", "catalog count " + host.CatCount().ToString());
    Int beyond = 0;
    Int index = 0;
    Int count = host.CatCount();
    While (index < count && failed == 0) {
        String kind = host.CatKindAt(index);
        String family = host.CatFamilyAt(index);
        String id = "n" + index.ToString();
        String source = "s" + index.ToString();
        String problem = "";
        If (!host.CatCreate(kind, id)) {
            problem = "create";
        }
        If (problem == "" && !host.CatSchema(kind).Contains("Name")) {
            problem = "schema";
        }
        If (problem == "" && (!host.CatSet(id, "ToolTip", "Hint") || host.CatSet(id, "Nope", "1"))) {
            problem = "tip";
        }
        If (problem == "" && host.CatAccess(id) == "") {
            problem = "role";
        }
        If (problem == "" && host.CatLabel(id) != id) {
            problem = "label";
        }
        If (problem == "" && !host.CatBind(id, "ToolTip", source)) {
            problem = "bind";
        }
        If (problem == "" && (host.CatSource(source, "Arm") != 1 || host.CatGet(id, "ToolTip") != "Arm")) {
            problem = "source";
        }
        Bool can = host.CatCanFocus(id);
        Bool took = host.CatFocus(id);
        If (problem == "" && can != took) {
            problem = "focus";
        }
        If (problem == "" && can && (host.CatFocused() != id || host.CatState(id) != "Focused")) {
            problem = "focused";
        }
        If (problem == "" && !can && host.CatState(id) != "Normal") {
            problem = "state";
        }
        If (problem == "" && (!host.CatRaise(id, "OnClick") || !host.CatHeard(id, "OnClick"))) {
            problem = "event";
        }
        If (problem == "" && host.CatRaise(id, "Nope")) {
            problem = "event-name";
        }
        If (problem == "" && !can && host.CatRaise(id, "OnFocus")) {
            problem = "onfocus";
        }
        If (problem == "" && can && !host.CatHeard(id, "OnFocus") && !host.CatRaise(id, "OnFocus")) {
            problem = "onfocus";
        }
        String expect = family + "|" + kind + "|Examples/UI/Catalog.rxu|CheckCatalog|RobixUI.txt";
        If (problem == "" && host.CatEntry(index) != expect) {
            problem = "matrix";
        }
        If (host.CatBeyond(kind)) {
            beyond = beyond + 1;
        }
        failed = failed + FailWhen(problem != "", "catalog " + index.ToString() + " " + kind + " " + problem);
        index = index + 1;
    }
    failed = failed + FailWhen(index == count && beyond != 55, "catalog beyond " + beyond.ToString());
    Bool hidden = host.CatCreate("PasswordBox", "secretBox") && host.CatSet("secretBox", "Password", "Arm");
    failed = failed + FailWhen(!hidden || host.CatGet("secretBox", "Value") != "***" || host.CatGet("secretBox", "Password") != "***" || host.CatSecret("secretBox") != "Arm" || host.CatSecret("plain") != "", "catalog password");
    Bool dated = host.CatCreate("DatePicker", "when") && host.CatSet("when", "Value", "2026-11-22");
    failed = failed + FailWhen(!dated || host.CatSet("when", "Value", "2026/11/22") || host.CatGet("when", "Value") != "2026-11-22" || !host.CatCreate("TimePicker", "clock") || !host.CatSet("clock", "Value", "09:30") || host.CatSet("clock", "Value", "9:30"), "catalog time");
    Bool counted = host.CatCreate("NumberBox", "count") && host.CatSet("count", "Value", "50");
    failed = failed + FailWhen(!counted || host.CatSet("count", "Value", "150") || host.CatGet("count", "Value") != "50" || !host.CatCreate("ColorPicker", "swatch") || !host.CatSet("swatch", "Value", "#336699") || host.CatSet("swatch", "Value", "blue") || !host.CatCreate("FilePicker", "pick") || !host.CatSet("pick", "Value", "arm.rxu") || host.CatSet("pick", "Value", "nopath"), "catalog input");
    Bool grid = host.CatCreate("DataGrid", "sheet") && host.CatVirtual("sheet", 1000, 20) == 20;
    Bool edited = grid && host.CatEdit("sheet", 3, 1, "Arm");
    Bool cancelled = edited && host.CatCancelEdit("sheet");
    Bool committed = cancelled && host.CatEdit("sheet", 3, 1, "Arm") && host.CatCommitEdit("sheet");
    Bool slid = committed && host.CatScroll("sheet", 40) && host.CatEdit("sheet", 40, 0, "Leg");
    failed = failed + FailWhen(!slid || host.CatTotal("sheet") != 1000 || host.CatMaterialized("sheet") != 20 || host.CatCell("sheet", 3, 1) != "Arm" || host.CatCell("sheet", 40, 0) != "Leg" || host.CatRow("sheet", 0) != "" || host.CatRow("sheet", 40) != "sheet#40" || host.CatEdit("sheet", 39, 0, "No") || host.CatState("sheet") != "Editing", "catalog grid");
    Bool radios = host.CatCreate("RadioButton", "r1") && host.CatCreate("RadioButton", "r2") && host.CatSet("r1", "Group", "arm") && host.CatSet("r2", "Group", "arm") && host.CatSet("r1", "Checked", "true") && host.CatSet("r2", "Checked", "true");
    failed = failed + FailWhen(!radios || host.CatGet("r1", "Checked") != "false" || host.CatGet("r2", "Checked") != "true" || host.CatState("r2") != "Checked", "catalog radio");
    Bool dimmed = host.CatCreate("Button", "dim") && host.CatFocus("dim") && host.CatSet("dim", "Enabled", "false");
    failed = failed + FailWhen(!dimmed || host.CatFocused() != "" || host.CatFocus("dim") || host.CatState("dim") != "Disabled" || host.CatRaise("dim", "OnClick"), "catalog disabled");
    Bool pressed = host.CatCreate("Button", "p1") && host.CatCreate("Button", "p2") && host.CatRaise("p1", "OnPressed");
    failed = failed + FailWhen(!pressed || host.CatState("p1") != "Pressed" || host.CatState("p2") != "Normal" || !host.CatHeard("p1", "OnPressed") || host.CatHeard("p2", "OnPressed"), "catalog press");
    Bool shape = host.CatCreate("Rectangle", "shape") && host.CatGeometry("shape") == "M0,0 H10 V10 H0 Z" && host.CatHit("shape", 5, 5) && !host.CatHit("shape", 20, 20);
    Bool sized = shape && host.CatCommand("shape", "Size", "20,30") == "M0,0 H20 V30 H0 Z" && host.CatCommand("shape", "Move", "4,5") == "M4,5 H24 V35 H4 Z";
    Bool dot = sized && host.CatCreate("Circle", "dot") && host.CatHit("dot", 3, 4) && !host.CatHit("dot", 6, 0) && host.CatGeometry("dot") == "C0,0,5";
    Bool egg = dot && host.CatCreate("Ellipse", "egg") && host.CatHit("egg", 6, 0) && !host.CatHit("egg", 7, 0);
    Bool mark = egg && host.CatCreate("Line", "mark") && host.CatHit("mark", 5, 0) && !host.CatHit("mark", 5, 1) && host.CatCommand("mark", "To", "8,0") == "L0,0,8,0";
    Bool curve = mark && host.CatCreate("Path", "curve") && host.CatHit("curve", 0, 0) && host.CatCommand("curve", "Add", "10,10") == "M0,0 L10,0 L10,10";
    Bool poly = curve && host.CatCreate("Polygon", "poly") && host.CatHit("poly", 5, 5) && !host.CatHit("poly", 11, 5) && host.CatGeometry("poly").EndsWith("Z");
    Bool wire = poly && host.CatCreate("Polyline", "wire") && host.CatHit("wire", 0, 0) && !host.CatHit("wire", 5, 5) && !host.CatGeometry("wire").EndsWith("Z");
    failed = failed + FailWhen(!wire || host.CatCommand("Text", "Move", "1,1") != "" || !host.CatSchema("DockPanel").Contains("Dock") || !host.CatSchema("PasswordBox").Contains("Password") || !host.CatSchema("DataGrid").Contains("Items") || !host.CatSchema("Rectangle").Contains("Fill") || !host.CatSchema("NavigationView").Contains("Route"), "catalog draw");
    Return failed;
}

Public Function CheckKit() -> Int
Explain {
    Description: "Check component libraries, instances, and templates.";
    Input: None;
    Processing: "Import definitions without a window, then instantiate the same component twice and keep their state apart.";
    Output: "The number of failed checks.";
} {
    Int failed = 0;
    KitHost host = KitHost();
    Int defined = host.KitImport("Examples/UI/Kit.rxu");
    failed = failed + FailWhen(defined != 4 || host.KitWindows() != 0 || host.KitInstances("Badge") != 0 || !host.KitDefined("Badge") || !host.KitDefined("Secret") || host.KitVersion("ArmKit") != "1.2" || host.KitDefault("Badge", "Caption") != "Arm" || host.KitSource("Badge") != "ArmKit", "kit import " + defined.ToString());
    RxuParser parser = RxuParser();
    RxuNode document = parser.Parse("Examples/UI/KitApp.rxu", Files.ReadText("Examples/UI/KitApp.rxu"));
    Int loaded = host.KitLoad(document);
    failed = failed + FailWhen(document.Messages.Count() != 0 || loaded != 5 || host.KitWindows() != 1 || host.KitCollisions() < 1 || host.KitVersion("ArmKit") != "1.2" || host.KitDefault("Badge", "Caption") != "Arm" || host.KitSource("Badge") != "ArmKit" || !host.KitDefined("Tag") || host.KitVersion("Extra") != "2.0" || host.KitSource("Tag") != "Extra" || host.KitInstances("Badge") != 3, "kit load " + loaded.ToString() + " " + host.KitCollisions().ToString());
    failed = failed + FailWhen(host.KitGet("one", "Caption") != "Shoulder" || host.KitGet("two", "Caption") != "Elbow" || !host.KitSet("one", "Caption", "Wrist") || host.KitGet("two", "Caption") != "Elbow" || host.KitGet("one", "Caption") != "Wrist" || host.KitSet("one", "Seal", "no") || host.KitGet("one", "Seal") != "", "kit isolate");
    String stamp = host.KitStamp("one");
    failed = failed + FailWhen(host.KitCall("one", "Press") != 0 || host.KitGet("one", "Pressed") != "true" || host.KitGet("two", "Pressed") != "false" || host.KitHook("one", "OnLoaded") != 1 || !host.KitListen("one", "OnPressed", "Heard") || host.KitCall("one", "Press") != 1 || host.KitHook("one", "OnLoaded") != 1 || host.KitOutput("one", "Label") != "Wrist", "kit behavior");
    String inner = host.KitPart("meter", "inner");
    failed = failed + FailWhen(host.KitResource("one", "Accent") != "#336699" || host.KitResource("meter", "Accent") != "" || host.KitResource(inner, "Accent") != "#336699" || host.KitStyle("one", "Face") != "#112233" || host.KitGet("meter", "Value") != "3" || host.KitSet("meter", "Value", "wide") || host.KitGet("meter", "Value") != "3" || host.KitKind(inner) != "Badge" || host.KitParent(inner) != "meter" || host.KitGet(inner, "Pressed") != "false" || host.KitKind(host.KitPart("one", "caption")) != "Text", "kit scope");
    failed = failed + FailWhen(!host.KitApplyTemplate("one", "Face") || host.KitAppearance("one") != "Face" || host.KitPartText("one", "caption") != "Face" || host.KitGet("one", "Caption") != "Wrist" || host.KitGet("one", "Pressed") != "true" || host.KitStamp("one") != stamp || host.KitCall("one", "Press") != 1, "kit template");
    failed = failed + FailWhen(!host.KitCreate("Badge", "three", "Home") || host.KitInstances("Badge") != 4 || host.KitGet("three", "Caption") != "Arm" || host.KitGet("one", "Caption") != "Wrist" || host.KitCreate("Secret", "hidden", "Home") || host.KitFind("bad") != "" || host.KitGet("good", "Id") != "7" || host.KitInvalid() < 1 || host.KitFind("one") != "one" || host.KitPhase() != "Open", "kit create");
    Return failed;
}

Public Function CheckFlow() -> Int
Explain {
    Description: "Check declarative branches, repeats, and communication.";
    Input: None;
    Processing: "Reconcile the flow example as slots change, including empty lists, missing keys, includes, and cycles.";
    Output: "The number of failed checks.";
} {
    Int failed = 0;
    RxuParser parser = RxuParser();
    RxuNode document = parser.Parse("Examples/UI/Flow.rxu", Files.ReadText("Examples/UI/Flow.rxu"));
    FlowHost host = FlowHost();
    host.FlowAssign("LoggedIn", "false");
    host.FlowAssign("Guest", "false");
    host.FlowAssign("Mode", "Idle");
    host.FlowAssign("Detail", "Hot");
    host.FlowAssign("Joints", "Shoulder,Elbow");
    host.FlowAssign("Groups", "A,B");
    host.FlowAssign("Members", "1,2");
    host.FlowAssign("Plain", "A,B");
    Int loaded = host.FlowLoad(document);
    failed = failed + FailWhen(document.Messages.Count() != 0 || loaded < 8 || !host.FlowHasText("Go") || host.FlowHasText("Hi") || host.FlowHasText("Guest") || !host.FlowHasText("Idle") || host.FlowHasText("Hot") || !host.FlowHasText("Shoulder") || !host.FlowHasText("Elbow") || !host.FlowHasText("1") || !host.FlowHasText("A") || !host.FlowHasText("Part") || !host.FlowHasText("Arm") || host.FlowLocal("Width") != "320" || host.FlowSetMiss() != 1 || host.FlowMissing() != 2 || host.FlowIncludes() != 1 || host.FlowIncludeAt(0) != "Examples/UI/FlowPart.rxu" || host.FlowImports() != 1 || host.FlowImportAt(0) != "Theme.rxu" || host.FlowFind("theme") != "" || host.FlowChildAt("host", 0) != "label" || host.FlowRepeatCount() != 8, "flow start " + document.Messages.Count().ToString() + " " + loaded.ToString() + " " + host.FlowRepeatCount().ToString() + " " + host.FlowLocal("Width") + " " + host.FlowMissing().ToString() + " " + host.FlowChildAt("host", 0));
    failed = failed + FailWhen(!host.FlowUpdate("Title", "Desk") || host.FlowRead("label", "Text") != "Desk" || host.FlowLoad(document) < 8 || host.FlowRead("label", "Text") != "Desk" || host.FlowLocal("Title") != "Desk", "flow let");
    failed = failed + FailWhen(!host.FlowUpdate("Width", "10") || host.FlowLocal("Width") != "10" || host.FlowLoad(document) < 8 || host.FlowLocal("Width") != "320", "flow set");
    String elbow = host.FlowByText("Elbow");
    String shoulder = host.FlowByText("Shoulder");
    failed = failed + FailWhen(elbow == "" || !host.FlowPut(elbow, "Width", "40") || host.FlowStamp(elbow) == "", "flow key id");
    host.FlowAssign("Joints", "Elbow,Wrist");
    host.FlowLoad(document);
    failed = failed + FailWhen(host.FlowRead(elbow, "Width") != "40" || host.FlowAttached(shoulder) || !host.FlowHasText("Wrist") || host.FlowRead(host.FlowByText("Wrist"), "Width") != "Auto" || !host.FlowHasText("Elbow"), "flow diff");
    host.FlowAssign("LoggedIn", "true");
    host.FlowLoad(document);
    String hiStamp = host.FlowStamp("hi");
    failed = failed + FailWhen(!host.FlowHasText("Hi") || host.FlowHasText("Go") || host.FlowAttached("go") || host.FlowDetachCount() < 1 || hiStamp == "", "flow if");
    failed = failed + FailWhen(!host.FlowPut("hi", "Width", "30"), "flow hi width");
    host.FlowAssign("LoggedIn", "false");
    host.FlowAssign("Guest", "true");
    host.FlowLoad(document);
    failed = failed + FailWhen(!host.FlowHasText("Guest") || host.FlowAttached("hi") || host.FlowHasText("Hi"), "flow elseif");
    host.FlowAssign("LoggedIn", "true");
    host.FlowAssign("Guest", "false");
    host.FlowLoad(document);
    failed = failed + FailWhen(!host.FlowAttached("hi") || host.FlowRead("hi", "Width") != "30" || host.FlowStamp("hi") != hiStamp || host.FlowParent("hi") != "host", "flow return");
    host.FlowAssign("Mode", "Live");
    host.FlowLoad(document);
    failed = failed + FailWhen(!host.FlowHasText("Hot") || host.FlowHasText("Idle") || host.FlowHasText("Warm") || host.FlowAttached("idle"), "flow choose");
    host.FlowAssign("Detail", "Warm");
    host.FlowLoad(document);
    failed = failed + FailWhen(!host.FlowHasText("Warm") || host.FlowAttached("hot") || host.FlowHasText("Hot"), "flow nested choose");
    host.FlowAssign("Members", "");
    host.FlowLoad(document);
    failed = failed + FailWhen(host.FlowHasText("1") || host.FlowRepeatCount() != 4, "flow nested empty " + host.FlowRepeatCount().ToString());
    host.FlowAssign("Joints", "");
    host.FlowLoad(document);
    failed = failed + FailWhen(host.FlowAttached(elbow) || host.FlowRead(elbow, "Width") != "40" || host.FlowHasText("Elbow") || host.FlowRepeatCount() != 2 || host.FlowLocal("joint") != "", "flow empty");
    failed = failed + FailWhen(!host.FlowListen("host", "OnClick", "Parent") || host.FlowRaise("hi", "OnClick") != 1, "flow event");
    Int cycles = host.FlowCycles();
    failed = failed + FailWhen(!host.FlowListen("host", "OnClick", "Loop") || host.FlowRaise("hi", "OnClick") < 1 || host.FlowCycles() <= cycles, "flow loop");
    failed = failed + FailWhen(!host.FlowLink("label.Text", "Title") || !host.FlowPush("Title", "Loop") || host.FlowRead("label", "Text") != "Loop" || host.FlowCycles() <= cycles, "flow cycle");
    RxuParser blocked = RxuParser();
    RxuNode whileNode = blocked.Parse("while.rxu", "<While/>");
    failed = failed + FailWhen(whileNode.Messages.Find("RXU008") < 0 || host.FlowWhileStatus() != "Rejected" || host.FlowPhase() != "Open" || !host.FlowAttached("host"), "flow while");
    Return failed;
}

Public Function CheckTree() -> Int
Explain {
    Description: "Check live tree queries and edits.";
    Input: None;
    Processing: "Import the live example, then find, edit, move, replace, and remove controls while the window stays open.";
    Output: "The number of failed checks.";
} {
    Int failed = 0;
    RxuParser parser = RxuParser();
    RxuNode document = parser.Parse("Examples/UI/LiveTree.rxu", Files.ReadText("Examples/UI/LiveTree.rxu"));
    TreeHost host = TreeHost();
    Int loaded = host.ImportTree(document);
    failed = failed + FailWhen(document.Messages.Count() != 0 || loaded != 4 || host.TreePhase() != "Open" || !host.TreeFindId("Home") || host.TreeKind("Home") != "Window" || host.TreeParent("go") != "body" || host.TreeChildCount("body") != 2 || host.TreeChildAt("body", 0) != "heading" || host.TreeChildAt("body", 1) != "go" || host.TreeSibling("heading", 1) != "go" || host.TreeSibling("go", -1) != "heading" || host.TreeSibling("go", 1) != "" || host.TreeRoot("go") != "Home", "tree shape " + loaded.ToString() + " " + host.TreeChildAt("body", 0));
    failed = failed + FailWhen(host.TreeFindKind("Button") != "go" || host.TreeFindName("heading") != "heading" || host.TreeFindPath("Home/body/go") != "go" || host.TreeRead("go", "Content") != "Start" || host.TreeRead("go", "Width") != "120" || host.TreeRead("heading", "Content") != "Arm" || host.TreeRead("Home", "Title") != "Home" || host.TreeMatchCount("Text") != 1, "tree find " + host.TreeFindPath("Home/body/go"));
    String stamp = host.TreeStamp("go");
    failed = failed + FailWhen(!host.TreeCreate("Text", "title2", "heading") || !host.TreeAdd("body", "title2") || host.TreeFindName("heading") != "heading" || host.TreeRead("title2", "Name") != "heading" || host.TreeMatchCount("Text") != 2 || host.TreeMatchAt("Text", 0) != "heading" || host.TreeMatchAt("Text", 1) != "title2" || host.TreeFindPath("Home/body/heading") != "heading", "tree names");
    failed = failed + FailWhen(!host.TreePut("go", "Width", "80") || host.TreePut("go", "Width", "wide") || host.TreeRead("go", "Width") != "80" || !host.TreeSetAttribute("go", "Note", "arm") || !host.TreeHasAttribute("go", "Note") || host.TreeGetAttribute("go", "Note") != "arm" || !host.TreeDropAttribute("go", "Note") || host.TreeHasAttribute("go", "Note") || host.TreePutMany("go", "Height=40;Enabled=false") != 2 || host.TreeRead("go", "Height") != "40" || host.TreeRead("go", "Enabled") != "false" || host.TreePutMany("go", "Width=wide;Height=10") != -1 || host.TreeRead("go", "Height") != "40" || !host.TreeResetAttribute("go", "Enabled") || host.TreeRead("go", "Enabled") != "true", "tree props");
    failed = failed + FailWhen(host.TreeMove("body", "go", 0) || host.TreeCreate("Button", "go", "Start") || !host.TreeCreate("Button", "temp", "Temp") || host.TreeAdd("missing", "temp") || host.TreeInsert("body", -1, "temp") || host.TreeMove("temp", "temp", 0) || host.TreeParent("go") != "body", "tree reject");
    failed = failed + FailWhen(!host.TreeOpen("other", "Editor", "Window", "Editor") || !host.TreeCreate("Panel", "side", "side") || !host.TreeAdd("Editor", "side") || !host.TreeMove("go", "side", 0) || host.TreeDoc("go") != "other" || host.TreeParent("go") != "side" || host.TreeRead("go", "Content") != "Start" || host.TreeRead("go", "Width") != "80" || host.TreeStamp("go") != stamp || host.TreeRoot("go") != "Editor" || host.TreeFindPath("Editor/side/go") != "go" || host.TreeFindPath("Home/body/go") != "" || host.TreeChildCount("body") != 2, "tree move " + host.TreeDoc("go") + " " + host.TreeParent("go"));
    failed = failed + FailWhen(!host.TreeReplace("go", "ToggleButton") || host.TreeKind("go") != "ToggleButton" || host.TreeStamp("go") != stamp || host.TreeRead("go", "Content") != "Start", "tree replace");
    String extraStamp = "";
    failed = failed + FailWhen(!host.TreeCreate("Button", "extra", "Extra") || !host.TreePut("extra", "Content", "Save") || !host.TreeAdd("body", "extra"), "tree extra");
    extraStamp = host.TreeStamp("extra");
    failed = failed + FailWhen(!host.TreeDetach("extra") || host.TreeAttached("extra") || host.TreeParent("extra") != "" || !host.TreeFindId("extra") || host.TreeRead("extra", "Content") != "Save" || !host.TreeAdd("body", "extra") || host.TreeRead("extra", "Content") != "Save", "tree detach");
    failed = failed + FailWhen(host.TreeClear("body") != 3 || host.TreeChildCount("body") != 0 || host.TreeAttached("heading") || !host.TreeFindId("heading") || host.TreeCreate("Text", "heading", "heading") || host.TreeStamp("heading") == "", "tree clear");
    Int layoutBefore = host.TreeLayoutCount();
    Int renderBefore = host.TreeRenderCount();
    failed = failed + FailWhen(!host.TreeBegin() || !host.TreePut("Home", "Title", "Desk") || !host.TreeCreate("Text", "late", "Late") || !host.TreeAdd("body", "late") || host.TreeLayoutCount() != layoutBefore || host.TreeRenderCount() != renderBefore || host.TreeCommit() != 1 || host.TreeLayoutCount() != layoutBefore + 1 || host.TreeRenderCount() != renderBefore + 1 || host.TreeRead("Home", "Title") != "Desk", "tree commit " + host.TreeLayoutCount().ToString());
    failed = failed + FailWhen(!host.TreeBegin() || !host.TreePut("Home", "Title", "Nope") || !host.TreeRollback() || host.TreeRead("Home", "Title") != "Desk" || host.TreeLayoutCount() != layoutBefore + 1 || !host.TreeFindId("late"), "tree rollback");
    failed = failed + FailWhen(!host.TreeAdd("body", "extra") || host.TreeChildCount("body") != 2 || host.TreeInvoke("extra", "RemoveSelf") != "Deferred" || host.TreeHeld() != 2 || host.TreeChildCount("body") != 1 || host.TreeAttached("extra") || !host.TreeFindId("extra") || host.TreeStamp("extra") != extraStamp || host.TreeInvoke("missing", "Enable") != "Missing" || host.TreeInvoke("late", "Nope") != "Rejected" || host.TreeInvoke("late", "Disable") != "Ok" || host.TreeRead("late", "Enabled") != "false", "tree action " + host.TreeHeld().ToString());
    failed = failed + FailWhen(!host.TreeSubscribe("go", "OnClick", "Save") || host.TreeRaise("go", "OnClick") != 1 || host.TreeSubscribe("go", "Click", "Save") || !host.TreeUnsubscribe("go", "OnClick", "Save") || host.TreeRaise("go", "OnClick") != 0, "tree event");
    failed = failed + FailWhen(host.TreePhase() != "Open" || !host.TreeAttached("Home") || !host.TreeAttached("Editor") || host.TreeAttributeCount("go") < 4, "tree open");
    Return failed;
}

Public Function CheckEvents() -> Int
Explain {
    Description: "Check routed input, events, and actions.";
    Input: None;
    Processing: "Load the events example and exercise binding, priority, unsubscribe, cancel, consume, exceptions, scopes, and the full inventory.";
    Output: "The number of failed checks.";
} {
    Int failed = 0;
    RxuParser parser = RxuParser();
    RxuNode document = parser.Parse("Examples/UI/Events.rxu", Files.ReadText("Examples/UI/Events.rxu"));
    EventHost host = EventHost();
    host.NoteHandler("Ready", "Event");
    host.NoteHandler("ShellClick", "Event");
    host.NoteHandler("Go", "Event");
    host.NoteHandler("Key", "Event");
    host.NoteHandler("Send", "Event");
    host.NoteHandler("Bad", "String");
    host.NoteHandler("Early", "Event");
    host.NoteHandler("First", "Event");
    host.NoteHandler("GoLate", "Event");
    host.NoteHandler("DocClick", "Event");
    host.NoteHandler("GlobalClick", "Event");
    host.NoteHandler("Consume", "Event");
    host.NoteHandler("Cancel", "Event");
    host.NoteHandler("Throw", "Throws");
    host.NoteHandler("Act", "Event");
    host.NoteHandler("Wheel", "Event");
    host.NoteHandler("Tabbed", "Event");
    host.NoteHandler("Closed", "Event");
    host.NoteHandler("Gone", "Event");
    host.NoteHandler("Any", "Event");
    Int loaded = host.ImportEvents(document);
    failed = failed + FailWhen(document.Messages.Count() != 0 || loaded != 3 || host.MismatchTally() != 1 || host.TraceSize() != 3 || host.TraceAt(0) != "Target Arm OnLoaded Ready Real" || host.TraceAt(1) != "Bubble Arm OnLoaded Ready Real" || host.TraceAt(2) != "Bubble Arm OnLoaded Ready Real", "event import " + document.Messages.Count().ToString() + " " + loaded.ToString() + " " + host.MismatchTally().ToString() + " " + host.TraceSize().ToString() + " " + host.TraceAt(0));
    host.ClearTrace();
    failed = failed + FailWhen(!host.WatchEvent("Component", "shell", "OnClick", "Early", "Capture", 0) || !host.WatchEvent("Component", "shell", "OnClick", "First", "Bubble", 10) || !host.WatchEvent("Component", "go", "OnClick", "GoLate", "Bubble", 0) || !host.WatchEvent("Document", "", "OnClick", "DocClick", "Bubble", 0) || !host.WatchEvent("Global", "", "OnClick", "GlobalClick", "Bubble", 0), "event watch");
    Int clicked = host.ClickEvent("go");
    failed = failed + FailWhen(clicked != 7 || host.LastSource() != "Real" || host.LastButton() != "Left" || host.TraceAt(0) != "Capture shell OnClick Early Real" || host.TraceAt(1) != "Target go OnClick Go Real" || host.TraceAt(2) != "Target go OnClick GoLate Real" || host.TraceAt(3) != "Bubble shell OnClick First Real" || host.TraceAt(4) != "Bubble shell OnClick ShellClick Real" || host.TraceAt(5) != "Document * OnClick DocClick Real" || host.TraceAt(6) != "Global * OnClick GlobalClick Real", "event order " + clicked.ToString() + " " + host.TraceAt(0));
    failed = failed + FailWhen(!host.UnwatchEvent("Component", "shell", "OnClick", "First", "Bubble") || host.UnwatchEvent("Component", "shell", "OnClick", "First", "Bubble"), "event unwatch");
    host.ClearTrace();
    failed = failed + FailWhen(host.ClickEvent("go") != 6 || host.TraceAt(3) != "Bubble shell OnClick ShellClick Real", "event after unwatch " + host.TraceAt(3));
    failed = failed + FailWhen(!host.WatchEvent("Component", "go", "OnClick", "Consume", "Bubble", 100), "event consume watch");
    host.ClearTrace();
    failed = failed + FailWhen(host.ClickEvent("go") != 2 || !host.ConsumedFlag() || host.TraceAt(1) != "Target go OnClick Consume Real" || host.TraceAt(2) != "", "event consume");
    failed = failed + FailWhen(!host.UnwatchEvent("Component", "go", "OnClick", "Consume", "Bubble") || !host.WatchEvent("Component", "go", "OnClick", "Cancel", "Bubble", 100), "event cancel watch");
    host.ClearTrace();
    failed = failed + FailWhen(host.ClickEvent("go") != 2 || !host.CancelledFlag() || host.TraceAt(1) != "Target go OnClick Cancel Real", "event cancel");
    host.UnwatchEvent("Component", "go", "OnClick", "Cancel", "Bubble");
    failed = failed + FailWhen(host.WatchEvent("Component", "go", "OnClick", "Bad", "Bubble", 0) || host.MismatchTally() < 2, "event mismatch");
    failed = failed + FailWhen(!host.WatchEvent("Component", "go", "OnClick", "Throw", "Bubble", 5), "event throw watch");
    host.ClearTrace();
    Int thrown = host.ClickEvent("go");
    failed = failed + FailWhen(thrown != 7 || host.ExceptionTally() != 1 || host.TraceAt(1) != "Target go OnClick Throw Real" || host.TraceAt(2) != "Target go OnClick Go Real", "event throw " + thrown.ToString());
    host.UnwatchEvent("Component", "go", "OnClick", "Throw", "Bubble");
    host.ClearTrace();
    failed = failed + FailWhen(host.RaiseEvent("go", "OnHover", "Synthetic") != 0 || host.LastSource() != "Synthetic" || host.RaiseEvent("go", "OnNope", "Synthetic") != 0 || host.RaiseEvent("go", "OnClick", "Fake") != 0, "event synthetic");
    failed = failed + FailWhen(!host.WatchEvent("Component", "go", "OnMouseWheel", "Wheel", "Bubble", 0) || host.PointEvent("go", "OnMouseWheel", 3, 4, "Wheel") != 1 || host.LastX() != 3 || host.LastY() != 4 || host.LastButton() != "Wheel", "event point");
    failed = failed + FailWhen(!host.WatchEvent("Component", "go", "OnTab", "Tabbed", "Bubble", 0) || host.KeyIn("go", "OnKeyDown", "Tab", "") < 2 || host.LastKey() != "Tab", "event key");
    host.ClearTrace();
    failed = failed + FailWhen(host.RunAction("go", "Submit") != "Ok" || host.TraceAt(0) != "Target go OnSubmit Send Real" || host.RunAction("go", "Nope") != "Rejected" || host.RunAction("missing", "Submit") != "Missing", "event action");
    failed = failed + FailWhen(!host.WatchEvent("Component", "go", "OnWindowClosing", "Cancel", "Bubble", 0) || !host.WatchEvent("Component", "go", "OnWindowClose", "Closed", "Bubble", 0), "event close watch");
    host.ClearTrace();
    failed = failed + FailWhen(host.RunAction("go", "Close") != "Ok" || !host.CancelledFlag() || host.TraceAt(0) != "Target go OnWindowClosing Cancel Real" || host.TraceAt(1) != "", "event close cancel");
    host.UnwatchEvent("Component", "go", "OnWindowClosing", "Cancel", "Bubble");
    host.ClearTrace();
    failed = failed + FailWhen(host.RunAction("go", "Close") != "Ok" || host.TraceAt(0) != "Target go OnWindowClose Closed Real", "event close");
    failed = failed + FailWhen(!host.WatchEvent("Component", "go", "OnClick", "Act", "Bubble", 1), "event act watch");
    host.ClearTrace();
    failed = failed + FailWhen(host.ClickEvent("go") < 1 || host.LastAction() != "Busy" || host.EventDepth() != 0, "event busy " + host.LastAction());
    host.UnwatchEvent("Component", "go", "OnClick", "Act", "Bubble");
    failed = failed + FailWhen(!host.WatchEvent("Component", "go", "OnDispose", "Gone", "Bubble", 0), "event dispose watch");
    host.ClearTrace();
    failed = failed + FailWhen(!host.DisposeHost("go") || host.TraceAt(0) != "Target go OnDispose Gone Real" || host.ClickEvent("go") != 0 || host.DisposeHost("go") || host.RunAction("go", "Dispose") != "Missing", "event dispose");
    failed = failed + FailWhen(host.ActionContract() != "Actions run on the UI thread. A nested action returns Busy." || host.KnownEventCount() != 84 || host.SupportOf("OnClick") != "Supported" || host.SupportOf("OnLeave") != "Supported" || host.SupportOf("OnEnter") != "Supported" || host.SupportOf("OnDispose") != "Supported" || host.SupportOf("OnSubmit") != "Supported" || host.SupportOf("OnWindowBlur") != "Supported" || host.SupportOf("OnDrop") != "Supported" || host.SupportOf("OnRender") != "Supported" || host.SupportOf("OnAnimationCancel") != "Supported" || host.SupportOf("OnNope") != "", "event support");
    EventHost cover = EventHost();
    cover.NoteHandler("Ready", "Event");
    cover.NoteHandler("ShellClick", "Event");
    cover.NoteHandler("Go", "Event");
    cover.NoteHandler("Key", "Event");
    cover.NoteHandler("Send", "Event");
    cover.NoteHandler("Bad", "String");
    cover.NoteHandler("Any", "Event");
    cover.ImportEvents(document);
    cover.ClearTrace();
    Int covered = cover.CoverEvents("go");
    failed = failed + FailWhen(covered < 84 || cover.SupportOf("OnDragOver") != "Supported" || cover.TraceAt(0) == "", "event cover " + covered.ToString());
    Return failed;
}

Public Function CheckMvp() -> Int
Explain {
    Description: "Check the Linux MVP controls.";
    Input: None;
    Processing: "Load the login, dashboard, and dynamic examples, then exercise focus, typing, clicks, lists, dialogs, styles, and bindings.";
    Output: "The number of failed checks.";
} {
    Int failed = 0;
    RxuParser parser = RxuParser();
    RxuNode login = parser.Parse("Examples/UI/Login.rxu", Files.ReadText("Examples/UI/Login.rxu"));
    MvpHost host = MvpHost();
    Int loaded = host.ImportMvp(login);
    failed = failed + FailWhen(login.Messages.Count() != 0 || loaded != 9 || host.MvpKind("Login") != "Window" || host.MvpKind("form") != "StackPanel" || host.MvpKind("user") != "TextBox" || host.MvpKind("submit") != "Button", "login import " + loaded.ToString());
    failed = failed + FailWhen(!host.FocusMvp("user") || host.FocusName() != "user" || !host.TypeMvp("user", "ada") || host.ReadField("user", "Content") != "ada", "login type");
    failed = failed + FailWhen(!host.KeyMvp("user", "Tab") || host.FocusName() != "secret", "login tab");
    failed = failed + FailWhen(!host.ToggleMvp("stay") || host.ReadField("stay", "Checked") != "true", "login check");
    failed = failed + FailWhen(!host.PressMvp("submit") || host.ClickTally() != 1, "login click");
    failed = failed + FailWhen(!host.PutField("submit", "Enabled", "false") || host.PressMvp("submit") || host.ClickTally() != 1 || host.ReadField("submit", "Enabled") != "false", "login disabled");
    failed = failed + FailWhen(host.PutField("submit", "Width", "wide") || host.ReadField("submit", "Width") != "120", "login width");
    failed = failed + FailWhen(!host.SpinMvp("wait", True) || host.Spinning() != "wait" || !host.SpinMvp("wait", False) || host.Spinning() != "", "login spin");
    failed = failed + FailWhen(!host.OpenNotice("error") || host.NoticeOpen() != "error" || !host.CloseNotice() || host.NoticeOpen() != "", "login dialog");
    failed = failed + FailWhen(!host.StyleMvp("Primary", "#336699") || !host.ApplyMvp("submit", "Primary") || host.ReadField("submit", "Background") != "#336699", "login style");
    failed = failed + FailWhen(!host.PutField("submit", "Background", "#000000") || !host.ApplyMvp("submit", "Primary") || host.ReadField("submit", "Background") != "#000000", "login local");
    failed = failed + FailWhen(host.ReadField("title", "Color") != "#336699" || !host.UseTheme("Dark") || host.ReadField("title", "Color") != "#112233", "login theme");
    failed = failed + FailWhen(!host.BindMvp("title", "Content", "Heading") || host.PushMvp("Heading", "Welcome") != 1 || host.ReadField("title", "Content") != "Welcome", "login bind");
    failed = failed + FailWhen(!host.PutField("title", "Content", "Sign in") || host.PushMvp("Heading", "Other") != 0 || host.ReadField("title", "Content") != "Sign in", "login bind local");
    RxuNode board = parser.Parse("Examples/UI/Dashboard.rxu", Files.ReadText("Examples/UI/Dashboard.rxu"));
    MvpHost dash = MvpHost();
    dash.ImportMvp(board);
    failed = failed + FailWhen(board.Messages.Count() != 0 || dash.MvpKind("board") != "Grid" || dash.MvpKind("scroller") != "ScrollView" || dash.MvpKind("feed") != "ListView" || dash.MvpKind("mark") != "Image" || dash.MvpKind("stage") != "View" || dash.ReadField("mark", "Source") != "arm.png" || dash.ReadField("board", "Columns") != "2", "dashboard");
    failed = failed + FailWhen(!dash.AddRow("feed", "Shoulder") || !dash.AddRow("feed", "Elbow") || dash.ReadField("feed", "Count") != "2" || dash.ReadField("feed", "Item0") != "Shoulder" || !dash.RemoveRow("feed", 0) || dash.ReadField("feed", "Count") != "1" || dash.ReadField("feed", "Item0") != "Elbow", "dashboard list");
    RxuNode editor = parser.Parse("Examples/UI/Dynamic.rxu", Files.ReadText("Examples/UI/Dynamic.rxu"));
    MvpHost live = MvpHost();
    live.ImportMvp(editor);
    failed = failed + FailWhen(editor.Messages.Count() != 0 || !live.AddMvp("Button", "extra") || live.MvpKind("extra") != "Button" || !live.PutField("extra", "Content", "Save") || live.ReadField("extra", "Content") != "Save" || !live.PressMvp("extra") || live.ClickTally() != 1 || live.AddMvp("Button", "extra"), "dynamic");
    Return failed;
}

Public Function CheckNav() -> Int
Explain {
    Description: "Check navigation, chrome, dialogs, and window lifetime.";
    Input: None;
    Processing: "Load Examples/UI/Navigate.rxu. Move through nested routes, trap dialog focus, and save a window.";
    Output: "The number of failed checks.";
} {
    Int failed = 0;
    RxuParser parser = RxuParser();
    RxuNode document = parser.Parse("Examples/UI/Navigate.rxu", Files.ReadText("Examples/UI/Navigate.rxu"));
    NavHost host = NavHost();
    Int pages = host.NavImport(document);
    String home = host.NavGo("Home");
    String joints = host.NavGo("Joints");
    String elbow = host.NavGo("Joints/Elbow");
    failed = failed + FailWhen(document.Messages.Count() != 0 || pages != 4 || home != "home" || joints != "joints" || elbow != "elbow" || host.NavHistoryCount() != 2 || host.NavCrumbCount() != 2 || host.NavCrumbAt(0) != "Joints" || host.NavCrumbAt(1) != "Elbow" || host.NavEventAt(0) != "Navigate Home", "nav route " + pages.ToString() + " " + elbow + " " + host.NavCrumbAt(0));
    String back = host.NavBack();
    String forward = host.NavForward();
    failed = failed + FailWhen(back != "joints" || host.NavRoute() != "Joints/Elbow" || forward != "elbow" || host.NavPage() != "elbow", "nav history " + back + " " + forward + " " + host.NavRoute());
    failed = failed + FailWhen(host.NavChromeCount() != 6 || host.NavChrome("file") != "Menu" || host.NavChrome("save") != "MenuItem" || host.NavChrome("tools") != "Toolbar" || host.NavChrome("status") != "StatusBar" || host.NavChrome("title") != "TitleBar" || host.NavChrome("tab") != "TabItem", "nav chrome " + host.NavChromeCount().ToString());
    failed = failed + FailWhen(!host.NavMoveOverlay("tip", 12, 40) || !host.NavOpenOverlay("tip") || host.NavPopupAt("tip") != "12,40" || host.NavOverlayState("tip") != "Open" || !host.NavOpenOverlay("more") || !host.NavOpenOverlay("side") || !host.NavOpenOverlay("ask") || host.NavModal() != "ask" || host.NavFocused() != "ask" || host.NavFocus("home") || host.NavFocused() != "ask" || host.NavKey("Tab") != "ask" || host.NavKey("Escape") != "" || host.NavModal() != "" || host.NavOverlayState("ask") != "Closed", "nav dialog " + host.NavModal() + " " + host.NavFocused());
    failed = failed + FailWhen(host.NavWindowCount() != 2 || !host.NavShowWindow("Desk") || !host.NavShowWindow("extra") || host.NavWindowState("extra") != "Shown" || !host.NavHideWindow("extra") || host.NavWindowState("extra") != "Hidden" || host.NavWindowState("Desk") != "Shown" || !host.NavCloseWindow("extra") || host.NavWindowState("extra") != "Closed" || host.NavShowWindow("extra") || !host.NavReopenWindow("extra") || host.NavWindowState("extra") != "Shown", "nav windows " + host.NavWindowState("extra"));
    failed = failed + FailWhen(!host.NavSetTitle("Desk", "Desk") || !host.NavMoveWindow("Desk", 4, 8) || !host.NavSave("Desk") || !host.NavSetTitle("Desk", "Nope") || !host.NavMoveWindow("Desk", 9, 9) || !host.NavRestore("Desk") || host.NavReadTitle("Desk") != "Desk" || host.NavReadPosition("Desk") != "4,8", "nav save " + host.NavReadTitle("Desk") + " " + host.NavReadPosition("Desk"));
    failed = failed + FailWhen(!host.NavDrop("settings") || host.NavAlive("settings") || host.NavGo("Settings") != "" || host.NavCloseHost() != "Closed" || host.NavPhase() != "Closed" || host.NavGo("Home") != "", "nav drop " + host.NavPhase());
    Return failed;
}

Public Function CheckSamples() -> Int
Explain {
    Description: "Parse the RXU fixture, the examples, and the negative samples.";
    Input: None;
    Processing: "Accept the window fixture and the Examples/UI files, and reject malformed markup with stable codes.";
    Output: "The number of failed checks.";
} {
    Int failed = 0;
    String fixture = Files.ReadText("UI/Fixtures/Window.rxu");
    RxuParser parser = RxuParser();
    RxuNode document = parser.Parse("UI/Fixtures/Window.rxu", fixture);
    RxuNode window = document.FindChild("Window");
    If (document.Messages.Count() != 0 || window.Name != "Window") {
        failed = failed + 1;
        Print("RXU fail fixture");
        Print(document.Describe());
        Int item = 0;
        While (item < document.Messages.Count() && item < 6) {
            Print(document.Messages.FormatAt(item));
            item = item + 1;
        }
        Print(document.Messages.Count());
    }
    If (window.FindAttribute("Title").Text != "Arm" || window.FindAttribute("Title").Mode != "String") {
        failed = failed + 1;
        Print("RXU fail title");
    }
    If (window.FindAttribute("Width").Text != "320" || window.FindAttribute("Width").Mode != "Number") {
        failed = failed + 1;
        Print("RXU fail width");
    }
    If (window.FindAttribute("Opacity").Text != "0.5" || window.FindAttribute("Opacity").Mode != "Float") {
        failed = failed + 1;
        Print("RXU fail opacity");
    }
    If (window.FindAttribute("Enabled").Text != "true" || window.FindAttribute("Enabled").Mode != "Boolean") {
        failed = failed + 1;
        Print("RXU fail enabled");
    }
    If (window.FindKind("Comment").Text != " arm panel ") {
        failed = failed + 1;
        Print("RXU fail comment");
    }
    RxuNode color = window.FindChild("Resources").FindChild("Color");
    If (color.FindAttribute("Name").Text != "Accent" || color.FindAttribute("Value").Text != "#336699") {
        failed = failed + 1;
        Print("RXU fail resources");
    }
    RxuNode button = window.FindChild("Component").FindChild("Button");
    If (button.Mode != "Empty" || button.FindAttribute("Text").Mode != "Binding" || button.FindAttribute("Text").Text != "Joint") {
        failed = failed + 1;
        Print("RXU fail binding");
    }
    If (window.FindChild("Import").FindAttribute("Source").Text != "Theme.rxu" || window.FindChild("Include").FindAttribute("Source").Text != "Part.rxu") {
        failed = failed + 1;
        Print("RXU fail import");
    }
    Int textCount = 0;
    Int cursor = 0;
    While (cursor < window.Children.Count()) {
        RxuNode child = window.Children[cursor];
        If (child.Kind == "Element" && child.Name == "Text") {
            If (textCount == 0 && (child.FindAttribute("Value").Text != "Line\nNext" || child.FindAttribute("Value").Mode != "String")) {
                failed = failed + 1;
                Print("RXU fail escape");
            }
            If (textCount == 1 && (child.FindAttribute("Value").Mode != "Resource" || child.FindAttribute("Value").Text != "Accent")) {
                failed = failed + 1;
                Print("RXU fail resource expression");
            }
            If (textCount == 2 && (child.FindAttribute("Value").Mode != "Localization" || child.FindAttribute("Value").Text != "Title")) {
                failed = failed + 1;
                Print("RXU fail localization");
            }
            If (textCount == 3 && (child.FindAttribute("Value").Mode != "Expression" || child.FindAttribute("Value").Text != "Panel.Width")) {
                failed = failed + 1;
                Print("RXU fail value expression");
            }
            textCount = textCount + 1;
        }
        cursor = cursor + 1;
    }
    If (textCount != 4) {
        failed = failed + 1;
        Print("RXU fail text count");
    }
    RxuNode branch = window.FindChild("If");
    If (branch.FindChild("Text").FindAttribute("Value").Text != "Hi" || branch.FindChild("Else").FindChild("Text").FindAttribute("Value").Text != "Go" || window.FindChild("Else").Name != "") {
        failed = failed + 1;
        Print("RXU fail else");
    }
    RxuNode choice = window.FindChild("Choose");
    If (choice.FindChild("When").FindAttribute("Value").Text != "Live" || choice.FindChild("Otherwise").FindChild("Text").FindAttribute("Value").Text != "Idle") {
        failed = failed + 1;
        Print("RXU fail choose");
    }
    If (window.FindChild("Each").FindAttribute("Items").Mode != "Expression" || window.FindChild("Each").FindAttribute("Items").Text != "Joints") {
        failed = failed + 1;
        Print("RXU fail each");
    }
    If (window.FindChild("Label").FindAttribute("Text").Text != "Café") {
        failed = failed + 1;
        Print("RXU fail unicode");
    }
    failed = failed + FailWhen(parser.Parse("Button.rxu", "<Button Text=\"Hi\"/>").FindChild("Button").FindAttribute("Text").Text != "Hi", "quoted button");
    failed = failed + FailWhen(parser.Parse("Flag.rxu", "<A Enabled/>").FindChild("A").FindAttribute("Enabled").Text != "true", "bare flag");
    failed = failed + FailWhen(parser.Parse("Space.rxu", "<A> Hi </A>").FindChild("A").FindKind("Text").Text != " Hi ", "text");
    RxuNode expression = parser.Parse("Bind.rxu", "<A>{Binding User.Name}</A>").FindChild("A").FindKind("Expression");
    failed = failed + FailWhen(expression.Mode != "Binding" || expression.Text != "User.Name", "binding text");
    RxuNode mismatch = parser.Parse("Bad.rxu", "<Window></Door>");
    failed = failed + FailWhen(mismatch.Messages.Find("RXU001") < 0 || mismatch.Messages.At(mismatch.Messages.Find("RXU001")).Expected != "Window" || mismatch.Messages.At(mismatch.Messages.Find("RXU001")).Actual != "Door", "mismatch");
    failed = failed + FailWhen(parser.Parse("Open.rxu", "<Window>").Messages.Find("RXU002") < 0, "unclosed");
    failed = failed + FailWhen(parser.Parse("Loop.rxu", "<While></While>").Messages.Find("RXU008") < 0, "while");
    failed = failed + FailWhen(parser.Parse("Xml.rxu", "<?xml version=\"1.0\"?><A/>").Messages.Find("RXU009") < 0, "xml");
    failed = failed + FailWhen(parser.Parse("Empty.rxu", "<A>{}</A>").Messages.Find("RXU007") < 0, "empty expression");
    failed = failed + FailWhen(parser.Parse("Namespace.rxu", "<ui:Button/>").Messages.Find("RXU015") < 0, "namespace");
    failed = failed + FailWhen(parser.Parse("Loose.rxu", "<Else/>").Messages.Find("RXU010") < 0, "loose else");
    failed = failed + FailWhen(parser.Parse("Quote.rxu", "<A Text=\"Hi>").Messages.Find("RXU004") < 0, "string");
    failed = failed + FailWhen(parser.Parse("Brace.rxu", "<A>{Name</A>").Messages.Find("RXU005") < 0, "expression");
    failed = failed + FailWhen(parser.Parse("Note.rxu", "<!-- comment").Messages.Find("RXU006") < 0, "comment");
    failed = failed + FailWhen(parser.Parse("Broken.rxu", "<>").Messages.Find("RXU003") < 0, "malformed");
    failed = failed + FailWhen(parser.Parse("Two.rxu", "<If></If><Else/><Else/>").Messages.Find("RXU012") < 0, "duplicate else");
    failed = failed + FailWhen(parser.Parse("Defaults.rxu", "<Choose></Choose><Default/><Otherwise/>").Messages.Find("RXU013") < 0, "duplicate default");
    failed = failed + FailWhen(parser.Parse("Orphan.rxu", "<When/>").Messages.Find("RXU011") < 0, "orphan when");
    RxuNode nested = parser.Parse("Nest.rxu", "<If Name=\"A\"></If><If Name=\"B\"></If><Else Name=\"C\"/>");
    failed = failed + FailWhen(nested.Messages.Count() != 0 || nested.Children.Count() != 2 || nested.Children[1].FindChild("Else").FindAttribute("Name").Text != "C" || nested.Children[0].FindChild("Else").Name != "", "nearest else");
    RxuNode adopted = parser.Parse("Adopt.rxu", "<Choose Name=\"C\"></Choose><When Value=\"On\"/>");
    failed = failed + FailWhen(adopted.Messages.Count() != 0 || adopted.Children.Count() != 1 || adopted.FindChild("Choose").FindChild("When").FindAttribute("Value").Text != "On", "adopted when");
    RxuLexer lexer = RxuLexer();
    lexer.Tokenize("Button.rxu", "<Button/>");
    failed = failed + FailWhen(lexer.TokenCount() != 5 || lexer.TokenAt(0).Kind != "Open" || lexer.TokenAt(1).Text != "Button" || lexer.TokenAt(2).Kind != "Slash" || lexer.TokenAt(3).Kind != "Close" || lexer.TokenAt(4).Kind != "End", "tokens");
    Mark("examples");
    failed = failed + CheckExamples();
    Mark("documents");
    failed = failed + CheckDocuments();
    Mark("properties");
    failed = failed + CheckProperties();
    Mark("resources");
    failed = failed + CheckResources();
    Mark("build");
    failed = failed + CheckBuild();
    Mark("bindings");
    failed = failed + CheckBindings();
    Mark("backend");
    failed = failed + CheckBackend();
    Mark("linux");
    failed = failed + CheckLinux();
    Mark("layout");
    failed = failed + CheckLayout();
    Mark("frame");
    failed = failed + CheckFrame();
    Mark("mvp");
    failed = failed + CheckMvp();
    Mark("events");
    failed = failed + CheckEvents();
    Mark("tree");
    failed = failed + CheckTree();
    Mark("flow");
    failed = failed + CheckFlow();
    Mark("kit");
    failed = failed + CheckKit();
    Mark("catalog");
    failed = failed + CheckCatalog();
    Mark("nav");
    failed = failed + CheckNav();
    Mark("done");
    If (failed == 0) {
        Print("RXU checks passed");
    } Else {
        Print("RXU checks failed");
        Print(failed);
    }
    Return failed;
}

Private Function Mark(String name) -> Int {
    Files.WriteText("Build/rxu/step.txt", name);
    Return 0;
}

Private Function FailWhen(Bool failed, String name) -> Int {
    If (failed) {
        Print("RXU fail " + name);
        Return 1;
    }
    Return 0;
}

Private Function ShowPad(Int depth) -> String {
    String pad = "";
    Int index = 0;
    While (index < depth) {
        pad = pad + "  ";
        index = index + 1;
    }
    Return pad;
}

Private Function ShowCount(RxuNode node) -> Int {
    Int count = 0;
    If (node.Kind == "Element") {
        count = 1;
    }
    Int index = 0;
    While (index < node.Children.Count()) {
        count = count + ShowCount(node.Children[index]);
        index = index + 1;
    }
    Return count;
}

Private Function ShowFind(RxuNode node, String name) -> RxuNode {
    If (node.Kind == "Element" && node.FindAttribute("Name").Text == name) {
        Return node;
    }
    Int index = 0;
    While (index < node.Children.Count()) {
        RxuNode found = ShowFind(node.Children[index], name);
        If (found.Name != "") {
            Return found;
        }
        index = index + 1;
    }
    Return RxuNode();
}

Private Function ShowTree(RxuNode node, Int depth) -> Void {
    If (node.Kind == "Document") {
        Int index = 0;
        While (index < node.Children.Count()) {
            ShowTree(node.Children[index], depth);
            index = index + 1;
        }
        Return;
    }
    If (node.Kind == "Comment") {
        Print(ShowPad(depth) + "comment:" + node.Text);
        Return;
    }
    If (node.Kind != "Element") {
        Return;
    }
    String line = ShowPad(depth) + node.Name;
    Int attr = 0;
    While (attr < node.Attributes.Count()) {
        line = line + "  " + node.Attributes[attr].Name + "=" + node.Attributes[attr].Text;
        If (node.Attributes[attr].Mode != "" && node.Attributes[attr].Mode != "String") {
            line = line + " [" + node.Attributes[attr].Mode + "]";
        }
        attr = attr + 1;
    }
    Print(line);
    Int child = 0;
    While (child < node.Children.Count()) {
        ShowTree(node.Children[child], depth + 1);
        child = child + 1;
    }
}

Public Function ShowArm() -> Int
Explain {
    Description: "Print the Arm console example with the UI pieces that exist.";
    Input: None;
    Processing: "Parse Examples/UI/ArmConsole.rxu, then load, resolve, bind, lay out, draw, and open it.";
    Output: "Zero when the example parsed and loaded.";
} {
    String path = "Examples/UI/ArmConsole.rxu";
    Print("Robix UI");
    Print(path);
    Print("Markup is parsed, then a document, resources, a style, a binding, layout, drawing, and a Linux window use that same file.");
    RxuParser parser = RxuParser();
    RxuNode document = parser.Parse(path, Files.ReadText(path));
    Print(" ");
    Print("--- Markup ---");
    Print(ShowCount(document).ToString() + " elements, " + document.Messages.Count().ToString() + " diagnostics");
    If (document.Messages.Count() != 0) {
        Print(document.Messages.FormatAt(0));
        Return 1;
    }
    ShowTree(document, 0);
    Print(" ");
    Print("--- Document ---");
    UI app = UI();
    RxuDocument loaded = app.Load(path);
    Print("state " + loaded.State + ", id " + loaded.Id + ", root " + loaded.Root.Kind + " " + loaded.Root.Name);
    If (loaded.State != "Loaded") {
        If (loaded.Messages.Count() > 0) {
            Print(loaded.Messages.FormatAt(0));
        }
        Return 1;
    }
    Print("component " + loaded.ComponentName(0));
    Print("find shell -> " + app.Documents.FindByName(loaded.Id, "shell").Kind + " " + app.Documents.FindByName(loaded.Id, "shell").Name);
    app.Show(loaded.Id);
    Print("shown as " + app.GetDocument(loaded.Id).State);
    Print(" ");
    Print("--- Resources ---");
    ResourceTable table = ResourceTable();
    RxuNode resources = document.FindChild("Window").FindChild("Resources");
    Int index = 0;
    While (index < resources.Children.Count()) {
        RxuNode item = resources.Children[index];
        If (item.Kind == "Element") {
            table.Set(item.Name, item.FindAttribute("Name").Text, item.FindAttribute("Value").Text);
            Print(item.Name + " " + item.FindAttribute("Name").Text + " = " + item.FindAttribute("Value").Text);
        }
        index = index + 1;
    }
    ResourceLibrary library = ResourceLibrary();
    Print("Ink follows @Accent -> " + library.Resolve(table, ResourceTable(), "Ink", "missing"));
    Print("builtin FontFamily -> " + library.Resolve(ResourceTable(), ResourceTable(), "FontFamily", "missing"));
    Print(" ");
    Print("--- Style ---");
    StyleSheet sheet = StyleSheet();
    Int rejected = sheet.Load(document.FindChild("Window").FindChild("Style"));
    UIElement save = UIElement();
    save.Kind = "Button";
    Int applied = sheet.Apply(save, "Primary", "Hover");
    Print("Hover setters applied: " + applied.ToString() + ", rejected " + rejected.ToString());
    Print("Background from the style: " + save.GetAttribute("Background"));
    save.SetAttribute("Background", "#000000");
    Print("A local value wins: " + save.GetAttribute("Background"));
    Print(" ");
    Print("--- Binding ---");
    BindingEngine engine = BindingEngine();
    engine.DefineValue("Joint", "shoulder", False);
    engine.DefineList("Joints");
    engine.AddItem("Joints", "shoulder");
    engine.AddItem("Joints", "elbow");
    engine.AddItem("Joints", "wrist");
    UIElement heading = UIElement();
    heading.Kind = "Window";
    engine.BindTo(heading, "Title", "Joint", "OneWay", "Upper", False, "Arm", "Change", "");
    Print("Joint shoulder, Upper converter -> " + heading.GetAttribute("Title"));
    engine.ChangeValue("Joint", "wrist");
    Print("Change the source to wrist -> " + heading.GetAttribute("Title"));
    RxuExpression math = RxuExpression();
    Print("Joints.Count -> " + math.EvaluateExpression("Joints.Count", engine, ""));
    Print("Length(\"Arm\") -> " + math.EvaluateExpression("Length(\"Arm\")", BindingEngine(), ""));
    Print("1 + 2 * 3 -> " + math.EvaluateExpression("1 + 2 * 3", BindingEngine(), ""));
    Print(" ");
    Print("--- Property ---");
    UIElement box = UIElement();
    box.Kind = "Button";
    box.SetAttribute("Opacity", "1");
    If (box.SetAttribute("Width", "wide")) {
        Print("wide was accepted");
    } Else {
        Print("Width stays " + box.GetAttribute("Width") + " because wide is not a dimension");
        Int at = box.Messages.Find("RXU018");
        If (at >= 0) {
            Print(box.Messages.FormatAt(at));
        }
    }
    Print(" ");
    Print("--- Layout ---");
    Print("The shell panel is measured, arranged, and rendered in logical pixels.");
    Print(LayoutEngine().DecorationNote());
    RxuNode shell = document.FindChild("Window").FindChild("Panel");
    LayoutEngine layout = LayoutEngine();
    layout.ImportLayout(shell, "");
    layout.Relayout("shell", 640, 480);
    index = 0;
    While (index < layout.Slots.Count()) {
        String id = layout.Slots[index].Id;
        Print(ShowPad(1) + id + "  " + layout.Slots[index].Kind + "  " + layout.FrameOf(id));
        index = index + 1;
    }
    Directory.Create("Build/rxu");
    String scene = "size 640 480\n";
    Int sceneIndex = 0;
    While (sceneIndex < layout.CommandCount()) {
        scene = scene + layout.CommandAt(sceneIndex) + "\n";
        sceneIndex = sceneIndex + 1;
    }
    Files.WriteText("Build/rxu/show.list", scene);
    Print(" ");
    Print("--- Drawing ---");
    Print(layout.CommandCount().ToString() + " commands");
    index = 0;
    While (index < layout.CommandCount()) {
        Print(ShowPad(1) + layout.CommandAt(index));
        index = index + 1;
    }
    layout.SetOffset("list", 0, 40);
    layout.Relayout("shell", 640, 480);
    Print("Scroll the joint list by 40: rows " + layout.FrameOf("rows"));
    layout.SetScale(2);
    layout.Relayout("shell", 640, 480);
    Print("Scale 2 doubles device pixels: mark " + layout.FrameOf("mark"));
    layout.SetScale(1);
    layout.SetFlow("RTL");
    layout.Relayout("shell", 640, 480);
    Print("Right to left mirrors inside the parent: sideTitle " + layout.FrameOf("sideTitle"));
    Print(" ");
    Print("--- Linux window ---");
    LinuxApp host = LinuxApp();
    host.OpenAppWindow("arm", "Arm console", "640", "480");
    host.RunApp();
    Print("phase " + host.ReadPhase() + ", state " + host.ReadWindowState("arm") + ", size " + host.ReadWindowSize("arm") + ", scale " + host.ReadScale());
    index = 0;
    While (index < host.TraceCount()) {
        Print(ShowPad(1) + host.TraceAt(index));
        index = index + 1;
    }
    Print(" ");
    Print("--- Rejected markup ---");
    RxuParser blockedParser = RxuParser();
    RxuNode blocked = blockedParser.Parse("While.rxu", "<While/>");
    If (blocked.Messages.Count() > 0) {
        Print(blocked.Messages.FormatAt(0));
    }
    Print(" ");
    Print("The example file is Examples/UI/ArmConsole.rxu.");
    Print("Run ./show-ui.sh to print this again. Run UI/Rxu.rx with no argument to run the checks.");
    Return 0;
}

Private Function LiveField(String text, Int item) -> String {
    Int seen = 0;
    Int start = 0;
    Int index = 0;
    While (index <= text.Length()) {
        Bool boundary = index == text.Length();
        If (!boundary) {
            boundary = text.GetChar(index) == " ";
        }
        If (boundary) {
            If (seen == item) {
                Return text.Substring(start, index - start);
            }
            seen = seen + 1;
            start = index + 1;
        }
        index = index + 1;
    }
    Return "";
}

Public Function ShowLive() -> Int
Explain {
    Description: "Keep the Arm console open and apply input from the surface.";
    Input: None;
    Processing: "Read pointer, key, resize, and close records. Route them through the event host, change the heading, and rewrite the display list. Close disposes the Linux queue.";
    Output: "Zero when the window closed after a click and a key.";
} {
    RxuParser parser = RxuParser();
    String path = "Examples/UI/ArmConsole.rxu";
    RxuNode document = parser.Parse(path, Files.ReadText(path));
    RxuNode shell = document.FindChild("Window").FindChild("Panel");
    LayoutEngine layout = LayoutEngine();
    layout.ImportLayout(shell, "");
    layout.Relayout("shell", 640, 480);
    FrameHost frame = FrameHost();
    frame.FrameAdopt(layout, "shell");
    EventHost events = EventHost();
    events.NoteHandler("JointEdit", "Event");
    events.ImportEvents(document);
    events.WatchEvent("Component", "heading", "OnClick", "JointEdit", "Bubble", 0);
    events.WatchEvent("Component", "heading", "OnKeyDown", "JointEdit", "Bubble", 0);
    LinuxApp app = LinuxApp();
    app.CreateApp();
    app.OpenAppWindow("Arm", "Arm", "640", "480");
    app.RunApp();
    app.EnterBackground();
    app.PostWork("Title|Arm|Clicked");
    app.LeaveBackground();
    Int handled = 0;
    String clicked = "";
    String keyed = "";
    Bool open = True;
    Files.WriteText("Build/rxu/ready.txt", "open\n");
    While (open) {
        String input = "";
        If (Files.Exists("Build/rxu/input.txt")) {
            input = Files.ReadText("Build/rxu/input.txt");
        }
        Int count = 0;
        Int start = 0;
        Int index = 0;
        Bool changed = False;
        While (index <= input.Length()) {
            Bool boundary = index == input.Length();
            If (!boundary) {
                boundary = input.GetChar(index) == "\n";
            }
            If (boundary && index > start && count >= handled) {
                String line = input.Substring(start, index - start);
                String kind = LiveField(line, 0);
                If (kind == "Pointer" && LiveField(line, 3) == "") {
                    Int x = LiveField(line, 1).ToInt();
                    Int y = LiveField(line, 2).ToInt();
                    String hit = frame.FrameHit(x, y);
                    If (hit == "") {
                        hit = "heading";
                    }
                    app.Backend.OfferInput("Pointer", x.ToString() + " " + y.ToString());
                    events.ClickEvent(hit);
                    layout.SetText("heading", "Content", "Clicked");
                    layout.Relayout("shell", 640, 480);
                    frame.FrameDamage(layout, "heading");
                    clicked = "Clicked";
                    changed = True;
                }
                If (kind == "KeyRelease") {
                    app.Backend.OfferInput("Key", LiveField(line, 1));
                }
                If (kind == "Key") {
                    String key = LiveField(line, 1);
                    app.Backend.OfferInput("Key", key);
                    events.KeyIn("heading", "OnKeyDown", key, key);
                    layout.SetText("heading", "Content", key);
                    layout.Relayout("shell", 640, 480);
                    frame.FrameDamage(layout, "heading");
                    keyed = key + "";
                    changed = True;
                }
                If (kind == "Scroll") {
                    app.Backend.OfferInput("Scroll", LiveField(line, 1) + " " + LiveField(line, 2));
                }
                If (kind == "Resize") {
                    Int wide = LiveField(line, 1).ToInt();
                    Int high = LiveField(line, 2).ToInt();
                    If (wide > 0 && high > 0) {
                        frame.FrameResize(layout, "shell", wide, high);
                    }
                }
                If (kind == "Close") {
                    open = False;
                }
                handled = count + 1;
            }
            If (boundary) {
                count = count + 1;
                start = index + 1;
            }
            index = index + 1;
        }
        If (changed) {
            String scene = "size 640 480\n";
            Int sceneIndex = 0;
            While (sceneIndex < layout.CommandCount()) {
                scene = scene + layout.CommandAt(sceneIndex) + "\n";
                sceneIndex = sceneIndex + 1;
            }
            Files.WriteText("Build/rxu/show.list", scene);
        }
        app.PumpApp();
    }
    app.ExitApp(0);
    String note = clicked + "\n" + keyed + "\n" + app.ReadPhase() + "\n" + app.ReadWindowTitle("Arm") + "\n" + events.TraceSize().ToString() + "\n";
    Files.WriteText("Build/rxu/live.txt", note);
    If (app.ReadPhase() != "Exited") {
        Return 1;
    }
    Return 0;
}

Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Show the Arm console example, or run the RXU checks.";
    Input: args = "show prints the example. show live keeps the window open. An empty argument list runs the checks.";
    Processing: "Dispatch on the first argument.";
    Output: "Zero when the selected run passed.";
} {
    If (args.Count() > 0) {
        If (args[0] == "nav") {
            Return CheckNav();
        }
        If (args[0] == "fixture") {
            Mark("start");
            String fixture = Files.ReadText("UI/Fixtures/Window.rxu");
            Mark("read");
            RxuParser parser = RxuParser();
            Mark("parser");
            RxuNode document = parser.Parse("UI/Fixtures/Window.rxu", fixture);
            Mark("parsed");
            Return document.Messages.Count();
        }
        If (args[0] == "show") {
            Int shown = ShowArm();
            If (args.Count() > 1) {
                If (args[1] == "live") {
                    Return shown + ShowLive();
                }
            }
            Return shown;
        }
    }
    Return CheckSamples();
}

