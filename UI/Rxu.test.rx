// Tests for UI/Rxu.rx.

Test RxuMessages.Add {
    Case "records a code" {
        Input: code = "RXU001", message = "mismatch", filename = "Window.rxu", line = 1, column = 2, length = 3, expected = "Window", actual = "Door", correction = "Close the tag.";
        Assert: code == "RXU001";
    }
}

Test RxuMessages.Count {
    Case "empty bag" {
        Input:;
        Output: 0;
    }
}

Test RxuMessages.At {
    Case "missing index" {
        Input: index = 0;
        Assert: Result.Code == "";
    }
}

Test RxuMessages.Find {
    Case "missing code" {
        Input: code = "RXU001";
        Output: -1;
    }
}

Test RxuMessages.FormatAt {
    Case "missing index is blank" {
        Input: index = 0;
        Output: "";
    }
}

Test RxuNode.FindAttribute {
    Case "missing attribute" {
        Input: name = "Text";
        Assert: Result.Name == "";
    }
}

Test RxuNode.FindChild {
    Case "missing child" {
        Input: name = "Button";
        Assert: Result.Name == "";
    }
}

Test RxuNode.FindKind {
    Case "missing kind" {
        Input: kind = "Comment";
        Assert: Result.Kind == "";
    }
}

Test RxuNode.Describe {
    Case "blank node" {
        Input:;
        Assert: Result.Length() >= 0;
    }
}

Test RxuNode.DescribeAt {
    Constraint: True;
    Processing: True;
    Output: True;
}

