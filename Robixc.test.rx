// Tests for Robixc.rx.

Test Main {
    Case "requires source file when arguments are empty" {
        Input: args = [];
        Assert: Result != Null;
        Equal: Result.Message, "A source file is required.";
    }
}

Test RuntimeObject {
    Case "linux carries the Robix runtime" {
        Input: target = "linux-x64";
        Assert: Result == "";
    }
    Case "host fallback" {
        Input: target = "host";
        Assert: Result == "Runtime/Runtime.cpp";
    }
}

Test FinishRun { Output: True; }
Test RunProcess {
    Constraint: True;
    Processing: True;
    Output: True;
}
