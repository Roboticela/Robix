// Tests for Robixc.rx.

Test Main {
    Case "requires source file when arguments are empty" {
        Input: args = [];
        Assert: Result != Null;
        Equal: Result.Message, "A source file is required.";
    }
}

Test RuntimeObject {
    Case "linux carries the Robix runtime" {
        Input: target = "linux-x64";
        Assert: Result == "";
    }
    Case "windows carries the Robix runtime" {
        Input: target = "windows-x64";
        Assert: Result == "";
    }
    Case "host carries the Robix runtime" {
        Input: target = "host";
        Assert: Result == "";
    }
}

Test FinishRun { Output: True; }
