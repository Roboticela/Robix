// Tests for Robixc.rx.

Test Main {
    Case "prints help when arguments are empty" {
        Input: args = [];
        Assert: Result != Null;
        Equal: Result.Message, "Printed Robixc help.";
    }
    Case "rejects a test file" {
        Input: args = ["User.test.rx"];
        Equal: Result.Message, "Test files are run with Robix Test. They are not compilation entries.";
    }
}

Test RuntimeObject {
    Case "linux carries the Robix runtime" {
        Input: target = "linux-x64";
        Assert: Result == "";
    }
    Case "windows carries the Robix runtime" {
        Input: target = "windows-x64";
        Assert: Result == "";
    }
    Case "host carries the Robix runtime" {
        Input: target = "host";
        Assert: Result == "";
    }
}

Test FinishRun { Output: True; }

Test ClassifyRobixc {
    Case "help" {
        Input: args = [];
        Output: "help";
    }
    Case "compile file" {
        Input: args = ["Main.rx"];
        Output: "compile-file";
    }
    Case "reject test" {
        Input: args = ["User.test.rx"];
        Output: "reject-test";
    }
    Case "build project" {
        Input: args = ["Build", "App.rxp"];
        Output: "build";
    }
}

Test CompilerHelp {
    Case "names the build command" {
        Input:;
        Contains: Result, "Robixc Build";
    }
}

Test CompilerVersion {
    Case "short" {
        Input: kind = "short";
        Output: "Robixc 0.0.48";
    }
}

Test TargetName {
    Case "kebab linux" {
        Input: name = "linux-x64";
        Output: "LinuxX64";
    }
    Case "windows" {
        Input: name = "WindowsX64";
        Output: "WindowsX64";
    }
    Case "unknown" {
        Input: name = "nope";
        Output: "";
    }
}

Test AssemblerTarget {
    Case "linux" {
        Input: target = "LinuxX64";
        Output: "linux-x64";
    }
    Case "arm is not encoded" {
        Input: target = "LinuxARM64";
        Output: "";
    }
}

Test PlannedOutput {
    Case "linux default" {
        Input: stem = "Main", target = "LinuxX64", requested = "", mode = "program";
        Output: "Build/Main/LinuxX64/Main";
    }
    Case "windows executable" {
        Input: stem = "Main", target = "WindowsX64", requested = "", mode = "program";
        Output: "Build/Main/WindowsX64/Main.exe";
    }
    Case "requested name gains exe" {
        Input: stem = "Main", target = "WindowsX64", requested = "Out/App", mode = "program";
        Output: "Out/App.exe";
    }
    Case "requested extension stays" {
        Input: stem = "Main", target = "WindowsX64", requested = "Out/App.bin", mode = "program";
        Output: "Out/App.bin";
    }
    Case "assembly" {
        Input: stem = "Main", target = "LinuxX64", requested = "", mode = "asm";
        Output: "Build/Main/LinuxX64/Main.rxasm";
    }
}

Test CacheStatus {
    Case "same hash" {
        Input: saved = "12", current = "12", present = True;
        Output: "Skipped";
    }
    Case "different hash" {
        Input: saved = "12", current = "13", present = False;
        Output: "Compiled";
    }
    Case "replaced output" {
        Input: saved = "12", current = "13", present = True;
        Output: "Recompiled";
    }
}

Test BuildLeaf {
    Case "bin folder" {
        Input: outputPath = "Build/Main/LinuxX64/Main", folderName = "Bin";
        Output: "Build/Main/LinuxX64/Bin/Main";
    }
}

Test DeclarationLines {
    Case "import" {
        Input: source = "Import Robix.Core;\nFunction Main() -> Int { Return 0; }\n", needle = "Import ";
        Output: "Import Robix.Core;\n";
    }
}

Test SourceIgnored {
    Case "build directory" {
        Input: path = "Build/Main.rx", rules = "Build/\n";
        Output: True;
    }
}

Test CountLines {
    Case "two files" {
        Input: text = "A.rx\nB.rx\n";
        Output: 2;
    }
}

Test ListedSources {
    Case "two sources" {
        Input: args = ["A.rx", "B.rx", "--Parallel"];
        Output: "A.rx\nB.rx\n";
    }
}

Test UnitMatch {
    Case "top level" {
        Input: path = "Main.rx", pattern = "*.rx";
        Output: True;
    }
    Case "nested" {
        Input: path = "Compiler/Elf.rx", pattern = "Compiler/**/*.rx";
        Output: True;
    }
    Case "excluded test" {
        Input: path = "Main.test.rx", pattern = "**/*.test.rx";
        Output: True;
    }
    Case "other directory" {
        Input: path = "Main.rx", pattern = "Examples/**";
        Output: False;
    }
}

Test ParallelScript {
    Case "two commands" {
        Input: files = "A.rx\nB.rx\n", target = "LinuxX64", flags = " --SkipTests";
        Output: "A.rx --Target LinuxX64 --SkipTests\nB.rx --Target LinuxX64 --SkipTests\n";
    }
}

Test PackageFile {
    Case "core" {
        Input: packageName = "Robix.Core";
        Output: "Packages/Robix.Core/Core.rx";
    }
}

Test ImportBundle {
    Case "names the file" {
        Input: source = "Import Robix.Core;\n";
        Contains: Result, "Packages/Robix.Core/Core.rx";
    }
}

Test CompileCommand {
    Case "already checked" {
        Input: file = "Main.rx", output = "Build/Compiler/Main.app", check = False;
        Output: "Main.rx --Target LinuxX64 --Output Build/Compiler/Main.app --SkipTests";
    }
    Case "check inside the compile" {
        Input: file = "Main.rx", output = "Build/Compiler/Main.app", check = True;
        Output: "Main.rx --Target LinuxX64 --Output Build/Compiler/Main.app";
    }
}

Test ProjectUnits { Output: True; }
Test CompileTogether { Output: True; }

Test PlaceBuildTree { Output: True; }
Test CacheSummary { Output: True; }
Test ShowToolchain { Output: True; }
Test ShowLink { Output: True; }
Test ShowListing { Output: True; }
Test ShowSymbols { Output: True; }
Test ShowDependencies { Output: True; }
Test ShowExplain { Output: True; }
Test ShowReport { Output: True; }
Test NoteCache { Output: True; }

Test OutputHash {
    Case "two letters" {
        Input: text = "ab";
        Output: "197";
    }
}

Test OutputStem {
    Case "source file" {
        Input: path = "Source/Main.rx";
        Output: "Main";
    }
}

Test ProjectEntry {
    Case "quoted entry" {
        Input: project = "Entry: \"Source/Main.rx\";\n";
        Output: "Source/Main.rx";
    }
}

Test ProjectHeading {
    Case "quoted name" {
        Input: project = "Project \"Demo\"\n";
        Output: "Demo";
    }
}

Test CompilerSource {
    Case "compile verb" {
        Input: args = ["Compile", "Main.rx"];
        Output: "Main.rx";
    }
}

Test CompilerOutput {
    Case "option" {
        Input: args = ["Main.rx", "--Output", "Out/App"];
        Output: "Out/App";
    }
}

Test CompilerOption {
    Case "accepted" {
        Input: args = ["Main.rx", "--Asm"];
        Output: "";
    }
    Case "unknown" {
        Input: args = ["--Nope"];
        Output: "Unknown option --Nope.";
    }
    Case "profile" {
        Input: args = ["--Profile"];
        Output: "";
    }
    Case "analyze" {
        Input: args = ["--Analyze"];
        Output: "";
    }
    Case "parallel" {
        Input: args = ["--Parallel"];
        Output: "";
    }
}

Test OptionText {
    Case "equals form" {
        Input: args = ["--Target=WindowsX64"], flag = "--Target";
        Output: "WindowsX64";
    }
}

Test CompileUnit { Output: True; }
Test CacheFile {
    Case "beside the output" {
        Input: outputPath = "Build/Main/LinuxX64/Main";
        Output: "Build/Main/LinuxX64/Cache/input.hash";
    }
}
Test InfoFile {
    Case "beside the output" {
        Input: outputPath = "Build/Main/LinuxX64/Main";
        Output: "Build/Main/LinuxX64/BuildInfo";
    }
}
Test CompilerProject { Output: True; }
Test CheckSource { Output: True; }
Test EnsureFolder { Output: True; }
