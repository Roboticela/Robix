    Private Function Construct(String name, ClassInfo info, List<String> arguments) -> IrValue {
        Int fields = info.Fields.Count();
        If (fields < 1) { fields = 1; }
        Var created = List<String>();
        created.Add(fields.ToString());
        IrValue value = This.CallRuntime("rx_obj_new", created, False);
        AstNode ctor = AstNode();
        Bool found = False;
        For candidate In info.Constructors {
            If (candidate.Parameters.Count() == arguments.Count()) {
                ctor = candidate;
                found = True;
            }
        }
        If (found) {
            Var args = List<String>();
            args.Add(value.Value);
            For argument In arguments { args.Add(argument); }
            This.CallRuntime("rxm_" + name + "_new", args, True);
        }
        Return This.Pair(value.Value, name);
    }

    Private Function LiteralArgument(AstNode node, Int position) -> String {
        If (position < 0 || position >= node.Parameters.Count()) { Return ""; }
        AstNode argument = node.Parameters[position];
        If (argument.Kind == AstKind.Argument && argument.Left != Null) { argument = argument.Left; }
        If (argument.Kind == AstKind.StringLiteral) { Return argument.Text; }
        Return "";
    }

    Private Function EmitOperatorLibrary(AstNode node, List<String> arguments, List<String> types) -> IrValue {
        String name = node.Left.Name;
        If (name == "Call") {
            String symbol = This.OperatorSymbol("", "", This.LiteralArgument(node, 0));
            Var args = List<String>();
            Int index = 1;
            While (index < arguments.Count()) {
                args.Add(arguments[index]);
                index = index + 1;
            }
            If (symbol == "") { Return This.Pair("0", "Int"); }
            IrValue called = This.CallRuntime(symbol, args, False);
            Return This.Pair(called.Value, This.OperatorType("", "", This.LiteralArgument(node, 0)));
        }
        If (arguments.Count() == 0) { Return This.Pair("0", "Int"); }
        If (name == "Negate") {
            IrValue value = This.Pair(arguments[0], types[0]);
            If (This.IsFloatType(types[0])) {
                String operand = This.Fresh("v");
                This.Emit(operand + " = bitcast i64 " + value.Value + " to double");
                String negated = This.Fresh("v");
                This.Emit(negated + " = fneg double " + operand);
                String bits = This.Fresh("v");
                This.Emit(bits + " = bitcast double " + negated + " to i64");
                Return This.Pair(bits, "Float");
            }
            String result = This.Fresh("v");
            This.Emit(result + " = sub i64 0, " + value.Value);
            Return This.Pair(result, "Int");
        }
        If (arguments.Count() < 2) { Return This.Pair("0", "Int"); }
        IrValue left = This.Pair(arguments[0], types[0]);
        IrValue right = This.Pair(arguments[1], types[1]);
        If (name == "Add") {
            String symbol = This.OperatorSymbol(types[0], types[1], "+");
            If (symbol != "") {
                Var args = List<String>();
                args.Add(left.Value);
                args.Add(right.Value);
                IrValue called = This.CallRuntime(symbol, args, False);
                Return This.Pair(called.Value, This.OperatorType(types[0], types[1], "+"));
            }
            If (This.IsFloatType(types[0]) || This.IsFloatType(types[1])) { Return This.EmitFloatBinary("+", left, right); }
            String result = This.Fresh("v");
            This.Emit(result + " = add i64 " + left.Value + ", " + right.Value);
            Return This.Pair(result, "Int");
        }
        If (name == "Equal") {
            String symbol = This.OperatorSymbol(types[0], types[1], "==");
            If (symbol != "") {
                Var args = List<String>();
                args.Add(left.Value);
                args.Add(right.Value);
                IrValue called = This.CallRuntime(symbol, args, False);
                Return This.Pair(called.Value, "Bool");
            }
            If (This.IsFloatType(types[0]) || This.IsFloatType(types[1])) { Return This.EmitFloatBinary("==", left, right); }
            String flag = This.Fresh("v");
            This.Emit(flag + " = icmp eq i64 " + left.Value + ", " + right.Value);
            String result = This.Fresh("v");
            This.Emit(result + " = zext i1 " + flag + " to i64");
            Return This.Pair(result, "Bool");
        }
        If (name == "GreaterThan") {
            If (This.IsFloatType(types[0]) || This.IsFloatType(types[1])) { Return This.EmitFloatBinary(">", left, right); }
            String flag = This.Fresh("v");
            This.Emit(flag + " = icmp sgt i64 " + left.Value + ", " + right.Value);
            String result = This.Fresh("v");
            This.Emit(result + " = zext i1 " + flag + " to i64");
            Return This.Pair(result, "Bool");
        }
        If (name == "And") {
            String leftFlag = This.Fresh("v");
            String rightFlag = This.Fresh("v");
            String both = This.Fresh("v");
            String result = This.Fresh("v");
            This.Emit(leftFlag + " = icmp ne i64 " + left.Value + ", 0");
            This.Emit(rightFlag + " = icmp ne i64 " + right.Value + ", 0");
            This.Emit(both + " = and i1 " + leftFlag + ", " + rightFlag);
            This.Emit(result + " = zext i1 " + both + " to i64");
            Return This.Pair(result, "Bool");
        }
        Return This.Pair("0", "Int");
    }

    Private Function EmitMethodCall(AstNode member, List<String> arguments, List<String> types) -> IrValue {
        If (member.Left != Null && member.Left.Kind == AstKind.Name && This.Lookup(member.Left.Name).Value == "") {
            IrValue staticCall = This.EmitStaticCall(member.Left.Name, member.Name, arguments, types);
            If (staticCall.TypeName != "Missing") { Return staticCall; }
        }
        If (member.Left != Null && member.Left.Kind == AstKind.Member && member.Left.Left != Null && member.Left.Left.Kind == AstKind.Name && member.Left.Left.Name == "Robix") {
            IrValue staticCall = This.EmitStaticCall(member.Left.Name, member.Name, arguments, types);
            If (staticCall.TypeName != "Missing") { Return staticCall; }
        }
        IrValue receiver = This.EmitExpr(member.Left);
        If ((member.Name == "As" || member.Name == "AsOptional" || member.Name == "Cast") && member.Children.Count() > 0) {
            String targetType = This.TypeName(member.Children[0]);
            String val = receiver.Value;
            If (This.IsAnyType(receiver.TypeName)) {
                val = This.LoadObjectField(receiver.Value, "1");
            }
            If (member.Name == "AsOptional") { targetType = targetType + "?"; }
            Return This.Pair(val, targetType);
        }
        If (This.IsAnyType(receiver.TypeName)) { Return This.AnyCall(member.Name, receiver.Value); }
        If (member.Name == "ToInt") {
            If (This.IsString(receiver.TypeName)) { Return This.StringMethod(member.Name, receiver.Value, arguments); }
            If (This.IsFloatType(receiver.TypeName)) {
                Var args = List<String>();
                args.Add(receiver.Value);
                IrValue value = This.CallRuntime("rx_F64ToInt", args, False);
                Return This.Pair(value.Value, "Int");
            }
            Return This.Pair(receiver.Value, "Int");
        }
        If (member.Name == "ToFloat") {
            If (This.IsString(receiver.TypeName)) { Return This.StringMethod(member.Name, receiver.Value, arguments); }
            If (This.IsFloatType(receiver.TypeName)) { Return receiver; }
            Var args = List<String>();
            args.Add(receiver.Value);
            IrValue value = This.CallRuntime("rx_F64FromInt", args, False);
            Return This.Pair(value.Value, "Float");
        }
        If (member.Name == "ToString") { Return This.ToStringValue(receiver.Value, receiver.TypeName); }
        If (This.IsString(receiver.TypeName) && This.IsStringMethod(member.Name)) {
            Return This.StringMethod(member.Name, receiver.Value, arguments);
        }
        If (This.IsList(receiver.TypeName) && This.IsListMethod(member.Name)) {
            Return This.ListMethod(member.Name, receiver.Value, receiver.TypeName, arguments);
        }
        ClassInfo info = This.FindClass(receiver.TypeName);
        MethodInfo method = This.FindMethod(info, member.Name);
        If (method.Name != "") {
            String symbol = "rxm_" + receiver.TypeName + "_" + member.Name;
            Var args = List<String>();
            args.Add(receiver.Value);
            For argument In arguments { args.Add(argument); }
            If (This.IsVoid(method.ReturnType)) {
                This.CallRuntime(symbol, args, True);
                Return This.Pair("0", "Void");
            }
            IrValue value = This.CallRuntime(symbol, args, False);
            String ret = method.ReturnType;
            If (ret == "") { ret = "Int"; }
            Return This.Pair(value.Value, ret);
        }
        If (receiver.TypeName.StartsWith("Queue<") || receiver.TypeName.StartsWith("Stack<")) {
            Return This.SequenceCall(member.Name, receiver.Value, receiver.TypeName, arguments);
        }
        If (member.Name == "Value" && (receiver.TypeName.StartsWith("Option<") || receiver.TypeName.StartsWith("Result<"))) {
            String loaded = This.LoadListItem(receiver.Value, "0");
            Return This.Pair(loaded, This.WrappedType(receiver.TypeName));
        }
        If (member.Name == "Contains") {
            String kind = "0";
            String probe = "0";
            String probeType = "Int";
            If (types.Count() > 0 && types[0] != "") { probeType = types[0]; }
            If (arguments.Count() > 0) { probe = arguments[0]; }
            If (This.ElementType(receiver.TypeName) == "String") { kind = "1"; }
            If (This.ElementType(receiver.TypeName) == "Any") {
                kind = "2";
                IrValue boxed = This.BoxAny(This.Pair(probe, probeType));
                probe = boxed.Value;
            }
            Var args = List<String>();
            args.Add(receiver.Value);
            args.Add(probe);
            args.Add(kind);
            IrValue value = This.CallRuntime("rx_set_has", args, False);
            Return This.Pair(value.Value, "Bool");
        }
        If (member.Name == "Count") {
            Var args = List<String>();
            args.Add(receiver.Value);
            IrValue value = This.CallRuntime("rx_list_count", args, False);
            Return This.Pair(value.Value, "Int");
        }
        If (member.Name == "Add") {
            Var args = List<String>();
            args.Add(receiver.Value);
            If (arguments.Count() > 0) { args.Add(arguments[0]); }
            If (arguments.Count() == 0) { args.Add("0"); }
            This.CallRuntime("rx_list_add", args, True);
            Return This.Pair("0", "Void");
        }
        If (member.Name == "Length") {
            Var args = List<String>();
            args.Add(receiver.Value);
            IrValue value = This.CallRuntime("rx_str_len", args, False);
            Return This.Pair(value.Value, "Int");
        }
        If (member.Name == "Enumerate") {
            Return This.Pair(receiver.Value, "Enumerate<" + This.ElementType(receiver.TypeName) + ">");
        }
        If (member.Name == "Sort") {
            Var args = List<String>();
            args.Add(receiver.Value);
            This.CallRuntime("rx_list_sort", args, True);
            Return This.Pair("0", "Void");
        }
        If (member.Name == "Reverse") {
            Var args = List<String>();
            args.Add(receiver.Value);
            This.CallRuntime("rx_list_reverse", args, True);
            Return This.Pair("0", "Void");
        }
        If (member.Name == "Map" && types.Count() > 0 && types[0].StartsWith("Lambda:")) {
            String lambdaName = types[0].Substring(7);
            String fnSym = This.FunctionSymbol(This.FileName, lambdaName);
            IrValue outList = This.CallRuntime("rx_list_new", List<String>(), False);
            String total = This.LoadListCount(receiver.Value);
            String idxSlot = "#map_" + This.Label("m");
            This.Alloca(idxSlot, "Int", "0");
            String head = This.Label("map_head");
            String body = This.Label("map_body");
            String done = This.Label("map_done");
            This.Branch(head);
            This.Block(head);
            String cur = This.LoadName(idxSlot);
            String flag = This.Fresh("cond");
            This.Emit(flag + " = icmp slt i64 " + cur + ", " + total);
            This.Emit("br i1 " + flag + ", label %" + body + ", label %" + done);
            This.Terminated = True;
            This.Block(body);
            String item = This.LoadListItem(receiver.Value, cur);
            Var callArgs = List<String>();
            callArgs.Add(item);
            IrValue mapped = This.CallRuntime(fnSym, callArgs, False);
            Var addArgs = List<String>();
            addArgs.Add(outList.Value);
            addArgs.Add(mapped.Value);
            This.CallRuntime("rx_list_add", addArgs, True);
            String next = This.Fresh("v");
            This.Emit(next + " = add i64 " + cur + ", 1");
            This.StoreName(idxSlot, next);
            This.Branch(head);
            This.Block(done);
            Return This.Pair(outList.Value, "Array<Int>");
        }
        If (member.Name == "Filter" && types.Count() > 0 && types[0].StartsWith("Lambda:")) {
            String lambdaName = types[0].Substring(7);
            String fnSym = This.FunctionSymbol(This.FileName, lambdaName);
            IrValue outList = This.CallRuntime("rx_list_new", List<String>(), False);
            String total = This.LoadListCount(receiver.Value);
            String idxSlot = "#flt_" + This.Label("f");
            This.Alloca(idxSlot, "Int", "0");
            String head = This.Label("flt_head");
            String body = This.Label("flt_body");
            String keep = This.Label("flt_keep");
            String step = This.Label("flt_step");
            String done = This.Label("flt_done");
            This.Branch(head);
            This.Block(head);
            String cur = This.LoadName(idxSlot);
            String flag = This.Fresh("cond");
            This.Emit(flag + " = icmp slt i64 " + cur + ", " + total);
            This.Emit("br i1 " + flag + ", label %" + body + ", label %" + done);
            This.Terminated = True;
            This.Block(body);
            String item = This.LoadListItem(receiver.Value, cur);
            Var callArgs = List<String>();
            callArgs.Add(item);
            IrValue pred = This.CallRuntime(fnSym, callArgs, False);
            String keepFlag = This.Fresh("cond");
            This.Emit(keepFlag + " = icmp ne i64 " + pred.Value + ", 0");
            This.Emit("br i1 " + keepFlag + ", label %" + keep + ", label %" + step);
            This.Terminated = True;
            This.Block(keep);
            Var addArgs = List<String>();
            addArgs.Add(outList.Value);
            addArgs.Add(item);
            This.CallRuntime("rx_list_add", addArgs, True);
            This.Branch(step);
            This.Block(step);
            String next = This.Fresh("v");
            This.Emit(next + " = add i64 " + cur + ", 1");
            This.StoreName(idxSlot, next);
            This.Branch(head);
            This.Block(done);
            Return This.Pair(outList.Value, receiver.TypeName);
        }
        If (member.Name == "Reduce" && arguments.Count() >= 2 && types.Count() >= 2 && types[1].StartsWith("Lambda:")) {
            String lambdaName = types[1].Substring(7);
            String fnSym = This.FunctionSymbol(This.FileName, lambdaName);
            String accSlot = "#red_acc_" + This.Label("ra");
            This.Alloca(accSlot, "Int", arguments[0]);
            String total = This.LoadListCount(receiver.Value);
            String idxSlot = "#red_idx_" + This.Label("ri");
            This.Alloca(idxSlot, "Int", "0");
            String head = This.Label("red_head");
            String body = This.Label("red_body");
            String done = This.Label("red_done");
            This.Branch(head);
            This.Block(head);
            String cur = This.LoadName(idxSlot);
            String flag = This.Fresh("cond");
            This.Emit(flag + " = icmp slt i64 " + cur + ", " + total);
            This.Emit("br i1 " + flag + ", label %" + body + ", label %" + done);
            This.Terminated = True;
            This.Block(body);
            String item = This.LoadListItem(receiver.Value, cur);
            String curAcc = This.LoadName(accSlot);
            Var callArgs = List<String>();
            callArgs.Add(curAcc);
            callArgs.Add(item);
            IrValue nextAcc = This.CallRuntime(fnSym, callArgs, False);
            This.StoreName(accSlot, nextAcc.Value);
            String next = This.Fresh("v");
            This.Emit(next + " = add i64 " + cur + ", 1");
            This.StoreName(idxSlot, next);
            This.Branch(head);
            This.Block(done);
            String finalAcc = This.LoadName(accSlot);
            Return This.Pair(finalAcc, "Int");
        }
        Return This.Pair("0", "Int");
    }

    Private Function EmitStaticCall(String owner, String method, List<String> arguments, List<String> types) -> IrValue {
        If ((owner == "RoboString" || owner == "String") && (method == "FormatInt" || method == "Digit")) {
            Var args = List<String>();
            If (arguments.Count() > 0) { args.Add(arguments[0]); } Else { args.Add("0"); }
            IrValue value = This.CallRuntime("rx_str_from_int", args, False);
            Return This.Pair(value.Value, "String");
        }
        If (owner == "String" && method == "From") {
            String valueType = "Int";
            If (types.Count() > 0) { valueType = types[0]; }
            String value = "0";
            If (arguments.Count() > 0) { value = arguments[0]; }
            Return This.ToStringValue(value, valueType);
        }
        If (owner == "String" && method == "FromChars") {
            Var args = List<String>();
            If (arguments.Count() > 0) { args.Add(arguments[0]); }
            If (arguments.Count() == 0) { args.Add("0"); }
            IrValue value = This.CallRuntime("rx_str_from_chars", args, False);
            Return This.Pair(value.Value, "String");
        }
        If (owner == "Char" && method == "From") {
            If (arguments.Count() > 0) { Return This.Pair(arguments[0], "Char"); }
            Return This.Pair("0", "Char");
        }
        If (owner == "Byte" && method == "From") {
            String value = "0";
            If (arguments.Count() > 0) { value = arguments[0]; }
            String result = This.Fresh("v");
            This.Emit(result + " = and i64 " + value + ", 255");
            Return This.Pair(result, "Int");
        }
        If (owner == "ExitCode" && method == "Custom") {
            If (arguments.Count() > 0) { Return This.Pair(arguments[0], "Int"); }
            Return This.Pair("0", "Int");
        }
        If (owner == "Math") {
            If (method == "Min" && arguments.Count() >= 2) {
                String flag = This.Fresh("v");
                This.Emit(flag + " = icmp sle i64 " + arguments[0] + ", " + arguments[1]);
                String res = This.Fresh("v");
                This.Emit(res + " = select i1 " + flag + ", i64 " + arguments[0] + ", i64 " + arguments[1]);
                Return This.Pair(res, "Int");
            }
            If (method == "Max" && arguments.Count() >= 2) {
                String flag = This.Fresh("v");
                This.Emit(flag + " = icmp sge i64 " + arguments[0] + ", " + arguments[1]);
                String res = This.Fresh("v");
                This.Emit(res + " = select i1 " + flag + ", i64 " + arguments[0] + ", i64 " + arguments[1]);
                Return This.Pair(res, "Int");
            }
            If (method == "Abs" && arguments.Count() >= 1) {
                String neg = This.Fresh("v");
                This.Emit(neg + " = sub i64 0, " + arguments[0]);
                String flag = This.Fresh("v");
                This.Emit(flag + " = icmp slt i64 " + arguments[0] + ", 0");
                String res = This.Fresh("v");
                This.Emit(res + " = select i1 " + flag + ", i64 " + neg + ", i64 " + arguments[0]);
                Return This.Pair(res, "Int");
            }
            If (method == "Clamp" && arguments.Count() >= 3) {
                String lowFlag = This.Fresh("v");
                This.Emit(lowFlag + " = icmp slt i64 " + arguments[0] + ", " + arguments[1]);
                String lowClamp = This.Fresh("v");
                This.Emit(lowClamp + " = select i1 " + lowFlag + ", i64 " + arguments[1] + ", i64 " + arguments[0]);
                String highFlag = This.Fresh("v");
                This.Emit(highFlag + " = icmp sgt i64 " + lowClamp + ", " + arguments[2]);
                String res = This.Fresh("v");
                This.Emit(res + " = select i1 " + highFlag + ", i64 " + arguments[2] + ", i64 " + lowClamp);
                Return This.Pair(res, "Int");
            }
            If (method == "Gcd" && arguments.Count() >= 2) {
                Var args = List<String>();
                args.Add(arguments[0]);
                args.Add(arguments[1]);
                IrValue value = This.CallRuntime("rx_math_gcd", args, False);
                Return This.Pair(value.Value, "Int");
            }
            If (method == "IntegerSquareRoot" && arguments.Count() >= 1) {
                Var args = List<String>();
                args.Add(arguments[0]);
                IrValue value = This.CallRuntime("rx_math_isqrt", args, False);
                Return This.Pair(value.Value, "Int");
            }
        }
        If (owner == "Files") { Return This.FilesCall(method, arguments); }
        If (owner == "Directory") { Return This.DirectoryCall(method, arguments); }
        If (owner == "Environment" && method == "Get") {
            Var args = List<String>();
            If (arguments.Count() > 0) { args.Add(arguments[0]); }
            If (arguments.Count() == 0) { args.Add("0"); }
            IrValue value = This.CallRuntime("rx_env_get", args, False);
            Return This.Pair(value.Value, "String");
        }
        ClassInfo enumInfo = This.FindClass(owner);
        If (enumInfo.Name != "" && enumInfo.KindName == "Enum") {
            Return This.EmitEnumCall(enumInfo, method, arguments);
        }
        If (owner == "Process" && method == "Run") {
            Var args = List<String>();
            If (arguments.Count() > 0) { args.Add(arguments[0]); }
            If (arguments.Count() == 0) { args.Add("0"); }
            IrValue value = This.CallRuntime("rx_process", args, False);
            Return This.Pair(value.Value, "Int");
        }
        Return This.Pair("0", "Missing");
    }

    Private Function FilesCall(String method, List<String> arguments) -> IrValue {
        Var args = List<String>();
        If (method == "ReadText" || method == "Exists" || method == "Delete" || method == "Name") {
            If (arguments.Count() > 0) { args.Add(arguments[0]); }
            If (arguments.Count() == 0) { args.Add("0"); }
        } Else {
            If (arguments.Count() > 0) { args.Add(arguments[0]); }
            If (arguments.Count() < 1) { args.Add("0"); }
            If (arguments.Count() > 1) { args.Add(arguments[1]); }
            If (arguments.Count() < 2) { args.Add("0"); }
        }
        If (method == "ReadText") {
            IrValue value = This.CallRuntime("rx_file_read", args, False);
            Return This.Pair(value.Value, "String");
        }
        If (method == "WriteText") {
            This.CallRuntime("rx_file_write_text", args, True);
            Return This.Pair("0", "Void");
        }
        If (method == "WriteBytes") {
            This.CallRuntime("rx_file_write_bytes", args, True);
            Return This.Pair("0", "Void");
        }
        If (method == "Exists") {
            IrValue value = This.CallRuntime("rx_file_exists", args, False);
            Return This.Pair(value.Value, "Bool");
        }
        If (method == "Delete") {
            This.CallRuntime("rx_file_delete", args, True);
            Return This.Pair("0", "Void");
        }
        If (method == "Name") {
            IrValue value = This.CallRuntime("rx_file_name", args, False);
            Return This.Pair(value.Value, "String");
        }
        If (method == "Join") {
            IrValue value = This.CallRuntime("rx_file_join", args, False);
            Return This.Pair(value.Value, "String");
        }
        Return This.Pair("0", "Void");
    }

    Private Function DirectoryCall(String method, List<String> arguments) -> IrValue {
        Var args = List<String>();
        If (arguments.Count() > 0) { args.Add(arguments[0]); }
        If (arguments.Count() == 0) { args.Add("0"); }
        If (method == "Create") {
            This.CallRuntime("rx_dir_create", args, True);
            Return This.Pair("0", "Void");
        }
        If (method == "Delete") {
            This.CallRuntime("rx_dir_delete", args, True);
            Return This.Pair("0", "Void");
        }
        If (method == "Exists") {
            IrValue value = This.CallRuntime("rx_dir_exists", args, False);
            Return This.Pair(value.Value, "Bool");
        }
        If (method == "Files") {
            IrValue value = This.CallRuntime("rx_dir_files", args, False);
            Return This.Pair(value.Value, "List:String");
        }
        Return This.Pair("0", "Void");
    }

    Private Function ToStringValue(String value, String valueType) -> IrValue {
        If (This.IsString(valueType)) { Return This.Pair(value, "String"); }
        Var args = List<String>();
        args.Add(value);
        If (valueType == "Bool") {
            IrValue result = This.CallRuntime("rx_str_from_bool", args, False);
            Return This.Pair(result.Value, "String");
        }
        If (valueType == "Char") {
            IrValue result = This.CallRuntime("rx_str_from_char", args, False);
            Return This.Pair(result.Value, "String");
        }
        If (This.IsFloatType(valueType)) {
            IrValue result = This.CallRuntime("rx_F64Text", args, False);
            Return This.Pair(result.Value, "String");
        }
        IrValue result = This.CallRuntime("rx_str_from_int", args, False);
        Return This.Pair(result.Value, "String");
    }

    Private Function StringMethod(String method, String receiver, List<String> arguments) -> IrValue {
        Var args = List<String>();
        args.Add(receiver);
        If (method == "Length") {
            IrValue value = This.CallRuntime("rx_str_len", args, False);
            Return This.Pair(value.Value, "Int");
        }
        If (method == "ToLower") {
            IrValue value = This.CallRuntime("rx_str_lower", args, False);
            Return This.Pair(value.Value, "String");
        }
        If (method == "ToUpper") {
            IrValue value = This.CallRuntime("rx_str_upper", args, False);
            Return This.Pair(value.Value, "String");
        }
        If (method == "Trim") {
            IrValue value = This.CallRuntime("rx_str_trim", args, False);
            Return This.Pair(value.Value, "String");
        }
        If (arguments.Count() > 0) { args.Add(arguments[0]); }
        If (method == "Split") {
            IrValue value = This.CallRuntime("rx_str_split", args, False);
            Return This.Pair(value.Value, "Array<String>");
        }
        If (method == "StartsWith") {
            IrValue value = This.CallRuntime("rx_str_starts", args, False);
            Return This.Pair(value.Value, "Bool");
        }
        If (method == "EndsWith") {
            IrValue value = This.CallRuntime("rx_str_ends", args, False);
            Return This.Pair(value.Value, "Bool");
        }
        If (method == "Contains") {
            IrValue value = This.CallRuntime("rx_str_contains", args, False);
            Return This.Pair(value.Value, "Bool");
        }
        If (method == "IndexOf") {
            If (arguments.Count() > 1) { args.Add(arguments[1]); }
            If (arguments.Count() <= 1) { args.Add("0"); }
            IrValue value = This.CallRuntime("rx_str_index", args, False);
            Return This.Pair(value.Value, "Int");
        }
        If (method == "LastIndexOf") {
            If (arguments.Count() > 1) { args.Add(arguments[1]); }
            If (arguments.Count() <= 1) { args.Add("-1"); }
            IrValue value = This.CallRuntime("rx_str_rindex", args, False);
            Return This.Pair(value.Value, "Int");
        }
        If (method == "GetChar") {
            IrValue value = This.CallRuntime("rx_str_get", args, False);
            Return This.Pair(value.Value, "Char");
        }
        If (method == "ToInt") {
            Var intArgs = List<String>();
            intArgs.Add(receiver);
            IrValue value = This.CallRuntime("rx_str_to_int", intArgs, False);
            Return This.Pair(value.Value, "Int");
        }
        If (method == "ToFloat") {
            Var floatArgs = List<String>();
            floatArgs.Add(receiver);
            IrValue value = This.CallRuntime("rx_F64Parse", floatArgs, False);
            Return This.Pair(value.Value, "Float");
        }
        If (method == "ToString") { Return This.Pair(receiver, "String"); }
        If (method == "Replace") {
            If (arguments.Count() > 1) { args.Add(arguments[1]); }
            IrValue value = This.CallRuntime("rx_str_replace", args, False);
            Return This.Pair(value.Value, "String");
        }
        If (method == "Substring") {
            String start = "0";
            If (arguments.Count() > 0) { start = arguments[0]; }
            String length = "0";
            If (arguments.Count() > 1) {
                length = arguments[1];
            } Else {
                Var lenArgs = List<String>();
                lenArgs.Add(receiver);
                IrValue total = This.CallRuntime("rx_str_len", lenArgs, False);
                length = This.Fresh("v");
                This.Emit(length + " = sub i64 " + total.Value + ", " + start);
            }
            Var subArgs = List<String>();
            subArgs.Add(receiver);
            subArgs.Add(start);
            subArgs.Add(length);
            IrValue value = This.CallRuntime("rx_str_substr", subArgs, False);
            Return This.Pair(value.Value, "String");
        }
        Return This.Pair("0", "Int");
    }

    Private Function ListMethod(String method, String receiver, String receiverType, List<String> arguments) -> IrValue {
        If (method == "Add") {
            Var args = List<String>();
            args.Add(receiver);
            If (arguments.Count() > 0) { args.Add(arguments[0]); }
            If (arguments.Count() == 0) { args.Add("0"); }
            This.CallRuntime("rx_list_add", args, True);
            Return This.Pair("0", "Void");
        }
        If (method == "Count") {
            String value = This.LoadListCount(receiver);
            Return This.Pair(value, "Int");
        }
        If (method == "ToArray") { Return This.Pair(receiver, receiverType); }
        Return This.Pair("0", "Int");
    }

    Private Function EmitBinary(AstNode node) -> IrValue {
        If (node.Operator == "&&" || node.Operator == "And") { Return This.ShortCircuit(node, False); }
        If (node.Operator == "||" || node.Operator == "Or") { Return This.ShortCircuit(node, True); }
        If (node.Operator == "??") { Return This.EmitCoalesce(node); }
        IrValue left = This.EmitExpr(node.Left);
        IrValue right = This.EmitExpr(node.Right);
        String overload = This.OperatorSymbol(left.TypeName, right.TypeName, node.Operator);
        If (overload != "") {
            Var args = List<String>();
            args.Add(left.Value);
            args.Add(right.Value);
            IrValue called = This.CallRuntime(overload, args, False);
            Return This.Pair(called.Value, This.OperatorType(left.TypeName, right.TypeName, node.Operator));
        }
        If (This.IsFloatType(left.TypeName) || This.IsFloatType(right.TypeName)) {
            Return This.EmitFloatBinary(node.Operator, left, right);
        }
        If (node.Operator == "+") {
            If (This.IsString(left.TypeName) || This.IsString(right.TypeName)) {
                String leftValue = left.Value;
                String rightValue = right.Value;
                If (!This.IsString(left.TypeName)) {
                    IrValue converted = This.ToStringValue(left.Value, left.TypeName);
                    leftValue = converted.Value;
                }
                If (!This.IsString(right.TypeName)) {
                    IrValue converted = This.ToStringValue(right.Value, right.TypeName);
                    rightValue = converted.Value;
                }
                Var args = List<String>();
                args.Add(leftValue);
                args.Add(rightValue);
                IrValue value = This.CallRuntime("rx_str_concat", args, False);
                Return This.Pair(value.Value, "String");
            }
            String result = This.Fresh("v");
            This.Emit(result + " = add i64 " + left.Value + ", " + right.Value);
            Return This.Pair(result, "Int");
        }
        If (node.Operator == "-") {
            String result = This.Fresh("v");
            This.Emit(result + " = sub i64 " + left.Value + ", " + right.Value);
            Return This.Pair(result, "Int");
        }
        If (node.Operator == "*") {
            String result = This.Fresh("v");
            This.Emit(result + " = mul i64 " + left.Value + ", " + right.Value);
            Return This.Pair(result, "Int");
        }
        If (node.Operator == "/") {
            String result = This.Fresh("v");
            This.Emit(result + " = sdiv i64 " + left.Value + ", " + right.Value);
            Return This.Pair(result, "Int");
        }
        If (node.Operator == "%") {
            String result = This.Fresh("v");
            This.Emit(result + " = srem i64 " + left.Value + ", " + right.Value);
            Return This.Pair(result, "Int");
        }
        If (node.Operator == "<<" || node.Operator == ">>" || node.Operator == "&" || node.Operator == "|" || node.Operator == "^") {
            String opcode = "and";
            If (node.Operator == "<<") { opcode = "shl"; }
            If (node.Operator == ">>") { opcode = "ashr"; }
            If (node.Operator == "|") { opcode = "or"; }
            If (node.Operator == "^") { opcode = "xor"; }
            String result = This.Fresh("v");
            This.Emit(result + " = " + opcode + " i64 " + left.Value + ", " + right.Value);
            Return This.Pair(result, "Int");
        }
        If (node.Operator == "==" || node.Operator == "!=" || node.Operator == "Equal") {
            If (This.IsString(left.TypeName) || This.IsString(right.TypeName)) {
                Var args = List<String>();
                args.Add(left.Value);
                args.Add(right.Value);
                IrValue value = This.CallRuntime("rx_str_eq", args, False);
                If (node.Operator == "!=") {
                    String result = This.Fresh("v");
                    This.Emit(result + " = xor i64 " + value.Value + ", 1");
                    Return This.Pair(result, "Bool");
                }
                Return This.Pair(value.Value, "Bool");
            }
            String predicate = "eq";
            If (node.Operator == "!=") { predicate = "ne"; }
            String flag = This.Fresh("v");
            This.Emit(flag + " = icmp " + predicate + " i64 " + left.Value + ", " + right.Value);
            String result = This.Fresh("v");
            This.Emit(result + " = zext i1 " + flag + " to i64");
            Return This.Pair(result, "Bool");
        }
        String predicate = "slt";
        If (node.Operator == ">") { predicate = "sgt"; }
        If (node.Operator == "<=") { predicate = "sle"; }
        If (node.Operator == ">=") { predicate = "sge"; }
        String flag = This.Fresh("v");
        This.Emit(flag + " = icmp " + predicate + " i64 " + left.Value + ", " + right.Value);
        String result = This.Fresh("v");
        This.Emit(result + " = zext i1 " + flag + " to i64");
        Return This.Pair(result, "Bool");
    }

    Private Function ShortCircuit(AstNode node, Bool isOr) -> IrValue {
        IrValue left = This.EmitExpr(node.Left);
        String rightLabel = This.Label("rhs");
        String mergeLabel = This.Label("logic");
        String resultSlot = This.Fresh("logic");
        This.Emit(resultSlot + " = alloca i64");
        String flag = This.Fresh("cond");
        This.Emit(flag + " = icmp ne i64 " + left.Value + ", 0");
        If (isOr) {
            This.Emit("store i64 1, ptr " + resultSlot);
            This.Emit("br i1 " + flag + ", label %" + mergeLabel + ", label %" + rightLabel);
        } Else {
            This.Emit("store i64 0, ptr " + resultSlot);
            This.Emit("br i1 " + flag + ", label %" + rightLabel + ", label %" + mergeLabel);
        }
        This.Terminated = True;
        This.Block(rightLabel);
        IrValue right = This.EmitExpr(node.Right);
        String rightFlag = This.Fresh("cond");
        This.Emit(rightFlag + " = icmp ne i64 " + right.Value + ", 0");
        String rightValue = This.Fresh("v");
        This.Emit(rightValue + " = zext i1 " + rightFlag + " to i64");
        This.Emit("store i64 " + rightValue + ", ptr " + resultSlot);
        This.Branch(mergeLabel);
        This.Block(mergeLabel);
        Return This.Pair(This.LoadSlot(resultSlot), "Bool");
    }

    Private Function JoinFunction() -> String {
        This.Serial = This.Serial + 1;
        String serial = This.Serial.ToString();
        String globals = "";
        Int index = 0;
        For text In This.Strings {
            index = index + 1;
            EscapeText escaped = This.Escape(text);
            Int length = escaped.Bytes + 1;
            globals = globals + "@.str." + serial + "." + index.ToString() + " = private unnamed_addr constant [" + length.ToString() + " x i8] c\"" + escaped.Text + "\\00\"\n";
        }
        String body = "";
        For line In This.Lines { body = body + line + "\n"; }
        Int replaceIndex = This.Strings.Count();
        While (replaceIndex > 0) {
            body = body.Replace("@str" + replaceIndex.ToString(), "@.str." + serial + "." + replaceIndex.ToString());
            replaceIndex = replaceIndex - 1;
        }
        Return globals + body + "\n";
    }

    Private Function SetField(String object, String index, String value) -> Void {
        This.StoreObjectField(object, index, value);
    }

    Private Function PushLoop(String cont, String brk) -> Void {
        If (This.LoopCount < This.LoopContinue.Count()) {
            This.LoopContinue[This.LoopCount] = cont;
            This.LoopBreak[This.LoopCount] = brk;
        } Else {
            This.LoopContinue.Add(cont);
            This.LoopBreak.Add(brk);
        }
        This.LoopCount = This.LoopCount + 1;
    }

    Private Function PopLoop() -> Void {
        This.LoopCount = This.LoopCount - 1;
    }

    Private Function IsDefined(String symbol) -> Bool {
        For name In This.Defined {
            If (name == symbol) { Return True; }
        }
        Return False;
    }

    Private Function AddDefined(String symbol) -> Void {
        This.Defined.Add(symbol);
    }

    Private Function FindMethod(ClassInfo info, String name) -> MethodInfo {
        For method In info.Methods {
            If (method.Name == name) { Return method; }
        }
        Return MethodInfo();
    }

    Private Function FieldSlot(ClassInfo info, String name) -> Int {
        Int index = 0;
        For field In info.Fields {
            If (field == name) { Return index; }
            index = index + 1;
        }
        Return -1;
    }

    Private Function FieldType(ClassInfo info, String name) -> String {
        Int index = 0;
        For field In info.Fields {
            If (field == name) { Return info.FieldTypes[index]; }
            index = index + 1;
        }
        Return "Int";
    }

    Private Function EnumValue(ClassInfo info, String name) -> Int {
        Int index = 0;
        For item In info.EnumNames {
            If (item == name) { Return info.EnumValues[index]; }
            index = index + 1;
        }
        Return -1;
    }

    Private Function Pair(String value, String typeName) -> IrValue {
        IrValue item = IrValue();
        item.Value = value;
        item.TypeName = typeName;
        Return item;
    }

    Private Function TypeName(AstNode? node) -> String {
        If (node == Null) { Return ""; }
        String name = node.Name;
        If (name == "Args") { Return "List:String"; }
        If (name == "List") {
            String element = "Int";
            If (node.Children.Count() > 0) {
                element = This.TypeName(node.Children[0]);
                If (element == "") { element = "Int"; }
            }
            Return "List:" + element;
        }
        If (name == "Array" || name == "Set" || name == "Map" || name == "Queue" || name == "Stack" || name == "Option" || name == "Result" || name == "Enumerate") {
            String text = name + "<";
            Bool first = True;
            For child In node.Children {
                If (!first) { text = text + ", "; }
                String argument = This.TypeName(child);
                If (argument == "") { argument = "Int"; }
                text = text + argument;
                first = False;
            }
            If (first) { text = text + "Int"; }
            text = text + ">";
            If (node.FlagA) { text = text + "?"; }
            Return text;
        }
        If (name == "()") {
            String text = "(";
            Bool first = True;
            For child In node.Children {
                If (!first) { text = text + ", "; }
                text = text + This.TypeName(child);
                first = False;
            }
            Return text + ")";
        }
        If (name == "{}") {
            String text = "{";
            Bool first = True;
            For child In node.Children {
                If (!first) { text = text + ", "; }
                text = text + child.Name + ": " + This.TypeName(child.Type);
                first = False;
            }
            Return text + "}";
        }
        If (name == "[]") {
            String element = "Int";
            If (node.Children.Count() > 0) { element = This.TypeName(node.Children[0]); }
            If (node.FlagC && node.Right != Null) { Return "[" + element + "; " + node.Right.Text + "]"; }
            Return "[" + element + "]";
        }
        String resolved = This.ResolveAlias(name);
        If (node.FlagA && !resolved.EndsWith("?")) { resolved = resolved + "?"; }
        Return resolved;
    }

    Private Function ResolveAlias(String name) -> String {
        Int guard = 0;
        String current = name;
        While (guard < 8) {
            String next = "";
            Int index = 0;
            For alias In This.AliasNames {
                If (alias == current) { next = This.AliasTargets[index]; }
                index = index + 1;
            }
            If (next == "" || next == current) { Return current; }
            current = next;
            guard = guard + 1;
        }
        Return current;
    }

    Private Function EmitObjectLiteral(AstNode node) -> IrValue {
        ClassInfo info = This.FindClass(node.Name);
        Int fields = info.Fields.Count();
        If (fields < 1) { fields = 1; }
        Var created = List<String>();
        created.Add(fields.ToString());
        IrValue obj = This.CallRuntime("rx_obj_new", created, False);
        For child In node.Children {
            Int slot = This.FieldSlot(info, child.Name);
            If (slot >= 0 && child.Left != Null) {
                IrValue field = This.EmitExpr(child.Left);
                This.StoreObjectField(obj.Value, slot.ToString(), field.Value);
            }
        }
        String typeName = node.Name;
        If (typeName == "") { typeName = "Int"; }
        Return This.Pair(obj.Value, typeName);
    }

    Private Function EmitEnumCall(ClassInfo info, String method, List<String> arguments) -> IrValue {
        Int ordinal = This.EnumValue(info, method);
        AstNode member = AstNode();
        Bool found = False;
        For candidate In info.EnumMembers {
            If (candidate.Name == method) {
                member = candidate;
                found = True;
            }
        }
        If (found && member.Parameters.Count() > 0) {
            Int fields = info.Fields.Count();
            If (fields < 1) { fields = 1; }
            Var created = List<String>();
            created.Add(fields.ToString());
            IrValue obj = This.CallRuntime("rx_obj_new", created, False);
            Int index = 0;
            For parameter In member.Parameters {
                String arg = "0";
                If (index < arguments.Count()) { arg = arguments[index]; }
                Int slot = This.FieldSlot(info, parameter.Name);
                If (slot >= 0) { This.StoreObjectField(obj.Value, slot.ToString(), arg); }
                index = index + 1;
            }
            Return This.Pair(obj.Value, info.Name);
        }
        If (ordinal < 0) { ordinal = 0; }
        Return This.Pair(ordinal.ToString(), "Int");
    }

    Private Function IsVoid(String typeName) -> Bool {
        Return typeName == "" || typeName == "Void";
    }

    Private Function IsString(String typeName) -> Bool {
        Return typeName == "String";
    }

    Private Function IsList(String typeName) -> Bool {
        Return typeName.StartsWith("List:") || typeName.StartsWith("List<") || typeName.StartsWith("Array<") || typeName.StartsWith("Set<") || typeName.StartsWith("Queue<") || typeName.StartsWith("Stack<") || typeName.StartsWith("Option<") || typeName.StartsWith("[");
    }

    Private Function ElementType(String typeName) -> String {
        If (typeName.StartsWith("List:")) { Return typeName.Substring(5); }
        If (typeName.StartsWith("Array<") && typeName.EndsWith(">")) { Return typeName.Substring(6, typeName.Length() - 7); }
        If (typeName.StartsWith("List<") && typeName.EndsWith(">")) { Return typeName.Substring(5, typeName.Length() - 6); }
        If (typeName.StartsWith("Set<") && typeName.EndsWith(">")) { Return typeName.Substring(4, typeName.Length() - 5); }
        If (typeName.StartsWith("Queue<") && typeName.EndsWith(">")) { Return typeName.Substring(6, typeName.Length() - 7); }
        If (typeName.StartsWith("Stack<") && typeName.EndsWith(">")) { Return typeName.Substring(6, typeName.Length() - 7); }
        If (typeName.StartsWith("Option<") && typeName.EndsWith(">")) { Return typeName.Substring(7, typeName.Length() - 8); }
        If (typeName.StartsWith("Enumerate<") && typeName.EndsWith(">")) { Return typeName.Substring(10, typeName.Length() - 11); }
        If (typeName.StartsWith("[") && typeName.EndsWith("]")) {
            String body = typeName.Substring(1, typeName.Length() - 2);
            Int semi = body.IndexOf(";");
            If (semi >= 0) { Return body.Substring(0, semi); }
            Return body;
        }
        Return "Int";
    }

    Private Function MapValueType(String typeName) -> String {
        Int comma = typeName.IndexOf(", ");
        If (comma < 0 || !typeName.EndsWith(">")) { Return "Int"; }
        Return typeName.Substring(comma + 2, typeName.Length() - comma - 3);
    }

    Private Function TupleElement(String typeName, String indexText) -> String {
        Int index = 0;
        Int cursor = 0;
        String number = "";
        Int digit = 0;
        While (digit < indexText.Length()) {
            Char character = indexText.GetChar(digit);
            If (character < '0' || character > '9') { Return "Int"; }
            number = number + indexText.Substring(digit, 1);
            digit = digit + 1;
        }
        If (number != "") { index = ParseInteger(number); }
        String body = typeName.Substring(1, typeName.Length() - 2);
        Int start = 0;
        While (start <= body.Length()) {
            Int comma = body.IndexOf(", ", start);
            String piece = "";
            If (comma < 0) {
                piece = body.Substring(start);
            } Else {
                piece = body.Substring(start, comma - start);
            }
            If (cursor == index) { Return piece; }
            If (comma < 0) { Return "Int"; }
            cursor = cursor + 1;
            start = comma + 2;
        }
        Return "Int";
    }

    Private Function RecordSlot(String typeName, String field) -> Int {
        String body = typeName.Substring(1, typeName.Length() - 2);
        Int slot = 0;
        Int start = 0;
        While (start <= body.Length()) {
            Int comma = body.IndexOf(", ", start);
            String piece = "";
            If (comma < 0) {
                piece = body.Substring(start);
            } Else {
                piece = body.Substring(start, comma - start);
            }
            Int colon = piece.IndexOf(": ");
            String name = piece;
            If (colon >= 0) { name = piece.Substring(0, colon); }
            If (name == field) { Return slot; }
            If (comma < 0) { Return -1; }
            slot = slot + 1;
            start = comma + 2;
        }
        Return -1;
    }

    Private Function RecordFieldType(String typeName, String field) -> String {
        String body = typeName.Substring(1, typeName.Length() - 2);
        Int start = 0;
        While (start <= body.Length()) {
            Int comma = body.IndexOf(", ", start);
            String piece = "";
            If (comma < 0) {
                piece = body.Substring(start);
            } Else {
                piece = body.Substring(start, comma - start);
            }
            Int colon = piece.IndexOf(": ");
            If (colon >= 0 && piece.Substring(0, colon) == field) { Return piece.Substring(colon + 2); }
            If (comma < 0) { Return "Int"; }
            start = comma + 2;
        }
        Return "Int";
    }

    Private Function EmitTernary(AstNode node) -> IrValue {
        IrValue condition = This.EmitExpr(node.Condition);
        IrValue left = This.EmitExpr(node.Left);
        IrValue right = This.EmitExpr(node.Right);
        String flag = This.Fresh("v");
        This.Emit(flag + " = icmp ne i64 " + condition.Value + ", 0");
        String result = This.Fresh("v");
        This.Emit(result + " = select i1 " + flag + ", i64 " + left.Value + ", i64 " + right.Value);
        Return This.Pair(result, left.TypeName);
    }

    Private Function EmitTypeCheck(AstNode node) -> IrValue {
        IrValue left = This.Pair("0", "Unknown");
        If (node.Left != Null) { left = This.EmitExpr(node.Left); }
        String actual = left.TypeName;
        String expected = This.TypeName(node.Type);
        If (actual.EndsWith("?")) { actual = actual.Substring(0, actual.Length() - 1); }
        If (This.IsAnyType(actual)) {
            String tag = This.LoadObjectField(left.Value, "0");
            String payload = This.LoadObjectField(left.Value, "1");
            String wantedTag = This.ValueTag(expected);
            String flag = This.Fresh("cond");
            This.Emit(flag + " = icmp eq i64 " + tag + ", " + wantedTag);
            String res = This.Fresh("v");
            This.Emit(res + " = zext i1 " + flag + " to i64");
            If (node.FlagA && node.Name != "") {
                This.Alloca(node.Name, expected, payload);
            }
            Return This.Pair(res, "Bool");
        }
        If (node.FlagA && node.Name != "") {
            This.Alloca(node.Name, expected, left.Value);
        }
        If (actual == expected || (This.IsFloatType(actual) && This.IsFloatType(expected))) {
            Return This.Pair("1", "Bool");
        }
        Return This.Pair("0", "Bool");
    }

    Private Function EmitRange(AstNode node) -> IrValue {
        IrValue start = This.EmitExpr(node.Left);
        IrValue end = This.EmitExpr(node.Right);
        String inclusive = "0";
        If (node.FlagA || node.Operator == "..=") { inclusive = "1"; }
        Var args = List<String>();
        args.Add(start.Value);
        args.Add(end.Value);
        args.Add(inclusive);
        IrValue list = This.CallRuntime("rx_range", args, False);
        Return This.Pair(list.Value, "Array<Int>");
    }

    Private Function EmitWrapped(String name, List<String> arguments, List<String> types) -> IrValue {
        IrValue list = This.CallRuntime("rx_list_new", List<String>(), False);
        String typeName = "";
        Bool first = True;
        Int index = 0;
        For argument In arguments {
            Var args = List<String>();
            args.Add(list.Value);
            args.Add(argument);
            This.CallRuntime("rx_list_add", args, True);
            If (!first) { typeName = typeName + ", "; }
            String argumentType = "Int";
            If (index < types.Count() && types[index] != "") { argumentType = types[index]; }
            typeName = typeName + argumentType;
            first = False;
            index = index + 1;
        }
        If (arguments.Count() == 0) {
            Var zeroArgs = List<String>();
            zeroArgs.Add(list.Value);
            zeroArgs.Add("0");
            This.CallRuntime("rx_list_add", zeroArgs, True);
        }
        If (name == "Some" || name == "Success") {
            Var tagArgs = List<String>();
            tagArgs.Add(list.Value);
            tagArgs.Add("1");
            This.CallRuntime("rx_list_add", tagArgs, True);
        }
        If (name == "None" || name == "Error" || name == "Failure") {
            Var tagArgs = List<String>();
            tagArgs.Add(list.Value);
            tagArgs.Add("0");
            This.CallRuntime("rx_list_add", tagArgs, True);
        }
        If (name == "Some") { Return This.Pair(list.Value, "Option<" + typeName + ">"); }
        If (name == "None") { Return This.Pair(list.Value, "Option<Int>"); }
        If (name == "Success") { Return This.Pair(list.Value, "Result<" + typeName + ", String>"); }
        If (name == "Error" || name == "Failure") { Return This.Pair(list.Value, "Result<Int, String>"); }
        Return This.Pair(list.Value, "(" + typeName + ")");
    }

    Private Function WrappedType(String typeName) -> String {
        Int open = typeName.IndexOf("<");
        Int comma = typeName.IndexOf(", ");
        If (open < 0) { Return "Int"; }
        If (comma > open) { Return typeName.Substring(open + 1, comma - open - 1); }
        If (typeName.EndsWith(">")) { Return typeName.Substring(open + 1, typeName.Length() - open - 2); }
        Return "Int";
    }

    Private Function SequenceCall(String method, String receiver, String typeName, List<String> arguments) -> IrValue {
        If (method == "Enqueue" || method == "Push") {
            Return This.ListMethod("Add", receiver, typeName, arguments);
        }
        If (method == "Dequeue" || method == "Pop") {
            String symbol = "rx_list_take_back";
            If (method == "Dequeue") { symbol = "rx_list_take_front"; }
            Var args = List<String>();
            args.Add(receiver);
            IrValue value = This.CallRuntime(symbol, args, False);
            Return This.Pair(value.Value, This.ElementType(typeName));
        }
        If (method == "Peek") {
            String index = "0";
            If (typeName.StartsWith("Stack<")) {
                String count = This.LoadListCount(receiver);
                index = This.Fresh("v");
                This.Emit(index + " = sub i64 " + count + ", 1");
            }
            Return This.Pair(This.LoadListItem(receiver, index), This.ElementType(typeName));
        }
        Return This.Pair("0", "Int");
    }

    Private Function EmitCoalesce(AstNode node) -> IrValue {
        IrValue left = This.EmitExpr(node.Left);
        IrValue right = This.EmitExpr(node.Right);
        String flag = This.Fresh("v");
        This.Emit(flag + " = icmp eq i64 " + left.Value + ", 0");
        String result = This.Fresh("v");
        This.Emit(result + " = select i1 " + flag + ", i64 " + right.Value + ", i64 " + left.Value);
        String typeName = left.TypeName;
        If (typeName.EndsWith("?")) { typeName = typeName.Substring(0, typeName.Length() - 1); }
        If (typeName == "Null") { typeName = right.TypeName; }
        Return This.Pair(result, typeName);
    }

    Private Function EmitMapLiteral(AstNode node) -> IrValue {
        Var created = List<String>();
        created.Add("1");
        IrValue map = This.CallRuntime("rx_map_new", created, False);
        Var values = List<String>();
        Var types = List<String>();
        String valueType = "Int";
        Bool mixed = False;
        For child In node.Children {
            IrValue field = This.EmitExpr(child.Left);
            String itemType = field.TypeName;
            If (itemType == "") { itemType = "Int"; }
            If (types.Count() == 0) { valueType = itemType; }
            If (itemType != valueType) { mixed = True; }
            values.Add(field.Value);
            types.Add(itemType);
        }
        Int index = 0;
        For child In node.Children {
            String payload = values[index];
            If (mixed || This.UntypedLiteral) {
                IrValue boxed = This.BoxAny(This.Pair(values[index], types[index]));
                payload = boxed.Value;
            }
            Var args = List<String>();
            args.Add(map.Value);
            args.Add(This.StringConst(child.Name));
            args.Add(payload);
            This.CallRuntime("rx_map_put", args, True);
            index = index + 1;
        }
        If (mixed || This.UntypedLiteral) { valueType = "Any"; }
        Return This.Pair(map.Value, "Map<String, " + valueType + ">");
    }

    Private Function EmitSetLiteral(AstNode node) -> IrValue {
        IrValue list = This.CallRuntime("rx_list_new", List<String>(), False);
        Var values = List<String>();
        Var types = List<String>();
        String element = "Int";
        Bool mixed = False;
        For child In node.Children {
            IrValue item = This.EmitExpr(child);
            String itemType = item.TypeName;
            If (itemType == "") { itemType = "Int"; }
            If (types.Count() == 0) { element = itemType; }
            If (itemType != element) { mixed = True; }
            values.Add(item.Value);
            types.Add(itemType);
        }
        String kind = "0";
        If (element == "String") { kind = "1"; }
        If (mixed || This.UntypedLiteral) { kind = "2"; }
        Int index = 0;
        For stored In values {
            String payload = stored;
            If (mixed || This.UntypedLiteral) {
                IrValue boxed = This.BoxAny(This.Pair(stored, types[index]));
                payload = boxed.Value;
            }
            Var args = List<String>();
            args.Add(list.Value);
            args.Add(payload);
            args.Add(kind);
            This.CallRuntime("rx_set_add", args, True);
            index = index + 1;
        }
        If (mixed || This.UntypedLiteral) { Return This.Pair(list.Value, "Set<Any>"); }
        Return This.Pair(list.Value, "Set<" + element + ">");
    }

    Private Function EmitTupleLiteral(AstNode node) -> IrValue {
        IrValue list = This.CallRuntime("rx_list_new", List<String>(), False);
        String typeName = "(";
        Bool first = True;
        For child In node.Children {
            IrValue item = This.EmitExpr(child);
            If (!first) { typeName = typeName + ", "; }
            typeName = typeName + item.TypeName;
            first = False;
            Var args = List<String>();
            args.Add(list.Value);
            args.Add(item.Value);
            This.CallRuntime("rx_list_add", args, True);
        }
        Return This.Pair(list.Value, typeName + ")");
    }

    Private Function EmitRecordLiteral(AstNode node) -> IrValue {
        Int fields = node.Children.Count();
        If (fields < 1) { fields = 1; }
        Var created = List<String>();
        created.Add(fields.ToString());
        IrValue obj = This.CallRuntime("rx_obj_new", created, False);
        String typeName = "{";
        Bool first = True;
        Int slot = 0;
        For child In node.Children {
            IrValue field = This.EmitExpr(child.Left);
            This.StoreObjectField(obj.Value, slot.ToString(), field.Value);
            If (!first) { typeName = typeName + ", "; }
            typeName = typeName + child.Name + ": " + field.TypeName;
            first = False;
            slot = slot + 1;
        }
        Return This.Pair(obj.Value, typeName + "}");
    }

    Private Function Stem(String fileName) -> String {
        String stemText = fileName;
        Int slash = fileName.LastIndexOf("/");
        If (slash >= 0) { stemText = fileName.Substring(slash + 1); }
        If (stemText.EndsWith(".rx")) { stemText = stemText.Substring(0, stemText.Length() - 3); }
        String cleaned = "";
        Int index = 0;
        While (index < stemText.Length()) {
            Int code = stemText.GetChar(index).ToInt();
            If ((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)) {
                cleaned = cleaned + stemText.Substring(index, 1);
            } Else {
                cleaned = cleaned + "_";
            }
            index = index + 1;
        }
        Return cleaned;
    }

    Private Function SafeArg(String name) -> String {
        String cleaned = "";
        Int index = 0;
        While (index < name.Length()) {
            Int code = name.GetChar(index).ToInt();
            If ((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)) {
                cleaned = cleaned + name.Substring(index, 1);
            } Else {
                cleaned = cleaned + "_";
            }
            index = index + 1;
        }
        If (cleaned == "") { cleaned = "arg"; }
        Return "p_" + cleaned;
    }

    Private Function Digits(String text) -> String {
        Return ParseInteger(text).ToString();
    }

    Private Function PrintKind(String typeName) -> Int {
        String clean = typeName;
        If (clean.EndsWith("?")) { clean = clean.Substring(0, clean.Length() - 1); }
        If (clean == "String") { Return 1; }
        If (clean == "Bool") { Return 2; }
        If (clean == "Char") { Return 3; }
        If (clean == "Decimal") { Return 1; }
        If (This.IsFloatType(clean)) { Return 4; }
        Return 0;
    }

    Private Function IsAnyType(String typeName) -> Bool {
        Return typeName == "Any" || typeName == "Dynamic";
    }

    Private Function ValueTag(String typeName) -> String {
        If (typeName == "String") { Return "2"; }
        If (typeName == "Bool") { Return "3"; }
        If (typeName == "Char") { Return "4"; }
        If (This.IsFloatType(typeName)) { Return "5"; }
        If (typeName == "Null") { Return "6"; }
        If (This.IsList(typeName) || typeName.StartsWith("Array")) { Return "7"; }
        Return "1";
    }

    Private Function ElementTag(String typeName) -> String {
        If (This.IsList(typeName)) { Return This.ValueTag(This.ElementType(typeName)); }
        Return "0";
    }

    Private Function BoxAny(IrValue value) -> IrValue {
        If (This.IsAnyType(value.TypeName)) { Return value; }
        Var created = List<String>();
        created.Add("3");
        IrValue obj = This.CallRuntime("rx_obj_new", created, False);
        ClassInfo info = This.FindClass(value.TypeName);
        If (info.Name != "" && (info.KindName == "Struct" || info.KindName == "Class")) {
            This.StoreObjectField(obj.Value, "0", "8");
            This.StoreObjectField(obj.Value, "1", value.Value);
            This.StoreObjectField(obj.Value, "2", This.StringConst(value.TypeName));
            Return This.Pair(obj.Value, "Any");
        }
        This.StoreObjectField(obj.Value, "0", This.ValueTag(value.TypeName));
        This.StoreObjectField(obj.Value, "1", value.Value);
        This.StoreObjectField(obj.Value, "2", This.ElementTag(value.TypeName));
        Return This.Pair(obj.Value, "Any");
    }

    Private Function ValueForStore(String name, IrValue value) -> IrValue {
        IrValue found = This.Lookup(name);
        If (This.IsAnyType(found.TypeName)) { Return This.BoxAny(value); }
        Return value;
    }

    Private Function AnyCall(String method, String receiver) -> IrValue {
        Var args = List<String>();
        args.Add(receiver);
        If (method == "ToString") {
            IrValue value = This.CallRuntime("rx_AnyText", args, False);
            Return This.Pair(value.Value, "String");
        }
        If (method == "ToInt") {
            IrValue value = This.CallRuntime("rx_AnyToInt", args, False);
            Return This.Pair(value.Value, "Int");
        }
        If (method == "ToFloat") {
            IrValue value = This.CallRuntime("rx_AnyToFloat", args, False);
            Return This.Pair(value.Value, "Float");
        }
        If (method == "Length" || method == "Count") {
            IrValue value = This.CallRuntime("rx_AnyLength", args, False);
            Return This.Pair(value.Value, "Int");
        }
        If (method == "ToUpper") {
            IrValue value = This.CallRuntime("rx_AnyUpper", args, False);
            Return This.Pair(value.Value, "String");
        }
        If (method == "ToLower") {
            IrValue value = This.CallRuntime("rx_AnyLower", args, False);
            Return This.Pair(value.Value, "String");
        }
        Return This.Pair("0", "Int");
    }

    Private Function EmitArrayLiteral(AstNode node) -> IrValue {
        IrValue list = This.CallRuntime("rx_list_new", List<String>(), False);
        Var values = List<String>();
        Var types = List<String>();
        String element = "Int";
        Bool mixed = False;
        For child In node.Children {
            IrValue item = This.EmitExpr(child);
            String itemType = item.TypeName;
            If (itemType == "") { itemType = "Int"; }
            If (types.Count() == 0) { element = itemType; }
            If (itemType != element) { mixed = True; }
            values.Add(item.Value);
            types.Add(itemType);
        }
        Int index = 0;
        For stored In values {
            String payload = stored;
            If (mixed || This.UntypedLiteral) {
                IrValue boxed = This.BoxAny(This.Pair(stored, types[index]));
                payload = boxed.Value;
            }
            Var args = List<String>();
            args.Add(list.Value);
            args.Add(payload);
            This.CallRuntime("rx_list_add", args, True);
            index = index + 1;
        }
        If (mixed || This.UntypedLiteral) { Return This.Pair(list.Value, "Array<Any>"); }
        Return This.Pair(list.Value, "List:" + element);
    }

    Private Function EmitNumericFrom(AstNode node) -> IrValue {
        String typeName = node.Left.Left.Name;
        String valueReg = "0";
        String valueType = "Int";
        String places = "-1";
        Bool hasValue = False;
        For argument In node.Parameters {
            If (argument.Left == Null) { Continue; }
            If (argument.Name == "precision" || argument.Name == "scale") {
                IrValue place = This.EmitExpr(argument.Left);
                places = place.Value;
            } Else If (!hasValue) {
                IrValue value = This.EmitExpr(argument.Left);
                valueReg = value.Value;
                valueType = value.TypeName;
                hasValue = True;
            }
        }
        If (typeName == "Decimal") {
            String text = valueReg;
            If (valueType != "String" && valueType != "Decimal") {
                IrValue rendered = This.ToStringValue(valueReg, valueType);
                text = rendered.Value;
            }
            Var args = List<String>();
            args.Add(text);
            args.Add(places);
            IrValue formatted = This.CallRuntime("rx_FormatFixed", args, False);
            Return This.Pair(formatted.Value, "Decimal");
        }
        If (typeName == "Float" || typeName == "Double" || typeName == "Float16" || typeName == "Float32" || typeName == "Float64") {
            String text = valueReg;
            If (!This.IsString(valueType) && valueType != "Decimal") {
                IrValue rendered = This.ToStringValue(valueReg, valueType);
                text = rendered.Value;
            }
            Var args = List<String>();
            args.Add(text);
            args.Add(places);
            IrValue formatted = This.CallRuntime("rx_FormatFixed", args, False);
            Var parseArgs = List<String>();
            parseArgs.Add(formatted.Value);
            String parser = "rx_F64Parse";
            If (typeName == "Float32" || typeName == "Float16") { parser = "rx_F32Parse"; }
            IrValue bits = This.CallRuntime(parser, parseArgs, False);
            Return This.Pair(bits.Value, typeName);
        }
        String integer = valueReg;
        If (This.IsString(valueType)) {
            Var args = List<String>();
            args.Add(valueReg);
            IrValue parsed = This.CallRuntime("rx_str_to_int", args, False);
            integer = parsed.Value;
        } Else If (This.IsFloatType(valueType)) {
            Var args = List<String>();
            args.Add(valueReg);
            IrValue parsed = This.CallRuntime("rx_F64ToInt", args, False);
            integer = parsed.Value;
        }
        Return This.Pair(This.WrapInteger(integer, typeName), typeName);
    }

    Private Function LiteralTypeName(String text) -> String {
        String lower = text.ToLower();
        If (This.DigitSuffix(lower, "u64")) { Return "UInt64"; }
        If (This.DigitSuffix(lower, "u32")) { Return "UInt32"; }
        If (This.DigitSuffix(lower, "u16")) { Return "UInt16"; }
        If (This.DigitSuffix(lower, "u8") || This.DigitSuffix(lower, "u")) { Return "UInt8"; }
        If (This.DigitSuffix(lower, "i64")) { Return "Int64"; }
        If (This.DigitSuffix(lower, "i32")) { Return "Int32"; }
        If (This.DigitSuffix(lower, "i16")) { Return "Int16"; }
        If (This.DigitSuffix(lower, "i8")) { Return "Int8"; }
        If (This.DigitSuffix(lower, "f64")) { Return "Float64"; }
        If (This.DigitSuffix(lower, "f32") || This.DigitSuffix(lower, "f")) { Return "Float32"; }
        If (This.DigitSuffix(lower, "f16")) { Return "Float16"; }
        If (This.DigitSuffix(lower, "m")) { Return "Decimal"; }
        If (This.DigitSuffix(lower, "d")) { Return "Double"; }
        If (text.Contains(".")) { Return "Float"; }
        Return "Int";
    }

    Private Function DigitSuffix(String lower, String suffix) -> Bool {
        If (!lower.EndsWith(suffix)) { Return False; }
        If (lower.Length() <= suffix.Length()) { Return False; }
        Char before = lower.GetChar(lower.Length() - suffix.Length() - 1);
        Return before >= '0' && before <= '9';
    }

    Private Function IsNumericType(String typeName) -> Bool {
        Return typeName == "Int" || typeName == "UInt" || typeName == "Float" || typeName == "Double" || typeName == "Decimal" || typeName == "Byte" || typeName.StartsWith("Int") || typeName.StartsWith("UInt") || typeName.StartsWith("Float");
    }

    Private Function IsWrappedInteger(String typeName) -> Bool {
        Return typeName == "Int8" || typeName == "Int16" || typeName == "Int32" || typeName == "UInt8" || typeName == "UInt16" || typeName == "UInt32" || typeName == "Byte";
    }

    Private Function WrapInteger(String value, String typeName) -> String {
        If (typeName == "UInt8" || typeName == "Byte") {
            String result = This.Fresh("v");
            This.Emit(result + " = and i64 " + value + ", 255");
            Return result;
        }
        If (typeName == "UInt16") {
            String result = This.Fresh("v");
            This.Emit(result + " = and i64 " + value + ", 65535");
            Return result;
        }
        If (typeName == "UInt32") {
            String result = This.Fresh("v");
            This.Emit(result + " = and i64 " + value + ", 4294967295");
            Return result;
        }
        If (typeName == "Int8") { Return This.SignExtend(value, "i8"); }
        If (typeName == "Int16") { Return This.SignExtend(value, "i16"); }
        If (typeName == "Int32") { Return This.SignExtend(value, "i32"); }
        Return value;
    }

    Private Function SignExtend(String value, String width) -> String {
        String narrowed = This.Fresh("v");
        This.Emit(narrowed + " = trunc i64 " + value + " to " + width);
        String result = This.Fresh("v");
        This.Emit(result + " = sext " + width + " " + narrowed + " to i64");
        Return result;
    }

    Private Function NarrowFloat32(String bits) -> String {
        String asDouble = This.Fresh("v");
        This.Emit(asDouble + " = bitcast i64 " + bits + " to double");
        String narrow = This.Fresh("v");
        This.Emit(narrow + " = fptrunc double " + asDouble + " to float");
        String wide = This.Fresh("v");
        This.Emit(wide + " = fpext float " + narrow + " to double");
        String result = This.Fresh("v");
        This.Emit(result + " = bitcast double " + wide + " to i64");
        Return result;
    }

    Private Function IsFloatType(String typeName) -> Bool {
        Return typeName == "Float" || typeName == "Double" || typeName == "Float16" || typeName == "Float32" || typeName == "Float64";
    }

    Private Function IsFloat32Literal(String text) -> Bool {
        String lower = text.Replace("_", "").ToLower();
        If (lower.EndsWith("f64")) { Return False; }
        Return lower.EndsWith("f32") || lower.EndsWith("f");
    }

    Private Function FloatSpelling(String text) -> String {
        String cleaned = StripNumericSuffix(text.Replace("_", ""));
        If (cleaned == "" || cleaned == "-" || cleaned == "." || cleaned == "-.") { Return "0.0"; }
        Return cleaned;
    }

    Private Function EmitFloatBits(String text) -> String {
        String spelling = This.FloatSpelling(text);
        If (This.IsFloat32Literal(text)) {
            String source = This.Fresh("v");
            This.Emit(source + " = bitcast double " + spelling + " to i64");
            String asDouble = This.Fresh("v");
            This.Emit(asDouble + " = bitcast i64 " + source + " to double");
            String narrow = This.Fresh("v");
            This.Emit(narrow + " = fptrunc double " + asDouble + " to float");
            String wide = This.Fresh("v");
            This.Emit(wide + " = fpext float " + narrow + " to double");
            String bits = This.Fresh("v");
            This.Emit(bits + " = bitcast double " + wide + " to i64");
            Return bits;
        }
        String bits = This.Fresh("v");
        This.Emit(bits + " = bitcast double " + spelling + " to i64");
        Return bits;
    }

    Private Function EmitInterpolation(AstNode node) -> IrValue {
        String text = This.StringConst("");
        For child In node.Children {
            String piece = This.StringConst("");
            If (child.Kind == AstKind.Interpolation && child.Left != Null) {
                IrValue value = This.EmitExpr(child.Left);
                IrValue rendered = This.ToStringValue(value.Value, value.TypeName);
                piece = rendered.Value;
            } Else If (child.Text != "") {
                piece = This.StringConst(child.Text);
            }
            Var args = List<String>();
            args.Add(text);
            args.Add(piece);
            IrValue joined = This.CallRuntime("rx_str_concat", args, False);
            text = joined.Value;
        }
        Return This.Pair(text, "String");
    }

    Private Function FloatOperand(IrValue value) -> String {
        If (This.IsFloatType(value.TypeName)) { Return value.Value; }
        String converted = This.Fresh("v");
        This.Emit(converted + " = sitofp i64 " + value.Value + " to double");
        String bits = This.Fresh("v");
        This.Emit(bits + " = bitcast double " + converted + " to i64");
        Return bits;
    }

    Private Function EmitFloatBinary(String operator, IrValue left, IrValue right) -> IrValue {
        String leftBits = This.FloatOperand(left);
        String rightBits = This.FloatOperand(right);
        String leftDouble = This.Fresh("v");
        String rightDouble = This.Fresh("v");
        This.Emit(leftDouble + " = bitcast i64 " + leftBits + " to double");
        This.Emit(rightDouble + " = bitcast i64 " + rightBits + " to double");
        If (operator == "==" || operator == "!=" || operator == "<" || operator == ">" || operator == "<=" || operator == ">=") {
            String predicate = "oeq";
            If (operator == "!=") { predicate = "one"; }
            If (operator == "<") { predicate = "olt"; }
            If (operator == ">") { predicate = "ogt"; }
            If (operator == "<=") { predicate = "ole"; }
            If (operator == ">=") { predicate = "oge"; }
            String flag = This.Fresh("v");
            This.Emit(flag + " = fcmp " + predicate + " double " + leftDouble + ", " + rightDouble);
            String result = This.Fresh("v");
            This.Emit(result + " = zext i1 " + flag + " to i64");
            Return This.Pair(result, "Bool");
        }
        String opcode = "fadd";
        If (operator == "-") { opcode = "fsub"; }
        If (operator == "*") { opcode = "fmul"; }
        If (operator == "/") { opcode = "fdiv"; }
        If (operator == "%") { opcode = "frem"; }
        String computed = This.Fresh("v");
        This.Emit(computed + " = " + opcode + " double " + leftDouble + ", " + rightDouble);
        String bits = This.Fresh("v");
        This.Emit(bits + " = bitcast double " + computed + " to i64");
        Return This.Pair(bits, "Float");
    }

    Private Function ExternSymbol(String name) -> String {
        If (name == "RunProcess") { Return "rx_process"; }
        Return "rx_" + name;
    }

    Private Function ExitCodeValue(String name) -> Int {
        If (name == "Success" || name == "SuccessfulExecution") { Return 0; }
        If (name == "WarningExecution") { Return 1; }
        If (name == "ErrorExecution") { Return 2; }
        If (name == "FatalErrorExecution") { Return 3; }
        If (name == "InvalidArguments") { Return 4; }
        If (name == "PermissionDenied") { Return 5; }
        If (name == "ResourceUnavailable") { Return 6; }
        Return -1;
    }

    Private Function IsStringMethod(String name) -> Bool {
        Return name == "Length" || name == "Substring" || name == "GetChar" || name == "ToLower" || name == "ToUpper" || name == "Trim" || name == "Split" || name == "StartsWith" || name == "EndsWith" || name == "Replace" || name == "IndexOf" || name == "LastIndexOf" || name == "Contains" || name == "ToInt" || name == "ToFloat" || name == "ToString";
    }

    Private Function IsListMethod(String name) -> Bool {
        Return name == "Add" || name == "Count" || name == "ToArray";
    }

    Private Function Escape(String text) -> EscapeText {
        EscapeText result = EscapeText();
        Int index = 0;
        While (index < text.Length()) {
            Int code = text.GetChar(index).ToInt();
            If (code == 92) {
                result.Text = result.Text + "\\\\";
                result.Bytes = result.Bytes + 1;
            } Else If (code == 34) {
                result.Text = result.Text + "\\22";
                result.Bytes = result.Bytes + 1;
            } Else If (code == 10) {
                result.Text = result.Text + "\\0A";
                result.Bytes = result.Bytes + 1;
            } Else If (code == 13) {
                result.Text = result.Text + "\\0D";
                result.Bytes = result.Bytes + 1;
            } Else If (code == 9) {
                result.Text = result.Text + "\\09";
                result.Bytes = result.Bytes + 1;
            } Else If (code == 0) {
                result.Text = result.Text + "\\00";
                result.Bytes = result.Bytes + 1;
            } Else If (code >= 32 && code < 127) {
                result.Text = result.Text + text.Substring(index, 1);
                result.Bytes = result.Bytes + 1;
            } Else {
                result = This.AppendUtf8(result, code);
            }
            index = index + 1;
        }
        Return result;
    }

    Private Function AppendUtf8(EscapeText result, Int code) -> EscapeText {
        If (code < 128) {
            result.Text = result.Text + This.HexByte(code);
            result.Bytes = result.Bytes + 1;
            Return result;
        }
        If (code < 2048) {
            result.Text = result.Text + This.HexByte(192 + code / 64) + This.HexByte(128 + code % 64);
            result.Bytes = result.Bytes + 2;
            Return result;
        }
        If (code < 65536) {
            result.Text = result.Text + This.HexByte(224 + code / 4096) + This.HexByte(128 + (code / 64) % 64) + This.HexByte(128 + code % 64);
            result.Bytes = result.Bytes + 3;
            Return result;
        }
        result.Text = result.Text + This.HexByte(240 + code / 262144) + This.HexByte(128 + (code / 4096) % 64) + This.HexByte(128 + (code / 64) % 64) + This.HexByte(128 + code % 64);
        result.Bytes = result.Bytes + 4;
        Return result;
    }

    Private Function HexByte(Int value) -> String {
        Int high = value / 16;
        Int low = value % 16;
        Return "\\" + This.HexDigit(high) + This.HexDigit(low);
    }

    Private Function HexDigit(Int value) -> String {
        If (value < 10) { Return value.ToString(); }
        If (value == 10) { Return "A"; }
        If (value == 11) { Return "B"; }
        If (value == 12) { Return "C"; }
        If (value == 13) { Return "D"; }
        If (value == 14) { Return "E"; }
        Return "F";
    }
}
