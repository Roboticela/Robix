            Var args = List<String>();
            args.Add(arguments[0]);
            IrValue v = This.CallRuntime("rx_F64FromInt", args, False);
            Return This.Pair(v.Value, "Float");
        }
        If (left.Name == "String" && arguments.Count() > 0) {
            String argType = "Int";
            If (types.Count() > 0 && types[0] != "") { argType = types[0]; }
            Return This.ToStringValue(arguments[0], argType);
