// Lower a type-checked Robix module to LLVM IR for the host Linux processor.
Package Robix.Syntax;

Import Robix.Core;


Public Class EscapeText {
    Public String Text;
    Public Int Bytes;

    Public Constructor() {
        This.Text = "";
        This.Bytes = 0;
    }
}

Public Class IrValue {
    Public String Value;
    Public String TypeName;

    Public Constructor() {
        This.Value = "0";
        This.TypeName = "Int";
    }
}

Public Class MethodInfo {
    Public String Name;
    Public String FileName;
    Public Int ArgumentCount;
    Public String ReturnType;
    Public AstNode Node;

    Public Constructor() {
        This.Name = "";
        This.FileName = "";
        This.ArgumentCount = 0;
        This.ReturnType = "";
        This.Node = AstNode();
    }
}

Public Class ClassInfo {
    Public String Name;
    Public String KindName;
    Public List<String> Fields;
    Public List<String> FieldTypes;
    Public List<MethodInfo> Methods;
    Public List<String> EnumNames;
    Public List<Int> EnumValues;
    Public List<AstNode> EnumMembers;
    Public List<AstNode> Constructors;
    Public List<String> ConstructorFiles;

    Public Constructor() {
        This.Name = "";
        This.KindName = "Class";
        This.Fields = List<String>();
        This.FieldTypes = List<String>();
        This.Methods = List<MethodInfo>();
        This.EnumNames = List<String>();
        This.EnumValues = List<Int>();
        This.EnumMembers = List<AstNode>();
        This.Constructors = List<AstNode>();
        This.ConstructorFiles = List<String>();
    }
}

Public Class FunctionInfo {
    Public String Name;
    Public String FileName;
    Public Int ArgumentCount;
    Public String ReturnType;
    Public Bool IsExtern;
    Public AstNode Node;

    Public Constructor() {
        This.Name = "";
        This.FileName = "";
        This.ArgumentCount = 0;
        This.ReturnType = "";
        This.IsExtern = False;
        This.Node = AstNode();
    }
}

Public Class NativeProgram {
    Public List<ClassInfo> Classes;
    Public List<FunctionInfo> Functions;
    Public Int Serial;
    Public String FileName;
    Public String Owner;
    Public String ReturnType;
    Public List<String> Lines;
    Public List<String> Strings;
    Public List<String> Defined;
    Public Int Counter;
    Public Bool Terminated;
    Public List<String> ScopeNames;
    Public List<String> ScopeSlots;
    Public List<String> ScopeTypes;
    Public Int ScopeCount;
    Public List<String> LoopContinue;
    Public List<String> LoopBreak;
    Public Int LoopCount;
    Public List<String> GlobalNames;
    Public List<String> GlobalSlots;
    Public List<String> GlobalTypes;
    Public String InitSymbol;
    Public List<String> AliasNames;
    Public List<String> AliasTargets;
    Public List<String> OperatorKeys;
    Public List<String> OperatorSymbols;
    Public List<String> OperatorReturns;
    Public Bool UntypedLiteral;

    Public Constructor() {
        This.Classes = List<ClassInfo>();
        This.Functions = List<FunctionInfo>();
        This.Serial = 0;
        This.FileName = "";
        This.Owner = "";
        This.ReturnType = "";
        This.Lines = List<String>();
        This.Strings = List<String>();
        This.Defined = List<String>();
        This.Counter = 0;
        This.Terminated = False;
        This.ScopeNames = List<String>();
        This.ScopeSlots = List<String>();
        This.ScopeTypes = List<String>();
        This.ScopeCount = 0;
        This.LoopContinue = List<String>();
        This.LoopBreak = List<String>();
        This.LoopCount = 0;
        This.GlobalNames = List<String>();
        This.GlobalSlots = List<String>();
        This.GlobalTypes = List<String>();
        This.InitSymbol = "";
        This.AliasNames = List<String>();
        This.AliasTargets = List<String>();
        This.OperatorKeys = List<String>();
        This.OperatorSymbols = List<String>();
        This.OperatorReturns = List<String>();
        This.UntypedLiteral = False;
    }

    Public Function Collect(List<String> fileNames, List<AstNode> modules) -> Void
    Explain {
        Description: "Record class layouts and functions for every module in a program.";
        Input: fileNames = "Source paths parallel to modules", modules = "Type-checked module trees";
        Processing: "Merge partial classes and remember which file defines each method.";
        Output: "A program model the LLVM lowering can share across files.";
    } {
        Int index = 0;
        While (index < modules.Count()) {
            String fileName = fileNames[index];
            AstNode module = modules[index];
            For child In module.Children {
                If (child.Kind == AstKind.Class) {
                    This.AddClass(fileName, child);
                }
                If (child.Kind == AstKind.TypeAlias && child.Parameters.Count() == 0) {
                    This.AliasNames.Add(child.Name);
                    String target = "";
                    If (child.Type != Null) { target = child.Type.Name; }
                    This.AliasTargets.Add(target);
                }
                If (child.Kind == AstKind.Function || child.Kind == AstKind.Extern) {
                    This.AddFunction(fileName, child);
                }
                If (child.Kind == AstKind.Operator) {
                    This.RememberModuleOperator(fileName, child);
                }
            }
            This.CollectLambdas(fileName, module);
            index = index + 1;
        }
        ClassInfo resultType = ClassInfo();
        resultType.Name = "ExecutionResult";
        resultType.KindName = "Class";
        resultType.Fields.Add("Code");
        resultType.FieldTypes.Add("Int");
        resultType.Fields.Add("Message");
        resultType.FieldTypes.Add("String");
        resultType.Fields.Add("Details");
        resultType.FieldTypes.Add("String");
        This.Classes.Add(resultType);
    }

    Public Function EmitFile(String fileName, AstNode module, Bool isEntry) -> String
    Explain {
        Description: "Print LLVM IR for one type-checked Robix module.";
        Input: fileName = "Module path", module = "Type-checked tree", isEntry = "True when this file owns main";
        Processing: "Lower functions, methods, and constructors to LLVM IR and declare the rest.";
        Output: "LLVM IR text for this file.";
    } {
        This.FileName = fileName;
        This.Defined = List<String>();
        This.CollectLambdas(fileName, module);
        String parts = This.RuntimeDeclarations();
        parts = parts + This.PrepareGlobals(module);
        For child In module.Children {
            If (child.Kind == AstKind.Class) {
                parts = parts + This.EmitClassMembers(child);
            }
            If (child.Kind == AstKind.Function) {
                parts = parts + This.EmitPlain(child);
            }
            If (child.Kind == AstKind.Operator && child.Body != Null && child.Body.Kind == AstKind.Function) {
                parts = parts + This.EmitPlain(child.Body);
            }
            If (child.Kind == AstKind.Extern) {
                parts = parts + This.DeclareExtern(child);
            }
        }
        For record In This.Functions {
            If (record.FileName == fileName && record.Node.Kind == AstKind.Lambda) {
                parts = parts + This.EmitPlain(record.Node);
            }
        }
        parts = parts + This.DeclareForeign();
        If (isEntry) {
            parts = parts + This.EntryMain(module);
        }
        Return parts;
    }

    Private Function AddClass(String fileName, AstNode node) -> Void {
        ClassInfo info = This.FindClass(node.Name);
        If (info.Name == "") {
            info = ClassInfo();
            info.Name = node.Name;
            This.Classes.Add(info);
        }
        If (node.Text != "") {
            info.KindName = node.Text;
        }
        For child In node.Children {
            If (child.Kind == AstKind.Field && This.FieldSlot(info, child.Name) < 0) {
                info.Fields.Add(child.Name);
                String fieldType = This.TypeName(child.Type);
                If (fieldType == "") { fieldType = "Int"; }
                info.FieldTypes.Add(fieldType);
            }
            If (child.Kind == AstKind.EnumMember && This.EnumValue(info, child.Name) < 0) {
                info.EnumNames.Add(child.Name);
                Int enumVal = info.EnumNames.Count() - 1;
                If (child.Initializer != Null && child.Initializer.Kind == AstKind.IntegerLiteral) {
                    enumVal = ParseInteger(child.Initializer.Text);
                }
                info.EnumValues.Add(enumVal);
                info.EnumMembers.Add(child);
                For parameter In child.Parameters {
                    If (parameter.Name != "" && This.FieldSlot(info, parameter.Name) < 0) {
                        info.Fields.Add(parameter.Name);
                        String fieldType = This.TypeName(parameter.Type);
                        If (fieldType == "") { fieldType = "Int"; }
                        info.FieldTypes.Add(fieldType);
                    }
                }
            }
            If (child.Kind == AstKind.Function) {
                MethodInfo method = MethodInfo();
                method.Name = child.Name;
                method.FileName = fileName;
                method.ArgumentCount = child.Parameters.Count();
                method.ReturnType = This.TypeName(child.Type);
                method.Node = child;
                This.PutMethod(info, method);
            }
            If (child.Kind == AstKind.Constructor) {
                info.Constructors.Add(child);
                info.ConstructorFiles.Add(fileName);
            }
            If (child.Kind == AstKind.Operator) {
                This.RememberClassOperator(node.Name, child);
            }
        }
    }

    Private Function PutMethod(ClassInfo info, MethodInfo method) -> Void {
        Int index = 0;
        For existing In info.Methods {
            If (existing.Name == method.Name) {
                info.Methods[index] = method;
                Return;
            }
            index = index + 1;
        }
        info.Methods.Add(method);
    }

    Private Function AddFunction(String fileName, AstNode node) -> Void {
        FunctionInfo record = FunctionInfo();
        record.Name = node.Name;
        record.FileName = fileName;
        record.ArgumentCount = node.Parameters.Count();
        record.ReturnType = This.TypeName(node.Type);
        record.IsExtern = node.Kind == AstKind.Extern;
        record.Node = node;
        This.Functions.Add(record);
    }

    Private Function CollectLambdas(String fileName, AstNode node) -> Void {
        If (node.Kind == AstKind.Lambda) {
            If (node.Name == "") {
                node.Name = "Lambda_" + This.Functions.Count().ToString();
            }
            FunctionInfo existing = This.FindFunction(node.Name, fileName);
            If (existing.Name == "") {
                FunctionInfo record = FunctionInfo();
                record.Name = node.Name;
                record.FileName = fileName;
                record.ArgumentCount = node.Parameters.Count();
                String ret = This.TypeName(node.Type);
                If (ret == "") {
                    If (node.Left != Null) { ret = "Int"; }
                    Else { ret = "Void"; }
                }
                record.ReturnType = ret;
                record.IsExtern = False;
                record.Node = node;
                This.Functions.Add(record);
            }
        }
        For child In node.Children {
            This.CollectLambdas(fileName, child);
        }
        For param In node.Parameters {
            This.CollectLambdas(fileName, param);
        }
        If (node.Left != Null) { This.CollectLambdas(fileName, node.Left); }
        If (node.Right != Null) { This.CollectLambdas(fileName, node.Right); }
        If (node.Initializer != Null) { This.CollectLambdas(fileName, node.Initializer); }
        If (node.Body != Null) { This.CollectLambdas(fileName, node.Body); }
        If (node.Otherwise != Null) { This.CollectLambdas(fileName, node.Otherwise); }
    }

    Private Function FindClass(String name) -> ClassInfo {
        String wanted = name;
        If (wanted.EndsWith("?")) { wanted = wanted.Substring(0, wanted.Length() - 1); }
        For info In This.Classes {
            If (info.Name == wanted) { Return info; }
        }
        Return ClassInfo();
    }

    Private Function FindFunction(String name, String fileName) -> FunctionInfo {
        FunctionInfo first = FunctionInfo();
        Bool found = False;
        For record In This.Functions {
            If (record.Name == name) {
                If (!found) {
                    first = record;
                    found = True;
                }
                If (record.FileName == fileName) { Return record; }
            }
        }
        Return first;
    }

    Private Function RememberModuleOperator(String fileName, AstNode node) -> Void {
        If (node.Body == Null || node.Body.Kind != AstKind.Function) { Return; }
        This.AddFunction(fileName, node.Body);
        This.OperatorKeys.Add(node.Operator);
        This.OperatorSymbols.Add(This.FunctionSymbol(fileName, node.Body.Name));
        This.OperatorReturns.Add(This.OperatorResult(node.Body.Type));
    }

    Private Function RememberClassOperator(String className, AstNode node) -> Void {
        This.OperatorKeys.Add(className + node.Operator);
        This.OperatorSymbols.Add("rxm_" + className + "_" + This.SafeOperator(node.Operator));
        This.OperatorReturns.Add(This.OperatorResult(node.Type));
    }

    Private Function OperatorResult(AstNode? typeNode) -> String {
        String name = This.TypeName(typeNode);
        If (name == "") { Return "Int"; }
        Return name;
    }

    Private Function SafeOperator(String symbol) -> String {
        If (symbol == "+") { Return "add"; }
        If (symbol == "-") { Return "sub"; }
        If (symbol == "==") { Return "eq"; }
        If (symbol == "!=") { Return "ne"; }
        If (symbol == "*") { Return "mul"; }
        If (symbol == "/") { Return "div"; }
        If (symbol == "⊗") { Return "tensor"; }
        Return "custom";
    }

    Private Function OperatorIndex(String key) -> Int {
        Int index = 0;
        While (index < This.OperatorKeys.Count()) {
            If (This.OperatorKeys[index] == key) { Return index; }
            index = index + 1;
        }
        Return -1;
    }

    Private Function OperatorSymbol(String leftType, String rightType, String symbol) -> String {
        Int typed = This.OperatorIndex(leftType + symbol);
        If (typed >= 0) { Return This.OperatorSymbols[typed]; }
        Int bare = This.OperatorIndex(symbol);
        If (bare >= 0) { Return This.OperatorSymbols[bare]; }
        Return "";
    }

    Private Function OperatorType(String leftType, String rightType, String symbol) -> String {
        Int typed = This.OperatorIndex(leftType + symbol);
        If (typed >= 0) { Return This.OperatorReturns[typed]; }
        Int bare = This.OperatorIndex(symbol);
        If (bare >= 0) { Return This.OperatorReturns[bare]; }
        Return "Int";
    }

    Private Function FunctionCount(String name) -> Int {
        Int count = 0;
        For record In This.Functions {
            If (record.Name == name) { count = count + 1; }
        }
        Return count;
    }

    Private Function FunctionSymbol(String fileName, String name) -> String {
        If (This.FunctionCount(name) == 1) { Return "rxf_" + name; }
        Return "rxf_" + This.Stem(fileName) + "_" + name;
    }

    Private Function EmitClassMembers(AstNode node) -> String {
        ClassInfo info = This.FindClass(node.Name);
        String parts = "";
        Int index = 0;
        For ctor In info.Constructors {
            String ctorFile = info.ConstructorFiles[index];
            If (ctorFile == This.FileName) {
                String symbol = "rxm_" + node.Name + "_new";
                If (!This.IsDefined(symbol)) {
                    This.AddDefined(symbol);
                    parts = parts + This.EmitConstructor(symbol, node.Name, ctor);
                }
            }
            index = index + 1;
        }
        For method In info.Methods {
            If (method.FileName == This.FileName) {
                String symbol = "rxm_" + node.Name + "_" + method.Name;
                If (!This.IsDefined(symbol)) {
                    This.AddDefined(symbol);
                    parts = parts + This.EmitMethod(symbol, node.Name, method);
                }
            }
        }
        For child In node.Children {
            If (child.Kind == AstKind.Operator) {
                String symbol = "rxm_" + node.Name + "_" + This.SafeOperator(child.Operator);
                If (!This.IsDefined(symbol)) {
                    This.AddDefined(symbol);
                    parts = parts + This.EmitOperatorFunction(symbol, child);
                }
            }
        }
        Return parts;
    }

    Private Function EmitConstructor(String symbol, String className, AstNode node) -> String {
        This.ResetFunction(className, "Void");
        String arguments = "i64 %p_This";
        For parameter In node.Parameters {
            arguments = arguments + ", i64 %" + This.SafeArg(parameter.Name);
        }
        This.Raw("define void @" + symbol + "(" + arguments + ") {");
        This.Raw("Lentry:");
        This.Alloca("This", className, "%p_This");
        For parameter In node.Parameters {
            String parameterType = This.TypeName(parameter.Type);
            If (parameterType == "") { parameterType = "Int"; }
            This.Alloca(parameter.Name, parameterType, "%" + This.SafeArg(parameter.Name));
        }
        If (node.Body != Null) { This.EmitStatement(node.Body); }
        If (!This.Terminated) { This.Emit("ret void"); }
        This.Raw("}");
        Return This.JoinFunction();
    }

    Private Function EmitMethod(String symbol, String className, MethodInfo method) -> String {
        This.ResetFunction(className, method.ReturnType);
        String arguments = "i64 %p_This";
        For parameter In method.Node.Parameters {
            arguments = arguments + ", i64 %" + This.SafeArg(parameter.Name);
        }
        String ret = "i64";
        If (This.IsVoid(method.ReturnType)) { ret = "void"; }
        This.Raw("define " + ret + " @" + symbol + "(" + arguments + ") {");
        This.Raw("Lentry:");
        This.Alloca("This", className, "%p_This");
        For parameter In method.Node.Parameters {
            String parameterType = This.TypeName(parameter.Type);
            If (parameterType == "") { parameterType = "Int"; }
            This.Alloca(parameter.Name, parameterType, "%" + This.SafeArg(parameter.Name));
        }
        If (method.Node.Body != Null) { This.EmitStatement(method.Node.Body); }
        If (!This.Terminated) {
            If (This.IsVoid(method.ReturnType)) { This.Emit("ret void"); }
            If (!This.IsVoid(method.ReturnType)) { This.Emit("ret i64 0"); }
        }
        This.Raw("}");
        Return This.JoinFunction();
    }

    Private Function EmitOperatorFunction(String symbol, AstNode node) -> String {
        String returnType = This.OperatorResult(node.Type);
        This.ResetFunction("", returnType);
        String arguments = "";
        Bool first = True;
        For parameter In node.Parameters {
            If (!first) { arguments = arguments + ", "; }
            arguments = arguments + "i64 %" + This.SafeArg(parameter.Name);
            first = False;
        }
        String ret = "i64";
        If (This.IsVoid(returnType)) { ret = "void"; }
        This.Raw("define " + ret + " @" + symbol + "(" + arguments + ") {");
        This.Raw("Lentry:");
        For parameter In node.Parameters {
            String parameterType = This.TypeName(parameter.Type);
            If (parameterType == "") { parameterType = "Int"; }
            This.Alloca(parameter.Name, parameterType, "%" + This.SafeArg(parameter.Name));
        }
        If (node.Body != Null) { This.EmitStatement(node.Body); }
        If (!This.Terminated) {
            If (This.IsVoid(returnType)) { This.Emit("ret void"); }
            If (!This.IsVoid(returnType)) { This.Emit("ret i64 0"); }
        }
        This.Raw("}");
        Return This.JoinFunction();
    }

    Private Function EmitPlain(AstNode node) -> String {
        FunctionInfo record = This.FindFunction(node.Name, This.FileName);
        String symbol = This.FunctionSymbol(record.FileName, node.Name);
        If (This.IsDefined(symbol)) { Return ""; }
        This.AddDefined(symbol);
        This.ResetFunction("", record.ReturnType);
        String arguments = "";
        Bool first = True;
        For parameter In node.Parameters {
            If (!first) { arguments = arguments + ", "; }
            arguments = arguments + "i64 %" + This.SafeArg(parameter.Name);
            first = False;
        }
        String ret = "i64";
        If (This.IsVoid(record.ReturnType)) { ret = "void"; }
        This.Raw("define " + ret + " @" + symbol + "(" + arguments + ") {");
        This.Raw("Lentry:");
        For parameter In node.Parameters {
            String parameterType = This.TypeName(parameter.Type);
            If (parameterType == "") { parameterType = "Int"; }
            If (parameter.FlagB) { parameterType = "Array<" + parameterType + ">"; }
            This.Alloca(parameter.Name, parameterType, "%" + This.SafeArg(parameter.Name));
        }
        If (node.Body != Null) {
            This.EmitStatement(node.Body);
        } Else If (node.Left != Null) {
            IrValue exprVal = This.EmitExpr(node.Left);
            If (This.IsVoid(record.ReturnType)) {
                This.Emit("ret void");
            } Else {
                This.Emit("ret i64 " + exprVal.Value);
            }
            This.Terminated = True;
        }
        If (!This.Terminated) {
            If (This.IsVoid(record.ReturnType)) { This.Emit("ret void"); }
            If (!This.IsVoid(record.ReturnType)) { This.Emit("ret i64 0"); }
        }
        This.Raw("}");
        Return This.JoinFunction();
    }

    Private Function DeclareExtern(AstNode node) -> String {
        If (node.Name == "RunProcess") { Return ""; }
        String symbol = This.ExternSymbol(node.Name);
        If (symbol == "rx_F64Parse" || symbol == "rx_F64Text" || symbol == "rx_F64FromInt" || symbol == "rx_F64ToInt" || symbol == "rx_F32Parse" || symbol == "rx_FormatFixed" || symbol == "rx_Input") { Return ""; }
        String args = "";
        Int count = node.Parameters.Count();
        Int index = 0;
        While (index < count) {
            If (index > 0) { args = args + ", "; }
            args = args + "i64";
            index = index + 1;
        }
        String ret = "i64";
        If (This.IsVoid(This.TypeName(node.Type))) { ret = "void"; }
        Return "declare " + ret + " @" + symbol + "(" + args + ")\n";
    }

    Private Function DeclareForeign() -> String {
        String parts = "";
        For record In This.Functions {
            String symbol = This.FunctionSymbol(record.FileName, record.Name);
            If (!record.IsExtern && !This.IsDefined(symbol)) {
                String args = "";
                Int index = 0;
                While (index < record.ArgumentCount) {
                    If (index > 0) { args = args + ", "; }
                    args = args + "i64";
                    index = index + 1;
                }
                String ret = "i64";
                If (This.IsVoid(record.ReturnType)) { ret = "void"; }
                parts = parts + "declare " + ret + " @" + symbol + "(" + args + ")\n";
                This.AddDefined(symbol);
            }
        }
        For info In This.Classes {
            If (info.Name != "ExecutionResult") {
                For method In info.Methods {
                    String symbol = "rxm_" + info.Name + "_" + method.Name;
                    If (method.FileName != This.FileName && !This.IsDefined(symbol)) {
                        String args = "i64";
                        Int index = 0;
                        While (index < method.ArgumentCount) {
                            args = args + ", i64";
                            index = index + 1;
                        }
                        String ret = "i64";
                        If (This.IsVoid(method.ReturnType)) { ret = "void"; }
                        parts = parts + "declare " + ret + " @" + symbol + "(" + args + ")\n";
                        This.AddDefined(symbol);
                    }
                }
                Bool definedHere = False;
                Int foreignArgs = -1;
                Int index = 0;
                For ctor In info.Constructors {
                    If (info.ConstructorFiles[index] == This.FileName) { definedHere = True; }
                    If (info.ConstructorFiles[index] != This.FileName && foreignArgs < 0) {
                        foreignArgs = ctor.Parameters.Count();
                    }
                    index = index + 1;
                }
                String symbol = "rxm_" + info.Name + "_new";
                If (!definedHere && foreignArgs >= 0 && !This.IsDefined(symbol)) {
                    String args = "i64";
                    Int arg = 0;
                    While (arg < foreignArgs) {
                        args = args + ", i64";
                        arg = arg + 1;
                    }
                    parts = parts + "declare void @" + symbol + "(" + args + ")\n";
                    This.AddDefined(symbol);
                }
            }
        }
        Return parts;
    }

    Private Function EntryMain(AstNode module) -> String {
        AstNode mainNode = AstNode();
        Bool found = False;
        For child In module.Children {
            If (child.Kind == AstKind.Function && child.Name == "Main") {
                mainNode = child;
                found = True;
            }
        }
        If (!found) { Return ""; }
        String symbol = This.FunctionSymbol(This.FileName, "Main");
        String startup = "";
        If (This.InitSymbol != "") {
            startup = "  call void @" + This.InitSymbol + "()\n";
        }
        String returnType = This.TypeName(mainNode.Type);
        String call = "";
        If (mainNode.Parameters.Count() == 0) {
            If (returnType == "ExecutionResult") {
                call = startup + "  %result = call i64 @" + symbol + "()\n  %rp = inttoptr i64 %result to ptr\n  %code64 = load i64, ptr %rp\n  %code = trunc i64 %code64 to i32\n  ret i32 %code\n";
            } Else {
                call = startup + "  %result = call i64 @" + symbol + "()\n  %code = trunc i64 %result to i32\n  ret i32 %code\n";
            }
        } Else {
            If (returnType == "ExecutionResult") {
                call = startup + "  %packed = call i64 @rx_args(i32 %argc, ptr %argv)\n  %result = call i64 @" + symbol + "(i64 %packed)\n  %rp = inttoptr i64 %result to ptr\n  %code64 = load i64, ptr %rp\n  %code = trunc i64 %code64 to i32\n  ret i32 %code\n";
            } Else {
                call = startup + "  %packed = call i64 @rx_args(i32 %argc, ptr %argv)\n  %result = call i64 @" + symbol + "(i64 %packed)\n  %code = trunc i64 %result to i32\n  ret i32 %code\n";
            }
        }
        Return "declare i64 @rx_args(i32, ptr)\ndeclare void @rx_finish_result(i64)\n\ndefine i32 @main(i32 %argc, ptr %argv) {\n" + call + "}\n";
    }

    Private Function RuntimeDeclarations() -> String {
        String names = "rx_str_len rx_str_eq rx_str_concat rx_str_substr rx_str_get rx_str_lower rx_str_upper rx_str_starts rx_str_ends rx_str_contains rx_str_index rx_str_rindex rx_str_replace rx_str_to_int rx_str_from_int rx_str_from_bool rx_str_from_char rx_str_from_chars rx_str_trim rx_str_split rx_list_new rx_list_count rx_list_get rx_list_take_front rx_list_take_back rx_range rx_map_new rx_map_get rx_set_has rx_obj_new rx_obj_get rx_file_read rx_file_exists rx_file_name rx_file_join rx_dir_exists rx_dir_files rx_env_get rx_process rx_math_gcd rx_math_isqrt rx_F64Parse rx_F64Text rx_F64FromInt rx_F64ToInt rx_F32Parse rx_FormatFixed rx_AnyText rx_any_list_text rx_any_map_text rx_AnyToInt rx_AnyToFloat rx_AnyLength rx_AnyUpper rx_AnyLower rx_Input";
        String voids = "rx_list_add rx_list_set rx_list_sort rx_list_reverse rx_map_put rx_set_add rx_obj_set rx_print rx_file_write_text rx_file_write_bytes rx_file_delete rx_dir_create rx_dir_delete";
        String lines = "";
        Int start = 0;
        While (start < names.Length()) {
            Int end = names.IndexOf(" ", start);
            String name = "";
            If (end < 0) {
                name = names.Substring(start);
                start = names.Length();
            } Else {
                name = names.Substring(start, end - start);
                start = end + 1;
            }
            lines = lines + "declare i64 @" + name + "(...)\n";
        }
        start = 0;
        While (start < voids.Length()) {
            Int end = voids.IndexOf(" ", start);
            String name = "";
            If (end < 0) {
                name = voids.Substring(start);
                start = voids.Length();
            } Else {
                name = voids.Substring(start, end - start);
                start = end + 1;
            }
            lines = lines + "declare void @" + name + "(...)\n";
        }
        Return lines + "\n";
    }

    Private Function ResetFunction(String owner, String returnType) -> Void {
        This.Owner = owner;
        This.ReturnType = returnType;
        This.Lines = List<String>();
        This.Strings = List<String>();
        This.Counter = 0;
        This.Terminated = False;
        This.ScopeNames = List<String>();
        This.ScopeSlots = List<String>();
        This.ScopeTypes = List<String>();
        This.ScopeCount = 0;
        This.LoopContinue = List<String>();
        This.LoopBreak = List<String>();
        This.LoopCount = 0;
        This.BindGlobals();
    }

    Private Function BindGlobals() -> Void {
        Int index = 0;
        While (index < This.GlobalNames.Count()) {
            This.Bind(This.GlobalNames[index], This.GlobalSlots[index], This.GlobalTypes[index]);
            index = index + 1;
        }
    }

    Private Function PrepareGlobals(AstNode module) -> String {
        This.GlobalNames = List<String>();
        This.GlobalSlots = List<String>();
        This.GlobalTypes = List<String>();
        This.InitSymbol = "";
        Var nodes = List<AstNode>();
        For child In module.Children {
            This.CollectGlobals(child, nodes);
        }
        If (nodes.Count() == 0) { Return ""; }
        String declarations = "";
        Int index = 0;
        For node In nodes {
            If (node.FlagC) {
                For child In node.Children {
                    String slot = "@g" + index.ToString();
                    declarations = declarations + slot + " = global i64 0\n";
                    This.GlobalNames.Add(child.Name);
                    This.GlobalSlots.Add(slot);
                    This.GlobalTypes.Add("Int");
                    index = index + 1;
                }
            } Else {
                String slot = "@g" + index.ToString();
                declarations = declarations + slot + " = global i64 0\n";
                String typeName = This.TypeName(node.Type);
                If (typeName == "") { typeName = "Int"; }
                This.GlobalNames.Add(node.Name);
                This.GlobalSlots.Add(slot);
                This.GlobalTypes.Add(typeName);
                index = index + 1;
            }
        }
        This.InitSymbol = "rxinit_" + This.Stem(This.FileName);
        This.ResetFunction("", "Void");
        This.Raw("define void @" + This.InitSymbol + "() {");
        This.Raw("Lentry:");
        index = 0;
        For node In nodes {
            If (node.FlagC && node.Initializer != Null && node.Initializer.Kind == AstKind.TupleLiteral) {
                Int part = 0;
                For child In node.Children {
                    String value = "0";
                    String typeName = "Int";
                    If (part < node.Initializer.Children.Count()) {
                        IrValue initial = This.EmitExpr(node.Initializer.Children[part]);
                        value = initial.Value;
                        If (initial.TypeName != "") { typeName = initial.TypeName; }
                    }
                    This.GlobalTypes[index] = typeName;
                    This.ScopeTypes[index] = typeName;
                    This.Emit("store i64 " + value + ", ptr " + This.GlobalSlots[index]);
                    index = index + 1;
                    part = part + 1;
                }
            } Else If (!node.FlagC) {
                String value = "0";
                If (node.Initializer != Null) {
                    IrValue initial = This.EmitExpr(node.Initializer);
                    value = initial.Value;
                    If (node.Type == Null && initial.TypeName != "") {
                        This.GlobalTypes[index] = initial.TypeName;
                        This.ScopeTypes[index] = initial.TypeName;
                    }
                }
                This.Emit("store i64 " + value + ", ptr " + This.GlobalSlots[index]);
                index = index + 1;
            } Else {
                For child In node.Children {
                    This.Emit("store i64 0, ptr " + This.GlobalSlots[index]);
                    index = index + 1;
                }
            }
        }
        If (!This.Terminated) { This.Emit("ret void"); }
        This.Raw("}");
        Return declarations + This.JoinFunction();
    }

    Private Function CollectGlobals(AstNode node, List<AstNode> nodes) -> Void {
        If (node.Kind != AstKind.Variable) { Return; }
        If (node.FlagC) {
            nodes.Add(node);
            Return;
        }
        If (node.Name != "") { nodes.Add(node); }
        For child In node.Children {
            This.CollectGlobals(child, nodes);
        }
    }

    Private Function Fresh(String prefix) -> String {
        This.Counter = This.Counter + 1;
        Return "%" + prefix + This.Counter.ToString();
    }

    Private Function Label(String prefix) -> String {
        This.Counter = This.Counter + 1;
        Return prefix + This.Counter.ToString();
    }

    Private Function Emit(String text) -> Void {
        If (!This.Terminated) { This.Lines.Add("  " + text); }
    }

    Private Function Raw(String text) -> Void {
        This.Lines.Add(text);
    }

    Private Function Branch(String label) -> Void {
        This.Emit("br label %" + label);
        This.Terminated = True;
    }

    Private Function Block(String name) -> Void {
        This.Lines.Add(name + ":");
        This.Terminated = False;
    }

    Private Function Bind(String name, String slot, String typeName) -> Void {
        If (This.ScopeCount < This.ScopeNames.Count()) {
            This.ScopeNames[This.ScopeCount] = name;
            This.ScopeSlots[This.ScopeCount] = slot;
            This.ScopeTypes[This.ScopeCount] = typeName;
        } Else {
            This.ScopeNames.Add(name);
            This.ScopeSlots.Add(slot);
            This.ScopeTypes.Add(typeName);
        }
        This.ScopeCount = This.ScopeCount + 1;
    }

    Private Function Lookup(String name) -> IrValue {
        Int index = This.ScopeCount - 1;
        While (index >= 0) {
            If (This.ScopeNames[index] == name) {
                Return This.Pair(This.ScopeSlots[index], This.ScopeTypes[index]);
            }
            index = index - 1;
        }
        Return This.Pair("", "");
    }

    Private Function Alloca(String name, String typeName, String value) -> String {
        String slot = This.Fresh("slot");
        This.Emit(slot + " = alloca i64");
        This.Emit("store i64 " + value + ", ptr " + slot);
        This.Bind(name, slot, typeName);
        Return slot;
    }

    Private Function LoadSlot(String slot) -> String {
        String loaded = This.Fresh("v");
        This.Emit(loaded + " = load i64, ptr " + slot);
        Return loaded;
    }

    Private Function StringConst(String text) -> String {
        This.Strings.Add(text);
        Int index = This.Strings.Count();
        EscapeText escaped = This.Escape(text);
        Int length = escaped.Bytes + 1;
        String name = "@str" + index.ToString();
        String pointer = This.Fresh("str");
        This.Emit(pointer + " = getelementptr [" + length.ToString() + " x i8], ptr " + name + ", i64 0, i64 0");
        String packed = This.Fresh("v");
        This.Emit(packed + " = ptrtoint ptr " + pointer + " to i64");
        Return packed;
    }

    Private Function CallRuntime(String symbol, List<String> args, Bool voidCall) -> IrValue {
        String rendered = "";
        Int index = 0;
        For arg In args {
            If (index > 0) { rendered = rendered + ", "; }
            rendered = rendered + "i64 " + arg;
            index = index + 1;
        }
        If (voidCall) {
            This.Emit("call void @" + symbol + "(" + rendered + ")");
            Return This.Pair("0", "Void");
        }
        String result = This.Fresh("v");
        This.Emit(result + " = call i64 @" + symbol + "(" + rendered + ")");
        Return This.Pair(result, "Int");
    }

    Private Function EmitBlock(AstNode node) -> Void {
        Int mark = This.ScopeCount;
        For child In node.Children { This.EmitStatement(child); }
        This.ScopeCount = mark;
    }

    Private Function EmitStatement(AstNode node) -> Void {
        If (This.Terminated) { Return; }
        If (node.Kind == AstKind.Explain || node.Kind == AstKind.ExplainEntry) { Return; }
        If (node.Kind == AstKind.Variable) {
            If (node.FlagC) {
                This.EmitTupleBinding(node);
                Return;
            }
            String typeName = This.TypeName(node.Type);
            String value = "0";
            String sourceType = "Int";
            If (node.Initializer != Null) {
                Bool open = typeName == "" && (node.Initializer.Kind == AstKind.ArrayLiteral || node.Initializer.Kind == AstKind.MapLiteral || node.Initializer.Kind == AstKind.SetLiteral);
                If (open) { This.UntypedLiteral = True; }
                IrValue initial = This.EmitExpr(node.Initializer);
                This.UntypedLiteral = False;
                value = initial.Value;
                sourceType = initial.TypeName;
                If (typeName == "" || typeName == "Tuple") { typeName = sourceType; }
            }
            If (typeName == "") { typeName = "Int"; }
            If (typeName == "Decimal" && sourceType != "Decimal" && node.Initializer != Null) {
                If (node.Initializer.Kind == AstKind.FloatLiteral) {
                    value = This.StringConst(This.FloatSpelling(node.Initializer.Text));
                } Else If (node.Initializer.Kind == AstKind.IntegerLiteral) {
                    value = This.StringConst(This.Digits(node.Initializer.Text) + ".0");
                }
            }
            If ((typeName == "Float32" || typeName == "Float16") && This.IsFloatType(sourceType) && sourceType != "Float32" && sourceType != "Float16") {
                value = This.NarrowFloat32(value);
            }
            If (This.IsWrappedInteger(typeName) && !This.IsFloatType(sourceType) && !This.IsString(sourceType) && sourceType != "Decimal") {
                value = This.WrapInteger(value, typeName);
            }
            If (This.IsAnyType(typeName)) {
                IrValue boxed = This.BoxAny(This.Pair(value, sourceType));
                value = boxed.Value;
            }
            If (node.Name != "") { This.Alloca(node.Name, typeName, value); }
            For child In node.Children { This.EmitStatement(child); }
            Return;
        }
        If (node.Kind == AstKind.Return) {
            If (This.IsVoid(This.ReturnType)) {
                This.Emit("ret void");
            } Else {
                String value = "0";
                If (node.Left != Null) {
                    IrValue returned = This.EmitExpr(node.Left);
                    value = returned.Value;
                }
                This.Emit("ret i64 " + value);
            }
            This.Terminated = True;
            Return;
        }
        If (node.Kind == AstKind.Break && This.LoopCount > 0) {
            This.Branch(This.LoopBreak[This.LoopCount - 1]);
            Return;
        }
        If (node.Kind == AstKind.Continue && This.LoopCount > 0) {
            This.Branch(This.LoopContinue[This.LoopCount - 1]);
            Return;
        }
        If (node.Kind == AstKind.If) { This.EmitIf(node); Return; }
        If (node.Kind == AstKind.While || node.Kind == AstKind.DoWhile || node.Kind == AstKind.Repeat || node.Kind == AstKind.Loop) { This.EmitWhile(node); Return; }
        If (node.Kind == AstKind.For) { This.EmitFor(node); Return; }
        If (node.Kind == AstKind.Block) { This.EmitBlock(node); Return; }
        If (node.Kind == AstKind.Match) { This.EmitMatch(node); Return; }
        If (node.Kind == AstKind.ExpressionStatement) {
            If (node.Left != Null) { This.EmitExpr(node.Left); }
            Return;
        }
        If (node.Kind == AstKind.Assignment) { This.EmitAssignment(node); }
    }

    Private Function EmitMatch(AstNode node) -> Void {
        IrValue scrutinee = This.Pair("0", "Int");
        If (node.Left != Null) { scrutinee = This.EmitExpr(node.Left); }
        String payload = scrutinee.Value;
        String tag = "0";
        String typeName = "0";
        Bool boxed = This.IsAnyType(scrutinee.TypeName);
        If (boxed) {
            tag = This.LoadObjectField(scrutinee.Value, "0");
            payload = This.LoadObjectField(scrutinee.Value, "1");
            typeName = This.LoadObjectField(scrutinee.Value, "2");
        }
        String done = This.Label("mend");
        For arm In node.Children {
            String next = This.Label("mnext");
            String body = This.Label("mbody");
            Bool wildcard = arm.Left != Null && arm.Left.FlagA;
            If (wildcard) {
                This.Branch(body);
            } Else If (!boxed && arm.Left != Null && (arm.Left.Text == "Some" || arm.Left.Text == "Success" || arm.Left.Text == "None" || arm.Left.Text == "Error" || arm.Left.Text == "Failure")) {
                String wtag = This.LoadListItem(scrutinee.Value, "1");
                String cond = This.Fresh("cond");
                String want = "0";
                If (arm.Left.Text == "Some" || arm.Left.Text == "Success") { want = "1"; }
                This.Emit(cond + " = icmp eq i64 " + wtag + ", " + want);
                This.Emit("br i1 " + cond + ", label %" + body + ", label %" + next);
                This.Terminated = True;
            } Else {
                String cond = This.EmitPatternCond(arm.Left, boxed, tag, typeName, scrutinee.TypeName);
                This.Emit("br i1 " + cond + ", label %" + body + ", label %" + next);
                This.Terminated = True;
            }
            This.Block(body);
            Int mark = This.ScopeCount;
            If (arm.Left != Null) {
                If (arm.Left.Children.Count() > 0) {
                    AstNode child = arm.Left.Children[0];
                    If (child.Name.Length() > 0 && child.Name != "_") {
                        String innerVal = This.LoadListItem(payload, "0");
                        String innerType = This.WrappedType(scrutinee.TypeName);
                        If (arm.Left.Text == "Error" || arm.Left.Text == "Failure") { innerType = "String"; }
                        This.Alloca(child.Name, innerType, innerVal);
                    }
                } Else {
                    This.BindMatchName(arm.Left, payload);
                }
            }
            If (arm.Right != Null) {
                If (arm.Right.Kind == AstKind.Block) { This.EmitStatement(arm.Right); }
                If (arm.Right.Kind != AstKind.Block) { This.EmitExpr(arm.Right); }
            }
            If (!This.Terminated) { This.Branch(done); }
            This.ScopeCount = mark;
            This.Block(next);
        }
        If (!This.Terminated) { This.Branch(done); }
        This.Block(done);
    }

    Private Function EmitPatternCond(AstNode? pattern, Bool boxed, String tag, String typeName, String staticType) -> String {
        String expected = "";
        If (pattern != Null) { expected = pattern.Text; }
        If (!boxed) {
            String flag = This.Fresh("cond");
            String same = "0";
            If (expected.Length() == 0 || staticType == expected) { same = "1"; }
            This.Emit(flag + " = icmp eq i64 " + same + ", 1");
            Return flag;
        }
        Int code = 0;
        If (expected == "Int" || expected == "Int64") { code = 1; }
        If (expected == "String") { code = 2; }
        If (expected == "Bool") { code = 3; }
        If (expected == "Char") { code = 4; }
        If (expected == "Float" || expected == "Double" || expected == "Float64") { code = 5; }
        If (code > 0) {
            String flag = This.Fresh("cond");
            This.Emit(flag + " = icmp eq i64 " + tag + ", " + code.ToString());
            Return flag;
        }
        String tagOk = This.Fresh("cond");
        This.Emit(tagOk + " = icmp eq i64 " + tag + ", 8");
        Var args = List<String>();
        args.Add(typeName);
        args.Add(This.StringConst(expected));
        IrValue same = This.CallRuntime("rx_str_eq", args, False);
        String nameOk = This.Fresh("cond");
        This.Emit(nameOk + " = icmp ne i64 " + same.Value + ", 0");
        String both = This.Fresh("cond");
        This.Emit(both + " = and i1 " + tagOk + ", " + nameOk);
        Return both;
    }

    Private Function BindMatchName(AstNode pattern, String payload) -> Void {
        If (pattern.Name.Length() == 0 || pattern.Name == "_" || pattern.Name == "()") { Return; }
        String bindType = pattern.Text;
        If (bindType.Length() == 0) { bindType = "Any"; }
        This.Alloca(pattern.Name, bindType, payload);
    }

    Private Function EmitIf(AstNode node) -> Void {
        IrValue condition = This.EmitExpr(node.Condition);
        String flag = This.Fresh("cond");
        This.Emit(flag + " = icmp ne i64 " + condition.Value + ", 0");
        String thenLabel = This.Label("then");
        String elseLabel = This.Label("else");
        String mergeLabel = This.Label("merge");
        This.Emit("br i1 " + flag + ", label %" + thenLabel + ", label %" + elseLabel);
        This.Terminated = True;
        This.Block(thenLabel);
        If (node.Body != Null) { This.EmitStatement(node.Body); }
        If (!This.Terminated) { This.Branch(mergeLabel); }
        This.Block(elseLabel);
        If (node.Otherwise != Null) { This.EmitStatement(node.Otherwise); }
        If (!This.Terminated) { This.Branch(mergeLabel); }
        This.Block(mergeLabel);
    }

    Private Function EmitWhile(AstNode node) -> Void {
        If (node.Kind == AstKind.DoWhile) {
            String body = This.Label("dbody");
            String check = This.Label("dcheck");
            String done = This.Label("dend");
            This.Branch(body);
            This.Block(body);
            This.PushLoop(check, done);
            If (node.Body != Null) { This.EmitStatement(node.Body); }
            This.PopLoop();
            If (!This.Terminated) { This.Branch(check); }
            This.Block(check);
            IrValue condition = This.EmitExpr(node.Condition);
            String flag = This.Fresh("cond");
            This.Emit(flag + " = icmp ne i64 " + condition.Value + ", 0");
            This.Emit("br i1 " + flag + ", label %" + body + ", label %" + done);
            This.Terminated = True;
            This.Block(done);
            Return;
        }
        If (node.Kind == AstKind.Repeat) {
            IrValue count = This.EmitExpr(node.Condition);
            String idxName = "#repeat_" + This.Label("r");
            This.Alloca(idxName, "Int", "0");
            String head = This.Label("repeat");
            String body = This.Label("rbody");
            String step = This.Label("rstep");
            String done = This.Label("rend");
            This.Branch(head);
            This.Block(head);
            String current = This.LoadName(idxName);
            String flag = This.Fresh("cond");
            This.Emit(flag + " = icmp slt i64 " + current + ", " + count.Value);
            This.Emit("br i1 " + flag + ", label %" + body + ", label %" + done);
            This.Terminated = True;
            This.Block(body);
            This.PushLoop(step, done);
            If (node.Body != Null) { This.EmitStatement(node.Body); }
            This.PopLoop();
            If (!This.Terminated) { This.Branch(step); }
            This.Block(step);
            String now = This.LoadName(idxName);
            String next = This.Fresh("v");
            This.Emit(next + " = add i64 " + now + ", 1");
            This.StoreName(idxName, next);
            This.Branch(head);
            This.Block(done);
            Return;
        }
        If (node.Kind == AstKind.Loop) {
            String body = This.Label("lbody");
            String done = This.Label("lend");
            This.Branch(body);
            This.Block(body);
            This.PushLoop(body, done);
            If (node.Body != Null) { This.EmitStatement(node.Body); }
            This.PopLoop();
            If (!This.Terminated) { This.Branch(body); }
            This.Block(done);
            Return;
        }
        String head = This.Label("while");
        String body = This.Label("wbody");
        String done = This.Label("wend");
        This.Branch(head);
        This.Block(head);
        IrValue condition = This.EmitExpr(node.Condition);
        String flag = This.Fresh("cond");
        This.Emit(flag + " = icmp ne i64 " + condition.Value + ", 0");
        This.Emit("br i1 " + flag + ", label %" + body + ", label %" + done);
        This.Terminated = True;
        This.Block(body);
        This.PushLoop(head, done);
        If (node.Body != Null) { This.EmitStatement(node.Body); }
        This.PopLoop();
        If (!This.Terminated) { This.Branch(head); }
        This.Block(done);
    }

    Private Function EmitFor(AstNode node) -> Void {
        Int mark = This.ScopeCount;
        If (node.FlagB) {
            If (node.Initializer != Null) {
                If (node.Initializer.Kind == AstKind.Variable || node.Initializer.Kind == AstKind.Assignment) {
                    This.EmitStatement(node.Initializer);
                } Else {
                    This.EmitExpr(node.Initializer);
                }
            }
            String head = This.Label("for");
            String body = This.Label("fbody");
            String step = This.Label("fstep");
            String done = This.Label("fend");
            This.Branch(head);
            This.Block(head);
            If (node.Condition != Null) {
                IrValue condition = This.EmitExpr(node.Condition);
                String flag = This.Fresh("cond");
                This.Emit(flag + " = icmp ne i64 " + condition.Value + ", 0");
                This.Emit("br i1 " + flag + ", label %" + body + ", label %" + done);
                This.Terminated = True;
            } Else {
                This.Branch(body);
            }
            This.Block(body);
            This.PushLoop(step, done);
            If (node.Body != Null) { This.EmitStatement(node.Body); }
            This.PopLoop();
            If (!This.Terminated) { This.Branch(step); }
            This.Block(step);
            If (node.Extra != Null) {
                If (node.Extra.Kind == AstKind.Assignment) {
                    This.EmitAssignment(node.Extra);
                } Else {
                    This.EmitExpr(node.Extra);
                }
            }
            This.Branch(head);
            This.Block(done);
            This.ScopeCount = mark;
            Return;
        }
        String itemName = "item";
        If (node.Left != Null && node.Left.Name != "") { itemName = node.Left.Name; }
        If (node.Right != Null && node.Right.Kind == AstKind.Range) {
            IrValue start = This.EmitExpr(node.Right.Left);
            IrValue end = This.EmitExpr(node.Right.Right);
            This.Alloca(itemName, "Int", start.Value);
            String head = This.Label("for");
            String body = This.Label("fbody");
            String step = This.Label("fstep");
            String done = This.Label("fend");
            This.Branch(head);
            This.Block(head);
            String current = This.LoadName(itemName);
            String flag = This.Fresh("cond");
            String op = "slt";
            If (node.Right.Operator == "..=") { op = "sle"; }
            This.Emit(flag + " = icmp " + op + " i64 " + current + ", " + end.Value);
            This.Emit("br i1 " + flag + ", label %" + body + ", label %" + done);
            This.Terminated = True;
            This.Block(body);
            This.PushLoop(step, done);
            If (node.Body != Null) { This.EmitStatement(node.Body); }
            This.PopLoop();
            If (!This.Terminated) { This.Branch(step); }
            This.Block(step);
            String now = This.LoadName(itemName);
            String next = This.Fresh("v");
            This.Emit(next + " = add i64 " + now + ", 1");
            This.StoreName(itemName, next);
            This.Branch(head);
            This.Block(done);
            This.ScopeCount = mark;
            Return;
        }
        IrValue collection = This.Pair("0", "List:Int");
        If (node.Right != Null) { collection = This.EmitExpr(node.Right); }
        Bool tuplePattern = node.Left != Null && node.Left.Children.Count() >= 2;
        String tupleIndexVar = "";
        String tupleValueVar = "";
        If (tuplePattern) {
            tupleIndexVar = node.Left.Children[0].Name;
            tupleValueVar = node.Left.Children[1].Name;
            This.Alloca(tupleIndexVar, "Int", "0");
            This.Alloca(tupleValueVar, This.ElementType(collection.TypeName), "0");
        } Else {
            This.Alloca(itemName, This.ElementType(collection.TypeName), "0");
        }
        String indexName = itemName + "#index";
        This.Alloca(indexName, "Int", "0");
        String total = This.LoadListCount(collection.Value);
        String head = This.Label("for");
        String body = This.Label("fbody");
        String step = This.Label("fstep");
        String done = This.Label("fend");
        This.Branch(head);
        This.Block(head);
        String index = This.LoadName(indexName);
        String flag = This.Fresh("cond");
        This.Emit(flag + " = icmp slt i64 " + index + ", " + total);
        This.Emit("br i1 " + flag + ", label %" + body + ", label %" + done);
        This.Terminated = True;
        This.Block(body);
        String currentIndex = This.LoadName(indexName);
        String item = This.LoadListItem(collection.Value, currentIndex);
        If (tuplePattern) {
            This.StoreName(tupleIndexVar, currentIndex);
            This.StoreName(tupleValueVar, item);
        } Else {
            This.StoreName(itemName, item);
        }
        This.PushLoop(step, done);
        If (node.Body != Null) { This.EmitStatement(node.Body); }
        This.PopLoop();
        If (!This.Terminated) { This.Branch(step); }
        This.Block(step);
        String now = This.LoadName(indexName);
        String next = This.Fresh("v");
        This.Emit(next + " = add i64 " + now + ", 1");
        This.StoreName(indexName, next);
        This.Branch(head);
        This.Block(done);
        This.ScopeCount = mark;
    }

    Private Function LoadName(String name) -> String {
        IrValue found = This.Lookup(name);
        If (found.Value == "") { Return "0"; }
        Return This.LoadSlot(found.Value);
    }

    Private Function StoreName(String name, String value) -> Void {
        IrValue found = This.Lookup(name);
        If (found.Value == "") { Return; }
        This.Emit("store i64 " + value + ", ptr " + found.Value);
    }

    Private Function EmitAssignment(AstNode node) -> IrValue {
        If (node.Left != Null && node.Left.Kind == AstKind.TupleLiteral) {
            Return This.EmitTupleAssignment(node);
        }
        IrValue value = This.Pair("0", "Int");
        If (node.Left != Null && node.Left.Kind == AstKind.Name && node.Operator != "=" && node.Operator != "") {
            IrValue current = This.Lookup(node.Left.Name);
            IrValue loaded = This.Pair(This.LoadSlot(current.Value), current.TypeName);
            IrValue right = This.EmitExpr(node.Right);
            value = This.CombineAssignment(node.Operator, loaded, right);
            This.StoreName(node.Left.Name, value.Value);
            Return value;
        }
        If (node.Right != Null) { value = This.EmitExpr(node.Right); }
        If (node.Left == Null) { Return value; }
        If (node.Left.Kind == AstKind.Name) {
            value = This.ValueForStore(node.Left.Name, value);
            This.StoreName(node.Left.Name, value.Value);
            Return value;
        }
        If (node.Left.Kind == AstKind.Member) {
            IrValue receiver = This.EmitExpr(node.Left.Left);
            Int index = This.FieldSlot(This.FindClass(receiver.TypeName), node.Left.Name);
            If (index < 0) { index = 0; }
            This.StoreObjectField(receiver.Value, index.ToString(), value.Value);
            Return value;
        }
        If (node.Left.Kind == AstKind.Index) {
            IrValue collection = This.EmitExpr(node.Left.Left);
            IrValue index = This.EmitExpr(node.Left.Right);
            IrValue stored = value;
            If (This.ElementType(collection.TypeName) == "Any" || This.MapValueType(collection.TypeName) == "Any") {
                stored = This.BoxAny(value);
            }
            If (collection.TypeName.StartsWith("Map<")) {
                Var args = List<String>();
                args.Add(collection.Value);
                args.Add(index.Value);
                args.Add(stored.Value);
                This.CallRuntime("rx_map_put", args, True);
            } Else {
                This.StoreListItem(collection.Value, index.Value, stored.Value);
            }
        }
        Return value;
    }

    Private Function CombineAssignment(String operator, IrValue left, IrValue right) -> IrValue {
        AstNode synthetic = AstNode();
        synthetic.Kind = AstKind.Binary;
        synthetic.Operator = "+";
        If (operator == "-=") { synthetic.Operator = "-"; }
        If (operator == "*=") { synthetic.Operator = "*"; }
        If (operator == "/=") { synthetic.Operator = "/"; }
        If (operator == "%=") { synthetic.Operator = "%"; }
        If (This.IsFloatType(left.TypeName) || This.IsFloatType(right.TypeName)) {
            Return This.EmitFloatBinary(synthetic.Operator, left, right);
        }
        String result = This.Fresh("v");
        String opcode = "add";
        If (synthetic.Operator == "-") { opcode = "sub"; }
        If (synthetic.Operator == "*") { opcode = "mul"; }
        If (synthetic.Operator == "/") { opcode = "sdiv"; }
        If (synthetic.Operator == "%") { opcode = "srem"; }
        This.Emit(result + " = " + opcode + " i64 " + left.Value + ", " + right.Value);
        Return This.Pair(result, "Int");
    }

    Private Function EmitTupleBinding(AstNode node) -> Void {
        If (node.Initializer != Null && node.Initializer.Kind == AstKind.TupleLiteral) {
            Int index = 0;
            For child In node.Children {
                String typeName = "Int";
                String value = "0";
                If (index < node.Initializer.Children.Count()) {
                    IrValue initial = This.EmitExpr(node.Initializer.Children[index]);
                    value = initial.Value;
                    If (initial.TypeName != "") { typeName = initial.TypeName; }
                }
                This.Alloca(child.Name, typeName, value);
                index = index + 1;
            }
            Return;
        }
        If (node.Initializer != Null) {
            IrValue tuple = This.EmitExpr(node.Initializer);
            Int index = 0;
            For child In node.Children {
                String indexText = index.ToString();
                String value = This.LoadListItem(tuple.Value, indexText);
                String typeName = "Int";
                If (tuple.TypeName.StartsWith("(")) {
                    typeName = This.TupleElement(tuple.TypeName, indexText);
                }
                This.Alloca(child.Name, typeName, value);
                index = index + 1;
            }
            Return;
        }
        For child In node.Children {
            This.Alloca(child.Name, "Int", "0");
        }
    }

    Private Function EmitTupleAssignment(AstNode node) -> IrValue {
        Var values = List<String>();
        Var types = List<String>();
        If (node.Right != Null && node.Right.Kind == AstKind.TupleLiteral) {
            For child In node.Right.Children {
                IrValue initial = This.EmitExpr(child);
                values.Add(initial.Value);
                types.Add(initial.TypeName);
            }
        }
        Int index = 0;
        For target In node.Left.Children {
            String value = "0";
            If (index < values.Count()) { value = values[index]; }
            If (target.Kind == AstKind.Name) { This.StoreName(target.Name, value); }
            index = index + 1;
        }
        If (values.Count() == 0) { Return This.Pair("0", "Int"); }
        Return This.Pair(values[0], types[0]);
    }

    Private Function EmitExpr(AstNode node) -> IrValue {
        If (node.Kind == AstKind.IntegerLiteral) {
            String literalType = This.LiteralTypeName(node.Text);
            Return This.Pair(This.WrapInteger(This.Digits(node.Text), literalType), literalType);
        }
        If (node.Kind == AstKind.FloatLiteral) {
            String literalType = This.LiteralTypeName(node.Text);
            If (literalType == "Decimal") { Return This.Pair(This.StringConst(This.FloatSpelling(node.Text)), "Decimal"); }
            Return This.Pair(This.EmitFloatBits(node.Text), literalType);
        }
        If (node.Kind == AstKind.StringLiteral) {
            If (node.FlagA && node.Children.Count() > 0) { Return This.EmitInterpolation(node); }
            Return This.Pair(This.StringConst(node.Text), "String");
        }
        If (node.Kind == AstKind.CharLiteral) {
            If (node.Text.Length() == 0) { Return This.Pair("0", "Char"); }
            Return This.Pair(node.Text.GetChar(0).ToInt().ToString(), "Char");
        }
        If (node.Kind == AstKind.BooleanLiteral) {
            If (node.FlagA) { Return This.Pair("1", "Bool"); }
            Return This.Pair("0", "Bool");
        }
        If (node.Kind == AstKind.NullLiteral) { Return This.Pair("0", "Null"); }
        If (node.Kind == AstKind.Name) {
            If (node.Name == "True" && This.Lookup(node.Name).Value == "") { Return This.Pair("1", "Bool"); }
            If (node.Name == "False" && This.Lookup(node.Name).Value == "") { Return This.Pair("0", "Bool"); }
            IrValue found = This.Lookup(node.Name);
            If (found.Value != "") { Return This.Pair(This.LoadSlot(found.Value), found.TypeName); }
            ClassInfo info = This.FindClass(node.Name);
            If (info.Name != "") { Return This.Pair("0", node.Name); }
            Return This.Pair("0", "Int");
        }
        If (node.Kind == AstKind.Member) { Return This.EmitMember(node); }
        If (node.Kind == AstKind.Call) { Return This.EmitCall(node); }
        If (node.Kind == AstKind.Index) {
            IrValue collection = This.EmitExpr(node.Left);
            IrValue index = This.EmitExpr(node.Right);
            Var args = List<String>();
            args.Add(collection.Value);
            args.Add(index.Value);
            If (This.IsString(collection.TypeName)) {
                IrValue value = This.CallRuntime("rx_str_get", args, False);
                Return This.Pair(value.Value, "Char");
            }
            If (collection.TypeName.StartsWith("Map<")) {
                IrValue value = This.CallRuntime("rx_map_get", args, False);
                Return This.Pair(value.Value, This.MapValueType(collection.TypeName));
            }
            String value = This.LoadListItem(collection.Value, index.Value);
            If (collection.TypeName.StartsWith("(")) {
                Return This.Pair(value, This.TupleElement(collection.TypeName, index.Value));
            }
            Return This.Pair(value, This.ElementType(collection.TypeName));
        }
        If (node.Kind == AstKind.Unary) {
            If ((node.Operator == "++" || node.Operator == "--") && node.Left != Null && node.Left.Kind == AstKind.Name) {
                IrValue current = This.Lookup(node.Left.Name);
                String loaded = This.LoadSlot(current.Value);
                String next = This.Fresh("v");
                String opcode = "add";
                If (node.Operator == "--") { opcode = "sub"; }
                This.Emit(next + " = " + opcode + " i64 " + loaded + ", 1");
                This.StoreName(node.Left.Name, next);
                If (node.FlagA) { Return This.Pair(loaded, current.TypeName); }
                Return This.Pair(next, current.TypeName);
            }
            IrValue value = This.EmitExpr(node.Left);
            If (node.Operator == "!" || node.Operator == "Not") {
                String flag = This.Fresh("v");
                This.Emit(flag + " = icmp eq i64 " + value.Value + ", 0");
                String result = This.Fresh("v");
                This.Emit(result + " = zext i1 " + flag + " to i64");
                Return This.Pair(result, "Bool");
            }
            If (node.Operator == "-" && This.IsFloatType(value.TypeName)) {
                String operand = This.Fresh("v");
                This.Emit(operand + " = bitcast i64 " + value.Value + " to double");
                String negated = This.Fresh("v");
                This.Emit(negated + " = fneg double " + operand);
                String bits = This.Fresh("v");
                This.Emit(bits + " = bitcast double " + negated + " to i64");
                Return This.Pair(bits, "Float");
            }
            String result = This.Fresh("v");
            This.Emit(result + " = sub i64 0, " + value.Value);
            Return This.Pair(result, value.TypeName);
        }
        If (node.Kind == AstKind.Ternary) { Return This.EmitTernary(node); }
        If (node.Kind == AstKind.TypeCheck) { Return This.EmitTypeCheck(node); }
        If (node.Kind == AstKind.Range) { Return This.EmitRange(node); }
        If (node.Kind == AstKind.Binary) { Return This.EmitBinary(node); }
        If (node.Kind == AstKind.Assignment) { Return This.EmitAssignment(node); }
        If (node.Kind == AstKind.Match) {
            This.EmitMatch(node);
            Return This.Pair("0", "Void");
        }
        If (node.Kind == AstKind.Unwrap || node.Kind == AstKind.Propagate) {
            If (node.Left == Null) { Return This.Pair("0", "Int"); }
            IrValue inner = This.EmitExpr(node.Left);
            If (inner.TypeName.EndsWith("?")) {
                Return This.Pair(inner.Value, inner.TypeName.Substring(0, inner.TypeName.Length() - 1));
            }
            If (inner.TypeName.StartsWith("Option<") || inner.TypeName.StartsWith("Result<")) {
                String unwrapped = This.LoadListItem(inner.Value, "0");
                Return This.Pair(unwrapped, This.WrappedType(inner.TypeName));
            }
            Return inner;
        }
        If (node.Kind == AstKind.Lambda) { Return This.Pair("0", "Lambda:" + node.Name); }
        If (node.Kind == AstKind.ArrayLiteral) { Return This.EmitArrayLiteral(node); }
        If (node.Kind == AstKind.MapLiteral) { Return This.EmitMapLiteral(node); }
        If (node.Kind == AstKind.SetLiteral) { Return This.EmitSetLiteral(node); }
        If (node.Kind == AstKind.TupleLiteral) { Return This.EmitTupleLiteral(node); }
        If (node.Kind == AstKind.RecordLiteral) { Return This.EmitRecordLiteral(node); }
        If (node.Kind == AstKind.ObjectLiteral) { Return This.EmitObjectLiteral(node); }
        Return This.Pair("0", "Int");
    }

    Private Function LoadObjectField(String object, String index) -> String {
        String pointer = This.Fresh("p");
        This.Emit(pointer + " = inttoptr i64 " + object + " to ptr");
        String slot = This.Fresh("s");
        This.Emit(slot + " = getelementptr i64, ptr " + pointer + ", i64 " + index);
        String loaded = This.Fresh("v");
        This.Emit(loaded + " = load i64, ptr " + slot);
        Return loaded;
    }

    Private Function StoreObjectField(String object, String index, String value) -> Void {
        String pointer = This.Fresh("p");
        This.Emit(pointer + " = inttoptr i64 " + object + " to ptr");
        String slot = This.Fresh("s");
        This.Emit(slot + " = getelementptr i64, ptr " + pointer + ", i64 " + index);
        This.Emit("store i64 " + value + ", ptr " + slot);
    }

    Private Function LoadListCount(String list) -> String {
        String pointer = This.Fresh("p");
        This.Emit(pointer + " = inttoptr i64 " + list + " to ptr");
        String slot = This.Fresh("s");
        This.Emit(slot + " = getelementptr i64, ptr " + pointer + ", i64 1");
        String loaded = This.Fresh("v");
        This.Emit(loaded + " = load i64, ptr " + slot);
        Return loaded;
    }

    Private Function LoadListItem(String list, String index) -> String {
        String pointer = This.Fresh("p");
        This.Emit(pointer + " = inttoptr i64 " + list + " to ptr");
        String items = This.Fresh("items");
        This.Emit(items + " = load ptr, ptr " + pointer);
        String slot = This.Fresh("s");
        This.Emit(slot + " = getelementptr i64, ptr " + items + ", i64 " + index);
        String loaded = This.Fresh("v");
        This.Emit(loaded + " = load i64, ptr " + slot);
        Return loaded;
    }

    Private Function StoreListItem(String list, String index, String value) -> Void {
        String pointer = This.Fresh("p");
        This.Emit(pointer + " = inttoptr i64 " + list + " to ptr");
        String items = This.Fresh("items");
        This.Emit(items + " = load ptr, ptr " + pointer);
        String slot = This.Fresh("s");
        This.Emit(slot + " = getelementptr i64, ptr " + items + ", i64 " + index);
        This.Emit("store i64 " + value + ", ptr " + slot);
    }

    Private Function EmitMember(AstNode node) -> IrValue {
        String target = node.Name;
        If (node.Left != Null && node.Left.Kind == AstKind.Name && This.Lookup(node.Left.Name).Value == "") {
            If (node.Left.Name == "ExitCode") {
                Int code = This.ExitCodeValue(target);
                If (code >= 0) { Return This.Pair(code.ToString(), "Int"); }
            }
            ClassInfo named = This.FindClass(node.Left.Name);
            If (named.Name != "") {
                Int ordinal = This.EnumValue(named, target);
                If (ordinal >= 0) { Return This.Pair(ordinal.ToString(), "Int"); }
            }
        }
        IrValue receiver = This.EmitExpr(node.Left);
        ClassInfo info = This.FindClass(receiver.TypeName);
        Int slot = This.FieldSlot(info, target);
        If (info.Name != "" && info.KindName == "Enum" && slot < 0) { Return This.Pair(receiver.Value, "Int"); }
        If (info.Name != "" && slot >= 0) {
            String loaded = This.LoadObjectField(receiver.Value, slot.ToString());
            Return This.Pair(loaded, This.FieldType(info, target));
        }
        If (receiver.TypeName.StartsWith("{")) {
            Int recordSlot = This.RecordSlot(receiver.TypeName, target);
            If (recordSlot >= 0) {
                String loaded = This.LoadObjectField(receiver.Value, recordSlot.ToString());
                Return This.Pair(loaded, This.RecordFieldType(receiver.TypeName, target));
            }
        }
        Return This.Pair(receiver.Value, receiver.TypeName);
    }

    Private Function EmitCall(AstNode node) -> IrValue {
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Name == "From" && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name && This.IsNumericType(node.Left.Left.Name)) {
            Return This.EmitNumericFrom(node);
        }
        Var arguments = List<String>();
        Var types = List<String>();
        For argument In node.Parameters {
            AstNode valueNode = argument;
            If (argument.Kind == AstKind.Argument && argument.Left != Null) { valueNode = argument.Left; }
            IrValue value = This.EmitExpr(valueNode);
            arguments.Add(value.Value);
            types.Add(value.TypeName);
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Name) {
            String targetName = node.Left.Name;
            IrValue local = This.Lookup(node.Left.Name);
            If (local.TypeName.StartsWith("Lambda:")) {
                targetName = local.TypeName.Substring(7);
            }
            FunctionInfo record = This.FindFunction(targetName, This.FileName);
            If (record.Name != "" && !record.IsExtern && record.Node.Parameters.Count() > 0) {
                Var alignedArgs = List<String>();
                Var alignedTypes = List<String>();
                Int paramIndex = 0;
                For parameter In record.Node.Parameters {
                    If (!parameter.FlagC) {
                        If (parameter.FlagB) {
                            String elemType = This.TypeName(parameter.Type);
                            If (elemType == "") { elemType = "Int"; }
                            If (paramIndex == node.Parameters.Count() - 1 && paramIndex < arguments.Count() && node.Parameters[paramIndex].FlagA) {
                                alignedArgs.Add(arguments[paramIndex]);
                                alignedTypes.Add("Array<" + elemType + ">");
                            } Else {
                                IrValue pack = This.CallRuntime("rx_list_new", List<String>(), False);
                                Int argIdx = paramIndex;
                                While (argIdx < node.Parameters.Count() && argIdx < arguments.Count()) {
                                    String itemVal = arguments[argIdx];
                                    If (This.IsAnyType(elemType) && !This.IsAnyType(types[argIdx])) {
                                        IrValue boxed = This.BoxAny(This.Pair(itemVal, types[argIdx]));
                                        itemVal = boxed.Value;
                                    }
                                    Var addArgs = List<String>();
                                    addArgs.Add(pack.Value);
                                    addArgs.Add(itemVal);
                                    This.CallRuntime("rx_list_add", addArgs, True);
                                    argIdx = argIdx + 1;
                                }
                                alignedArgs.Add(pack.Value);
                                alignedTypes.Add("Array<" + elemType + ">");
                            }
                        } Else {
                            Bool matched = False;
                            String chosenVal = "0";
                            String chosenType = "Int";
                            Int searchIdx = 0;
                            While (searchIdx < node.Parameters.Count() && searchIdx < arguments.Count()) {
                                If (node.Parameters[searchIdx].Name == parameter.Name && parameter.Name != "") {
                                    chosenVal = arguments[searchIdx];
                                    chosenType = types[searchIdx];
                                    matched = True;
                                }
                                searchIdx = searchIdx + 1;
                            }
                            If (!matched && paramIndex < node.Parameters.Count() && paramIndex < arguments.Count() && node.Parameters[paramIndex].Name == "") {
                                chosenVal = arguments[paramIndex];
                                chosenType = types[paramIndex];
                                matched = True;
                            }
                            If (!matched && parameter.Initializer != Null) {
                                IrValue defVal = This.EmitExpr(parameter.Initializer);
                                chosenVal = defVal.Value;
                                chosenType = defVal.TypeName;
                                matched = True;
                            }
                            alignedArgs.Add(chosenVal);
                            alignedTypes.Add(chosenType);
                        }
                        paramIndex = paramIndex + 1;
                    }
                }
                Return This.EmitNamedCall(node.Left, alignedArgs, alignedTypes);
            }
            Return This.EmitNamedCall(node.Left, arguments, types);
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name && node.Left.Left.Name == "Operators") {
            Return This.EmitOperatorLibrary(node, arguments, types);
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member) { Return This.EmitMethodCall(node.Left, arguments, types); }
        Return This.Pair("0", "Int");
    }

    Private Function EmitNamedCall(AstNode left, List<String> arguments, List<String> types) -> IrValue {
        If (left.Name == "Print") {
            String printed = "0";
            String kind = "0";
            If (arguments.Count() > 0) { printed = arguments[0]; }
            If (types.Count() > 0 && This.IsAnyType(types[0])) {
                Var textArgs = List<String>();
                textArgs.Add(printed);
                IrValue text = This.CallRuntime("rx_AnyText", textArgs, False);
                printed = text.Value;
                kind = "1";
            } Else If (types.Count() > 0 && (types[0] == "Array<Any>" || types[0] == "Set<Any>")) {
                Var textArgs = List<String>();
                textArgs.Add(printed);
                IrValue text = This.CallRuntime("rx_any_list_text", textArgs, False);
                printed = text.Value;
                kind = "1";
            } Else If (types.Count() > 0 && types[0].StartsWith("Map<") && This.MapValueType(types[0]) == "Any") {
                Var textArgs = List<String>();
                textArgs.Add(printed);
                IrValue text = This.CallRuntime("rx_any_map_text", textArgs, False);
                printed = text.Value;
                kind = "1";
            } Else If (types.Count() > 0) {
                kind = This.PrintKind(types[0]).ToString();
            }
            Var args = List<String>();
            args.Add(printed);
            args.Add(kind);
            This.CallRuntime("rx_print", args, True);
            Return This.Pair("0", "Void");
        }
        If (left.Name == "Assert" || left.Name == "AssertTrue" || left.Name == "AssertFalse" || left.Name == "AssertEqual" || left.Name == "AssertNear") {
            Return This.Pair("0", "Void");
        }
        If (left.Name == "Input") {
            IrValue value = This.CallRuntime("rx_Input", List<String>(), False);
            If (left.Children.Count() > 0 && This.TypeName(left.Children[0]) == "Int") {
                Var parseArgs = List<String>();
                parseArgs.Add(value.Value);
                IrValue parsed = This.CallRuntime("rx_str_to_int", parseArgs, False);
                Return This.Pair(parsed.Value, "Int");
            }
            Return This.Pair(value.Value, "String");
        }
        If (left.Name == "Queue" || left.Name == "Stack") {
            String element = "Int";
            If (left.Children.Count() > 0) {
                element = This.TypeName(left.Children[0]);
                If (element == "") { element = "Int"; }
            }
            IrValue value = This.CallRuntime("rx_list_new", List<String>(), False);
            Return This.Pair(value.Value, left.Name + "<" + element + ">");
        }
        If (left.Name == "Some" || left.Name == "Success" || left.Name == "Error" || left.Name == "Failure" || left.Name == "None" || left.Name == "Tuple") {
            Return This.EmitWrapped(left.Name, arguments, types);
        }
        If (left.Name == "List") {
            String element = "Int";
            If (left.Children.Count() > 0) {
                element = This.TypeName(left.Children[0]);
                If (element == "") { element = "Int"; }
            }
            IrValue value = This.CallRuntime("rx_list_new", List<String>(), False);
            Return This.Pair(value.Value, "List:" + element);
        }
        If (left.Name == "ExecutionResult") { Return This.MakeResult(arguments); }
        If (left.Name == "Int" && arguments.Count() > 0) {
            If (types.Count() > 0 && This.IsFloatType(types[0])) {
                Var args = List<String>();
                args.Add(arguments[0]);
                IrValue v = This.CallRuntime("rx_F64ToInt", args, False);
                Return This.Pair(v.Value, "Int");
            }
            If (types.Count() > 0 && This.IsString(types[0])) {
                Var args = List<String>();
                args.Add(arguments[0]);
                IrValue v = This.CallRuntime("rx_str_to_int", args, False);
                Return This.Pair(v.Value, "Int");
            }
            Return This.Pair(arguments[0], "Int");
        }
        If (left.Name == "Float" && arguments.Count() > 0) {
            If (types.Count() > 0 && This.IsFloatType(types[0])) { Return This.Pair(arguments[0], "Float"); }
            If (types.Count() > 0 && This.IsString(types[0])) {
                Var args = List<String>();
                args.Add(arguments[0]);
                IrValue v = This.CallRuntime("rx_F64Parse", args, False);
                Return This.Pair(v.Value, "Float");
