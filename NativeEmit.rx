        ClassInfo info = This.FindClass(left.Name);
        If (info.Name != "") { Return This.Construct(left.Name, info, arguments); }
        String targetName = left.Name;
        IrValue local = This.Lookup(left.Name);
        If (local.TypeName.StartsWith("Lambda:")) {
            targetName = local.TypeName.Substring(7);
