            }
            IrValue value = This.CallRuntime(symbol, arguments, False);
            String ret = record.ReturnType;
            If (ret == "T" && types.Count() > 0 && types[0] != "") { ret = types[0]; }
            If (ret == "") { ret = "Int"; }
            Return This.Pair(value.Value, ret);
        }
        Return This.Pair("0", "Int");
    }

    Private Function MakeResult(List<String> arguments) -> IrValue {
