// Tests for Interpreter.rx.

Test MakeInt {
    Case "make integer value" {
        Input: number = 42;
        Assert: Result.Kind == ValueKind.Integer && Result.Integer == 42;
    }
}

Test MakeBool {
    Case "make boolean true" {
        Input: number = True;
        Assert: Result.Kind == ValueKind.Boolean && Result.Boolean == True;
    }
    Case "make boolean false" {
        Input: number = False;
        Assert: Result.Kind == ValueKind.Boolean && Result.Boolean == False;
    }
}

Test MakeText {
    Case "make text value" {
        Input: text = "hello";
        Assert: Result.Kind == ValueKind.Text && Result.Text == "hello";
    }
}

Test MakeNull {
    Case "make null value" {
        Input:;
        Assert: Result.Kind == ValueKind.Null;
    }
}

Test MakeVoid {
    Case "make void value" {
        Input:;
        Assert: Result.Kind == ValueKind.Void;
    }
}

Test MakeArray {
    Case "make empty array" {
        Input:;
        Assert: Result.Kind == ValueKind.Array && Result.Elements.Count() == 0;
    }
}

Test MakeFunction {
    Case "make function value" {
        Input: node = AstNode(Name: "testFunc");
        Assert: Result.Kind == ValueKind.Function && Result.Text == "testFunc";
    }
}

Test MakeObjectValue {
    Case "make object value" {
        Input: typeName = "Person";
        Assert: Result.Kind == ValueKind.Object && Result.Text == "Person";
    }
}

Test MakeObject {
    Case "make object node" {
        Input: node = AstNode(Name: "Widget", Children: []);
        Assert: Result.Kind == ValueKind.Object && Result.Text == "Widget";
    }
}

Test BlankObject {
    Case "blank object" {
        Input: typeName = "Widget";
        Assert: Result.Kind == ValueKind.Object && Result.Text == "Widget";
    }
}

Test MakeRecord {
    Case "make record" {
        Input: node = AstNode(Children: [AstNode(Name: "x", Left: AstNode(Kind: AstKind.IntegerLiteral, Text: "10"))]);
        Assert: Result.Kind == ValueKind.Object && Result.Elements.Count() == 1;
    }
}

Test MakeMap {
    Case "make map" {
        Input: node = AstNode(Children: [AstNode(Name: "key", Left: AstNode(Kind: AstKind.IntegerLiteral, Text: "5"))]);
        Assert: Result.Text == "Map" && Result.Elements.Count() == 2;
    }
}

Test MakeSet {
    Case "make set" {
        Input: node = AstNode(Children: [AstNode(Kind: AstKind.IntegerLiteral, Text: "1")]);
        Assert: Result.Text == "Set" && Result.Elements.Count() == 1;
    }
}

Test FieldIndex {
    Case "found field" {
        Input: value = Value(FieldNames: ["age"]), name = "age";
        Output: 0;
    }
    Case "missing field" {
        Input: value = Value(FieldNames: ["age"]), name = "name";
        Output: -1;
    }
}

Test BlankValue {
    Case "string" {
        Input: typeName = "String";
        Assert: Result.Kind == ValueKind.Text && Result.Text == "";
    }
    Case "int" {
        Input: typeName = "Int";
        Assert: Result.Kind == ValueKind.Integer && Result.Integer == 0;
    }
    Case "bool" {
        Input: typeName = "Bool";
        Assert: Result.Kind == ValueKind.Boolean && Result.Boolean == False;
    }
}

Test BlankArgument {
    Case "default parameter" {
        Input: parameter = AstNode();
        Assert: Result.Kind == ValueKind.Integer;
    }
}

Test Describe {
    Case "integer" {
        Input: value = MakeInt(7);
        Output: "Int:7";
    }
    Case "boolean" {
        Input: value = MakeBool(True);
        Output: "Bool:True";
    }
    Case "null" {
        Input: value = MakeNull();
        Output: "Null:";
    }
}

Test TestTitle {
    Case "name only" {
        Input: test = AstNode(Name: "MyTest", Text: "");
        Output: "MyTest";
    }
    Case "with text" {
        Input: test = AstNode(Name: "MyTest", Text: "case 1");
        Output: "MyTest case 1";
    }
}

Test ExpectsFailure {
    Case "no fails child" {
        Input: test = AstNode(Children: []);
        Output: False;
    }
    Case "fails child" {
        Input: test = AstNode(Children: [AstNode(Name: "Fails", Left: AstNode(Kind: AstKind.BooleanLiteral, FlagA: True))]);
        Output: True;
    }
}

Test HasTestName {
    Case "present" {
        Input: names = ["alpha", "beta"], name = "beta";
        Output: True;
    }
    Case "absent" {
        Input: names = ["alpha", "beta"], name = "gamma";
        Output: False;
    }
}

Test CollectTestNames {
    Case "collects test name" {
        Input: node = AstNode(Kind: AstKind.Test, Name: "TestOne", Children: []), kind = AstKind.Test, names = [];
        Assert: names.Count() == 1 && names[0] == "TestOne";
    }
}

Test IsTruthy {
    Case "true bool" {
        Input: value = MakeBool(True);
        Output: True;
    }
    Case "false bool" {
        Input: value = MakeBool(False);
        Output: False;
    }
    Case "nonzero int" {
        Input: value = MakeInt(5);
        Output: True;
    }
    Case "zero int" {
        Input: value = MakeInt(0);
        Output: False;
    }
    Case "null is falsy" {
        Input: value = MakeNull();
        Output: False;
    }
}

Test Same {
    Case "same ints" {
        Input: left = MakeInt(10), right = MakeInt(10);
        Output: True;
    }
    Case "different ints" {
        Input: left = MakeInt(10), right = MakeInt(20);
        Output: False;
    }
    Case "same text" {
        Input: left = MakeText("a"), right = MakeText("a");
        Output: True;
    }
    Case "both null" {
        Input: left = MakeNull(), right = MakeNull();
        Output: True;
    }
}

Test Display {
    Case "int" {
        Input: value = MakeInt(123);
        Output: "123";
    }
    Case "bool" {
        Input: value = MakeBool(True);
        Output: "True";
    }
    Case "text" {
        Input: value = MakeText("abc");
        Output: "abc";
    }
    Case "null" {
        Input: value = MakeNull();
        Output: "Null";
    }
}

Test IsEmptyValue {
    Case "empty text" {
        Input: value = MakeText("");
        Output: True;
    }
    Case "non-empty text" {
        Input: value = MakeText("x");
        Output: False;
    }
    Case "null is empty" {
        Input: value = MakeNull();
        Output: True;
    }
}

Test CompareValues {
    Case "less" {
        Input: left = MakeInt(5), right = MakeInt(10);
        Output: -1;
    }
    Case "greater" {
        Input: left = MakeInt(10), right = MakeInt(5);
        Output: 1;
    }
    Case "equal" {
        Input: left = MakeInt(5), right = MakeInt(5);
        Output: 0;
    }
}

Test TypeMatches {
    Case "bool matches" {
        Input: value = MakeBool(True), expected = "Bool";
        Output: True;
    }
    Case "int matches" {
        Input: value = MakeInt(42), expected = "Int";
        Output: True;
    }
    Case "text matches" {
        Input: value = MakeText("hi"), expected = "String";
        Output: True;
    }
    Case "mismatch" {
        Input: value = MakeInt(42), expected = "String";
        Output: False;
    }
}

Test TakeFront {
    Case "empty collection" {
        Input: collection = MakeArray();
        Assert: Result.Integer == 0;
    }
}

Test TakeBack {
    Case "empty collection" {
        Input: collection = MakeArray();
        Assert: Result.Integer == 0;
    }
}

Test FindOperator {
    Case "absent returns -1" {
        Input: key = "+";
        Output: -1;
    }
}

Test TypeIndex {
    Case "absent returns -1" {
        Input: name = "UnknownType";
        Output: -1;
    }
}

Test EnumOrdinal {
    Case "first member" {
        Input: typeNode = AstNode(Children: [AstNode(Kind: AstKind.EnumMember, Name: "A"), AstNode(Kind: AstKind.EnumMember, Name: "B")]), name = "A";
        Output: 0;
    }
    Case "second member" {
        Input: typeNode = AstNode(Children: [AstNode(Kind: AstKind.EnumMember, Name: "A"), AstNode(Kind: AstKind.EnumMember, Name: "B")]), name = "B";
        Output: 1;
    }
}

Test LookupBuiltinEnum {
    Case "astkind missing" {
        Input: typeName = "AstKind", memberName = "Missing";
        Output: 0;
    }
    Case "tokenkind identifier" {
        Input: typeName = "TokenKind", memberName = "Identifier";
        Output: 2;
    }
    Case "exitcode success" {
        Input: typeName = "ExitCode", memberName = "Success";
        Output: 0;
    }
    Case "rounding nearest" {
        Input: typeName = "Rounding", memberName = "Nearest";
        Output: 0;
    }
    Case "rounding truncate" {
        Input: typeName = "Rounding", memberName = "Truncate";
        Output: 1;
    }
}

Test LookupAstKind {
    Case "Missing" {
        Input: name = "Missing";
        Output: 0;
    }
    Case "Module" {
        Input: name = "Module";
        Output: 1;
    }
}

Test LookupTokenKind {
    Case "EndOfFile" {
        Input: name = "EndOfFile";
        Output: 0;
    }
    Case "Identifier" {
        Input: name = "Identifier";
        Output: 2;
    }
}

Test MakeEnumValue {
    Case "simple enum" {
        Input: typeNode = AstNode(Name: "Color", Children: [AstNode(Kind: AstKind.EnumMember, Name: "Red", Parameters: [])]), name = "Red", arguments = [];
        Assert: Result.Integer == 0;
    }
}

Test StringStatic {
    Case "from text" {
        Input: name = "From", arguments = [MakeText("abc")];
        Assert: Result.Text == "abc";
    }
}

Test TextCall {
    Case "substring" {
        Input: name = "Substring", target = MakeText("hello"), arguments = [MakeInt(1), MakeInt(3)];
        Assert: Result.Text == "ell";
    }
    Case "getchar" {
        Input: name = "GetChar", target = MakeText("hello"), arguments = [MakeInt(0)];
        Assert: Result.Text == "h";
    }
}

Test OperatorLibrary {
    Case "negate" {
        Input: name = "Negate", arguments = [MakeInt(5)];
        Assert: Result.Integer == -5;
    }
    Case "add" {
        Input: name = "Add", arguments = [MakeInt(3), MakeInt(4)];
        Assert: Result.Integer == 7;
    }
}

Test PatternMatches {
    Case "wildcard flagA" {
        Input: pattern = AstNode(FlagA: True), scrutinee = MakeInt(10);
        Output: True;
    }
    Case "type match" {
        Input: pattern = AstNode(Text: "Int"), scrutinee = MakeInt(10);
        Output: True;
    }
}

Test BindPattern {
    Case "bind identifier" {
        Input: pattern = AstNode(Name: "testPatternVar"), scrutinee = MakeInt(77);
        Assert: This.Lookup("testPatternVar").Integer == 77;
    }
}

Test Define {
    Case "define variable" {
        Input: name = "myDefinedVar", value = MakeInt(88);
        Assert: This.Lookup("myDefinedVar").Integer == 88;
    }
}

Test Assign {
    Case "assign existing" {
        Input: name = "name", value = Value(Kind: ValueKind.Int, Integer: 99);
        Assert: True;
    }
}

