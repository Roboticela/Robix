}

Test ExecuteWithCancellation {
    Case "runs" {
        Constraint: AlgorithmDesk().ExecuteWithCancellation(1, 21, 1) == 42;
        Processing: AlgorithmDesk().ExecuteWithCancellation(1, 21, 1);
        Output: 42;
    }
    Case "cancelled" {
        Constraint: AlgorithmDesk().ExecuteWithCancellation(1, 21, 0) == 0;
        Processing: AlgorithmDesk().ExecuteWithCancellation(1, 21, 0);
        Output: 0;
    }
}

Test RegisterAlgorithm {
    Case "already stored" {
        Constraint: AlgorithmDesk().RegisterAlgorithm(1) == 1;
        Processing: AlgorithmDesk().RegisterAlgorithm(1);
        Output: 1;
    }
    Case "registry full" {
        Constraint: AlgorithmDesk().RegisterAlgorithm(9) == -1;
        Processing: AlgorithmDesk().RegisterAlgorithm(9);
        Output: -1;
    }
}

Test UnregisterAlgorithm {
    Case "present" {
