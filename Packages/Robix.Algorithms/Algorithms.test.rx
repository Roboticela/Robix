// Tests for Algorithms.rx. Each call uses a fresh desk.

Test Execute {
    Constraint: AlgorithmDesk().Execute(1, 21) == 42;
    Processing: AlgorithmDesk().Execute(1, 21);
    Output: 42;
}

Test ExecuteAsync {
    Constraint: AlgorithmDesk().ExecuteAsync(1, 21) == 42;
    Processing: AlgorithmDesk().ExecuteAsync(1, 21);
    Output: 42;
}

