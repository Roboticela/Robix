// Tests for Concurrency.rx. Each call uses a fresh lane.

Test SetDegree {
    Constraint: Lane().SetDegree(4) == 4;
    Processing: Lane().SetDegree(4);
    Output: 4;
}

Test RunFor {
    Constraint: Lane().RunFor(1, 4) == 6;
    Processing: Lane().RunFor(1, 4);
    Output: 6;
}

Test BreakFor {
    Constraint: Lane().BreakFor(1, 5, 3) == 3;
    Processing: Lane().BreakFor(1, 5, 3);
    Output: 3;
}

Test Stopped {
    Constraint: Lane().Stopped() == 0;
    Processing: Lane().Stopped();
    Output: 0;
}

Test Load3 {
    Constraint: Lane().Load3(1, 2, 3) == 3;
    Processing: Lane().Load3(1, 2, 3);
    Output: 3;
}

Test Load4 {
    Constraint: Lane().Load4(1, 2, 3, 4) == 4;
