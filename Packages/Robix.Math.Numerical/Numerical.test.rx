// Tests for Numerical.rx. Shape 0 is the identity, shape 1 is x squared minus 4, and shape 2 is x squared.

Test Evaluate {
    Constraint: NumericalDesk().Evaluate(1, 3) == 5;
    Processing: NumericalDesk().Evaluate(1, 3);
    Output: 5;
}

