// Tests for Selection.rx. Each call uses a fresh desk.

Test Select {
    Constraint: SelectionDesk().Select(4) == 5;
    Processing: SelectionDesk().Select(4);
    Output: 5;
}

Test SelectMinimum {
    Constraint: SelectionDesk().SelectMinimum() == 1;
    Processing: SelectionDesk().SelectMinimum();
    Output: 1;
}

