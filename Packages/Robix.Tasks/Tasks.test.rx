}

Test GroupSize {
    Constraint: TaskDesk().GroupSize(1) == 0;
    Processing: TaskDesk().GroupSize(1);
    Output: 0;
}

Test CreateGraph {
    Constraint: TaskDesk().CreateGraph() == 1;
    Processing: TaskDesk().CreateGraph();
    Output: 1;
}

Test GraphEdges {
    Constraint: TaskDesk().GraphEdges() == 0;
    Processing: TaskDesk().GraphEdges();
    Output: 0;
}

Test Schedule {
    Constraint: TaskDesk().Schedule(0, 5) == 5;
    Processing: TaskDesk().Schedule(0, 5);
    Output: 5;
}

Test ScheduleAfter {
    Constraint: TaskDesk().ScheduleAfter(0, 3) == 3;
    Processing: TaskDesk().ScheduleAfter(0, 3);
    Output: 3;
}

Test ScheduleAt {
    Constraint: TaskDesk().ScheduleAt(0, 4) == 4;
    Processing: TaskDesk().ScheduleAt(0, 4);
    Output: 4;
}

Test ScheduleRepeated {
    Constraint: TaskDesk().ScheduleRepeated(0, 2) == 2;
    Processing: TaskDesk().ScheduleRepeated(0, 2);
    Output: 2;
}

Test Advance {
    Constraint: TaskDesk().Advance(3) == 3;
    Processing: TaskDesk().Advance(3);
    Output: 3;
}

Test Pipe {
    Constraint: TaskDesk().Pipe(0) == 0;
    Processing: TaskDesk().Pipe(0);
    Output: 0;
}

Test MapValue {
    Constraint: TaskDesk().MapValue(0) == 0;
    Processing: TaskDesk().MapValue(0);
    Output: 0;
}

Test FlatMapValue {
    Constraint: TaskDesk().FlatMapValue(0) == 0;
    Processing: TaskDesk().FlatMapValue(0);
    Output: 0;
}

Test Retry {
    Constraint: TaskDesk().Retry(0) == 0;
    Processing: TaskDesk().Retry(0);
