}

Test CreateGroup {
    Constraint: TaskDesk().CreateGroup() == 1;
    Processing: TaskDesk().CreateGroup();
    Output: 1;
}

Test JoinGroup {
    Constraint: TaskDesk().JoinGroup(0, 1) == 1;
    Processing: TaskDesk().JoinGroup(0, 1);
