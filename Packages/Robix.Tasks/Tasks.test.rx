Test Timeout {
    Constraint: TaskDesk().Timeout(0, 4) == 0;
    Processing: TaskDesk().Timeout(0, 4);
    Output: 0;
}

Test Batch {
    Constraint: TaskDesk().Batch(0, 1) == -1;
    Processing: TaskDesk().Batch(0, 1);
    Output: -1;
}

Test SetPriority {
    Constraint: TaskDesk().SetPriority(0, 2) == 2;
    Processing: TaskDesk().SetPriority(0, 2);
    Output: 2;
}

Test Priority {
    Constraint: TaskDesk().Priority(0) == 0;
    Processing: TaskDesk().Priority(0);
    Output: 0;
}

Test Status {
    Constraint: TaskDesk().Status(0) == "empty";
    Processing: TaskDesk().Status(0);
    Output: "empty";
}

Test Result {
    Constraint: TaskDesk().Result(0) == 0;
    Processing: TaskDesk().Result(0);
    Output: 0;
}

Test Fault {
    Constraint: TaskDesk().Fault(0) == "none";
    Processing: TaskDesk().Fault(0);
    Output: "none";
}

Test SetWorker {
    Constraint: TaskDesk().SetWorker("main") == 1;
    Processing: TaskDesk().SetWorker("main");
