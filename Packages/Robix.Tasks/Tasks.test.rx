    Output: 0;
}

Test Stats {
    Constraint: TaskDesk().Stats() == "created=0,ran=0,canceled=0,retried=0";
    Processing: TaskDesk().Stats();
    Output: "created=0,ran=0,canceled=0,retried=0";
}

Test Claim {
    Constraint: TaskDesk().Claim() == 0;
    Processing: TaskDesk().Claim();
    Output: 0;
}

Test Ready {
    Constraint: TaskDesk().Ready(0) == 1;
    Processing: TaskDesk().Ready(0);
    Output: 1;
}

Test IntText {
    Constraint: TaskDesk().IntText(7) == "7";
    Processing: TaskDesk().IntText(7);
    Output: "7";
}
