// Tests for Tasks.rx. Each call uses a fresh desk.

Test Create {
    Constraint: TaskDesk().Create("work", 1, 8) == 0;
    Processing: TaskDesk().Create("work", 1, 8);
    Output: 0;
}

Test Start {
    Constraint: TaskDesk().Start(0) == 0;
    Processing: TaskDesk().Start(0);
    Output: 0;
}

Test Run {
    Constraint: TaskDesk().Run(0) == 0;
    Processing: TaskDesk().Run(0);
    Output: 0;
}

Test Cancel {
    Constraint: TaskDesk().Cancel(0) == 0;
    Processing: TaskDesk().Cancel(0);
    Output: 0;
}

Test Wait {
    Constraint: TaskDesk().Wait(0) == 0;
    Processing: TaskDesk().Wait(0);
    Output: 0;
}

Test WaitAll {
    Constraint: TaskDesk().WaitAll(0, 1) == 0;
    Processing: TaskDesk().WaitAll(0, 1);
    Output: 0;
}

Test WaitAny {
    Constraint: TaskDesk().WaitAny(0, 1) == 0;
    Processing: TaskDesk().WaitAny(0, 1);
    Output: 0;
}

Test ContinueWith {
    Constraint: TaskDesk().ContinueWith(0) == 0;
    Processing: TaskDesk().ContinueWith(0);
    Output: 0;
}

Test AddDependency {
    Constraint: TaskDesk().AddDependency(0, 1) == 1;
    Processing: TaskDesk().AddDependency(0, 1);
    Output: 1;
}

Test RemoveDependency {
    Constraint: TaskDesk().RemoveDependency(0) == 1;
    Processing: TaskDesk().RemoveDependency(0);
