// Tests for Core.rx. Input reads an empty line while tests are running.

Test Dispose {
    Constraint: Box(1, "a").Dispose() == True;
    Processing: Box(1, "a").Dispose();
    Output: True;
}

Test IsDisposed {
    Constraint: Box(1, "a").IsDisposed() == False;
    Processing: Box(1, "a").IsDisposed();
    Output: False;
}

Test Clone {
    Case "value" {
        Constraint: Clone(4) == 4;
        Processing: Clone(4);
        Output: 4;
    }
    Case "box" {
        Constraint: Box(1, "a").Clone().Id == 2;
        Processing: Box(1, "a").Clone().Id;
        Output: 2;
    }
}

Test CompareTo {
    Assert: Compare(2, 5) == -1;
}

Test Equals {
    Constraint: Equals(4, 4) == True;
    Processing: Equals(4, 4);
    Output: True;
}

Test DisposeAsync {
    Assert: True;
}

Test Clean {
    Constraint: Clean("  a  ") == "a";
    Processing: Clean("  a  ");
    Output: "a";
}

Test Digit {
    Constraint: Digit("4") == 4;
    Processing: Digit("4");
    Output: 4;
}

Test IsIntText {
    Constraint: IsIntText("12") == True;
    Processing: IsIntText("12");
    Output: True;
}

Test IsFloatText {
    Constraint: IsFloatText("1.5") == True;
    Processing: IsFloatText("1.5");
    Output: True;
}

Test IsBoolText {
    Constraint: IsBoolText("yes") == True;
    Processing: IsBoolText("yes");
    Output: True;
}

Test Pad2 {
    Constraint: Pad2(3) == "03";
    Processing: Pad2(3);
    Output: "03";
}

Test HexDigit {
    Constraint: HexDigit(10) == "a";
    Processing: HexDigit(10);
    Output: "a";
}

Test HexValue {
    Constraint: HexValue("A") == 10;
    Processing: HexValue("A");
    Output: 10;
}

Test UnitText {
    Constraint: UnitText() == "()";
    Processing: UnitText();
    Output: "()";
}

Test IsNullText {
    Constraint: IsNullText("") == False;
    Processing: IsNullText("");
    Output: False;
}

Test IsBlank {
    Constraint: IsBlank("  ") == True;
    Processing: IsBlank("  ");
    Output: True;
}

Test IsDefined {
    Constraint: IsDefined(True) == True;
    Processing: IsDefined(True);
    Output: True;
}

Test IsUndefined {
    Constraint: IsUndefined("") == True;
    Processing: IsUndefined("");
    Output: True;
}

Test IsNull {
    Constraint: IsNull("a") == False;
    Processing: IsNull("a");
    Output: False;
}

Test GetType {
    Constraint: GetType("12").Name == "Int";
    Processing: GetType("12").Name;
    Output: "Int";
}

Test ToString {
    Constraint: ToString(6) == "6";
    Processing: ToString(6);
    Output: "6";
}

Test GetHashCode {
    Constraint: GetHashCode("a") == 177670;
    Processing: GetHashCode("a");
    Output: 177670;
}

Test Is {
    Constraint: Is("a") == True;
    Processing: Is("a");
    Output: True;
}

Test As {
    Constraint: As("  a  ") == "a";
    Processing: As("  a  ");
    Output: "a";
}

Test Default {
    Constraint: Default() == 0;
    Processing: Default();
    Output: 0;
}

Test Compare {
    Constraint: Compare(2, 5) == -1;
    Processing: Compare(2, 5);
    Output: -1;
}

Test TryConvert {
    Constraint: TryConvert("12").Ok == 1;
    Processing: TryConvert("12").Integer;
    Output: 12;
}

Test ConvertChecked {
    Constraint: ConvertChecked("12") == "12";
    Processing: ConvertChecked("12");
    Output: "12";
}

Test ConvertUnchecked {
    Constraint: ConvertUnchecked("12") == "12";
    Processing: ConvertUnchecked("12");
    Output: "12";
}

Test Kind {
    Constraint: Kind("12") == "Int";
    Processing: Kind("12");
    Output: "Int";
}

Test HasInput {
    Constraint: HasInput("a") == True;
    Processing: HasInput("a");
    Output: True;
}

Test Input {
    Constraint: Input() == "";
    Processing: Input();
    Output: "";
}

Test InputLine {
    Constraint: InputLine() == "";
    Processing: InputLine();
    Output: "";
}

Test InputInt {
    Constraint: InputInt() == 0;
    Processing: InputInt();
    Output: 0;
}

Test InputFloat {
    Constraint: InputFloat() == 0.0;
    Processing: InputFloat();
    Output: 0.0;
}

Test InputBool {
    Constraint: InputBool() == False;
    Processing: InputBool();
    Output: False;
}

Test InputChar {
    Constraint: InputChar() == "";
    Processing: InputChar();
    Output: "";
}

Test InputKey {
    Constraint: InputKey() == "";
    Processing: InputKey();
    Output: "";
}

Test InputPassword {
    Constraint: InputPassword() == "";
    Processing: InputPassword();
    Output: "";
}

Test Prompt {
    Constraint: Prompt("?") == "";
    Processing: Prompt("?");
    Output: "";
}

Test PromptInt {
    Constraint: PromptInt("?") == 0;
    Processing: PromptInt("?");
    Output: 0;
}

Test PromptFloat {
    Constraint: PromptFloat("?") == 0.0;
    Processing: PromptFloat("?");
    Output: 0.0;
}

Test PromptBool {
    Constraint: PromptBool("?") == False;
    Processing: PromptBool("?");
    Output: False;
}

Test Confirm {
    Constraint: Confirm("?") == False;
    Processing: Confirm("?");
    Output: False;
}

Test Accepted {
    Constraint: Accepted("12", "int") == True;
    Processing: Accepted("12", "int");
    Output: True;
}

Test ReadText {
    Constraint: ReadText("  a  ") == "a";
    Processing: ReadText("  a  ");
    Output: "a";
}

Test ReadLine {
    Constraint: ReadLine("  a  ") == "a";
    Processing: ReadLine("  a  ");
    Output: "a";
}

Test ReadInt {
    Constraint: ReadInt("12") == 12;
    Processing: ReadInt("12");
