}

Test CanConvert {
    Constraint: CanConvert("int", "float") == True;
    Processing: CanConvert("int", "float");
    Output: True;
}

Test ToBinary {
    Constraint: ToBinary(5) == "101";
    Processing: ToBinary(5);
    Output: "101";
}

