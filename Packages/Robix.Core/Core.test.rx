}

Test ReadBool {
    Constraint: ReadBool("yes") == True;
    Processing: ReadBool("yes");
    Output: True;
}

Test ReadChar {
    Constraint: ReadChar("ab") == "a";
    Processing: ReadChar("ab");
    Output: "a";
}

Test TryReadInt {
    Constraint: TryReadInt("12").Ok == 1;
    Processing: TryReadInt("12").Integer;
    Output: 12;
}

Test TryReadFloat {
    Constraint: TryReadFloat("1.5").Ok == 1;
    Processing: TryReadFloat("1.5").Text;
    Output: "1.5";
}

Test TryReadBool {
    Constraint: TryReadBool("yes").Ok == 1;
    Processing: TryReadBool("yes").Integer;
