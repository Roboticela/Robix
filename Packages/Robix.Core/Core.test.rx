Test EqualsInt {
    Constraint: EqualsInt(4, 4) == True;
    Processing: EqualsInt(4, 4);
    Output: True;
}

Test EqualsText {
    Constraint: EqualsText("a", "a") == True;
    Processing: EqualsText("a", "a");
    Output: True;
}

Test EqualsFloat {
    Constraint: EqualsFloat(1.5, 1.5) == True;
    Processing: EqualsFloat(1.5, 1.5);
    Output: True;
}

Test CompareInt {
    Constraint: CompareInt(2, 5) == -1;
    Processing: CompareInt(2, 5);
    Output: -1;
}

Test CompareText {
    Constraint: CompareText("a", "b") == -1;
    Processing: CompareText("a", "b");
    Output: -1;
}

Test CompareFloat {
    Constraint: CompareFloat(1.0, 2.0) == -1;
    Processing: CompareFloat(1.0, 2.0);
    Output: -1;
}

Test Min {
    Constraint: Min(2, 5) == 2;
    Processing: Min(2, 5);
    Output: 2;
}

Test Max {
    Constraint: Max(2, 5) == 5;
    Processing: Max(2, 5);
    Output: 5;
}

Test Absolute {
    Constraint: Absolute(-4) == 4;
    Processing: Absolute(-4);
    Output: 4;
}

Test Sign {
    Constraint: Sign(-4) == -1;
    Processing: Sign(-4);
    Output: -1;
}

Test Between {
    Constraint: Between(3, 1, 4) == True;
    Processing: Between(3, 1, 4);
    Output: True;
}

Test Clamp {
    Constraint: Clamp(9, 1, 4) == 4;
    Processing: Clamp(9, 1, 4);
    Output: 4;
}

Test HashText {
    Constraint: HashText("a") == 177670;
    Processing: HashText("a");
    Output: 177670;
}

Test ReferenceEquals {
    Constraint: ReferenceEquals(Box(1, "a"), Box(1, "b")) == True;
    Processing: ReferenceEquals(Box(1, "a"), Box(1, "b"));
    Output: True;
}

Test MakeRange {
    Constraint: MakeRange(1, 4).Start == 1;
    Processing: MakeRange(1, 4).End;
    Output: 4;
}

Test MakeRangeStep {
    Constraint: MakeRangeStep(1, 8, 2).Step == 2;
    Processing: MakeRangeStep(1, 8, 2).Step;
    Output: 2;
}

Test SumRange {
    Constraint: SumRange(MakeRange(1, 4)) == 6;
    Processing: SumRange(MakeRange(1, 4));
    Output: 6;
}

Test RangeCount {
    Constraint: RangeCount(MakeRange(1, 4)) == 3;
    Processing: RangeCount(MakeRange(1, 4));
    Output: 3;
}

Test RangeContains {
    Constraint: RangeContains(MakeRange(1, 4), 2) == True;
    Processing: RangeContains(MakeRange(1, 4), 2);
    Output: True;
}

Test At {
    Constraint: At(3).Offset == 3;
    Processing: At(3).EndRelative;
    Output: 0;
}

Test FromEnd {
    Constraint: FromEnd(2).EndRelative == 1;
    Processing: FromEnd(2).Offset;
    Output: 2;
}

Test GetOffset {
    Constraint: GetOffset(FromEnd(2), 8) == 6;
    Processing: GetOffset(FromEnd(2), 8);
    Output: 6;
}

Test Swap {
    Constraint: Swap(1, 4).Start == 4;
    Processing: Swap(1, 4).End;
    Output: 1;
}

Test VersionText {
    Constraint: VersionText(CoreVersion(1, 2, 3)) == "1.2.3";
    Processing: VersionText(CoreVersion(1, 2, 3));
    Output: "1.2.3";
}

Test ParseVersion {
    Constraint: ParseVersion("1.2.3").Major == 1;
    Processing: ParseVersion("1.2.3").Patch;
    Output: 3;
}

Test CompareVersion {
    Constraint: CompareVersion(CoreVersion(1, 0, 0), CoreVersion(1, 2, 0)) == -1;
    Processing: CompareVersion(CoreVersion(1, 0, 0), CoreVersion(1, 2, 0));
    Output: -1;
}

Test SameVersion {
    Constraint: SameVersion(CoreVersion(1, 2, 3), CoreVersion(1, 2, 3)) == True;
    Processing: SameVersion(CoreVersion(1, 2, 3), CoreVersion(1, 2, 3));
    Output: True;
}

Test IsCompatible {
    Constraint: IsCompatible(CoreVersion(1, 2, 0), CoreVersion(1, 1, 0)) == True;
    Processing: IsCompatible(CoreVersion(1, 2, 0), CoreVersion(1, 1, 0));
    Output: True;
}

Test BumpMajor {
    Constraint: BumpMajor(CoreVersion(1, 2, 3)).Major == 2;
    Processing: BumpMajor(CoreVersion(1, 2, 3)).Minor;
    Output: 0;
}

Test BumpMinor {
    Constraint: BumpMinor(CoreVersion(1, 2, 3)).Minor == 3;
    Processing: BumpMinor(CoreVersion(1, 2, 3)).Patch;
    Output: 0;
}

Test BumpPatch {
    Constraint: BumpPatch(CoreVersion(1, 2, 3)).Patch == 4;
    Processing: BumpPatch(CoreVersion(1, 2, 3)).Patch;
    Output: 4;
}

Test Milliseconds {
    Constraint: Milliseconds(15).Duration == 15;
    Processing: Milliseconds(15).Duration;
    Output: 15;
}

Test Seconds {
    Constraint: Seconds(2).Duration == 2000;
    Processing: Seconds(2).Duration;
    Output: 2000;
}

Test Minutes {
    Constraint: Minutes(1).Duration == 60000;
    Processing: Minutes(1).Duration;
    Output: 60000;
}

Test Hours {
    Constraint: Hours(1).Duration == 3600000;
    Processing: Hours(1).Duration;
    Output: 3600000;
}

Test Days {
    Constraint: Days(1).Duration == 86400000;
    Processing: Days(1).Duration;
    Output: 86400000;
}

Test TotalSeconds {
    Constraint: TotalSeconds(Seconds(2)) == 2;
    Processing: TotalSeconds(Seconds(2));
    Output: 2;
}

Test AddSpan {
    Constraint: AddSpan(Milliseconds(1000), Milliseconds(500)).Duration == 1500;
    Processing: AddSpan(Milliseconds(1000), Milliseconds(500)).Duration;
    Output: 1500;
}

Test SubtractSpan {
    Constraint: SubtractSpan(Milliseconds(1000), Milliseconds(250)).Duration == 750;
    Processing: SubtractSpan(Milliseconds(1000), Milliseconds(250)).Duration;
    Output: 750;
}

Test DateText {
    Constraint: DateText(DateTime(2024, 1, 2)) == "2024-01-02";
    Processing: DateText(DateTime(2024, 1, 2));
    Output: "2024-01-02";
}

Test ParseDate {
    Constraint: ParseDate("2024-01-02").Day == 2;
    Processing: ParseDate("2024-01-02").Year;
    Output: 2024;
}

Test IsLeapYear {
    Constraint: IsLeapYear(2024) == True;
    Processing: IsLeapYear(2024);
    Output: True;
}

Test DaysInMonth {
    Constraint: DaysInMonth(2024, 2) == 29;
    Processing: DaysInMonth(2024, 2);
    Output: 29;
}

Test AddDays {
    Constraint: AddDays(DateTime(2024, 1, 31), 1).Day == 1;
    Processing: AddDays(DateTime(2024, 1, 31), 1).Month;
    Output: 2;
}

Test CompareDate {
    Constraint: CompareDate(DateTime(2024, 1, 2), DateTime(2024, 1, 3)) == -1;
    Processing: CompareDate(DateTime(2024, 1, 2), DateTime(2024, 1, 3));
    Output: -1;
}

Test NowMillis {
    Assert: NowMillis() >= 0;
}

Test MakeGuid {
    Constraint: MakeGuid(1, 2).Text == "1-2-3";
    Processing: MakeGuid(1, 2).Text;
    Output: "1-2-3";
}

Test ParseGuid {
    Constraint: ParseGuid("a-b").Text == "a-b";
    Processing: ParseGuid("a-b").Text;
    Output: "a-b";
}

Test EmptyGuid {
    Constraint: EmptyGuid().Text == "00000000-0000-0000-0000-000000000000";
    Processing: EmptyGuid().Text;
    Output: "00000000-0000-0000-0000-000000000000";
}

Test GuidText {
    Constraint: GuidText(MakeGuid(1, 2)) == "1-2-3";
    Processing: GuidText(MakeGuid(1, 2));
    Output: "1-2-3";
}

Test SameGuid {
    Constraint: SameGuid(MakeGuid(1, 2), MakeGuid(1, 2)) == True;
    Processing: SameGuid(MakeGuid(1, 2), MakeGuid(1, 2));
    Output: True;
}

Test MemberwiseClone {
    Constraint: MemberwiseClone(4) == 4;
    Processing: MemberwiseClone(4);
    Output: 4;
}

Test ClonePair {
    Constraint: ClonePair(1, 2).Count() == 2;
    Processing: ClonePair(1, 2).Count();
    Output: 2;
}

Test CultureName {
    Constraint: CultureName(CultureInfo("en")) == "en";
    Processing: CultureName(CultureInfo("en"));
    Output: "en";
}
