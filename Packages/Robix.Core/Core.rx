}

Public Function Compare(Int left, Int right) -> Int
Explain {
    Description: "Order two integers.";
    Input: left = "Left integer", right = "Right integer";
    Processing: "Compare the values.";
    Output: "-1, 0, or 1.";
} {
    Return CompareInt(left, right);
}

Public Function TryConvert<T>(String value) -> ParseOutcome
Explain {
    Description: "Try to convert text to a number or boolean.";
    Input: value = "Value text";
    Processing: "Accept an integer, a float, or a boolean. Record the failure otherwise.";
    Output: "Ok is 1 when the conversion succeeded.";
} {
    String clean = Clean(value);
    If (IsIntText(clean)) {
        Int integer = clean.ToInt();
        Return ParseOutcome(1, integer, integer.ToFloat(), clean);
    }
    If (IsFloatText(clean)) { Return ParseOutcome(1, 0, clean.ToFloat(), clean); }
    If (IsBoolText(clean)) { Return ParseOutcome(1, 0, 0.0, BoolText(ReadBool(clean))); }
    Return ParseOutcome(0, 0, 0.0, clean);
}

Public Function ConvertChecked<T>(String value) -> String
Explain {
    Description: "Convert text when the form is known.";
    Input: value = "Value text";
    Processing: "Accept an integer, float, or boolean. Reject every other form.";
    Output: "The normalized text, or empty when the conversion is rejected.";
} {
    ParseOutcome parsed = TryConvert(value);
    If (parsed.Ok == 0) { Return ""; }
    Return parsed.Text;
}

Public Function ConvertUnchecked<T>(String value) -> String
Explain {
    Description: "Convert text, keeping the original when the form is unknown.";
    Input: value = "Value text";
    Processing: "Use the checked conversion, then fall back to the trimmed text.";
    Output: "The converted text, or the original trimmed text.";
} {
    String converted = ConvertChecked(value);
    If (converted.Length() == 0) { Return Clean(value); }
    Return converted;
}

Public Function Kind(String text) -> String
Explain {
    Description: "Classify input text as empty, boolean, integer, float, or string.";
    Input: text = "Input text";
    Processing: "Trim the text and test the boolean, integer, and float forms.";
    Output: "Empty, Bool, Int, Float, or String.";
} {
    String clean = Clean(text);
    If (clean.Length() == 0) { Return "Empty"; }
    If (IsBoolText(clean)) { Return "Bool"; }
    If (IsIntText(clean)) { Return "Int"; }
    If (IsFloatText(clean)) { Return "Float"; }
    Return "String";
}

Public Function HasInput(String text) -> Bool
Explain {
    Description: "Report whether input text contains a value.";
    Input: text = "Input text";
    Processing: "Trim the text and test the length.";
    Output: "True when a value is present.";
} {
    Return !IsBlank(text);
}

