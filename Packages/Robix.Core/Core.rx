    Explain {
        Description: "Release the object.";
        Input: "No parameters";
        Processing: "Free the held resource.";
        Output: "No return value.";
    };
}

Public Interface IAsyncDisposable {
    Public Async Function DisposeAsync() -> Task<Void>
    Explain {
        Description: "Release the object asynchronously.";
        Input: "No parameters";
        Processing: "Free the held resource on this turn.";
        Output: "No return value.";
    };
}

Private Function Clean(String text) -> String {
    If (text == Null) { Return ""; }
    Return text.Trim();
}

Private Function Digit(String piece) -> Int {
    If (piece.Length() != 1) { Return -1; }
    Int code = piece.GetChar(0).ToInt();
    If (code >= 0 && code <= 9) { Return code; }
    If (code >= 48 && code <= 57) { Return code - 48; }
    Return -1;
}

Private Function IsIntText(String text) -> Bool {
    If (text.Length() == 0) { Return False; }
    Int index = 0;
    String sign = text.Substring(0, 1);
    If (sign == "+" || sign == "-") { index = 1; }
    If (index >= text.Length()) { Return False; }
    While (index < text.Length()) {
        If (Digit(text.Substring(index, 1)) < 0) { Return False; }
        index = index + 1;
    }
    Return True;
}

Private Function IsFloatText(String text) -> Bool {
    If (text.Length() == 0) { Return False; }
    Int index = 0;
    Int dots = 0;
    Int digits = 0;
    String sign = text.Substring(0, 1);
    If (sign == "+" || sign == "-") { index = 1; }
    If (index >= text.Length()) { Return False; }
    While (index < text.Length()) {
        String piece = text.Substring(index, 1);
        If (piece == ".") {
            dots = dots + 1;
            If (dots > 1) { Return False; }
        } Else {
            If (Digit(piece) < 0) { Return False; }
            digits = digits + 1;
        }
        index = index + 1;
    }
    Return digits > 0;
}

Private Function IsBoolText(String text) -> Bool {
    String lower = text.ToLower();
    If (lower == "true" || lower == "false") { Return True; }
    If (lower == "yes" || lower == "no") { Return True; }
    If (lower == "1" || lower == "0") { Return True; }
    Return False;
}

Private Function Pad2(Int value) -> String {
    Int current = value;
    If (current < 0) { current = 0 - current; }
    If (current < 10) { Return "0" + current.ToString(); }
    Return current.ToString();
}

Private Function HexDigit(Int value) -> String {
    Int digit = value % 16;
    If (digit < 0) { digit = 0 - digit; }
    If (digit < 10) { Return digit.ToString(); }
    If (digit == 10) { Return "a"; }
    If (digit == 11) { Return "b"; }
    If (digit == 12) { Return "c"; }
    If (digit == 13) { Return "d"; }
    If (digit == 14) { Return "e"; }
    Return "f";
}

Private Function HexValue(String piece) -> Int {
    String lower = piece.ToLower();
    Int digit = Digit(lower);
    If (digit >= 0) { Return digit; }
    If (lower == "a") { Return 10; }
    If (lower == "b") { Return 11; }
    If (lower == "c") { Return 12; }
    If (lower == "d") { Return 13; }
    If (lower == "e") { Return 14; }
    If (lower == "f") { Return 15; }
    Return -1;
}

