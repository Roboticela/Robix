}

Public Function IsUndefined(String? value) -> Bool
Explain {
    Description: "Report whether a value is null, missing, or blank.";
    Input: value = "Value to test";
    Processing: "Treat null and blank text as undefined.";
    Output: "True when the value is undefined.";
} {
    If (value == Null) { Return True; }
    Return Clean(value).Length() == 0;
}

Public Function IsNull(String? value) -> Bool
Explain {
    Description: "Report whether a reference is absent.";
    Input: value = "Reference to test";
    Processing: "Compare the reference with Null.";
    Output: "True when the reference is null.";
} {
    If (value == Null) { Return True; }
    Return False;
}

