Explain {
    Description: "Clamp an integer to a range.";
    Input: value = "Integer value", minimum = "Lower bound", maximum = "Upper bound";
    Processing: "Raise the value to the minimum and lower it to the maximum.";
    Output: "The clamped integer.";
} {
