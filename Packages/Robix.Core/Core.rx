    Description: "Make a range with a step of one.";
    Input: start = "Inclusive start", end = "Exclusive end";
    Processing: "Store the bounds and a step of 1.";
    Output: "The range.";
} {
    Return CoreRange(start, end, 1);
}

Public Function MakeRangeStep(Int start, Int end, Int step) -> CoreRange
Explain {
    Description: "Make a range with an explicit step.";
    Input: start = "Inclusive start", end = "Exclusive end", step = "Step size";
    Processing: "Store the bounds and the step.";
    Output: "The range.";
} {
    Return CoreRange(start, end, step);
}

Public Function SumRange(CoreRange range) -> Int
Explain {
    Description: "Sum the integers in a range.";
    Input: range = "Range to walk";
    Processing: "Add each value from the start until the end, using the step.";
    Output: "The sum.";
} {
    Int total = 0;
    Int cursor = range.Start;
    Int step = range.Step;
    If (step == 0) { step = 1; }
    If (step < 0) { step = 0 - step; }
    While (cursor < range.End) {
        total = total + cursor;
        cursor = cursor + step;
    }
    Return total;
}

Public Function RangeCount(CoreRange range) -> Int
Explain {
    Description: "Count the integers in a range.";
    Input: range = "Range to walk";
    Processing: "Count each value from the start until the end, using the step.";
    Output: "The count.";
} {
    Int count = 0;
    Int cursor = range.Start;
    Int step = range.Step;
    If (step == 0) { step = 1; }
    If (step < 0) { step = 0 - step; }
    While (cursor < range.End) {
        count = count + 1;
        cursor = cursor + step;
    }
    Return count;
}

Public Function RangeContains(CoreRange range, Int value) -> Bool
Explain {
    Description: "Report whether a range contains an integer.";
    Input: range = "Range to test", value = "Integer value";
    Processing: "Test the bounds and whether the step lands on the value.";
    Output: "True when the value is in the range.";
} {
    Int step = range.Step;
    If (step == 0) { step = 1; }
    If (step < 0) { step = 0 - step; }
    If (value < range.Start || value >= range.End) { Return False; }
    Int delta = value - range.Start;
    Return delta % step == 0;
}

