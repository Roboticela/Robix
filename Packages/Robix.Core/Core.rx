Public Function ToHex(Int value) -> String
Explain {
    Description: "Convert an integer to hexadecimal text.";
    Input: value = "Integer value";
    Processing: "Render the absolute value in base 16.";
    Output: "Lowercase hexadecimal text.";
} {
    If (value == 0) { Return "0"; }
    Int current = value;
    If (current < 0) { current = 0 - current; }
    String text = "";
    While (current > 0) {
        text = HexDigit(current) + text;
        current = current / 16;
    }
    Return text;
}

