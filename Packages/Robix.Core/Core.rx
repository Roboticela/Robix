Public Function CanConvert(String source, String target) -> Bool
Explain {
    Description: "Report whether Core can convert one kind of value to another.";
    Input: source = "Source kind", target = "Target kind";
    Processing: "Compare the kind names with the conversions this package provides.";
    Output: "True when the conversion is available.";
} {
    String left = source.ToLower();
    String right = target.ToLower();
    If (left == right) { Return True; }
    If (left == "int" && (right == "float" || right == "string" || right == "bool" || right == "byte" || right == "hex" || right == "binary")) { Return True; }
    If (left == "string" && (right == "int" || right == "float" || right == "bool" || right == "guid" || right == "version" || right == "date" || right == "base64")) { Return True; }
    If (left == "bool" && (right == "int" || right == "string")) { Return True; }
    If (left == "float" && (right == "int" || right == "string")) { Return True; }
    Return False;
}

