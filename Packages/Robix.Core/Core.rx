Public Function AddDigits(String left, String right) -> String
Explain {
    Description: "Add two non-negative integers written as digits.";
    Input: left = "Left digits", right = "Right digits";
    Processing: "Add the digits from right to left and keep the carry.";
    Output: "The sum as digits.";
} {
    Int leftIndex = left.Length() - 1;
    Int rightIndex = right.Length() - 1;
    Int carry = 0;
    String result = "";
    While (leftIndex >= 0 || rightIndex >= 0 || carry > 0) {
        Int total = carry;
        If (leftIndex >= 0) {
            total = total + Digit(left.Substring(leftIndex, 1));
            leftIndex = leftIndex - 1;
        }
        If (rightIndex >= 0) {
            total = total + Digit(right.Substring(rightIndex, 1));
            rightIndex = rightIndex - 1;
        }
        If (total < 0) { total = 0; }
        carry = total / 10;
        result = (total % 10).ToString() + result;
    }
    If (result == "") { Return "0"; }
    Return result;
}

