Public Function GetOffset(Index index, Int length) -> Int
Explain {
    Description: "Resolve an index against a length.";
    Input: index = "Start-relative or end-relative index", length = "Collection length";
    Processing: "Subtract an end-relative offset from the length.";
    Output: "The resolved offset.";
} {
    If (index.EndRelative == 1) { Return length - index.Offset; }
    Return index.Offset;
}

