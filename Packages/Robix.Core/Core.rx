Public Function CompareInt(Int left, Int right) -> Int
Explain {
    Description: "Order two integers.";
    Input: left = "Left integer", right = "Right integer";
    Processing: "Compare the values.";
    Output: "-1 when left is smaller, 1 when left is larger, and 0 when equal.";
} {
    If (left < right) { Return -1; }
    If (left > right) { Return 1; }
    Return 0;
}

Public Function CompareText(String left, String right) -> Int
Explain {
    Description: "Order two strings.";
    Input: left = "Left text", right = "Right text";
    Processing: "Compare characters from the left, then the lengths.";
    Output: "-1, 0, or 1.";
} {
    Int index = 0;
    Int limit = left.Length();
    If (right.Length() < limit) { limit = right.Length(); }
    While (index < limit) {
        Int leftCode = left.GetChar(index).ToInt();
        Int rightCode = right.GetChar(index).ToInt();
        If (leftCode < rightCode) { Return -1; }
        If (leftCode > rightCode) { Return 1; }
        index = index + 1;
    }
    If (left.Length() < right.Length()) { Return -1; }
    If (left.Length() > right.Length()) { Return 1; }
    Return 0;
}

Public Function CompareFloat(Float left, Float right) -> Int
Explain {
    Description: "Order two floats.";
    Input: left = "Left float", right = "Right float";
    Processing: "Compare the values.";
    Output: "-1, 0, or 1.";
} {
    If (left < right) { Return -1; }
    If (left > right) { Return 1; }
