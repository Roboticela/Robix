} {
    Return ToBase(value, 2);
}

Public Function FromBinary(String text) -> Int
Explain {
    Description: "Convert binary text to an integer.";
    Input: text = "Binary text";
    Processing: "Read the text as base 2.";
    Output: "The integer, or zero when the text is not binary.";
} {
    Return FromBase(text, 2);
}

Public Function ToBase(Int value, Int radix) -> String
Explain {
    Description: "Convert an integer to text in a radix from 2 through 36.";
    Input: value = "Integer value", radix = "Radix from 2 through 36";
    Processing: "Divide by the radix and write the remainders.";
    Output: "The converted text, or empty when the radix is outside 2 through 36.";
} {
    If (radix < 2 || radix > 36) { Return ""; }
    If (value == 0) { Return "0"; }
    Int current = value;
    String sign = "";
    If (current < 0) {
        sign = "-";
        current = 0 - current;
    }
    String alphabet = "0123456789abcdefghijklmnopqrstuvwxyz";
    String text = "";
    While (current > 0) {
        text = alphabet.Substring(current % radix, 1) + text;
        current = current / radix;
    }
    Return sign + text;
}

Public Function FromBase(String text, Int radix) -> Int
Explain {
    Description: "Convert text in a radix from 2 through 36 to an integer.";
    Input: text = "Digits for the radix", radix = "Radix from 2 through 36";
    Processing: "Accumulate each digit.";
    Output: "The integer, or zero when the text or radix is invalid.";
} {
    If (radix < 2 || radix > 36) { Return 0; }
    String clean = Clean(text).ToLower();
    If (clean.Length() == 0) { Return 0; }
    Int index = 0;
    Int sign = 1;
    If (clean.Substring(0, 1) == "-") {
        sign = -1;
        index = 1;
    }
    If (index >= clean.Length()) { Return 0; }
    String alphabet = "0123456789abcdefghijklmnopqrstuvwxyz";
    Int value = 0;
    While (index < clean.Length()) {
        Int digit = alphabet.IndexOf(clean.Substring(index, 1));
        If (digit < 0 || digit >= radix) { Return 0; }
        value = value * radix + digit;
        index = index + 1;
    }
    Return sign * value;
}

Public Function ToBase64(String text) -> String
Explain {
    Description: "Encode text as Base64.";
    Input: text = "Text to encode";
    Processing: "Group the character codes into 6-bit Base64 digits.";
    Output: "The Base64 text.";
} {
    String alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    String result = "";
    Int index = 0;
    While (index < text.Length()) {
        Int first = text.GetChar(index).ToInt();
        Int second = 0;
        Int third = 0;
        Int count = 1;
        If (index + 1 < text.Length()) {
            second = text.GetChar(index + 1).ToInt();
            count = 2;
        }
        If (index + 2 < text.Length()) {
            third = text.GetChar(index + 2).ToInt();
            count = 3;
        }
        Int bundle = first * 65536 + second * 256 + third;
        result = result + alphabet.Substring((bundle / 262144) % 64, 1);
        result = result + alphabet.Substring((bundle / 4096) % 64, 1);
        If (count < 2) {
            result = result + "==";
        } Else {
            result = result + alphabet.Substring((bundle / 64) % 64, 1);
            If (count < 3) {
                result = result + "=";
            } Else {
                result = result + alphabet.Substring(bundle % 64, 1);
            }
        }
        index = index + 3;
    }
    Return result;
}

Public Function FromBase64(String text) -> String
Explain {
    Description: "Decode Base64 text.";
    Input: text = "Base64 text";
    Processing: "Turn each group of four Base64 digits back into characters.";
    Output: "The decoded text, or empty when the text is not Base64.";
} {
    String alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    String result = "";
    Int index = 0;
    While (index + 1 < text.Length()) {
        Int firstDigit = alphabet.IndexOf(text.Substring(index, 1));
        Int secondDigit = alphabet.IndexOf(text.Substring(index + 1, 1));
        If (firstDigit < 0 || secondDigit < 0) { Return ""; }
        Int thirdDigit = -1;
        Int fourthDigit = -1;
        If (index + 2 < text.Length() && text.Substring(index + 2, 1) != "=") {
            thirdDigit = alphabet.IndexOf(text.Substring(index + 2, 1));
            If (thirdDigit < 0) { Return ""; }
        }
        If (index + 3 < text.Length() && text.Substring(index + 3, 1) != "=") {
            fourthDigit = alphabet.IndexOf(text.Substring(index + 3, 1));
            If (fourthDigit < 0) { Return ""; }
        }
        result = result + Character((firstDigit * 4) + (secondDigit / 16));
        If (thirdDigit >= 0) {
            result = result + Character(((secondDigit % 16) * 16) + (thirdDigit / 4));
        }
        If (fourthDigit >= 0 && thirdDigit >= 0) {
            result = result + Character(((thirdDigit % 4) * 64) + fourthDigit);
        }
        index = index + 4;
    }
    Return result;
}

Private Function Character(Int code) -> String {
    If (code < 32 || code > 126) { Return ""; }
    String printable = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    Return printable.Substring(code - 32, 1);
}

Public Function FromHex(String text) -> Int
Explain {
    Description: "Convert hexadecimal text to an integer.";
    Input: text = "Hexadecimal text, with an optional 0x prefix";
    Processing: "Read each hex digit into an integer.";
    Output: "The integer, or zero when the text is not hexadecimal.";
} {
    String clean = Clean(text).ToLower();
    If (clean.StartsWith("0x")) { clean = clean.Substring(2); }
    If (clean.Length() == 0) { Return 0; }
    Int value = 0;
    Int index = 0;
    While (index < clean.Length()) {
        Int digit = HexValue(clean.Substring(index, 1));
        If (digit < 0) { Return 0; }
        value = value * 16 + digit;
        index = index + 1;
    }
    Return value;
}

