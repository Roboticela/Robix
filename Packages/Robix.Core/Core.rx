Public Function VersionText(CoreVersion version) -> String
Explain {
    Description: "Render a version as major.minor.patch.";
    Input: version = "Version value";
    Processing: "Join the three numbers with dots.";
    Output: "The version text.";
} {
    Return version.Major.ToString() + "." + version.Minor.ToString() + "." + version.Patch.ToString();
}

Public Function ParseVersion(String text) -> CoreVersion
Explain {
    Description: "Parse major.minor.patch text.";
    Input: text = "Version text";
    Processing: "Read up to three dot-separated integers. Missing parts are zero.";
    Output: "The version.";
} {
    String clean = Clean(text);
    Int major = 0;
    Int minor = 0;
    Int patch = 0;
    Int part = 0;
    Int value = 0;
    Int seen = 0;
    Int index = 0;
    While (index <= clean.Length()) {
        Bool boundary = index == clean.Length();
        String piece = "";
        If (!boundary) { piece = clean.Substring(index, 1); }
        If (boundary || piece == ".") {
            If (seen == 1) {
                If (part == 0) { major = value; }
                If (part == 1) { minor = value; }
                If (part == 2) { patch = value; }
                part = part + 1;
            }
            value = 0;
            seen = 0;
        } Else {
            Int digit = Digit(piece);
            If (digit >= 0) {
                value = value * 10 + digit;
                seen = 1;
            }
        }
        index = index + 1;
    }
    Return CoreVersion(major, minor, patch);
}

Public Function CompareVersion(CoreVersion left, CoreVersion right) -> Int
Explain {
    Description: "Order two versions.";
    Input: left = "Left version", right = "Right version";
    Processing: "Compare major, then minor, then patch.";
    Output: "-1, 0, or 1.";
} {
    Int major = CompareInt(left.Major, right.Major);
    If (major != 0) { Return major; }
    Int minor = CompareInt(left.Minor, right.Minor);
    If (minor != 0) { Return minor; }
    Return CompareInt(left.Patch, right.Patch);
}

Public Function SameVersion(CoreVersion left, CoreVersion right) -> Bool
Explain {
    Description: "Report whether two versions are the same.";
    Input: left = "Left version", right = "Right version";
    Processing: "Compare major, minor, and patch.";
    Output: "True when all three numbers match.";
} {
    Return CompareVersion(left, right) == 0;
}

Public Function IsCompatible(CoreVersion current, CoreVersion required) -> Bool
Explain {
    Description: "Report whether a version satisfies a required version in the same major line.";
    Input: current = "Available version", required = "Required version";
    Processing: "Require the same major and a current version that is at least the required version.";
    Output: "True when the versions are compatible.";
} {
    If (current.Major != required.Major) { Return False; }
    Return CompareVersion(current, required) >= 0;
}

Public Function BumpMajor(CoreVersion version) -> CoreVersion
Explain {
    Description: "Increase the major version and reset the rest.";
    Input: version = "Version value";
    Processing: "Add one to the major number.";
    Output: "The next major version.";
} {
    Return CoreVersion(version.Major + 1, 0, 0);
}

Public Function BumpMinor(CoreVersion version) -> CoreVersion
Explain {
    Description: "Increase the minor version and reset the patch.";
    Input: version = "Version value";
    Processing: "Add one to the minor number.";
    Output: "The next minor version.";
} {
    Return CoreVersion(version.Major, version.Minor + 1, 0);
}

Public Function BumpPatch(CoreVersion version) -> CoreVersion
Explain {
    Description: "Increase the patch version.";
    Input: version = "Version value";
    Processing: "Add one to the patch number.";
    Output: "The next patch version.";
} {
    Return CoreVersion(version.Major, version.Minor, version.Patch + 1);
}

Public Function Milliseconds(Int value) -> TimeSpan
Explain {
    Description: "Make a time span from milliseconds.";
    Input: value = "Millisecond count";
    Processing: "Store the count.";
    Output: "The time span.";
} {
    Return TimeSpan(value);
}

Public Function Seconds(Int value) -> TimeSpan
Explain {
    Description: "Make a time span from seconds.";
    Input: value = "Second count";
    Processing: "Convert seconds to milliseconds.";
    Output: "The time span.";
} {
    Return TimeSpan(value * 1000);
}

Public Function Minutes(Int value) -> TimeSpan
Explain {
    Description: "Make a time span from minutes.";
    Input: value = "Minute count";
    Processing: "Convert minutes to milliseconds.";
    Output: "The time span.";
} {
    Return TimeSpan(value * 60000);
}

Public Function Hours(Int value) -> TimeSpan
Explain {
    Description: "Make a time span from hours.";
    Input: value = "Hour count";
    Processing: "Convert hours to milliseconds.";
    Output: "The time span.";
} {
    Return TimeSpan(value * 3600000);
}

Public Function Days(Int value) -> TimeSpan
Explain {
    Description: "Make a time span from days.";
    Input: value = "Day count";
    Processing: "Convert days to milliseconds.";
    Output: "The time span.";
} {
    Return TimeSpan(value * 86400000);
}

Public Function TotalSeconds(TimeSpan span) -> Int
Explain {
    Description: "Convert a time span to whole seconds.";
    Input: span = "Time span";
    Processing: "Divide the milliseconds by 1000.";
    Output: "The whole seconds.";
} {
    Return span.Duration / 1000;
}

Public Function AddSpan(TimeSpan left, TimeSpan right) -> TimeSpan
Explain {
    Description: "Add two time spans.";
    Input: left = "Left span", right = "Right span";
    Processing: "Add the millisecond counts.";
    Output: "The sum.";
} {
    Return TimeSpan(left.Duration + right.Duration);
}

Public Function SubtractSpan(TimeSpan left, TimeSpan right) -> TimeSpan
Explain {
    Description: "Subtract one time span from another.";
    Input: left = "Left span", right = "Right span";
    Processing: "Subtract the millisecond counts.";
    Output: "The difference.";
} {
    Return TimeSpan(left.Duration - right.Duration);
}

Public Function DateText(DateTime value) -> String
Explain {
    Description: "Render a date as year-month-day.";
    Input: value = "Date value";
    Processing: "Join the year, month, and day with dashes.";
    Output: "The date text.";
} {
    Return value.Year.ToString() + "-" + Pad2(value.Month) + "-" + Pad2(value.Day);
}

Public Function ParseDate(String text) -> DateTime
Explain {
    Description: "Parse year-month-day text.";
    Input: text = "Date text such as 2026-11-24";
    Processing: "Read the year, month, and day around the dashes.";
    Output: "The date, or year 1 when the text does not match.";
} {
    String clean = Clean(text);
    If (clean.Length() < 10) { Return DateTime(1, 1, 1); }
    If (clean.Substring(4, 1) != "-" || clean.Substring(7, 1) != "-") { Return DateTime(1, 1, 1); }
    Int year = clean.Substring(0, 4).ToInt();
    Int month = clean.Substring(5, 2).ToInt();
    Int day = clean.Substring(8, 2).ToInt();
    Return DateTime(year, month, day);
}

Public Function IsLeapYear(Int year) -> Bool
Explain {
    Description: "Report whether a year has a leap day.";
    Input: year = "Year number";
    Processing: "A leap year is divisible by 4, except centuries that are not divisible by 400.";
    Output: "True for a leap year.";
} {
    If (year % 4 != 0) { Return False; }
    If (year % 100 != 0) { Return True; }
    Return year % 400 == 0;
}

Public Function DaysInMonth(Int year, Int month) -> Int
Explain {
    Description: "Return the number of days in a month.";
    Input: year = "Year number", month = "Month from 1 through 12";
    Processing: "Use the calendar length and the leap-year rule for February.";
    Output: "The day count, or zero when the month is outside 1 through 12.";
} {
    If (month < 1 || month > 12) { Return 0; }
    If (month == 2) {
        If (IsLeapYear(year)) { Return 29; }
        Return 28;
    }
    If (month == 4 || month == 6 || month == 9 || month == 11) { Return 30; }
    Return 31;
}

Public Function AddDays(DateTime value, Int days) -> DateTime
Explain {
    Description: "Add a number of days to a date.";
    Input: value = "Start date", days = "Day count, which may be negative";
    Processing: "Walk month lengths, including leap days.";
    Output: "The resulting date.";
} {
    Int year = value.Year;
    Int month = value.Month;
    Int day = value.Day + days;
    While (day > DaysInMonth(year, month)) {
        day = day - DaysInMonth(year, month);
        month = month + 1;
        If (month > 12) {
            month = 1;
            year = year + 1;
        }
    }
    While (day < 1) {
        month = month - 1;
        If (month < 1) {
            month = 12;
            year = year - 1;
        }
        day = day + DaysInMonth(year, month);
    }
    DateTime result = DateTime(year, month, day);
    result.Hour = value.Hour;
    result.Minute = value.Minute;
    result.Second = value.Second;
    Return result;
}

Public Function CompareDate(DateTime left, DateTime right) -> Int
Explain {
    Description: "Order two dates.";
    Input: left = "Left date", right = "Right date";
    Processing: "Compare year, month, day, then the time of day.";
    Output: "-1, 0, or 1.";
} {
    Int year = CompareInt(left.Year, right.Year);
    If (year != 0) { Return year; }
    Int month = CompareInt(left.Month, right.Month);
    If (month != 0) { Return month; }
    Int day = CompareInt(left.Day, right.Day);
    If (day != 0) { Return day; }
    Int hour = CompareInt(left.Hour, right.Hour);
    If (hour != 0) { Return hour; }
    Int minute = CompareInt(left.Minute, right.Minute);
    If (minute != 0) { Return minute; }
    Return CompareInt(left.Second, right.Second);
}

Public Function NowMillis() -> Int
Explain {
    Description: "Read the clock in milliseconds.";
    Input: "No parameters";
    Processing: "Read the runtime clock.";
    Output: "Milliseconds since the clock started.";
} {
    Return ClockMillis();
}

Public Function MakeGuid(Int left, Int right) -> Guid
Explain {
    Description: "Make a deterministic identity from two integers.";
    Input: left = "Left integer", right = "Right integer";
    Processing: "Render the integers as hexadecimal groups.";
    Output: "The identity.";
} {
    String text = ToHex(left) + "-" + ToHex(right) + "-" + ToHex(left + right);
    Return Guid(text);
}

Public Function ParseGuid(String text) -> Guid
Explain {
    Description: "Parse identity text.";
    Input: text = "Hexadecimal identity text, with optional dashes";
    Processing: "Accept hex digits and dashes. Reject any other character.";
    Output: "The identity, or the empty identity when the text is invalid.";
} {
    String clean = Clean(text).ToLower();
    If (clean.Length() == 0) { Return EmptyGuid(); }
    Int index = 0;
    While (index < clean.Length()) {
        String piece = clean.Substring(index, 1);
        If (piece != "-" && HexValue(piece) < 0) { Return EmptyGuid(); }
        index = index + 1;
    }
    Return Guid(clean);
}

Public Function EmptyGuid() -> Guid
Explain {
    Description: "Make the empty identity.";
    Input: "No parameters";
    Processing: "Use the zero identity text.";
    Output: "The empty identity.";
} {
    Return Guid("00000000-0000-0000-0000-000000000000");
}

Public Function GuidText(Guid value) -> String
Explain {
    Description: "Render an identity as text.";
    Input: value = "Identity value";
    Processing: "Read the stored text.";
    Output: "The identity text.";
} {
    Return value.Text;
}

Public Function SameGuid(Guid left, Guid right) -> Bool
Explain {
    Description: "Compare two identities.";
    Input: left = "Left identity", right = "Right identity";
    Processing: "Compare the identity text.";
    Output: "True when the identities match.";
} {
    Return left.Text == right.Text;
}

Public Function MemberwiseClone<T>(T value) -> T
Explain {
    Description: "Copy a value member by member.";
    Input: value = "Value to copy";
    Processing: "Return the value. Value types are copied by the call.";
    Output: "The copy.";
} {
    Return value;
}

Public Function ClonePair(Int first, Int second) -> Array<Int>
Explain {
    Description: "Copy two integers into a new array.";
    Input: first = "First integer", second = "Second integer";
    Processing: "Store the integers in a new array.";
    Output: "The copy.";
} {
    Array<Int> copy = [first, second];
    Return copy;
}

Public Function CultureName(CultureInfo culture) -> String
Explain {
    Description: "Read the name of a culture.";
    Input: culture = "Culture value";
    Processing: "Read the stored name.";
    Output: "The culture name.";
} {
    Return culture.Name;
}
