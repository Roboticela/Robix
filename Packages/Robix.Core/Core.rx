Public Function HashText(String text) -> Int
Explain {
    Description: "Hash text to a stable integer.";
    Input: text = "Text to hash";
    Processing: "Fold each character into a positive hash.";
    Output: "The hash.";
} {
    Int hash = 5381;
    Int index = 0;
    While (index < text.Length()) {
        hash = hash * 33 + text.GetChar(index).ToInt();
        index = index + 1;
    }
    If (hash < 0) { hash = 0 - hash; }
    Return hash;
}

