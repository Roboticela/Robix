Public Function Accepted(String text, String kind) -> Bool
Explain {
    Description: "Report whether input text matches a requested kind.";
    Input: text = "Input text", kind = "Int, Float, Bool, or Text";
    Processing: "Trim the text and test it against the kind.";
    Output: "True when the input is accepted.";
} {
    String clean = Clean(text);
    String name = kind.ToLower();
    If (name == "int") { Return IsIntText(clean); }
    If (name == "float") { Return IsFloatText(clean); }
    If (name == "bool") { Return IsBoolText(clean); }
    If (name == "text") { Return clean.Length() > 0; }
    Return False;
}

Public Function ReadText(String text) -> String
Explain {
    Description: "Read text from input.";
    Input: text = "Input text";
    Processing: "Trim surrounding space.";
    Output: "The trimmed text.";
} {
    Return Clean(text);
}

Public Function ReadLine(String text) -> String
Explain {
    Description: "Read one input line.";
    Input: text = "Input line";
    Processing: "Trim surrounding space and keep the inner text.";
    Output: "The line.";
} {
    Return Clean(text);
}

Public Function ReadInt(String text) -> Int
Explain {
    Description: "Read an integer from input text.";
    Input: text = "Input text with an optional sign and digits";
    Processing: "Trim the text and accept only a signed integer.";
    Output: "The integer, or zero when the text is not an integer.";
} {
    String clean = Clean(text);
    If (!IsIntText(clean)) { Return 0; }
    Return clean.ToInt();
}

Public Function ReadFloat(String text) -> Float
Explain {
    Description: "Read a float from input text.";
    Input: text = "Input text with digits and an optional decimal point";
    Processing: "Trim the text and accept an integer or decimal form.";
    Output: "The float, or zero when the text is not a number.";
} {
    String clean = Clean(text);
    If (!IsFloatText(clean)) { Return 0.0; }
    Return clean.ToFloat();
}

Public Function ReadBool(String text) -> Bool
Explain {
    Description: "Read a boolean from input text.";
    Input: text = "true, false, yes, no, 1, or 0";
    Processing: "Trim the text and compare it with the boolean words.";
    Output: "True for true, yes, and 1. False otherwise.";
} {
    String clean = Clean(text);
    If (!IsBoolText(clean)) { Return False; }
    String lower = clean.ToLower();
    If (lower == "true" || lower == "yes" || lower == "1") { Return True; }
    Return False;
}

Public Function ReadChar(String text) -> String
Explain {
    Description: "Read the first character from input text.";
    Input: text = "Input text";
    Processing: "Trim the text and take the first character.";
    Output: "The character, or empty when the input is blank.";
} {
    String clean = Clean(text);
    If (clean.Length() == 0) { Return ""; }
    Return clean.Substring(0, 1);
}

Public Function TryReadInt(String text) -> ParseOutcome
Explain {
    Description: "Try to read an integer from input text.";
    Input: text = "Input text";
    Processing: "Accept a signed integer and record whether it parsed.";
    Output: "Ok is 1 when the integer was read.";
} {
    String clean = Clean(text);
    If (!IsIntText(clean)) { Return ParseOutcome(0, 0, 0.0, clean); }
    Int value = clean.ToInt();
    Return ParseOutcome(1, value, value.ToFloat(), clean);
}

Public Function TryReadFloat(String text) -> ParseOutcome
Explain {
    Description: "Try to read a float from input text.";
    Input: text = "Input text";
    Processing: "Accept an integer or decimal form and record whether it parsed.";
    Output: "Ok is 1 when the float was read.";
} {
    String clean = Clean(text);
    If (!IsFloatText(clean)) { Return ParseOutcome(0, 0, 0.0, clean); }
    Float value = clean.ToFloat();
    Return ParseOutcome(1, value.ToInt(), value, clean);
}

Public Function TryReadBool(String text) -> ParseOutcome
Explain {
    Description: "Try to read a boolean from input text.";
    Input: text = "Input text";
    Processing: "Accept a boolean word and record whether it parsed.";
    Output: "Ok is 1 when the boolean was read. Integer is 1 for true.";
} {
    String clean = Clean(text);
    If (!IsBoolText(clean)) { Return ParseOutcome(0, 0, 0.0, clean); }
    If (ReadBool(clean)) { Return ParseOutcome(1, 1, 1.0, clean); }
    Return ParseOutcome(1, 0, 0.0, clean);
}

Public Function ToBoolean(String text) -> Bool
Explain {
    Description: "Convert text to a boolean.";
    Input: text = "true, false, yes, no, 1, or 0";
    Processing: "Use the boolean input reader.";
    Output: "The boolean value.";
} {
    Return ReadBool(text);
}

Public Function ToByte(Int value) -> Int
Explain {
    Description: "Convert an integer to the byte range.";
    Input: value = "Integer value";
    Processing: "Clamp the value to 0 through 255.";
    Output: "The byte value.";
} {
    If (value < 0) { Return 0; }
    If (value > 255) { Return 255; }
    Return value;
}

Public Function ToInt32(Int value) -> Int
Explain {
    Description: "Convert an integer to the 32-bit signed range.";
    Input: value = "Integer value";
    Processing: "Clamp the value to the signed 32-bit limits.";
    Output: "The clamped integer.";
} {
    Int limit = 2147483647;
    If (value > limit) { Return limit; }
    If (value < 0 - limit) { Return 0 - limit; }
    Return value;
}

Public Function ToInt(String text) -> Int
Explain {
    Description: "Convert text to an integer.";
    Input: text = "Integer text";
    Processing: "Accept an optional sign and digits.";
    Output: "The integer, or zero when the text is not an integer.";
} {
    Return ReadInt(text);
}

Public Function ToFloat64(Int value) -> Float
Explain {
    Description: "Convert an integer to a float.";
    Input: value = "Integer value";
    Processing: "Widen the integer.";
    Output: "The float value.";
} {
    Return value.ToFloat();
}

Public Function ToFloat(String text) -> Float
Explain {
    Description: "Convert text to a float.";
    Input: text = "Numeric text";
    Processing: "Accept an integer or decimal form.";
