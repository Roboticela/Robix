Public Function Is<T>(String value) -> Bool
Explain {
    Description: "Report whether a value has a usable representation.";
    Input: value = "Value text";
    Processing: "Reject null and blank text.";
    Output: "True when the value is present.";
} {
    Return !IsUndefined(value);
}

Public Function As<T>(String value) -> String
Explain {
    Description: "Return a value when it is present.";
    Input: value = "Value text";
    Processing: "Trim the text. Blank text stays empty.";
    Output: "The value text, or empty when it is absent.";
} {
    If (IsUndefined(value)) { Return ""; }
    Return Clean(value);
}

Public Function Default<T>() -> Int
Explain {
    Description: "Return the default integer value.";
    Input: "No parameters";
    Processing: "The default number is zero.";
    Output: "Zero.";
} {
