        Processing: "The numerator is 8 and the denominator is 12.";
        Output: "0 because 8 / 12 is not an integer.";
    } {
        This.Load();
        Int numerator = 8;
        Int denominator = 12;
        Int quote = numerator / denominator;
        If (quote * denominator != numerator) {
            problem = "exact";
            Return 0;
        }
        Return quote;
    }

