    Private Function Load() -> Int {
        origin[0] = 0;
        dest[0] = 1;
        weight[0] = 1;
        origin[1] = 1;
        dest[1] = 0;
        weight[1] = 1;
        origin[2] = 0;
        dest[2] = 2;
        weight[2] = 2;
        origin[3] = 2;
        dest[3] = 0;
        weight[3] = 2;
        origin[4] = 1;
        dest[4] = 3;
        weight[4] = 1;
        origin[5] = 3;
        dest[5] = 1;
        weight[5] = 1;
        origin[6] = 2;
        dest[6] = 3;
        weight[6] = 1;
        origin[7] = 3;
        dest[7] = 2;
        weight[7] = 1;
        problem = "none";
        Return 8;
    }

    Private Function DegreeOf(Int vertex) -> Int {
        Int edge = 0;
        Int count = 0;
        While (edge < 8) {
            If (origin[edge] == vertex) { count = count + 1; }
            edge = edge + 1;
        }
        Return count;
    }

    Private Function HasEdge(Int from, Int toward) -> Int {
        Int edge = 0;
        While (edge < 8) {
            If (origin[edge] == from && dest[edge] == toward) { Return 1; }
            edge = edge + 1;
        }
        Return 0;
    }

    Private Function EdgeWeight(Int from, Int toward) -> Int {
        Int edge = 0;
        While (edge < 8) {
            If (origin[edge] == from && dest[edge] == toward) { Return weight[edge]; }
            edge = edge + 1;
        }
        Return 0;
    }

    Private Function UndirectedCount() -> Int {
        Int edge = 0;
        Int count = 0;
        While (edge < 8) {
            If (origin[edge] < dest[edge]) { count = count + 1; }
            edge = edge + 1;
        }
        Return count;
    }

    Private Function Reverse(Int edge) -> Int {
        If (edge % 2 == 0) { Return edge + 1; }
        Return edge - 1;
    }

    Private Function BfsSum(Int start) -> Int {
        This.Load();
        Int i = 0;
        While (i < 4) {
            seen[i] = 0;
            i = i + 1;
        }
        seen[start] = 1;
        queue[0] = start;
        Int head = 0;
        Int tail = 1;
        Int place = 1;
        Int sum = 0;
        While (head < tail) {
            Int node = queue[head];
            head = head + 1;
            sum = sum + place * node;
            place = place + 1;
            Int edge = 0;
            While (edge < 8) {
                If (origin[edge] == node && seen[dest[edge]] == 0) {
                    seen[dest[edge]] = 1;
                    queue[tail] = dest[edge];
                    tail = tail + 1;
                }
                edge = edge + 1;
            }
        }
        problem = "none";
        Return sum;
    }

    Private Function DfsSum(Int start) -> Int {
        This.Load();
        Int i = 0;
        While (i < 4) {
            seen[i] = 0;
            i = i + 1;
        }
        queue[0] = start;
        Int top = 1;
        Int place = 1;
        Int sum = 0;
        While (top > 0) {
            top = top - 1;
            Int node = queue[top];
            If (seen[node] == 0) {
                seen[node] = 1;
                sum = sum + place * node;
                place = place + 1;
                Int edge = 7;
                While (edge >= 0) {
                    If (origin[edge] == node && seen[dest[edge]] == 0) {
                        queue[top] = dest[edge];
                        top = top + 1;
                    }
                    edge = edge - 1;
                }
            }
        }
        problem = "none";
        Return sum;
    }

    Private Function LimitedCount(Int start, Int limit) -> Int {
        This.Load();
        Int i = 0;
        While (i < 4) {
            seen[i] = 0;
            dist[i] = 0;
            i = i + 1;
        }
        seen[start] = 1;
        queue[0] = start;
        Int head = 0;
        Int tail = 1;
        Int count = 0;
        While (head < tail) {
            Int node = queue[head];
            head = head + 1;
            If (dist[node] <= limit) { count = count + 1; }
            If (dist[node] < limit) {
                Int edge = 0;
                While (edge < 8) {
                    If (origin[edge] == node && seen[dest[edge]] == 0) {
                        seen[dest[edge]] = 1;
                        dist[dest[edge]] = dist[node] + 1;
                        queue[tail] = dest[edge];
                        tail = tail + 1;
                    }
                    edge = edge + 1;
                }
            }
        }
        problem = "none";
        Return count;
    }

    Private Function RunDijkstra(Int source) -> Int {
        This.Load();
        Int i = 0;
        While (i < 4) {
            dist[i] = 99;
            seen[i] = 0;
            i = i + 1;
        }
        dist[source] = 0;
        Int step = 0;
        While (step < 4) {
            Int best = -1;
            Int bestDist = 99;
            i = 0;
            While (i < 4) {
                If (seen[i] == 0 && dist[i] < bestDist) {
                    bestDist = dist[i];
                    best = i;
                }
                i = i + 1;
            }
            If (best >= 0) {
                seen[best] = 1;
                Int edge = 0;
                While (edge < 8) {
                    If (origin[edge] == best && dist[best] + weight[edge] < dist[dest[edge]]) {
                        dist[dest[edge]] = dist[best] + weight[edge];
                    }
                    edge = edge + 1;
                }
            }
            step = step + 1;
        }
        Int sum = 0;
        i = 0;
        While (i < 4) {
            sum = sum + dist[i];
            i = i + 1;
        }
        problem = "none";
        Return sum;
    }

    Private Function Shortest(Int source, Int goal) -> Int {
        This.RunDijkstra(source);
        Return dist[goal];
    }

    Private Function SetDist(Int index, Int value) -> Int {
        If (index < 8) { near[index] = value; }
        If (index >= 8) { far[index - 8] = value; }
        Return value;
    }

    Private Function GetDist(Int index) -> Int {
        If (index < 8) { Return near[index]; }
        Return far[index - 8];
    }

    Private Function AllPairs() -> Int {
        This.Load();
        Int index = 0;
        While (index < 16) {
            This.SetDist(index, 99);
            index = index + 1;
        }
        index = 0;
        While (index < 4) {
            This.SetDist(index * 4 + index, 0);
            index = index + 1;
        }
        Int edge = 0;
        While (edge < 8) {
            Int slot = origin[edge] * 4 + dest[edge];
            If (This.GetDist(slot) > weight[edge]) { This.SetDist(slot, weight[edge]); }
            edge = edge + 1;
        }
        Int k = 0;
        While (k < 4) {
            Int i = 0;
            While (i < 4) {
                Int j = 0;
                While (j < 4) {
                    Int via = This.GetDist(i * 4 + k) + This.GetDist(k * 4 + j);
                    If (This.GetDist(i * 4 + j) > via) { This.SetDist(i * 4 + j, via); }
                    j = j + 1;
                }
                i = i + 1;
            }
            k = k + 1;
        }
        Int sum = 0;
        index = 0;
        While (index < 16) {
            sum = sum + This.GetDist(index);
            index = index + 1;
        }
        problem = "none";
        Return sum;
    }

    Private Function Root(Int vertex) -> Int {
        Int guard = 0;
        While (parent[vertex] != vertex && guard < 8) {
            parent[vertex] = parent[parent[vertex]];
            vertex = parent[vertex];
            guard = guard + 1;
        }
        Return vertex;
    }

    Private Function MstWeight(Int maximum) -> Int {
        This.Load();
        Int i = 0;
        While (i < 4) {
            parent[i] = i;
            seen[i] = 0;
            i = i + 1;
        }
        Int total = 0;
        Int chosen = 0;
        While (chosen < 4) {
            Int bestEdge = -1;
            Int best = 99;
            If (maximum == 1) { best = -1; }
            Int edge = 0;
            While (edge < 8) {
                If (origin[edge] < dest[edge] && seen[edge] == 0) {
                    Int take = 0;
                    If (maximum == 0 && weight[edge] < best) { take = 1; }
                    If (maximum == 1 && weight[edge] > best) { take = 1; }
                    If (take == 1) {
                        best = weight[edge];
                        bestEdge = edge;
                    }
                }
                edge = edge + 1;
            }
            If (bestEdge < 0) { chosen = 4; }
            If (bestEdge >= 0) {
                seen[bestEdge] = 1;
                Int left = This.Root(origin[bestEdge]);
                Int right = This.Root(dest[bestEdge]);
                If (left != right) {
                    parent[right] = left;
                    total = total + weight[bestEdge];
                }
                chosen = chosen + 1;
            }
        }
        problem = "none";
        Return total;
    }

    Private Function BoruvkaWeight() -> Int {
        This.Load();
        Int i = 0;
        While (i < 4) {
            parent[i] = i;
            i = i + 1;
        }
        Int total = 0;
        Int guard = 0;
        Int merged = 1;
        While (merged == 1 && guard < 4) {
            guard = guard + 1;
            merged = 0;
            i = 0;
            While (i < 4) {
                queue[i] = -1;
                i = i + 1;
            }
            Int edge = 0;
            While (edge < 8) {
                If (origin[edge] < dest[edge]) {
                    Int left = This.Root(origin[edge]);
                    Int right = This.Root(dest[edge]);
                    If (left != right) {
                        Int better = 0;
                        If (queue[left] < 0) { better = 1; }
                        If (better == 0 && weight[edge] < weight[queue[left]]) { better = 1; }
                        If (better == 0 && weight[edge] == weight[queue[left]] && edge < queue[left]) { better = 1; }
                        If (better == 1) { queue[left] = edge; }
                        better = 0;
                        If (queue[right] < 0) { better = 1; }
                        If (better == 0 && weight[edge] < weight[queue[right]]) { better = 1; }
                        If (better == 0 && weight[edge] == weight[queue[right]] && edge < queue[right]) { better = 1; }
                        If (better == 1) { queue[right] = edge; }
                    }
                }
                edge = edge + 1;
            }
            i = 0;
            While (i < 4) {
                Int chosen = queue[i];
                If (chosen >= 0) {
                    Int left = This.Root(origin[chosen]);
                    Int right = This.Root(dest[chosen]);
                    If (left != right) {
                        parent[right] = left;
                        total = total + weight[chosen];
                        merged = 1;
                    }
                }
                i = i + 1;
            }
        }
        problem = "none";
        Return total;
    }

    Private Function Reach(Int start) -> Int {
        This.Load();
        Int i = 0;
        While (i < 4) {
            seen[i] = 0;
            i = i + 1;
        }
        seen[start] = 1;
        queue[0] = start;
        Int head = 0;
        Int tail = 1;
        Int count = 0;
        While (head < tail) {
            Int node = queue[head];
            head = head + 1;
            count = count + 1;
            Int edge = 0;
            While (edge < 8) {
                If (origin[edge] == node && seen[dest[edge]] == 0) {
                    seen[dest[edge]] = 1;
                    queue[tail] = dest[edge];
                    tail = tail + 1;
                }
                edge = edge + 1;
            }
        }
        problem = "none";
        Return count;
    }

    Private Function InitResidual() -> Int {
        This.Load();
        Int edge = 0;
        While (edge < 8) {
            residual[edge] = 0;
            If (origin[edge] < dest[edge]) { residual[edge] = weight[edge]; }
            edge = edge + 1;
        }
        Return residual[0];
    }

    Private Function SendFlow(Int sink) -> Int {
        Int bottle = 99;
        Int walk = sink;
        Int guard = 0;
        While (walk != parent[7] && guard < 8) {
            Int edge = parent[walk];
            If (edge < 0) { Return 0; }
            If (residual[edge] < bottle) { bottle = residual[edge]; }
            walk = origin[edge];
            guard = guard + 1;
        }
        If (bottle == 99 || bottle == 0) { Return 0; }
        walk = sink;
        guard = 0;
        While (walk != parent[7] && guard < 8) {
            Int edge = parent[walk];
            Int rev = This.Reverse(edge);
            residual[edge] = residual[edge] - bottle;
            residual[rev] = residual[rev] + bottle;
            walk = origin[edge];
            guard = guard + 1;
        }
        Return bottle;
    }

    Private Function DfsFlow(Int source, Int sink) -> Int {
        This.InitResidual();
        parent[7] = source;
        Int total = 0;
        Int guard = 0;
        While (guard < 8) {
            Int i = 0;
            While (i < 4) {
                seen[i] = 0;
                parent[i] = -1;
                dist[i] = 0;
                i = i + 1;
            }
            seen[source] = 1;
            queue[0] = source;
            Int top = 1;
            Int found = 0;
            While (top > 0 && found == 0) {
                Int node = queue[top - 1];
                If (node == sink) { found = 1; }
                If (found == 0) {
                    Int advanced = 0;
                    While (dist[node] < 8 && advanced == 0) {
                        Int edge = dist[node];
                        dist[node] = dist[node] + 1;
                        If (origin[edge] == node && residual[edge] > 0 && seen[dest[edge]] == 0) {
                            seen[dest[edge]] = 1;
                            parent[dest[edge]] = edge;
                            queue[top] = dest[edge];
                            top = top + 1;
                            advanced = 1;
                        }
                    }
                    If (advanced == 0) { top = top - 1; }
                }
            }
            If (found == 0) { guard = 8; }
            If (found == 1) { total = total + This.SendFlow(sink); }
            guard = guard + 1;
        }
        problem = "none";
        Return total;
    }

    Private Function BfsFlow(Int source, Int sink) -> Int {
        This.InitResidual();
        parent[7] = source;
        Int total = 0;
        Int guard = 0;
        While (guard < 8) {
            Int i = 0;
            While (i < 4) {
                seen[i] = 0;
                parent[i] = -1;
                i = i + 1;
            }
            seen[source] = 1;
            queue[0] = source;
            Int head = 0;
            Int tail = 1;
            While (head < tail) {
                Int node = queue[head];
                head = head + 1;
                Int edge = 0;
                While (edge < 8) {
                    If (origin[edge] == node && residual[edge] > 0 && seen[dest[edge]] == 0) {
                        seen[dest[edge]] = 1;
                        parent[dest[edge]] = edge;
                        queue[tail] = dest[edge];
                        tail = tail + 1;
                    }
                    edge = edge + 1;
                }
            }
            If (seen[sink] == 0) { guard = 8; }
            If (seen[sink] == 1) { total = total + This.SendFlow(sink); }
            guard = guard + 1;
        }
        problem = "none";
        Return total;
    }

    Private Function DinicFlow(Int source, Int sink) -> Int {
        This.InitResidual();
        parent[7] = source;
        Int total = 0;
        Int guard = 0;
        While (guard < 8) {
            Int i = 0;
            While (i < 4) {
                dist[i] = -1;
                i = i + 1;
            }
            dist[source] = 0;
            queue[0] = source;
            Int head = 0;
            Int tail = 1;
            While (head < tail) {
                Int node = queue[head];
                head = head + 1;
                Int edge = 0;
                While (edge < 8) {
                    If (origin[edge] == node && residual[edge] > 0 && dist[dest[edge]] < 0) {
                        dist[dest[edge]] = dist[node] + 1;
                        queue[tail] = dest[edge];
                        tail = tail + 1;
                    }
                    edge = edge + 1;
                }
            }
            If (dist[sink] < 0) { guard = 8; }
            If (dist[sink] >= 0) {
                i = 0;
                While (i < 4) {
                    seen[i] = 0;
                    i = i + 1;
                }
                Int blocking = 1;
                Int inner = 0;
                While (blocking == 1 && inner < 8) {
                    inner = inner + 1;
                    i = 0;
                    While (i < 4) {
                        parent[i] = -1;
                        queue[i] = 0;
                        i = i + 1;
                    }
                    seen[source] = 1;
                    near[0] = source;
                    Int top = 1;
                    Int found = 0;
                    While (top > 0 && found == 0) {
                        Int node = near[top - 1];
                        If (node == sink) { found = 1; }
                        If (found == 0) {
                            Int advanced = 0;
                            While (queue[node] < 8 && advanced == 0) {
                                Int edge = queue[node];
                                queue[node] = queue[node] + 1;
                                Int next = dest[edge];
                                If (origin[edge] == node && residual[edge] > 0 && dist[next] == dist[node] + 1 && seen[next] == 0) {
                                    seen[next] = 1;
                                    parent[next] = edge;
                                    near[top] = next;
                                    top = top + 1;
                                    advanced = 1;
                                }
                            }
                            If (advanced == 0) {
                                seen[node] = 0;
                                top = top - 1;
                            }
                        }
                    }
                    If (found == 0) { blocking = 0; }
                    If (found == 1) { total = total + This.SendFlow(sink); }
                }
            }
            guard = guard + 1;
        }
        problem = "none";
        Return total;
    }

    Private Function PushFlow(Int source, Int sink) -> Int {
        This.InitResidual();
        Int i = 0;
        While (i < 4) {
            dist[i] = 0;
            seen[i] = 0;
            i = i + 1;
        }
        dist[source] = 4;
        Int edge = 0;
        While (edge < 8) {
            If (origin[edge] == source && residual[edge] > 0) {
                Int amount = residual[edge];
                residual[edge] = 0;
                residual[This.Reverse(edge)] = residual[This.Reverse(edge)] + amount;
                seen[dest[edge]] = seen[dest[edge]] + amount;
            }
            edge = edge + 1;
        }
        Int guard = 0;
        Int active = 1;
        While (active == 1 && guard < 32) {
            guard = guard + 1;
            active = 0;
            i = 0;
            While (i < 4) {
                If (i != source && i != sink && seen[i] > 0) {
                    active = 1;
                    Int moved = 1;
                    Int spins = 0;
                    While (seen[i] > 0 && moved == 1 && spins < 8) {
                        spins = spins + 1;
                        moved = 0;
                        edge = 0;
                        While (edge < 8 && moved == 0) {
                            If (origin[edge] == i && residual[edge] > 0 && dist[i] == dist[dest[edge]] + 1) {
                                Int amount = seen[i];
                                If (residual[edge] < amount) { amount = residual[edge]; }
                                residual[edge] = residual[edge] - amount;
                                residual[This.Reverse(edge)] = residual[This.Reverse(edge)] + amount;
                                seen[i] = seen[i] - amount;
                                seen[dest[edge]] = seen[dest[edge]] + amount;
                                moved = 1;
                            }
                            edge = edge + 1;
                        }
                        If (moved == 0) {
                            Int low = 99;
                            edge = 0;
                            While (edge < 8) {
                                If (origin[edge] == i && residual[edge] > 0 && dist[dest[edge]] < low) {
                                    low = dist[dest[edge]];
                                }
                                edge = edge + 1;
                            }
                            If (low == 99) { spins = 8; }
                            If (low < 99) { dist[i] = low + 1; }
                            moved = 1;
                        }
                    }
                }
                i = i + 1;
            }
        }
        problem = "none";
        Return seen[sink];
    }

    Private Function MinCost(Int source, Int sink) -> Int {
        This.InitResidual();
        parent[7] = source;
        Int total = 0;
        Int guard = 0;
        While (guard < 4) {
            Int i = 0;
            While (i < 4) {
                dist[i] = 99;
                parent[i] = -1;
                i = i + 1;
            }
            dist[source] = 0;
            Int pass = 0;
            While (pass < 4) {
                Int edge = 0;
                While (edge < 8) {
                    If (residual[edge] > 0 && dist[origin[edge]] < 99) {
                        Int cost = weight[edge];
                        If (origin[edge] > dest[edge]) { cost = 0 - weight[edge]; }
                        If (dist[origin[edge]] + cost < dist[dest[edge]]) {
                            dist[dest[edge]] = dist[origin[edge]] + cost;
                            parent[dest[edge]] = edge;
                        }
                    }
                    edge = edge + 1;
                }
                pass = pass + 1;
            }
            If (dist[sink] >= 99) { guard = 4; }
            If (dist[sink] < 99) {
                Int bottle = This.SendFlow(sink);
                total = total + dist[sink] * bottle;
            }
            guard = guard + 1;
        }
        problem = "none";
        Return total;
    }

    Private Function MatchSize() -> Int {
        This.Load();
        parent[1] = -1;
        parent[2] = -1;
        Int left = 0;
        Int matched = 0;
        While (left < 2) {
            Int who = 0;
            If (left == 1) { who = 3; }
            Int i = 0;
            While (i < 4) {
                seen[i] = 0;
                i = i + 1;
            }
            Int edge = 0;
            Int found = 0;
            While (edge < 8 && found == 0) {
                If (origin[edge] == who) {
                    Int accept = dest[edge];
                    If (seen[accept] == 0 && (accept == 1 || accept == 2)) {
                        seen[accept] = 1;
                        Int held = parent[accept];
                        Int free = 0;
                        If (held < 0) { free = 1; }
                        If (free == 0) {
                            Int other = 0;
                            While (other < 8 && free == 0) {
                                If (origin[other] == held && dest[other] != accept && (dest[other] == 1 || dest[other] == 2) && parent[dest[other]] < 0) {
                                    parent[dest[other]] = held;
                                    free = 1;
                                }
                                other = other + 1;
                            }
                        }
                        If (free == 1) {
                            parent[accept] = who;
                            found = 1;
                            matched = matched + 1;
                        }
                    }
                }
                edge = edge + 1;
            }
            left = left + 1;
        }
        problem = "none";
        Return matched;
    }

    Private Function AssignCost() -> Int {
        This.Load();
        Int first = This.EdgeWeight(0, 1) + This.EdgeWeight(3, 2);
        Int second = This.EdgeWeight(0, 2) + This.EdgeWeight(3, 1);
        problem = "none";
        If (first < second) { Return first; }
        Return second;
    }

    Private Function TwoColor() -> Int {
        This.Load();
        Int i = 0;
        While (i < 4) {
            dist[i] = -1;
            seen[i] = 0;
            i = i + 1;
        }
        dist[0] = 0;
        seen[0] = 1;
        queue[0] = 0;
        Int head = 0;
        Int tail = 1;
        While (head < tail) {
            Int node = queue[head];
            head = head + 1;
            Int edge = 0;
            While (edge < 8) {
                If (origin[edge] == node) {
                    Int next = dest[edge];
                    If (dist[next] < 0) {
                        dist[next] = 1 - dist[node];
                        seen[next] = 1;
                        queue[tail] = next;
                        tail = tail + 1;
                    }
                    If (dist[next] == dist[node]) {
                        problem = "domain";
                        Return 0;
                    }
                }
                edge = edge + 1;
            }
        }
        problem = "none";
        Return 1;
    }

    Private Function EulerWalk() -> Int {
        This.Load();
        Int edge = 0;
        While (edge < 8) {
            seen[edge] = 0;
            edge = edge + 1;
        }
        Int current = 0;
        Int walked = 0;
        Int guard = 0;
        Int moving = 1;
        While (moving == 1 && guard < 8) {
            guard = guard + 1;
            edge = 0;
            Int found = 0;
            While (edge < 8 && found == 0) {
                If (origin[edge] == current && seen[edge] == 0) {
                    seen[edge] = 1;
                    seen[This.Reverse(edge)] = 1;
                    current = dest[edge];
                    walked = walked + 1;
                    found = 1;
                }
                edge = edge + 1;
            }
            If (found == 0) { moving = 0; }
        }
        problem = "none";
        Return walked;
    }

    Private Function HamiltonWalk(Int closed) -> Int {
        This.Load();
        Int a = 0;
        While (a < 4) {
            Int b = 0;
            While (b < 4) {
                Int c = 0;
                While (c < 4) {
                    Int d = 0;
                    While (d < 4) {
                        Int distinct = 0;
                        If (a != b && a != c && a != d && b != c && b != d && c != d) { distinct = 1; }
                        If (distinct == 1 && This.HasEdge(a, b) == 1 && This.HasEdge(b, c) == 1 && This.HasEdge(c, d) == 1) {
                            Int linked = 1;
                            If (closed == 1 && This.HasEdge(d, a) == 0) { linked = 0; }
                            If (linked == 1) {
                                problem = "none";
                                Return 4;
                            }
                        }
                        d = d + 1;
                    }
                    c = c + 1;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        problem = "domain";
        Return 0;
    }

    Private Function BridgeCount() -> Int {
        This.Load();
        Int banned = 0;
        Int bridges = 0;
        While (banned < 8) {
            If (origin[banned] < dest[banned]) {
                Int i = 0;
                While (i < 4) {
                    seen[i] = 0;
                    i = i + 1;
                }
                seen[0] = 1;
                queue[0] = 0;
                Int head = 0;
                Int tail = 1;
                Int count = 0;
                While (head < tail) {
                    Int node = queue[head];
                    head = head + 1;
                    count = count + 1;
                    Int edge = 0;
                    While (edge < 8) {
                        Int skip = 0;
                        If (edge == banned) { skip = 1; }
                        If (edge == This.Reverse(banned)) { skip = 1; }
                        If (skip == 0 && origin[edge] == node && seen[dest[edge]] == 0) {
                            seen[dest[edge]] = 1;
                            queue[tail] = dest[edge];
                            tail = tail + 1;
                        }
                        edge = edge + 1;
                    }
                }
                If (count < 4) { bridges = bridges + 1; }
            }
            banned = banned + 1;
        }
        problem = "none";
        Return bridges;
    }

    Private Function CutCount() -> Int {
        Int removed = 0;
        Int cuts = 0;
        While (removed < 4) {
            This.Load();
            Int start = 0;
            If (removed == 0) { start = 1; }
            Int i = 0;
            While (i < 4) {
                seen[i] = 0;
                i = i + 1;
            }
            seen[removed] = 1;
            seen[start] = 1;
            queue[0] = start;
            Int head = 0;
            Int tail = 1;
            Int count = 0;
            While (head < tail) {
                Int node = queue[head];
                head = head + 1;
                count = count + 1;
                Int edge = 0;
                While (edge < 8) {
                    If (origin[edge] == node && seen[dest[edge]] == 0) {
                        seen[dest[edge]] = 1;
                        queue[tail] = dest[edge];
                        tail = tail + 1;
                    }
                    edge = edge + 1;
                }
            }
            If (count < 3) { cuts = cuts + 1; }
            removed = removed + 1;
        }
        problem = "none";
        Return cuts;
    }

    Private Function Eccentricity(Int vertex) -> Int {
        This.Load();
        Int i = 0;
        While (i < 4) {
            seen[i] = 0;
            dist[i] = 0;
            i = i + 1;
        }
        seen[vertex] = 1;
        queue[0] = vertex;
        Int head = 0;
        Int tail = 1;
        Int farHop = 0;
        While (head < tail) {
            Int node = queue[head];
            head = head + 1;
            If (dist[node] > farHop) { farHop = dist[node]; }
            Int edge = 0;
            While (edge < 8) {
                If (origin[edge] == node && seen[dest[edge]] == 0) {
                    seen[dest[edge]] = 1;
                    dist[dest[edge]] = dist[node] + 1;
                    queue[tail] = dest[edge];
                    tail = tail + 1;
                }
                edge = edge + 1;
            }
        }
        problem = "none";
        Return farHop;
    }

    Private Function Girth() -> Int {
        Int best = 99;
        Int start = 0;
        While (start < 4) {
            This.Load();
            Int i = 0;
            While (i < 4) {
                seen[i] = 0;
                dist[i] = 0;
                parent[i] = -1;
                i = i + 1;
            }
            seen[start] = 1;
            queue[0] = start;
            Int head = 0;
            Int tail = 1;
            While (head < tail) {
                Int node = queue[head];
                head = head + 1;
                Int edge = 0;
                While (edge < 8) {
                    If (origin[edge] == node) {
                        Int next = dest[edge];
                        Int known = seen[next];
                        If (known == 0) {
                            seen[next] = 1;
                            dist[next] = dist[node] + 1;
                            parent[next] = node;
                            queue[tail] = next;
                            tail = tail + 1;
                        }
                        If (known == 1 && parent[node] != next) {
                            Int length = dist[node] + dist[next] + 1;
                            If (length < best) { best = length; }
                        }
                    }
                    edge = edge + 1;
                }
            }
            start = start + 1;
        }
        problem = "none";
        Return best;
    }

    Private Function Betweenness() -> Int {
        Int total = 0;
        Int source = 0;
        While (source < 4) {
            Int goal = source + 1;
            While (goal < 4) {
                Int distance = This.Shortest(source, goal);
                Int internals = 0;
                Int vertex = 0;
                While (vertex < 4) {
                    If (vertex != source && vertex != goal) {
                        Int left = This.Shortest(source, vertex);
                        Int right = This.Shortest(vertex, goal);
                        If (left + right == distance) { internals = internals + 1; }
                    }
                    vertex = vertex + 1;
                }
                If (internals == 1) { total = total + 1; }
                goal = goal + 1;
            }
            source = source + 1;
        }
        problem = "none";
        Return total;
    }

    Private Function RankOf(Int vertex) -> Int {
        This.Load();
        Int i = 0;
        While (i < 4) {
            queue[i] = 2;
            i = i + 1;
        }
        i = 0;
        While (i < 4) {
            Int incoming = 0;
            Int edge = 0;
            While (edge < 8) {
                If (dest[edge] == i) {
                    incoming = incoming + queue[origin[edge]] / This.DegreeOf(origin[edge]);
                }
                edge = edge + 1;
            }
            parent[i] = incoming;
            i = i + 1;
        }
        problem = "none";
        Return parent[vertex];
    }

    Private Function LabelCount() -> Int {
        This.Load();
        Int i = 0;
        While (i < 4) {
            queue[i] = i;
            i = i + 1;
        }
        i = 0;
        While (i < 4) {
            Int best = 99;
            Int edge = 0;
            While (edge < 8) {
                If (origin[edge] == i && queue[dest[edge]] < best) { best = queue[dest[edge]]; }
                edge = edge + 1;
            }
            parent[i] = best;
            i = i + 1;
        }
        i = 0;
        Int distinct = 0;
        While (i < 4) {
            Int earlier = 0;
            Int j = 0;
            While (j < i) {
                If (parent[j] == parent[i]) { earlier = 1; }
                j = j + 1;
            }
            If (earlier == 0) { distinct = distinct + 1; }
            i = i + 1;
        }
        problem = "none";
        Return distinct;
    }
}
