    Public Function StableMatching() -> Int
    Explain {
        Description: "Stable matching of proposers 0 and 3.";
        Input: "None.";
        Processing: "Prefer the lighter edge, then the smaller vertex id.";
        Output: "2.";
    } {
        This.Load();
        parent[1] = -1;
        parent[2] = -1;
        queue[0] = 1;
        queue[1] = 2;
        queue[2] = 1;
        queue[3] = 2;
        dist[0] = 0;
        dist[1] = 0;
        Int proposer = 0;
        While (proposer < 2) {
            Int who = 0;
            If (proposer == 1) { who = 3; }
            Int choice = 0;
            While (choice < 2 && dist[proposer] < 2) {
                Int accept = queue[proposer * 2 + dist[proposer]];
                dist[proposer] = dist[proposer] + 1;
                Int held = parent[accept];
                Int take = 0;
                If (held < 0) { take = 1; }
                If (held == 0 && who == 0) { take = 1; }
                If (held == 3 && who == 3) { take = 1; }
                If (accept == 2 && who == 3 && held == 0) { take = 1; }
                If (accept == 1 && who == 0 && held == 3) { take = 1; }
                If (take == 1) {
                    parent[accept] = who;
                    choice = 2;
                }
                choice = choice + 1;
            }
            proposer = proposer + 1;
        }
        Int matched = 0;
        If (parent[1] >= 0) { matched = matched + 1; }
        If (parent[2] >= 0) { matched = matched + 1; }
        problem = "none";
        Return matched;
    }

