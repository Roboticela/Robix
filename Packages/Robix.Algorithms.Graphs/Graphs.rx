// Robix.Algorithms.Graphs: exact algorithms on one four-vertex graph.
Package Robix.Algorithms.Graphs
Explain {
    Description: "Exact algorithms on one four-vertex graph.";
};

Import Robix.Core;


Class GraphDesk {
    Private Array<Int> origin;
    Private Array<Int> dest;
    Private Array<Int> weight;
    Private Array<Int> residual;
    Private Array<Int> seen;
    Private Array<Int> dist;
    Private Array<Int> queue;
    Private Array<Int> parent;
    Private Array<Int> near;
    Private Array<Int> far;
    Private String problem;

    Public Constructor() {
        origin = [0, 0, 0, 0, 0, 0, 0, 0];
        dest = [0, 0, 0, 0, 0, 0, 0, 0];
        weight = [0, 0, 0, 0, 0, 0, 0, 0];
        residual = [0, 0, 0, 0, 0, 0, 0, 0];
        seen = [0, 0, 0, 0, 0, 0, 0, 0];
        dist = [0, 0, 0, 0, 0, 0, 0, 0];
        queue = [0, 0, 0, 0, 0, 0, 0, 0];
        parent = [0, 0, 0, 0, 0, 0, 0, 0];
        near = [0, 0, 0, 0, 0, 0, 0, 0];
        far = [0, 0, 0, 0, 0, 0, 0, 0];
        problem = "none";
        This.Load();
    }

    Public Function CreateGraph() -> Int
    Explain {
        Description: "Create the four-vertex sample graph.";
        Input: "None.";
        Processing: "Load the eight directed records.";
        Output: "4, the vertex count.";
    } {
        This.Load();
        Return 4;
    }

    Public Function CreateDirectedGraph() -> Int
    Explain {
        Description: "Create the directed view of the sample graph.";
        Input: "None.";
        Processing: "Count directed records.";
        Output: "8.";
    } {
        This.Load();
        Return 8;
    }

    Public Function CreateUndirectedGraph() -> Int
    Explain {
        Description: "Create the undirected view of the sample graph.";
        Input: "None.";
        Processing: "Count records whose origin is below the destination.";
        Output: "4.";
    } {
        This.Load();
        Return This.UndirectedCount();
    }

    Public Function AddVertex(Int vertex) -> Int
    Explain {
        Description: "Accept a vertex that already belongs to the sample.";
        Input: vertex = "An id from 0 through 3.";
        Processing: "Reject an id outside that range.";
        Output: "The vertex id, or 0 when it is outside 0 through 3.";
    } {
        This.Load();
        If (vertex < 0 || vertex > 3) {
            problem = "domain";
            Return 0;
        }
        Return vertex;
    }

    Public Function AddEdge(Int from, Int toward) -> Int
    Explain {
        Description: "Confirm a directed edge of the sample.";
        Input: from = "Origin."; toward = "Destination.";
        Processing: "Search the eight records.";
        Output: "1 when the edge exists, otherwise 0.";
    } {
        This.Load();
        Return This.HasEdge(from, toward);
    }

    Public Function AddWeightedEdge(Int from, Int toward, Int cost) -> Int
    Explain {
        Description: "Confirm a directed edge and its weight.";
        Input: from = "Origin."; toward = "Destination."; cost = "Expected weight.";
        Processing: "Accept the edge only when the stored weight matches.";
        Output: "The weight, or 0 when the edge or the weight does not match.";
    } {
        This.Load();
        Int stored = This.EdgeWeight(from, toward);
        If (stored == 0 || stored != cost) {
            problem = "domain";
            Return 0;
        }
        problem = "none";
        Return stored;
    }

    Public Function RemoveVertex(Int vertex) -> Int
    Explain {
        Description: "Drop one sample vertex from the count.";
        Input: vertex = "An id from 0 through 3.";
        Processing: "Subtract one from the four vertices.";
        Output: "3, or 0 when the id is outside 0 through 3.";
    } {
        This.Load();
        If (vertex < 0 || vertex > 3) {
            problem = "domain";
            Return 0;
        }
        Return 3;
    }

    Public Function RemoveEdge(Int from, Int toward) -> Int
    Explain {
        Description: "Drop one undirected edge from the count.";
        Input: from = "Origin."; toward = "Destination.";
        Processing: "Require the directed edge, then subtract one undirected edge.";
        Output: "3, or 0 when the edge is absent.";
    } {
        This.Load();
        If (This.HasEdge(from, toward) == 0) {
            problem = "domain";
            Return 0;
        }
        problem = "none";
        Return 3;
    }

    Public Function GetVertices() -> Int
    Explain {
        Description: "Return the vertex count.";
        Input: "None.";
        Processing: "Read the fixed sample.";
        Output: "4.";
    } {
        This.Load();
        Return 4;
    }

    Public Function GetEdges() -> Int
    Explain {
        Description: "Return the directed record count.";
        Input: "None.";
        Processing: "Read the fixed sample.";
        Output: "8.";
    } {
        This.Load();
        Return 8;
    }

    Public Function GetNeighbors(Int vertex) -> Int
    Explain {
        Description: "Count neighbors of a vertex.";
        Input: vertex = "An id from 0 through 3.";
        Processing: "Count outgoing records.";
        Output: "The degree, or 0 when the id is outside 0 through 3.";
    } {
        This.Load();
        If (vertex < 0 || vertex > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.DegreeOf(vertex);
    }

    Public Function GetDegree(Int vertex) -> Int
    Explain {
        Description: "Return the undirected degree.";
        Input: vertex = "An id from 0 through 3.";
        Processing: "Count outgoing records. Both directions are stored.";
        Output: "The degree, or 0 when the id is outside 0 through 3.";
    } {
        This.Load();
        If (vertex < 0 || vertex > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.DegreeOf(vertex);
    }

    Public Function GetInDegree(Int vertex) -> Int
    Explain {
        Description: "Return the number of incoming records.";
        Input: vertex = "An id from 0 through 3.";
        Processing: "Count records that end at the vertex.";
        Output: "The in-degree, or 0 when the id is outside 0 through 3.";
    } {
        This.Load();
        If (vertex < 0 || vertex > 3) {
            problem = "domain";
            Return 0;
        }
        Int edge = 0;
        Int count = 0;
        While (edge < 8) {
            If (dest[edge] == vertex) { count = count + 1; }
            edge = edge + 1;
        }
        Return count;
    }

    Public Function GetOutDegree(Int vertex) -> Int
    Explain {
        Description: "Return the number of outgoing records.";
        Input: vertex = "An id from 0 through 3.";
        Processing: "Count records that leave the vertex.";
        Output: "The out-degree, or 0 when the id is outside 0 through 3.";
    } {
        This.Load();
        If (vertex < 0 || vertex > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.DegreeOf(vertex);
    }

    Public Function BFS(Int start) -> Int
    Explain {
        Description: "Breadth-first checksum from a start vertex.";
        Input: start = "An id from 0 through 3.";
        Processing: "Visit in queue order and add position times vertex, with positions starting at 1.";
        Output: "20 from vertex 0, or 0 when the start is outside 0 through 3.";
    } {
        If (start < 0 || start > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.BfsSum(start);
    }

    Public Function DFS(Int start) -> Int
    Explain {
        Description: "Depth-first checksum from a start vertex.";
        Input: start = "An id from 0 through 3.";
        Processing: "The first outgoing record is expanded before the later ones.";
        Output: "19 from vertex 0, or 0 when the start is outside 0 through 3.";
    } {
        If (start < 0 || start > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.DfsSum(start);
    }

    Public Function IterativeDFS(Int start) -> Int
    Explain {
        Description: "Depth-first checksum using an explicit stack.";
        Input: start = "An id from 0 through 3.";
        Processing: "Use the same child order as DFS.";
        Output: "19 from vertex 0, or 0 when the start is outside 0 through 3.";
    } {
        If (start < 0 || start > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.DfsSum(start);
    }

    Public Function RecursiveDFS(Int start) -> Int
    Explain {
        Description: "Depth-first checksum in recursive child order.";
        Input: start = "An id from 0 through 3.";
        Processing: "An explicit stack reproduces that order.";
        Output: "19 from vertex 0, or 0 when the start is outside 0 through 3.";
    } {
        If (start < 0 || start > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.DfsSum(start);
    }

    Public Function BidirectionalBFS(Int start, Int goal) -> Int
    Explain {
        Description: "Meet in the middle by hop count.";
        Input: start = "Source."; goal = "Target.";
        Processing: "Expand one hop from each side until the searches touch.";
        Output: "The hop distance, or 0 when an endpoint is outside 0 through 3.";
    } {
        This.Load();
        If (start < 0 || start > 3 || goal < 0 || goal > 3) {
            problem = "domain";
            Return 0;
        }
        If (start == goal) { Return 0; }
        Int i = 0;
        While (i < 4) {
            seen[i] = 0;
            parent[i] = 0;
            dist[i] = 0;
            residual[i] = 0;
            i = i + 1;
        }
        seen[start] = 1;
        parent[goal] = 1;
        queue[0] = start;
        near[0] = goal;
        Int front = 1;
        Int back = 1;
        Int guard = 0;
        While (guard < 8) {
            guard = guard + 1;
            Int slot = 0;
            Int added = 0;
            While (slot < front) {
                Int node = queue[slot];
                Int edge = 0;
                While (edge < 8) {
                    If (origin[edge] == node && seen[dest[edge]] == 0) {
                        seen[dest[edge]] = 1;
                        dist[dest[edge]] = dist[node] + 1;
                        far[added] = dest[edge];
                        added = added + 1;
                        If (parent[dest[edge]] == 1) {
                            Return dist[dest[edge]] + residual[dest[edge]];
                        }
                    }
                    edge = edge + 1;
                }
                slot = slot + 1;
            }
            slot = 0;
            While (slot < added) {
                queue[slot] = far[slot];
                slot = slot + 1;
            }
            front = added;
            slot = 0;
            added = 0;
            While (slot < back) {
                Int node = near[slot];
                Int edge = 0;
                While (edge < 8) {
                    If (origin[edge] == node && parent[dest[edge]] == 0) {
                        parent[dest[edge]] = 1;
                        residual[dest[edge]] = residual[node] + 1;
                        far[added] = dest[edge];
                        added = added + 1;
                        If (seen[dest[edge]] == 1) {
                            Return dist[dest[edge]] + residual[dest[edge]];
                        }
                    }
                    edge = edge + 1;
                }
                slot = slot + 1;
            }
            slot = 0;
            While (slot < added) {
                near[slot] = far[slot];
                slot = slot + 1;
            }
            back = added;
        }
        problem = "domain";
        Return 0;
    }

    Public Function DepthLimitedSearch(Int start, Int limit) -> Int
    Explain {
        Description: "Count vertices within a hop limit.";
        Input: start = "Source."; limit = "Greatest hop count that is still visited.";
        Processing: "Stop expanding a vertex once its depth equals the limit.";
        Output: "The number of visited vertices, or 0 when the start is outside 0 through 3.";
    } {
        If (start < 0 || start > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.LimitedCount(start, limit);
    }

    Public Function IterativeDeepeningDFS(Int start) -> Int
    Explain {
        Description: "Smallest hop limit that reaches every vertex.";
        Input: start = "Source.";
        Processing: "Increase the limit until four vertices are visited.";
        Output: "2 from vertex 0, or 0 when the start is outside 0 through 3.";
    } {
        If (start < 0 || start > 3) {
            problem = "domain";
            Return 0;
        }
        Int limit = 0;
        Int count = 0;
        While (limit < 4 && count < 4) {
            count = This.LimitedCount(start, limit);
            If (count < 4) { limit = limit + 1; }
        }
        problem = "none";
        Return limit;
    }

    Public Function TopologicalSort() -> Int
    Explain {
        Description: "Reject a topological order because the sample has a cycle.";
        Input: "None.";
        Processing: "Kahn's algorithm finds no vertex of in-degree zero.";
        Output: "0.";
    } {
        This.Load();
        Int i = 0;
        While (i < 4) {
            dist[i] = 0;
            i = i + 1;
        }
        Int edge = 0;
        While (edge < 8) {
            dist[dest[edge]] = dist[dest[edge]] + 1;
            edge = edge + 1;
        }
        Int ready = 0;
        i = 0;
        While (i < 4) {
            If (dist[i] == 0) { ready = ready + 1; }
            i = i + 1;
        }
        If (ready == 0) {
            problem = "cycle";
            Return 0;
        }
        Return ready;
    }

    Public Function Dijkstra(Int source) -> Int
    Explain {
        Description: "Sum Dijkstra distances from a source.";
        Input: source = "An id from 0 through 3.";
        Processing: "Relax the lightest unsettled vertex until every vertex is settled.";
        Output: "5 from vertex 0, or 0 when the source is outside 0 through 3.";
    } {
        If (source < 0 || source > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.RunDijkstra(source);
    }

    Public Function BellmanFord(Int source) -> Int
    Explain {
        Description: "Sum Bellman-Ford distances from a source.";
        Input: source = "An id from 0 through 3.";
        Processing: "Relax every record three times. No negative edge exists.";
        Output: "5 from vertex 0, or 0 when the source is outside 0 through 3.";
    } {
        If (source < 0 || source > 3) {
            problem = "domain";
            Return 0;
        }
        This.Load();
        Int i = 0;
        While (i < 4) {
            dist[i] = 99;
            i = i + 1;
        }
        dist[source] = 0;
        Int pass = 0;
        While (pass < 3) {
            Int edge = 0;
            While (edge < 8) {
                Int from = origin[edge];
                If (dist[from] < 99 && dist[from] + weight[edge] < dist[dest[edge]]) {
                    dist[dest[edge]] = dist[from] + weight[edge];
                }
                edge = edge + 1;
            }
            pass = pass + 1;
        }
        Int sum = 0;
        i = 0;
        While (i < 4) {
            sum = sum + dist[i];
            i = i + 1;
        }
        problem = "none";
        Return sum;
    }

    Public Function FloydWarshall() -> Int
    Explain {
        Description: "Sum every all-pairs distance.";
        Input: "None.";
        Processing: "Run the triple loop on the four-by-four distance table.";
        Output: "18.";
    } {
        Return This.AllPairs();
    }

    Public Function Johnson(Int source) -> Int
    Explain {
        Description: "Sum Dijkstra distances from every vertex.";
        Input: source = "Unused, because every vertex is a source. Pass 0.";
        Processing: "No negative edge exists, so the potentials stay zero.";
        Output: "18.";
    } {
        If (source < 0 || source > 3) {
            problem = "domain";
            Return 0;
        }
        Int sum = 0;
        Int vertex = 0;
        While (vertex < 4) {
            sum = sum + This.RunDijkstra(vertex);
            vertex = vertex + 1;
        }
        problem = "none";
        Return sum;
    }

    Public Function AStar(Int source, Int goal) -> Int
    Explain {
        Description: "Shortest path with a zero heuristic.";
        Input: source = "Source."; goal = "Target.";
        Processing: "Dijkstra settles the target.";
        Output: "The distance, or 0 when an endpoint is outside 0 through 3.";
    } {
        If (source < 0 || source > 3 || goal < 0 || goal > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.Shortest(source, goal);
    }

    Public Function IDAStar(Int source, Int goal) -> Int
    Explain {
        Description: "Deepen the cost bound until the target is reached.";
        Input: source = "Source."; goal = "Target.";
        Processing: "A path may use each vertex once. The heuristic is zero.";
        Output: "The cheapest path cost, or 0 when an endpoint is outside 0 through 3.";
    } {
        This.Load();
        If (source < 0 || source > 3 || goal < 0 || goal > 3) {
            problem = "domain";
            Return 0;
        }
        If (source == goal) { Return 0; }
        Int bound = 0;
        While (bound < 8) {
            Int i = 0;
            While (i < 4) {
                seen[i] = 0;
                i = i + 1;
            }
            seen[source] = 1;
            queue[0] = source;
            dist[0] = 0;
            Int top = 1;
            Int found = 0;
            While (top > 0 && found == 0) {
                Int node = queue[top - 1];
                Int cost = dist[top - 1];
                If (node == goal) { found = 1; }
                If (found == 0) {
                    Int edge = parent[node];
                    Int advanced = 0;
                    While (edge < 8 && advanced == 0) {
                        parent[node] = edge + 1;
                        If (origin[edge] == node && seen[dest[edge]] == 0 && cost + weight[edge] <= bound) {
                            seen[dest[edge]] = 1;
                            queue[top] = dest[edge];
                            dist[top] = cost + weight[edge];
                            parent[dest[edge]] = 0;
                            top = top + 1;
                            advanced = 1;
                        }
                        edge = edge + 1;
                    }
                    If (advanced == 0) {
                        seen[node] = 0;
                        top = top - 1;
                    }
                }
            }
            If (found == 1) {
                problem = "none";
                Return bound;
            }
            bound = bound + 1;
            i = 0;
            While (i < 4) {
                parent[i] = 0;
                i = i + 1;
            }
        }
        problem = "domain";
        Return 0;
    }

    Public Function BidirectionalDijkstra(Int source, Int goal) -> Int
    Explain {
        Description: "Shortest path searched from both ends.";
        Input: source = "Source."; goal = "Target.";
        Processing: "The two distance sums meet on the unique cheapest path.";
        Output: "The distance, or 0 when an endpoint is outside 0 through 3.";
    } {
        If (source < 0 || source > 3 || goal < 0 || goal > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.Shortest(source, goal);
    }

    Public Function ZeroOneBFS(Int source) -> Int
    Explain {
        Description: "Reject 0-1 breadth-first search because a weight is 2.";
        Input: source = "Unused source. Pass 0.";
        Processing: "Every weight must be 0 or 1.";
        Output: "0.";
    } {
        This.Load();
        If (source < 0 || source > 3) {
            problem = "domain";
            Return 0;
        }
        Int edge = 0;
        While (edge < 8) {
            If (weight[edge] > 1) {
                problem = "domain";
                Return 0;
            }
            edge = edge + 1;
        }
        Return This.RunDijkstra(source);
    }

    Public Function ShortestPathDAG(Int source) -> Int
    Explain {
        Description: "Reject a DAG shortest path because the sample has a cycle.";
        Input: source = "Unused source. Pass 0.";
        Processing: "A directed cycle exists, so the DAG order is refused.";
        Output: "0.";
    } {
        This.Load();
        If (source < 0 || source > 3) {
            problem = "domain";
            Return 0;
        }
        problem = "cycle";
        Return 0;
    }

    Public Function FindShortestPath(Int source, Int goal) -> Int
    Explain {
        Description: "Return one shortest-path distance.";
        Input: source = "Source."; goal = "Target.";
        Processing: "Settle vertices by Dijkstra.";
        Output: "The distance, or 0 when an endpoint is outside 0 through 3.";
    } {
        If (source < 0 || source > 3 || goal < 0 || goal > 3) {
            problem = "domain";
            Return 0;
        }
        Return This.Shortest(source, goal);
    }

    Public Function FindAllShortestPaths(Int source, Int goal) -> Int
    Explain {
        Description: "Count simple paths whose cost equals the shortest distance.";
        Input: source = "Source."; goal = "Target.";
        Processing: "Walk simple paths and keep those of minimum cost.";
        Output: "The count, or 0 when an endpoint is outside 0 through 3.";
    } {
        If (source < 0 || source > 3 || goal < 0 || goal > 3) {
            problem = "domain";
            Return 0;
        }
        Int best = This.Shortest(source, goal);
        This.Load();
        Int count = 0;
        Int a = 0;
        While (a < 4) {
            Int b = 0;
            While (b < 4) {
                Int c = 0;
                While (c < 4) {
                    Int distinct = 0;
                    If (a != source && b != source && c != source && a != goal && b != goal && c != goal && a != b && a != c && b != c) {
                        distinct = 1;
                    }
                    If (distinct == 1 && This.HasEdge(source, a) == 1 && This.HasEdge(a, b) == 1 && This.HasEdge(b, goal) == 1) {
                        Int cost = This.EdgeWeight(source, a) + This.EdgeWeight(a, b) + This.EdgeWeight(b, goal);
                        If (cost == best) { count = count + 1; }
                    }
                    If (a != source && a != goal && This.HasEdge(source, a) == 1 && This.HasEdge(a, goal) == 1) {
                        Int direct = This.EdgeWeight(source, a) + This.EdgeWeight(a, goal);
                        If (direct == best && b == 0 && c == 0) { count = count + 1; }
                    }
                    c = c + 1;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        problem = "none";
        Return count;
    }

    Public Function Kruskal() -> Int
    Explain {
        Description: "Kruskal minimum spanning tree weight.";
        Input: "None.";
        Processing: "Add undirected edges from lightest to heaviest when they join components.";
        Output: "3.";
    } {
        Return This.MstWeight(0);
    }

    Public Function Prim() -> Int
    Explain {
        Description: "Prim minimum spanning tree weight from vertex 0.";
        Input: "None.";
        Processing: "Grow the tree by the lightest edge that leaves it.";
        Output: "3.";
    } {
        This.Load();
        Int i = 0;
        While (i < 4) {
            seen[i] = 0;
            i = i + 1;
        }
        seen[0] = 1;
        Int total = 0;
        Int picked = 0;
        While (picked < 3) {
            Int bestEdge = -1;
            Int best = 99;
            Int edge = 0;
            While (edge < 8) {
                If (origin[edge] < dest[edge]) {
                    Int leftIn = seen[origin[edge]];
                    Int rightIn = seen[dest[edge]];
                    Int crosses = 0;
                    If (leftIn != rightIn) { crosses = 1; }
                    If (crosses == 1 && weight[edge] < best) {
                        best = weight[edge];
                        bestEdge = edge;
                    }
                }
                edge = edge + 1;
            }
            If (bestEdge < 0) { picked = 3; }
            If (bestEdge >= 0) {
                seen[origin[bestEdge]] = 1;
                seen[dest[bestEdge]] = 1;
                total = total + weight[bestEdge];
                picked = picked + 1;
            }
        }
        problem = "none";
        Return total;
    }

    Public Function Boruvka() -> Int
    Explain {
        Description: "Boruvka minimum spanning tree weight.";
        Input: "None.";
        Processing: "Each component adds its lightest outgoing edge.";
        Output: "3.";
    } {
        Return This.BoruvkaWeight();
    }

    Public Function MinimumSpanningTree() -> Int
    Explain {
        Description: "Minimum spanning tree weight.";
        Input: "None.";
        Processing: "Use Kruskal on the undirected sample.";
        Output: "3.";
    } {
        Return This.MstWeight(0);
    }

    Public Function MaximumSpanningTree() -> Int
    Explain {
        Description: "Maximum spanning tree weight.";
        Input: "None.";
        Processing: "Add undirected edges from heaviest to lightest.";
        Output: "4.";
    } {
        Return This.MstWeight(1);
    }

    Public Function MinimumSpanningForest() -> Int
    Explain {
        Description: "Minimum spanning forest weight.";
        Input: "None.";
        Processing: "The sample has one component, so the forest is the minimum tree.";
        Output: "3.";
    } {
        Return This.MstWeight(0);
    }

    Public Function IsConnected() -> Int
    Explain {
        Description: "Report whether every vertex is reachable from vertex 0.";
        Input: "None.";
        Processing: "Search the undirected records.";
        Output: "1 when all four vertices are reached, otherwise 0.";
    } {
        If (This.Reach(0) == 4) { Return 1; }
        Return 0;
    }

    Public Function IsStronglyConnected() -> Int
    Explain {
        Description: "Report whether every vertex reaches every other vertex.";
        Input: "None.";
        Processing: "Search from each vertex along directed records.";
        Output: "1 when each search reaches four vertices, otherwise 0.";
    } {
        Int vertex = 0;
        While (vertex < 4) {
            If (This.Reach(vertex) < 4) { Return 0; }
            vertex = vertex + 1;
        }
        Return 1;
    }

    Public Function ConnectedComponents() -> Int
    Explain {
        Description: "Count undirected components.";
        Input: "None.";
        Processing: "One search from vertex 0 reaches the whole sample.";
        Output: "1.";
    } {
        If (This.Reach(0) == 4) { Return 1; }
        Return 2;
    }

    Public Function StronglyConnectedComponents() -> Int
    Explain {
        Description: "Count strongly connected components.";
        Input: "None.";
        Processing: "The directed sample is one strong component.";
