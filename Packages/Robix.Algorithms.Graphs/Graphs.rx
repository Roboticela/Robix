        Processing: "Forward capacity is stored only on records whose origin is below the destination.";
        Output: "The flow, or 0 when an endpoint is outside 0 through 3.";
    } {
        If (source < 0 || source > 3 || sink < 0 || sink > 3 || source == sink) {
            problem = "domain";
            Return 0;
