}

Test Infinity {
    Processing: TrigDesk().Infinity();
    Assert: TrigDesk().Infinity() == 1.0 / 0.0;
}

Test NegativeInfinity {
    Processing: TrigDesk().NegativeInfinity();
    Assert: TrigDesk().NegativeInfinity() == 0.0 - TrigDesk().Infinity();
}
