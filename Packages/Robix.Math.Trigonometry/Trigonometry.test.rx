Test Solve {
    Case "sine" {
        Constraint: TrigDesk().Solve("sin", 0.5) == 30.0;
        Processing: TrigDesk().Solve("sin", 0.5);
        Output: 30.0;
    }
    Case "cosine" {
        Constraint: TrigDesk().Solve("cos", 1.0) == 0.0;
        Processing: TrigDesk().Solve("cos", 1.0);
        Output: 0.0;
    }
}

Test Identity {
    Constraint: TrigDesk().Identity(0.0) == 1.0;
    Processing: TrigDesk().Identity(0.0);
    Output: 1.0;
}

Test Fault {
    Constraint: TrigDesk().Fault() == "none";
    Processing: TrigDesk().Fault();
