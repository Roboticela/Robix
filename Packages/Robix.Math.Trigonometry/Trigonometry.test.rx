}

Test Atan {
    Constraint: TrigDesk().Atan(0.0) == 0.0;
    Processing: TrigDesk().Atan(0.0);
    Output: 0.0;
}

Test Atan2 {
    Constraint: TrigDesk().Atan2(0.0, 1.0) == 0.0;
    Processing: TrigDesk().Atan2(0.0, 1.0);
    Output: 0.0;
}

Test Acot {
    Processing: TrigDesk().Acot(0.0);
    Assert: TrigDesk().Acot(0.0) == TrigDesk().Pi() / 2.0;
}

Test Asec {
    Case "one" {
        Constraint: TrigDesk().Asec(1.0) == 0.0;
        Processing: TrigDesk().Asec(1.0);
        Output: 0.0;
    }
    Case "inside" {
        Constraint: TrigDesk().Asec(0.0) == 0.0;
        Processing: TrigDesk().Asec(0.0);
        Output: 0.0;
    }
}

