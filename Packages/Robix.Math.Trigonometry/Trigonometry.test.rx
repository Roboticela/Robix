// Tests for Trigonometry.rx. Each call uses a fresh desk.

Test Pi {
    Constraint: TrigDesk().Pi() == 3.141592653589793;
    Processing: TrigDesk().Pi();
    Output: 3.141592653589793;
}

Test Sin {
    Constraint: TrigDesk().Sin(0.0) == 0.0;
    Processing: TrigDesk().Sin(0.0);
    Output: 0.0;
}

Test Cos {
    Constraint: TrigDesk().Cos(0.0) == 1.0;
    Processing: TrigDesk().Cos(0.0);
    Output: 1.0;
}

Test Tan {
    Constraint: TrigDesk().Tan(0.0) == 0.0;
    Processing: TrigDesk().Tan(0.0);
    Output: 0.0;
}

Test Cot {
    Processing: TrigDesk().Cot(0.0);
    Assert: TrigDesk().Cot(0.0) == TrigDesk().Infinity();
}

Test Sec {
    Constraint: TrigDesk().Sec(0.0) == 1.0;
    Processing: TrigDesk().Sec(0.0);
    Output: 1.0;
}

Test Csc {
    Processing: TrigDesk().Csc(0.0);
    Assert: TrigDesk().Csc(0.0) == TrigDesk().Infinity();
}

Test Asin {
    Constraint: TrigDesk().Asin(0.0) == 0.0;
    Processing: TrigDesk().Asin(0.0);
    Output: 0.0;
}

Test Acos {
    Constraint: TrigDesk().Acos(1.0) == 0.0;
    Processing: TrigDesk().Acos(1.0);
