// Tests for Conversions.rx. Width 0 is a byte and width 6 is a wide integer.

Test SetOverflow {
    Constraint: ConversionsDesk().SetOverflow(2) == 2;
    Processing: ConversionsDesk().SetOverflow(2);
    Output: 2;
}

Test SetRounding {
    Constraint: ConversionsDesk().SetRounding(1) == 1;
    Processing: ConversionsDesk().SetRounding(1);
    Output: 1;
}

Test Convert {
    Case "byte" {
        Constraint: ConversionsDesk().Convert(4, 0) == 4;
        Processing: ConversionsDesk().Convert(4, 0);
        Output: 4;
    }
    Case "unknown" {
        Constraint: ConversionsDesk().Convert(4, 9) == 0;
        Processing: ConversionsDesk().Convert(4, 9);
        Output: 0;
    }
}

Test AttemptConvert {
    Constraint: ConversionsDesk().AttemptConvert(4, 0) == 4;
    Processing: ConversionsDesk().AttemptConvert(4, 0);
    Output: 4;
}

Test CheckedConvert {
    Constraint: ConversionsDesk().CheckedConvert(4, 0) == 4;
    Processing: ConversionsDesk().CheckedConvert(4, 0);
    Output: 4;
}

Test ConvertSaturating {
    Constraint: ConversionsDesk().ConvertSaturating(300, 0) == 255;
    Processing: ConversionsDesk().ConvertSaturating(300, 0);
    Output: 255;
}

Test ConvertTruncating {
    Constraint: ConversionsDesk().ConvertTruncating(256, 0) == 0;
    Processing: ConversionsDesk().ConvertTruncating(256, 0);
    Output: 0;
}

Test ConvertOrDefault {
    Constraint: ConversionsDesk().ConvertOrDefault(4, 0, 9) == 4;
    Processing: ConversionsDesk().ConvertOrDefault(4, 0, 9);
    Output: 4;
}

