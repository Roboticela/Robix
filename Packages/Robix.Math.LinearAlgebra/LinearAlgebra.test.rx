// Tests for LinearAlgebra.rx. A fresh desk is the zero matrix. Identity arguments are loaded by the call.

Test CreateVector {
    Constraint: LinearAlgebraDesk().CreateVector(1, 2, 3) == 3;
    Processing: LinearAlgebraDesk().CreateVector(1, 2, 3);
    Output: 3;
}

