Test DotProduct {
    Constraint: LinearAlgebraDesk().DotProduct(1, 2, 3, 4, 5, 6) == 32;
    Processing: True;
    Output: True;
}

Test DeterminantOf {
    Constraint: LinearAlgebraDesk().DeterminantOf(1, 2, 3, 0, 1, 4, 5, 6, 0) == 1;
    Processing: True;
    Output: True;
}

Test SolveGaussian {
    Constraint: LinearAlgebraDesk().SolveGaussian(1, 0, 0, 0, 1, 0, 0, 0, 1, 4, 5, 6) == 4;
    Processing: True;
    Output: True;
}

Test VectorNorm {
    Constraint: LinearAlgebraDesk().VectorNorm(1, 2, 2, 0) == 3;
    Processing: True;
    Output: True;
}
