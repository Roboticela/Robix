// Tests for Arithmetic.rx. Each call uses a fresh desk.

Test Plus {
    Constraint: ArithmeticDesk().Plus(2, 3) == 5;
    Processing: ArithmeticDesk().Plus(2, 3);
    Output: 5;
}

Test Minus {
    Constraint: ArithmeticDesk().Minus(5, 2) == 3;
    Processing: ArithmeticDesk().Minus(5, 2);
    Output: 3;
}

Test Times {
    Constraint: ArithmeticDesk().Times(3, 4) == 12;
    Processing: ArithmeticDesk().Times(3, 4);
    Output: 12;
}

Test Quotient {
    Case "division" {
        Constraint: ArithmeticDesk().Quotient(7, 3) == 2;
        Processing: ArithmeticDesk().Quotient(7, 3);
        Output: 2;
    }
    Case "zero" {
        Constraint: ArithmeticDesk().Quotient(1, 0) == 0;
        Processing: ArithmeticDesk().Quotient(1, 0);
        Output: 0;
    }
}

