Test Validate {
    Constraint: JobDesk().Validate("*/5") == 1;
    Processing: JobDesk().Validate("*/5");
    Output: 1;
}

Test NextCron {
    Constraint: JobDesk().NextCron("*/5", 3) == 8;
    Processing: JobDesk().NextCron("*/5", 3);
    Output: 8;
}

Test PrevCron {
    Constraint: JobDesk().PrevCron("*/5", 3) == 0;
