// Tests for Scheduling.rx. Each call uses a fresh desk.

Test Schedule {
    Constraint: JobDesk().Schedule("tick", 3, 8) == 0;
    Processing: JobDesk().Schedule("tick", 3, 8);
    Output: 0;
}

Test ScheduleOnce {
    Constraint: JobDesk().ScheduleOnce("tick", 3, 8) == 0;
    Processing: JobDesk().ScheduleOnce("tick", 3, 8);
    Output: 0;
}

Test ScheduleAfter {
    Constraint: JobDesk().ScheduleAfter("tick", 3, 8) == 0;
    Processing: JobDesk().ScheduleAfter("tick", 3, 8);
    Output: 0;
}

Test ScheduleEvery {
    Constraint: JobDesk().ScheduleEvery("tick", 3, 8) == 0;
    Processing: JobDesk().ScheduleEvery("tick", 3, 8);
    Output: 0;
}

Test ScheduleCron {
    Case "step" {
        Constraint: JobDesk().ScheduleCron("tick", "*/5", 8) == 0;
        Processing: JobDesk().ScheduleCron("tick", "*/5", 8);
        Output: 0;
    }
    Case "invalid" {
        Constraint: JobDesk().ScheduleCron("tick", "no", 8) == -1;
        Processing: JobDesk().ScheduleCron("tick", "no", 8);
        Output: -1;
    }
}

Test ScheduleRecurring {
    Constraint: JobDesk().ScheduleRecurring("tick", 3, 8) == 0;
    Processing: JobDesk().ScheduleRecurring("tick", 3, 8);
    Output: 0;
}

Test ScheduleRank {
    Constraint: JobDesk().ScheduleRank("tick", 3, 8, 2) == 0;
    Processing: JobDesk().ScheduleRank("tick", 3, 8, 2);
    Output: 0;
}

