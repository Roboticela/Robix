Test SetMode {
    Case "round" {
        Constraint: JobDesk().SetMode(1) == 1;
        Processing: JobDesk().SetMode(1);
        Output: 1;
    }
    Case "rejected" {
        Constraint: JobDesk().SetMode(9) == 0;
        Processing: JobDesk().SetMode(9);
        Output: 0;
    }
}

Test Mode {
    Constraint: JobDesk().Mode() == "priority";
