// Tests for Synchronization.rx. Each call uses a fresh desk.

Test Acquire {
    Constraint: SyncDesk().Acquire(3) == 1;
    Processing: SyncDesk().Acquire(3);
    Output: 1;
}

Test TryAcquire {
    Constraint: SyncDesk().TryAcquire(3) == 1;
    Processing: SyncDesk().TryAcquire(3);
    Output: 1;
}

Test AcquireFor {
    Case "ready" {
        Constraint: SyncDesk().AcquireFor(3, 1) == 1;
        Processing: SyncDesk().AcquireFor(3, 1);
        Output: 1;
    }
    Case "negative" {
        Constraint: SyncDesk().AcquireFor(3, -1) == 0;
        Processing: SyncDesk().AcquireFor(3, -1);
        Output: 0;
    }
}

Test Release {
    Constraint: SyncDesk().Release(3) == 0;
    Processing: SyncDesk().Release(3);
    Output: 0;
}

Test IsLocked {
    Constraint: SyncDesk().IsLocked() == 0;
    Processing: SyncDesk().IsLocked();
    Output: 0;
}

Test Owner {
    Constraint: SyncDesk().Owner() == 0;
    Processing: SyncDesk().Owner();
    Output: 0;
}

Test WaitSem {
    Constraint: SyncDesk().WaitSem() == 1;
    Processing: SyncDesk().WaitSem();
    Output: 1;
}

Test TryWait {
    Constraint: SyncDesk().TryWait() == 1;
    Processing: SyncDesk().TryWait();
    Output: 1;
}

Test ReleaseSem {
    Constraint: SyncDesk().ReleaseSem() == 0;
    Processing: SyncDesk().ReleaseSem();
    Output: 0;
}

Test SemCount {
    Constraint: SyncDesk().SemCount() == 2;
    Processing: SyncDesk().SemCount();
