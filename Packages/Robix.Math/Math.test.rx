// Tests for Math.rx. Each call uses a fresh desk.

Test Pi {
    Constraint: MathDesk().Pi() == 3.141592653589793;
    Processing: MathDesk().Pi();
    Output: 3.141592653589793;
}

Test E {
    Constraint: MathDesk().E() == 2.718281828459045;
    Processing: MathDesk().E();
    Output: 2.718281828459045;
}

Test Tau {
    Processing: MathDesk().Tau();
    Assert: MathDesk().Tau() == MathDesk().Pi() * 2.0;
}

Test Phi {
    Constraint: MathDesk().Phi() == 1.618033988749895;
    Processing: MathDesk().Phi();
    Output: 1.618033988749895;
}

Test Sqrt2 {
    Constraint: MathDesk().Sqrt2() == 1.4142135623730951;
    Processing: MathDesk().Sqrt2();
    Output: 1.4142135623730951;
}

Test Sqrt3 {
    Constraint: MathDesk().Sqrt3() == 1.7320508075688772;
    Processing: MathDesk().Sqrt3();
    Output: 1.7320508075688772;
}

Test Ln2 {
    Constraint: MathDesk().Ln2() == 0.6931471805599453;
    Processing: MathDesk().Ln2();
    Output: 0.6931471805599453;
}

Test Ln10 {
    Constraint: MathDesk().Ln10() == 2.302585092994046;
    Processing: MathDesk().Ln10();
    Output: 2.302585092994046;
}

Test Log2E {
    Constraint: MathDesk().Log2E() == 1.4426950408889634;
    Processing: MathDesk().Log2E();
    Output: 1.4426950408889634;
}

Test Log10E {
    Constraint: MathDesk().Log10E() == 0.4342944819032518;
    Processing: MathDesk().Log10E();
    Output: 0.4342944819032518;
}

Test Infinity {
    Constraint: MathDesk().Infinity() == 0.0;
    Processing: MathDesk().Infinity();
    Output: 0.0;
}

Test NegativeInfinity {
    Constraint: MathDesk().NegativeInfinity() == 0.0;
    Processing: MathDesk().NegativeInfinity();
    Output: 0.0;
}

Test NaN {
    Constraint: MathDesk().NaN() == 0.0;
    Processing: MathDesk().NaN();
    Output: 0.0;
}

Test Epsilon {
    Constraint: MathDesk().Epsilon() == 0.000001;
    Processing: MathDesk().Epsilon();
    Output: 0.000001;
}

Test Abs {
    Constraint: MathDesk().Abs(-3.0) == 3.0;
    Processing: MathDesk().Abs(-3.0);
    Output: 3.0;
}

Test Sign {
    Case "negative" {
        Constraint: MathDesk().Sign(-2.0) == -1;
        Processing: MathDesk().Sign(-2.0);
        Output: -1;
    }
    Case "zero" {
        Constraint: MathDesk().Sign(0.0) == 0;
        Processing: MathDesk().Sign(0.0);
        Output: 0;
    }
}

Test Negate {
    Constraint: MathDesk().Negate(4.0) == -4.0;
    Processing: MathDesk().Negate(4.0);
    Output: -4.0;
}

Test CopySign {
    Constraint: MathDesk().CopySign(3.0, -1.0) == -3.0;
    Processing: MathDesk().CopySign(3.0, -1.0);
    Output: -3.0;
}

Test Min {
    Constraint: MathDesk().Min(2.0, 5.0) == 2.0;
    Processing: MathDesk().Min(2.0, 5.0);
    Output: 2.0;
}

Test Max {
    Constraint: MathDesk().Max(2.0, 5.0) == 5.0;
    Processing: MathDesk().Max(2.0, 5.0);
    Output: 5.0;
}

Test MinOf {
    Constraint: MathDesk().MinOf(4.0, 1.0, 3.0) == 1.0;
    Processing: MathDesk().MinOf(4.0, 1.0, 3.0);
    Output: 1.0;
}

Test MaxOf {
    Constraint: MathDesk().MaxOf(4.0, 1.0, 3.0) == 4.0;
    Processing: MathDesk().MaxOf(4.0, 1.0, 3.0);
    Output: 4.0;
}

Test Clamp {
    Constraint: MathDesk().Clamp(9.0, 1.0, 5.0) == 5.0;
    Processing: MathDesk().Clamp(9.0, 1.0, 5.0);
    Output: 5.0;
}

Test Clamp01 {
    Constraint: MathDesk().Clamp01(2.0) == 1.0;
    Processing: MathDesk().Clamp01(2.0);
    Output: 1.0;
}

Test Saturate {
    Constraint: MathDesk().Saturate(-1.0) == 0.0;
    Processing: MathDesk().Saturate(-1.0);
    Output: 0.0;
}

Test Lerp {
    Constraint: MathDesk().Lerp(2.0, 6.0, 0.5) == 4.0;
    Processing: MathDesk().Lerp(2.0, 6.0, 0.5);
    Output: 4.0;
}

Test InverseLerp {
    Constraint: MathDesk().InverseLerp(2.0, 6.0, 4.0) == 0.5;
    Processing: MathDesk().InverseLerp(2.0, 6.0, 4.0);
    Output: 0.5;
}

Test Remap {
    Constraint: MathDesk().Remap(4.0, 2.0, 6.0, 10.0, 20.0) == 15.0;
    Processing: MathDesk().Remap(4.0, 2.0, 6.0, 10.0, 20.0);
    Output: 15.0;
}

Test Pow {
    Constraint: MathDesk().Pow(2.0, 3) == 8.0;
    Processing: MathDesk().Pow(2.0, 3);
    Output: 8.0;
}

Test Sqrt {
    Constraint: MathDesk().Sqrt(9.0) == 3.0;
    Processing: MathDesk().Sqrt(9.0);
    Output: 3.0;
}

Test Cbrt {
    Constraint: MathDesk().Cbrt(8.0) == 2.0;
    Processing: MathDesk().Cbrt(8.0);
    Output: 2.0;
}

Test Root {
    Case "square" {
        Constraint: MathDesk().Root(16.0, 2) == 4.0;
        Processing: MathDesk().Root(16.0, 2);
        Output: 4.0;
    }
    Case "even negative" {
        Constraint: MathDesk().Root(-4.0, 2) == 0.0;
        Processing: MathDesk().Root(-4.0, 2);
        Output: 0.0;
    }
}

Test Hypot {
    Constraint: MathDesk().Hypot(3.0, 4.0) == 5.0;
    Processing: MathDesk().Hypot(3.0, 4.0);
