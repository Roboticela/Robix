Test IsPowerOfTwo {
    Case "power" {
        Constraint: MathDesk().IsPowerOfTwo(8) == 1;
        Processing: MathDesk().IsPowerOfTwo(8);
        Output: 1;
    }
    Case "other" {
        Constraint: MathDesk().IsPowerOfTwo(6) == 0;
        Processing: MathDesk().IsPowerOfTwo(6);
        Output: 0;
    }
}

