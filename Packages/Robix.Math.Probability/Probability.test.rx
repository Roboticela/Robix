// Tests for Probability.rx. Each call uses a fresh desk.

Test CalculateProbability {
    Constraint: ProbabilityDesk().CalculateProbability(1, 4) == 0.25;
    Processing: ProbabilityDesk().CalculateProbability(1, 4);
    Output: 0.25;
}

Test Complement {
    Constraint: ProbabilityDesk().Complement(0.25) == 0.75;
    Processing: ProbabilityDesk().Complement(0.25);
    Output: 0.75;
}

Test JointProbability {
    Constraint: ProbabilityDesk().JointProbability(0.5, 0.5) == 0.25;
    Processing: ProbabilityDesk().JointProbability(0.5, 0.5);
    Output: 0.25;
}

Test ConditionalProbability {
    Constraint: ProbabilityDesk().ConditionalProbability(0.25, 0.5) == 0.5;
