// Tests for Units.rx. Conversions that are not exact integers return zero.

Test Convert {
    Case "kilometer" {
        Constraint: UnitsDesk().Convert(1, "km", "m") == 1000;
        Processing: UnitsDesk().Convert(1, "km", "m");
        Output: 1000;
    }
    Case "unknown" {
        Constraint: UnitsDesk().Convert(1, "nope", "m") == 0;
        Processing: UnitsDesk().Convert(1, "nope", "m");
        Output: 0;
    }
}

Test AttemptConvert {
    Constraint: UnitsDesk().AttemptConvert(1000, "m", "km") == 1;
    Processing: UnitsDesk().AttemptConvert(1000, "m", "km");
    Output: 1;
}

Test GetConversionFactor {
    Constraint: UnitsDesk().GetConversionFactor("km", "m") == 1000;
    Processing: UnitsDesk().GetConversionFactor("km", "m");
    Output: 1000;
}

Test GetConversionOffset {
    Constraint: UnitsDesk().GetConversionOffset("C", "K") == 273;
    Processing: UnitsDesk().GetConversionOffset("C", "K");
    Output: 273;
}

Test ConvertTemperature {
    Constraint: UnitsDesk().ConvertTemperature(0, "C", "K") == 273;
    Processing: UnitsDesk().ConvertTemperature(0, "C", "K");
    Output: 273;
}

Test ConvertLength {
    Constraint: UnitsDesk().ConvertLength(1, "km", "m") == 1000;
    Processing: UnitsDesk().ConvertLength(1, "km", "m");
    Output: 1000;
}

Test ConvertMass {
    Constraint: UnitsDesk().ConvertMass(1, "kg", "g") == 1000;
    Processing: UnitsDesk().ConvertMass(1, "kg", "g");
    Output: 1000;
}

Test ConvertTime {
    Constraint: UnitsDesk().ConvertTime(1, "s", "ms") == 1000;
    Processing: UnitsDesk().ConvertTime(1, "s", "ms");
    Output: 1000;
}

Test ConvertVolume {
    Constraint: UnitsDesk().ConvertVolume(1, "L", "mL") == 1000;
    Processing: UnitsDesk().ConvertVolume(1, "L", "mL");
    Output: 1000;
}

Test ConvertSpeed {
    Constraint: UnitsDesk().ConvertSpeed(1, "m/s", "m/s") == 1;
    Processing: UnitsDesk().ConvertSpeed(1, "m/s", "m/s");
    Output: 1;
}

Test ConvertPressure {
    Constraint: UnitsDesk().ConvertPressure(1, "kPa", "Pa") == 1000;
    Processing: UnitsDesk().ConvertPressure(1, "kPa", "Pa");
    Output: 1000;
}

Test ConvertEnergy {
    Constraint: UnitsDesk().ConvertEnergy(1, "kJ", "J") == 1000;
    Processing: UnitsDesk().ConvertEnergy(1, "kJ", "J");
    Output: 1000;
}

Test AddQuantities {
    Constraint: UnitsDesk().AddQuantities(1, "m", 1000, "mm") == 2;
    Processing: UnitsDesk().AddQuantities(1, "m", 1000, "mm");
    Output: 2;
}

Test SubtractQuantities {
    Constraint: UnitsDesk().SubtractQuantities(2, "m", 1000, "mm") == 1;
    Processing: UnitsDesk().SubtractQuantities(2, "m", 1000, "mm");
    Output: 1;
}

Test MultiplyQuantities {
    Constraint: UnitsDesk().MultiplyQuantities(2, "m", 3, "m") == 6;
    Processing: UnitsDesk().MultiplyQuantities(2, "m", 3, "m");
    Output: 6;
}

Test DivideQuantities {
    Constraint: UnitsDesk().DivideQuantities(10, "m", 2, "s") == 5;
    Processing: UnitsDesk().DivideQuantities(10, "m", 2, "s");
    Output: 5;
}

Test ScaleQuantity {
    Constraint: UnitsDesk().ScaleQuantity(3, "m", 4) == 12;
    Processing: UnitsDesk().ScaleQuantity(3, "m", 4);
    Output: 12;
