Test CompareQuantities {
    Constraint: UnitsDesk().CompareQuantities(2, "m", 1000, "mm") == 1;
    Processing: UnitsDesk().CompareQuantities(2, "m", 1000, "mm");
    Output: 1;
}

Test NormalizeQuantity {
    Constraint: UnitsDesk().NormalizeQuantity(1, "km") == 1000;
    Processing: UnitsDesk().NormalizeQuantity(1, "km");
