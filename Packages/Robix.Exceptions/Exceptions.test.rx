// Tests for Exceptions.rx.

Test Known {
    Case "format" {
        Constraint: FaultDesk().Known("FormatException") == 1;
        Processing: FaultDesk().Known("FormatException");
        Output: 1;
    }
    Case "unknown" {
        Constraint: FaultDesk().Known("Nope") == 0;
        Processing: FaultDesk().Known("Nope");
        Output: 0;
    }
}

Test ThrowIf {
    Case "quiet" {
        Constraint: FaultDesk().ThrowIf(0, "Exception", "bad") == 0;
        Processing: FaultDesk().ThrowIf(0, "Exception", "bad");
        Output: 0;
    }
    Case "throws" {
        Constraint: FaultDesk().ThrowIf(1, "Exception", "bad") == 1;
        Processing: FaultDesk().ThrowIf(1, "Exception", "bad");
        Output: 1;
    }
}

Test ThrowIfNull {
    Case "present" {
        Constraint: FaultDesk().ThrowIfNull("name") == 0;
        Processing: FaultDesk().ThrowIfNull("name");
        Output: 0;
    }
    Case "empty" {
        Constraint: FaultDesk().ThrowIfNull("") == 1;
        Processing: FaultDesk().ThrowIfNull("");
        Output: 1;
    }
}

Test Prepare {
    Case "known type" {
        Constraint: FaultDesk().Prepare("FormatException", "bad") == 1;
        Processing: FaultDesk().Prepare("FormatException", "bad");
        Output: 1;
    }
    Case "unknown type" {
        Constraint: FaultDesk().Prepare("Nope", "bad") == 0;
        Processing: FaultDesk().Prepare("Nope", "bad");
        Output: 0;
    }
}

Test RaiseWithInner {
    Case "both known" {
        Constraint: FaultDesk().RaiseWithInner("Exception", "outer", "FormatException", "inner") == 1;
        Processing: FaultDesk().RaiseWithInner("Exception", "outer", "FormatException", "inner");
        Output: 1;
    }
    Case "unknown outer" {
        Constraint: FaultDesk().RaiseWithInner("Nope", "outer", "Exception", "inner") == 0;
        Processing: FaultDesk().RaiseWithInner("Nope", "outer", "Exception", "inner");
        Output: 0;
    }
}

Test Enter {
    Constraint: FaultDesk().Enter("Main", "App.rx", 4) == 1;
    Processing: FaultDesk().Enter("Main", "App.rx", 4);
    Output: 1;
}

