// Robix.Color: RGB, HEX, HSV, HSL, CMYK, and contrast for any package.
Package Robix.Color
Explain {
    Description: "RGB, HEX, HSV, HSL, CMYK, and contrast for any package.";
};

Import Robix.Core;


Class ColorDesk {
    Private Int red;
    Private Int green;
    Private Int blue;
    Private Int alpha;
    Private Int hue;
    Private Int saturation;
    Private Int value;
    Private Int lightness;
    Private String problem;

    Public Constructor() {
        red = 0;
        green = 0;
        blue = 0;
        alpha = 255;
        hue = 0;
        saturation = 0;
        value = 0;
        lightness = 0;
        problem = "none";
    }

    Public Function Rgb(Int r, Int g, Int b) -> Int
    Explain {
        Description: "Store an RGB color.";
        Input: r = "Red", g = "Green", b = "Blue";
        Processing: "Clamp each channel and derive the other models.";
        Output: "The packed color.";
    } {
        Return This.Store(r, g, b, 255);
    }

    Public Function Rgba(Int r, Int g, Int b, Int a) -> Int
    Explain {
        Description: "Store an RGB color and an alpha.";
        Input: r = "Red", g = "Green", b = "Blue", a = "Alpha";
        Processing: "Clamp each channel. Terminal drawing composites the alpha later.";
        Output: "The packed color.";
    } {
        Return This.Store(r, g, b, a);
    }

    Public Function Hex(String text) -> Int
    Explain {
        Description: "Store a color from HEX text.";
        Input: text = "RRGGBB, with an optional leading hash";
        Processing: "Read three channel pairs.";
        Output: "The packed color, or zero when the text is not a color.";
    } {
        Int index = 0;
        If (text.Length() > 0) {
            String mark = text.Substring(0, 1);
            If (mark == "#") { index = 1; }
        }
        If (text.Length() < index + 6) {
            problem = "hex";
            Return 0;
        }
        Int r = This.Pair(text, index);
        Int g = This.Pair(text, index + 2);
        Int b = This.Pair(text, index + 4);
        If (r < 0 || g < 0 || b < 0) {
            problem = "hex";
            Return 0;
        }
        Return This.Store(r, g, b, 255);
    }

    Public Function FromHsv(Int h, Int s, Int v) -> Int
    Explain {
        Description: "Store a color from HSV.";
        Input: h = "Hue from 0 through 360", s = "Saturation from 0 through 100", v = "Value from 0 through 100";
        Processing: "Convert the cone to RGB.";
        Output: "The packed color.";
    } {
        Int turn = h;
        While (turn >= 360) { turn = turn - 360; }
        While (turn < 0) { turn = turn + 360; }
        Int sector = turn / 60;
        Int offset = turn % 60;
        Int chroma = v * s / 100;
        Int cross = chroma * offset / 60;
        Int rest = chroma - cross;
        Int rr = 0;
        Int gg = 0;
        Int bb = 0;
        If (sector == 0) { rr = chroma; gg = cross; }
        If (sector == 1) { rr = rest; gg = chroma; }
        If (sector == 2) { gg = chroma; bb = cross; }
        If (sector == 3) { gg = rest; bb = chroma; }
        If (sector == 4) { rr = cross; bb = chroma; }
        If (sector == 5) { rr = chroma; bb = rest; }
        Int lift = v - chroma;
        Return This.Store(This.Scale(rr + lift), This.Scale(gg + lift), This.Scale(bb + lift), 255);
    }

    Public Function FromHsl(Int h, Int s, Int l) -> Int
    Explain {
        Description: "Store a color from HSL.";
        Input: h = "Hue from 0 through 360", s = "Saturation from 0 through 100", l = "Lightness from 0 through 100";
        Processing: "Convert lightness to a value and use HSV.";
        Output: "The packed color.";
    } {
        Int opposite = 2 * l - 100;
        If (opposite < 0) { opposite = 0 - opposite; }
        Int chroma = (100 - opposite) * s / 100;
        Int peak = l + chroma / 2;
        Int sat = 0;
        If (peak != 0) { sat = chroma * 100 / peak; }
        Return This.FromHsv(h, sat, peak);
    }

    Public Function FromCmyk(Int cyan, Int magenta, Int yellow, Int key) -> Int
    Explain {
        Description: "Store a color from CMYK.";
        Input: cyan = "Cyan percent", magenta = "Magenta percent", yellow = "Yellow percent", key = "Black percent";
        Processing: "Convert the ink amounts to RGB.";
        Output: "The packed color.";
    } {
        Int r = 255 * (100 - cyan) * (100 - key) / 10000;
        Int g = 255 * (100 - magenta) * (100 - key) / 10000;
        Int b = 255 * (100 - yellow) * (100 - key) / 10000;
        Return This.Store(r, g, b, 255);
    }

    Public Function From256(Int index) -> Int
    Explain {
        Description: "Store a 256-color palette entry.";
        Input: index = "Palette index from 0 through 255";
        Processing: "Use the basic colors, the color cube, or the gray ramp.";
        Output: "The packed color.";
    } {
        If (index < 0 || index > 255) {
            problem = "palette";
            Return 0;
        }
        If (index < 16) { Return This.AnsiIndex(index); }
        If (index >= 232) {
            Int gray = 8 + (index - 232) * 10;
            Return This.Store(gray, gray, gray, 255);
        }
        Int cube = index - 16;
        Int rr = cube / 36;
        Int gg = (cube % 36) / 6;
        Int bb = cube % 6;
        Return This.Store(This.Cube(rr), This.Cube(gg), This.Cube(bb), 255);
    }

    Public Function FromAnsi(String name) -> Int
    Explain {
        Description: "Store a named ANSI color.";
        Input: name = "black, red, green, yellow, blue, magenta, cyan, white, or gray";
        Processing: "Map the name to its channel values.";
        Output: "The packed color, or zero when the name is unknown.";
    } {
        If (name == "black") { Return This.Store(0, 0, 0, 255); }
        If (name == "red") { Return This.Store(255, 0, 0, 255); }
        If (name == "green") { Return This.Store(0, 255, 0, 255); }
        If (name == "yellow") { Return This.Store(255, 255, 0, 255); }
        If (name == "blue") { Return This.Store(0, 0, 255, 255); }
        If (name == "magenta") { Return This.Store(255, 0, 255, 255); }
        If (name == "cyan") { Return This.Store(0, 255, 255, 255); }
        If (name == "white") { Return This.Store(255, 255, 255, 255); }
        If (name == "gray") { Return This.Store(128, 128, 128, 255); }
        problem = "name";
        Return 0;
    }

    Public Function ToHex() -> String
    Explain {
        Description: "Return the stored color as HEX.";
        Input: "No parameters";
        Processing: "Write two digits for each channel.";
        Output: "Six uppercase hex digits.";
    } {
        Return This.ByteText(red) + This.ByteText(green) + This.ByteText(blue);
    }

    Public Function Red() -> Int
    Explain {
        Description: "Return the red channel.";
        Input: "No parameters";
        Processing: "Read the stored channel.";
        Output: "Red from 0 through 255.";
    } {
        Return red;
    }

    Public Function Green() -> Int
    Explain {
        Description: "Return the green channel.";
        Input: "No parameters";
        Processing: "Read the stored channel.";
        Output: "Green from 0 through 255.";
    } {
        Return green;
    }

    Public Function Blue() -> Int
    Explain {
        Description: "Return the blue channel.";
        Input: "No parameters";
        Processing: "Read the stored channel.";
        Output: "Blue from 0 through 255.";
    } {
        Return blue;
    }

    Public Function Alpha() -> Int
    Explain {
        Description: "Return the alpha channel.";
        Input: "No parameters";
        Processing: "Read the stored alpha.";
        Output: "Alpha from 0 through 255.";
    } {
        Return alpha;
    }

    Public Function Hue() -> Int
    Explain {
        Description: "Return the hue.";
        Input: "No parameters";
        Processing: "Read the hue derived from the stored RGB color.";
        Output: "Hue from 0 through 359.";
    } {
        Return hue;
    }

    Public Function Saturation() -> Int
    Explain {
        Description: "Return the HSV saturation.";
        Input: "No parameters";
        Processing: "Read the saturation derived from the stored RGB color.";
        Output: "Saturation from 0 through 100.";
    } {
        Return saturation;
    }

    Public Function Value() -> Int
    Explain {
        Description: "Return the HSV value.";
        Input: "No parameters";
        Processing: "Read the value derived from the stored RGB color.";
        Output: "Value from 0 through 100.";
    } {
        Return value;
    }

    Public Function Lightness() -> Int
    Explain {
        Description: "Return the HSL lightness.";
        Input: "No parameters";
        Processing: "Read the lightness derived from the stored RGB color.";
        Output: "Lightness from 0 through 100.";
    } {
        Return lightness;
    }

    Public Function Lighten(Int percent) -> Int
    Explain {
        Description: "Lighten the stored color.";
        Input: percent = "Amount from 0 through 100";
        Processing: "Move each channel toward white.";
        Output: "The packed color.";
    } {
        Int r = red + (255 - red) * percent / 100;
        Int g = green + (255 - green) * percent / 100;
        Int b = blue + (255 - blue) * percent / 100;
        Return This.Store(r, g, b, alpha);
    }

    Public Function Darken(Int percent) -> Int
    Explain {
        Description: "Darken the stored color.";
        Input: percent = "Amount from 0 through 100";
        Processing: "Move each channel toward black.";
        Output: "The packed color.";
    } {
        Int r = red * (100 - percent) / 100;
        Int g = green * (100 - percent) / 100;
        Int b = blue * (100 - percent) / 100;
        Return This.Store(r, g, b, alpha);
    }

    Public Function Mix(Int r, Int g, Int b, Int percent) -> Int
    Explain {
        Description: "Mix the stored color toward another color.";
        Input: r = "Other red", g = "Other green", b = "Other blue", percent = "Weight of the other color";
        Processing: "Blend the channels.";
        Output: "The packed color.";
    } {
        Int rr = (red * (100 - percent) + r * percent) / 100;
        Int gg = (green * (100 - percent) + g * percent) / 100;
        Int bb = (blue * (100 - percent) + b * percent) / 100;
        Return This.Store(rr, gg, bb, alpha);
    }

    Public Function Invert() -> Int
    Explain {
        Description: "Invert the stored color.";
        Input: "No parameters";
        Processing: "Subtract each channel from 255.";
        Output: "The packed color.";
    } {
        Return This.Store(255 - red, 255 - green, 255 - blue, alpha);
    }

    Public Function Grayscale() -> Int
    Explain {
        Description: "Return the grayscale level of the stored color.";
        Input: "No parameters";
        Processing: "Weight the channels.";
        Output: "A level from 0 through 255.";
    } {
        Return (red * 30 + green * 59 + blue * 11) / 100;
    }

    Public Function WithAlpha(Int a) -> Int
    Explain {
        Description: "Store a new alpha.";
        Input: a = "Alpha";
        Processing: "Keep the RGB channels.";
        Output: "The packed color.";
    } {
        alpha = This.Clamp(a);
        Return red * 65536 + green * 256 + blue;
    }

    Public Function IsDark() -> Int
    Explain {
        Description: "Report whether the stored color is dark.";
        Input: "No parameters";
        Processing: "Compare the grayscale level with 128.";
        Output: "One when the color is dark.";
    } {
        If (This.Grayscale() < 128) { Return 1; }
        Return 0;
    }

    Public Function IsLight() -> Int
    Explain {
        Description: "Report whether the stored color is light.";
        Input: "No parameters";
        Processing: "Compare the grayscale level with 128.";
        Output: "One when the color is light.";
    } {
        If (This.Grayscale() >= 128) { Return 1; }
        Return 0;
    }

    Public Function Contrast(Int r, Int g, Int b, Int otherR, Int otherG, Int otherB) -> Int
    Explain {
        Description: "Return the contrast ratio of two colors.";
        Input: r = "First red", g = "First green", b = "First blue", otherR = "Second red", otherG = "Second green", otherB = "Second blue";
        Processing: "Divide the lighter luminance by the darker luminance.";
        Output: "The ratio rounded to an integer. Black on white is 21.";
    } {
        Int left = (r * 30 + g * 59 + b * 11) / 100;
        Int right = (otherR * 30 + otherG * 59 + otherB * 11) / 100;
        Float hi = left.ToFloat() / 255.0;
        Float lo = right.ToFloat() / 255.0;
        If (right > left) {
            hi = right.ToFloat() / 255.0;
            lo = left.ToFloat() / 255.0;
        }
        Float ratio = (hi + 0.05) / (lo + 0.05);
        Int whole = ratio.ToInt();
        If (ratio - whole.ToFloat() >= 0.5) { whole = whole + 1; }
        Return whole;
    }

    Public Function Fault() -> String
    Explain {
        Description: "Return the latest color error.";
        Input: "No parameters";
        Processing: "Read the stored error.";
        Output: "The error text.";
    } {
        Return problem;
    }

    Private Function Store(Int r, Int g, Int b, Int a) -> Int {
        red = This.Clamp(r);
        green = This.Clamp(g);
        blue = This.Clamp(b);
        alpha = This.Clamp(a);
        Int max = red;
        Int min = red;
        If (green > max) { max = green; }
        If (blue > max) { max = blue; }
        If (green < min) { min = green; }
        If (blue < min) { min = blue; }
        Int delta = max - min;
        value = max * 100 / 255;
        lightness = (max + min) * 100 / 510;
        saturation = 0;
        hue = 0;
        If (max != 0) { saturation = delta * 100 / max; }
        If (delta != 0 && max == red) {
            hue = 60 * (green - blue) / delta;
            If (hue < 0) { hue = hue + 360; }
        }
        If (delta != 0 && max != red && max == green) { hue = 120 + 60 * (blue - red) / delta; }
        If (delta != 0 && max != red && max != green) { hue = 240 + 60 * (red - green) / delta; }
        If (hue < 0) { hue = hue + 360; }
        Return red * 65536 + green * 256 + blue;
    }

    Private Function Scale(Int amount) -> Int {
        Return This.Clamp(amount * 255 / 100);
    }

    Private Function Cube(Int level) -> Int {
        If (level <= 0) { Return 0; }
        If (level == 1) { Return 95; }
        If (level == 2) { Return 135; }
        If (level == 3) { Return 175; }
        If (level == 4) { Return 215; }
        Return 255;
    }

    Private Function AnsiIndex(Int index) -> Int {
        If (index == 1 || index == 9) { Return This.Store(255, 0, 0, 255); }
        If (index == 2 || index == 10) { Return This.Store(0, 255, 0, 255); }
        If (index == 3 || index == 11) { Return This.Store(255, 255, 0, 255); }
        If (index == 4 || index == 12) { Return This.Store(0, 0, 255, 255); }
        If (index == 5 || index == 13) { Return This.Store(255, 0, 255, 255); }
        If (index == 6 || index == 14) { Return This.Store(0, 255, 255, 255); }
        If (index == 7 || index == 15) { Return This.Store(255, 255, 255, 255); }
        If (index == 8) { Return This.Store(128, 128, 128, 255); }
        Return This.Store(0, 0, 0, 255);
    }

    Private Function Pair(String text, Int index) -> Int {
        Int high = This.HexDigit(text.Substring(index, 1));
        Int low = This.HexDigit(text.Substring(index + 1, 1));
        If (high < 0 || low < 0) { Return -1; }
        Return high * 16 + low;
    }

    Private Function HexDigit(String piece) -> Int {
        If (piece == "0") { Return 0; }
        If (piece == "1") { Return 1; }
        If (piece == "2") { Return 2; }
        If (piece == "3") { Return 3; }
        If (piece == "4") { Return 4; }
        If (piece == "5") { Return 5; }
        If (piece == "6") { Return 6; }
        If (piece == "7") { Return 7; }
        If (piece == "8") { Return 8; }
        If (piece == "9") { Return 9; }
        If (piece == "a" || piece == "A") { Return 10; }
        If (piece == "b" || piece == "B") { Return 11; }
        If (piece == "c" || piece == "C") { Return 12; }
        If (piece == "d" || piece == "D") { Return 13; }
        If (piece == "e" || piece == "E") { Return 14; }
        If (piece == "f" || piece == "F") { Return 15; }
        Return -1;
    }

    Private Function ByteText(Int channel) -> String {
        String digits = "0123456789ABCDEF";
        Int high = channel / 16;
        Int low = channel % 16;
        Return digits.Substring(high, 1) + digits.Substring(low, 1);
    }

    Private Function Clamp(Int channel) -> Int {
        If (channel < 0) { Return 0; }
        If (channel > 255) { Return 255; }
        Return channel;
    }
}
