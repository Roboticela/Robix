// Tests for SignalProcessing.rx. The even ramp is 2, 4, 6, 8, 10, 12, 14, 16.

Test CreateSignal {
    Constraint: SignalDesk().CreateSignal(4) == 4;
    Processing: SignalDesk().CreateSignal(4);
    Output: 4;
}

