// Tests for Delegates.rx. Each call uses a fresh desk.

Test Create {
    Constraint: DelegateDesk().Create("Add", 0, 0, 2) == 0;
    Processing: DelegateDesk().Create("Add", 0, 0, 2);
    Output: 0;
}

Test CreateAsync {
    Constraint: DelegateDesk().CreateAsync("Run", 0, 1) == 0;
    Processing: DelegateDesk().CreateAsync("Run", 0, 1);
    Output: 0;
}

Test Bind {
    Constraint: DelegateDesk().Bind(0, 4) == -1;
    Processing: DelegateDesk().Bind(0, 4);
    Output: -1;
}

Test Invoke {
    Constraint: DelegateDesk().Invoke(0, 3) == 0;
    Processing: DelegateDesk().Invoke(0, 3);
    Output: 0;
}

Test InvokeAsync {
    Constraint: DelegateDesk().InvokeAsync(0, 3) == 0;
    Processing: DelegateDesk().InvokeAsync(0, 3);
    Output: 0;
}

