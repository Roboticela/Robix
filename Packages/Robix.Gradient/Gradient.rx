// Robix.Gradient: color stops and interpolation. Conversion stays in Robix.Color.
Package Robix.Gradient;

Import Robix.Core;
Import Robix.Color;


Class GradientDesk {
    Private Array<Int> pos;
    Private Array<Int> sr;
    Private Array<Int> sg;
    Private Array<Int> sb;
    Private Int stopCount;
    Private Int red;
    Private Int green;
    Private Int blue;
    Private String problem;

    Public Constructor() {
        pos = [0, 0, 0, 0, 0, 0, 0, 0];
        sr = [0, 0, 0, 0, 0, 0, 0, 0];
        sg = [0, 0, 0, 0, 0, 0, 0, 0];
        sb = [0, 0, 0, 0, 0, 0, 0, 0];
        stopCount = 0;
        red = 0;
        green = 0;
        blue = 0;
        problem = "none";
    }

    Public Function Stop(Int position, Int r, Int g, Int b) -> Int
    Explain {
        Description: "Add a color stop.";
        Input: position = "Position from 0 through 100", r = "Red", g = "Green", b = "Blue";
        Processing: "Append the stop.";
        Output: "The stop index, or -1 when the gradient is full.";
    } {
        If (stopCount >= 8) { Return -1; }
        pos[stopCount] = position;
        sr[stopCount] = This.Clamp(r);
        sg[stopCount] = This.Clamp(g);
        sb[stopCount] = This.Clamp(b);
        stopCount = stopCount + 1;
        Return stopCount - 1;
    }

    Public Function At(Int position) -> Int
    Explain {
        Description: "Store the color at a position.";
        Input: position = "Position from 0 through 100";
        Processing: "Interpolate the surrounding stops.";
        Output: "The packed color.";
    } {
        If (stopCount == 0) {
            problem = "empty";
            Return 0;
        }
        If (position <= pos[0]) { Return This.Paint(sr[0], sg[0], sb[0]); }
        Int index = 1;
        While (index < stopCount) {
            If (position <= pos[index]) {
                Int span = pos[index] - pos[index - 1];
                Int along = 0;
                If (span != 0) { along = (position - pos[index - 1]) * 100 / span; }
                Return This.Blend(sr[index - 1], sg[index - 1], sb[index - 1], sr[index], sg[index], sb[index], along);
            }
            index = index + 1;
        }
        Return This.Paint(sr[stopCount - 1], sg[stopCount - 1], sb[stopCount - 1]);
    }

    Public Function Linear(Int r, Int g, Int b, Int otherR, Int otherG, Int otherB, Int position) -> Int
    Explain {
        Description: "Interpolate two colors.";
        Input: r = "First red", g = "First green", b = "First blue", otherR = "Second red", otherG = "Second green", otherB = "Second blue", position = "Position from 0 through 100";
        Processing: "Blend toward the second color.";
        Output: "The packed color.";
    } {
        Return This.Blend(r, g, b, otherR, otherG, otherB, position);
    }

    Public Function Rainbow(Int position) -> Int
    Explain {
        Description: "Store a rainbow color.";
        Input: position = "Position from 0 through 100";
        Processing: "Walk the hue from red back to red.";
        Output: "The packed color.";
    } {
        Int turn = position * 360 / 100;
        While (turn >= 360) { turn = turn - 360; }
        Int sector = turn / 60;
        Int offset = turn % 60;
        Int cross = 255 * offset / 60;
        Int rest = 255 - cross;
        Int rr = 0;
        Int gg = 0;
        Int bb = 0;
        If (sector == 0) { rr = 255; gg = cross; }
        If (sector == 1) { rr = rest; gg = 255; }
        If (sector == 2) { gg = 255; bb = cross; }
        If (sector == 3) { gg = rest; bb = 255; }
        If (sector == 4) { rr = cross; bb = 255; }
        If (sector == 5) { rr = 255; bb = rest; }
        Return This.Paint(rr, gg, bb);
    }

    Public Function Clear() -> Int
    Explain {
        Description: "Remove the stops.";
        Input: "No parameters";
        Processing: "Drop every stop.";
        Output: "Zero.";
    } {
        stopCount = 0;
        Return 0;
    }

    Public Function Red() -> Int
    Explain {
        Description: "Return the stored red channel.";
        Input: "No parameters";
        Processing: "Read the latest sample.";
        Output: "Red.";
    } {
        Return red;
    }

    Public Function Green() -> Int
    Explain {
        Description: "Return the stored green channel.";
        Input: "No parameters";
        Processing: "Read the latest sample.";
        Output: "Green.";
    } {
        Return green;
    }

    Public Function Blue() -> Int
    Explain {
        Description: "Return the stored blue channel.";
        Input: "No parameters";
        Processing: "Read the latest sample.";
        Output: "Blue.";
    } {
        Return blue;
    }

    Public Function Fault() -> String
    Explain {
        Description: "Return the latest gradient error.";
        Input: "No parameters";
        Processing: "Read the stored error.";
        Output: "The error text.";
    } {
        Return problem;
    }

    Private Function Blend(Int r, Int g, Int b, Int otherR, Int otherG, Int otherB, Int position) -> Int {
        Int weight = position;
        If (weight < 0) { weight = 0; }
        If (weight > 100) { weight = 100; }
        Int rr = (r * (100 - weight) + otherR * weight) / 100;
        Int gg = (g * (100 - weight) + otherG * weight) / 100;
        Int bb = (b * (100 - weight) + otherB * weight) / 100;
        Return This.Paint(rr, gg, bb);
    }

    Private Function Paint(Int r, Int g, Int b) -> Int {
        red = This.Clamp(r);
        green = This.Clamp(g);
        blue = This.Clamp(b);
        Return red * 65536 + green * 256 + blue;
    }

    Private Function Clamp(Int channel) -> Int {
        If (channel < 0) { Return 0; }
        If (channel > 255) { Return 255; }
        Return channel;
    }
}
