// Tests for Calculus.rx. Sample shapes are 0 for x, 1 for x squared, 2 for x cubed, and 3 for the constant one.

Test Evaluate {
    Constraint: CalculusDesk().Evaluate(1, 3) == 9;
    Processing: CalculusDesk().Evaluate(1, 3);
    Output: 9;
}

