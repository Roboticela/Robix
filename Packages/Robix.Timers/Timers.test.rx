// Tests for Timers.rx. Each call uses a fresh desk.

Test SetTimeout {
    Constraint: TimerDesk().SetTimeout("tick", 5) == 0;
    Processing: TimerDesk().SetTimeout("tick", 5);
    Output: 0;
}

Test ClearTimeout {
    Constraint: TimerDesk().ClearTimeout(0) == 0;
    Processing: TimerDesk().ClearTimeout(0);
    Output: 0;
}

Test SetInterval {
    Constraint: TimerDesk().SetInterval("tick", 5) == 0;
    Processing: TimerDesk().SetInterval("tick", 5);
    Output: 0;
}

Test ClearInterval {
    Constraint: TimerDesk().ClearInterval(0) == 0;
    Processing: TimerDesk().ClearInterval(0);
    Output: 0;
}

Test SetDelay {
    Constraint: TimerDesk().SetDelay("tick", 5) == 0;
    Processing: TimerDesk().SetDelay("tick", 5);
    Output: 0;
}

Test Create {
    Constraint: TimerDesk().Create("tick", 0, 5) == 0;
    Processing: TimerDesk().Create("tick", 0, 5);
    Output: 0;
}

Test Start {
    Constraint: TimerDesk().Start(0) == 0;
    Processing: TimerDesk().Start(0);
    Output: 0;
}

Test Stop {
    Constraint: TimerDesk().Stop(0) == 0;
    Processing: TimerDesk().Stop(0);
    Output: 0;
}

Test Pause {
    Constraint: TimerDesk().Pause(0) == 0;
