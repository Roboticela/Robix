// Tests for Collections.rx. Each call uses a fresh collection.

Test Append {
    Constraint: IntList().Append(4) == 1;
    Processing: IntList().Append(4);
    Output: 1;
}

Test Insert {
    Constraint: IntList().Insert(0, 4) == 1;
    Processing: IntList().Insert(0, 4);
    Output: 1;
}

Test RemoveAt {
    Constraint: IntList().RemoveAt(0) == -1;
    Processing: IntList().RemoveAt(0);
    Output: -1;
}

Test Remove {
    Case "list" {
        Constraint: IntList().Remove(4) == 0;
