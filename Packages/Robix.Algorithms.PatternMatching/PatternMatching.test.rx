}

Test WildcardMatch {
    Constraint: PatternDesk().WildcardMatch("aabaab", "a*b") == 1;
    Processing: PatternDesk().WildcardMatch("aabaab", "a*b");
    Output: 1;
}

Test GlobMatch {
    Constraint: PatternDesk().GlobMatch("aa", "a?") == 1;
    Processing: PatternDesk().GlobMatch("aa", "a?");
    Output: 1;
}

Test RegexMatch {
    Constraint: PatternDesk().RegexMatch("aabaab", "a.b") == 0;
    Processing: PatternDesk().RegexMatch("aabaab", "a.b");
