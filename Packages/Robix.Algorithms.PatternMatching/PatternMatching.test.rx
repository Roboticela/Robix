// Tests for PatternMatching.rx. Each call uses a fresh desk.
Test Match {
    Constraint: PatternDesk().Match("aabaab", "aa") == 0;
    Processing: PatternDesk().Match("aabaab", "aa");
    Output: 0;
}

Test MatchAll {
    Constraint: PatternDesk().MatchAll("aabaab", "aa") == 2;
    Processing: PatternDesk().MatchAll("aabaab", "aa");
    Output: 2;
}

Test IsMatch {
    Constraint: PatternDesk().IsMatch("aabaab", "aa") == 1;
    Processing: PatternDesk().IsMatch("aabaab", "aa");
    Output: 1;
}

Test FindMatch {
    Constraint: PatternDesk().FindMatch("aabaab", "aa") == 0;
    Processing: PatternDesk().FindMatch("aabaab", "aa");
    Output: 0;
}

Test FindMatches {
    Constraint: PatternDesk().FindMatches("aabaab", "aa") == 2;
    Processing: PatternDesk().FindMatches("aabaab", "aa");
    Output: 2;
}

Test CountMatches {
    Constraint: PatternDesk().CountMatches("aabaab", "aa") == 2;
    Processing: PatternDesk().CountMatches("aabaab", "aa");
    Output: 2;
}

Test MatchAt {
    Constraint: PatternDesk().MatchAt("aabaab", "aa", 3) == 1;
    Processing: PatternDesk().MatchAt("aabaab", "aa", 3);
    Output: 1;
}

Test CompilePattern {
    Constraint: PatternDesk().CompilePattern("a**b") == 3;
    Processing: PatternDesk().CompilePattern("a**b");
    Output: 3;
}

Test ParsePattern {
    Constraint: PatternDesk().ParsePattern("a**b") == 4;
    Processing: PatternDesk().ParsePattern("a**b");
    Output: 4;
}

Test ValidatePattern {
    Constraint: PatternDesk().ValidatePattern("(aa)") == 1;
    Processing: PatternDesk().ValidatePattern("(aa)");
    Output: 1;
}

Test OptimizePattern {
    Constraint: PatternDesk().OptimizePattern("a**b") == 3;
    Processing: PatternDesk().OptimizePattern("a**b");
    Output: 3;
}

Test ExplainPattern {
    Constraint: PatternDesk().ExplainPattern("a*") == 4;
    Processing: PatternDesk().ExplainPattern("a*");
    Output: 4;
}

Test GetPatternCaptures {
    Constraint: PatternDesk().GetPatternCaptures("(aa)") == 1;
    Processing: PatternDesk().GetPatternCaptures("(aa)");
    Output: 1;
}

Test ExactMatch {
    Constraint: PatternDesk().ExactMatch("aabaab", "aa") == 0;
    Processing: PatternDesk().ExactMatch("aabaab", "aa");
