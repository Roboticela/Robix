// Tests for Decimal.rx. A fresh desk uses scale 2, factor 100, and half-up rounding.

Test SetScale {
    Case "two" {
        Constraint: DecimalDesk().SetScale(2) == 2;
        Processing: DecimalDesk().SetScale(2);
        Output: 2;
    }
    Case "too wide" {
        Constraint: DecimalDesk().SetScale(7) == 0;
        Processing: DecimalDesk().SetScale(7);
        Output: 0;
    }
}

Test GetScale {
    Constraint: DecimalDesk().GetScale(1) == 2;
    Processing: DecimalDesk().GetScale(1);
    Output: 2;
}

Test GetPrecision {
    Constraint: DecimalDesk().GetPrecision() == 2;
    Processing: DecimalDesk().GetPrecision();
    Output: 2;
}

Test SetPrecision {
    Constraint: DecimalDesk().SetPrecision(1) == 1;
    Processing: DecimalDesk().SetPrecision(1);
    Output: 1;
}

Test SetRoundingMode {
    Case "half even" {
        Constraint: DecimalDesk().SetRoundingMode(1) == 1;
        Processing: DecimalDesk().SetRoundingMode(1);
        Output: 1;
    }
    Case "unknown" {
        Constraint: DecimalDesk().SetRoundingMode(9) == 0;
        Processing: DecimalDesk().SetRoundingMode(9);
        Output: 0;
    }
}

Test GetRoundingMode {
    Constraint: DecimalDesk().GetRoundingMode() == 0;
    Processing: DecimalDesk().GetRoundingMode();
    Output: 0;
}

Test Add {
    Constraint: DecimalDesk().Add(2, 3) == 5;
    Processing: DecimalDesk().Add(2, 3);
    Output: 5;
}

Test Subtract {
    Constraint: DecimalDesk().Subtract(5, 2) == 3;
    Processing: DecimalDesk().Subtract(5, 2);
    Output: 3;
}

Test Multiply {
    Constraint: DecimalDesk().Multiply(10, 10) == 1;
    Processing: DecimalDesk().Multiply(10, 10);
    Output: 1;
}

Test Divide {
    Case "two" {
        Constraint: DecimalDesk().Divide(200, 100) == 200;
        Processing: DecimalDesk().Divide(200, 100);
        Output: 200;
    }
    Case "zero" {
        Constraint: DecimalDesk().Divide(1, 0) == 0;
        Processing: DecimalDesk().Divide(1, 0);
        Output: 0;
    }
}

Test Remainder {
    Constraint: DecimalDesk().Remainder(200, 100) == 0;
    Processing: DecimalDesk().Remainder(200, 100);
    Output: 0;
}

Test Modulo {
    Constraint: DecimalDesk().Modulo(200, 100) == 0;
    Processing: DecimalDesk().Modulo(200, 100);
    Output: 0;
}

Test DivRem {
    Constraint: DecimalDesk().DivRem(200, 100) == 200;
    Processing: DecimalDesk().DivRem(200, 100);
    Output: 200;
}

Test RemainderOf {
    Constraint: DecimalDesk().RemainderOf() == 0;
    Processing: DecimalDesk().RemainderOf();
    Output: 0;
}

Test Negate {
    Constraint: DecimalDesk().Negate(4) == -4;
    Processing: DecimalDesk().Negate(4);
    Output: -4;
}

Test Abs {
    Constraint: DecimalDesk().Abs(-4) == 4;
    Processing: DecimalDesk().Abs(-4);
    Output: 4;
}

Test Min {
    Constraint: DecimalDesk().Min(2, 5) == 2;
    Processing: DecimalDesk().Min(2, 5);
    Output: 2;
}

Test Max {
    Constraint: DecimalDesk().Max(2, 5) == 5;
    Processing: DecimalDesk().Max(2, 5);
    Output: 5;
}

Test Clamp {
    Constraint: DecimalDesk().Clamp(9, 1, 5) == 5;
    Processing: DecimalDesk().Clamp(9, 1, 5);
    Output: 5;
}

Test Compare {
    Constraint: DecimalDesk().Compare(2, 5) == -1;
    Processing: DecimalDesk().Compare(2, 5);
    Output: -1;
}

Test Rescale {
    Constraint: DecimalDesk().Rescale(150, 1) == 15;
    Processing: DecimalDesk().Rescale(150, 1);
    Output: 15;
}

Test Quantize {
    Constraint: DecimalDesk().Quantize(150, 1) == 150;
    Processing: DecimalDesk().Quantize(150, 1);
    Output: 150;
}

Test Normalize {
    Constraint: DecimalDesk().Normalize(150) == 15;
    Processing: DecimalDesk().Normalize(150);
    Output: 15;
}

Test StripTrailingZeros {
    Constraint: DecimalDesk().StripTrailingZeros(150) == 15;
    Processing: DecimalDesk().StripTrailingZeros(150);
    Output: 15;
}

Test Round {
    Constraint: DecimalDesk().Round(155, 1) == 160;
    Processing: DecimalDesk().Round(155, 1);
    Output: 160;
}

Test RoundToEven {
    Constraint: DecimalDesk().RoundToEven(145, 1) == 140;
    Processing: DecimalDesk().RoundToEven(145, 1);
    Output: 140;
}

Test RoundAwayFromZero {
    Constraint: DecimalDesk().RoundAwayFromZero(155, 1) == 160;
    Processing: DecimalDesk().RoundAwayFromZero(155, 1);
    Output: 160;
}

Test RoundTowardZero {
    Constraint: DecimalDesk().RoundTowardZero(155, 1) == 150;
    Processing: DecimalDesk().RoundTowardZero(155, 1);
    Output: 150;
}

Test RoundTowardPositive {
    Constraint: DecimalDesk().RoundTowardPositive(155, 1) == 160;
    Processing: DecimalDesk().RoundTowardPositive(155, 1);
    Output: 160;
}

Test RoundTowardNegative {
    Constraint: DecimalDesk().RoundTowardNegative(155, 1) == 150;
    Processing: DecimalDesk().RoundTowardNegative(155, 1);
    Output: 150;
}

Test Floor {
    Constraint: DecimalDesk().Floor(155) == 100;
    Processing: DecimalDesk().Floor(155);
    Output: 100;
}

Test Ceiling {
    Constraint: DecimalDesk().Ceiling(155) == 200;
    Processing: DecimalDesk().Ceiling(155);
    Output: 200;
}

Test Truncate {
    Constraint: DecimalDesk().Truncate(155) == 100;
    Processing: DecimalDesk().Truncate(155);
    Output: 100;
}

Test Pow {
    Case "zero" {
        Constraint: DecimalDesk().Pow(200, 0) == 100;
        Processing: DecimalDesk().Pow(200, 0);
        Output: 100;
    }
    Case "one" {
        Constraint: DecimalDesk().Pow(200, 1) == 200;
        Processing: DecimalDesk().Pow(200, 1);
        Output: 200;
    }
}

Test Sqrt {
    Case "four" {
        Constraint: DecimalDesk().Sqrt(400) == 200;
        Processing: DecimalDesk().Sqrt(400);
        Output: 200;
    }
    Case "negative" {
        Constraint: DecimalDesk().Sqrt(-1) == 0;
        Processing: DecimalDesk().Sqrt(-1);
        Output: 0;
    }
}

Test Gcd {
    Constraint: DecimalDesk().Gcd(12, 8) == 4;
    Processing: DecimalDesk().Gcd(12, 8);
    Output: 4;
}

Test Lcm {
    Constraint: DecimalDesk().Lcm(4, 6) == 12;
    Processing: DecimalDesk().Lcm(4, 6);
    Output: 12;
}

Test Parse {
    Case "one and a half" {
        Constraint: DecimalDesk().Parse("1.5") == 150;
        Processing: DecimalDesk().Parse("1.5");
        Output: 150;
    }
    Case "empty" {
        Constraint: DecimalDesk().Parse("") == 0;
        Processing: DecimalDesk().Parse("");
        Output: 0;
    }
}

Test TryParse {
    Constraint: DecimalDesk().TryParse("2") == 200;
    Processing: DecimalDesk().TryParse("2");
    Output: 200;
}

Test FromInteger {
    Constraint: DecimalDesk().FromInteger(3) == 300;
    Processing: DecimalDesk().FromInteger(3);
    Output: 300;
}

Test ToInteger {
    Constraint: DecimalDesk().ToInteger(250) == 2;
    Processing: DecimalDesk().ToInteger(250);
    Output: 2;
}

Test ToInt32 {
    Constraint: DecimalDesk().ToInt32(250) == 2;
    Processing: DecimalDesk().ToInt32(250);
    Output: 2;
}

Test ToInt64 {
    Constraint: DecimalDesk().ToInt64(250) == 2;
    Processing: DecimalDesk().ToInt64(250);
    Output: 2;
}

Test SimpleInterest {
    Constraint: DecimalDesk().SimpleInterest(10000, 500, 1) == 500;
    Processing: DecimalDesk().SimpleInterest(10000, 500, 1);
    Output: 500;
}

Test CompoundInterest {
    Constraint: DecimalDesk().CompoundInterest(10000, 0, 1) == 0;
    Processing: DecimalDesk().CompoundInterest(10000, 0, 1);
    Output: 0;
}

Test CalculateInterest {
    Constraint: DecimalDesk().CalculateInterest(10000, 500, 1) == 500;
    Processing: DecimalDesk().CalculateInterest(10000, 500, 1);
    Output: 500;
}

Test CalculateDiscount {
    Constraint: DecimalDesk().CalculateDiscount(200, 10) == 20;
    Processing: DecimalDesk().CalculateDiscount(200, 10);
    Output: 20;
}

Test CalculateTax {
    Constraint: DecimalDesk().CalculateTax(200, 10) == 20;
    Processing: DecimalDesk().CalculateTax(200, 10);
    Output: 20;
}

Test CalculatePercentage {
    Constraint: DecimalDesk().CalculatePercentage(200, 10) == 20;
    Processing: DecimalDesk().CalculatePercentage(200, 10);
    Output: 20;
}

Test CalculatePercentageChange {
    Case "rise" {
        Constraint: DecimalDesk().CalculatePercentageChange(100, 150) == 50;
        Processing: DecimalDesk().CalculatePercentageChange(100, 150);
        Output: 50;
    }
    Case "zero base" {
        Constraint: DecimalDesk().CalculatePercentageChange(0, 1) == 0;
        Processing: DecimalDesk().CalculatePercentageChange(0, 1);
        Output: 0;
    }
}

Test CalculateInstallment {
    Constraint: DecimalDesk().CalculateInstallment(200, 0, 4) == 50;
    Processing: DecimalDesk().CalculateInstallment(200, 0, 4);
    Output: 50;
}

Test PresentValue {
    Constraint: DecimalDesk().PresentValue(100, 0, 1) == 100;
    Processing: DecimalDesk().PresentValue(100, 0, 1);
    Output: 100;
}

Test FutureValue {
    Constraint: DecimalDesk().FutureValue(100, 0, 1) == 100;
    Processing: DecimalDesk().FutureValue(100, 0, 1);
    Output: 100;
}

Test Fault {
    Constraint: DecimalDesk().Fault() == "none";
    Processing: DecimalDesk().Fault();
    Output: "none";
}

Test DivideScaled {
    Constraint: DecimalDesk().DivideScaled(250, 100) == 3;
    Processing: DecimalDesk().DivideScaled(250, 100);
    Output: 3;
}

Test Digit {
    Constraint: DecimalDesk().Digit("4") == 4;
    Processing: DecimalDesk().Digit("4");
    Output: 4;
}
