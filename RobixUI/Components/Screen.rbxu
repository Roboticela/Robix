<Component Name="Screen">
  <Attribute Name="id" Type="String"/>
  <Attribute Name="path" Type="String" Default="/" Aliases="route"/>
  <Attribute Name="name" Type="String" Default="" Aliases="title"/>
  <Attribute Name="theme" Type="Enum" Values="dark|light" Default="dark" Aliases="appearance"/>
  <Attribute Name="transparent" Type="Bool" Default="false" Aliases="transparency"/>
  <Attribute Name="place" Type="Enum" Values="center|top|bottom|left|right|top-left|top-right|bottom-left|bottom-right|absolute" Default="center"/>
  <Attribute Name="x" Type="Int" Default="0"/>
  <Attribute Name="y" Type="Int" Default="0"/>
  <Attribute Name="width" Type="Int" Default="640"/>
  <Attribute Name="height" Type="Int" Default="400"/>
  <Attribute Name="minWidth" Type="Int" Default="320"/>
  <Attribute Name="minHeight" Type="Int" Default="200"/>
  <Attribute Name="maxWidth" Type="Int" Default="1920"/>
  <Attribute Name="maxHeight" Type="Int" Default="1080"/>
  <Attribute Name="minSize" Type="String"/>
  <Attribute Name="maxSize" Type="String"/>
  <Attribute Name="radius" Type="Token" Default="radius-lg"/>
  <Attribute Name="foundation" Type="String"/>
  <Attribute Name="contentWidth" Type="Token"/>
  <Attribute Name="gutter" Type="Token"/>
  <Attribute Name="border" Type="Int" Default="0"/>
  <Attribute Name="overflow" Type="Enum" Values="visible|hidden|clip|scroll|auto" Default="visible"/>
  <Attribute Name="overflowX" Type="Enum" Values="visible|hidden|clip|scroll|auto" Aliases="overflow-x"/>
  <Attribute Name="overflowY" Type="Enum" Values="visible|hidden|clip|scroll|auto" Aliases="overflow-y"/>
  <Attribute Name="clip" Type="Bool" Default="false"/>
  <Attribute Name="background" Type="Color" Aliases="backgroundColor|bg"/>
  <Attribute Name="borderColor" Type="Color"/>
  <Attribute Name="display" Type="Enum" Values="flex|grid|stack" Default="flex"/>
  <Attribute Name="direction" Type="Enum" Values="row|column|row-reverse|column-reverse" Default="column" Aliases="flexDirection"/>
  <Attribute Name="justify" Type="Enum" Values="start|center|end|space-between|space-around|space-evenly" Default="start" Aliases="justifyContent"/>
  <Attribute Name="align" Type="Enum" Values="start|center|end|stretch" Default="stretch" Aliases="alignItems"/>
  <Attribute Name="gap" Type="Int" Default="0"/>
  <Attribute Name="padding" Type="Int" Default="0"/>
  <Attribute Name="columns" Type="Int" Default="1"/>
  <Attribute Name="rows" Type="Int"/>
  <Attribute Name="wrap" Type="Enum" Values="wrap|nowrap" Default="nowrap" Aliases="flexWrap"/>
  <Attribute Name="alignContent" Type="Enum" Values="start|center|end|space-between|space-around|space-evenly" Default="start"/>
  <Attribute Name="justifyItems" Type="Enum" Values="start|center|end|stretch" Default="stretch"/>
  <Attribute Name="position" Type="Enum" Values="relative|absolute|fixed" Default="relative"/>
  <Attribute Name="inset" Type="String"/>
  <Attribute Name="left" Type="Int"/>
  <Attribute Name="top" Type="Int"/>
  <Attribute Name="right" Type="Int"/>
  <Attribute Name="bottom" Type="Int"/>
  <Attribute Name="margin" Type="Int"/>
  <Attribute Name="alignSelf" Type="Enum" Values="auto|start|center|end|stretch" Default="auto"/>
  <Attribute Name="order" Type="Int" Default="0"/>
  <Attribute Name="gridColumn" Type="String"/>
  <Attribute Name="gridRow" Type="String"/>
  <Attribute Name="grow" Type="Int" Default="0" Aliases="flex|flexGrow"/>
  <Attribute Name="state" Type="Enum" Values="normal|minimized|maximized|closed" Default="normal"/>
  <Attribute Name="resizable" Type="String" Default="true"/>
  <Attribute Name="resize" Type="String"/>
  <Attribute Name="noResize" Type="String" Aliases="resizeDisabled"/>
  <Attribute Name="resizeLeft" Type="Bool"/>
  <Attribute Name="resizeRight" Type="Bool"/>
  <Attribute Name="resizeTop" Type="Bool"/>
  <Attribute Name="resizeBottom" Type="Bool"/>
  <Attribute Name="resizeTopLeft" Type="Bool"/>
  <Attribute Name="resizeTopRight" Type="Bool"/>
  <Attribute Name="resizeBottomLeft" Type="Bool"/>
  <Attribute Name="resizeBottomRight" Type="Bool"/>
  <Attribute Name="movable" Type="Bool" Default="true"/>
  <Attribute Name="topmost" Type="Bool" Default="false" Aliases="alwaysOnTop"/>
  <Attribute Name="fullscreen" Type="Bool" Default="false"/>
  <Attribute Name="board" Type="String"/>
  <Child Name="*" Max="64"/>
</Component>
