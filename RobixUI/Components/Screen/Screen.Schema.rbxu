<!-- Screen — a page (/login on the web, a borderless surface on RoboticelaOS unless border is set). -->
<Component name="Screen">
  <Attribute name="id" type="string" required="false" />
  <Attribute name="path" type="string" default="/" aliases="route" />
  <Attribute name="name" type="string" default="" aliases="title" />
  <Attribute name="theme" type="enum" values="dark|light" default="dark" aliases="appearance" />
  <Attribute name="transparent" type="bool" default="false" aliases="transparency" />
  <Attribute name="place" type="enum"
             values="center|top|bottom|left|right|top-left|top-right|bottom-left|bottom-right|absolute"
             default="center" />
  <Attribute name="x" type="int" default="0" />
  <Attribute name="y" type="int" default="0" />
  <Attribute name="width" type="int" default="640" />
  <Attribute name="height" type="int" default="400" />
  <Attribute name="minWidth" type="int" default="320" />
  <Attribute name="minHeight" type="int" default="200" />
  <Attribute name="maxWidth" type="int" default="1920" />
  <Attribute name="maxHeight" type="int" default="1080" />
  <Attribute name="minSize" type="string" required="false" description="width height, or one number for both" />
  <Attribute name="maxSize" type="string" required="false" />
  <Attribute name="radius" type="token" default="radius-lg" />
  <Attribute name="foundation" type="string" required="false" />
  <Attribute name="contentWidth" type="token" required="false" />
  <Attribute name="gutter" type="token" required="false" />
  <Attribute name="border" type="int" default="0" />
  <Attribute name="overflow" type="enum" values="visible|hidden|clip|scroll|auto" default="visible" />
  <Attribute name="overflowX" type="enum" values="visible|hidden|clip|scroll|auto" required="false"
             aliases="overflow-x" />
  <Attribute name="overflowY" type="enum" values="visible|hidden|clip|scroll|auto" required="false"
             aliases="overflow-y" />
  <Attribute name="clip" type="bool" default="false" />
  <Attribute name="background" type="color" required="false" aliases="backgroundColor|bg" />
  <Attribute name="borderColor" type="color" required="false" />
  <Attribute name="display" type="enum" values="flex|grid|stack" default="flex" />
  <Attribute name="direction" type="enum" values="row|column|row-reverse|column-reverse" default="column"
             aliases="flexDirection" />
  <Attribute name="justify" type="enum"
             values="start|center|end|space-between|space-around|space-evenly" default="start"
             aliases="justifyContent" />
  <Attribute name="align" type="enum" values="start|center|end|stretch" default="stretch" aliases="alignItems" />
  <Attribute name="gap" type="int" default="0" />
  <Attribute name="padding" type="int" default="0" />
  <Attribute name="columns" type="int" default="1" />
  <Attribute name="rows" type="int" required="false" />
  <Attribute name="wrap" type="enum" values="wrap|nowrap" default="nowrap" aliases="flexWrap" />
  <Attribute name="alignContent" type="enum"
             values="start|center|end|space-between|space-around|space-evenly" default="start" />
  <Attribute name="justifyItems" type="enum" values="start|center|end|stretch" default="stretch" />
  <Attribute name="position" type="enum" values="relative|absolute|fixed" default="relative" />
  <Attribute name="inset" type="string" required="false" />
  <Attribute name="left" type="int" required="false" />
  <Attribute name="top" type="int" required="false" />
  <Attribute name="right" type="int" required="false" />
  <Attribute name="bottom" type="int" required="false" />
  <Attribute name="margin" type="int" required="false" />
  <Attribute name="alignSelf" type="enum" values="auto|start|center|end|stretch" default="auto" />
  <Attribute name="order" type="int" default="0" />
  <Attribute name="gridColumn" type="string" required="false" />
  <Attribute name="gridRow" type="string" required="false" />
  <Attribute name="grow" type="int" default="0" aliases="flex|flexGrow" />
  <Attribute name="state" type="enum" values="normal|minimized|maximized|closed" default="normal" />
  <Attribute name="resizable" type="string" default="true"
             description="true, false, or sides: left, right, top, bottom, top-left, top-right, bottom-left, bottom-right" />
  <Attribute name="resize" type="string" required="false" description="sides and corners that stay resizable" />
  <Attribute name="noResize" type="string" required="false" aliases="resizeDisabled"
             description="sides or corners to lock, for example top, top-left" />
  <Attribute name="resizeLeft" type="bool" required="false" />
  <Attribute name="resizeRight" type="bool" required="false" />
  <Attribute name="resizeTop" type="bool" required="false" />
  <Attribute name="resizeBottom" type="bool" required="false" />
  <Attribute name="resizeTopLeft" type="bool" required="false" />
  <Attribute name="resizeTopRight" type="bool" required="false" />
  <Attribute name="resizeBottomLeft" type="bool" required="false" />
  <Attribute name="resizeBottomRight" type="bool" required="false" />
  <Attribute name="movable" type="bool" default="true" />
  <Attribute name="topmost" type="bool" default="false" aliases="alwaysOnTop" />
  <Attribute name="fullscreen" type="bool" default="false" />
  <Attribute name="board" type="string" required="false" description="Board id this screen displays" />
  <Child name="*" max="64" description="content laid out with flex, grid, or stack" />
</Component>
