package Robix.UI;

import Robix.UI.Behaviors.Press;
import Robix.UI.Behaviors.Focus;

public class Button {
  public Press press = new Press();
  public Focus focus = new Focus();
  public Void OnClick() {}
  public Void OnPointerDown() { this.press.OnPointerDown(); }
  public Void OnPointerUp() { this.press.OnPointerUp(); }
  public Void OnFocus() { this.focus.OnFocus(); }
  public Void OnBlur() { this.focus.OnBlur(); }
  public Void OnKeyDown() {}
  public Void OnKeyUp() {}
}
