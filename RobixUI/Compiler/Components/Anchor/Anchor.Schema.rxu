<!--
  Anchor — RefCode/WebRef/components/Anchor.tsx
  A text link. Same destinations, icons, and states as Button. The face is a link, not a pill.
  Variants: inline, subtle, underline, plain, standalone, arrow, more.
  more is the home text link: brand text and a sliding arrow.
-->
<Component name="Anchor">
  <Attribute name="id" type="string" required="false" />
  <Attribute name="variant" type="enum" values="inline|subtle|underline|plain|standalone|arrow|more" default="inline" />
  <Attribute name="size" type="enum" values="inherit|sm|md|lg" default="inherit" />
  <Attribute name="tone" type="enum" values="brand|danger" default="brand" />
  <Attribute name="arrow" type="enum" values="end|start" required="false" />
  <Attribute name="external" type="enum" values="auto|true|false" default="auto" />
  <Attribute name="target" type="string" required="false" />
  <Attribute name="rel" type="string" required="false" />
  <Attribute name="leading" type="string" required="false" />
  <Attribute name="trailing" type="string" required="false" />
  <Attribute name="preview" type="enum" values="hover|focus|active|visited" required="false" />
  <Attribute name="disabled" type="bool" default="false" />
  <Attribute name="type" type="enum" values="button|submit|reset" default="button" />
  <Attribute name="content" type="string" required="false" />
  <Attribute name="path" type="string" required="false" aliases="route,href,screen" />
  <Child name="Icon" max="2" />
  <Child name="Svg" max="2" />
</Component>
