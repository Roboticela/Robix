<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scrollbar — chrome tokens (owned by ScrollView). Prefer setting arrows/autoHide on <ScrollView>.
-->
<Component name="Scrollbar">
  <Attribute name="orientation" type="enum" values="vertical|horizontal" default="vertical" />
  <Attribute name="arrows" type="enum" values="off|hover|always" default="hover" />
  <Attribute name="autoHide" type="bool" default="true" />
  <Attribute name="overlay" type="bool" default="true" />
  <Attribute name="thickness" type="int" default="6" />
  <Attribute name="thumbColor" type="color" required="false" />
  <Attribute name="trackColor" type="color" required="false" />
  <Attribute name="position" type="enum" values="relative|absolute|fixed" default="relative" />
  <Attribute name="margin" type="int" required="false" />
  <Attribute name="flex" type="int" required="false" aliases="flexGrow|grow" />
  <Attribute name="alignSelf" type="enum" values="auto|start|center|end|stretch" default="auto" />
  <Attribute name="order" type="int" default="0" />
  <Attribute name="gridColumn" type="string" required="false" />
  <Attribute name="gridRow" type="string" required="false" />
</Component>
