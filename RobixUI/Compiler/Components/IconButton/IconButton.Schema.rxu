<!--
  IconButton — RefCode/Components/components/IconButton.tsx
  Variants: ghost, subtle, outline, primary, danger.
  Sizes: sm, md.
  Status: idle, loading, success, error.
-->
<Component name="IconButton">
  <Attribute name="id" type="string" required="false" />
  <Attribute name="label" type="string" required="true" />
  <Attribute name="icon" type="string" required="false" />
  <Attribute name="variant" type="enum" values="ghost|subtle|outline|primary|danger" default="ghost" />
  <Attribute name="size" type="enum" values="sm|md" default="md" />
  <Attribute name="badge" type="string" required="false" />
  <Attribute name="loading" type="bool" default="false" />
  <Attribute name="status" type="enum" values="idle|loading|success|error" required="false" />
  <Attribute name="action" type="string" required="false" />
  <Attribute name="successMs" type="int" default="1600" />
  <Attribute name="disabled" type="bool" default="false" />
  <Attribute name="title" type="string" required="false" />
  <Child name="Icon" max="1" />
  <Child name="Svg" max="1" />
</Component>
