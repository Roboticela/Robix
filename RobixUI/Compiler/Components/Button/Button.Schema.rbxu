<?xml version="1.0" encoding="UTF-8"?>
<!--
  Button — RefCode/Components/components/Button.tsx
  Variants: primary, secondary, action, ghost, danger.
  Sizes: sm, md, lg.
  States: rest, hover, focus, active, disabled, loading.
-->
<Component name="Button">
  <Attribute name="id" type="string" required="false" />
  <Attribute name="variant" type="enum" values="primary|secondary|action|ghost|danger" default="primary" />
  <Attribute name="size" type="enum" values="sm|md|lg" default="md" />
  <Attribute name="fullWidth" type="bool" default="true" />
  <Attribute name="loading" type="bool" default="false" />
  <Attribute name="loadingText" type="string" required="false" />
  <Attribute name="leading" type="string" required="false" />
  <Attribute name="trailing" type="string" required="false" />
  <Attribute name="preview" type="enum" values="hover|focus|active" required="false" />
  <Attribute name="disabled" type="bool" default="false" />
  <Attribute name="type" type="enum" values="button|submit|reset" default="button" />
  <Attribute name="content" type="string" required="false" />
  <Attribute name="path" type="string" required="false" aliases="route,href,screen" />
  <Child name="Icon" max="2" />
  <Child name="Svg" max="2" />
</Component>
