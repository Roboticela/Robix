<Component Name="Text">
  <Attribute Name="id" Type="String"/>
  <Attribute Name="variant" Type="Enum" Values="display|h1|h2|h3|h4|h5|h6|subhead|content|content-sm|body|body-sm|caption|eyebrow|label" Default="content"/>
  <Attribute Name="tone" Type="Enum" Values="primary|secondary|tertiary|disabled|link|danger|success|warning|on-brand"/>
  <Attribute Name="x" Type="Int" Default="0"/>
  <Attribute Name="y" Type="Int" Default="0"/>
  <Attribute Name="width" Type="Int"/>
  <Attribute Name="height" Type="Int"/>
  <Attribute Name="maxWidth" Type="Size"/>
  <Attribute Name="minWidth" Type="Size"/>
  <Attribute Name="minHeight" Type="Size"/>
  <Attribute Name="maxHeight" Type="Size"/>
  <Attribute Name="minSize" Type="String"/>
  <Attribute Name="maxSize" Type="String"/>
  <Attribute Name="size" Type="String"/>
  <Attribute Name="align" Type="Enum" Values="start|center|end|left|right" Default="start"/>
  <Attribute Name="wrap" Type="Enum" Values="none|char|word" Default="word"/>
  <Attribute Name="color" Type="Color"/>
  <Attribute Name="font" Type="String"/>
  <Attribute Name="content" Type="String"/>
  <Attribute Name="position" Type="Enum" Values="relative|absolute|fixed" Default="relative"/>
  <Attribute Name="inset" Type="String"/>
  <Attribute Name="left" Type="Int"/>
  <Attribute Name="top" Type="Int"/>
  <Attribute Name="right" Type="Int"/>
  <Attribute Name="bottom" Type="Int"/>
  <Attribute Name="margin" Type="Int"/>
  <Attribute Name="flex" Type="Int" Aliases="flexGrow|grow"/>
  <Attribute Name="flexShrink" Type="Int" Aliases="shrink"/>
  <Attribute Name="alignSelf" Type="Enum" Values="auto|start|center|end|stretch" Default="auto"/>
  <Attribute Name="alignItems" Type="Enum" Values="start|center|end|stretch"/>
  <Attribute Name="order" Type="Int" Default="0"/>
  <Attribute Name="display" Type="Enum" Values="flex|grid|stack|canvas"/>
  <Attribute Name="direction" Type="Enum" Values="row|column|row-reverse|column-reverse" Aliases="flexDirection"/>
  <Attribute Name="justify" Type="Enum" Values="start|center|end|space-between|space-around|space-evenly" Aliases="justifyContent"/>
  <Attribute Name="justifyItems" Type="Enum" Values="start|center|end|stretch"/>
  <Attribute Name="columns" Type="Int"/>
  <Attribute Name="rows" Type="Int"/>
  <Attribute Name="gap" Type="Int"/>
  <Attribute Name="gridColumn" Type="String"/>
  <Attribute Name="gridRow" Type="String"/>
  <Child Name="Span" Max="48">
    <Attribute Name="size" Type="Int"/>
    <Attribute Name="color" Type="Color"/>
    <Attribute Name="content" Type="String"/>
    <Attribute Name="font" Type="String"/>
  </Child>
</Component>
