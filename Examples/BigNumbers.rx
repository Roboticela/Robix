// Robix.BigNumbers: base-1000 integers, powers, and factorials.
Package Robotics.BigNumbers;

Import Robix.Core;
Import Robix.BigNumbers;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Exercise big integers and rationals.";
    Input: args = "Command-line arguments";
    Processing: "Call the big-number desk.";
    Output: "The big-number report.";
} {
    BigNumbersDesk desk = BigNumbersDesk();
    Print(desk.FromInt(3628800));
    Print(desk.Limb(0));
    Print(desk.Add(20, 22));
    Print(desk.Subtract(50, 8));
    Print(desk.Multiply(12, 12));
    Print(desk.Divide(84, 2));
    Print(desk.DivRem(17, 5));
    Print(desk.Remainder(17, 5));
    Print(desk.Mod(-3, 5));
    Print(desk.Pow(2, 10));
    Print(desk.PowMod(2, 10, 1000));
    Print(desk.Sqrt(144));
    Print(desk.Cbrt(27));
    Print(desk.Gcd(48, 18));
    Print(desk.Lcm(4, 6));
    Print(desk.Factorial(10));
    Print(desk.Binomial(5, 2));
    Print(desk.IsPrime(17));
    Print(desk.NextPrime(14));
    Print(desk.PreviousPrime(18));
    Print(desk.ModInverse(3, 7));
    Print(desk.ExtendedGcd(48, 18));
    Print(desk.Bezout(0));
    Print(desk.BitLength(13));
    Print(desk.PopulationCount(13));
    Print(desk.IsPowerOfTwo(16));
    Print(desk.And(6, 3));
    Print(desk.Or(6, 3));
    Print(desk.Xor(6, 3));
    Print(desk.ShiftLeft(3, 2));
    Print(desk.ShiftRight(13, 1));
    Print(desk.TestBit(13, 0));
    Print(desk.CreateRational(2, 4));
    Print(desk.Denominator());
    Print(desk.AddRational(1, 2, 1, 3));
    Print(desk.Denominator());
    Print(desk.SubtractRational(1, 2, 1, 3));
    Print(desk.MultiplyRational(1, 2, 2, 3));
    Print(desk.DivideRational(1, 2, 2, 3));
    Print(desk.ParseBigInteger("3628800"));
    Print(desk.TryParseBigInteger("-12"));
    Print(desk.ToDecimalString(42));
    Print(desk.Fault());
    Return 0;
}
