// Robix.Console.Screen: cursor, screen size, title, and capability flags.
Package Robotics.Screen;

Import Robix.Core;


Class ScreenDesk {
    Private Int column;
    Private Int row;
    Private Int width;
    Private Int height;
    Private Int visible;
    Private Int cleared;
    Private Int trueColor;
    Private String title;
    Private String problem;

    Public Constructor() {
        column = 0;
        row = 0;
        width = 80;
        height = 24;
        visible = 1;
        cleared = 0;
        trueColor = 1;
        title = "Robix";
        problem = "none";
    }

    Public Function Move(Int nextColumn, Int nextRow) -> Int
    Explain {
        Description: "Move the cursor.";
        Input: nextColumn = "Column", nextRow = "Row";
        Processing: "Keep the cursor inside the window.";
        Output: "One when the position is stored.";
    } {
        If (nextColumn < 0 || nextRow < 0 || nextColumn >= width || nextRow >= height) {
            problem = "range";
            Return 0;
        }
        column = nextColumn;
        row = nextRow;
        Return 1;
    }

    Public Function Column() -> Int
    Explain {
        Description: "Return the cursor column.";
        Input: "No parameters";
        Processing: "Read the cursor.";
        Output: "The column.";
    } {
        Return column;
    }

    Public Function Row() -> Int
    Explain {
        Description: "Return the cursor row.";
        Input: "No parameters";
        Processing: "Read the cursor.";
        Output: "The row.";
    } {
        Return row;
    }

    Public Function Home() -> Int
    Explain {
        Description: "Move the cursor home.";
        Input: "No parameters";
        Processing: "Set the cursor to the origin.";
        Output: "One.";
    } {
        column = 0;
        row = 0;
        Return 1;
    }

    Public Function Hide() -> Int
    Explain {
        Description: "Hide the cursor.";
        Input: "No parameters";
        Processing: "Store the hidden state.";
        Output: "Zero.";
    } {
        visible = 0;
        Return 0;
    }

    Public Function Show() -> Int
    Explain {
        Description: "Show the cursor.";
        Input: "No parameters";
        Processing: "Store the visible state.";
        Output: "One.";
    } {
        visible = 1;
        Return 1;
    }

    Public Function Visible() -> Int
    Explain {
        Description: "Return whether the cursor is visible.";
        Input: "No parameters";
        Processing: "Read the cursor state.";
        Output: "One when the cursor is visible.";
    } {
        Return visible;
    }

    Public Function Clear() -> Int
    Explain {
        Description: "Clear the screen.";
        Input: "No parameters";
        Processing: "Mark the screen clear and move home.";
        Output: "One.";
    } {
        cleared = 1;
        column = 0;
        row = 0;
        Return 1;
    }

    Public Function Cleared() -> Int
    Explain {
        Description: "Return whether the screen was cleared.";
        Input: "No parameters";
        Processing: "Read the clear flag.";
        Output: "One after a clear.";
    } {
        Return cleared;
    }

    Public Function Size(Int nextWidth, Int nextHeight) -> Int
    Explain {
        Description: "Set the window size.";
        Input: nextWidth = "Width", nextHeight = "Height";
        Processing: "Store a positive size.";
        Output: "One when the size is stored.";
    } {
        If (nextWidth <= 0 || nextHeight <= 0) {
            problem = "range";
            Return 0;
        }
        width = nextWidth;
        height = nextHeight;
        If (column >= width) { column = width - 1; }
        If (row >= height) { row = height - 1; }
        Return 1;
    }

    Public Function Width() -> Int
    Explain {
        Description: "Return the window width.";
        Input: "No parameters";
        Processing: "Read the width.";
        Output: "The width.";
    } {
        Return width;
    }

    Public Function Height() -> Int
    Explain {
        Description: "Return the window height.";
        Input: "No parameters";
        Processing: "Read the height.";
        Output: "The height.";
    } {
        Return height;
    }

    Public Function SetTitle(String text) -> Int
    Explain {
        Description: "Set the window title.";
        Input: text = "Title";
        Processing: "Store the title.";
        Output: "The title length.";
    } {
        title = text;
        Return title.Length();
    }

    Public Function Title() -> String
    Explain {
        Description: "Return the window title.";
        Input: "No parameters";
        Processing: "Read the title.";
        Output: "The title.";
    } {
        Return title;
    }

    Public Function SetTrueColor(Int enabled) -> Int
    Explain {
        Description: "Set true-color support.";
        Input: enabled = "One when the terminal supports 24-bit color";
        Processing: "Store the capability.";
        Output: "The capability.";
    } {
        trueColor = 0;
        If (enabled != 0) { trueColor = 1; }
        Return trueColor;
    }

    Public Function SupportsTrueColor() -> Int
    Explain {
        Description: "Report true-color support.";
        Input: "No parameters";
        Processing: "Read the capability.";
        Output: "One when true color is supported.";
    } {
        Return trueColor;
    }

    Public Function SupportsColor() -> Int
    Explain {
        Description: "Report color support.";
        Input: "No parameters";
        Processing: "Basic color remains available.";
        Output: "One.";
    } {
        Return 1;
    }

    Public Function CursorSequence() -> String
    Explain {
        Description: "Return the cursor-move sequence.";
        Input: "No parameters";
        Processing: "Use a one-based terminal position.";
        Output: "The sequence.";
    } {
        String esc = "\u001b";
        Return esc + "[" + This.IntText(row + 1) + ";" + This.IntText(column + 1) + "H";
    }

    Public Function Fault() -> String
    Explain {
        Description: "Return the latest screen error.";
        Input: "No parameters";
        Processing: "Read the stored error.";
        Output: "The error text.";
    } {
        Return problem;
    }

    Private Function IntText(Int value) -> String {
        If (value <= 0) { Return "0"; }
        Int remainingValue = value;
        String digits = "0123456789";
        String built = "";
        While (remainingValue > 0) {
            Int digit = remainingValue % 10;
            built = digits.Substring(digit, 1) + built;
            remainingValue = remainingValue / 10;
        }
        Return built;
    }
}


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Move the cursor and describe the window.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the screen desk.";
    Output: "The screen report.";
} {
    ScreenDesk desk = ScreenDesk();
    Print(desk.Width());
    Print(desk.Height());
    Print(desk.Move(3, 4));
    Print(desk.Column());
    Print(desk.Row());
    Print(desk.CursorSequence());
    Print(desk.Clear());
    Print(desk.Column());
    Print(desk.Cleared());
    Print(desk.SetTitle("Robix"));
    Print(desk.Title());
    Print(desk.SupportsColor());
    Print(desk.SupportsTrueColor());
    Print(desk.SetTrueColor(0));
    Print(desk.SupportsTrueColor());
    Print(desk.Hide());
    Print(desk.Visible());
    Print(desk.Show());
    Print(desk.Fault());
    Return 0;
}
