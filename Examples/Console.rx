Package Robotics.Console;

Import Robix.Console;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Write plain and colored console text.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the console desk.";
    Output: "The console report.";
} {
    ConsoleDesk desk = ConsoleDesk();
    Print(desk.WriteLine("Welcome"));
    Print(desk.WriteSuccess("started"));
    Print(desk.WriteWarning("careful"));
    Print(desk.WriteError("failed"));
    Print(desk.Transcript());
    Print(desk.ClearOutput());
    Print(desk.UseColor(1));
    Print(desk.WriteColored("Robix", 255, 87, 51));
    Print(desk.Transcript());
    Print(desk.Fault());
    Return 0;
}
