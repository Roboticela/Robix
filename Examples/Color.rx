Package Robotics.Color;

Import Robix.Color;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Convert and mix colors.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the color desk.";
    Output: "The color report.";
} {
    ColorDesk desk = ColorDesk();
    Print(desk.Rgb(255, 100, 50));
    Print(desk.Red());
    Print(desk.Green());
    Print(desk.Blue());
    Print(desk.Hex("#FF5733"));
    Print(desk.Red());
    Print(desk.Green());
    Print(desk.Blue());
    Print(desk.ToHex());
    Print(desk.FromAnsi("red"));
    Print(desk.Hue());
    Print(desk.Saturation());
    Print(desk.Value());
    Print(desk.Lightness());
    Print(desk.FromHsv(120, 100, 100));
    Print(desk.Red());
    Print(desk.Green());
    Print(desk.Blue());
    Print(desk.FromHsl(0, 100, 50));
    Print(desk.Red());
    Print(desk.Green());
    Print(desk.Blue());
    Print(desk.FromCmyk(0, 100, 100, 0));
    Print(desk.ToHex());
    Print(desk.From256(196));
    Print(desk.ToHex());
    Print(desk.Rgb(255, 255, 255));
    Print(desk.Darken(50));
    Print(desk.Red());
    Print(desk.Rgb(0, 0, 0));
    Print(desk.Lighten(50));
    Print(desk.Red());
    Print(desk.Rgb(255, 0, 0));
    Print(desk.Invert());
    Print(desk.ToHex());
    Print(desk.Rgb(255, 0, 0));
    Print(desk.Grayscale());
    Print(desk.IsDark());
    Print(desk.Rgb(255, 255, 255));
    Print(desk.IsLight());
    Print(desk.Contrast(0, 0, 0, 255, 255, 255));
    Print(desk.Rgba(10, 20, 30, 128));
    Print(desk.Alpha());
    Print(desk.Fault());
    Return 0;
}
