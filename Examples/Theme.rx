Package Robotics.Theme;

Import Robix.Theme;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Apply shared color themes.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the theme desk.";
    Output: "The theme report.";
} {
    ThemeDesk desk = ThemeDesk();
    Print(desk.Apply("dark"));
    Print(desk.Active());
    Print(desk.RoleRed("primary"));
    Print(desk.RoleGreen("primary"));
    Print(desk.RoleBlue("primary"));
    Print(desk.RoleRed("error"));
    Print(desk.RoleGreen("error"));
    Print(desk.RoleBlue("error"));
    Print(desk.RoleRed("background"));
    Print(desk.RoleRed("text"));
    Print(desk.Apply("light"));
    Print(desk.RoleRed("background"));
    Print(desk.RoleRed("text"));
    Print(desk.Apply("unknown"));
    Print(desk.Fault());
    Return 0;
}
