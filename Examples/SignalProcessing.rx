// Robix.Math.SignalProcessing: eight-sample waves, integer filters, and Walsh-Hadamard spectra.
Package Robotics.SignalProcessing;

Import Robix.Core;
Import Robix.Math.SignalProcessing;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Exercise waves, filters, and spectra.";
    Input: args = "Command-line arguments";
    Processing: "Call the signal desk.";
    Output: "The signal report.";
} {
    SignalDesk desk = SignalDesk();
    Print(desk.CreateSignal(8));
    Print(desk.SetSampleRate(8));
    Print(desk.SetChannels(1));
    Print(desk.CreateSineWave(1, 2, 8, 8));
    Print(desk.CreateCosineWave(1, 2, 8, 8));
    Print(desk.CreateSquareWave(1, 3, 8, 8));
    Print(desk.CreateTriangleWave(1, 4, 8, 8));
    Print(desk.CreateSawtoothWave(1, 4, 8, 8));
    Print(desk.SquareSample(1, 3, 8, 4));
    Print(desk.SineSample(1, 2, 8, 2));
    Print(desk.CreateImpulseSignal(8, 0));
    Print(desk.CreateWhiteNoise(8));
    Print(desk.CreatePinkNoise(8));
    Print(desk.CreateBrownNoise(8));
    Print(desk.GenerateSignal(0));
    Print(desk.GenerateSignal(1));
    Print(desk.AddSignals(2, 3));
    Print(desk.SubtractSignals(9, 4));
    Print(desk.MultiplySignals(2, 3));
    Print(desk.ScaleSignal(3));
    Print(desk.NormalizeSignal());
    Print(desk.ReverseSignal());
    Print(desk.InvertSignal());
    Print(desk.ConcatenateSignals());
    Print(desk.SliceSignal(1, 4));
    Print(desk.ShiftSignal(1));
    Print(desk.PadSignal(8));
    Print(desk.TrimSignal());
    Print(desk.ResampleSignal(4));
    Print(desk.Downsample(2));
    Print(desk.Upsample(2));
    Print(desk.ApplyFIRFilter(1, 2, 3, 4));
    Print(desk.ApplyIIRFilter());
    Print(desk.LowPass(4));
    Print(desk.HighPass(4));
    Print(desk.BandPass(2, 4));
    Print(desk.BandStop(2, 4));
    Print(desk.MovingAverage(4));
    Print(desk.MedianFilter(2));
    Print(desk.DesignButterworth(2));
    Print(desk.DesignChebyshev(2, 0));
    Print(desk.DesignElliptic(2, 0, 0));
    Print(desk.ApplyZeroPhaseFilter(6));
    Print(desk.ResetFilterState());
    Print(desk.DFT());
    Print(desk.FFT());
    Print(desk.IDFT());
    Print(desk.IFFT());
    Print(desk.RealFFT());
    Print(desk.InverseRealFFT());
    Print(desk.STFT());
    Print(desk.ISTFT());
    Print(desk.DCT());
    Print(desk.IDCT());
    Print(desk.DST());
    Print(desk.Hilbert());
    Print(desk.WaveletTransform());
    Print(desk.InverseWaveletTransform());
    Print(desk.ZTransform(1));
    Print(desk.ZTransform(-1));
    Print(desk.InverseZTransform());
    Print(desk.CalculateMean());
    Print(desk.CalculateVariance());
    Print(desk.CalculateEnergy());
    Print(desk.CalculatePower());
    Print(desk.CalculatePeakAmplitude());
    Print(desk.CalculateRMS(6));
    Print(desk.CalculateSNR(6, 3));
    Print(desk.CalculateCrestFactor(6));
    Print(desk.CalculateAutocorrelation(0));
    Print(desk.CalculateAutocorrelation(1));
    Print(desk.CalculateCrossCorrelation());
    Print(desk.FindPeaks());
    Print(desk.FindZeroCrossings());
    Print(desk.EstimateFrequency());
    Print(desk.EstimatePhase());
    Print(desk.CalculateSpectrum());
    Print(desk.CalculatePowerSpectrum());
    Print(desk.CalculateSpectrogram());
    Print(desk.CalculatePSD());
    Print(desk.Notch());
    Print(desk.ApplyWindow(3));
    Print(desk.RectangularWindow());
    Print(desk.TriangularWindow());
    Print(desk.HannWindow());
    Print(desk.HammingWindow());
    Print(desk.BlackmanWindow());
    Print(desk.KaiserWindow(1));
    Print(desk.GaussianWindow(1));
    Print(desk.WindowEnergy());
    Print(desk.WindowCoherentGain());
    Print(desk.AddNoise());
    Print(desk.RemoveNoise());
    Print(desk.ApplyNoiseGate(8));
    Print(desk.CompressDynamicRange());
    Print(desk.NormalizeLoudness(8));
    Print(desk.RemoveDCOffset());
    Print(desk.RemoveClicks());
    Print(desk.RemoveClipping(10));
    Print(desk.Convolve());
    Print(desk.ConvolveFFT(2, 3));
    Print(desk.Correlate());
    Print(desk.Echo(4));
    Print(desk.Reverb(6));
    Print(desk.Quantize(5, 2));
    Print(desk.CalculateMean());
    Print(desk.Fault());
    Return 0;
}
