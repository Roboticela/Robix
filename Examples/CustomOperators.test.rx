// Tests for Examples/CustomOperators.rx.

Test RoboMultiply {
    Case "multiply six and seven" {
        Input: left = 6, right = 7;
        Constraint: left > 0 And right > 0;
        Processing: left * right;
        Output: 42;
    }
}

Test Main {
    Case "run custom operators" {
        Input: args = [];
        Output: 0;
    }
}
