// Exercise the Robix.Core package.
Package Robotics.Core
Explain {
    Description: "Exercise Robix.Core values, input, conversion, comparison, ranges, versions, time, and identity.";
};

Import Robix.Core;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Exercise Robix.Core values, input, conversion, order, ranges, versions, time, and identity.";
    Input: args = "Command-line arguments";
    Processing: "Read input, convert it, compare values, walk a range, parse a version and a date, and compare identities.";
    Output: "The core report.";
} {
    Print(UnitText());
    Print(Kind("42"));
    Print(Kind("3.5"));
    Print(Kind("yes"));
    Print(HasInput(" arm "));
    Print(Accepted("42", "Int"));
    Print(ReadInt(" 42"));
    Print(ReadInt("-7"));
    Print(ReadBool("yes"));
    Print(ReadChar("Robot"));
    Print(TryReadInt("42").Ok);
    Print(TryReadInt("arm").Ok);
    Print(ToByte(300));
    Print(ToByte(-4));
    Print(ToHex(255));
    Print(FromHex("0x10"));
    Print(ToDecimalText(12));
    Print(AddDigits("999", "1"));
    Print(CompareInt(2, 5));
    Print(CompareText("arm", "arm"));
    Print(Min(10, 30));
    Print(Max(10, 30));
    Print(Clamp(42, 10, 30));
    Print(SumRange(MakeRange(1, 5)));
    Print(RangeCount(MakeRangeStep(0, 10, 2)));
    Print(RangeContains(MakeRange(1, 5), 3));
    Print(GetOffset(FromEnd(1), 5));
    Print(VersionText(ParseVersion("1.2.3")));
    Print(IsCompatible(ParseVersion("1.4.0"), ParseVersion("1.2.0")));
    Print(VersionText(BumpPatch(ParseVersion("1.2.3"))));
    Print(TotalSeconds(AddSpan(Seconds(1), Seconds(2))));
    Print(DateText(ParseDate("2026-11-24")));
    Print(DateText(AddDays(ParseDate("2024-02-28"), 2)));
    Print(IsLeapYear(2024));
    Print(DaysInMonth(2024, 2));
    Print(GuidText(EmptyGuid()));
    Print(SameGuid(MakeGuid(1, 2), MakeGuid(1, 2)));
    Print(CultureName(CultureInfo("en-US")));
    Print(HashText("arm"));
    Box box = Box(7, "sensor");
    Box twin = box.Clone();
    Print(ReferenceEquals(box, box));
    Print(ReferenceEquals(box, twin));
    Print(box.Dispose());
    Print(box.IsDisposed());
    Print(NowMillis());
    Return 0;
}
