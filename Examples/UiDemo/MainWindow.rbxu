<RobixUI Version="1.0">
  <Screen
    id="RobotDashboard"
    name="Robix UI Demo"
    path="/"
    theme="light"
    place="center"
    width="960"
    height="640"
    minWidth="640"
    minHeight="480"
    movable="true"
    resizable="true"
    board="MainBoard"/>

  <Board id="MainBoard" display="flex" direction="column" gap="16" padding="24" fill="true" background="bg-secondary">
    <Board id="Header" display="flex" direction="row" gap="16" height="72">
      <Board id="Brand" display="flex" direction="column" justify="center" padding="16" width="220" height="72" background="brand-primary">
        <Label id="BrandText" content="Roboticela" color="#FFFFFF"/>
      </Board>
      <Board id="Title" display="flex" direction="column" justify="center" padding="16" width="676" height="72" background="bg-primary">
        <Heading id="TitleText" level="h3" content="Robix UI Demo"/>
        <Paragraph id="TitleBody" content="The Language of Intelligent Machines."/>
      </Board>
    </Board>

    <Board id="Body" display="flex" direction="row" gap="16" height="504">
      <Board id="Actions" display="flex" direction="column" gap="12" padding="12" width="220" height="504" background="bg-primary">
        <Board id="Start" display="flex" direction="column" justify="center" padding="12" width="196" height="44" background="brand-primary">
          <Label id="StartText" content="Start Robot" color="#FFFFFF"/>
        </Board>
        <Board id="Stop" display="flex" direction="column" justify="center" padding="12" width="196" height="44" background="danger">
          <Label id="StopText" content="Stop Robot" color="#FFFFFF"/>
        </Board>
        <Board id="Status" display="flex" direction="column" gap="4" padding="12" width="196" height="120" background="bg-tertiary">
          <Eyebrow id="StatusEyebrow" content="Status"/>
          <Body id="StatusBody" content="Disconnected"/>
        </Board>
      </Board>

      <Board id="Stage" display="flex" direction="column" gap="12" padding="16" width="676" height="504" background="bg-primary">
        <Board id="Preview" display="flex" direction="column" gap="8" padding="16" width="644" height="220" background="bg-tertiary">
          <Subhead id="PreviewTitle" content="Live stage"/>
          <Caption id="PreviewCaption" content="Waiting for the first sensor frame."/>
        </Board>
        <Board id="Meters" display="grid" columns="3" gap="12" width="644" height="148">
          <Board id="Power" width="206" height="148" background="success"/>
          <Board id="Motor" width="206" height="148" background="warning"/>
          <Board id="Link" width="206" height="148" background="accent-teal"/>
        </Board>
        <Board id="Log" display="flex" direction="row" align="center" padding="16" gap="12" width="644" height="76" background="bg-tertiary">
          <Text id="LogText" width="584" content="Log is clear."/>
          <Scrollbar id="LogBar" orientation="vertical" width="16" height="44" autoHide="false" arrows="always"/>
        </Board>
      </Board>
    </Board>
  </Board>
</RobixUI>
