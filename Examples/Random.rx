// Robix.Math.Random: deterministic generators, samples, and distributions.
Package Robotics.Random;

Import Robix.Core;
Import Robix.Math.Random;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Exercise a deterministic random stream.";
    Input: args = "Command-line arguments";
    Processing: "Call the random desk.";
    Output: "The random report.";
} {
    RandomDesk desk = RandomDesk();
    Print(desk.CreateGenerator(1));
    Print(desk.NextInt());
    Print(desk.ResetGenerator());
    Print(desk.NextInRange(0, 9));
    Print(desk.CreateDefaultGenerator());
    Print(desk.GetState());
    Print(desk.SetState(1));
    Print(desk.ForkStream());
    Print(desk.SplitStream());
    Print(desk.CreateGeneratorFromState(1));
    Print(desk.NextInt64());
    Print(desk.SetSeed(1));
    Print(desk.NextUInt());
    Print(desk.SetSeed(1));
    Print(desk.NextUInt64());
    Print(desk.SetSeed(1));
    Print(desk.NextUnit());
    Print(desk.SetSeed(1));
    Print(desk.NextBoolean());
    Print(desk.SetSeed(1));
    Print(desk.NextByte());
    Print(desk.SetSeed(1));
    Print(desk.NextBytes(2));
    Print(desk.DrawnAt(1));
    Print(desk.SetSeed(1));
    Print(desk.Range(1, 6));
    Print(desk.SetSeed(1));
    Print(desk.RangeInclusive(1, 6));
    Print(desk.SetSeed(1));
    Print(desk.RangeExclusive(0, 10));
    Print(desk.SetItem(0, 10, 1));
    Print(desk.SetItem(1, 20, 1));
    Print(desk.SetItem(2, 30, 3));
    Print(desk.SetSeed(1));
    Print(desk.Choose());
    Print(desk.SetSeed(1));
    Print(desk.ChooseWeighted());
    Print(desk.SetSeed(1));
    Print(desk.ChooseMultiple(2));
    Print(desk.SetSeed(1));
    Print(desk.Shuffle());
    Print(desk.ItemAt(1));
    Print(desk.SetItem(0, 10, 1));
    Print(desk.SetItem(1, 20, 1));
    Print(desk.SetItem(2, 30, 1));
    Print(desk.SetSeed(1));
    Print(desk.Sample(2));
    Print(desk.SetItem(0, 10, 1));
    Print(desk.SetItem(1, 20, 1));
    Print(desk.SetSeed(1));
    Print(desk.SampleWithReplacement(2));
    Print(desk.SetItem(0, 10, 1));
    Print(desk.SetItem(1, 20, 1));
    Print(desk.SetItem(2, 30, 1));
    Print(desk.SetSeed(1));
    Print(desk.SampleWithoutReplacement(2));
    Print(desk.SetItem(0, 10, 1));
    Print(desk.SetItem(1, 20, 1));
    Print(desk.SetItem(2, 30, 1));
    Print(desk.SetSeed(1));
    Print(desk.ReservoirSample(2));
    Print(desk.SetSeed(1));
    Print(desk.NextNormal(0, 1));
    Print(desk.SetSeed(1));
    Print(desk.NextExponential(1));
    Print(desk.SetSeed(1));
    Print(desk.NextPoisson(4));
    Print(desk.SetSeed(1));
    Print(desk.NextBernoulli(500));
    Print(desk.SetSeed(1));
    Print(desk.NextBinomial(4, 500));
    Print(desk.SetSeed(1));
    Print(desk.NextGamma(2, 1));
    Print(desk.SetSeed(1));
    Print(desk.NextBeta(1, 1));
    Print(desk.SetSeed(1));
    Print(desk.NextWeibull(1, 2));
    Print(desk.SetSeed(1));
    Print(desk.NextLogNormal(10, 1));
    Print(desk.SetSeed(1));
    Print(desk.NextCauchy(0, 1));
    Print(desk.SetSeed(1));
    Print(desk.NextTriangular(0, 5, 10));
    Print(desk.SetSeed(1));
    Print(desk.RandomIntegers(3, 0, 9));
    Print(desk.SetSeed(1));
    Print(desk.RandomFloats(2, 0, 1));
    Print(desk.SetSeed(1));
    Print(desk.RandomBooleans(3));
    Print(desk.SetSeed(1));
    Print(desk.RandomBytes(2));
    Print(desk.SetSeed(1));
    Print(desk.RandomPermutation(4));
    Print(desk.SetSeed(1));
    Print(desk.RandomMatrix(2, 2));
    Print(desk.SetSeed(1));
    Print(desk.RandomVector(3));
    Print(desk.SetItem(0, 7, 1));
    Print(desk.SetItem(1, 8, 1));
    Print(desk.SetSeed(1));
    Print(desk.RandomChoiceSequence(2));
    Print(desk.Fault());
    Return 0;
}
