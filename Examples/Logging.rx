Package Robotics.Logging;

Import Robix.Logging;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Filter log records.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the log desk.";
    Output: "The log report.";
} {
    LogDesk desk = LogDesk();
    Print(desk.Accept(2, "ready"));
    Print(desk.Last());
    Print(desk.Accept(1, "hidden"));
    Print(desk.Accept(5, "boom"));
    Print(desk.Last());
    Print(desk.Kept());
    Print(desk.Dropped());
    Print(desk.SetLevel(0));
    Print(desk.Accept(0, "trace"));
    Print(desk.Last());
    Print(desk.Fault());
    Return 0;
}
