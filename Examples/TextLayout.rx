Package Robotics.Text;

Import Robix.Text;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Align and wrap text.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the text desk.";
    Output: "The text report.";
} {
    TextDesk desk = TextDesk();
    Print(desk.Measure("Robix"));
    Print(desk.Center("Robix", 10));
    Print(desk.AlignLeft("Robix", 8));
    Print(desk.AlignRight("Robix", 8));
    Print(desk.Truncate("Roboticela", 6));
    Print(desk.Repeat("ab", 3));
    Print(desk.Wrap("one two three", 7));
    Print(desk.FirstLine());
    Print(desk.NextLine());
    Print(desk.Fault());
    Return 0;
}
