// Robix.Math.LinearAlgebra: vectors, matrices, decompositions, and linear systems.
Package Robotics.LinearAlgebra;

Import Robix.Core;
Import Robix.Math.LinearAlgebra;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Exercise vectors, matrices, and linear systems.";
    Input: args = "Command-line arguments";
    Processing: "Call the linear algebra desk.";
    Output: "The linear algebra report.";
} {
    LinearAlgebraDesk desk = LinearAlgebraDesk();
    Print(desk.CreateVector(1, 2, 3));
    Print(desk.Component(2));
    Print(desk.CreateVector4(1, 0, 0, 1));
    Print(desk.ZeroVector(3));
    Print(desk.UnitVector(3, 1));
    Print(desk.Component(1));
    Print(desk.AddVectors(1, 2, 3, 4, 5, 6));
    Print(desk.Result(1));
    Print(desk.SubtractVectors(4, 5, 6, 1, 2, 3));
    Print(desk.MultiplyVector(1, 2, 3, 2));
    Print(desk.DivideVector(2, 4, 6, 2));
    Print(desk.DotProduct(1, 2, 3, 4, 5, 6));
    Print(desk.CrossProduct(1, 0, 0, 0, 1, 0));
    Print(desk.Result(2));
    Print(desk.VectorNorm(1, 2, 2, 0));
    Print(desk.VectorNorm(1, 2, 3, 1));
    Print(desk.Normalize(0, 3, 4));
    Print(desk.Result(2));
    Print(desk.VectorDistance(1, 2, 3, 1, 5, 7));
    Print(desk.VectorAngle(1, 0, 0, 0, 1, 0));
    Print(desk.ProjectVector(4, 0, 0, 2, 0, 0));
    Print(desk.RejectVector(4, 5, 0, 2, 0, 0));
    Print(desk.Result(1));
    Print(desk.HadamardProduct(2, 3, 4, 5, 6, 7));
    Print(desk.OuterProduct(1, 0, 0, 0, 1, 0));
    Print(desk.Get(0, 1));
    Print(desk.IsOrthogonal(1, 0, 0, 0, 1, 0));
    Print(desk.IsParallel(2, 0, 0, 4, 0, 0));
    Print(desk.Identity(3));
    Print(desk.Determinant());
    Print(desk.Trace());
    Print(desk.Zeros(2, 2));
    Print(desk.Ones(2, 2));
    Print(desk.Get(1, 1));
    Print(desk.Diagonal(2, 3, 4));
    Print(desk.Set(1, 1, 9));
    Print(desk.Get(1, 1));
    Print(desk.FromRow(0, 1, 0, 0));
    Print(desk.FromColumn(2, 0, 0, 1));
    Print(desk.Load(1, 0, 0, 0, 1, 0, 0, 0, 1));
    Print(desk.AddMatrices(1, 0, 0, 0, 1, 0, 0, 0, 1));
    Print(desk.SubtractMatrices(1, 0, 0, 0, 1, 0, 0, 0, 1));
    Print(desk.ScaleMatrix(3));
    Print(desk.DivideMatrix(3));
    Print(desk.MultiplyMatrices(1, 0, 0, 0, 1, 0, 0, 0, 1));
    Print(desk.MultiplyMatrixVector(4, 5, 6));
    Print(desk.Result(1));
    Print(desk.Transpose());
    Print(desk.Conjugate());
    Print(desk.ConjugateTranspose());
    Print(desk.DeterminantOf(1, 2, 3, 0, 1, 4, 5, 6, 0));
    Print(desk.Minor(0, 0));
    Print(desk.Cofactor(0, 0));
    Print(desk.Rank());
    Print(desk.Nullity());
    Print(desk.Adjugate());
    Print(desk.Load(1, 0, 0, 0, 1, 0, 0, 0, 1));
    Print(desk.Inverse());
    Print(desk.PseudoInverse());
    Print(desk.Load(1, 0, 0, 0, 1, 0, 0, 0, 1));
    Print(desk.MatrixPower(2));
    Print(desk.Load(0, 0, 0, 0, 0, 0, 0, 0, 0));
    Print(desk.MatrixExponential());
    Print(desk.Load(2, 0, 0, 0, 3, 0, 0, 0, 4));
    Print(desk.HadamardMatrices(2, 0, 0, 0, 2, 0, 0, 0, 2));
    Print(desk.KroneckerProduct(1, 0, 0, 1));
    Print(desk.KroneckerEntry(0));
    Print(desk.SolveLinearSystem(1, 0, 0, 0, 1, 0, 0, 0, 1, 4, 5, 6));
    Print(desk.Result(2));
    Print(desk.SolveGaussJordan(1, 2, 0, 0, 1, 0, 0, 0, 1, 5, 2, 3));
    Print(desk.SolveLU(1, 0, 0, 0, 1, 0, 0, 0, 1, 4, 5, 6));
    Print(desk.SolveQR(1, 0, 0, 0, 1, 0, 0, 0, 1, 4, 5, 6));
    Print(desk.SolveCholesky(4, 0, 0, 0, 9, 0, 0, 0, 16, 8, 18, 32));
    Print(desk.Result(1));
    Print(desk.SolveLeastSquares(1, 0, 0, 0, 1, 0, 0, 0, 1, 4, 5, 6));
    Print(desk.SolveSparse(2, 2, 2, 4, 6, 8));
    Print(desk.SetSparse(0, 0, 0, 1));
    Print(desk.SetSparse(1, 1, 1, 1));
    Print(desk.SetSparse(2, 2, 2, 1));
    Print(desk.SolveStoredSparse(4, 5, 6));
    Print(desk.SolveIterative(2, 0, 0, 0, 2, 0, 0, 0, 2, 4, 6, 8));
    Print(desk.Load(1, 0, 0, 0, 1, 0, 0, 0, 1));
    Print(desk.ComputeResidual(4, 5, 6, 4, 5, 6));
    Print(desk.Load(2, 1, 0, 4, 3, 0, 0, 0, 1));
    Print(desk.LU());
    Print(desk.Factor(1, 0, 0));
    Print(desk.Identity(3));
    Print(desk.QR());
    Print(desk.Factor(0, 0, 0));
    Print(desk.Diagonal(4, 9, 16));
    Print(desk.Cholesky());
    Print(desk.Factor(0, 1, 1));
    Print(desk.SVD());
    Print(desk.Eigenvalue(1));
    Print(desk.Diagonal(2, 3, 4));
    Print(desk.EigenDecompose());
    Print(desk.Eigenvalue(2));
    Print(desk.Schur());
    Print(desk.PolarDecomposition());
    Print(desk.IsSquare());
    Print(desk.IsSymmetric());
    Print(desk.IsHermitian());
    Print(desk.IsDiagonal());
    Print(desk.IsTriangular());
    Print(desk.Identity(3));
    Print(desk.IsOrthogonalMatrix());
    Print(desk.IsUnitary());
    Print(desk.IsPositiveDefinite());
    Print(desk.IsSingular());
    Print(desk.IsInvertible());
    Print(desk.Diagonal(2, 2, 4));
    Print(desk.ConditionNumber());
    Print(desk.MatrixNorm(1));
    Print(desk.FrobeniusNorm());
    Print(desk.SetTensor(0, 3));
    Print(desk.SetTensor(1, 4));
    Print(desk.TensorAt(1));
    Print(desk.TensorShape(2));
    Print(desk.TensorSum());
    Print(desk.RankOfTensor());
    Print(desk.Identity(3));
    Print(desk.SetShift(1, 2, 3));
    Print(desk.ApplyAffine(4, 5, 6));
    Print(desk.Result(2));
    Print(desk.RotationMatrix(1));
    Print(desk.LinearTransform(1, 0, 0));
    Print(desk.Result(1));
    Print(desk.SetShift(0, 0, 0));
    Print(desk.TransformationMatrix(1, 0, 0));
    Print(desk.RandomMatrix(2, 2, 1));
    Print(desk.CreateMatrix(2, 2));
    Print(desk.Fault());
    Return 0;
}
