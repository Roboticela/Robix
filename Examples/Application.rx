Package Robotics.Application;

Import Robix.Console.Application;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Decide when a console window should wait.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the application desk.";
    Output: "The application report.";
} {
    AppDesk desk = AppDesk();
    Print(desk.ShouldPause());
    Print(desk.IsInteractive());
    Print(desk.ExitMessage());
    Print(desk.SetLaunch(1));
    Print(desk.ShouldPause());
    Print(desk.SetLaunch(2));
    Print(desk.ShouldPause());
    Print(desk.IsInteractive());
    Print(desk.SetLaunch(0));
    Print(desk.SetBehavior(2));
    Print(desk.ShouldPause());
    Print(desk.SetBehavior(4));
    Print(desk.ShouldPause());
    Print(desk.SetBehavior(1));
    Print(desk.ShouldPause());
    Print(desk.SetExitMessage("Press Enter to close..."));
    Print(desk.ExitMessage());
    Print(desk.Fault());
    Return 0;
}
