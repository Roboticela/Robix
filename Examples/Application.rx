// Robix.Console.Application: whether a finished console window should wait.
Package Robotics.Application
Explain {
    Description: "Robix.Console.Application: whether a finished console window should wait.";
};

Import Robix.Core;


Class AppDesk {
    Private Int behavior;
    Private Int launch;
    Private String message;
    Private String problem;

    Public Constructor() {
        behavior = 0;
        launch = 0;
        message = "Press any key to close...";
        problem = "none";
    }

    Public Function SetBehavior(Int next) -> Int
    Explain {
        Description: "Set the close behavior.";
        Input: next = "0 wait-key, 1 wait-enter, 2 immediate, 3 delay, 4 never";
        Processing: "Store a known behavior.";
        Output: "The behavior, or -1 when it is unknown.";
    } {
        If (next < 0 || next > 4) {
            problem = "behavior";
            Return -1;
        }
        behavior = next;
        Return behavior;
    }

    Public Function SetLaunch(Int context) -> Int
    Explain {
        Description: "Set how the application was launched.";
        Input: context = "0 direct, 1 terminal, 2 redirected";
        Processing: "Store a known launch context.";
        Output: "The context, or -1 when it is unknown.";
    } {
        If (context < 0 || context > 2) {
            problem = "launch";
            Return -1;
        }
        launch = context;
        Return launch;
    }

    Public Function SetExitMessage(String text) -> Int
    Explain {
        Description: "Set the exit message.";
        Input: text = "Message";
        Processing: "Store the message shown when the runtime pauses.";
        Output: "The message length.";
    } {
        message = text;
        Return message.Length();
    }

    Public Function ShouldPause() -> Int
    Explain {
        Description: "Report whether the runtime should pause after exit.";
        Input: "No parameters";
        Processing: "A direct launch pauses unless the behavior says not to. A terminal or redirected launch does not pause.";
        Output: "One when the window should wait.";
    } {
        If (launch == 1 || launch == 2) { Return 0; }
        If (behavior == 2 || behavior == 4) { Return 0; }
        Return 1;
    }

    Public Function ExitMessage() -> String
    Explain {
        Description: "Return the exit message.";
        Input: "No parameters";
        Processing: "Read the message.";
        Output: "The message.";
    } {
        Return message;
    }

    Public Function IsInteractive() -> Int
    Explain {
        Description: "Report whether a person can answer a pause.";
        Input: "No parameters";
        Processing: "Redirected output is not interactive.";
        Output: "One when input is interactive.";
    } {
        If (launch == 2) { Return 0; }
        Return 1;
    }

    Public Function Fault() -> String
    Explain {
        Description: "Return the latest application error.";
        Input: "No parameters";
        Processing: "Read the stored error.";
        Output: "The error text.";
    } {
        Return problem;
    }
}


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Decide when a console window should wait.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the application desk.";
    Output: "The application report.";
} {
    AppDesk desk = AppDesk();
    Print(desk.ShouldPause());
    Print(desk.IsInteractive());
    Print(desk.ExitMessage());
    Print(desk.SetLaunch(1));
    Print(desk.ShouldPause());
    Print(desk.SetLaunch(2));
    Print(desk.ShouldPause());
    Print(desk.IsInteractive());
    Print(desk.SetLaunch(0));
    Print(desk.SetBehavior(2));
    Print(desk.ShouldPause());
    Print(desk.SetBehavior(4));
    Print(desk.ShouldPause());
    Print(desk.SetBehavior(1));
    Print(desk.ShouldPause());
    Print(desk.SetExitMessage("Press Enter to close..."));
    Print(desk.ExitMessage());
    Print(desk.Fault());
    Return 0;
}
