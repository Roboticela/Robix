// Robix.Math.Optimization: exact integer minimization, linear programs, and Pareto fronts.
Package Robotics.Optimization;

Import Robix.Core;
Import Robix.Math.Optimization;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Exercise minimization, a linear program, and a Pareto front.";
    Input: args = "Command-line arguments";
    Processing: "Call the optimization desk.";
    Output: "The optimization report.";
} {
    OptimizationDesk desk = OptimizationDesk();
    Print(desk.CreateMaximizationProblem(2));
    Print(desk.CreateMinimizationProblem(1));
    Print(desk.AddVariable(0));
    Print(desk.AddConstraint(4));
    Print(desk.SetBounds(0, 10));
    Print(desk.SetInitialGuess(0));
    Print(desk.SetObjective(1));
    Print(desk.ValidateProblem(1, 0, 10));
    Print(desk.SetLearningRate(1));
    Print(desk.SetTolerance(0));
    Print(desk.Minimize(1, 0, 10));
    Print(desk.Maximize(2, 0, 10));
    Print(desk.Optimize(1, 0, 10));
    Print(desk.OptimizeAsync(1, 0, 10));
    Print(desk.FindMinimum(1, 0, 10));
    Print(desk.FindMaximum(2, 0, 10));
    Print(desk.FindGlobalMinimum(1, 0, 10));
    Print(desk.FindGlobalMaximum(1, 0, 10));
    Print(desk.GetOptimalValue(1, 0, 10));
    Print(desk.OptimalParameter(1, 0, 10));
    Print(desk.GradientDescent(1, 0, 1));
    Print(desk.StochasticGradientDescent(0, 1));
    Print(desk.MiniBatchGradientDescent(0, 1));
    Print(desk.Momentum(1, 0, 1));
    Print(desk.AdaGrad(1, 0, 1));
    Print(desk.RMSProp(1, 0, 1));
    Print(desk.Adam(1, 0, 1));
    Print(desk.AdamW(1, 0, 1));
    Print(desk.BFGS(1, 10));
    Print(desk.LBFGS(1, 10));
    Print(desk.NewtonMethod(1, 10));
    Print(desk.NewtonMethod(2, 0));
    Print(desk.ConjugateGradient(1, 0));
    Print(desk.ComputeGradient(1, 5));
    Print(desk.ComputeHessian(1, 5));
    Print(desk.ComputeHessian(2, 0));
    Print(desk.ComputeJacobian(1, 5));
    Print(desk.LineSearch(1, 0, 1));
    Print(desk.BacktrackingLineSearch(1, 0, 1));
    Print(desk.GoldenSectionSearch(1, 0, 10));
    Print(desk.BrentSearch(1, 0, 10));
    Print(desk.CoordinateSearch(1, 0));
    Print(desk.CoordinateDescent(1, 0));
    Print(desk.EstimateOptimalStepSize(1, 5));
    Print(desk.NelderMead(1, 0));
    Print(desk.Powell(1, 0));
    Print(desk.SimulatedAnnealing(1, 0));
    Print(desk.GeneticOptimize(1));
    Print(desk.ParticleSwarmOptimize(1));
    Print(desk.DifferentialEvolution(1));
    Print(desk.BayesianOptimize(1, 0, 10));
    Print(desk.EvolutionStrategy(1));
    Print(desk.SolveLinearProgram(3, 2));
    Print(desk.OptimalLinearX(3, 2));
    Print(desk.OptimalLinearY(3, 2));
    Print(desk.SolveQuadraticProgram(3, 1));
    Print(desk.SolveIntegerProgram(3, 2));
    Print(desk.SolveMixedIntegerProgram(3, 2));
    Print(desk.SolveWithConstraints(3, 2));
    Print(desk.Simplex(3, 2));
    Print(desk.InteriorPoint(3, 2));
    Print(desk.BranchAndBound(3, 2));
    Print(desk.ApplyPenaltyFunction(1, 4));
    Print(desk.CheckConstraintSatisfaction(2, 2));
    Print(desk.CheckConstraintSatisfaction(4, 4));
    Print(desk.IsConverged(1, 3));
    Print(desk.IsConverged(1, 1));
    Print(desk.ConvergenceHistory(1, 0, 1));
    Print(desk.IterationCount(1, 0, 1));
    Print(desk.GetGradientNorm(1, 5));
    Print(desk.EstimateOptimalityGap(1, 5));
    Print(desk.CompareOptimizers(1, 0));
    Print(desk.ConvergedWithin(1, 4, 2));
    Print(desk.ParetoFront(0, 6));
    Print(desk.NSGA2(0, 6));
    Print(desk.NSGA3(0, 6));
    Print(desk.Dominates(1, 0));
    Print(desk.Dominates(2, 1));
    Print(desk.ObjectiveVector(2));
    Print(desk.MultiObjectiveOptimize(0, 6));
    Print(desk.MinimizeRegularized(1, 2, 0, 6));
    Print(desk.NewtonMethod(3, 5));
    Print(desk.Fault());
    Print(desk.Minimize(1, 0, 10));
    Print(desk.Fault());
    Return 0;
}
