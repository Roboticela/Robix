Package Robotics.Gradient;

Import Robix.Gradient;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Interpolate colors.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the gradient desk.";
    Output: "The gradient report.";
} {
    GradientDesk desk = GradientDesk();
    Print(desk.Linear(255, 0, 0, 0, 0, 255, 0));
    Print(desk.Red());
    Print(desk.Blue());
    Print(desk.Linear(255, 0, 0, 0, 0, 255, 50));
    Print(desk.Red());
    Print(desk.Green());
    Print(desk.Blue());
    Print(desk.Linear(255, 0, 0, 0, 0, 255, 100));
    Print(desk.Red());
    Print(desk.Blue());
    Print(desk.Rainbow(0));
    Print(desk.Red());
    Print(desk.Rainbow(50));
    Print(desk.Red());
    Print(desk.Green());
    Print(desk.Blue());
    Print(desk.Stop(0, 255, 0, 0));
    Print(desk.Stop(100, 0, 0, 255));
    Print(desk.At(50));
    Print(desk.Red());
    Print(desk.Blue());
    Print(desk.Clear());
    Print(desk.Fault());
    Return 0;
}
