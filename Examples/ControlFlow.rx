// Conditions, C-style For, ranges, Enumerate, For-In, While, Do-While, Repeat, Loop, and Break/Continue.
Package Robotics.ControlFlow;

Import Robix.Core;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Walk every Robix condition and loop construct.";
    Input: args = "Command-line arguments";
    Processing: "Run If/Else, C-style For, range For, Enumerate, While, Do-While, Repeat, Loop, and infinite For.";
    Output: "Zero after printing loop results.";
} {
    Var batteryLevel = 80;
    If (batteryLevel >= 80) {
        Print("Battery is full");
    } Else If (batteryLevel >= 30) {
        Print("Battery is sufficient");
    } Else {
        Print("Low battery");
    }
    If batteryLevel >= 80 {
        Print("Parentheses are optional");
    }

    Var counter = 0;
    For (Int index = 0; index < 3; index++) {
        counter = counter + 1;
    }
    For index In 0..2 {
        counter = counter + 1;
    }

    Array<String> robotNames = ["Alpha", "Beta"];
    For robot In robotNames {
        Print(robot);
    }

    Array<Int> sensorReads = [10, 20, 30];
    Enumerate<Int> enumerateItems = sensorReads.Enumerate();
    For (index, value) In enumerateItems {
        Print(index);
        Print(value);
    }

    While (batteryLevel > 20) {
        batteryLevel -= 30;
    }

    Bool enabled = False;
    Do {
        Print("Sensor check");
    } While (enabled);

    Repeat 2 {
        counter = counter + 1;
    }

    Loop {
        counter = counter + 1;
        If (!enabled) {
            Break;
        }
        Continue;
    }

    For (Var i = 0; ; i++) {
        If (i >= 3) {
            Break;
        }
        counter = counter + 1;
    }

    Var backwards = 3;
    While (backwards > 0) {
        backwards--;
    }

    Print(counter);
    Print(backwards);
    Return 0;
}
