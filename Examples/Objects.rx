// Classes, inheritance, structs, enums, and services.
Package Robotics.Objects;

Import Robix.Core;


Public Abstract Class RoboRobot {
    Protected String robotName;
    Protected Int batteryLevel;

    Public Abstract Function Move() -> Void
    Explain {
        Description: "Move the robot.";
        Input: None;
        Processing: "Perform the movement defined by the derived robot.";
        Output: "No return value.";
    };

    Public Function GetBatteryLevel() -> Int
    Explain {
        Description: "Return the battery level.";
        Input: None;
        Processing: "Read the stored battery level.";
        Output: "The battery level.";
    } {
        Return batteryLevel;
    }
}

Public Interface RoboDrivable {
    Public Function Move() -> Void
    Explain {
        Description: "Move a drivable robot.";
        Input: None;
        Processing: "Perform the drive motion.";
        Output: "No return value.";
    };
}

Public Interface RoboComparable<T> {
    Public Function CompareTo(T other) -> Int
    Explain {
        Description: "Compare this value with another.";
        Input: other = "The other value";
        Processing: "Return the comparison result.";
        Output: "An integer comparison.";
    };
}

Public Trait RoboIterable<T> {
    Public Function GetIterator() -> Iterator<T>
    Explain {
        Description: "Return an iterator.";
        Input: None;
        Processing: "Create the iterator.";
        Output: "The iterator.";
    };
}

Public Trait RoboCloneable<T> {
    Public Function Clone() -> T
    Explain {
        Description: "Clone the value.";
        Input: None;
        Processing: "Return a copy.";
        Output: "The copy.";
    };
}

Public Class RoboFlyingCapability {
    Public Constructor() {
    }
}

Public Class RoboWalkingRobot : RoboRobot, RoboDrivable {
    Private String serialNumber;

    Public Constructor(String name, String serial = "UNASSIGNED") {
        Base.Constructor();
        robotName = name;
        serialNumber = serial;
        batteryLevel = 100;
    }

    Public Override Function Move() -> Void
    Explain {
        Description: "Walk the robot forward.";
        Input: None;
        Processing: "Print the walking action.";
        Output: "No return value.";
    } {
        Print("Walking forward");
    }

    Public Function GetSerialNumber() -> String
    Explain {
        Description: "Return the serial number.";
        Input: None;
        Processing: "Read the stored serial number.";
        Output: "The serial number.";
    } {
        Return serialNumber;
    }

    Public Destructor() {
    }
}

Public Class RoboFlyingRobot : RoboRobot {
    Public Constructor(String name = "RoboFly") {
        Base.Constructor();
        robotName = name;
        batteryLevel = 100;
    }

    Public Override Function Move() -> Void
    Explain {
        Description: "Fly the robot forward.";
        Input: None;
        Processing: "Print the flying action.";
        Output: "No return value.";
    } {
        Print("Flying forward");
    }

    Public Function GetName() -> String
    Explain {
        Description: "Return the robot name.";
        Input: None;
        Processing: "Read the stored name.";
        Output: "The robot name.";
    } {
        Return robotName;
    }
}

Public Class RoboAdvancedRobot : RoboWalkingRobot {
    Public Constructor(String name) : Base.Constructor(name) {
        Print("Advanced robot initialized");
    }

    Public Destructor() {
        Print("Advanced robot cleanup");
        Base.Destructor();
    }
}

Public Class RoboHybridRobot : RoboWalkingRobot, RoboFlyingCapability {
    Public Constructor(String name)
        : Base<RoboWalkingRobot>.Constructor(name)
        : Base<RoboFlyingCapability>.Constructor() {
        robotName = name;
    }

    Public Override Function Move() -> Void
    Explain {
        Description: "Walk and fly.";
        Input: None;
        Processing: "Print the combined action.";
        Output: "No return value.";
    } {
        Print("Walking and flying");
    }
}

Public Struct RoboPoint {
    Public Float X;
    Public Float Y;

    Public Constructor(Float x, Float y) {
        X = x;
        Y = y;
    }
}

Public Enum RoboState {
    Idle,
    Moving,
    Charging,
    Error(Int errorCode)
}

Public Service RoboStatusService {
    Public Function GetStatus(Int id) -> Int
    Explain {
        Description: "Return a status code for an id.";
        Input: id = "Status identifier";
        Processing: "Look up the status.";
        Output: "The status code.";
    };
}

Implement RoboStatusService {
    Public Function GetStatus(Int id) -> Int
    Explain {
        Description: "Return the supplied status id.";
        Input: id = "Status identifier";
        Processing: "Return the id unchanged.";
        Output: "The same id.";
    } {
        Return id;
    }
}

Connect RoboStatusService;

Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Construct robots, a point, and a status service.";
    Input: args = "Command-line arguments";
    Processing: "Move each robot, print stored values, and read a service.";
    Output: "Zero after the robot report.";
} {
    RoboWalkingRobot walker = RoboWalkingRobot("Walker");
    walker.Move();
    Print(walker.GetBatteryLevel());
    Print(walker.GetSerialNumber());
    RoboFlyingRobot flyer = RoboFlyingRobot();
    Print(flyer.GetName());
    flyer.Move();
    RoboAdvancedRobot advanced = RoboAdvancedRobot("Advanced");
    advanced.Move();
    RoboHybridRobot hybrid = RoboHybridRobot("Hybrid");
    hybrid.Move();
    RoboPoint point = RoboPoint(1.5, 2.5);
    Print(point.X);
    Print(point.Y);
    Print(RoboState.Idle);
    Print(RoboStatusService.GetStatus(7));
    Return 0;
}
