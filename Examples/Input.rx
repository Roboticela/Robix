Package Robotics.Input;

Import Robix.Console.Input;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Read virtual input and a menu choice.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the input desk.";
    Output: "The input report.";
} {
    InputDesk desk = InputDesk();
    Print(desk.Feed("42"));
    Print(desk.ReadInteger());
    Print(desk.Feed("yes"));
    Print(desk.ReadBoolean());
    Print(desk.Confirm());
    Print(desk.Feed("secret"));
    Print(desk.Password());
    Print(desk.ReadLine());
    Print(desk.AddItem("Start"));
    Print(desk.AddItem("Settings"));
    Print(desk.Choose(1));
    Print(desk.Selected());
    Print(desk.Choice());
    Print(desk.Key("up"));
    Print(desk.Key("missing"));
    Print(desk.Fault());
    Return 0;
}
