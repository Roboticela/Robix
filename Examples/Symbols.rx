Package Robotics.Symbols;

Import Robix.Symbols;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Show Unicode and ASCII symbols.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the symbol desk.";
    Output: "The symbol report.";
} {
    SymbolDesk desk = SymbolDesk();
    Print(desk.Check());
    Print(desk.Cross());
    Print(desk.Warning());
    Print(desk.Arrow());
    Print(desk.Bullet());
    Print(desk.Star());
    Print(desk.UseAscii(1));
    Print(desk.Check());
    Print(desk.Cross());
    Print(desk.Warning());
    Print(desk.Arrow());
    Print(desk.Glyph("star"));
    Print(desk.Fault());
    Return 0;
}
