Package Robotics.Widget;

Import Robix.Console.Widget;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Draw progress, a table, and a panel.";
    Input: args = "Command-line arguments";
    Processing: "Exercise the widget desk.";
    Output: "The widget report.";
} {
    WidgetDesk desk = WidgetDesk();
    Print(desk.Start("Downloading", 100));
    Print(desk.SetValue(40));
    Print(desk.Percent());
    Print(desk.Bar());
    Print(desk.Complete("saved"));
    Print(desk.Status());
    Print(desk.AddColumn("Name", "Version"));
    Print(desk.AddRow("Robix", "1.0"));
    Print(desk.Table());
    Print(desk.Panel("Welcome", "Hello"));
    Print(desk.Live("Installing"));
    Print(desk.LiveText());
    Print(desk.Fail("stopped"));
    Print(desk.Fault());
    Return 0;
}
