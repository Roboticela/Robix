// Robix.Math.Numerical: roots, interpolation, quadrature, and stable summation.
Package Robotics.Numerical;

Import Robix.Core;
Import Robix.Math.Numerical;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Exercise roots, interpolation, and quadrature.";
    Input: args = "Command-line arguments";
    Processing: "Call the numerical desk.";
    Output: "The numerical report.";
} {
    NumericalDesk desk = NumericalDesk();
    Print(desk.Evaluate(1, 2));
    Print(desk.SlopeOf(1, 3));
    Print(desk.Bisection(1, 0, 5));
    Print(desk.Brent(1, 0, 5));
    Print(desk.NewtonRaphson(1, 2));
    Print(desk.Secant(1, 0, 2));
    Print(desk.RegulaFalsi(1, 0, 5));
    Print(desk.FixedPointIteration(4));
    Print(desk.FindRoot(1, 0, 5));
    Print(desk.FindRoots(1, -3, 3));
    Print(desk.RootAt(0));
    Print(desk.RootAt(1));
    Print(desk.LinearInterpolate(0, 0, 4, 8, 2));
    Print(desk.BilinearInterpolate(0, 2, 2, 4, 1, 1, 2, 2));
    Print(desk.TrilinearInterpolate(2, 6, 1));
    Print(desk.SetPoint(0, 0, 0));
    Print(desk.SetPoint(1, 1, 1));
    Print(desk.SetPoint(2, 2, 4));
    Print(desk.PolynomialInterpolate(3));
    Print(desk.LagrangeInterpolate(0, 0, 1, 1, 2, 4, 3));
    Print(desk.NewtonInterpolate(0, 0, 1, 1, 2, 4, 3));
    Print(desk.CubicSplineInterpolate(0, 0, 4, 8, 2));
    Print(desk.HermiteInterpolate(0, 0, 2, 2, 4, 2, 1));
    Print(desk.NearestNeighborInterpolate(0, 1, 10, 9, 2));
    Print(desk.TrapezoidalRule(0, 0, 4));
    Print(desk.CompositeTrapezoidal(0, 0, 4, 2));
    Print(desk.SimpsonsRule(0, 0, 2));
    Print(desk.CompositeSimpsons(0, 0, 2, 2));
    Print(desk.RombergIntegration(0, 0, 4));
    Print(desk.GaussianQuadrature(0, 0, 4));
    Print(desk.AdaptiveQuadrature(0, 0, 2, 0));
    Print(desk.FiniteDifference(2, 3, 1));
    Print(desk.ForwardDifference(2, 3, 1));
    Print(desk.BackwardDifference(2, 3, 1));
    Print(desk.CentralDifference(2, 3, 1));
    Print(desk.RichardsonExtrapolation(2, 3, 2));
    Print(desk.NumericalGradient(3, 4));
    Print(desk.GradientY());
    Print(desk.NumericalJacobian(3, 4));
    Print(desk.NumericalHessian(3, 4));
    Print(desk.Approximate(17, 5));
    Print(desk.ApproximatePolynomial(2, 3));
    Print(desk.LeastSquaresApproximation(0, 0, 1, 2, 2, 4));
    Print(desk.Intercept());
    Print(desk.ChebyshevApproximation(0, 1));
    Print(desk.PadeApproximation(2, 3));
    Print(desk.AbsoluteError(10, 7));
    Print(desk.RelativeError(10, 8));
    Print(desk.EstimateError(10, 7));
    Print(desk.ResidualError(1, 2));
    Print(desk.SolveNonlinearSystem(0, 0));
    Print(desk.SolvedY());
    Print(desk.SolveEigenvalues(2, 5));
    Print(desk.SolveODENumerically(1, 3));
    Print(desk.SolvePDENumerically(0, 4));
    Print(desk.IterateUntilConverged(0, 0));
    Print(desk.EstimateConditionNumber(2, 3));
    Print(desk.AnalyzeStability(1));
    Print(desk.Record(0, 8));
    Print(desk.Record(1, 4));
    Print(desk.Record(2, 0));
    Print(desk.CheckConvergence());
    Print(desk.EstimateConvergenceRate());
    Print(desk.CompensatedSum(1, 2, 3, 4));
    Print(desk.KahanSum(1, 2, 3, 4));
    Print(desk.PairwiseSum(1, 2, 3, 4));
    Print(desk.StableSort(4, 1, 3, 2));
    Print(desk.SortedAt(3));
    Print(desk.Fault());
    Return 0;
}
