// Let, Var, multiple names, and assignment.
Package Robotics.Variables;

Import Robix.Core;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Exercise immutable bindings, mutable bindings, and tuple assignment.";
    Input: args = "Command-line arguments";
    Processing: "Assign several names, swap a pair, and update a counter.";
    Output: "The counter after the compound updates.";
} {
    Int x = 20, j = 30, k = 0, f = 0;
    x = j = 20;
    Print(x);
    Print(j);
    (x, j, k) = (20, 30, 40);
    Print(k);
    (x, j) = (j, x);
    Print(x);
    Print(j);
    Let (firstName, lastName) = ("Robo", "Bot");
    Print(firstName);
    Print(lastName);
    Var counter = 0;
    counter++;
    counter--;
    counter += 5;
    counter *= 2;
    Int shown = counter++;
    Print(shown);
    Print(counter);
    Print(f);
    Return 0;
}
