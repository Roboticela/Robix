// Robix.Algorithms.Graphs: exact algorithms on one four-vertex graph.
Package Robotics.Graphs;

Import Robix.Core;
Import Robix.Algorithms.Graphs;


Public Function Main(Args<String> args) -> Int
Explain {
    Description: "Exercise graph algorithms on four vertices.";
    Input: args = "Command-line arguments";
    Processing: "Call the graph desk.";
    Output: "The graph report.";
} {
    GraphDesk desk = GraphDesk();
    Print(desk.CreateGraph());
    Print(desk.CreateDirectedGraph());
    Print(desk.CreateUndirectedGraph());
    Print(desk.AddVertex(2));
    Print(desk.AddEdge(0, 1));
    Print(desk.AddWeightedEdge(0, 2, 2));
    Print(desk.RemoveVertex(3));
    Print(desk.RemoveEdge(0, 1));
    Print(desk.GetVertices());
    Print(desk.GetEdges());
    Print(desk.GetNeighbors(0));
    Print(desk.GetDegree(0));
    Print(desk.GetInDegree(0));
    Print(desk.GetOutDegree(0));
    Print(desk.BFS(0));
    Print(desk.DFS(0));
    Print(desk.IterativeDFS(0));
    Print(desk.RecursiveDFS(0));
    Print(desk.BidirectionalBFS(0, 3));
    Print(desk.DepthLimitedSearch(0, 1));
    Print(desk.IterativeDeepeningDFS(0));
    Print(desk.TopologicalSort());
    Print(desk.Dijkstra(0));
    Print(desk.BellmanFord(0));
    Print(desk.FloydWarshall());
    Print(desk.Johnson(0));
    Print(desk.AStar(0, 3));
    Print(desk.IDAStar(0, 3));
    Print(desk.BidirectionalDijkstra(0, 3));
    Print(desk.ZeroOneBFS(0));
    Print(desk.ShortestPathDAG(0));
    Print(desk.FindShortestPath(0, 3));
    Print(desk.FindAllShortestPaths(0, 3));
    Print(desk.Kruskal());
    Print(desk.Prim());
    Print(desk.Boruvka());
    Print(desk.MinimumSpanningTree());
    Print(desk.MaximumSpanningTree());
    Print(desk.MinimumSpanningForest());
    Print(desk.IsConnected());
    Print(desk.IsStronglyConnected());
    Print(desk.ConnectedComponents());
    Print(desk.StronglyConnectedComponents());
    Print(desk.WeaklyConnectedComponents());
    Print(desk.TarjanSCC());
    Print(desk.KosarajuSCC());
    Print(desk.FindBridges());
    Print(desk.FindArticulationPoints());
    Print(desk.FindBiconnectedComponents());
    Print(desk.HasCycle());
    Print(desk.FindCycle());
    Print(desk.FindAllCycles());
    Print(desk.DetectNegativeCycle());
    Print(desk.FindEulerianPath());
    Print(desk.FindEulerianCircuit());
    Print(desk.FindHamiltonianPath());
    Print(desk.FindHamiltonianCycle());
    Print(desk.FordFulkerson(0, 3));
    Print(desk.EdmondsKarp(0, 3));
    Print(desk.Dinic(0, 3));
    Print(desk.PushRelabel(0, 3));
    Print(desk.MaximumFlow(0, 3));
    Print(desk.MinimumCut(0, 3));
    Print(desk.MinimumCostFlow(0, 3));
    Print(desk.MaximumMatching());
    Print(desk.BipartiteMatching());
    Print(desk.HopcroftKarp());
    Print(desk.HungarianAlgorithm());
    Print(desk.StableMatching());
    Print(desk.IsBipartite());
    Print(desk.IsAcyclic());
    Print(desk.IsTree());
    Print(desk.IsPlanar());
    Print(desk.IsComplete());
    Print(desk.IsRegular());
    Print(desk.IsEulerian());
    Print(desk.IsHamiltonian());
    Print(desk.GraphDensity());
    Print(desk.GraphDiameter());
    Print(desk.GraphRadius());
    Print(desk.GraphGirth());
    Print(desk.PageRank());
    Print(desk.DegreeCentrality());
    Print(desk.ClosenessCentrality());
    Print(desk.BetweennessCentrality());
    Print(desk.EigenvectorCentrality());
    Print(desk.KatzCentrality());
    Print(desk.CommunityDetection());
    Print(desk.LabelPropagation());
    Print(desk.Louvain());
    Print(desk.GetVertices());
    Print(desk.Fault());
    Return 0;
}
