{
    "name": "Robix",
    "scopeName": "source.robix",
    "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#attribute" },
        { "include": "#number" },
        { "include": "#declaration" },
        { "include": "#keyword" },
        { "include": "#operator" }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.robix",
                    "match": "//.*"
                },
                {
                    "name": "comment.block.robix",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "name": "string.quoted.triple.robix",
                    "begin": "(r)?(\\$)?(\"\"\")",
                    "beginCaptures": {
                        "1": { "name": "storage.modifier.raw.robix" },
                        "2": { "name": "punctuation.definition.interpolation.begin.robix" },
                        "3": { "name": "punctuation.definition.string.begin.robix" }
                    },
                    "end": "\"\"\"",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.robix" }
                    },
                    "patterns": [{ "include": "#string-inner" }]
                },
                {
                    "name": "string.quoted.double.raw.robix",
                    "begin": "(r)(\\$)?(\")",
                    "beginCaptures": {
                        "1": { "name": "storage.modifier.raw.robix" },
                        "2": { "name": "punctuation.definition.interpolation.begin.robix" },
                        "3": { "name": "punctuation.definition.string.begin.robix" }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.robix" }
                    }
                },
                {
                    "name": "string.quoted.double.robix",
                    "begin": "(\\$)?(\")",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.interpolation.begin.robix" },
                        "2": { "name": "punctuation.definition.string.begin.robix" }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.robix" }
                    },
                    "patterns": [{ "include": "#string-inner" }]
                }
            ]
        },
        "string-inner": {
            "patterns": [
                {
                    "name": "constant.character.escape.robix",
                    "match": "\\\\."
                },
                {
                    "name": "meta.interpolation.robix",
                    "begin": "\\{",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.interpolation.begin.robix" }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.interpolation.end.robix" }
                    },
                    "patterns": [{ "include": "$self" }]
                }
            ]
        },
        "char": {
            "name": "constant.character.robix",
            "match": "'(?:\\\\.|[^'\\\\])'"
        },
        "attribute": {
            "name": "entity.name.tag.robix",
            "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        "number": {
            "name": "constant.numeric.robix",
            "match": "\\b0[xX][0-9A-Fa-f_]+|\\b0[bB][01_]+|\\b0[oO][0-7_]+|\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d[\\d_]*)?(?:[iufdmIUFDM][0-9]*)?"
        },
        "declaration": {
            "patterns": [
                {
                    "match": "(?i)\\b(function|macro)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.robix" },
                        "2": { "name": "entity.name.function.robix" }
                    }
                },
                {
                    "match": "(?i)\\b(class|struct|interface|trait|enum|service)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.robix" },
                        "2": { "name": "entity.name.type.robix" }
                    }
                },
                {
                    "match": "(?i)\\b(test)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.control.robix" },
                        "2": { "name": "entity.name.function.robix" }
                    }
                }
            ]
        },
        "keyword": {
            "patterns": [
                {
                    "name": "constant.language.robix",
                    "match": "(?i)\\b(?:true|false|null)\\b"
                },
                {
                    "name": "storage.type.robix",
                    "match": "(?i)\\b(?:void|any|dynamic|int|uint|float|double|decimal|bool|char|string)\\b"
                },
                {
                    "name": "storage.modifier.robix",
                    "match": "(?i)\\b(?:public|private|protected|internal|abstract|override|virtual|sealed|final|static|partial|unsafe|extern|consteval|iterator|mut|ref|params)\\b"
                },
                {
                    "name": "keyword.control.robix",
                    "match": "(?i)\\b(?:if|else|match|for|in|while|do|repeat|loop|break|continue|return|yield|throw|try|catch|finally|defer|goto|await|async)\\b"
                },
                {
                    "name": "keyword.other.robix",
                    "match": "(?i)\\b(?:package|import|as|permissions|let|var|const|function|test|explain|class|struct|interface|trait|enum|service|implement|implements|connect|constructor|destructor|base|this|using|lock|asm|operator|precedence|leftassociative|rightassociative|and|or|not|equal|is|where|type|macro|callingconvention|out|clobber)\\b"
                }
            ]
        },
        "operator": {
            "name": "keyword.operator.robix",
            "match": "\\.\\.\\.|\\.\\.=|\\.\\.|=>|->|\\?\\.|\\?\\?|==|!=|<=|>=|&&|\\|\\||<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|\\+\\+|--|[{}()\\[\\],.;:@+\\-*/%=<>&|^~!?]"
        }
    }
}
