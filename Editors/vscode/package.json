{
    "name": "Robix",
    "displayName": "Robix",
    "description": "Robix is Roboticela's type-safe language: PascalCase you can read aloud, the control of C, an interpreter to run it, and a compiler that builds a native executable.",
    "version": "0.0.27",
    "publisher": "Roboticela",
    "author": {
        "name": "Roboticela"
    },
    "license": "AGPL-3.0",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Formatters",
        "Snippets"
    ],
    "icon": "icons/RobixLanguage.png",
    "keywords": [
        "robix",
        "rx",
        "rxp",
        "rxu",
        "rx3d"
    ],
    "main": "./extension.js",
    "scripts": {
        "test": "node test/run.js"
    },
    "activationEvents": [
        "onLanguage:robix",
        "onLanguage:robix-project"
    ],
    "contributes": {
        "languages": [
            {
                "id": "robix",
                "aliases": ["Robix", "robix"],
                "extensions": [".rx"],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/Robix.svg",
                    "dark": "./icons/Robix.svg"
                }
            },
            {
                "id": "robix-project",
                "aliases": ["Robix Project", "robix-project"],
                "extensions": [".rxp"],
                "configuration": "./language-configuration-project.json",
                "icon": {
                    "light": "./icons/RobixProject.svg",
                    "dark": "./icons/RobixProject.svg"
                }
            },
            {
                "id": "robix-ui",
                "aliases": ["Robix UI", "robix-ui"],
                "extensions": [".rxu"],
                "icon": {
                    "light": "./icons/RobixUI.svg",
                    "dark": "./icons/RobixUI.svg"
                }
            },
            {
                "id": "robix-3d",
                "aliases": ["Robix 3D", "robix-3d"],
                "extensions": [".rx3d"],
                "icon": {
                    "light": "./icons/Robix3D.svg",
                    "dark": "./icons/Robix3D.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "robix",
                "scopeName": "source.robix",
                "path": "./syntaxes/robix.tmLanguage.json"
            },
            {
                "language": "robix-project",
                "scopeName": "source.robix.project",
                "path": "./syntaxes/robix-project.tmLanguage.json"
            }
        ],
        "themes": [
            {
                "label": "Robix Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/robix-dark.json"
            },
            {
                "label": "Robix Light",
                "uiTheme": "vs",
                "path": "./themes/robix-light.json"
            }
        ],
        "configuration": {
            "title": "Robix",
            "properties": {
                "robix.interpreterPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Robix interpreter. Leave empty to use robix from PATH, then Build/bootstrap/robix-run.app."
                },
                "robix.compilerPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Robix compiler. Leave empty to use robixc from PATH, then Build/bootstrap/robixc.app."
                },
                "robix.autoCorrectKeywords": {
                    "type": "boolean",
                    "default": true,
                    "description": "Rewrite keywords, package names, and function and class names to PascalCase, and variable names to camelCase, when a word is finished."
                },
                "robix.format.indentSize": {
                    "type": "number",
                    "default": 4,
                    "minimum": 1,
                    "description": "Spaces used for each indentation level."
                },
                "robix.diagnostics.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Check the open file with the Robix tools and the built-in language service."
                },
                "robix.run.arguments": {
                    "type": "array",
                    "default": [],
                    "items": { "type": "string" },
                    "description": "Extra arguments passed to a program started with Run."
                }
            }
        },
        "configurationDefaults": {
            "[robix]": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.detectIndentation": false,
                "editor.formatOnSave": true,
                "editor.wordBasedSuggestions": "off",
                "editor.suggest.showWords": false,
                "editor.quickSuggestions": {
                    "other": true,
                    "comments": false,
                    "strings": false
                },
                "editor.snippetSuggestions": "bottom",
                "editor.renderLineHighlight": "line",
                "editor.renderWhitespace": "boundary",
                "editor.guides.indentation": true,
                "editor.guides.highlightActiveIndentation": true,
                "editor.bracketPairColorization.enabled": false,
                "editor.matchBrackets": "always",
                "editor.occurrencesHighlight": "singleFile",
                "editor.selectionHighlight": true,
                "editor.stickyScroll.enabled": true
            },
            "[robix-project]": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.formatOnSave": true,
                "editor.renderLineHighlight": "line",
                "editor.renderWhitespace": "boundary",
                "editor.guides.indentation": true,
                "editor.guides.highlightActiveIndentation": true,
                "editor.bracketPairColorization.enabled": false,
                "editor.matchBrackets": "always"
            },
            "[robix-ui]": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.renderLineHighlight": "line",
                "editor.renderWhitespace": "boundary",
                "editor.guides.indentation": true,
                "editor.guides.highlightActiveIndentation": true,
                "editor.bracketPairColorization.enabled": false,
                "editor.matchBrackets": "always"
            },
            "[robix-3d]": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.renderLineHighlight": "line",
                "editor.renderWhitespace": "boundary",
                "editor.guides.indentation": true,
                "editor.guides.highlightActiveIndentation": true,
                "editor.bracketPairColorization.enabled": false,
                "editor.matchBrackets": "always"
            }
        },
        "commands": [
            {
                "command": "robix.run",
                "title": "Run",
                "category": "Robix",
                "icon": "$(play)"
            },
            {
                "command": "robix.compile",
                "title": "Compile",
                "category": "Robix",
                "icon": "$(tools)"
            },
            {
                "command": "robix.release",
                "title": "Release",
                "category": "Robix",
                "icon": "$(package)"
            },
            {
                "command": "robix.check",
                "title": "Check",
                "category": "Robix",
                "icon": "$(check)"
            }
        ],
        "keybindings": [
            {
                "command": "robix.run",
                "key": "f5",
                "when": "editorTextFocus && (editorLangId == robix || editorLangId == robix-project)"
            },
            {
                "command": "robix.compile",
                "key": "ctrl+f5",
                "mac": "cmd+f5",
                "when": "editorTextFocus && (editorLangId == robix || editorLangId == robix-project)"
            },
            {
                "command": "robix.release",
                "key": "ctrl+shift+f5",
                "mac": "cmd+shift+f5",
                "when": "editorTextFocus && (editorLangId == robix || editorLangId == robix-project)"
            },
            {
                "command": "robix.check",
                "key": "shift+f5",
                "when": "editorTextFocus && editorLangId == robix"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "robix.run",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@1"
                },
                {
                    "command": "robix.compile",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@2"
                },
                {
                    "command": "robix.release",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@3"
                }
            ],
            "editor/context": [
                {
                    "command": "robix.run",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@1"
                },
                {
                    "command": "robix.compile",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@2"
                },
                {
                    "command": "robix.release",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@3"
                }
            ],
            "commandPalette": [
                {
                    "command": "robix.run",
                    "when": "editorLangId == robix || editorLangId == robix-project"
                },
                {
                    "command": "robix.compile",
                    "when": "editorLangId == robix || editorLangId == robix-project"
                },
                {
                    "command": "robix.release",
                    "when": "editorLangId == robix || editorLangId == robix-project"
                },
                {
                    "command": "robix.check",
                    "when": "editorLangId == robix"
                }
            ]
        }
    }
}
