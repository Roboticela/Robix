{
    "name": "Robix",
    "displayName": "Robix",
    "description": "Robix is Roboticela's type-safe language: PascalCase you can read aloud, the control of C, an interpreter to run it, and a compiler that builds a native executable.",
    "version": "0.0.46",
    "publisher": "Roboticela",
    "author": {
        "name": "Roboticela"
    },
    "license": "AGPL-3.0",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Formatters",
        "Snippets"
    ],
    "icon": "icons/RobixLanguage.png",
    "keywords": [
        "robix",
        "rx",
        "rxp",
        "rxu",
        "rx3d"
    ],
    "main": "./extension.js",
    "scripts": {
        "test": "node test/run.js"
    },
    "extensionKind": ["workspace"],
    "activationEvents": [
        "onLanguage:robix",
        "onLanguage:robix-project",
        "onLanguage:robix-ui",
        "onLanguage:robix-3d",
        "onDebugResolve:robix",
        "workspaceContains:**/*.rx",
        "workspaceContains:**/*.rxp"
    ],
    "contributes": {
        "languages": [
            {
                "id": "robix",
                "aliases": ["Robix", "robix"],
                "extensions": [".rx"],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/Robix.svg",
                    "dark": "./icons/Robix.svg"
                }
            },
            {
                "id": "robix-project",
                "aliases": ["Robix Project", "robix-project"],
                "extensions": [".rxp"],
                "configuration": "./language-configuration-project.json",
                "icon": {
                    "light": "./icons/RobixProject.svg",
                    "dark": "./icons/RobixProject.svg"
                }
            },
            {
                "id": "robix-ui",
                "aliases": ["Robix UI", "robix-ui"],
                "extensions": [".rxu"],
                "configuration": "./language-configuration-ui.json",
                "icon": {
                    "light": "./icons/RobixUI.svg",
                    "dark": "./icons/RobixUI.svg"
                }
            },
            {
                "id": "robix-3d",
                "aliases": ["Robix 3D", "robix-3d"],
                "extensions": [".rx3d"],
                "configuration": "./language-configuration-3d.json",
                "icon": {
                    "light": "./icons/Robix3D.svg",
                    "dark": "./icons/Robix3D.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "robix",
                "scopeName": "source.robix",
                "path": "./syntaxes/robix.tmLanguage.json"
            },
            {
                "language": "robix-project",
                "scopeName": "source.robix.project",
                "path": "./syntaxes/robix-project.tmLanguage.json"
            },
            {
                "language": "robix-ui",
                "scopeName": "source.robix.ui",
                "path": "./syntaxes/robix-ui.tmLanguage.json"
            },
            {
                "language": "robix-3d",
                "scopeName": "source.robix.3d",
                "path": "./syntaxes/robix-3d.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "robix",
                "path": "./snippets/robix.code-snippets"
            }
        ],
        "breakpoints": [
            { "language": "robix" },
            { "language": "robix-project" }
        ],
        "themes": [
            {
                "label": "Robix Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/robix-dark.json"
            },
            {
                "label": "Robix Light",
                "uiTheme": "vs",
                "path": "./themes/robix-light.json"
            }
        ],
        "configuration": {
            "title": "Robix",
            "properties": {
                "robix.interpreterPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Robix interpreter. Leave empty to use robix from PATH, then Build/Compiler/Robix.app."
                },
                "robix.compilerPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Robix compiler. Leave empty to use robixc from PATH, then Build/bootstrap/robixc.app."
                },
                "robix.autoCorrectKeywords": {
                    "type": "boolean",
                    "default": true,
                    "description": "Rewrite keywords, package names, and function and class names to PascalCase, and variable names to camelCase, when a word is finished."
                },
                "robix.format.indentSize": {
                    "type": "number",
                    "default": 4,
                    "minimum": 1,
                    "description": "Spaces used for each indentation level."
                },
                "robix.diagnostics.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Check the open file with the Robix tools and the built-in language service."
                },
                "robix.run.arguments": {
                    "type": "array",
                    "default": [],
                    "items": { "type": "string" },
                    "description": "Extra arguments passed to a program started with Run or used when a launch configuration leaves args empty."
                },
                "robix.languageServer.path": {
                    "type": "string",
                    "default": "",
                    "description": "Path to robix-server. Leave empty to start the server shipped with this extension."
                },
                "robix.languageServer.trace": {
                    "type": "string",
                    "default": "Info",
                    "enum": ["Error", "Warning", "Info", "Debug", "Trace"],
                    "description": "Trace level written to the Robix Language channel."
                },
                "robix.packages.exclude": {
                    "type": "array",
                    "default": [],
                    "items": { "type": "string" },
                    "description": "Package names left out of completion."
                },
                "robix.files.exclude": {
                    "type": "array",
                    "default": ["**/Build/**", "**/node_modules/**"],
                    "items": { "type": "string" },
                    "description": "Glob patterns left out of the workspace scan."
                },
                "robix.maxFileSize": {
                    "type": "number",
                    "default": 1048576,
                    "description": "Files larger than this many characters keep syntax coloring and skip the language service."
                },
                "robix.analysis.delay": {
                    "type": "number",
                    "default": 400,
                    "description": "Milliseconds to wait after a keystroke before checking the file."
                },
                "robix.diagnostics.level": {
                    "type": "string",
                    "default": "Warning",
                    "enum": ["Error", "Warning", "Information"],
                    "description": "Lowest diagnostic severity to show."
                },
                "robix.suggest.autoImport": {
                    "type": "boolean",
                    "default": true,
                    "description": "Insert Import when a completion comes from a package this file has not imported."
                },
                "robix.suggest.commitCharacters": {
                    "type": "boolean",
                    "default": true,
                    "description": "Commit a completion when you type . or (."
                },
                "robix.inlayHints.parameterNames": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show parameter names at call sites."
                },
                "robix.inlayHints.types": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show inferred types on declarations that omit them."
                },
                "robix.format.onType": {
                    "type": "boolean",
                    "default": false,
                    "description": "Format the file when you type }, a semicolon, or a newline."
                },
                "robix.debug.justMyCode": {
                    "type": "boolean",
                    "default": true,
                    "description": "Hide stack frames that are not Robix source."
                }
            }
        },
        "configurationDefaults": {
            "[robix]": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.detectIndentation": false,
                "editor.formatOnSave": true,
                "editor.wordBasedSuggestions": "off",
                "editor.suggest.showWords": false,
                "editor.quickSuggestions": {
                    "other": true,
                    "comments": false,
                    "strings": false
                },
                "editor.snippetSuggestions": "bottom",
                "editor.renderLineHighlight": "line",
                "editor.renderWhitespace": "boundary",
                "editor.guides.indentation": true,
                "editor.guides.highlightActiveIndentation": true,
                "editor.bracketPairColorization.enabled": false,
                "editor.matchBrackets": "always",
                "editor.occurrencesHighlight": "singleFile",
                "editor.selectionHighlight": true,
                "editor.stickyScroll.enabled": true
            },
            "[robix-project]": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.formatOnSave": true,
                "editor.renderLineHighlight": "line",
                "editor.renderWhitespace": "boundary",
                "editor.guides.indentation": true,
                "editor.guides.highlightActiveIndentation": true,
                "editor.bracketPairColorization.enabled": false,
                "editor.matchBrackets": "always"
            },
            "[robix-ui]": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.renderLineHighlight": "line",
                "editor.renderWhitespace": "boundary",
                "editor.guides.indentation": true,
                "editor.guides.highlightActiveIndentation": true,
                "editor.bracketPairColorization.enabled": false,
                "editor.matchBrackets": "always"
            },
            "[robix-3d]": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.renderLineHighlight": "line",
                "editor.renderWhitespace": "boundary",
                "editor.guides.indentation": true,
                "editor.guides.highlightActiveIndentation": true,
                "editor.bracketPairColorization.enabled": false,
                "editor.matchBrackets": "always"
            }
        },
        "commands": [
            { "command": "robix.run", "title": "Run", "category": "Robix", "icon": "$(play)" },
            { "command": "robix.compile", "title": "Compile", "category": "Robix", "icon": "$(tools)" },
            { "command": "robix.build", "title": "Build", "category": "Robix", "icon": "$(tools)" },
            { "command": "robix.rebuild", "title": "Rebuild", "category": "Robix" },
            { "command": "robix.release", "title": "Release", "category": "Robix", "icon": "$(package)" },
            { "command": "robix.check", "title": "Check", "category": "Robix", "icon": "$(check)" },
            { "command": "robix.configure", "title": "Configure", "category": "Robix" },
            { "command": "robix.clean", "title": "Clean", "category": "Robix" },
            { "command": "robix.debug.start", "title": "Start Debugging", "category": "Robix", "icon": "$(debug)" },
            { "command": "robix.selectConfiguration", "title": "Select a Configuration", "category": "Robix" },
            { "command": "robix.editConfigurations", "title": "Edit Configurations (UI)", "category": "Robix" },
            { "command": "robix.selectTarget", "title": "Select Target", "category": "Robix" },
            { "command": "robix.selectMode", "title": "Select Mode", "category": "Robix" },
            { "command": "robix.restartServer", "title": "Restart Language Server", "category": "Robix" },
            { "command": "robix.rescan", "title": "Rescan Workspace", "category": "Robix" },
            { "command": "robix.resetDatabase", "title": "Reset IntelliSense Database", "category": "Robix" },
            { "command": "robix.logDiagnostics", "title": "Log Diagnostics", "category": "Robix" },
            { "command": "robix.runCodeAnalysis", "title": "Run Code Analysis", "category": "Robix" },
            { "command": "robix.fixAll", "title": "Fix All", "category": "Robix" },
            { "command": "robix.switchSourceTest", "title": "Switch Source and Test", "category": "Robix" },
            { "command": "robix.runTestsInFile", "title": "Run Tests in Current File", "category": "Robix" },
            { "command": "robix.debugTestAtCursor", "title": "Debug Test at Cursor", "category": "Robix" },
            { "command": "robix.preview", "title": "Preview", "category": "Robix" },
            { "command": "robix.discoverToolchain", "title": "Discover Toolchain", "category": "Robix" },
            { "command": "robix.selectProject", "title": "Select Project", "category": "Robix" }
        ],
        "keybindings": [
            {
                "command": "robix.run",
                "key": "ctrl+f6",
                "mac": "cmd+f6",
                "when": "editorTextFocus && (editorLangId == robix || editorLangId == robix-project)"
            },
            {
                "command": "robix.switchSourceTest",
                "key": "alt+o",
                "mac": "alt+o",
                "when": "editorTextFocus && editorLangId == robix"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "robix.configure",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@1"
                },
                {
                    "command": "robix.build",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@2"
                },
                {
                    "command": "robix.debug.start",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@3"
                }
            ],
            "editor/context": [
                {
                    "command": "robix.run",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@1"
                },
                {
                    "command": "robix.compile",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@2"
                },
                {
                    "command": "robix.release",
                    "when": "editorLangId == robix || editorLangId == robix-project",
                    "group": "navigation@3"
                }
            ],
            "commandPalette": [
                { "command": "robix.run", "when": "editorLangId == robix || editorLangId == robix-project" },
                { "command": "robix.compile", "when": "editorLangId == robix || editorLangId == robix-project" },
                { "command": "robix.build", "when": "editorLangId == robix || editorLangId == robix-project" },
                { "command": "robix.release", "when": "editorLangId == robix || editorLangId == robix-project" },
                { "command": "robix.check", "when": "editorLangId == robix" },
                { "command": "robix.preview", "when": "editorLangId == robix-ui || editorLangId == robix-3d" }
            ]
        },
        "taskDefinitions": [
            {
                "type": "robix",
                "required": ["task"],
                "properties": {
                    "task": {
                        "type": "string",
                        "enum": ["Configure", "Build", "Rebuild", "Clean", "Release", "Check", "Run", "Test"]
                    }
                }
            }
        ],
        "problemMatchers": [
            {
                "name": "robix",
                "owner": "robixc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(error|warning|info)\\s+(RX\\d+)\\s+(\\d+):(\\d+)\\s+(.*)$",
                    "severity": 1,
                    "code": 2,
                    "line": 3,
                    "column": 4,
                    "message": 5
                }
            }
        ],
        "debuggers": [
            {
                "type": "robix",
                "label": "Robix",
                "program": "./debug/adapter.js",
                "runtime": "node",
                "languages": ["robix", "robix-project"],
                "configurationAttributes": {
                    "launch": {
                        "required": [],
                        "properties": {
                            "program": { "type": "string", "description": "Robix source file or executable.", "default": "${file}" },
                            "args": { "type": "array", "items": { "type": "string" }, "default": [] },
                            "cwd": { "type": "string", "default": "${workspaceFolder}" },
                            "stopOnEntry": { "type": "boolean", "default": false },
                            "target": { "type": "string", "default": "linux-x64" },
                            "mode": { "type": "string", "enum": ["Debug", "Release"], "default": "Debug" },
                            "console": { "type": "string", "enum": ["integratedTerminal", "internalConsole"], "default": "integratedTerminal" },
                            "justMyCode": { "type": "boolean", "default": true },
                            "coreDumpPath": { "type": "string" }
                        }
                    },
                    "attach": {
                        "required": [],
                        "properties": {
                            "processId": { "type": "string" },
                            "host": { "type": "string" },
                            "port": { "type": "number" },
                            "program": { "type": "string" }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "robix",
                        "request": "launch",
                        "name": "Robix",
                        "program": "${file}",
                        "cwd": "${workspaceFolder}",
                        "stopOnEntry": false,
                        "mode": "Debug"
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Robix: Launch",
                        "description": "Debug the active Robix file.",
                        "body": {
                            "type": "robix",
                            "request": "launch",
                            "name": "Robix",
                            "program": "^\"\\${file}\"",
                            "args": [],
                            "cwd": "^\"\\${workspaceFolder}\"",
                            "stopOnEntry": false,
                            "target": "linux-x64",
                            "mode": "Debug",
                            "console": "integratedTerminal"
                        }
                    }
                ]
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "robix.project",
                    "name": "Robix Project"
                }
            ]
        },
        "walkthroughs": [
            {
                "id": "robix.start",
                "title": "Get started with Robix",
                "description": "Build, debug, and test a Robix program.",
                "steps": [
                    {
                        "id": "open",
                        "title": "Open a Robix file",
                        "description": "A .rx file is a program. The status bar shows the configuration and the target.",
                        "media": { "markdown": "walkthrough/start.md" }
                    },
                    {
                        "id": "build",
                        "title": "Build",
                        "description": "Ctrl+Shift+B runs the build task after you trust the workspace.",
                        "media": { "markdown": "walkthrough/start.md" }
                    },
                    {
                        "id": "debug",
                        "title": "Debug",
                        "description": "F5 starts debugging. F9 sets a breakpoint. Ctrl+F5 runs without debugging.",
                        "media": { "markdown": "walkthrough/start.md" }
                    },
                    {
                        "id": "test",
                        "title": "Run a test",
                        "description": "The Testing view lists every Test. Alt+O switches the source and the companion test.",
                        "media": { "markdown": "walkthrough/start.md" }
                    }
                ]
            }
        ]
    }
}
