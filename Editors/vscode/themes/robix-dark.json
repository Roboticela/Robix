{
    "name": "Robix Dark",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#1E1E1E",
        "editor.foreground": "#DCDCDC",
        "editor.lineHighlightBackground": "#00000000",
        "editor.lineHighlightBorder": "#464646",
        "editor.selectionBackground": "#264F78",
        "editor.inactiveSelectionBackground": "#3A3D41",
        "editor.selectionHighlightBackground": "#ADD6FF26",
        "editor.wordHighlightBackground": "#57575780",
        "editor.wordHighlightBorder": "#00000000",
        "editorCursor.foreground": "#AEAFAD",
        "editorLineNumber.foreground": "#858585",
        "editorLineNumber.activeForeground": "#C6C6C6",
        "editorWhitespace.foreground": "#505050",
        "editorIndentGuide.background1": "#404040",
        "editorIndentGuide.activeBackground1": "#707070",
        "editorBracketMatch.background": "#00000000",
        "editorBracketMatch.border": "#888888",
        "editorError.foreground": "#F44747",
        "editorWarning.foreground": "#CCA700",
        "editorInfo.foreground": "#3794FF",
        "editorWidget.background": "#252526",
        "editorWidget.border": "#454545",
        "editorSuggestWidget.background": "#252526",
        "editorSuggestWidget.border": "#454545",
        "editorSuggestWidget.selectedBackground": "#094771",
        "editorSuggestWidget.foreground": "#DCDCDC",
        "editorHoverWidget.background": "#252526",
        "editorHoverWidget.border": "#454545",
        "focusBorder": "#007ACC",
        "foreground": "#CCCCCC",
        "descriptionForeground": "#A0A0A0",
        "errorForeground": "#F44747",
        "widget.shadow": "#00000000",
        "scrollbar.shadow": "#00000000",
        "sideBar.background": "#252526",
        "sideBar.foreground": "#CCCCCC",
        "sideBar.border": "#2D2D30",
        "sideBarSectionHeader.background": "#252526",
        "sideBarTitle.foreground": "#BBBBBB",
        "activityBar.background": "#2D2D30",
        "activityBar.foreground": "#FFFFFF",
        "activityBar.inactiveForeground": "#969696",
        "activityBar.border": "#2D2D30",
        "activityBar.activeBorder": "#007ACC",
        "activityBarBadge.background": "#007ACC",
        "activityBarBadge.foreground": "#FFFFFF",
        "titleBar.activeBackground": "#2D2D30",
        "titleBar.activeForeground": "#CCCCCC",
        "titleBar.inactiveBackground": "#2D2D30",
        "titleBar.border": "#2D2D30",
        "statusBar.background": "#007ACC",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.border": "#007ACC",
        "statusBar.noFolderBackground": "#68217A",
        "editorGroupHeader.tabsBackground": "#2D2D30",
        "tab.activeBackground": "#1E1E1E",
        "tab.inactiveBackground": "#2D2D30",
        "tab.activeForeground": "#FFFFFF",
        "tab.inactiveForeground": "#969696",
        "tab.border": "#2D2D30",
        "tab.activeBorderTop": "#007ACC",
        "panel.background": "#1E1E1E",
        "panel.border": "#2D2D30",
        "panelTitle.activeBorder": "#007ACC",
        "terminal.background": "#1E1E1E",
        "terminal.foreground": "#CCCCCC",
        "input.background": "#3C3C3C",
        "input.border": "#3C3C3C",
        "input.foreground": "#CCCCCC",
        "dropdown.background": "#3C3C3C",
        "dropdown.border": "#3C3C3C",
        "button.background": "#0E639C",
        "button.foreground": "#FFFFFF",
        "button.border": "#00000000",
        "list.activeSelectionBackground": "#094771",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.hoverBackground": "#2A2D2E",
        "list.inactiveSelectionBackground": "#37373D",
        "badge.background": "#007ACC",
        "badge.foreground": "#FFFFFF",
        "progressBar.background": "#007ACC",
        "menu.background": "#252526",
        "menu.foreground": "#CCCCCC",
        "menu.border": "#454545"
    },
    "semanticTokenColors": {
        "keyword": "#569CD6",
        "keyword.control": "#D8A0DF",
        "keyword.modifier": "#569CD6",
        "keyword.readonly": "#569CD6",
        "type": "#4EC9B0",
        "type.defaultLibrary": "#4EC9B0",
        "class": "#4EC9B0",
        "struct": "#86C691",
        "interface": "#B8D7A3",
        "enum": "#B8D7A3",
        "enumMember": "#DCDCDC",
        "typeParameter": "#B8D7A3",
        "function": "#DCDCAA",
        "method": "#DCDCAA",
        "macro": "#DCDCAA",
        "parameter": "#9CDCFE",
        "variable": "#9CDCFE",
        "variable.readonly": "#9CDCFE",
        "property": "#DCDCDC",
        "namespace": "#DCDCDC",
        "decorator": "#4EC9B0",
        "string": "#D69D85",
        "number": "#B5CEA8",
        "comment": "#57A64A",
        "operator": "#DCDCDC"
    },
    "tokenColors": [
        {
            "scope": ["comment"],
            "settings": { "foreground": "#57A64A" }
        },
        {
            "scope": ["keyword.control", "keyword.control.robix"],
            "settings": { "foreground": "#D8A0DF" }
        },
        {
            "scope": ["keyword", "keyword.other", "keyword.declaration", "storage.modifier", "storage.type", "constant.language"],
            "settings": { "foreground": "#569CD6" }
        },
        {
            "scope": ["entity.name.type", "support.type", "entity.name.tag"],
            "settings": { "foreground": "#4EC9B0" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#DCDCAA" }
        },
        {
            "scope": ["variable", "variable.parameter", "variable.other"],
            "settings": { "foreground": "#9CDCFE" }
        },
        {
            "scope": ["string", "constant.character"],
            "settings": { "foreground": "#D69D85" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#B5CEA8" }
        },
        {
            "scope": ["keyword.operator", "punctuation"],
            "settings": { "foreground": "#DCDCDC" }
        }
    ]
}
