{
    "name": "Robix Light",
    "type": "light",
    "semanticHighlighting": true,
    "colors": {
        "editor.background": "#FFFFFF",
        "editor.foreground": "#000000",
        "editor.lineHighlightBackground": "#00000000",
        "editor.lineHighlightBorder": "#C8C8C8",
        "editor.selectionBackground": "#ADD6FF",
        "editor.inactiveSelectionBackground": "#E5EBF1",
        "editor.selectionHighlightBackground": "#ADD6FF80",
        "editor.wordHighlightBackground": "#D0D0D080",
        "editor.wordHighlightBorder": "#00000000",
        "editorCursor.foreground": "#000000",
        "editorLineNumber.foreground": "#2B91AF",
        "editorLineNumber.activeForeground": "#0B216F",
        "editorWhitespace.foreground": "#B0B0B0",
        "editorIndentGuide.background1": "#D3D3D3",
        "editorIndentGuide.activeBackground1": "#939393",
        "editorBracketMatch.background": "#00000000",
        "editorBracketMatch.border": "#B4B4B4",
        "editorError.foreground": "#E51400",
        "editorWarning.foreground": "#B89500",
        "editorInfo.foreground": "#1A85FF",
        "editorWidget.background": "#F3F3F3",
        "editorWidget.border": "#CCCEDB",
        "editorSuggestWidget.background": "#F3F3F3",
        "editorSuggestWidget.border": "#CCCEDB",
        "editorSuggestWidget.selectedBackground": "#CCE8FF",
        "editorSuggestWidget.foreground": "#000000",
        "editorHoverWidget.background": "#F3F3F3",
        "editorHoverWidget.border": "#CCCEDB",
        "focusBorder": "#007ACC",
        "foreground": "#1E1E1E",
        "descriptionForeground": "#6F6F6F",
        "errorForeground": "#E51400",
        "widget.shadow": "#00000000",
        "scrollbar.shadow": "#00000000",
        "sideBar.background": "#F3F3F3",
        "sideBar.foreground": "#1E1E1E",
        "sideBar.border": "#EEEEF2",
        "sideBarSectionHeader.background": "#F3F3F3",
        "sideBarTitle.foreground": "#6F6F6F",
        "activityBar.background": "#F3F3F3",
        "activityBar.foreground": "#1E1E1E",
        "activityBar.inactiveForeground": "#6F6F6F",
        "activityBar.border": "#EEEEF2",
        "activityBar.activeBorder": "#007ACC",
        "activityBarBadge.background": "#007ACC",
        "activityBarBadge.foreground": "#FFFFFF",
        "titleBar.activeBackground": "#F3F3F3",
        "titleBar.activeForeground": "#1E1E1E",
        "titleBar.inactiveBackground": "#F3F3F3",
        "titleBar.border": "#EEEEF2",
        "statusBar.background": "#007ACC",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.border": "#007ACC",
        "statusBar.noFolderBackground": "#68217A",
        "editorGroupHeader.tabsBackground": "#F3F3F3",
        "tab.activeBackground": "#FFFFFF",
        "tab.inactiveBackground": "#ECECEC",
        "tab.activeForeground": "#1E1E1E",
        "tab.inactiveForeground": "#6F6F6F",
        "tab.border": "#EEEEF2",
        "tab.activeBorderTop": "#007ACC",
        "panel.background": "#FFFFFF",
        "panel.border": "#EEEEF2",
        "panelTitle.activeBorder": "#007ACC",
        "terminal.background": "#FFFFFF",
        "terminal.foreground": "#1E1E1E",
        "input.background": "#FFFFFF",
        "input.border": "#CCCEDB",
        "input.foreground": "#1E1E1E",
        "dropdown.background": "#FFFFFF",
        "dropdown.border": "#CCCEDB",
        "button.background": "#0E639C",
        "button.foreground": "#FFFFFF",
        "button.border": "#00000000",
        "list.activeSelectionBackground": "#0078D4",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.hoverBackground": "#E8E8E8",
        "list.inactiveSelectionBackground": "#CCE8FF",
        "badge.background": "#007ACC",
        "badge.foreground": "#FFFFFF",
        "progressBar.background": "#007ACC",
        "menu.background": "#FFFFFF",
        "menu.foreground": "#1E1E1E",
        "menu.border": "#CCCEDB"
    },
    "semanticTokenColors": {
        "keyword": "#0000FF",
        "keyword.control": "#8F08C4",
        "keyword.modifier": "#0000FF",
        "keyword.readonly": "#0000FF",
        "type": "#2B91AF",
        "type.defaultLibrary": "#2B91AF",
        "class": "#2B91AF",
        "struct": "#2B91AF",
        "interface": "#2B91AF",
        "enum": "#2B91AF",
        "enumMember": "#2B91AF",
        "typeParameter": "#2B91AF",
        "function": "#74531F",
        "method": "#74531F",
        "macro": "#74531F",
        "parameter": "#1F377F",
        "variable": "#1F377F",
        "variable.readonly": "#1F377F",
        "property": "#000000",
        "namespace": "#0451A5",
        "decorator": "#2B91AF",
        "string": "#A31515",
        "number": "#098658",
        "comment": "#008000",
        "operator": "#000000"
    },
    "tokenColors": [
        {
            "scope": ["comment"],
            "settings": { "foreground": "#008000" }
        },
        {
            "scope": ["keyword.control", "keyword.control.robix"],
            "settings": { "foreground": "#8F08C4" }
        },
        {
            "scope": ["keyword", "keyword.other", "keyword.declaration", "storage.modifier", "storage.type", "constant.language"],
            "settings": { "foreground": "#0000FF" }
        },
        {
            "scope": ["entity.name.type", "support.type", "entity.name.tag"],
            "settings": { "foreground": "#2B91AF" }
        },
        {
            "scope": ["entity.name.function", "support.function"],
            "settings": { "foreground": "#74531F" }
        },
        {
            "scope": ["entity.name.namespace"],
            "settings": { "foreground": "#0451A5" }
        },
        {
            "scope": ["variable", "variable.parameter", "variable.other"],
            "settings": { "foreground": "#1F377F" }
        },
        {
            "scope": ["string", "constant.character"],
            "settings": { "foreground": "#A31515" }
        },
        {
            "scope": ["constant.numeric"],
            "settings": { "foreground": "#098658" }
        },
        {
            "scope": ["keyword.operator", "punctuation"],
            "settings": { "foreground": "#000000" }
        }
    ]
}
