// Tree-walk interpreter for Robix's executable syntax.
Package Robix.Runtime;

Import Robix.Core;
Import Robix.Syntax;


Public Enum ValueKind {
    None,
    Integer,
    Float,
    Boolean,
    Text,
    Null,
    Array,
    Function,
    Void,
    Object
}

Public Class Value {
    Public ValueKind Kind;
    Public Int Integer;
    Public Float FloatValue;
    Public Bool Boolean;
    Public String Text;
    Public List<Value> Elements;
    Public List<String> FieldNames;
    Public AstNode? FunctionNode;

    Public Constructor() {
        This.Kind = ValueKind.None;
        This.Integer = 0;
        This.FloatValue = 0.0;
        This.Boolean = False;
        This.Text = "";
        This.Elements = List<Value>();
        This.FieldNames = List<String>();
        This.FunctionNode = Null;
    }
}

Public Class Interpreter {
    Private List<String> names;
    Private List<Value> values;
    Private List<Int> marks;
    Private List<String> lines;
    Private List<String> runtimeErrors;
    Private String signal;
    Private Value returnValue;
    Private Value thrown;
    Private List<Value> yields;
    Private List<AstNode> defers;
    Private String constructing;
    Private List<AstNode> functions;
    Private List<String> functionOwners;
    Private String collectOwner;
    Private List<AstNode> types;
    Private List<AstNode> macros;
    Private List<String> operatorKeys;
    Private List<AstNode> operatorNodes;
    Private Bool inTests;
    Private Bool consoleEnabled;
    Private Int consolePort;
    Private List<String> programArguments;
    Private List<String> importAliasNames;
    Private List<String> importAliasPackages;
    Private List<String> packageFunctionNames;
    Private List<String> packageFunctionPackages;
    Private String walkPackage;

    Public Constructor() {
        This.names = List<String>();
        This.values = List<Value>();
        This.marks = List<Int>();
        This.lines = List<String>();
        This.runtimeErrors = List<String>();
        This.signal = "";
        This.returnValue = This.MakeVoid();
        This.thrown = This.MakeVoid();
        This.yields = List<Value>();
        This.defers = List<AstNode>();
        This.constructing = "";
        This.functions = List<AstNode>();
        This.functionOwners = List<String>();
        This.collectOwner = "";
        This.types = List<AstNode>();
        This.macros = List<AstNode>();
        This.operatorKeys = List<String>();
        This.operatorNodes = List<AstNode>();
        This.inTests = False;
        This.consoleEnabled = True;
        This.consolePort = 0;
        This.programArguments = List<String>();
        This.importAliasNames = List<String>();
        This.importAliasPackages = List<String>();
        This.packageFunctionNames = List<String>();
        This.packageFunctionPackages = List<String>();
        This.walkPackage = "";
    }

    Public Function SetConsole(Bool enabled, Int port) -> Void
    Explain {
        Description: "Choose whether the runtime creates a console and which port it owns.";
        Input: enabled = "False hides program output", port = "Console port, or zero when unset";
        Processing: "Store the console flag and port. Print and logs honor the flag.";
        Output: "No return value.";
    } {
        This.consoleEnabled = enabled;
        This.consolePort = port;
    }

    Public Function Execute(AstNode module, List<String> arguments) -> Int
    Explain {
        Description: "Execute a parsed Robix module.";
        Input: module = "Module syntax tree", arguments = "Command-line arguments passed to Main";
        Processing: "Define functions, then call Main when it exists. Otherwise run top-level statements.";
        Output: "The process exit integer.";
    } {
        This.programArguments = arguments;
        This.importAliasNames = List<String>();
        This.importAliasPackages = List<String>();
        This.packageFunctionNames = List<String>();
        This.packageFunctionPackages = List<String>();
        This.CollectImportAliases(module);
        This.PushScope();
        This.CollectFunctions(module);
        For child In module.Children {
            If (child.Kind == AstKind.Variable) {
                This.ExecuteNode(child);
            }
        }
        AstNode? entry = AstNode();
        Bool entryFound = False;
        String entryOwner = "";
        Int entryCount = 0;
        Int entryIndex = 0;
        While (entryIndex < This.functions.Count()) {
            If (This.functions[entryIndex].Name == "Main") {
                entryCount = entryCount + 1;
                entry = This.functions[entryIndex];
                entryFound = True;
                entryOwner = This.functionOwners[entryIndex];
            }
            entryIndex = entryIndex + 1;
        }
        Int exitCode = 0;
        If (entryCount > 1) {
            This.runtimeErrors.Add("A file can define only one Main.");
            This.PopScope();
            Return 1;
        }
        If (entryFound && entry != Null) {
            If (entryOwner != "") { This.PrepareThis(entryOwner); }
            Value argumentArray = This.MakeArray();
            For argument In arguments {
                argumentArray.Elements.Add(This.MakeText(argument));
            }
            Var args = List<Value>();
            args.Add(argumentArray);
            Value result = This.CallFunction(entry, args);
            If (result.Kind == ValueKind.Integer) {
                exitCode = result.Integer;
            }
        } Else {
            For child In module.Children {
                If (child.Kind != AstKind.Function && child.Kind != AstKind.Class) {
                    This.ExecuteNode(child);
                }
            }
        }
        This.PopScope();
        Return exitCode;
    }

    Public Function Lines() -> List<String>
    Explain {
        Description: "Return text written by Print during execution.";
        Input: None;
        Processing: "Read the captured output lines.";
        Output: "The output lines in order.";
    } {
        Return This.lines;
    }

    Public Function RequireTests(String sourcePath, AstNode module) -> List<String>
    Explain {
        Description: "Run the companion tests for a source file.";
        Input: sourcePath = "Source file path", module = "Parsed source module";
        Processing: "The interpreter ignores a missing companion and a function that has no test. When the companion exists, it runs every test. The compiler reports missing tests itself.";
        Output: "Error lines from tests that ran. An empty list means nothing failed or there was nothing to run.";
    } {
        Var errors = List<String>();
        If (sourcePath.EndsWith(".test.rx") || !sourcePath.EndsWith(".rx")) {
            Return errors;
        }
        String companion = sourcePath.Substring(0, sourcePath.Length() - 3) + ".test.rx";
        If (!Files.Exists(companion)) {
            Return errors;
        }
        DiagnosticBag diagnostics = DiagnosticBag();
        Lexer lexer = Lexer(Files.ReadText(companion), diagnostics);
        Parser parser = Parser(lexer.Tokenize(), diagnostics);
        AstNode tests = parser.Parse();
        If (diagnostics.ErrorCount() > 0) {
            For item In diagnostics.All() {
                errors.Add(FormatDiagnostic(item));
            }
            Return errors;
        }
        This.PushScope();
        If ((sourcePath.Contains("ParserStatements") || sourcePath.Contains("ParserExpressions")) && Files.Exists("Parser.rx")) {
            DiagnosticBag dp = DiagnosticBag();
            Lexer lp = Lexer(Files.ReadText("Parser.rx"), dp);
            Parser pp = Parser(lp.Tokenize(), dp);
            This.CollectFunctions(pp.Parse());
        }
        This.CollectFunctions(module);
        For child In module.Children {
            If (child.Kind == AstKind.Variable) {
                This.ExecuteNode(child);
            }
        }
        This.inTests = True;
        This.RunParsedTests(tests, errors);
        This.inTests = False;
        This.PopScope();
        Return errors;
    }

    Public Function RuntimeErrors() -> List<String>
    Explain {
        Description: "Return runtime type and evaluation errors.";
        Input: None;
        Processing: "Read errors reported while the module ran.";
        Output: "The runtime error lines.";
    } {
        Return This.runtimeErrors;
    }

    Private Function CollectTestNames(AstNode node, AstKind kind, List<String> names) -> Void {
        If (This.IsImported(node)) {
            Return;
        }
        If (node.Kind == kind && node.Name != "" && !This.HasTestName(names, node.Name)) {
            names.Add(node.Name);
        }
        For child In node.Children {
            This.CollectTestNames(child, kind, names);
        }
        If (node.Body != Null) {
            This.CollectTestNames(node.Body, kind, names);
        }
    }

    Private Function IsImported(AstNode node) -> Bool {
        For modifier In node.Modifiers {
            If (modifier == "Imported") { Return True; }
        }
        Return False;
    }

    Private Function HasTestName(List<String> names, String name) -> Bool {
        For existing In names {
            If (existing == name) { Return True; }
        }
        Return False;
    }

    Private Function RunParsedTests(AstNode node, List<String> errors) -> Void {
        If (node.Kind == AstKind.Test) {
            Bool hasCase = False;
            For child In node.Children {
                If (child.Kind == AstKind.Test && child.FlagB) { hasCase = True; }
            }
            If (node.FlagB || !hasCase) {
                String failure = This.RunOneTest(node);
                If (failure != "") { errors.Add(failure); }
            }
        }
        For child In node.Children {
            This.RunParsedTests(child, errors);
        }
        If (node.Body != Null) {
            This.RunParsedTests(node.Body, errors);
        }
    }

    Private Function RunOneTest(AstNode test) -> String {
        This.runtimeErrors = List<String>();
        This.PushScope();
        For binding In test.Parameters {
            Value value = This.MakeInt(0);
            If (binding.Initializer != Null) { value = This.Evaluate(binding.Initializer); }
            This.Define(binding.Name, value);
        }
        If (This.runtimeErrors.Count() > 0) {
            String message = This.runtimeErrors[0];
            This.PopScope();
            Return "error RX121 Test " + test.Name + " failed. " + message;
        }
        If (test.Left != Null && !This.IsTruthy(This.Evaluate(test.Left))) {
            This.PopScope();
            Return "error RX121 Test " + test.Name + " failed. Constraint was false.";
        }
        Value processing = This.MakeVoid();
        Bool hasProcessing = test.Right != Null;
        If (hasProcessing) { processing = This.Evaluate(test.Right); }
        Value expected = This.MakeVoid();
        Bool hasOutput = test.Extra != Null;
        If (hasOutput) { expected = This.Evaluate(test.Extra); }
        If (This.runtimeErrors.Count() > 0) {
            String message = This.runtimeErrors[0];
            This.PopScope();
            Return "error RX121 Test " + test.Name + " failed. " + message;
        }
        Bool hasCheck = False;
        For child In test.Children {
            If (child.Kind != AstKind.Test) { hasCheck = True; }
        }
        If (!test.FlagA && !hasOutput && !hasCheck) {
            This.PopScope();
            Return "error RX121 Test " + This.TestTitle(test) + " must declare Output.";
        }
        Bool expectFailure = This.ExpectsFailure(test);
        Value actual = This.MakeVoid();
        Bool called = False;
        If (test.FlagA) {
            If (test.Suffix != "") { This.PrepareThis(test.Suffix); }
            AstNode? function = This.FindTestFunction(test.Suffix, test.Name);
            If (function == Null) {
                This.PopScope();
                Return "error RX121 Test " + This.TestTitle(test) + " failed. The function is not defined.";
            }
            Var arguments = List<Value>();
            For parameter In function.Parameters {
                If (!parameter.FlagC) {
                    Value argument = This.BlankArgument(parameter);
                    For binding In test.Parameters {
                        If (binding.Name == parameter.Name) { argument = This.Lookup(parameter.Name); }
                    }
                    arguments.Add(argument);
                }
            }
            actual = This.CallFunction(function, arguments);
            called = True;
            If (This.runtimeErrors.Count() > 0 && !expectFailure) {
                String message = This.runtimeErrors[0];
                This.PopScope();
                Return "error RX121 Test " + This.TestTitle(test) + " failed. " + message;
            }
            If (This.runtimeErrors.Count() == 0 && expectFailure) {
                This.PopScope();
                Return "error RX121 Test " + This.TestTitle(test) + " failed. The call was expected to fail.";
            }
            This.runtimeErrors = List<String>();
            If (!expectFailure) {
                This.Define("Result", actual);
                If (hasOutput && !This.Same(actual, expected)) {
                    This.PopScope();
                    Return "error RX121 Test " + This.TestTitle(test) + " failed. Output expected " + This.Display(expected) + " but the function returned " + This.Display(actual) + ".";
                }
                If (hasProcessing && !This.Same(actual, processing)) {
                    This.PopScope();
                    Return "error RX121 Test " + This.TestTitle(test) + " failed. Processing expected " + This.Display(processing) + " but the function returned " + This.Display(actual) + ".";
                }
            }
        } Else If (hasProcessing && hasOutput && !This.Same(processing, expected)) {
            This.PopScope();
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Processing and Output do not match.";
        }
        String checkFailure = This.RunChecks(test, actual, called);
        This.PopScope();
        Return checkFailure;
    }

    Private Function TestTitle(AstNode test) -> String {
        If (test.Text == "") { Return test.Name; }
        Return test.Name + " " + test.Text;
    }

    Private Function ExpectsFailure(AstNode test) -> Bool {
        For child In test.Children {
            If (child.Name == "Fails" && child.Left != Null && This.IsTruthy(This.Evaluate(child.Left))) {
                Return True;
            }
        }
        Return False;
    }

    Private Function RunChecks(AstNode test, Value actual, Bool called) -> String {
        For child In test.Children {
            If (child.Kind == AstKind.Test || child.Name == "Fails") { Continue; }
            String failure = This.RunCheck(test, child, actual, called);
            If (failure != "") { Return failure; }
        }
        Return "";
    }

    Private Function RunCheck(AstNode test, AstNode check, Value actual, Bool called) -> String {
        Value left = This.MakeVoid();
        Value right = This.MakeVoid();
        If (check.Left != Null) { left = This.Evaluate(check.Left); }
        If (check.Right != Null) { right = This.Evaluate(check.Right); }
        If (This.runtimeErrors.Count() > 0) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. " + This.runtimeErrors[0];
        }
        String label = check.Name;
        If ((label == "Assert" || label == "True") && !This.IsTruthy(left)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. " + label + " was false.";
        }
        If (label == "False" && This.IsTruthy(left)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. False was true.";
        }
        If (label == "Equal" && !This.Same(left, right)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Equal expected " + This.Display(right) + " but got " + This.Display(left) + ".";
        }
        If (label == "NotEqual" && This.Same(left, right)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. NotEqual got " + This.Display(left) + ".";
        }
        If (label == "Greater" && This.CompareValues(left, right) <= 0) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Greater expected " + This.Display(left) + " > " + This.Display(right) + ".";
        }
        If (label == "Less" && This.CompareValues(left, right) >= 0) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Less expected " + This.Display(left) + " < " + This.Display(right) + ".";
        }
        If (label == "GreaterEqual" && This.CompareValues(left, right) < 0) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. GreaterEqual expected " + This.Display(left) + " >= " + This.Display(right) + ".";
        }
        If (label == "LessEqual" && This.CompareValues(left, right) > 0) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. LessEqual expected " + This.Display(left) + " <= " + This.Display(right) + ".";
        }
        If (label == "Contains" && !left.Text.Contains(right.Text)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Contains expected " + This.Display(right) + " in " + This.Display(left) + ".";
        }
        If (label == "Expect") {
            If (!called) {
                Return "error RX121 Test " + This.TestTitle(test) + " failed. Expect needs Input so the function is called.";
            }
            If (!This.Same(actual, left)) {
                Return "error RX121 Test " + This.TestTitle(test) + " failed. Expect expected " + This.Display(left) + " but the function returned " + This.Display(actual) + ".";
            }
        }
        If (label == "Empty" && !This.IsEmptyValue(left)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Empty was not empty.";
        }
        If (label == "NotEmpty" && This.IsEmptyValue(left)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. NotEmpty was empty.";
        }
        If (label == "Null" && left.Kind != ValueKind.Null) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Null got " + This.Display(left) + ".";
        }
        If (label == "NotNull" && left.Kind == ValueKind.Null) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. NotNull got Null.";
        }
        If (label == "Show") {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. show => " + This.Describe(actual);
        }
        Return "";
    }

    Private Function Describe(Value value) -> String {
        If (value.Kind == ValueKind.Integer) { Return "Int:" + value.Integer.ToString(); }
        If (value.Kind == ValueKind.Boolean) {
            If (value.Boolean) { Return "Bool:True"; }
            Return "Bool:False";
        }
        If (value.Kind == ValueKind.Text) { Return "Text:" + value.Text; }
        If (value.Kind == ValueKind.Null) { Return "Null:"; }
        If (value.Kind == ValueKind.Void || value.Kind == ValueKind.None) { Return "Void:"; }
        If (value.Kind == ValueKind.Float) { Return "Float:" + TextF64(value.Integer); }
        Return "Other:" + This.Display(value);
    }

    Private Function FindTestFunction(String owner, String name) -> AstNode? {
        Int index = 0;
        While (index < This.functions.Count()) {
            If (This.functions[index].Name == name && (owner == "" || This.functionOwners[index] == owner)) {
                If (owner == "" && This.functionOwners[index] != "") {
                    This.PrepareThis(This.functionOwners[index]);
                }
                Return This.functions[index];
            }
            index = index + 1;
        }
        Return This.FindFunction(name);
    }

    Private Function PrepareThis(String owner) -> Void {
        If (owner == "") { Return; }
        Value obj = This.BlankObject(owner);
        If (owner == "NameChecker") {
            Int aIndex = This.FieldIndex(obj, "acronyms");
            If (aIndex >= 0) {
                obj.Elements[aIndex].Elements.Add(This.MakeText("HTTPS"));
                obj.Elements[aIndex].Elements.Add(This.MakeText("HTTP"));
                obj.Elements[aIndex].Elements.Add(This.MakeText("JSON"));
                obj.Elements[aIndex].Elements.Add(This.MakeText("XML"));
                obj.Elements[aIndex].Elements.Add(This.MakeText("SQL"));
                obj.Elements[aIndex].Elements.Add(This.MakeText("AI"));
            }
        }
        If (owner == "Parser") {
            Int tIndex = This.FieldIndex(obj, "tokens");
            Int tcIndex = This.FieldIndex(obj, "tokenCount");
            If (tIndex >= 0) {
                Value tok = This.BlankValue("Token");
                obj.Elements[tIndex].Elements.Add(tok);
                If (tcIndex >= 0) {
                    obj.Elements[tcIndex] = This.MakeInt(1);
                }
            }
        }
        If (owner == "TypeChecker") {
            Int sIndex = This.FieldIndex(obj, "strict");
            If (sIndex >= 0) {
                obj.Elements[sIndex] = This.MakeBool(True);
            }
        }
        This.Define("This", obj);
    }

    Private Function BlankArgument(AstNode parameter) -> Value {
        If (parameter.Type == Null) { Return This.MakeInt(0); }
        If (parameter.Type.FlagA) { Return This.MakeNull(); }
        Return This.BlankValue(parameter.Type.Name);
    }

    Private Function BlankValue(String typeName) -> Value {
        If (typeName == "String") { Return This.MakeText(""); }
        If (typeName == "Bool") { Return This.MakeBool(False); }
        If (typeName == "Char") { Return This.MakeText("A"); }
        If (typeName == "List" || typeName == "Array" || typeName == "Map" || typeName == "Set") { Return This.MakeArray(); }
        If (typeName == "Float" || typeName == "Double" || typeName == "Float64" || typeName == "Float32") {
            Return This.MakeFloatBits(FloatFromInt(0));
        }
        If (typeName == "Int" || typeName == "Int64" || typeName == "Int32" || typeName == "UInt" || typeName == "UInt32" || typeName == "Byte") {
            Return This.MakeInt(0);
        }
        If (typeName == "Token") {
            Value obj = This.MakeObjectValue("Token");
            obj.FieldNames.Add("Kind"); obj.Elements.Add(This.MakeInt(0));
            obj.FieldNames.Add("Text"); obj.Elements.Add(This.MakeText(""));
            obj.FieldNames.Add("Line"); obj.Elements.Add(This.MakeInt(1));
            obj.FieldNames.Add("Column"); obj.Elements.Add(This.MakeInt(1));
            obj.FieldNames.Add("Length"); obj.Elements.Add(This.MakeInt(0));
            obj.FieldNames.Add("IsInterpolated"); obj.Elements.Add(This.MakeBool(False));
            obj.FieldNames.Add("IsRaw"); obj.Elements.Add(This.MakeBool(False));
            obj.FieldNames.Add("IsMultiline"); obj.Elements.Add(This.MakeBool(False));
            Return obj;
        }
        If (typeName == "AstNode") {
            Value obj = This.MakeObjectValue("AstNode");
            obj.FieldNames.Add("Kind"); obj.Elements.Add(This.MakeInt(0));
            obj.FieldNames.Add("Line"); obj.Elements.Add(This.MakeInt(1));
            obj.FieldNames.Add("Column"); obj.Elements.Add(This.MakeInt(1));
            obj.FieldNames.Add("EndLine"); obj.Elements.Add(This.MakeInt(1));
            obj.FieldNames.Add("EndColumn"); obj.Elements.Add(This.MakeInt(1));
            obj.FieldNames.Add("Name"); obj.Elements.Add(This.MakeText(""));
            obj.FieldNames.Add("Text"); obj.Elements.Add(This.MakeText(""));
            obj.FieldNames.Add("Operator"); obj.Elements.Add(This.MakeText(""));
            obj.FieldNames.Add("Suffix"); obj.Elements.Add(This.MakeText(""));
            obj.FieldNames.Add("Number"); obj.Elements.Add(This.MakeInt(0));
            obj.FieldNames.Add("FlagA"); obj.Elements.Add(This.MakeBool(False));
            obj.FieldNames.Add("FlagB"); obj.Elements.Add(This.MakeBool(False));
            obj.FieldNames.Add("FlagC"); obj.Elements.Add(This.MakeBool(False));
            obj.FieldNames.Add("Modifiers"); obj.Elements.Add(This.MakeArray());
            obj.FieldNames.Add("Attributes"); obj.Elements.Add(This.MakeArray());
            obj.FieldNames.Add("Children"); obj.Elements.Add(This.MakeArray());
            obj.FieldNames.Add("Parameters"); obj.Elements.Add(This.MakeArray());
            obj.FieldNames.Add("Members"); obj.Elements.Add(This.MakeArray());
            obj.FieldNames.Add("Type"); obj.Elements.Add(This.MakeNull());
            obj.FieldNames.Add("Body"); obj.Elements.Add(This.MakeNull());
            obj.FieldNames.Add("Initializer"); obj.Elements.Add(This.MakeNull());
            obj.FieldNames.Add("Condition"); obj.Elements.Add(This.MakeNull());
            obj.FieldNames.Add("Left"); obj.Elements.Add(This.MakeNull());
            obj.FieldNames.Add("Right"); obj.Elements.Add(This.MakeNull());
            obj.FieldNames.Add("Extra"); obj.Elements.Add(This.MakeNull());
            obj.FieldNames.Add("Otherwise"); obj.Elements.Add(This.MakeNull());
            Return obj;
        }
        If (This.TypeIndex(typeName) >= 0) { Return This.BlankObject(typeName); }
        Return This.MakeInt(0);
    }

    Private Function BlankObject(String typeName) -> Value {
        Value obj = This.MakeObjectValue(typeName);
        Int typeIndex = This.TypeIndex(typeName);
        If (typeIndex < 0) { Return obj; }
        For baseType In This.types[typeIndex].Members {
            Int baseIndex = This.TypeIndex(baseType.Name);
            If (baseIndex >= 0) {
                For grand In This.types[baseIndex].Members {
                    Int grandIndex = This.TypeIndex(grand.Name);
                    If (grandIndex >= 0) {
                        For field In This.types[grandIndex].Children {
                            If (field.Kind == AstKind.Field && This.FieldIndex(obj, field.Name) < 0) {
                                obj.FieldNames.Add(field.Name);
                                obj.Elements.Add(This.FieldDefault(field));
                            }
                        }
                    }
                }
                For field In This.types[baseIndex].Children {
                    If (field.Kind == AstKind.Field && This.FieldIndex(obj, field.Name) < 0) {
                        obj.FieldNames.Add(field.Name);
                        obj.Elements.Add(This.FieldDefault(field));
                    }
                }
            }
        }
        For field In This.types[typeIndex].Children {
            If (field.Kind == AstKind.Field && This.FieldIndex(obj, field.Name) < 0) {
                obj.FieldNames.Add(field.Name);
                obj.Elements.Add(This.FieldDefault(field));
            }
        }
        Return obj;
    }

    Private Function FieldDefault(AstNode field) -> Value {
        String fieldType = "Int";
        If (field.Type != Null) { fieldType = field.Type.Name; }
        If (field.Type != Null && field.Type.FlagA) { Return This.MakeNull(); }
        If (fieldType == "List" || fieldType == "Array" || fieldType == "Map" || fieldType == "Set") { Return This.MakeArray(); }
        If (fieldType == "String") { Return This.MakeText(""); }
        If (fieldType == "Bool") { Return This.MakeBool(False); }
        Return This.MakeInt(0);
    }

    Private Function RunConstructor(String typeName, List<Value> arguments, Value existing) -> Value {
        Int typeIndex = This.TypeIndex(typeName);
        If (typeIndex < 0) { Return existing; }
        String previous = This.constructing;
        This.constructing = typeName + "";
        AstNode ctor = AstNode();
        Bool found = False;
        Int best = 999;
        For child In This.types[typeIndex].Children {
            If (child.Kind == AstKind.Constructor && child.Parameters.Count() >= arguments.Count() && child.Parameters.Count() < best) {
                ctor = child;
                found = True;
                best = child.Parameters.Count();
            }
        }
        If (!found) {
            This.constructing = previous;
            Return existing;
        }
        This.PushScope();
        This.Define("This", existing);
        Int index = 0;
        For parameter In ctor.Parameters {
            Value supplied = This.MakeInt(0);
            If (index < arguments.Count()) { supplied = arguments[index]; }
            If (index >= arguments.Count() && parameter.Initializer != Null) { supplied = This.Evaluate(parameter.Initializer); }
            This.Define(parameter.Name, supplied);
            index = index + 1;
        }
        For child In ctor.Children { This.Evaluate(child); }
        If (ctor.Body != Null) { This.ExecuteNode(ctor.Body); }
        This.PopScope();
        This.constructing = previous;
        Return existing;
    }

    Private Function RunDestructor(String typeName, Value obj) -> Void {
        If (obj.Kind != ValueKind.Object) { Return; }
        String mark = "#dead:" + typeName;
        If (This.FieldIndex(obj, mark) >= 0) { Return; }
        Int typeIndex = This.TypeIndex(typeName);
        If (typeIndex < 0) { Return; }
        AstNode dtor = AstNode();
        Bool found = False;
        For child In This.types[typeIndex].Children {
            If (child.Kind == AstKind.Destructor && child.Body != Null) {
                dtor = child;
                found = True;
            }
        }
        If (!found) { Return; }
        obj.FieldNames.Add(mark);
        obj.Elements.Add(This.MakeInt(1));
        String saved = This.signal;
        This.signal = "";
        This.PushScope();
        This.Define("This", obj);
        This.ExecuteNode(dtor.Body);
        This.PopScope();
        If (This.signal == "") { This.signal = saved; }
    }

    Private Function IsEmptyValue(Value value) -> Bool {
        If (value.Kind == ValueKind.Null || value.Kind == ValueKind.None) { Return True; }
        If (value.Kind == ValueKind.Text) { Return value.Text.Length() == 0; }
        If (value.Kind == ValueKind.Array) { Return value.Elements.Count() == 0; }
        Return False;
    }

    Private Function CompareValues(Value left, Value right) -> Int {
        If (left.Kind == ValueKind.Float || right.Kind == ValueKind.Float) {
            Return F64Cmp(This.FloatBits(left), This.FloatBits(right));
        }
        If (left.Kind == ValueKind.Text && right.Kind == ValueKind.Text) {
            Int length = left.Text.Length();
            If (right.Text.Length() < length) { length = right.Text.Length(); }
            Int index = 0;
            While (index < length) {
                Int leftCode = left.Text.GetChar(index).ToInt();
                Int rightCode = right.Text.GetChar(index).ToInt();
                If (leftCode < rightCode) { Return -1; }
                If (leftCode > rightCode) { Return 1; }
                index = index + 1;
            }
            If (left.Text.Length() < right.Text.Length()) { Return -1; }
            If (left.Text.Length() > right.Text.Length()) { Return 1; }
            Return 0;
        }
        If (left.Integer < right.Integer) { Return -1; }
        If (left.Integer > right.Integer) { Return 1; }
        Return 0;
    }

    Private Function CollectFunctions(AstNode node) -> Void {
        For child In node.Children {
            If (child.Kind == AstKind.Function) {
                This.functions.Add(child);
                String ownerName = This.collectOwner;
                This.functionOwners.Add(ownerName);
                This.Define(child.Name, This.MakeFunction(child));
            }
            If (child.Kind == AstKind.Operator) {
                If (child.Body != Null && child.Body.Kind == AstKind.Function) {
                    This.functions.Add(child.Body);
                    String operatorOwner = This.collectOwner;
                    This.functionOwners.Add(operatorOwner);
                    This.Define(child.Body.Name, This.MakeFunction(child.Body));
                    This.operatorKeys.Add(child.Operator);
                    This.operatorNodes.Add(child.Body);
                }
            }
            If (child.Kind == AstKind.Implement) {
                String savedOwner = This.collectOwner;
                This.collectOwner = child.Name;
                This.CollectFunctions(child);
                This.collectOwner = savedOwner;
            }
            If (child.Kind == AstKind.Macro) {
                This.macros.Add(child);
            }
            If (child.Kind == AstKind.Class) {
                Int existing = This.TypeIndex(child.Name);
                If (existing < 0) {
                    This.types.Add(child);
                } Else {
                    For member In child.Children { This.types[existing].Children.Add(member); }
                    For baseType In child.Members { This.types[existing].Members.Add(baseType); }
                }
                String savedOwner = This.collectOwner;
                This.collectOwner = child.Name;
                For member In child.Children {
                    If (member.Kind == AstKind.Operator) {
                        This.operatorKeys.Add(child.Name + member.Operator);
                        This.operatorNodes.Add(member);
                    }
                }
                This.CollectFunctions(child);
                This.collectOwner = savedOwner;
            }
            If (child.Kind == AstKind.Block) {
                This.CollectFunctions(child);
            }
        }
    }

    Private Function ExecuteNode(AstNode node) -> Value {
        If (This.signal.StartsWith("goto:")) {
            If (node.Kind == AstKind.Label && This.signal == "goto:" + node.Name) {
                This.signal = "";
            }
            Return This.MakeVoid();
        }
        If (This.signal.Length() > 0 && node.Kind != AstKind.Function) {
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Using) {
            Value lease = This.MakeVoid();
            If (node.Initializer != Null) { lease = This.Evaluate(node.Initializer); }
            This.PushScope();
            If (node.Name != "") { This.Define(node.Name, lease); }
            If (node.Body != Null) { This.ExecuteNode(node.Body); }
            This.PopScope();
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Unsafe) {
            If (node.Body != Null) { Return This.ExecuteNode(node.Body); }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Defer) {
            If (node.Body != Null) { This.defers.Add(node.Body); }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Goto) {
            This.signal = "goto:" + node.Name;
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Label) { Return This.MakeVoid(); }
        If (node.Kind == AstKind.Asm) {
            If (node.Text.IndexOf("movq") >= 0) {
                String outName = "";
                Value input = This.MakeInt(0);
                For param In node.Parameters {
                    If (param.Name == "Out" && param.Left != Null && param.Left.Kind == AstKind.Name) { outName = param.Left.Name; }
                    If (param.Name == "In" && param.Left != Null) { input = This.Evaluate(param.Left); }
                }
                If (outName != "") { This.Assign(outName, input); }
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Throw) {
            If (node.Left != Null) { This.thrown = This.Evaluate(node.Left); }
            This.signal = "throw";
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Lock) {
            If (node.Left != Null) { This.Evaluate(node.Left); }
            If (node.Body != Null) { This.ExecuteNode(node.Body); }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Block) {
            Return This.ExecuteBlock(node);
        }
        If (node.Kind == AstKind.Variable) {
            Return This.ExecuteVariable(node);
        }
        If (node.Kind == AstKind.ExpressionStatement) {
            If (node.Left != Null) {
                Return This.Evaluate(node.Left);
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.If) {
            If (This.IsTruthy(This.Evaluate(node.Condition))) {
                If (node.Body != Null) { Return This.ExecuteNode(node.Body); }
            } Else If (node.Otherwise != Null) {
                Return This.ExecuteNode(node.Otherwise);
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.While) {
            While (This.signal.Length() == 0 && This.IsTruthy(This.Evaluate(node.Condition))) {
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.DoWhile) {
            If (node.Body != Null) { This.ExecuteNode(node.Body); }
            While (This.signal.Length() == 0 && This.IsTruthy(This.Evaluate(node.Condition))) {
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Repeat) {
            Int count = This.Evaluate(node.Condition).Integer;
            Int index = 0;
            While (index < count && This.signal.Length() == 0) {
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
                index = index + 1;
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Loop) {
            While (This.signal.Length() == 0) {
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.For) {
            Return This.ExecuteFor(node);
        }
        If (node.Kind == AstKind.Return) {
            If (node.Left != Null) {
                This.returnValue = This.Evaluate(node.Left);
            } Else {
                This.returnValue = This.MakeVoid();
            }
            This.signal = "return";
            Return This.returnValue;
        }
        If (node.Kind == AstKind.Break) {
            This.signal = "break";
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Yield) {
            Value item = This.MakeVoid();
            If (node.Left != Null) { item = This.Evaluate(node.Left); }
            This.yields.Add(item);
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Continue) {
            This.signal = "continue";
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Match) {
            Return This.ExecuteMatch(node);
        }
        If (node.Kind == AstKind.Try) {
            If (node.Body != Null) { This.ExecuteNode(node.Body); }
            If (This.signal == "throw") {
                This.signal = "";
                If (node.Children.Count() > 0) {
                    AstNode caught = node.Children[0];
                    This.PushScope();
                    If (caught.Name != "") { This.Define(caught.Name, This.thrown); }
                    If (caught.Body != Null) { This.ExecuteNode(caught.Body); }
                    This.PopScope();
                } Else {
                    This.signal = "throw";
                }
            }
            If (node.Extra != Null) {
                String saved = This.signal;
                This.signal = "";
                This.ExecuteNode(node.Extra);
                If (This.signal == "") { This.signal = saved; }
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Await) {
            If (node.Left != Null) { This.Evaluate(node.Left); }
            Return This.MakeVoid();
        }
        For child In node.Children {
            This.ExecuteNode(child);
            If (This.signal.Length() > 0) {
                Break;
            }
        }
        Return This.MakeVoid();
    }

    Private Function ExecuteBlock(AstNode node) -> Value {
        This.PushScope();
        This.CollectFunctions(node);
        Value last = This.MakeVoid();
        Int deferMark = This.defers.Count();
        For child In node.Children {
            last = This.ExecuteNode(child);
            If (This.signal.StartsWith("goto:")) { Continue; }
            If (This.signal.Length() > 0) {
                Break;
            }
        }
        While (This.defers.Count() > deferMark) {
            AstNode pending = This.defers[This.defers.Count() - 1];
            Var kept = List<AstNode>();
            Int index = 0;
            While (index < This.defers.Count() - 1) {
                kept.Add(This.defers[index]);
                index = index + 1;
            }
            This.defers = kept;
            String saved = This.signal;
            This.signal = "";
            This.ExecuteNode(pending);
            If (This.signal == "") { This.signal = saved; }
        }
        This.PopScope();
        Return last;
    }

    Private Function ExecuteVariable(AstNode node) -> Value {
        If (node.FlagC) {
            Value value = This.MakeNull();
            If (node.Initializer != Null) {
                value = This.Evaluate(node.Initializer);
            }
            Int index = 0;
            For child In node.Children {
                Value part = This.MakeNull();
                If (index < value.Elements.Count()) {
                    part = value.Elements[index];
                }
                This.Define(child.Name, part);
                index = index + 1;
            }
            Return value;
        }
        Value initial = This.MakeNull();
        If (node.Initializer != Null) {
            initial = This.Evaluate(node.Initializer);
        }
        If (node.Type != Null) {
            initial = This.AdaptNumeric(node.Type.Name, initial, node.Initializer);
        }
        This.Define(node.Name, initial);
        For child In node.Children {
            This.ExecuteVariable(child);
        }
        Return initial;
    }

    Private Function ExecuteFor(AstNode node) -> Value {
        This.PushScope();
        If (node.FlagB) {
            If (node.Initializer != Null) { This.ExecuteNode(node.Initializer); }
            While (This.signal.Length() == 0) {
                If (node.Condition == Null && node.Initializer == Null && node.Extra == Null && node.Body == Null) {
                    Break;
                }
                If (node.Condition != Null && !This.IsTruthy(This.Evaluate(node.Condition))) {
                    Break;
                }
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
                If (This.signal.Length() > 0) { Break; }
                If (node.Extra != Null) { This.Evaluate(node.Extra); }
            }
        } Else If (node.Right != Null && node.Right.Kind == AstKind.Range) {
            Int start = This.Evaluate(node.Right.Left).Integer;
            Int end = This.Evaluate(node.Right.Right).Integer;
            Int cursor = start;
            Int last = end;
            If (!node.Right.FlagA) {
                last = end - 1;
            }
            If (node.Left != Null && node.Left.Name != "") {
                This.Define(node.Left.Name, This.MakeInt(start));
            }
            While (cursor <= last && This.signal.Length() == 0) {
                If (node.Left != Null && node.Left.Name != "") {
                    This.Assign(node.Left.Name, This.MakeInt(cursor));
                }
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
                cursor = cursor + 1;
            }
        } Else {
            Value collection = This.Evaluate(node.Right);
            If (node.Left != Null) {
                If (node.Left.Children.Count() > 0) {
                    For part In node.Left.Children {
                        This.Define(part.Name, This.MakeNull());
                    }
                } Else If (node.Left.Name != "") {
                    This.Define(node.Left.Name, This.MakeNull());
                }
            }
            For element In collection.Elements {
                If (node.Left != Null) {
                    If (node.Left.Children.Count() > 0) {
                        Int partIndex = 0;
                        For part In node.Left.Children {
                            Value partValue = This.MakeNull();
                            If (partIndex < element.Elements.Count()) {
                                partValue = element.Elements[partIndex];
                            }
                            This.Assign(part.Name, partValue);
                            partIndex = partIndex + 1;
                        }
                    } Else If (node.Left.Name != "") {
                        This.Assign(node.Left.Name, element);
                    }
                }
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
            }
        }
        This.PopScope();
        Return This.MakeVoid();
    }

    Private Function ExecuteMatch(AstNode node) -> Value {
        Value scrutinee = This.MakeNull();
        If (node.Left != Null) {
            scrutinee = This.Evaluate(node.Left);
        }
        For arm In node.Children {
            If (arm.Left != Null && (arm.Left.FlagA || This.PatternMatches(arm.Left, scrutinee))) {
                This.PushScope();
                This.BindPattern(arm.Left, scrutinee);
                Value result = This.MakeVoid();
                If (arm.Right != Null) {
                    If (arm.Right.Kind == AstKind.Block || arm.Right.Kind == AstKind.Return) {
                        result = This.ExecuteNode(arm.Right);
                    } Else {
                        result = This.Evaluate(arm.Right);
                    }
                }
                This.PopScope();
                Return result;
            }
        }
        Return This.MakeVoid();
    }

    Private Function Evaluate(AstNode? node) -> Value {
        If (node == Null) {
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.IntegerLiteral) {
            Return This.MakeWidth(SuffixTypeName(NumericSuffix(node.Text)), ParseInteger(node.Text));
        }
        If (node.Kind == AstKind.FloatLiteral) {
            Return This.ParseFloat(node.Text);
        }
        If (node.Kind == AstKind.StringLiteral) {
            If (node.FlagA && node.Children.Count() > 0) {
                String text = "";
                For child In node.Children {
                    If (child.Kind == AstKind.Interpolation) {
                        text = text + This.Display(This.Evaluate(child.Left));
                    } Else {
                        text = text + child.Text;
                    }
                }
                Return This.MakeText(text);
            }
            Return This.MakeText(node.Text);
        }
        If (node.Kind == AstKind.CharLiteral) { Return This.MakeText(node.Text); }
        If (node.Kind == AstKind.BooleanLiteral) { Return This.MakeBool(node.FlagA); }
        If (node.Kind == AstKind.NullLiteral) { Return This.MakeNull(); }
        If (node.Kind == AstKind.Name) { Return This.Lookup(node.Name); }
        If (node.Kind == AstKind.ObjectLiteral) { Return This.MakeObject(node); }
        If (node.Kind == AstKind.RecordLiteral) { Return This.MakeRecord(node); }
        If (node.Kind == AstKind.MapLiteral) { Return This.MakeMap(node); }
        If (node.Kind == AstKind.SetLiteral) { Return This.MakeSet(node); }
        If (node.Kind == AstKind.ArrayLiteral || node.Kind == AstKind.TupleLiteral) {
            Value array = This.MakeArray();
            For child In node.Children {
                array.Elements.Add(This.Evaluate(child));
            }
            Return array;
        }
        If (node.Kind == AstKind.Lambda) { Return This.MakeFunction(node); }
        If (node.Kind == AstKind.Unary) {
            Value operand = This.Evaluate(node.Left);
            If (node.Operator == "-" && operand.Kind == ValueKind.Float) {
                Return This.MakeFloatBits(F64Neg(operand.Integer));
            }
            If (node.Operator == "-" && operand.Kind == ValueKind.Integer) {
                Return This.MakeInt(-operand.Integer);
            }
            If (node.Operator == "*" && operand.Text == "Ptr" && operand.Elements.Count() > 0) {
                Value storage = operand.Elements[0];
                If (operand.Integer >= 0 && operand.Integer < storage.Elements.Count()) { Return storage.Elements[operand.Integer]; }
                Return This.MakeInt(0);
            }
            If (node.Operator == "*" && (operand.Text.StartsWith("Ref:") || operand.Text.StartsWith("MutRef:"))) {
                Return This.Lookup(This.ReferenceTarget(operand.Text));
            }
            If (node.Operator == "!" || node.Operator == "Not") {
                Return This.MakeBool(!This.IsTruthy(operand));
            }
            If ((node.Operator == "++" || node.Operator == "--") && node.Left != Null && node.Left.Kind == AstKind.Name) {
                Int current = operand.Integer;
                Int next = current + 1;
                If (node.Operator == "--") { next = current - 1; }
                This.Assign(node.Left.Name, This.MakeInt(next));
                If (node.FlagA) { Return This.MakeInt(current); }
                Return This.MakeInt(next);
            }
            Return operand;
        }
        If (node.Kind == AstKind.Binary && node.Operator == "??") {
            Value left = This.Evaluate(node.Left);
            If (left.Kind == ValueKind.Null || left.Kind == ValueKind.None) { Return This.Evaluate(node.Right); }
            Return left;
        }
        If (node.Kind == AstKind.Binary && (node.Operator == "&&" || node.Operator == "And")) {
            Value left = This.Evaluate(node.Left);
            If (!This.IsTruthy(left)) { Return left; }
            Return This.Evaluate(node.Right);
        }
        If (node.Kind == AstKind.Binary && (node.Operator == "||" || node.Operator == "Or")) {
            Value left = This.Evaluate(node.Left);
            If (This.IsTruthy(left)) { Return left; }
            Return This.Evaluate(node.Right);
        }
        If (node.Kind == AstKind.Binary || node.Kind == AstKind.Range) {
            Return This.EvaluateBinary(node);
        }
        If (node.Kind == AstKind.Assignment) {
            If (node.Left != Null && node.Left.Kind == AstKind.TupleLiteral) {
                Value value = This.Evaluate(node.Right);
                Int index = 0;
                For target In node.Left.Children {
                    Value part = This.MakeNull();
                    If (index < value.Elements.Count()) { part = value.Elements[index]; }
                    If (target.Kind == AstKind.Name) { This.Assign(target.Name, part); }
                    index = index + 1;
                }
                Return value;
            }
            Value value = This.Evaluate(node.Right);
            If (node.Left != Null && node.Left.Kind == AstKind.Unary && node.Left.Operator == "*") {
                Value target = This.Evaluate(node.Left.Left);
                If (target.Text == "Ptr" && target.Elements.Count() > 0) {
                    Value storage = target.Elements[0];
                    If (target.Integer >= 0 && target.Integer < storage.Elements.Count()) { storage.Elements[target.Integer] = value; }
                    Return value;
                }
                If (target.Text.StartsWith("Ref:") || target.Text.StartsWith("MutRef:")) {
                    This.Assign(This.ReferenceTarget(target.Text), value);
                }
                Return value;
            }
            If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Name == "Value") {
                Value target = This.Evaluate(node.Left.Left);
                If (This.IsMutableReference(target.Text)) {
                    This.Assign(This.ReferenceTarget(target.Text), value);
                    Return value;
                }
            }
            If (node.Left != Null && node.Left.Kind == AstKind.Member) {
                Value target = This.Evaluate(node.Left.Left);
                Int index = This.FieldIndex(target, node.Left.Name);
                If (index >= 0) {
                    target.Elements[index] = value;
                    If (node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name) {
                        This.Assign(node.Left.Left.Name, target);
                    }
                }
                Return value;
            }
            If (node.Left != Null && node.Left.Kind == AstKind.Index) {
                Value target = This.Evaluate(node.Left.Left);
                If (target.Text == "Map") {
                    Value key = This.Evaluate(node.Left.Right);
                    Int pair = 0;
                    Bool found = False;
                    While (pair + 1 < target.Elements.Count()) {
                        If (This.Same(target.Elements[pair], key)) {
                            target.Elements[pair + 1] = value;
                            found = True;
                        }
                        pair = pair + 2;
                    }
                    If (!found) {
                        target.Elements.Add(key);
                        target.Elements.Add(value);
                    }
                    Return value;
                }
                Int slot = This.Evaluate(node.Left.Right).Integer;
                If (slot >= 0 && slot < target.Elements.Count()) { target.Elements[slot] = value; }
                Return value;
            }
            If (node.Left != Null && node.Left.Kind == AstKind.Name) {
                If (node.Operator != "=" && node.Operator != "") {
                    Value current = This.Lookup(node.Left.Name);
                    If (node.Operator == "+=") { value = This.MakeInt(current.Integer + value.Integer); }
                    If (node.Operator == "-=") { value = This.MakeInt(current.Integer - value.Integer); }
                    If (node.Operator == "*=") { value = This.MakeInt(current.Integer * value.Integer); }
                    If (node.Operator == "/=") {
                        If (value.Integer == 0) { value = This.MakeInt(0); }
                        If (value.Integer != 0) { value = This.MakeInt(current.Integer / value.Integer); }
                    }
                    If (node.Operator == "%=") {
                        If (value.Integer == 0) { value = This.MakeInt(0); }
                        If (value.Integer != 0) { value = This.MakeInt(current.Integer % value.Integer); }
                    }
                }
                This.Assign(node.Left.Name, value);
            }
            Return value;
        }
        If (node.Kind == AstKind.Ternary) {
            If (This.IsTruthy(This.Evaluate(node.Condition))) {
                Return This.Evaluate(node.Left);
            }
            Return This.Evaluate(node.Right);
        }
        If (node.Kind == AstKind.TypeCheck) {
            Value value = This.Evaluate(node.Left);
            String expected = "";
            If (node.Type != Null) { expected = node.Type.Name; }
            Bool matched = This.TypeMatches(value, expected);
            If (matched && node.FlagA && node.Name != "") {
                This.Define(node.Name, value);
            }
            Return This.MakeBool(matched);
        }
        If (node.Kind == AstKind.Call) {
            Return This.EvaluateCall(node);
        }
        If (node.Kind == AstKind.Member) {
            If (node.Left != Null && node.Left.Kind == AstKind.Name && This.ImportPackage(node.Left.Name) != "") {
                String packageName = This.ImportPackage(node.Left.Name);
                If (This.TypeIndex(node.Name) >= 0 || This.PackageFunction(packageName, node.Name) || This.CoreMember(packageName, node.Name)) {
                    Return This.MakeText(node.Name);
                }
                This.runtimeErrors.Add("'" + node.Name + "' is not in package '" + packageName + "'.");
                Return This.MakeNull();
            }
            If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Name == "Console" && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name && node.Left.Left.Name == "Runtime") {
                If (node.Name == "Enabled") { Return This.MakeBool(This.consoleEnabled); }
                If (node.Name == "Port") { Return This.MakeInt(This.consolePort); }
            }
            If (node.Left != Null && node.Left.Kind == AstKind.Name) {
                Int typeIndex = This.TypeIndex(node.Left.Name);
                If (typeIndex >= 0 && This.types[typeIndex].Text == "Enum") {
                    Return This.MakeInt(This.EnumOrdinal(This.types[typeIndex], node.Name));
                }
                Int builtIn = This.LookupBuiltinEnum(node.Left.Name, node.Name);
                If (builtIn >= 0) {
                    Return This.MakeInt(builtIn);
                }
                If (node.Left.Name == "ExitCode" || node.Left.Name == "AstKind" || node.Left.Name == "ValueKind" || node.Left.Name == "TokenKind" || node.Left.Name == "Rounding") {
                    Return This.MakeInt(0);
                }
                If (node.Name == "MaxValue" && This.IsNumericOwner(node.Left.Name)) {
                    Return This.MakeInt(This.NumericMax(node.Left.Name));
                }
            }
            Value target = This.Evaluate(node.Left);
            If (target.Kind == ValueKind.Object) {
                Int index = This.FieldIndex(target, node.Name);
                If (index >= 0 && index < target.Elements.Count()) { Return target.Elements[index]; }
                Return This.MakeInt(0);
            }
            If (node.Name == "Value" && (target.Text.StartsWith("Ref:") || target.Text.StartsWith("MutRef:"))) {
                Return This.Lookup(This.ReferenceTarget(target.Text));
            }
            If (node.Name == "Length" || node.Name == "Count") {
                If (target.Kind == ValueKind.Text) { Return This.MakeInt(target.Text.Length()); }
                Return This.MakeInt(target.Elements.Count());
            }
            If (node.Name == "Message" && target.Text == "RoboException") {
                If (target.Elements.Count() > 0) { Return target.Elements[0]; }
                Return This.MakeText("");
            }
            If (node.Name == "Read" && target.Text == "File") {
                If (target.Elements.Count() > 0) { Return target.Elements[0]; }
                Return This.MakeText("");
            }
            If (node.Name == "ToString") { Return This.MakeText(This.Display(target)); }
            Return This.MakeText(This.Display(target));
        }
        If (node.Kind == AstKind.Index) {
            Value target = This.Evaluate(node.Left);
            If (target.Text == "Map") {
                Value key = This.Evaluate(node.Right);
                Int pair = 0;
                While (pair + 1 < target.Elements.Count()) {
                    If (This.Same(target.Elements[pair], key)) { Return target.Elements[pair + 1]; }
                    pair = pair + 2;
                }
                Return This.MakeInt(0);
            }
            Int index = This.Evaluate(node.Right).Integer;
            If (index >= 0 && index < target.Elements.Count()) {
                Return target.Elements[index];
            }
            If (target.Kind == ValueKind.Text && index >= 0 && index < target.Text.Length()) {
                Return This.MakeText(target.Text.Substring(index, 1));
            }
            This.runtimeErrors.Add("Index is outside the collection.");
            Return This.MakeNull();
        }
        If (node.Kind == AstKind.Await || node.Kind == AstKind.Unwrap || node.Kind == AstKind.Propagate) {
            Value inner = This.Evaluate(node.Left);
            If (node.Kind == AstKind.Await && inner.Kind == ValueKind.Array && inner.Text == "Promise" && inner.Elements.Count() > 0) {
                Return inner.Elements[0];
            }
            If ((node.Kind == AstKind.Propagate || node.Kind == AstKind.Unwrap) && inner.Kind == ValueKind.Array && (inner.Text == "Some" || inner.Text == "Success") && inner.Elements.Count() > 0) {
                Return inner.Elements[0];
            }
            Return inner;
        }
        If (node.Kind == AstKind.Block || node.Kind == AstKind.If || node.Kind == AstKind.Match) {
            Return This.ExecuteNode(node);
        }
        Return This.MakeVoid();
    }

    Private Function EvaluateBinary(AstNode node) -> Value {
        Value left = This.Evaluate(node.Left);
        Value right = This.Evaluate(node.Right);
        Int overload = -1;
        If (left.Kind == ValueKind.Object && right.Kind == ValueKind.Object) {
            overload = This.FindOperator(left.Text + node.Operator);
        }
        If (overload < 0) { overload = This.FindOperator(node.Operator); }
        If (overload >= 0) {
            Var args = List<Value>();
            args.Add(left);
            args.Add(right);
            Return This.CallFunction(This.operatorNodes[overload], args);
        }
        If (node.Kind == AstKind.Range) {
            Value range = This.MakeArray();
            Int cursor = left.Integer;
            Int end = right.Integer;
            If (!node.FlagA) { end = end - 1; }
            While (cursor <= end) {
                range.Elements.Add(This.MakeInt(cursor));
                cursor = cursor + 1;
            }
            Return range;
        }
        If (left.Kind == ValueKind.Float || right.Kind == ValueKind.Float) {
            Return This.EvaluateFloat(node.Operator, left, right);
        }
        If (node.Operator == "+") {
            If (left.Text == "Ptr") {
                Value shifted = This.MakeArray();
                shifted.Text = "Ptr";
                shifted.Integer = left.Integer + right.Integer;
                If (left.Elements.Count() > 0) { shifted.Elements.Add(left.Elements[0]); }
                Return shifted;
            }
            If (left.Kind == ValueKind.Text || right.Kind == ValueKind.Text) {
                Return This.MakeText(This.Display(left) + This.Display(right));
            }
            Return This.MakeInt(left.Integer + right.Integer);
        }
        If (node.Operator == "-") { Return This.MakeInt(left.Integer - right.Integer); }
        If (node.Operator == "*") { Return This.MakeInt(left.Integer * right.Integer); }
        If (node.Operator == "/") {
            If (right.Integer == 0) {
                This.runtimeErrors.Add("Division by zero.");
                Return This.MakeInt(0);
            }
            Return This.MakeInt(left.Integer / right.Integer);
        }
        If (node.Operator == "%") {
            If (right.Integer == 0) {
                This.runtimeErrors.Add("Division by zero.");
                Return This.MakeInt(0);
            }
            Return This.MakeInt(left.Integer % right.Integer);
        }
        If (node.Operator == "<<") { Return This.MakeInt(Shl(left.Integer, right.Integer)); }
        If (node.Operator == ">>") { Return This.MakeInt(Shr(left.Integer, right.Integer)); }
        If (node.Operator == "&") { Return This.MakeInt(BitAnd(left.Integer, right.Integer)); }
        If (node.Operator == "|") { Return This.MakeInt(BitOr(left.Integer, right.Integer)); }
        If (node.Operator == "^") { Return This.MakeInt(BitXor(left.Integer, right.Integer)); }
        If (node.Operator == "==" || node.Operator == "Equal") { Return This.MakeBool(This.Same(left, right)); }
        If (node.Operator == "!=") { Return This.MakeBool(!This.Same(left, right)); }
        If (left.Kind == ValueKind.Text && right.Kind == ValueKind.Text) {
            Int leftCode = 0;
            If (left.Text.Length() > 0) { leftCode = left.Text.GetChar(0).ToInt(); }
            Int rightCode = 0;
            If (right.Text.Length() > 0) { rightCode = right.Text.GetChar(0).ToInt(); }
            If (node.Operator == "<") { Return This.MakeBool(leftCode < rightCode); }
            If (node.Operator == ">") { Return This.MakeBool(leftCode > rightCode); }
            If (node.Operator == "<=") { Return This.MakeBool(leftCode <= rightCode); }
            If (node.Operator == ">=") { Return This.MakeBool(leftCode >= rightCode); }
        }
        If (node.Operator == "<") { Return This.MakeBool(left.Integer < right.Integer); }
        If (node.Operator == ">") { Return This.MakeBool(left.Integer > right.Integer); }
        If (node.Operator == "<=") { Return This.MakeBool(left.Integer <= right.Integer); }
        If (node.Operator == ">=") { Return This.MakeBool(left.Integer >= right.Integer); }
        If (node.Operator == "&&" || node.Operator == "And") { Return This.MakeBool(This.IsTruthy(left) && This.IsTruthy(right)); }
        If (node.Operator == "||" || node.Operator == "Or") { Return This.MakeBool(This.IsTruthy(left) || This.IsTruthy(right)); }
        Return left;
    }

    Private Function CollectImportAliases(AstNode node) -> Void {
        This.walkPackage = "";
        This.WalkPackage(node);
    }

    Private Function WalkPackage(AstNode node) -> Void {
        If (node.Kind == AstKind.Package && node.Name != "") {
            This.walkPackage = node.Name;
        }
        If (node.Kind == AstKind.Import && node.Name != "") {
            String alias = node.Text;
            If (alias == "") { alias = This.PackageLeaf(node.Name); }
            If (alias != "") {
                This.importAliasNames.Add(alias);
                This.importAliasPackages.Add(node.Name);
            }
        }
        If (node.Kind == AstKind.Function && This.walkPackage != "") {
            This.packageFunctionNames.Add(node.Name);
            This.packageFunctionPackages.Add(This.walkPackage + "");
        }
        If (node.Kind == AstKind.Class || node.Kind == AstKind.Function) { Return; }
        For child In node.Children {
            This.WalkPackage(child);
        }
    }

    Private Function PackageFunction(String packageName, String member) -> Bool {
        Int index = 0;
        While (index < This.packageFunctionNames.Count() && index < This.packageFunctionPackages.Count()) {
            If (This.packageFunctionNames[index] == member && (This.packageFunctionPackages[index] == packageName || This.packageFunctionPackages[index].EndsWith("." + packageName) || packageName.EndsWith("." + This.packageFunctionPackages[index]))) {
                Return True;
            }
            index = index + 1;
        }
        Return False;
    }

    Private Function PackageLeaf(String name) -> String {
        Int dot = name.LastIndexOf(".");
        If (dot < 0) { Return name; }
        Return name.Substring(dot + 1);
    }

    Private Function ImportPackage(String name) -> String {
        Int index = 0;
        While (index < This.importAliasNames.Count() && index < This.importAliasPackages.Count()) {
            If (This.importAliasNames[index] == name) { Return This.importAliasPackages[index]; }
            index = index + 1;
        }
        Return "";
    }

    Private Function CoreMember(String packageName, String member) -> Bool {
        If (packageName != "Robix.Core" && !packageName.EndsWith(".Core")) { Return False; }
        Return member == "Print" || member == "Some" || member == "None" || member == "Ok" || member == "Err";
    }

    Private Function CallPackage(String packageName, String member, List<Value> arguments) -> Value {
        If (This.TypeIndex(member) >= 0) {
            Return This.RunConstructor(member, arguments, This.BlankObject(member));
        }
        If (This.PackageFunction(packageName, member)) {
            AstNode? function = This.FindCallable(member, arguments.Count());
            If (function != Null) {
                Return This.CallFunction(function, arguments);
            }
        }
        If (member == "Print" && This.CoreMember(packageName, member)) {
            If (!This.consoleEnabled) { Return This.MakeVoid(); }
            String line = "";
            For argument In arguments {
                If (line.Length() > 0) { line = line + " "; }
                line = line + This.Display(argument);
            }
            This.lines.Add(line);
            Return This.MakeVoid();
        }
        If (This.CoreMember(packageName, member)) {
            Value wrapper = This.MakeArray();
            wrapper.Text = member;
            For argument In arguments {
                wrapper.Elements.Add(argument);
            }
            Return wrapper;
        }
        This.runtimeErrors.Add("'" + member + "' is not in package '" + packageName + "'.");
        Return This.MakeNull();
    }

    Private Function EvaluateCall(AstNode node) -> Value {
        If (node.Parameters.Count() > 256) {
            This.runtimeErrors.Add("A call exceeds the argument resource limit of 256.");
            Return This.MakeVoid();
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Name == "Pointer" && node.Left.Name == "Of") {
            Value reference = This.MakeArray();
            reference.Text = "MutRef:";
            If (node.Parameters.Count() > 0 && node.Parameters[0].Left != Null && node.Parameters[0].Left.Kind == AstKind.Name) {
                reference.Text = "MutRef:" + node.Parameters[0].Left.Name;
            }
            Return reference;
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Name && node.Left.Name == "Ref") {
            Return This.MakeReference(node);
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Name) {
            AstNode? macro = This.FindMacro(node.Left.Name);
            If (macro != Null) { Return This.ExpandMacro(macro, node); }
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Name == "Reflect" && node.Left.Name == "TypeOf") {
            String typeName = "";
            If (node.Parameters.Count() > 0 && node.Parameters[0].Left != Null && node.Parameters[0].Left.Kind == AstKind.Name) {
                typeName = node.Parameters[0].Left.Name;
            }
            Return This.MakeText(typeName);
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Name == "Promise" && (node.Left.Name == "Create" || node.Left.Name == "FromCallback" || node.Left.Name == "Resolved" || node.Left.Name == "Rejected")) {
            Return This.MakePromiseCall(node);
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Name == "LegacyApi" && node.Left.Name == "ReadText") {
            Return This.MakeText(This.ReadLegacyText(node));
        }
        Var arguments = List<Value>();
        For argument In node.Parameters {
            If (argument.Left != Null) {
                arguments.Add(This.Evaluate(argument.Left));
            }
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name) {
            String packageName = This.ImportPackage(node.Left.Left.Name);
            If (packageName != "") {
                Return This.CallPackage(packageName, node.Left.Name, arguments);
            }
        }
        Value library = This.StandardLibrary(node, arguments);
        If (library.Kind != ValueKind.None) { Return library; }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Name == "Reflect" && node.Left.Name == "Create" && arguments.Count() > 0) {
            Var none = List<Value>();
            Return This.RunConstructor(arguments[0].Text, none, This.BlankObject(arguments[0].Text));
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Name == "Reflect" && node.Left.Name == "Invoke" && arguments.Count() > 1 && arguments[0].Kind == ValueKind.Object) {
            Var owners = List<String>();
            owners.Add(arguments[0].Text);
            Int cursor = 0;
            While (cursor < owners.Count() && cursor < 8) {
                Int mIdx = 0;
                While (mIdx < This.functions.Count()) {
                    If (This.functions[mIdx].Name == arguments[1].Text && This.functionOwners[mIdx] == owners[cursor] && This.functions[mIdx].Body != Null) {
                        This.PushScope();
                        This.Define("This", arguments[0]);
                        Var none = List<Value>();
                        Value res = This.CallFunction(This.functions[mIdx], none);
                        This.PopScope();
                        Return res;
                    }
                    mIdx = mIdx + 1;
                }
                Int ownerType = This.TypeIndex(owners[cursor]);
                If (ownerType >= 0) {
                    For baseType In This.types[ownerType].Members { owners.Add(baseType.Name); }
                }
                cursor = cursor + 1;
            }
            Return This.MakeVoid();
        }
        String name = "";
        If (node.Left != Null && node.Left.Kind == AstKind.Name) {
            name = node.Left.Name;
        }
        If (name != "" && This.HasName(name)) {
            Value callee = This.Lookup(name);
            If (callee.Text == "PromiseResolve" || callee.Text == "PromiseReject") {
                Return This.SettlePromise(callee, arguments);
            }
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Name == "From" && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name && This.IsNumericOwner(node.Left.Left.Name)) {
            String fullName = node.Left.Left.Name;
            If (node.Left.Left.Children.Count() > 0) {
                fullName = fullName + "<" + node.Left.Left.Children[0].Name + ">";
            }
            Return This.NumericFrom(fullName, node, arguments);
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name && This.IsNumericOwner(node.Left.Left.Name)) {
            String numericOwner = node.Left.Left.Name;
            If (node.Left.Name == "FromChecked" && arguments.Count() > 0) { Return This.MakeInt(arguments[0].Integer); }
            If (node.Left.Name == "AddChecked" && arguments.Count() >= 2) { Return This.MakeInt(arguments[0].Integer + arguments[1].Integer); }
            If (node.Left.Name == "WrappingAdd" && arguments.Count() >= 2) { Return This.MakeInt(This.WrapAdd(arguments[0].Integer, arguments[1].Integer)); }
            If (node.Left.Name == "SaturatingAdd" && arguments.Count() >= 2) { Return This.MakeInt(This.SaturatingAdd(numericOwner, arguments[0].Integer, arguments[1].Integer)); }
            If (node.Left.Name == "TryParse" && arguments.Count() > 0) { Return This.TryInteger(arguments[0]); }
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name && node.Left.Left.Name == "Decimal" && node.Left.Name == "From") {
            String text = "0";
            If (arguments.Count() > 0) { text = arguments[0].Text; }
            Return This.MakeText(text);
        }
        If (name == "AstNode") {
            Value obj = This.BlankValue("AstNode");
            For argument In node.Parameters {
                Value argVal = This.MakeInt(0);
                If (argument.Left != Null) {
                    argVal = This.Evaluate(argument.Left);
                } Else If (argument.Initializer != Null) {
                    argVal = This.Evaluate(argument.Initializer);
                }
                Int fIndex = This.FieldIndex(obj, argument.Name);
                If (fIndex >= 0) { obj.Elements[fIndex] = argVal; }
            }
            Return obj;
        }
        If (name == "Token") {
            Value obj = This.BlankValue("Token");
            Int pos = 0;
            For argument In node.Parameters {
                Value argVal = This.MakeInt(0);
                If (argument.Left != Null) {
                    argVal = This.Evaluate(argument.Left);
                } Else If (argument.Initializer != Null) {
                    argVal = This.Evaluate(argument.Initializer);
                }
                If (argument.Name != "") {
                    Int fIndex = This.FieldIndex(obj, argument.Name);
                    If (fIndex >= 0) { obj.Elements[fIndex] = argVal; }
                } Else If (pos < obj.Elements.Count()) {
                    obj.Elements[pos] = argVal;
                }
                pos = pos + 1;
            }
            Return obj;
        }
        If (name == "ExecutionResult") {
            Value res = This.MakeObjectValue("ExecutionResult");
            res.FieldNames.Add("Code");
            res.FieldNames.Add("Message");
            res.FieldNames.Add("Details");
            If (arguments.Count() > 0) { res.Elements.Add(arguments[0]); }
            If (arguments.Count() > 1) { res.Elements.Add(arguments[1]); }
            If (arguments.Count() > 2) { res.Elements.Add(arguments[2]); }
            Return res;
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name && node.Left.Left.Name == "ExitCode") {
            If (node.Left.Name == "Custom" && arguments.Count() > 0) { Return arguments[0]; }
            Return This.MakeInt(0);
        }
        If (name == "TimeoutError") {
            If (arguments.Count() > 0) { Return arguments[0]; }
            Return This.MakeText("");
        }
        If (name == "Atomic") {
            Value atomic = This.MakeArray();
            atomic.Text = "Atomic";
            If (arguments.Count() > 0) { atomic.Elements.Add(arguments[0]); }
            If (arguments.Count() == 0) { atomic.Elements.Add(This.MakeInt(0)); }
            Return atomic;
        }
        If (name == "RoboException") {
            Value error = This.MakeArray();
            error.Text = "RoboException";
            If (arguments.Count() > 0) { error.Elements.Add(arguments[0]); }
            If (arguments.Count() == 0) { error.Elements.Add(This.MakeText("")); }
            Return error;
        }
        If (name == "AsyncLock") {
            Value gate = This.MakeArray();
            gate.Text = "AsyncLock";
            gate.Elements.Add(This.MakeInt(0));
            Return gate;
        }
        If (name == "CancellationSource") {
            Value source = This.MakeArray();
            source.Text = "CancellationSource";
            source.Elements.Add(This.MakeInt(0));
            source.Elements.Add(This.MakeText(""));
            Return source;
        }
        If (name == "Print") {
            If (!This.consoleEnabled) { Return This.MakeVoid(); }
            String line = "";
            For argument In arguments {
                If (line.Length() > 0) { line = line + " "; }
                line = line + This.Display(argument);
            }
            This.lines.Add(line);
            Return This.MakeVoid();
        }
        If (name == "Assert" || name == "AssertTrue") {
            If (arguments.Count() == 0 || !This.IsTruthy(arguments[0])) {
                This.runtimeErrors.Add("Assertion failed.");
            }
            Return This.MakeVoid();
        }
        If (name == "AssertFalse") {
            If (arguments.Count() > 0 && This.IsTruthy(arguments[0])) {
                This.runtimeErrors.Add("Assertion failed.");
            }
            Return This.MakeVoid();
        }
        If (name == "AssertEqual") {
            If (arguments.Count() >= 2 && !This.Same(arguments[0], arguments[1])) {
                This.runtimeErrors.Add("Assertion failed.");
            }
            Return This.MakeVoid();
        }
        If (name == "AssertNear") {
            Return This.MakeVoid();
        }
        If (name == "ParseInteger" && arguments.Count() > 0) {
            Return This.MakeInt(ParseInteger(arguments[0].Text));
        }
        If (name == "StripNumericSuffix" && arguments.Count() > 0) {
            Return This.MakeText(StripNumericSuffix(arguments[0].Text));
        }
        If (name == "ClockMillis") {
            Return This.MakeInt(ClockMillis());
        }
        If (name == "Input") {
            String line = "";
            If (!This.inTests) { line = ReadLine(); }
            If (node.Left != Null && node.Left.Children.Count() > 0 && node.Left.Children[0].Name == "Int") {
                Return This.MakeInt(ParseInteger(line));
            }
            Return This.MakeText(line);
        }
        If (name == "Queue" || name == "Stack") {
            Value collection = This.MakeArray();
            collection.Text = name;
            Return collection;
        }
        If (name == "Map") {
            Value map = This.MakeArray();
            map.Text = "Map";
            Return map;
        }
        If (name == "Some" || name == "Success" || name == "Error" || name == "Failure" || name == "None" || name == "Tuple") {
            Value wrapper = This.MakeArray();
            wrapper.Text = name;
            For argument In arguments {
                wrapper.Elements.Add(argument);
            }
            Return wrapper;
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name && node.Left.Left.Name == "Memory") {
            If (node.Left.Name == "Allocate") {
                Int count = 1;
                If (arguments.Count() > 0) { count = arguments[0].Integer; }
                Value storage = This.MakeArray();
                storage.Text = "Bytes";
                Int index = 0;
                While (index < count) {
                    storage.Elements.Add(This.MakeInt(0));
                    index = index + 1;
                }
                Value pointer = This.MakeArray();
                pointer.Text = "Ptr";
                pointer.Integer = 0;
                pointer.Elements.Add(storage);
                Return pointer;
            }
            If (node.Left.Name == "Copy" && arguments.Count() >= 3) {
                Value dest = arguments[0];
                Value source = arguments[1];
                Int count = arguments[2].Integer;
                If (dest.Text == "Ptr" && source.Text == "Ptr" && dest.Elements.Count() > 0 && source.Elements.Count() > 0) {
                    Value destStorage = dest.Elements[0];
                    Value sourceStorage = source.Elements[0];
                    Int index = 0;
                    While (index < count) {
                        Int from = source.Integer + index;
                        Int to = dest.Integer + index;
