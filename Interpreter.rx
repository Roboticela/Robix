            Int start = 0;
            If (arguments.Count() > 0) { start = arguments[0].Integer; }
            Int length = text.Length() - start;
            If (arguments.Count() > 1) { length = arguments[1].Integer; }
            If (start < 0) { start = 0; }
            If (length < 0) { length = 0; }
            If (start > text.Length()) { start = text.Length(); }
            If (start + length > text.Length()) { length = text.Length() - start; }
            Return This.MakeText(text.Substring(start, length));
        }
        If (name == "StartsWith" && arguments.Count() > 0) { Return This.MakeBool(text.StartsWith(arguments[0].Text)); }
        If (name == "EndsWith" && arguments.Count() > 0) { Return This.MakeBool(text.EndsWith(arguments[0].Text)); }
        If (name == "Contains" && arguments.Count() > 0) { Return This.MakeBool(text.Contains(arguments[0].Text)); }
        If (name == "IndexOf" && arguments.Count() > 0) {
            If (arguments.Count() > 1) {
                Return This.MakeInt(text.IndexOf(arguments[0].Text, arguments[1].Integer));
            }
            Return This.MakeInt(text.IndexOf(arguments[0].Text));
        }
        If (name == "LastIndexOf" && arguments.Count() > 0) {
            If (arguments.Count() > 1) {
                Return This.MakeInt(text.LastIndexOf(arguments[0].Text, arguments[1].Integer));
            }
            Return This.MakeInt(text.LastIndexOf(arguments[0].Text));
        }
        If (name == "Replace" && arguments.Count() > 1) { Return This.MakeText(text.Replace(arguments[0].Text, arguments[1].Text)); }
        If (name == "ToLower") { Return This.MakeText(text.ToLower()); }
        If (name == "ToUpper") { Return This.MakeText(text.ToUpper()); }
        If (name == "Trim") {
            Int start = 0;
            Int end = text.Length();
            While (start < end) {
                Char c = text.GetChar(start);
                If (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                    start = start + 1;
                } Else {
                    Break;
                }
            }
            While (end > start) {
                Char c = text.GetChar(end - 1);
                If (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                    end = end - 1;
                } Else {
                    Break;
                }
            }
            Return This.MakeText(text.Substring(start, end - start));
        }
        If (name == "Split") {
            Value parts = This.MakeArray();
            String sep = ",";
            If (arguments.Count() > 0) { sep = arguments[0].Text; }
            If (sep.Length() == 0) {
                parts.Elements.Add(This.MakeText(text));
                Return parts;
            }
            Int start = 0;
            While (start <= text.Length()) {
                Int found = text.IndexOf(sep, start);
                If (found < 0) {
                    parts.Elements.Add(This.MakeText(text.Substring(start)));
                    Break;
                }
                parts.Elements.Add(This.MakeText(text.Substring(start, found - start)));
                start = found + sep.Length();
            }
            Return parts;
        }
        If (name == "ToInt") {
            If (text.Length() == 1) {
                Int code = text.GetChar(0).ToInt();
                If (code < 48 || code > 57) {
                    Return This.MakeInt(code);
                }
            }
            Return This.MakeInt(ParseInteger(text));
        }
        Return Value();
    }

    Private Function FindOperator(String key) -> Int {
        Int index = 0;
        While (index < This.operatorKeys.Count()) {
            If (This.operatorKeys[index] == key) { Return index; }
            index = index + 1;
        }
        Return -1;
    }

    Private Function OperatorLibrary(String name, List<Value> arguments) -> Value {
        If (name == "Call") {
            If (arguments.Count() == 0) { Return This.MakeInt(0); }
            Int index = This.FindOperator(arguments[0].Text);
            If (index < 0) { Return This.MakeInt(0); }
            Var rest = List<Value>();
            Int argumentIndex = 1;
            While (argumentIndex < arguments.Count()) {
                rest.Add(arguments[argumentIndex]);
                argumentIndex = argumentIndex + 1;
            }
            Return This.CallFunction(This.operatorNodes[index], rest);
        }
        If (arguments.Count() == 0) { Return This.MakeInt(0); }
        If (name == "Negate") {
            If (arguments[0].Kind == ValueKind.Float) { Return This.MakeFloatBits(F64Neg(arguments[0].Integer)); }
            Return This.MakeInt(0 - arguments[0].Integer);
        }
        If (arguments.Count() < 2) { Return This.MakeInt(0); }
        If (name == "Add") {
            If (arguments[0].Kind == ValueKind.Object && arguments[1].Kind == ValueKind.Object) {
                Int index = This.FindOperator(arguments[0].Text + "+");
                If (index >= 0) { Return This.CallFunction(This.operatorNodes[index], arguments); }
            }
            If (arguments[0].Kind == ValueKind.Float || arguments[1].Kind == ValueKind.Float) {
                Return This.EvaluateFloat("+", arguments[0], arguments[1]);
            }
            Return This.MakeInt(arguments[0].Integer + arguments[1].Integer);
        }
        If (name == "Equal") {
            If (arguments[0].Kind == ValueKind.Object && arguments[1].Kind == ValueKind.Object) {
                Int index = This.FindOperator(arguments[0].Text + "==");
                If (index >= 0) { Return This.CallFunction(This.operatorNodes[index], arguments); }
            }
            Return This.MakeBool(This.Same(arguments[0], arguments[1]));
        }
        If (name == "GreaterThan") {
            If (arguments[0].Kind == ValueKind.Float || arguments[1].Kind == ValueKind.Float) {
                Return This.EvaluateFloat(">", arguments[0], arguments[1]);
            }
            Return This.MakeBool(arguments[0].Integer > arguments[1].Integer);
        }
        If (name == "And") {
            Return This.MakeBool(This.IsTruthy(arguments[0]) && This.IsTruthy(arguments[1]));
        }
        Return This.MakeInt(0);
    }

    Private Function CallFunction(AstNode function, List<Value> arguments) -> Value {
        This.PushScope();
        Int index = 0;
        For parameter In function.Parameters {
            If (!parameter.FlagC) {
                Value argument = This.MakeNull();
                If (index < arguments.Count()) {
                    argument = arguments[index];
                } Else If (parameter.Initializer != Null) {
                    argument = This.Evaluate(parameter.Initializer);
                }
                This.Define(parameter.Name, argument);
                index = index + 1;
            }
        }
        String previous = This.signal;
        Value previousReturn = This.returnValue;
        Var savedYields = List<Value>();
        Bool iterator = function.Kind == AstKind.Function && function.FlagB;
        If (iterator) {
            For item In This.yields { savedYields.Add(item); }
            This.yields = List<Value>();
        }
        This.signal = "";
        This.returnValue = This.MakeVoid();
        If (function.Body != Null) {
            This.ExecuteNode(function.Body);
        } Else If (function.Left != Null) {
            This.returnValue = This.Evaluate(function.Left);
        }
        Value result = This.returnValue;
        If (iterator) {
            result = This.MakeArray();
            For item In This.yields { result.Elements.Add(item); }
            This.yields = savedYields;
        }
        This.signal = previous;
        This.returnValue = previousReturn;
        This.PopScope();
        Return result;
    }

    Private Function PatternMatches(AstNode pattern, Value scrutinee) -> Bool {
        If (pattern.FlagA) { Return True; }
        If (pattern.Left != Null && pattern.Left.Kind == AstKind.IntegerLiteral) {
            Return scrutinee.Kind == ValueKind.Integer && scrutinee.Integer == ParseInteger(pattern.Left.Text);
        }
        If (pattern.Text == "Int" || pattern.Text == "Int64") { Return scrutinee.Kind == ValueKind.Integer; }
        If (pattern.Text == "String") { Return scrutinee.Kind == ValueKind.Text; }
        If (pattern.Text == "Bool") { Return scrutinee.Kind == ValueKind.Boolean; }
        If (pattern.Text == "Float" || pattern.Text == "Double" || pattern.Text == "Float64") { Return scrutinee.Kind == ValueKind.Float; }
        If (pattern.Text.Length() > 0 && scrutinee.Text == pattern.Text) {
            Return True;
        }
        If (pattern.Name.Length() > 0 && pattern.Text.Length() == 0 && pattern.Children.Count() == 0) {
            Return True;
        }
        Return False;
    }

    Private Function BindPattern(AstNode pattern, Value scrutinee) -> Void {
        If (pattern.Name.Length() > 0 && pattern.Name != "_" && pattern.Name != "()") {
            This.Define(pattern.Name, scrutinee);
        }
        Int idx = 0;
        For child In pattern.Children {
            If (child.Name.Length() > 0 && child.Name != "_") {
                Value elem = This.MakeNull();
                If (idx < scrutinee.Elements.Count()) { elem = scrutinee.Elements[idx]; }
                This.Define(child.Name, elem);
            }
            idx = idx + 1;
        }
    }

    Private Function FindFunction(String name) -> AstNode? {
        Return This.FindCallable(name, -1);
    }

    Private Function FindCallable(String name, Int arity) -> AstNode? {
        AstNode? fallback = Null;
        For function In This.functions {
            If (function.Name == name) {
                If (arity >= 0 && function.Parameters.Count() == arity) { Return function; }
                If (fallback == Null) { fallback = function; }
            }
        }
        Return fallback;
    }

    Private Function Define(String name, Value value) -> Void {
        If (name.Length() == 0) { Return; }
        This.names.Add(name);
        This.values.Add(value);
    }

    Private Function Assign(String name, Value value) -> Void {
        Var sought = name;
        Int index = This.names.Count() - 1;
        Int hops = 0;
        While (index >= 0) {
            If (This.names[index] == sought) {
                String target = "";
                If (This.values[index].Kind == ValueKind.Integer) { target = This.AliasTarget(This.values[index].Text); }
                If (target != "" && hops < 8) {
                    sought = target;
                    hops = hops + 1;
                    index = index - 1;
                    Continue;
                }
                This.values[index] = value;
                Return;
            }
            index = index - 1;
        }
        Value self = This.FindValue("This");
        If (name != "This" && self.Kind == ValueKind.Object) {
            Int slot = This.FieldIndex(self, name);
            If (slot >= 0) {
                self.Elements[slot] = value;
                Return;
            }
        }
        This.Define(sought, value);
    }

    Private Function TypeIndex(String name) -> Int {
        Int index = 0;
        For typeNode In This.types {
            If (typeNode.Name == name) { Return index; }
            index = index + 1;
        }
        Return -1;
    }

    Private Function FormatPlaces(String format) -> Int {
        If (format.Length() < 2) { Return -1; }
        String head = format.Substring(0, 1);
        If (head != "F" && head != "f") { Return -1; }
        Int places = 0;
        Int index = 1;
        While (index < format.Length()) {
            Int raw = format.GetChar(index).ToInt();
            Int digit = raw;
            If (raw >= 48) { digit = raw - 48; }
            If (digit < 0 || digit > 9) { Return -1; }
            places = places * 10 + digit;
            index = index + 1;
        }
        Return places;
    }

    Private Function IntegerText(String text) -> Bool {
        If (text.Length() == 0) { Return False; }
        Int index = 0;
        String first = text.Substring(0, 1);
        If (first == "+" || first == "-") {
            If (text.Length() == 1) { Return False; }
            index = 1;
        }
        While (index < text.Length()) {
            Int raw = text.GetChar(index).ToInt();
            Int digit = raw;
            If (raw >= 48) { digit = raw - 48; }
            If (digit < 0 || digit > 9) { Return False; }
            index = index + 1;
        }
        Return True;
    }

    Private Function TryIntegerTag(String text) -> String {
        Value parsed = This.TryInteger(This.MakeText(text));
        Return parsed.Text;
    }

    Private Function TryInteger(Value target) -> Value {
        Value result = This.MakeArray();
        If (target.Kind == ValueKind.Text && This.IntegerText(target.Text)) {
            result.Text = "Success";
            result.Elements.Add(This.MakeInt(ParseInteger(target.Text)));
            Return result;
        }
        result.Text = "Error";
        result.Elements.Add(This.MakeText("InvalidText"));
        Return result;
    }

    Private Function ConvertFloat(Int bits, List<Value> arguments) -> Value {
        If (arguments.Count() > 0 && arguments[0].Kind == ValueKind.Boolean) {
            If (arguments[0].Boolean) { Return This.MakeInt(F64ToIntChecked(bits)); }
            Return This.MakeInt(FloatToInt(bits));
        }
        If (arguments.Count() > 0 && arguments[0].Kind == ValueKind.Integer) {
            Return This.MakeInt(F64ToIntMode(bits, arguments[0].Integer));
        }
        Return This.MakeInt(FloatToInt(bits));
    }

    Private Function MakeReference(AstNode node) -> Value {
        Value reference = This.MakeArray();
        reference.Text = "Ref:";
        If (node.Parameters.Count() == 0 || node.Parameters[0].Left == Null) { Return reference; }
        AstNode argument = node.Parameters[0].Left;
        If (argument.Kind == AstKind.Unary && argument.Operator == "Mut" && argument.Left != Null) {
            argument = argument.Left;
            reference.Text = "MutRef:";
        }
        If (argument.Kind == AstKind.Name) { reference.Text = reference.Text + argument.Name; }
        Return reference;
    }

    Private Function IsMutableReference(String text) -> Bool {
        Return text.StartsWith("MutRef:");
    }

    Private Function ReferenceTarget(String text) -> String {
        If (text.StartsWith("MutRef:")) { Return text.Substring(7); }
        If (text.StartsWith("Ref:")) { Return text.Substring(4); }
        Return "";
    }

    Private Function EnumOrdinal(AstNode typeNode, String name) -> Int {
        Int ordinal = 0;
        For child In typeNode.Children {
            If (child.Kind == AstKind.EnumMember) {
                If (child.Initializer != Null && child.Initializer.Kind == AstKind.IntegerLiteral) {
                    ordinal = ParseInteger(child.Initializer.Text);
                }
                If (child.Name == name) { Return ordinal; }
                ordinal = ordinal + 1;
            }
        }
        Return 0;
    }

    Private Function LookupBuiltinEnum(String typeName, String memberName) -> Int {
        If (typeName == "ValueKind") {
            If (memberName == "None") { Return 0; }
            If (memberName == "Integer") { Return 1; }
            If (memberName == "Float") { Return 2; }
            If (memberName == "Boolean") { Return 3; }
            If (memberName == "Text") { Return 4; }
            If (memberName == "Null") { Return 5; }
            If (memberName == "Array") { Return 6; }
            If (memberName == "Function") { Return 7; }
            If (memberName == "Void") { Return 8; }
            If (memberName == "Object") { Return 9; }
            Return -1;
        }
        If (typeName == "ExitCode") {
            If (memberName == "Success") { Return 0; }
            If (memberName == "WarningExecution") { Return 1; }
            If (memberName == "ErrorExecution") { Return 2; }
            If (memberName == "InvalidArguments") { Return 3; }
            If (memberName == "Custom") { Return 4; }
            Return -1;
        }
        If (typeName == "Rounding") {
            If (memberName == "Nearest") { Return 0; }
            If (memberName == "Truncate") { Return 1; }
            Return -1;
        }
        If (typeName == "AstKind") {
            Return This.LookupAstKind(memberName);
        }
        If (typeName == "TokenKind") {
            Return This.LookupTokenKind(memberName);
        }
        Return -1;
    }

