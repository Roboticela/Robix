        If (name == "Precedence") { Return 122; }
        If (name == "LeftAssociative") { Return 123; }
        If (name == "RightAssociative") { Return 124; }
        If (name == "And") { Return 125; }
        If (name == "Or") { Return 126; }
        If (name == "Not") { Return 127; }
        If (name == "Equal") { Return 128; }
        If (name == "Is") { Return 129; }
        If (name == "Where") { Return 130; }
        If (name == "Type") { Return 131; }
        If (name == "Macro") { Return 132; }
        If (name == "Extern") { Return 133; }
        If (name == "CallingConvention") { Return 134; }
        If (name == "True") { Return 135; }
        If (name == "False") { Return 136; }
        If (name == "Null") { Return 137; }
        If (name == "Void") { Return 138; }
        If (name == "Any") { Return 139; }
        If (name == "Dynamic") { Return 140; }
        If (name == "Int") { Return 141; }
        If (name == "UInt") { Return 142; }
        If (name == "Float") { Return 143; }
        If (name == "Double") { Return 144; }
        If (name == "Decimal") { Return 145; }
        If (name == "Bool") { Return 146; }
        If (name == "Char") { Return 147; }
        If (name == "String") { Return 148; }
        If (name == "Out") { Return 149; }
        If (name == "Clobber") { Return 150; }
        If (name == "Test") { Return 151; }
        Return -1;
    }

    Private Function MakeEnumValue(AstNode typeNode, String name, List<Value> arguments) -> Value {
        For child In typeNode.Children {
            If (child.Kind == AstKind.EnumMember && child.Name == name) {
                If (child.Parameters.Count() == 0) { Return This.MakeInt(This.EnumOrdinal(typeNode, name)); }
                Value obj = This.MakeObjectValue(typeNode.Name);
                Int index = 0;
                For parameter In child.Parameters {
                    obj.FieldNames.Add(parameter.Name);
                    Value field = This.MakeInt(0);
                    If (index < arguments.Count()) { field = arguments[index]; }
                    obj.Elements.Add(field);
                    index = index + 1;
                }
                Return obj;
            }
        }
        Return This.MakeInt(0);
    }

    Private Function TakeFront(Value collection) -> Value {
        If (collection.Elements.Count() == 0) { Return This.MakeInt(0); }
        Value item = collection.Elements[0];
        Var kept = List<Value>();
        Int index = 1;
        While (index < collection.Elements.Count()) {
            kept.Add(collection.Elements[index]);
            index = index + 1;
        }
        collection.Elements = kept;
        Return item;
    }

    Private Function TakeBack(Value collection) -> Value {
        Int count = collection.Elements.Count();
        If (count == 0) { Return This.MakeInt(0); }
        Value item = collection.Elements[count - 1];
        Var kept = List<Value>();
        Int index = 0;
        While (index + 1 < count) {
            kept.Add(collection.Elements[index]);
            index = index + 1;
        }
        collection.Elements = kept;
        Return item;
    }

    Private Function TypeMatches(Value value, String expected) -> Bool {
        If (expected == "Bool") { Return value.Kind == ValueKind.Boolean; }
        If (expected == "String") { Return value.Kind == ValueKind.Text; }
        If (expected == "Float" || expected == "Double") { Return value.Kind == ValueKind.Float; }
        If (expected == "Null") { Return value.Kind == ValueKind.Null; }
        If (expected == "Int" || expected == "Int64") { Return value.Kind == ValueKind.Integer; }
        Return False;
    }

    Private Function MakeRecord(AstNode node) -> Value {
        Value obj = This.MakeObjectValue("");
        For child In node.Children {
            Value field = This.MakeInt(0);
            If (child.Left != Null) { field = This.Evaluate(child.Left); }
            obj.FieldNames.Add(child.Name);
            obj.Elements.Add(field);
        }
        Return obj;
    }

    Private Function MakeMap(AstNode node) -> Value {
        Value map = This.MakeArray();
        map.Text = "Map";
        For child In node.Children {
            map.Elements.Add(This.MakeText(child.Name));
            If (child.Left != Null) { map.Elements.Add(This.Evaluate(child.Left)); }
            If (child.Left == Null) { map.Elements.Add(This.MakeInt(0)); }
        }
        Return map;
    }

    Private Function MakeSet(AstNode node) -> Value {
        Value set = This.MakeArray();
        set.Text = "Set";
        For child In node.Children {
            Value item = This.Evaluate(child);
            Bool seen = False;
            For existing In set.Elements {
                If (This.Same(existing, item)) { seen = True; }
            }
            If (!seen) { set.Elements.Add(item); }
        }
        Return set;
    }

    Private Function MakeObject(AstNode node) -> Value {
        Value obj = This.MakeObjectValue(node.Name);
        Int typeIndex = This.TypeIndex(node.Name);
        If (typeIndex >= 0) {
            For field In This.types[typeIndex].Children {
                If (field.Kind == AstKind.Field) {
                    obj.FieldNames.Add(field.Name);
                    obj.Elements.Add(This.MakeInt(0));
                }
            }
        }
        For child In node.Children {
            Value field = This.MakeInt(0);
            If (child.Left != Null) { field = This.Evaluate(child.Left); }
            Int index = This.FieldIndex(obj, child.Name);
            If (index < 0) {
                obj.FieldNames.Add(child.Name);
                obj.Elements.Add(field);
            } Else {
                obj.Elements[index] = field;
            }
        }
        Return obj;
    }

    Private Function MakeObjectValue(String typeName) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Object;
        value.Text = typeName + "";
        value.Integer = 0;
        value.Boolean = False;
        value.Elements = List<Value>();
        value.FieldNames = List<String>();
        Return value;
    }

    Private Function FieldIndex(Value value, String name) -> Int {
        Int index = 0;
        For field In value.FieldNames {
            If (field == name) { Return index; }
            index = index + 1;
        }
        Return -1;
    }

    Private Function HasName(String name) -> Bool {
        Int index = This.names.Count() - 1;
        While (index >= 0) {
            If (This.names[index] == name) { Return True; }
            index = index - 1;
        }
        Return False;
    }

    Private Function Lookup(String name) -> Value {
        Var sought = name;
        Int index = This.names.Count() - 1;
        Int hops = 0;
        While (index >= 0) {
            If (This.names[index] == sought) {
                String target = "";
                If (This.values[index].Kind == ValueKind.Integer) { target = This.AliasTarget(This.values[index].Text); }
                If (target != "" && hops < 8) {
                    sought = target;
                    hops = hops + 1;
                    index = index - 1;
                    Continue;
                }
                Return This.values[index];
            }
            index = index - 1;
        }
        Value self = This.FindValue("This");
        If (name != "This" && self.Kind == ValueKind.Object) {
            Int slot = This.FieldIndex(self, name);
            If (slot >= 0) { Return self.Elements[slot]; }
        }
        This.runtimeErrors.Add("Name '" + sought + "' is not defined at runtime.");
        Return This.MakeNull();
    }

    Private Function FindMacro(String name) -> AstNode? {
        For macro In This.macros {
            If (macro.Name == name) { Return macro; }
        }
        Return Null;
    }

    Private Function ExpandMacro(AstNode macro, AstNode call) -> Value {
        If (macro.Body == Null) { Return This.MakeVoid(); }
        Return This.ExpandMacroNode(macro, call, macro.Body);
    }

    Private Function ExpandMacroNode(AstNode macro, AstNode call, AstNode node) -> Value {
        If (node.Kind == AstKind.Block) {
            For child In node.Children { This.ExpandMacroNode(macro, call, child); }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.ExpressionStatement && node.Left != Null && node.Left.Kind == AstKind.Name) {
            Int slot = 0;
            For parameter In macro.Parameters {
                If (parameter.Name == node.Left.Name && slot < call.Parameters.Count() && call.Parameters[slot].Left != Null) {
                    Return This.Evaluate(call.Parameters[slot].Left);
                }
                slot = slot + 1;
            }
        }
        Return This.ExecuteNode(node);
    }

    Private Function FindValue(String name) -> Value {
        Int index = This.names.Count() - 1;
        While (index >= 0) {
            If (This.names[index] == name) { Return This.values[index]; }
            index = index - 1;
        }
        Return This.MakeVoid();
    }

    Private Function MakePromise() -> Value {
        Value promise = This.MakeArray();
        promise.Text = "Promise";
        promise.Elements.Add(This.MakeNull());
        promise.Elements.Add(This.MakeBool(False));
        promise.Elements.Add(This.MakeBool(False));
        Return promise;
    }

    Private Function IsPromiseCallback(String text) -> Bool {
        Return text == "PromiseResolve" || text == "PromiseReject";
    }

    Private Function MakePromiseCall(AstNode node) -> Value {
        String method = "";
        If (node.Left != Null) { method = node.Left.Name; }
        Value promise = This.MakePromise();
        If (method == "Resolved" || method == "Rejected") {
            Value payload = This.MakeNull();
            If (node.Parameters.Count() > 0 && node.Parameters[0].Left != Null) {
                payload = This.Evaluate(node.Parameters[0].Left);
            }
            promise.Elements[0] = payload;
            If (method == "Rejected") { promise.Elements[1] = This.MakeBool(True); }
            promise.Elements[2] = This.MakeBool(True);
            Return promise;
        }
        If ((method == "Create" || method == "FromCallback") && node.Parameters.Count() > 0) {
            AstNode lambda = node.Parameters[0];
            If (lambda.Kind == AstKind.Argument && lambda.Left != Null) { lambda = lambda.Left; }
            Value resolve = This.MakeInt(0);
            resolve.Text = "PromiseResolve";
            resolve.Elements.Add(promise);
            Value reject = This.MakeInt(0);
            reject.Text = "PromiseReject";
            reject.Elements.Add(promise);
            Var callbacks = List<Value>();
            callbacks.Add(resolve);
            callbacks.Add(reject);
            This.CallFunction(lambda, callbacks);
        }
        Return promise;
    }

    Private Function SettlePromise(Value callee, List<Value> supplied) -> Value {
        If (callee.Elements.Count() == 0) { Return This.MakeVoid(); }
        Value promise = callee.Elements[0];
        Value payload = This.MakeNull();
        If (supplied.Count() > 0) { payload = supplied[0]; }
        promise.Elements[0] = payload;
        promise.Elements[1] = This.MakeBool(callee.Text == "PromiseReject");
        promise.Elements[2] = This.MakeBool(True);
        Return payload;
    }

    Private Function ReadLegacyText(AstNode node) -> String {
        String note = "robot-note";
        Int index = 0;
        While (index < node.Parameters.Count()) {
            AstNode argument = node.Parameters[index];
            If (argument.Name == "onSuccess" && argument.Left != Null) {
                Value callback = This.Evaluate(argument.Left);
                If (callback.Kind == ValueKind.Function && callback.FunctionNode != Null) {
                    Var supplied = List<Value>();
                    supplied.Add(This.MakeText(note));
                    This.CallFunction(callback.FunctionNode, supplied);
                }
            }
            index = index + 1;
        }
        Return note;
    }

    Private Function IsTaskLibrary(String owner, String name) -> Bool {
        If (owner == "Task" && (name == "Delay" || name == "Yield" || name == "FromResult" || name == "Run" || name == "WhenAll" || name == "Detach")) { Return True; }
        If (owner == "Scheduler" && (name == "QueueMicrotask" || name == "Queue")) { Return True; }
        If (owner == "Function" && (name == "Debounce" || name == "Throttle" || name == "Compose")) { Return True; }
        If (owner == "Network" && (name == "SendText" || name == "IsConnected")) { Return True; }
        If (owner == "Async" && name == "WaitUntil") { Return True; }
        If (owner == "Promise" && (name == "All" || name == "Race" || name == "Any" || name == "AllSettled")) { Return True; }
        If (owner == "Duration" && (name == "Milliseconds" || name == "Seconds")) { Return True; }
        If (owner == "Hardware" && (name == "ReadSensor" || name == "WatchSensor")) { Return True; }
        If (owner == "Timer" && (name == "SetTimeout" || name == "SetInterval" || name == "SetIntervalAsync" || name == "ClearInterval" || name == "Clear" || name == "Sleep")) { Return True; }
        Return False;
    }

    Private Function TaskLibraryValue(String owner, String name, List<Value> supplied) -> Value {
        If (owner == "Duration" && name == "Milliseconds") {
            If (supplied.Count() > 0) { Return supplied[0]; }
            Return This.MakeInt(0);
        }
        If (owner == "Duration" && name == "Seconds") {
            If (supplied.Count() > 0) { Return This.MakeInt(supplied[0].Integer * 1000); }
            Return This.MakeInt(0);
        }
        If (owner == "Hardware" && name == "ReadSensor") { Return This.MakeInt(40); }
        If (owner == "Hardware" && name == "WatchSensor") {
            Value stream = This.MakeArray();
            stream.Text = "AsyncStream";
            stream.Elements.Add(This.MakeInt(40));
            Return stream;
        }
        If (owner == "Timer" && (name == "SetTimeout" || name == "SetInterval" || name == "SetIntervalAsync")) {
            Value handle = This.MakeArray();
            handle.Text = "TimerHandle";
            handle.Elements.Add(This.MakeInt(0));
            If (supplied.Count() > 0) { handle.Elements.Add(supplied[0]); }
            Return handle;
        }
        If (owner == "Timer" && (name == "ClearInterval" || name == "Clear")) {
            If (supplied.Count() > 0 && supplied[0].Text == "TimerHandle" && supplied[0].Elements.Count() > 0) {
                supplied[0].Elements[0] = This.MakeInt(1);
            }
            Return This.MakeVoid();
        }
        If (owner == "Task" && name == "FromResult") {
            If (supplied.Count() > 0) { Return supplied[0]; }
            Return This.MakeInt(0);
        }
        If (owner == "Task" && name == "Run") {
            If (supplied.Count() > 0 && supplied[0].Kind == ValueKind.Function && supplied[0].FunctionNode != Null) {
                Return This.CallFunction(supplied[0].FunctionNode, List<Value>());
            }
            Return This.MakeVoid();
        }
        If (owner == "Function" && name == "Compose") {
            Value wrap = This.MakeArray();
            wrap.Text = "Compose";
            If (supplied.Count() > 1 && supplied[0].Kind == ValueKind.Function && supplied[1].Kind == ValueKind.Function) {
                wrap = This.MakeFunction(supplied[0].FunctionNode);
                wrap.Text = "Compose";
                wrap.Elements.Add(supplied[0]);
                wrap.Elements.Add(supplied[1]);
            }
            Return wrap;
        }
        If (owner == "Function" && name == "Debounce") {
            If (supplied.Count() > 0) { Return supplied[0]; }
            Return This.MakeVoid();
        }
        If (owner == "Function" && name == "Throttle") {
            If (supplied.Count() > 0 && supplied[0].Kind == ValueKind.Function) {
                Value wrap = This.MakeFunction(supplied[0].FunctionNode);
                wrap.Text = "Throttle:" + supplied[0].Text;
                wrap.Elements.Add(This.MakeInt(0));
                Return wrap;
            }
            Return This.MakeVoid();
        }
        If (owner == "Scheduler" && (name == "QueueMicrotask" || name == "Queue")) {
            If (supplied.Count() > 0 && supplied[0].Kind == ValueKind.Function && supplied[0].FunctionNode != Null) {
                Return This.CallFunction(supplied[0].FunctionNode, List<Value>());
            }
            Return This.MakeVoid();
        }
        If (owner == "Task" && name == "WhenAll") {
            Value tuple = This.MakeArray();
            For item In supplied {
                tuple.Elements.Add(item);
            }
            Return tuple;
        }
        If (owner == "Network" && name == "IsConnected") { Return This.MakeBool(True); }
        If (owner == "Async" && name == "WaitUntil") {
            If (supplied.Count() > 0 && supplied[0].Kind == ValueKind.Function && supplied[0].FunctionNode != Null) {
                Value result = This.CallFunction(supplied[0].FunctionNode, List<Value>());
                Return This.MakeBool(This.IsTruthy(result));
            }
            Return This.MakeBool(False);
        }
        If (owner == "Network" && name == "SendText") {
            If (supplied.Count() > 0) { Return supplied[0]; }
            Return This.MakeText("");
        }
        If (owner == "Promise" && (name == "All" || name == "Race" || name == "Any" || name == "AllSettled")) {
            Value jobs = This.MakeArray();
            If (supplied.Count() > 0) { jobs = supplied[0]; }
            If (name == "Race" || name == "Any") {
                If (jobs.Elements.Count() > 0) { Return jobs.Elements[0]; }
                Return This.MakeInt(0);
            }
            If (name == "AllSettled") {
                Value outcomes = This.MakeArray();
                For item In jobs.Elements {
                    outcomes.Elements.Add(This.MakeText("Fulfilled:" + This.Display(item)));
                }
                Return outcomes;
            }
            Return jobs;
        }
        Return This.MakeVoid();
    }

    Private Function MakeAlias(String name) -> Value {
        Value alias = This.MakeInt(0);
        alias.Text = "MutBind:" + name;
        Return alias;
    }

    Private Function AliasTarget(String text) -> String {
        If (text.StartsWith("MutBind:")) { Return text.Substring(8); }
        Return "";
    }

    Private Function PushScope() -> Void {
        This.marks.Add(This.names.Count());
    }

    Private Function PopScope() -> Void {
        If (This.marks.Count() == 0) { Return; }
        Int mark = This.marks[This.marks.Count() - 1];
        Int dying = This.names.Count() - 1;
        While (dying >= mark) {
            If (This.names[dying] != "This" && This.values[dying].Kind == ValueKind.Object) {
                This.RunDestructor(This.values[dying].Text, This.values[dying]);
            }
            dying = dying - 1;
        }
        Var keptNames = List<String>();
        Var keptValues = List<Value>();
        Int index = 0;
        While (index < mark) {
            keptNames.Add(This.names[index]);
            keptValues.Add(This.values[index]);
            index = index + 1;
        }
        This.names = keptNames;
        This.values = keptValues;
        Var keptMarks = List<Int>();
        Int markIndex = 0;
        While (markIndex < This.marks.Count() - 1) {
            keptMarks.Add(This.marks[markIndex]);
            markIndex = markIndex + 1;
        }
        This.marks = keptMarks;
    }

    Private Function MakeInt(Int number) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Integer;
        value.Integer = number;
        Return value;
    }

    Private Function MakeFloatBits(Int bits) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Float;
        value.Integer = bits;
        Return value;
    }

    Private Function ParseFloat(String text) -> Value {
        String compact = text.Replace("_", "");
        String lower = compact.ToLower();
        String number = StripNumericSuffix(compact);
        If (lower.EndsWith("f64")) {
            Return This.MakeFloatBits(ParseF64(number));
        }
        If (lower.EndsWith("f32") || lower.EndsWith("f")) {
            Return This.MakeFloatBits(F32Parse(number));
        }
        If (lower.EndsWith("m")) {
            Return This.MakeText(number);
        }
        Return This.MakeFloatBits(ParseF64(number));
    }

    Private Function AdaptNumeric(String typeName, Value value, AstNode? initializer) -> Value {
        If (typeName == "Decimal") {
            If (value.Kind == ValueKind.Text) { Return value; }
            If (initializer != Null) {
                If (initializer.Kind == AstKind.FloatLiteral) {
                    Return This.MakeText(StripNumericSuffix(initializer.Text.Replace("_", "")));
                }
                If (initializer.Kind == AstKind.IntegerLiteral) {
                    Return This.MakeText(ParseInteger(initializer.Text).ToString() + ".0");
                }
            }
            Return value;
        }
        If (initializer != Null) {
            If (typeName == "Float16" && initializer.Kind == AstKind.FloatLiteral) {
                Return This.MakeFloatBits(F16Parse(StripNumericSuffix(initializer.Text.Replace("_", ""))));
            }
            If (typeName == "Float32" && initializer.Kind == AstKind.FloatLiteral) {
                Return This.MakeFloatBits(F32Parse(StripNumericSuffix(initializer.Text.Replace("_", ""))));
            }
            If (initializer.Kind == AstKind.IntegerLiteral && This.IsWideUnsigned(typeName)) {
                String digits = initializer.Text.Replace("_", "");
                Value wide = This.MakeInt(U64Parse(digits));
                If (wide.Integer < 0) { wide.Text = "u:" + digits; }
                Return wide;
            }
        }
        If (value.Kind == ValueKind.Integer && (typeName == "Int8" || typeName == "Int16" || typeName == "Int32" || typeName == "UInt8" || typeName == "UInt16" || typeName == "UInt32" || typeName == "Byte")) {
            Return This.MakeWidth(typeName, value.Integer);
        }
        Return value;
    }

    Private Function NumericFrom(String typeName, AstNode node, List<Value> arguments) -> Value {
        Int places = -1;
        Bool hasPlaces = False;
        Int index = 0;
        Int valueIndex = 0;
        Bool hasValue = False;
        For argument In node.Parameters {
            If (argument.Name == "precision" || argument.Name == "scale") {
                If (index < arguments.Count()) {
                    places = arguments[index].Integer;
                    hasPlaces = True;
                }
            } Else If (!hasValue) {
                valueIndex = index;
                hasValue = True;
            }
            index = index + 1;
        }
        Value source = This.MakeInt(0);
        If (hasValue && valueIndex < arguments.Count()) { source = arguments[valueIndex]; }
        If (typeName == "Decimal") {
            String text = This.NumericText(source);
            If (hasPlaces) { text = This.FixedText(text, places); }
            Else If (!text.Contains(".")) { text = text + ".0"; }
            Return This.MakeText(text);
        }
        If (typeName == "Float" || typeName == "Double" || typeName == "Float16" || typeName == "Float32" || typeName == "Float64") {
            String text = This.NumericText(source);
            If (hasPlaces) { text = This.FixedText(text, places); }
            If (typeName == "Float32" || typeName == "Float16") { Return This.MakeFloatBits(F32Parse(text)); }
            Return This.MakeFloatBits(ParseF64(text));
        }
        If (typeName.StartsWith("Float<")) {
            String text = This.NumericText(source);
            If (hasValue && valueIndex < node.Parameters.Count()) {
                AstNode valueNode = node.Parameters[valueIndex];
                If (valueNode.Kind == AstKind.Argument && valueNode.Left != Null) { valueNode = valueNode.Left; }
                If (valueNode.Kind == AstKind.FloatLiteral || valueNode.Kind == AstKind.IntegerLiteral) {
                    text = StripNumericSuffix(valueNode.Text.Replace("_", ""));
                    If (valueNode.Kind == AstKind.IntegerLiteral && text.IndexOf(".") < 0) { text = text + ".0"; }
                }
            }
            Return This.MakeText(text);
        }
        Int number = 0;
        If (source.Kind == ValueKind.Text) { number = ParseInteger(source.Text); }
        Else If (source.Kind == ValueKind.Float) { number = FloatToInt(source.Integer); }
        Else { number = source.Integer; }
        Return This.MakeWidth(typeName, number);
    }

    Private Function NumericText(Value source) -> String {
        If (source.Kind == ValueKind.Text) { Return source.Text; }
        If (source.Kind == ValueKind.Float) { Return TextF64(source.Integer); }
        Return source.Integer.ToString();
    }

    Private Function NumericMax(String name) -> Int {
        If (name == "UInt8" || name == "Byte") { Return 255; }
        If (name == "Int8") { Return 127; }
        If (name == "UInt16") { Return 65535; }
        If (name == "Int16") { Return 32767; }
        Return ParseInteger("9223372036854775807");
    }

    Private Function SaturatingAdd(String name, Int left, Int right) -> Int {
        Int sum = left + right;
        If (name == "UInt8" || name == "Byte") {
            If (sum > 255) { Return 255; }
            If (sum < 0) { Return 0; }
        }
        Return sum;
    }

    Private Function WrapAdd(Int left, Int right) -> Int {
        If (left >= 0 && right >= 0) {
            Int limit = ParseInteger("9223372036854775807");
            If (right > 0 && left > limit - right) {
                Int minimum = 0 - limit - 1;
                Int over = left - (limit - right) - 1;
                Return minimum + over;
            }
            Return left + right;
        }
        Return left + right;
    }

    Private Function IsNumericOwner(String typeName) -> Bool {
        Return typeName == "Int" || typeName == "UInt" || typeName == "Float" || typeName == "Double" || typeName == "Decimal" || typeName == "Byte" || typeName.StartsWith("Int") || typeName.StartsWith("UInt") || typeName.StartsWith("Float");
    }

    Private Function BitWidth(String typeName) -> Int {
        If (typeName == "Int8" || typeName == "UInt8" || typeName == "Byte") { Return 8; }
        If (typeName == "Int16" || typeName == "UInt16") { Return 16; }
        If (typeName == "Int32" || typeName == "UInt32") { Return 32; }
        If (typeName == "Int" || typeName == "Int64" || typeName == "UInt" || typeName == "UInt64") { Return 64; }
        Int open = typeName.IndexOf("<");
        If (open < 0 || !typeName.EndsWith(">")) { Return 0; }
        String inner = typeName.Substring(open + 1, typeName.Length() - open - 2);
        If (inner == "") { Return 0; }
        Return ParseInteger(inner);
    }

    Private Function IsWideUnsigned(String typeName) -> Bool {
        If (!(typeName == "UInt" || typeName == "UInt64" || typeName.StartsWith("UInt<"))) { Return False; }
        Return This.BitWidth(typeName) >= 64;
    }

    Private Function MakeWidth(String typeName, Int number) -> Value {
        Int bits = This.BitWidth(typeName);
        Bool unsigned = typeName == "Byte" || typeName.StartsWith("UInt");
        If (bits > 0 && bits < 64) {
            If (unsigned) {
                Int span = 1;
                Int count = 0;
                While (count < bits) {
                    span = span * 2;
                    count = count + 1;
                }
                Return This.MakeInt(This.Mask(number, span - 1));
            }
            Return This.MakeInt(This.SignExtend(number, bits));
        }
        If (unsigned && number < 0 && !typeName.StartsWith("UInt<")) { Return This.MakeInt(0); }
        Return This.MakeInt(number);
    }

    Private Function Mask(Int number, Int mask) -> Int {
        Int span = mask + 1;
        Int value = number % span;
        If (value < 0) { value = value + span; }
        Return value;
    }

    Private Function SignExtend(Int number, Int bits) -> Int {
        If (bits <= 0) { Return number; }
        If (bits >= 63) { Return number; }
        Int span = 1;
        Int count = 0;
        While (count < bits) {
            span = span * 2;
            count = count + 1;
        }
        Int masked = This.Mask(number, span - 1);
        Int sign = span / 2;
        If (masked >= sign) { Return masked - span; }
        Return masked;
    }

    Private Function FixedText(String text, Int places) -> String {
        If (places < 0) { Return text; }
        String body = text;
        String sign = "";
        If (body.StartsWith("-")) {
            sign = "-";
            body = body.Substring(1);
        }
        Int dot = body.IndexOf(".");
        String whole = body;
        String frac = "";
        If (dot >= 0) {
            whole = body.Substring(0, dot);
            frac = body.Substring(dot + 1);
        }
        If (whole == "") { whole = "0"; }
        While (frac.Length() < places + 1) { frac = frac + "0"; }
        String kept = "";
        If (places > 0) { kept = frac.Substring(0, places); }
        Int roundUp = 0;
        Int nextRaw = frac.GetChar(places).ToInt();
        Int next = nextRaw;
        If (nextRaw >= 48) { next = nextRaw - 48; }
        If (next > 5) { roundUp = 1; }
        If (next == 5) {
            Bool more = False;
            Int cursor = places + 1;
            While (cursor < frac.Length()) {
                If (frac.GetChar(cursor) != '0') { more = True; }
                cursor = cursor + 1;
            }
            Int lastRaw = whole.GetChar(whole.Length() - 1).ToInt();
            Int last = lastRaw;
            If (lastRaw >= 48) { last = lastRaw - 48; }
            If (places > 0) {
                lastRaw = kept.GetChar(places - 1).ToInt();
                last = lastRaw;
                If (lastRaw >= 48) { last = lastRaw - 48; }
            }
            If (more || last % 2 == 1) { roundUp = 1; }
        }
        If (places == 0) {
            If (roundUp == 1) { whole = This.AddNumeric(whole); }
            Return sign + whole;
        }
        String combined = whole + kept;
        If (roundUp == 1) { combined = This.AddNumeric(combined); }
        String newWhole = combined.Substring(0, combined.Length() - places);
        String newFrac = combined.Substring(combined.Length() - places);
        Return sign + newWhole + "." + newFrac;
    }

    Private Function AddNumeric(String digits) -> String {
        String result = "";
        Int carry = 1;
        Int index = digits.Length() - 1;
        While (index >= 0) {
            Int raw = digits.GetChar(index).ToInt();
            Int digit = raw + carry;
            If (raw >= 48) { digit = raw - 48 + carry; }
            carry = 0;
            If (digit >= 10) {
                digit = digit - 10;
                carry = 1;
            }
            String table = "0123456789";
            result = table.Substring(digit, 1) + result;
            index = index - 1;
        }
        If (carry == 1) { result = "1" + result; }
        Return result;
    }

    Private Function FloatBits(Value value) -> Int {
        If (value.Kind == ValueKind.Float) { Return value.Integer; }
        Return FloatFromInt(value.Integer);
    }

    Private Function EvaluateFloat(String operator, Value left, Value right) -> Value {
        Int first = This.FloatBits(left);
        Int second = This.FloatBits(right);
        If (operator == "+") { Return This.MakeFloatBits(F64Add(first, second)); }
        If (operator == "-") { Return This.MakeFloatBits(F64Sub(first, second)); }
        If (operator == "*") { Return This.MakeFloatBits(F64Mul(first, second)); }
        If (operator == "/") { Return This.MakeFloatBits(F64Div(first, second)); }
        Int compared = F64Cmp(first, second);
        If (operator == "==") { Return This.MakeBool(compared == 0); }
        If (operator == "!=") { Return This.MakeBool(compared != 0); }
        If (operator == "<") { Return This.MakeBool(compared < 0); }
        If (operator == ">") { Return This.MakeBool(compared > 0); }
        If (operator == "<=") { Return This.MakeBool(compared <= 0); }
        If (operator == ">=") { Return This.MakeBool(compared >= 0); }
        Return This.MakeFloatBits(first);
    }

    Private Function MakeBool(Bool number) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Boolean;
        value.Boolean = number;
        Return value;
    }

    Private Function MakeText(String text) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Text;
        value.Text = text + "";
        Return value;
    }

    Private Function MakeNull() -> Value {
        Value value = Value();
        value.Kind = ValueKind.Null;
        Return value;
    }

    Private Function MakeVoid() -> Value {
        Value value = Value();
        value.Kind = ValueKind.Void;
        Return value;
    }

    Private Function MakeArray() -> Value {
        Value value = Value();
        value.Kind = ValueKind.Array;
        Return value;
    }

    Private Function MakeFunction(AstNode node) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Function;
        value.FunctionNode = node;
        value.Text = node.Name;
        Return value;
    }

    Private Function IsTruthy(Value value) -> Bool {
        If (value.Kind == ValueKind.Boolean) { Return value.Boolean; }
        If (value.Kind == ValueKind.Integer) { Return value.Integer != 0; }
        If (value.Kind == ValueKind.Null || value.Kind == ValueKind.None || value.Kind == ValueKind.Void) { Return False; }
        Return True;
    }

    Private Function Same(Value left, Value right) -> Bool {
        If (left.Kind != right.Kind) { Return False; }
        If (left.Kind == ValueKind.Float) { Return F64Cmp(left.Integer, right.Integer) == 0; }
        If (left.Kind == ValueKind.Integer) { Return left.Integer == right.Integer; }
        If (left.Kind == ValueKind.Boolean) { Return left.Boolean == right.Boolean; }
        If (left.Kind == ValueKind.Text) { Return left.Text == right.Text; }
        If (left.Kind == ValueKind.Null) { Return True; }
        Return False;
    }

    Private Function StandardLibrary(AstNode node, List<Value> arguments) -> Value {
        Value missed = Value();
        missed.Kind = ValueKind.None;
        If (node.Left == Null || node.Left.Kind != AstKind.Member || node.Left.Left == Null) { Return missed; }
        String owner = node.Left.Left.Name;
        String method = node.Left.Name;
        String text = "";
        If (arguments.Count() > 0) { text = arguments[0].Text; }
        If (owner == "Paths") {
            If (method == "Name") {
                Int slash = text.LastIndexOf("/");
                If (slash < 0) { Return This.MakeText(text); }
                Return This.MakeText(text.Substring(slash + 1));
            }
            If (method == "Directory") {
                Int slash = text.LastIndexOf("/");
                If (slash < 0) { Return This.MakeText(""); }
                Return This.MakeText(text.Substring(0, slash));
            }
            If (method == "Extension") {
                Int dot = text.LastIndexOf(".");
                Int slash = text.LastIndexOf("/");
                If (dot < 0 || dot < slash) { Return This.MakeText(""); }
                Return This.MakeText(text.Substring(dot));
            }
            If (method == "Join") {
                String file = "";
                If (arguments.Count() > 1) { file = arguments[1].Text; }
                If (text.Length() == 0) { Return This.MakeText(file); }
                If (text.EndsWith("/")) { Return This.MakeText(text + file); }
                Return This.MakeText(text + "/" + file);
            }
        }
        If (owner == "Date" && text.Length() >= 10) {
            Int year = ParseInteger(text.Substring(0, 4));
            Int month = ParseInteger(text.Substring(5, 2));
            Int day = ParseInteger(text.Substring(8, 2));
            If (method == "Year") { Return This.MakeInt(year); }
            If (method == "Month") { Return This.MakeInt(month); }
            If (method == "Day") { Return This.MakeInt(day); }
        }
        If (owner == "Date") { Return This.MakeInt(0); }
        If (owner == "Time") {
            Int value = 0;
            If (arguments.Count() > 0) { value = arguments[0].Integer; }
            If (method == "Millis") { Return This.MakeInt(value * 1000); }
            If (method == "Seconds") { Return This.MakeInt(value / 1000); }
        }
        If (owner == "Net") {
            Int colon = text.LastIndexOf(":");
            If (method == "Host") {
                If (colon < 0) { Return This.MakeText(text); }
                Return This.MakeText(text.Substring(0, colon));
            }
            If (method == "Port") {
                If (colon < 0) { Return This.MakeInt(0); }
                Return This.MakeInt(ParseInteger(text.Substring(colon + 1)));
            }
        }
        If (owner == "Json") {
            If (method == "Quote") { Return This.MakeText("\"" + text + "\""); }
            If (method == "Object") {
                String valueText = "";
                If (arguments.Count() > 1) { valueText = This.Display(arguments[1]); }
                Return This.MakeText("{\"" + text + "\":" + valueText + "}");
            }
        }
        If (owner == "Log" && (method == "Info" || method == "Error")) {
            If (This.consoleEnabled) {
                String prefix = "info";
                If (method == "Error") { prefix = "error"; }
                String body = "";
                If (arguments.Count() > 0) { body = This.Display(arguments[0]); }
                This.lines.Add(prefix + " " + body);
            }
            Return This.MakeVoid();
        }
        If (owner == "Process" && method == "Count") { Return This.MakeInt(This.programArguments.Count()); }
        If (owner == "Process" && method == "Argument") {
            Int index = 0;
            If (arguments.Count() > 0) { index = arguments[0].Integer; }
            If (index < 0 || index >= This.programArguments.Count()) { Return This.MakeText(""); }
            Return This.MakeText(This.programArguments[index]);
        }
        If (owner == "Environment" && method == "Get") {
            If (text == "ROBIX") { Return This.MakeText("1"); }
            If (text == "ROBIX_CONSOLE") {
                If (This.consoleEnabled) { Return This.MakeText("on"); }
                Return This.MakeText("off");
            }
            If (text == "PORT") { Return This.MakeText(This.consolePort.ToString()); }
            Return This.MakeText("");
        }
        If (owner == "Crypto" && method == "Hash") {
            Int hash = 5381;
            Int index = 0;
            While (index < text.Length()) {
                hash = hash * 33 + text.GetChar(index).ToInt();
                index = index + 1;
            }
            If (hash < 0) { hash = 0 - hash; }
            Return This.MakeInt(hash);
        }
        If (owner == "Testing" && method == "Equal") {
            If (arguments.Count() < 2) { Return This.MakeBool(False); }
            Return This.MakeBool(This.Same(arguments[0], arguments[1]));
        }
        If (owner == "Diagnostics" && method == "Format") {
            String message = "";
            If (arguments.Count() > 1) { message = This.Display(arguments[1]); }
            Return This.MakeText(text + ": " + message);
        }
        If (owner == "Library" && method == "Contains") {
            Bool known = text == "Math" || text == "String" || text == "Collection" || text == "Files" || text == "Paths" || text == "Date" || text == "Time" || text == "Net" || text == "Json" || text == "Log" || text == "Process" || text == "Environment" || text == "Crypto" || text == "Testing" || text == "Reflect" || text == "Diagnostics" || text == "Hardware" || text == "Concurrency";
            Return This.MakeBool(known);
        }
        If (owner == "Collection" && method == "Count") {
            If (arguments.Count() == 0) { Return This.MakeInt(0); }
            Return This.MakeInt(arguments[0].Elements.Count());
        }
        If (owner == "Concurrency" && method == "Workers") { Return This.MakeInt(1); }
        Return missed;
    }

    Private Function Display(Value value) -> String {
        If (value.Kind == ValueKind.Integer) {
            If (value.Text.StartsWith("u:")) { Return value.Text.Substring(2); }
            Return value.Integer.ToString();
        }
        If (value.Kind == ValueKind.Float) { Return TextF64(value.Integer); }
        If (value.Kind == ValueKind.Boolean) {
            If (value.Boolean) { Return "True"; }
            Return "False";
        }
        If (value.Kind == ValueKind.Text) { Return value.Text; }
        If (value.Kind == ValueKind.Null) { Return "Null"; }
        If (value.Kind == ValueKind.Array && value.Text == "Map") {
            String text = "{";
            Int index = 0;
            While (index + 1 < value.Elements.Count()) {
                If (index > 0) { text = text + ", "; }
                text = text + This.Display(value.Elements[index]);
                text = text + ": ";
                text = text + This.Display(value.Elements[index + 1]);
                index = index + 2;
            }
            Return text + "}";
        }
        If (value.Kind == ValueKind.Array && value.Text == "Set") {
            String text = "{";
            Int index = 0;
            For element In value.Elements {
                If (index > 0) { text = text + ", "; }
                text = text + This.Display(element);
                index = index + 1;
            }
            Return text + "}";
        }
        If (value.Kind == ValueKind.Array && (value.Text == "Success" || value.Text == "Failure")) {
            String payload = "";
            If (value.Elements.Count() > 0) { payload = This.Display(value.Elements[0]); }
            Return value.Text + ":" + payload;
        }
        If (value.Kind == ValueKind.Array) {
            String text = "[";
            Int index = 0;
            For element In value.Elements {
                If (index > 0) { text = text + ", "; }
                text = text + This.Display(element);
                index = index + 1;
            }
            Return text + "]";
        }
        Return "";
    }
}

Private Extern Function ParseF64(String text) -> Int;
Private Extern Function F32Parse(String text) -> Int;
Private Extern Function TextF64(Int bits) -> String;
Private Extern Function FloatFromInt(Int value) -> Int;
Private Extern Function F64Add(Int left, Int right) -> Int;
Private Extern Function F64Sub(Int left, Int right) -> Int;
Private Extern Function F64Mul(Int left, Int right) -> Int;
Private Extern Function F64Div(Int left, Int right) -> Int;
Private Extern Function F64Neg(Int bits) -> Int;
Private Extern Function F64Cmp(Int left, Int right) -> Int;
Private Extern Function FloatToInt(Int bits) -> Int;
Private Extern Function F64ToIntMode(Int bits, Int mode) -> Int;
Private Extern Function F64ToIntChecked(Int bits) -> Int;
Private Extern Function F64Format(Int bits, String format) -> String;
Private Extern Function U64Parse(String text) -> Int;
Private Extern Function F16Parse(String text) -> Int;
Private Extern Function ReadLine() -> String;
Private Extern Function ClockMillis() -> Int;
Private Extern Function BitAnd(Int left, Int right) -> Int;
Private Extern Function BitOr(Int left, Int right) -> Int;
Private Extern Function BitXor(Int left, Int right) -> Int;
Private Extern Function Shl(Int left, Int right) -> Int;
Private Extern Function Shr(Int left, Int right) -> Int;
