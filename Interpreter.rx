// Tree-walk interpreter for Robix's executable syntax.
Package Robix.Runtime;

Import Robix.Core;
Import Robix.Syntax;


Public Enum ValueKind {
    None,
    Integer,
    Float,
    Boolean,
    Text,
    Null,
    Array,
    Function,
    Void,
    Object
}

Public Class Value {
    Public ValueKind Kind;
    Public Int Integer;
    Public Float FloatValue;
    Public Bool Boolean;
    Public String Text;
    Public List<Value> Elements;
    Public List<String> FieldNames;
    Public AstNode? FunctionNode;

    Public Constructor() {
        This.Kind = ValueKind.None;
        This.Integer = 0;
        This.FloatValue = 0.0;
        This.Boolean = False;
        This.Text = "";
        This.Elements = List<Value>();
        This.FieldNames = List<String>();
        This.FunctionNode = Null;
    }
}

Public Class Interpreter {
    Private List<String> names;
    Private List<Value> values;
    Private List<Int> marks;
    Private List<String> lines;
    Private List<String> runtimeErrors;
    Private String signal;
    Private Value returnValue;
    Private List<AstNode> functions;
    Private List<AstNode> types;
    Private List<String> operatorKeys;
    Private List<AstNode> operatorNodes;

    Public Constructor() {
        This.names = List<String>();
        This.values = List<Value>();
        This.marks = List<Int>();
        This.lines = List<String>();
        This.runtimeErrors = List<String>();
        This.signal = "";
        This.returnValue = This.MakeVoid();
        This.functions = List<AstNode>();
        This.types = List<AstNode>();
        This.operatorKeys = List<String>();
        This.operatorNodes = List<AstNode>();
    }

    Public Function Execute(AstNode module, List<String> arguments) -> Int
    Explain {
        Description: "Execute a parsed Robix module.";
        Input: module = "Module syntax tree", arguments = "Command-line arguments passed to Main";
        Processing: "Define functions, then call Main when it exists. Otherwise run top-level statements.";
        Output: "The process exit integer.";
    } {
        This.PushScope();
        This.CollectFunctions(module);
        For child In module.Children {
            If (child.Kind == AstKind.Variable) {
                This.ExecuteNode(child);
            }
        }
        AstNode? entry = This.FindFunction("Main");
        Int exitCode = 0;
        If (entry != Null) {
            Value argumentArray = This.MakeArray();
            For argument In arguments {
                argumentArray.Elements.Add(This.MakeText(argument));
            }
            Var args = List<Value>();
            args.Add(argumentArray);
            Value result = This.CallFunction(entry, args);
            If (result.Kind == ValueKind.Integer) {
                exitCode = result.Integer;
            }
        } Else {
            For child In module.Children {
                If (child.Kind != AstKind.Function && child.Kind != AstKind.Class) {
                    This.ExecuteNode(child);
                }
            }
        }
        This.PopScope();
        Return exitCode;
    }

    Public Function Lines() -> List<String>
    Explain {
        Description: "Return text written by Print during execution.";
        Input: None;
        Processing: "Read the captured output lines.";
        Output: "The output lines in order.";
    } {
        Return This.lines;
    }

    Public Function RequireTests(String sourcePath, AstNode module) -> List<String>
    Explain {
        Description: "Require a companion test file and run its function tests.";
        Input: sourcePath = "Source file path", module = "Parsed source module";
        Processing: "The interpreter ignores a missing companion. The compiler reports a missing file or a function without a test, then runs every test.";
        Output: "Error lines. An empty list means the tests passed or this run is not enforcing them.";
    } {
        Var errors = List<String>();
        If (sourcePath.EndsWith(".test.rx") || !sourcePath.EndsWith(".rx")) {
            Return errors;
        }
        String companion = sourcePath.Substring(0, sourcePath.Length() - 3) + ".test.rx";
        If (!Files.Exists(companion)) {
            errors.Add("error RX120 " + sourcePath + " requires " + companion + ".");
            Return errors;
        }
        DiagnosticBag diagnostics = DiagnosticBag();
        Lexer lexer = Lexer(Files.ReadText(companion), diagnostics);
        Parser parser = Parser(lexer.Tokenize(), diagnostics);
        AstNode tests = parser.Parse();
        If (diagnostics.ErrorCount() > 0) {
            For item In diagnostics.All() {
                errors.Add(FormatDiagnostic(item));
            }
            Return errors;
        }
        Var functions = List<String>();
        This.CollectTestNames(module, AstKind.Function, functions);
        Var covered = List<String>();
        This.CollectTestNames(tests, AstKind.Test, covered);
        For name In functions {
            If (!This.HasTestName(covered, name)) {
                errors.Add("error RX120 " + companion + " has no test for '" + name + "'.");
            }
        }
        If (errors.Count() > 0) {
            Return errors;
        }
        This.PushScope();
        This.CollectFunctions(module);
        This.RunParsedTests(tests, errors);
        This.PopScope();
        Return errors;
    }

    Public Function RuntimeErrors() -> List<String>
    Explain {
        Description: "Return runtime type and evaluation errors.";
        Input: None;
        Processing: "Read errors reported while the module ran.";
        Output: "The runtime error lines.";
    } {
        Return This.runtimeErrors;
    }

    Private Function CollectTestNames(AstNode node, AstKind kind, List<String> names) -> Void {
        If (node.Kind == kind && node.Name != "" && !This.HasTestName(names, node.Name)) {
            names.Add(node.Name);
        }
        For child In node.Children {
            This.CollectTestNames(child, kind, names);
        }
        If (node.Body != Null) {
            This.CollectTestNames(node.Body, kind, names);
        }
    }

    Private Function HasTestName(List<String> names, String name) -> Bool {
        For existing In names {
            If (existing == name) { Return True; }
        }
        Return False;
    }

    Private Function RunParsedTests(AstNode node, List<String> errors) -> Void {
        If (node.Kind == AstKind.Test) {
            Bool hasCase = False;
            For child In node.Children {
                If (child.Kind == AstKind.Test && child.FlagB) { hasCase = True; }
            }
            If (node.FlagB || !hasCase) {
                String failure = This.RunOneTest(node);
                If (failure != "") { errors.Add(failure); }
            }
        }
        For child In node.Children {
            This.RunParsedTests(child, errors);
        }
        If (node.Body != Null) {
            This.RunParsedTests(node.Body, errors);
        }
    }

    Private Function RunOneTest(AstNode test) -> String {
        This.runtimeErrors = List<String>();
        This.PushScope();
        For binding In test.Parameters {
            Value value = This.MakeInt(0);
            If (binding.Initializer != Null) { value = This.Evaluate(binding.Initializer); }
            This.Define(binding.Name, value);
        }
        If (This.runtimeErrors.Count() > 0) {
            String message = This.runtimeErrors[0];
            This.PopScope();
            Return "error RX121 Test " + test.Name + " failed. " + message;
        }
        If (test.Left != Null && !This.IsTruthy(This.Evaluate(test.Left))) {
            This.PopScope();
            Return "error RX121 Test " + test.Name + " failed. Constraint was false.";
        }
        Value processing = This.MakeVoid();
        Bool hasProcessing = test.Right != Null;
        If (hasProcessing) { processing = This.Evaluate(test.Right); }
        Value expected = This.MakeVoid();
        Bool hasOutput = test.Extra != Null;
        If (hasOutput) { expected = This.Evaluate(test.Extra); }
        If (This.runtimeErrors.Count() > 0) {
            String message = This.runtimeErrors[0];
            This.PopScope();
            Return "error RX121 Test " + test.Name + " failed. " + message;
        }
        Bool hasCheck = False;
        For child In test.Children {
            If (child.Kind != AstKind.Test) { hasCheck = True; }
        }
        If (!test.FlagA && !hasOutput && !hasCheck) {
            This.PopScope();
            Return "error RX121 Test " + This.TestTitle(test) + " must declare Output.";
        }
        Bool expectFailure = This.ExpectsFailure(test);
        Value actual = This.MakeVoid();
        Bool called = False;
        If (test.FlagA) {
            AstNode? function = This.FindFunction(test.Name);
            If (function == Null) {
                This.PopScope();
                Return "error RX121 Test " + This.TestTitle(test) + " failed. The function is not defined.";
            }
            Var arguments = List<Value>();
            For parameter In function.Parameters {
                If (!parameter.FlagC) {
                    Value argument = This.MakeInt(0);
                    For binding In test.Parameters {
                        If (binding.Name == parameter.Name) { argument = This.Lookup(parameter.Name); }
                    }
                    arguments.Add(argument);
                }
            }
            actual = This.CallFunction(function, arguments);
            called = True;
            If (This.runtimeErrors.Count() > 0 && !expectFailure) {
                String message = This.runtimeErrors[0];
                This.PopScope();
                Return "error RX121 Test " + This.TestTitle(test) + " failed. " + message;
            }
            If (This.runtimeErrors.Count() == 0 && expectFailure) {
                This.PopScope();
                Return "error RX121 Test " + This.TestTitle(test) + " failed. The call was expected to fail.";
            }
            This.runtimeErrors = List<String>();
            If (!expectFailure) {
                This.Define("Result", actual);
                If (hasOutput && !This.Same(actual, expected)) {
                    This.PopScope();
                    Return "error RX121 Test " + This.TestTitle(test) + " failed. Output expected " + This.Display(expected) + " but the function returned " + This.Display(actual) + ".";
                }
                If (hasProcessing && !This.Same(actual, processing)) {
                    This.PopScope();
                    Return "error RX121 Test " + This.TestTitle(test) + " failed. Processing expected " + This.Display(processing) + " but the function returned " + This.Display(actual) + ".";
                }
            }
        } Else If (hasProcessing && hasOutput && !This.Same(processing, expected)) {
            This.PopScope();
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Processing and Output do not match.";
        }
        String checkFailure = This.RunChecks(test, actual, called);
        This.PopScope();
        Return checkFailure;
    }

    Private Function TestTitle(AstNode test) -> String {
        If (test.Text == "") { Return test.Name; }
        Return test.Name + " " + test.Text;
    }

    Private Function ExpectsFailure(AstNode test) -> Bool {
        For child In test.Children {
            If (child.Name == "Fails" && child.Left != Null && This.IsTruthy(This.Evaluate(child.Left))) {
                Return True;
            }
        }
        Return False;
    }

    Private Function RunChecks(AstNode test, Value actual, Bool called) -> String {
        For child In test.Children {
            If (child.Kind == AstKind.Test || child.Name == "Fails") { Continue; }
            String failure = This.RunCheck(test, child, actual, called);
            If (failure != "") { Return failure; }
        }
        Return "";
    }

    Private Function RunCheck(AstNode test, AstNode check, Value actual, Bool called) -> String {
        Value left = This.MakeVoid();
        Value right = This.MakeVoid();
        If (check.Left != Null) { left = This.Evaluate(check.Left); }
        If (check.Right != Null) { right = This.Evaluate(check.Right); }
        If (This.runtimeErrors.Count() > 0) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. " + This.runtimeErrors[0];
        }
        String label = check.Name;
        If ((label == "Assert" || label == "True") && !This.IsTruthy(left)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. " + label + " was false.";
        }
        If (label == "False" && This.IsTruthy(left)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. False was true.";
        }
        If (label == "Equal" && !This.Same(left, right)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Equal expected " + This.Display(right) + " but got " + This.Display(left) + ".";
        }
        If (label == "NotEqual" && This.Same(left, right)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. NotEqual got " + This.Display(left) + ".";
        }
        If (label == "Greater" && This.CompareValues(left, right) <= 0) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Greater expected " + This.Display(left) + " > " + This.Display(right) + ".";
        }
        If (label == "Less" && This.CompareValues(left, right) >= 0) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Less expected " + This.Display(left) + " < " + This.Display(right) + ".";
        }
        If (label == "GreaterEqual" && This.CompareValues(left, right) < 0) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. GreaterEqual expected " + This.Display(left) + " >= " + This.Display(right) + ".";
        }
        If (label == "LessEqual" && This.CompareValues(left, right) > 0) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. LessEqual expected " + This.Display(left) + " <= " + This.Display(right) + ".";
        }
        If (label == "Contains" && !left.Text.Contains(right.Text)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Contains expected " + This.Display(right) + " in " + This.Display(left) + ".";
        }
        If (label == "Expect") {
            If (!called) {
                Return "error RX121 Test " + This.TestTitle(test) + " failed. Expect needs Input so the function is called.";
            }
            If (!This.Same(actual, left)) {
                Return "error RX121 Test " + This.TestTitle(test) + " failed. Expect expected " + This.Display(left) + " but the function returned " + This.Display(actual) + ".";
            }
        }
        If (label == "Empty" && !This.IsEmptyValue(left)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Empty was not empty.";
        }
        If (label == "NotEmpty" && This.IsEmptyValue(left)) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. NotEmpty was empty.";
        }
        If (label == "Null" && left.Kind != ValueKind.Null) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. Null got " + This.Display(left) + ".";
        }
        If (label == "NotNull" && left.Kind == ValueKind.Null) {
            Return "error RX121 Test " + This.TestTitle(test) + " failed. NotNull got Null.";
        }
        Return "";
    }

    Private Function IsEmptyValue(Value value) -> Bool {
        If (value.Kind == ValueKind.Null || value.Kind == ValueKind.None) { Return True; }
        If (value.Kind == ValueKind.Text) { Return value.Text.Length() == 0; }
        If (value.Kind == ValueKind.Array) { Return value.Elements.Count() == 0; }
        Return False;
    }

    Private Function CompareValues(Value left, Value right) -> Int {
        If (left.Kind == ValueKind.Float || right.Kind == ValueKind.Float) {
            Return F64Cmp(This.FloatBits(left), This.FloatBits(right));
        }
        If (left.Kind == ValueKind.Text && right.Kind == ValueKind.Text) {
            Int length = left.Text.Length();
            If (right.Text.Length() < length) { length = right.Text.Length(); }
            Int index = 0;
            While (index < length) {
                Int leftCode = left.Text.GetChar(index).ToInt();
                Int rightCode = right.Text.GetChar(index).ToInt();
                If (leftCode < rightCode) { Return -1; }
                If (leftCode > rightCode) { Return 1; }
                index = index + 1;
            }
            If (left.Text.Length() < right.Text.Length()) { Return -1; }
            If (left.Text.Length() > right.Text.Length()) { Return 1; }
            Return 0;
        }
        If (left.Integer < right.Integer) { Return -1; }
        If (left.Integer > right.Integer) { Return 1; }
        Return 0;
    }

    Private Function CollectFunctions(AstNode node) -> Void {
        For child In node.Children {
            If (child.Kind == AstKind.Function) {
                This.functions.Add(child);
                This.Define(child.Name, This.MakeFunction(child));
            }
            If (child.Kind == AstKind.Operator) {
                If (child.Body != Null && child.Body.Kind == AstKind.Function) {
                    This.functions.Add(child.Body);
                    This.Define(child.Body.Name, This.MakeFunction(child.Body));
                    This.operatorKeys.Add(child.Operator);
                    This.operatorNodes.Add(child.Body);
                }
            }
            If (child.Kind == AstKind.Class) {
                This.types.Add(child);
                For member In child.Children {
                    If (member.Kind == AstKind.Operator) {
                        This.operatorKeys.Add(child.Name + member.Operator);
                        This.operatorNodes.Add(member);
                    }
                }
                This.CollectFunctions(child);
            }
            If (child.Kind == AstKind.Block) {
                This.CollectFunctions(child);
            }
        }
    }

    Private Function ExecuteNode(AstNode node) -> Value {
        If (This.signal.Length() > 0 && node.Kind != AstKind.Function) {
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Block || node.Kind == AstKind.Unsafe || node.Kind == AstKind.Defer || node.Kind == AstKind.Lock) {
            Return This.ExecuteBlock(node);
        }
        If (node.Kind == AstKind.Variable) {
            Return This.ExecuteVariable(node);
        }
        If (node.Kind == AstKind.ExpressionStatement) {
            If (node.Left != Null) {
                Return This.Evaluate(node.Left);
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.If) {
            If (This.IsTruthy(This.Evaluate(node.Condition))) {
                If (node.Body != Null) { Return This.ExecuteNode(node.Body); }
            } Else If (node.Otherwise != Null) {
                Return This.ExecuteNode(node.Otherwise);
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.While) {
            While (This.signal.Length() == 0 && This.IsTruthy(This.Evaluate(node.Condition))) {
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.DoWhile) {
            If (node.Body != Null) { This.ExecuteNode(node.Body); }
            While (This.signal.Length() == 0 && This.IsTruthy(This.Evaluate(node.Condition))) {
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Repeat) {
            Int count = This.Evaluate(node.Condition).Integer;
            Int index = 0;
            While (index < count && This.signal.Length() == 0) {
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
                index = index + 1;
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Loop) {
            While (This.signal.Length() == 0) {
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
            }
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.For) {
            Return This.ExecuteFor(node);
        }
        If (node.Kind == AstKind.Return) {
            If (node.Left != Null) {
                This.returnValue = This.Evaluate(node.Left);
            } Else {
                This.returnValue = This.MakeVoid();
            }
            This.signal = "return";
            Return This.returnValue;
        }
        If (node.Kind == AstKind.Break) {
            This.signal = "break";
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Continue) {
            This.signal = "continue";
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.Match) {
            Return This.ExecuteMatch(node);
        }
        If (node.Kind == AstKind.Try) {
            If (node.Body != Null) { This.ExecuteNode(node.Body); }
            If (node.Extra != Null) { This.ExecuteNode(node.Extra); }
            Return This.MakeVoid();
        }
        For child In node.Children {
            This.ExecuteNode(child);
            If (This.signal.Length() > 0) {
                Break;
            }
        }
        Return This.MakeVoid();
    }

    Private Function ExecuteBlock(AstNode node) -> Value {
        This.PushScope();
        This.CollectFunctions(node);
        Value last = This.MakeVoid();
        For child In node.Children {
            last = This.ExecuteNode(child);
            If (This.signal.Length() > 0) {
                Break;
            }
        }
        This.PopScope();
        Return last;
    }

    Private Function ExecuteVariable(AstNode node) -> Value {
        If (node.FlagC) {
            Value value = This.MakeNull();
            If (node.Initializer != Null) {
                value = This.Evaluate(node.Initializer);
            }
            Int index = 0;
            For child In node.Children {
                Value part = This.MakeNull();
                If (index < value.Elements.Count()) {
                    part = value.Elements[index];
                }
                This.Define(child.Name, part);
                index = index + 1;
            }
            Return value;
        }
        Value initial = This.MakeNull();
        If (node.Initializer != Null) {
            initial = This.Evaluate(node.Initializer);
        }
        This.Define(node.Name, initial);
        For child In node.Children {
            This.ExecuteVariable(child);
        }
        Return initial;
    }

    Private Function ExecuteFor(AstNode node) -> Value {
        This.PushScope();
        If (node.FlagB) {
            If (node.Initializer != Null) { This.ExecuteNode(node.Initializer); }
            While (This.signal.Length() == 0) {
                If (node.Condition != Null && !This.IsTruthy(This.Evaluate(node.Condition))) {
                    Break;
                }
                If (node.Condition == Null && node.Initializer == Null) {
                    Break;
                }
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
                If (node.Extra != Null) { This.Evaluate(node.Extra); }
                If (node.Condition == Null) {
                    Break;
                }
            }
        } Else If (node.Right != Null && node.Right.Kind == AstKind.Range) {
            Int start = This.Evaluate(node.Right.Left).Integer;
            Int end = This.Evaluate(node.Right.Right).Integer;
            Int cursor = start;
            Int last = end;
            If (!node.Right.FlagA) {
                last = end - 1;
            }
            While (cursor <= last && This.signal.Length() == 0) {
                If (node.Left != Null) {
                    This.Define(node.Left.Name, This.MakeInt(cursor));
                }
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
                cursor = cursor + 1;
            }
        } Else {
            Value collection = This.Evaluate(node.Right);
            For element In collection.Elements {
                If (node.Left != Null) {
                    This.Define(node.Left.Name, element);
                }
                If (node.Body != Null) { This.ExecuteNode(node.Body); }
                If (This.signal == "break") { This.signal = ""; Break; }
                If (This.signal == "continue") { This.signal = ""; }
            }
        }
        This.PopScope();
        Return This.MakeVoid();
    }

    Private Function ExecuteMatch(AstNode node) -> Value {
        Value scrutinee = This.MakeNull();
        If (node.Left != Null) {
            scrutinee = This.Evaluate(node.Left);
        }
        For arm In node.Children {
            If (arm.Left != Null && (arm.Left.FlagA || This.PatternMatches(arm.Left, scrutinee))) {
                This.PushScope();
                This.BindPattern(arm.Left, scrutinee);
                Value result = This.MakeVoid();
                If (arm.Right != Null) {
                    If (arm.Right.Kind == AstKind.Block) {
                        result = This.ExecuteNode(arm.Right);
                    } Else {
                        result = This.Evaluate(arm.Right);
                    }
                }
                This.PopScope();
                Return result;
            }
        }
        Return This.MakeVoid();
    }

    Private Function Evaluate(AstNode? node) -> Value {
        If (node == Null) {
            Return This.MakeVoid();
        }
        If (node.Kind == AstKind.IntegerLiteral) {
            Return This.MakeInt(ParseInteger(node.Text));
        }
        If (node.Kind == AstKind.FloatLiteral) {
            Return This.ParseFloat(node.Text);
        }
        If (node.Kind == AstKind.StringLiteral) {
            If (node.FlagA && node.Children.Count() > 0) {
                String text = "";
                For child In node.Children {
                    If (child.Kind == AstKind.Interpolation) {
                        text = text + This.Display(This.Evaluate(child.Left));
                    } Else {
                        text = text + child.Text;
                    }
                }
                Return This.MakeText(text);
            }
            Return This.MakeText(node.Text);
        }
        If (node.Kind == AstKind.CharLiteral) { Return This.MakeText(node.Text); }
        If (node.Kind == AstKind.BooleanLiteral) { Return This.MakeBool(node.FlagA); }
        If (node.Kind == AstKind.NullLiteral) { Return This.MakeNull(); }
        If (node.Kind == AstKind.Name) { Return This.Lookup(node.Name); }
        If (node.Kind == AstKind.ObjectLiteral) { Return This.MakeObject(node); }
        If (node.Kind == AstKind.RecordLiteral) { Return This.MakeRecord(node); }
        If (node.Kind == AstKind.MapLiteral) { Return This.MakeMap(node); }
        If (node.Kind == AstKind.SetLiteral) { Return This.MakeSet(node); }
        If (node.Kind == AstKind.ArrayLiteral || node.Kind == AstKind.TupleLiteral) {
            Value array = This.MakeArray();
            For child In node.Children {
                array.Elements.Add(This.Evaluate(child));
            }
            Return array;
        }
        If (node.Kind == AstKind.Unary) {
            Value operand = This.Evaluate(node.Left);
            If (node.Operator == "-" && operand.Kind == ValueKind.Float) {
                Return This.MakeFloatBits(F64Neg(operand.Integer));
            }
            If (node.Operator == "-" && operand.Kind == ValueKind.Integer) {
                Return This.MakeInt(-operand.Integer);
            }
            If (node.Operator == "!" || node.Operator == "Not") {
                Return This.MakeBool(!This.IsTruthy(operand));
            }
            If ((node.Operator == "++" || node.Operator == "--") && node.Left != Null && node.Left.Kind == AstKind.Name) {
                Int current = operand.Integer;
                Int next = current + 1;
                If (node.Operator == "--") { next = current - 1; }
                This.Assign(node.Left.Name, This.MakeInt(next));
                If (node.FlagA) { Return This.MakeInt(current); }
                Return This.MakeInt(next);
            }
            Return operand;
        }
        If (node.Kind == AstKind.Binary && node.Operator == "??") {
            Value left = This.Evaluate(node.Left);
            If (left.Kind == ValueKind.Null || left.Kind == ValueKind.None) { Return This.Evaluate(node.Right); }
            Return left;
        }
        If (node.Kind == AstKind.Binary || node.Kind == AstKind.Range) {
            Return This.EvaluateBinary(node);
        }
        If (node.Kind == AstKind.Assignment) {
            If (node.Left != Null && node.Left.Kind == AstKind.TupleLiteral) {
                Value value = This.Evaluate(node.Right);
                Int index = 0;
                For target In node.Left.Children {
                    Value part = This.MakeNull();
                    If (index < value.Elements.Count()) { part = value.Elements[index]; }
                    If (target.Kind == AstKind.Name) { This.Assign(target.Name, part); }
                    index = index + 1;
                }
                Return value;
            }
            Value value = This.Evaluate(node.Right);
            If (node.Left != Null && node.Left.Kind == AstKind.Member) {
                Value target = This.Evaluate(node.Left.Left);
                Int index = This.FieldIndex(target, node.Left.Name);
                If (index >= 0) { target.Elements[index] = value; }
                Return value;
            }
            If (node.Left != Null && node.Left.Kind == AstKind.Index) {
                Value target = This.Evaluate(node.Left.Left);
                If (target.Text == "Map") {
                    Value key = This.Evaluate(node.Left.Right);
                    Int pair = 0;
                    Bool found = False;
                    While (pair + 1 < target.Elements.Count()) {
                        If (This.Same(target.Elements[pair], key)) {
                            target.Elements[pair + 1] = value;
                            found = True;
                        }
                        pair = pair + 2;
                    }
                    If (!found) {
                        target.Elements.Add(key);
                        target.Elements.Add(value);
                    }
                    Return value;
                }
                Int slot = This.Evaluate(node.Left.Right).Integer;
                If (slot >= 0 && slot < target.Elements.Count()) { target.Elements[slot] = value; }
                Return value;
            }
            If (node.Left != Null && node.Left.Kind == AstKind.Name) {
                Value current = This.Lookup(node.Left.Name);
                If (node.Operator == "+=") { value = This.MakeInt(current.Integer + value.Integer); }
                If (node.Operator == "-=") { value = This.MakeInt(current.Integer - value.Integer); }
                If (node.Operator == "*=") { value = This.MakeInt(current.Integer * value.Integer); }
                If (node.Operator == "/=") {
                    If (value.Integer == 0) { value = This.MakeInt(0); }
                    If (value.Integer != 0) { value = This.MakeInt(current.Integer / value.Integer); }
                }
                If (node.Operator == "%=") {
                    If (value.Integer == 0) { value = This.MakeInt(0); }
                    If (value.Integer != 0) { value = This.MakeInt(current.Integer % value.Integer); }
                }
                This.Assign(node.Left.Name, value);
            }
            Return value;
        }
        If (node.Kind == AstKind.Ternary) {
            If (This.IsTruthy(This.Evaluate(node.Condition))) {
                Return This.Evaluate(node.Left);
            }
            Return This.Evaluate(node.Right);
        }
        If (node.Kind == AstKind.TypeCheck) {
            Value value = This.Evaluate(node.Left);
            String expected = "";
            If (node.Type != Null) { expected = node.Type.Name; }
            Return This.MakeBool(This.TypeMatches(value, expected));
        }
        If (node.Kind == AstKind.Call) {
            Return This.EvaluateCall(node);
        }
        If (node.Kind == AstKind.Member) {
            If (node.Left != Null && node.Left.Kind == AstKind.Name) {
                Int typeIndex = This.TypeIndex(node.Left.Name);
                If (typeIndex >= 0 && This.types[typeIndex].Text == "Enum") {
                    Return This.MakeInt(This.EnumOrdinal(This.types[typeIndex], node.Name));
                }
            }
            Value target = This.Evaluate(node.Left);
            If (target.Kind == ValueKind.Object) {
                Int index = This.FieldIndex(target, node.Name);
                If (index >= 0 && index < target.Elements.Count()) { Return target.Elements[index]; }
                Return This.MakeInt(0);
            }
            If (node.Name == "Length" || node.Name == "Count") {
                If (target.Kind == ValueKind.Text) { Return This.MakeInt(target.Text.Length()); }
                Return This.MakeInt(target.Elements.Count());
            }
            If (node.Name == "ToString") { Return This.MakeText(This.Display(target)); }
            Return This.MakeText(This.Display(target));
        }
        If (node.Kind == AstKind.Index) {
            Value target = This.Evaluate(node.Left);
            If (target.Text == "Map") {
                Value key = This.Evaluate(node.Right);
                Int pair = 0;
                While (pair + 1 < target.Elements.Count()) {
                    If (This.Same(target.Elements[pair], key)) { Return target.Elements[pair + 1]; }
                    pair = pair + 2;
                }
                Return This.MakeInt(0);
            }
            Int index = This.Evaluate(node.Right).Integer;
            If (index >= 0 && index < target.Elements.Count()) {
                Return target.Elements[index];
            }
            If (target.Kind == ValueKind.Text && index >= 0 && index < target.Text.Length()) {
                Return This.MakeText(target.Text.Substring(index, 1));
            }
            This.runtimeErrors.Add("Index is outside the collection.");
            Return This.MakeNull();
        }
        If (node.Kind == AstKind.Await || node.Kind == AstKind.Unwrap || node.Kind == AstKind.Propagate) {
            Return This.Evaluate(node.Left);
        }
        If (node.Kind == AstKind.Block || node.Kind == AstKind.If || node.Kind == AstKind.Match) {
            Return This.ExecuteNode(node);
        }
        Return This.MakeVoid();
    }

    Private Function EvaluateBinary(AstNode node) -> Value {
        Value left = This.Evaluate(node.Left);
        Value right = This.Evaluate(node.Right);
        Int overload = -1;
        If (left.Kind == ValueKind.Object && right.Kind == ValueKind.Object) {
            overload = This.FindOperator(left.Text + node.Operator);
        }
        If (overload < 0) { overload = This.FindOperator(node.Operator); }
        If (overload >= 0) {
            Var args = List<Value>();
            args.Add(left);
            args.Add(right);
            Return This.CallFunction(This.operatorNodes[overload], args);
        }
        If (node.Kind == AstKind.Range) {
            Value range = This.MakeArray();
            Int cursor = left.Integer;
            Int end = right.Integer;
            If (!node.FlagA) { end = end - 1; }
            While (cursor <= end) {
                range.Elements.Add(This.MakeInt(cursor));
                cursor = cursor + 1;
            }
            Return range;
        }
        If (left.Kind == ValueKind.Float || right.Kind == ValueKind.Float) {
            Return This.EvaluateFloat(node.Operator, left, right);
        }
        If (node.Operator == "+") {
            If (left.Kind == ValueKind.Text || right.Kind == ValueKind.Text) {
                Return This.MakeText(This.Display(left) + This.Display(right));
            }
            Return This.MakeInt(left.Integer + right.Integer);
        }
        If (node.Operator == "-") { Return This.MakeInt(left.Integer - right.Integer); }
        If (node.Operator == "*") { Return This.MakeInt(left.Integer * right.Integer); }
        If (node.Operator == "/") {
            If (right.Integer == 0) {
                This.runtimeErrors.Add("Division by zero.");
                Return This.MakeInt(0);
            }
            Return This.MakeInt(left.Integer / right.Integer);
        }
        If (node.Operator == "%") {
            If (right.Integer == 0) {
                This.runtimeErrors.Add("Division by zero.");
                Return This.MakeInt(0);
            }
            Return This.MakeInt(left.Integer % right.Integer);
        }
        If (node.Operator == "<<") { Return This.MakeInt(Shl(left.Integer, right.Integer)); }
        If (node.Operator == ">>") { Return This.MakeInt(Shr(left.Integer, right.Integer)); }
        If (node.Operator == "&") { Return This.MakeInt(BitAnd(left.Integer, right.Integer)); }
        If (node.Operator == "|") { Return This.MakeInt(BitOr(left.Integer, right.Integer)); }
        If (node.Operator == "^") { Return This.MakeInt(BitXor(left.Integer, right.Integer)); }
        If (node.Operator == "==" || node.Operator == "Equal") { Return This.MakeBool(This.Same(left, right)); }
        If (node.Operator == "!=") { Return This.MakeBool(!This.Same(left, right)); }
        If (left.Kind == ValueKind.Text && right.Kind == ValueKind.Text && left.Text.Length() == 1 && right.Text.Length() == 1) {
            Int leftCode = left.Text.GetChar(0).ToInt();
            Int rightCode = right.Text.GetChar(0).ToInt();
            If (node.Operator == "<") { Return This.MakeBool(leftCode < rightCode); }
            If (node.Operator == ">") { Return This.MakeBool(leftCode > rightCode); }
            If (node.Operator == "<=") { Return This.MakeBool(leftCode <= rightCode); }
            If (node.Operator == ">=") { Return This.MakeBool(leftCode >= rightCode); }
        }
        If (node.Operator == "<") { Return This.MakeBool(left.Integer < right.Integer); }
        If (node.Operator == ">") { Return This.MakeBool(left.Integer > right.Integer); }
        If (node.Operator == "<=") { Return This.MakeBool(left.Integer <= right.Integer); }
        If (node.Operator == ">=") { Return This.MakeBool(left.Integer >= right.Integer); }
        If (node.Operator == "&&" || node.Operator == "And") { Return This.MakeBool(This.IsTruthy(left) && This.IsTruthy(right)); }
        If (node.Operator == "||" || node.Operator == "Or") { Return This.MakeBool(This.IsTruthy(left) || This.IsTruthy(right)); }
        Return left;
    }

    Private Function EvaluateCall(AstNode node) -> Value {
        Var arguments = List<Value>();
        For argument In node.Parameters {
            If (argument.Left != Null) {
                arguments.Add(This.Evaluate(argument.Left));
            }
        }
        String name = "";
        If (node.Left != Null && node.Left.Kind == AstKind.Name) {
            name = node.Left.Name;
        }
        If (name == "Print") {
            String line = "";
            For argument In arguments {
                If (line.Length() > 0) { line = line + " "; }
                line = line + This.Display(argument);
            }
            This.lines.Add(line);
            Return This.MakeVoid();
        }
        If (name == "Assert" || name == "AssertTrue") {
            If (arguments.Count() == 0 || !This.IsTruthy(arguments[0])) {
                This.runtimeErrors.Add("Assertion failed.");
            }
            Return This.MakeVoid();
        }
        If (name == "AssertFalse") {
            If (arguments.Count() > 0 && This.IsTruthy(arguments[0])) {
                This.runtimeErrors.Add("Assertion failed.");
            }
            Return This.MakeVoid();
        }
        If (name == "AssertEqual") {
            If (arguments.Count() >= 2 && !This.Same(arguments[0], arguments[1])) {
                This.runtimeErrors.Add("Assertion failed.");
            }
            Return This.MakeVoid();
        }
        If (name == "Input") { Return This.MakeText(ReadLine()); }
        If (name == "Queue" || name == "Stack") {
            Value collection = This.MakeArray();
            collection.Text = name;
            Return collection;
        }
        If (name == "Some" || name == "Success" || name == "Tuple") {
            Value wrapper = This.MakeArray();
            wrapper.Text = name;
            For argument In arguments {
                wrapper.Elements.Add(argument);
            }
            Return wrapper;
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name && node.Left.Left.Name == "Operators") {
            Return This.OperatorLibrary(node.Left.Name, arguments);
        }
        AstNode? function = This.FindFunction(name);
        If (function == Null && node.Left != Null && node.Left.Kind == AstKind.Name) {
            Value value = This.Lookup(name);
            If (value.Kind == ValueKind.Function) {
                function = value.FunctionNode;
            }
        }
        If (function != Null) {
            Return This.CallFunction(function, arguments);
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member && node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name) {
            Int typeIndex = This.TypeIndex(node.Left.Left.Name);
            If (typeIndex >= 0 && This.types[typeIndex].Text == "Enum") {
                Return This.MakeEnumValue(This.types[typeIndex], node.Left.Name, arguments);
            }
        }
        If (node.Left != Null && node.Left.Kind == AstKind.Member) {
            If (node.Left.Left != Null && node.Left.Left.Kind == AstKind.Name && node.Left.Left.Name == "String") {
                Return This.StringStatic(node.Left.Name, arguments);
            }
            Value target = This.Evaluate(node.Left.Left);
            If (target.Kind == ValueKind.Text) {
                Value textCall = This.TextCall(node.Left.Name, target, arguments);
                If (textCall.Kind != ValueKind.None) { Return textCall; }
            }
            If (node.Left.Name == "Enqueue" || node.Left.Name == "Push") {
                If (arguments.Count() > 0) { target.Elements.Add(arguments[0]); }
                Return This.MakeVoid();
            }
            If (node.Left.Name == "Dequeue") { Return This.TakeFront(target); }
            If (node.Left.Name == "Pop") { Return This.TakeBack(target); }
            If (node.Left.Name == "Peek") {
                If (target.Elements.Count() == 0) { Return This.MakeInt(0); }
                If (target.Text == "Stack") { Return target.Elements[target.Elements.Count() - 1]; }
                Return target.Elements[0];
            }
            If (node.Left.Name == "Value" && target.Elements.Count() > 0) { Return target.Elements[0]; }
            If (node.Left.Name == "Contains" && arguments.Count() > 0) {
                For element In target.Elements {
                    If (This.Same(element, arguments[0])) { Return This.MakeBool(True); }
                }
                Return This.MakeBool(False);
            }
            If (node.Left.Name == "Count" || node.Left.Name == "Length") {
                If (target.Kind == ValueKind.Text) { Return This.MakeInt(target.Text.Length()); }
                Return This.MakeInt(target.Elements.Count());
            }
            If (node.Left.Name == "Add" && arguments.Count() > 0) {
                target.Elements.Add(arguments[0]);
                Return This.MakeVoid();
            }
            If (node.Left.Name == "ToString") { Return This.MakeText(This.Display(target)); }
            If (node.Left.Name == "ToUpper") { Return This.MakeText(This.Display(target).ToUpper()); }
            If (node.Left.Name == "ToLower") { Return This.MakeText(This.Display(target).ToLower()); }
            If (node.Left.Name == "ToFloat") {
                If (target.Kind == ValueKind.Text) { Return This.MakeFloatBits(ParseF64(target.Text)); }
                If (target.Kind == ValueKind.Float) { Return target; }
                If (target.Kind == ValueKind.Boolean) {
                    Int bit = 0;
                    If (target.Boolean) { bit = 1; }
                    Return This.MakeFloatBits(FloatFromInt(bit));
                }
                Return This.MakeFloatBits(FloatFromInt(target.Integer));
            }
            If (node.Left.Name == "ToInt") {
                If (target.Kind == ValueKind.Text) { Return This.MakeInt(target.Text.ToInt()); }
                If (target.Kind == ValueKind.Float) { Return This.MakeInt(FloatToInt(target.Integer)); }
                If (target.Kind == ValueKind.Boolean) {
                    If (target.Boolean) { Return This.MakeInt(1); }
                    Return This.MakeInt(0);
                }
                Return This.MakeInt(target.Integer);
            }
        }
        Return This.MakeVoid();
    }

    Private Function StringStatic(String name, List<Value> arguments) -> Value {
        If (name == "From" && arguments.Count() > 0) {
            If (arguments[0].Kind == ValueKind.Text) { Return arguments[0]; }
            If (arguments[0].Kind == ValueKind.Integer) { Return This.MakeText(String.From(Char.From(arguments[0].Integer))); }
            Return This.MakeText(This.Display(arguments[0]));
        }
        Return This.MakeText("");
    }

    Private Function TextCall(String name, Value target, List<Value> arguments) -> Value {
        String text = target.Text;
        If (name == "GetChar") {
            Int index = 0;
            If (arguments.Count() > 0) { index = arguments[0].Integer; }
            If (index < 0 || index >= text.Length()) { Return This.MakeText(""); }
            Return This.MakeText(text.Substring(index, 1));
        }
        If (name == "Substring") {
            Int start = 0;
            If (arguments.Count() > 0) { start = arguments[0].Integer; }
            Int length = text.Length() - start;
            If (arguments.Count() > 1) { length = arguments[1].Integer; }
            If (start < 0) { start = 0; }
            If (length < 0) { length = 0; }
            If (start > text.Length()) { start = text.Length(); }
            If (start + length > text.Length()) { length = text.Length() - start; }
            Return This.MakeText(text.Substring(start, length));
        }
        If (name == "StartsWith" && arguments.Count() > 0) { Return This.MakeBool(text.StartsWith(arguments[0].Text)); }
        If (name == "EndsWith" && arguments.Count() > 0) { Return This.MakeBool(text.EndsWith(arguments[0].Text)); }
        If (name == "Contains" && arguments.Count() > 0) { Return This.MakeBool(text.Contains(arguments[0].Text)); }
        If (name == "IndexOf" && arguments.Count() > 0) { Return This.MakeInt(text.IndexOf(arguments[0].Text)); }
        If (name == "Replace" && arguments.Count() > 1) { Return This.MakeText(text.Replace(arguments[0].Text, arguments[1].Text)); }
        If (name == "ToLower") { Return This.MakeText(text.ToLower()); }
        If (name == "ToUpper") { Return This.MakeText(text.ToUpper()); }
        Return Value();
    }

    Private Function FindOperator(String key) -> Int {
        Int index = 0;
        While (index < This.operatorKeys.Count()) {
            If (This.operatorKeys[index] == key) { Return index; }
            index = index + 1;
        }
        Return -1;
    }

    Private Function OperatorLibrary(String name, List<Value> arguments) -> Value {
        If (name == "Call") {
            If (arguments.Count() == 0) { Return This.MakeInt(0); }
            Int index = This.FindOperator(arguments[0].Text);
            If (index < 0) { Return This.MakeInt(0); }
            Var rest = List<Value>();
            Int argumentIndex = 1;
            While (argumentIndex < arguments.Count()) {
                rest.Add(arguments[argumentIndex]);
                argumentIndex = argumentIndex + 1;
            }
            Return This.CallFunction(This.operatorNodes[index], rest);
        }
        If (arguments.Count() == 0) { Return This.MakeInt(0); }
        If (name == "Negate") {
            If (arguments[0].Kind == ValueKind.Float) { Return This.MakeFloatBits(F64Neg(arguments[0].Integer)); }
            Return This.MakeInt(0 - arguments[0].Integer);
        }
        If (arguments.Count() < 2) { Return This.MakeInt(0); }
        If (name == "Add") {
            If (arguments[0].Kind == ValueKind.Object && arguments[1].Kind == ValueKind.Object) {
                Int index = This.FindOperator(arguments[0].Text + "+");
                If (index >= 0) { Return This.CallFunction(This.operatorNodes[index], arguments); }
            }
            If (arguments[0].Kind == ValueKind.Float || arguments[1].Kind == ValueKind.Float) {
                Return This.EvaluateFloat("+", arguments[0], arguments[1]);
            }
            Return This.MakeInt(arguments[0].Integer + arguments[1].Integer);
        }
        If (name == "Equal") {
            If (arguments[0].Kind == ValueKind.Object && arguments[1].Kind == ValueKind.Object) {
                Int index = This.FindOperator(arguments[0].Text + "==");
                If (index >= 0) { Return This.CallFunction(This.operatorNodes[index], arguments); }
            }
            Return This.MakeBool(This.Same(arguments[0], arguments[1]));
        }
        If (name == "GreaterThan") {
            If (arguments[0].Kind == ValueKind.Float || arguments[1].Kind == ValueKind.Float) {
                Return This.EvaluateFloat(">", arguments[0], arguments[1]);
            }
            Return This.MakeBool(arguments[0].Integer > arguments[1].Integer);
        }
        If (name == "And") {
            Return This.MakeBool(This.IsTruthy(arguments[0]) && This.IsTruthy(arguments[1]));
        }
        Return This.MakeInt(0);
    }

    Private Function CallFunction(AstNode function, List<Value> arguments) -> Value {
        This.PushScope();
        Int index = 0;
        For parameter In function.Parameters {
            If (!parameter.FlagC) {
                Value argument = This.MakeNull();
                If (index < arguments.Count()) {
                    argument = arguments[index];
                } Else If (parameter.Initializer != Null) {
                    argument = This.Evaluate(parameter.Initializer);
                }
                This.Define(parameter.Name, argument);
                index = index + 1;
            }
        }
        String previous = This.signal;
        Value previousReturn = This.returnValue;
        This.signal = "";
        This.returnValue = This.MakeVoid();
        If (function.Body != Null) {
            This.ExecuteNode(function.Body);
        } Else If (function.Left != Null) {
            This.returnValue = This.Evaluate(function.Left);
        }
        Value result = This.returnValue;
        This.signal = previous;
        This.returnValue = previousReturn;
        This.PopScope();
        Return result;
    }

    Private Function PatternMatches(AstNode pattern, Value scrutinee) -> Bool {
        If (pattern.FlagA) { Return True; }
        If (pattern.Left != Null && pattern.Left.Kind == AstKind.IntegerLiteral) {
            Return scrutinee.Kind == ValueKind.Integer && scrutinee.Integer == ParseInteger(pattern.Left.Text);
        }
        If (pattern.Text == "Int" || pattern.Text == "Int64") { Return scrutinee.Kind == ValueKind.Integer; }
        If (pattern.Text == "String") { Return scrutinee.Kind == ValueKind.Text; }
        If (pattern.Text == "Bool") { Return scrutinee.Kind == ValueKind.Boolean; }
        If (pattern.Text == "Float" || pattern.Text == "Double" || pattern.Text == "Float64") { Return scrutinee.Kind == ValueKind.Float; }
        If (pattern.Text.Length() > 0 && scrutinee.Text == pattern.Text) {
            Return True;
        }
        If (pattern.Name.Length() > 0 && pattern.Text.Length() == 0 && pattern.Children.Count() == 0) {
            Return True;
        }
        Return False;
    }

    Private Function BindPattern(AstNode pattern, Value scrutinee) -> Void {
        If (pattern.Name.Length() > 0 && pattern.Name != "_" && pattern.Name != "()") {
            This.Define(pattern.Name, scrutinee);
        }
    }

    Private Function FindFunction(String name) -> AstNode? {
        For function In This.functions {
            If (function.Name == name) {
                Return function;
            }
        }
        Return Null;
    }

    Private Function Define(String name, Value value) -> Void {
        If (name.Length() == 0) { Return; }
        This.names.Add(name);
        This.values.Add(value);
    }

    Private Function Assign(String name, Value value) -> Void {
        Int index = This.names.Count() - 1;
        While (index >= 0) {
            If (This.names[index] == name) {
                This.values[index] = value;
                Return;
            }
            index = index - 1;
        }
        This.Define(name, value);
    }

    Private Function TypeIndex(String name) -> Int {
        Int index = 0;
        For typeNode In This.types {
            If (typeNode.Name == name) { Return index; }
            index = index + 1;
        }
        Return -1;
    }

    Private Function EnumOrdinal(AstNode typeNode, String name) -> Int {
        Int ordinal = 0;
        For child In typeNode.Children {
            If (child.Kind == AstKind.EnumMember) {
                If (child.Name == name) { Return ordinal; }
                ordinal = ordinal + 1;
            }
        }
        Return 0;
    }

    Private Function MakeEnumValue(AstNode typeNode, String name, List<Value> arguments) -> Value {
        For child In typeNode.Children {
            If (child.Kind == AstKind.EnumMember && child.Name == name) {
                If (child.Parameters.Count() == 0) { Return This.MakeInt(This.EnumOrdinal(typeNode, name)); }
                Value obj = This.MakeObjectValue(typeNode.Name);
                Int index = 0;
                For parameter In child.Parameters {
                    obj.FieldNames.Add(parameter.Name);
                    Value field = This.MakeInt(0);
                    If (index < arguments.Count()) { field = arguments[index]; }
                    obj.Elements.Add(field);
                    index = index + 1;
                }
                Return obj;
            }
        }
        Return This.MakeInt(0);
    }

    Private Function TakeFront(Value collection) -> Value {
        If (collection.Elements.Count() == 0) { Return This.MakeInt(0); }
        Value item = collection.Elements[0];
        Var kept = List<Value>();
        Int index = 1;
        While (index < collection.Elements.Count()) {
            kept.Add(collection.Elements[index]);
            index = index + 1;
        }
        collection.Elements = kept;
        Return item;
    }

    Private Function TakeBack(Value collection) -> Value {
        Int count = collection.Elements.Count();
        If (count == 0) { Return This.MakeInt(0); }
        Value item = collection.Elements[count - 1];
        Var kept = List<Value>();
        Int index = 0;
        While (index + 1 < count) {
            kept.Add(collection.Elements[index]);
            index = index + 1;
        }
        collection.Elements = kept;
        Return item;
    }

    Private Function TypeMatches(Value value, String expected) -> Bool {
        If (expected == "Bool") { Return value.Kind == ValueKind.Boolean; }
        If (expected == "String") { Return value.Kind == ValueKind.Text; }
        If (expected == "Float" || expected == "Double") { Return value.Kind == ValueKind.Float; }
        If (expected == "Null") { Return value.Kind == ValueKind.Null; }
        If (expected == "Int" || expected == "Int64") { Return value.Kind == ValueKind.Integer; }
        Return False;
    }

    Private Function MakeRecord(AstNode node) -> Value {
        Value obj = This.MakeObjectValue("");
        For child In node.Children {
            Value field = This.MakeInt(0);
            If (child.Left != Null) { field = This.Evaluate(child.Left); }
            obj.FieldNames.Add(child.Name);
            obj.Elements.Add(field);
        }
        Return obj;
    }

    Private Function MakeMap(AstNode node) -> Value {
        Value map = This.MakeArray();
        map.Text = "Map";
        For child In node.Children {
            map.Elements.Add(This.MakeText(child.Name));
            If (child.Left != Null) { map.Elements.Add(This.Evaluate(child.Left)); }
            If (child.Left == Null) { map.Elements.Add(This.MakeInt(0)); }
        }
        Return map;
    }

    Private Function MakeSet(AstNode node) -> Value {
        Value set = This.MakeArray();
        set.Text = "Set";
        For child In node.Children {
            Value item = This.Evaluate(child);
            Bool seen = False;
            For existing In set.Elements {
                If (This.Same(existing, item)) { seen = True; }
            }
            If (!seen) { set.Elements.Add(item); }
        }
        Return set;
    }

    Private Function MakeObject(AstNode node) -> Value {
        Value obj = This.MakeObjectValue(node.Name);
        Int typeIndex = This.TypeIndex(node.Name);
        If (typeIndex >= 0) {
            For field In This.types[typeIndex].Children {
                If (field.Kind == AstKind.Field) {
                    obj.FieldNames.Add(field.Name);
                    obj.Elements.Add(This.MakeInt(0));
                }
            }
        }
        For child In node.Children {
            Value field = This.MakeInt(0);
            If (child.Left != Null) { field = This.Evaluate(child.Left); }
            Int index = This.FieldIndex(obj, child.Name);
            If (index < 0) {
                obj.FieldNames.Add(child.Name);
                obj.Elements.Add(field);
            } Else {
                obj.Elements[index] = field;
            }
        }
        Return obj;
    }

    Private Function MakeObjectValue(String typeName) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Object;
        value.Text = typeName;
        value.Integer = 0;
        value.Boolean = False;
        value.Elements = List<Value>();
        value.FieldNames = List<String>();
        Return value;
    }

    Private Function FieldIndex(Value value, String name) -> Int {
        Int index = 0;
        For field In value.FieldNames {
            If (field == name) { Return index; }
            index = index + 1;
        }
        Return -1;
    }

    Private Function Lookup(String name) -> Value {
        Int index = This.names.Count() - 1;
        While (index >= 0) {
            If (This.names[index] == name) {
                Return This.values[index];
            }
            index = index - 1;
        }
        This.runtimeErrors.Add("Name '" + name + "' is not defined at runtime.");
        Return This.MakeNull();
    }

    Private Function PushScope() -> Void {
        This.marks.Add(This.names.Count());
    }

    Private Function PopScope() -> Void {
        If (This.marks.Count() == 0) { Return; }
        Int mark = This.marks[This.marks.Count() - 1];
        Var keptNames = List<String>();
        Var keptValues = List<Value>();
        Int index = 0;
        While (index < mark) {
            keptNames.Add(This.names[index]);
            keptValues.Add(This.values[index]);
            index = index + 1;
        }
        This.names = keptNames;
        This.values = keptValues;
        Var keptMarks = List<Int>();
        Int markIndex = 0;
        While (markIndex < This.marks.Count() - 1) {
            keptMarks.Add(This.marks[markIndex]);
            markIndex = markIndex + 1;
        }
        This.marks = keptMarks;
    }

    Private Function MakeInt(Int number) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Integer;
        value.Integer = number;
        Return value;
    }

    Private Function MakeFloatBits(Int bits) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Float;
        value.Integer = bits;
        Return value;
    }

    Private Function ParseFloat(String text) -> Value {
        String compact = text.Replace("_", "");
        String lower = compact.ToLower();
        String number = StripNumericSuffix(compact);
        If (lower.EndsWith("f64")) {
            Return This.MakeFloatBits(ParseF64(number));
        }
        If (lower.EndsWith("f32") || lower.EndsWith("f")) {
            Return This.MakeFloatBits(F32Parse(number));
        }
        Return This.MakeFloatBits(ParseF64(number));
    }

    Private Function FloatBits(Value value) -> Int {
        If (value.Kind == ValueKind.Float) { Return value.Integer; }
        Return FloatFromInt(value.Integer);
    }

    Private Function EvaluateFloat(String operator, Value left, Value right) -> Value {
        Int first = This.FloatBits(left);
        Int second = This.FloatBits(right);
        If (operator == "+") { Return This.MakeFloatBits(F64Add(first, second)); }
        If (operator == "-") { Return This.MakeFloatBits(F64Sub(first, second)); }
        If (operator == "*") { Return This.MakeFloatBits(F64Mul(first, second)); }
        If (operator == "/") { Return This.MakeFloatBits(F64Div(first, second)); }
        Int compared = F64Cmp(first, second);
        If (operator == "==") { Return This.MakeBool(compared == 0); }
        If (operator == "!=") { Return This.MakeBool(compared != 0); }
        If (operator == "<") { Return This.MakeBool(compared < 0); }
        If (operator == ">") { Return This.MakeBool(compared > 0); }
        If (operator == "<=") { Return This.MakeBool(compared <= 0); }
        If (operator == ">=") { Return This.MakeBool(compared >= 0); }
        Return This.MakeFloatBits(first);
    }

    Private Function MakeBool(Bool number) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Boolean;
        value.Boolean = number;
        Return value;
    }

    Private Function MakeText(String text) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Text;
        value.Text = text;
        Return value;
    }

    Private Function MakeNull() -> Value {
        Value value = Value();
        value.Kind = ValueKind.Null;
        Return value;
    }

    Private Function MakeVoid() -> Value {
        Value value = Value();
        value.Kind = ValueKind.Void;
        Return value;
    }

    Private Function MakeArray() -> Value {
        Value value = Value();
        value.Kind = ValueKind.Array;
        Return value;
    }

    Private Function MakeFunction(AstNode node) -> Value {
        Value value = Value();
        value.Kind = ValueKind.Function;
        value.FunctionNode = node;
        value.Text = node.Name;
        Return value;
    }

    Private Function IsTruthy(Value value) -> Bool {
        If (value.Kind == ValueKind.Boolean) { Return value.Boolean; }
        If (value.Kind == ValueKind.Integer) { Return value.Integer != 0; }
        If (value.Kind == ValueKind.Null || value.Kind == ValueKind.None || value.Kind == ValueKind.Void) { Return False; }
        Return True;
    }

    Private Function Same(Value left, Value right) -> Bool {
        If (left.Kind != right.Kind) { Return False; }
        If (left.Kind == ValueKind.Float) { Return F64Cmp(left.Integer, right.Integer) == 0; }
        If (left.Kind == ValueKind.Integer) { Return left.Integer == right.Integer; }
        If (left.Kind == ValueKind.Boolean) { Return left.Boolean == right.Boolean; }
        If (left.Kind == ValueKind.Text) { Return left.Text == right.Text; }
        If (left.Kind == ValueKind.Null) { Return True; }
        Return False;
    }

    Private Function Display(Value value) -> String {
        If (value.Kind == ValueKind.Integer) { Return value.Integer.ToString(); }
        If (value.Kind == ValueKind.Float) { Return TextF64(value.Integer); }
        If (value.Kind == ValueKind.Boolean) {
            If (value.Boolean) { Return "True"; }
            Return "False";
        }
        If (value.Kind == ValueKind.Text) { Return value.Text; }
        If (value.Kind == ValueKind.Null) { Return "Null"; }
        If (value.Kind == ValueKind.Array && value.Text == "Map") {
            String text = "{";
            Int index = 0;
            While (index + 1 < value.Elements.Count()) {
                If (index > 0) { text = text + ", "; }
                text = text + This.Display(value.Elements[index]);
                text = text + ": ";
                text = text + This.Display(value.Elements[index + 1]);
                index = index + 2;
            }
            Return text + "}";
        }
        If (value.Kind == ValueKind.Array && value.Text == "Set") {
            String text = "{";
            Int index = 0;
            For element In value.Elements {
                If (index > 0) { text = text + ", "; }
                text = text + This.Display(element);
                index = index + 1;
            }
            Return text + "}";
        }
        If (value.Kind == ValueKind.Array) {
            String text = "[";
            Int index = 0;
            For element In value.Elements {
                If (index > 0) { text = text + ", "; }
                text = text + This.Display(element);
                index = index + 1;
            }
            Return text + "]";
        }
        Return "";
    }
}

Private Extern Function ParseF64(String text) -> Int;
Private Extern Function F32Parse(String text) -> Int;
Private Extern Function TextF64(Int bits) -> String;
Private Extern Function FloatFromInt(Int value) -> Int;
Private Extern Function F64Add(Int left, Int right) -> Int;
Private Extern Function F64Sub(Int left, Int right) -> Int;
Private Extern Function F64Mul(Int left, Int right) -> Int;
Private Extern Function F64Div(Int left, Int right) -> Int;
Private Extern Function F64Neg(Int bits) -> Int;
Private Extern Function F64Cmp(Int left, Int right) -> Int;
Private Extern Function FloatToInt(Int bits) -> Int;
Private Extern Function ReadLine() -> String;
Private Extern Function BitAnd(Int left, Int right) -> Int;
Private Extern Function BitOr(Int left, Int right) -> Int;
Private Extern Function BitXor(Int left, Int right) -> Int;
Private Extern Function Shl(Int left, Int right) -> Int;
Private Extern Function Shr(Int left, Int right) -> Int;
